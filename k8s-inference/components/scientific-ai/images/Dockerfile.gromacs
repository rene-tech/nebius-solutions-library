# Same GROMACS/CUDA/scientific features; native code for each approved GPU.
# Build SM=89 for L40S and SM=120 for RTX PRO 6000. No experimental kernels.
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS build
ARG SM
ARG GMX_VERSION=2026.4
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build ca-certificates curl libfftw3-dev libhwloc-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN curl --fail --location --silent --show-error \
    https://ftp.gromacs.org/gromacs/gromacs-${GMX_VERSION}.tar.gz -o gromacs.tar.gz && \
    tar xzf gromacs.tar.gz
RUN test "$SM" = 89 -o "$SM" = 120 && \
    cmake -S gromacs-${GMX_VERSION} -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/gromacs \
      -DGMX_GPU=CUDA -DGMX_CUDA_TARGET_SM="$SM" -DGMX_SIMD=AVX2_256 \
      -DGMX_MPI=OFF -DGMX_OPENMP=ON -DGMX_HWLOC=ON \
      -DGMX_FFT_LIBRARY=fftw3 -DGMX_BUILD_OWN_FFTW=OFF \
      -DGMX_INSTALL_NBLIB_API=OFF -DGMXAPI=OFF -DREGRESSIONTEST_DOWNLOAD=OFF && \
    cmake --build build -j 16 && cmake --install build
FROM nvidia/cuda:12.8.1-base-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    libfftw3-double3 libfftw3-single3 libhwloc15 libgomp1 ca-certificates python3-venv && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/cuda/lib64/libcufft.so.1* /usr/local/cuda/lib64/
COPY --from=build /opt/gromacs /opt/gromacs
ENV PATH=/opt/gromacs/bin:$PATH GMX_MAXBACKUP=-1
ENTRYPOINT ["/opt/gromacs/bin/gmx"]
