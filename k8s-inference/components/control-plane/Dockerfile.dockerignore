# BuildKit selects this file (not control-plane/.dockerignore) when the
# repository root is the context and this Dockerfile is passed with -f.
# Start closed, admit only immutable build inputs, then re-exclude sensitive
# names even if they are accidentally created inside an admitted source tree.
