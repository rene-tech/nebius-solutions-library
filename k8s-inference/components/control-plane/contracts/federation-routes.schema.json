{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/federation-routes/v1",
  "title": "fs2-serve private exact-upstream federation routes v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "routes"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/federation-routes/v1"},
    "routes": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z0-9](?:[-a-z0-9]{0,126}[a-z0-9])?$"},
      "additionalProperties": {"$ref": "#/$defs/route"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "destination", "credential_mode", "health", "timeouts", "idempotency", "retry", "circuit_breaker"],
      "properties": {
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_digest", "backend_class", "runtime_image_digest", "endpoint_identity_sha256", "trust_bundle_sha256", "credential_requirement_id"],
          "properties": {
            "model_digest": {"$ref": "#/$defs/digest"},
            "backend_class": {"enum": ["federated-kserve-nim", "federated-serverless"]},
            "runtime_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "endpoint_identity_sha256": {"$ref": "#/$defs/digest"},
            "trust_bundle_sha256": {"$ref": "#/$defs/digest"},
            "credential_requirement_id": {"type": "string", "pattern": "^fs2-models/[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"}
          }
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "host", "port", "connect_ips"],
          "properties": {
            "scheme": {"const": "https"},
            "host": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9](?:[-.a-z0-9]*[a-z0-9])?$"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "connect_ips": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 45}}
          }
        },
        "credential_mode": {"enum": ["bearer", "mtls"]},
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path", "expected_status", "timeout_seconds"],
          "properties": {
            "method": {"const": "GET"},
            "path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/(?!/)[^?#]*$"},
            "expected_status": {"type": "integer", "minimum": 100, "maximum": 599},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 5}
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["connect_seconds", "read_seconds", "write_seconds", "pool_seconds", "total_seconds"],
          "properties": {
            "connect_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3},
            "read_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
            "write_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
            "pool_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3},
            "total_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30}
          }
        },
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "header"],
          "properties": {
            "mode": {"const": "operation-id"},
            "header": {"const": "Idempotency-Key"}
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_attempts", "base_backoff_seconds", "retry_status_codes"],
          "properties": {
            "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
            "base_backoff_seconds": {"type": "number", "minimum": 0.01, "maximum": 1},
            "retry_status_codes": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"enum": [408, 425, 429, 500, 502, 503, 504]}}
          }
        },
        "circuit_breaker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failure_threshold", "recovery_seconds"],
          "properties": {
            "failure_threshold": {"type": "integer", "minimum": 1, "maximum": 10},
            "recovery_seconds": {"type": "number", "minimum": 1, "maximum": 300}
          }
        }
      }
    }
  }
}
