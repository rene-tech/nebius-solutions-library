{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/contracts/network-policy-security-provider-trust-anchor-v3.schema.json",
  "title": "Externally pinned provider directory and Kubernetes authentication trust anchor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "provider", "adapter", "directory_execution", "directory_query",
    "kubernetes_authentication", "execution_sha256", "kubernetes_authentication_sha256",
    "tenant_sha256", "query_sha256", "provider_collection_authority_sha256",
    "valid_from", "expires_at"
  ],
  "properties": {
    "schema": { "const": "fs2-serve.nebius.ai/security-provider-trust-anchor/v3" },
    "provider": { "const": "nebius-iam" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "const": "fs2-serve.nebius.ai/nebius-iam-human-directory/v3" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "directory_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli_path", "cli_sha256", "config_path", "config_sha256", "credential_path",
        "credential_sha256", "api_endpoint", "api_endpoint_sha256", "provider_issuer",
        "provider_issuer_sha256", "principal_type", "principal_id", "config_profiles_path",
        "config_endpoint_path", "config_credential_path", "config_principal_path",
        "config_project_path", "credential_principal_path", "directory_reader_access"
      ],
      "properties": {
        "cli_path": { "const": "/usr/local/bin/nebius" },
        "cli_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "config_path": { "const": "/etc/fs2/security/nebius-directory-reader.yaml" },
        "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "credential_path": { "const": "/etc/fs2/security/nebius-directory-reader-credential.json" },
        "credential_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "api_endpoint": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$" },
        "api_endpoint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "provider_issuer": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$" },
        "provider_issuer_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "principal_type": { "const": "service-account" },
        "principal_id": { "type": "string", "pattern": "^serviceaccount-[A-Za-z0-9-]{8,128}$" },
        "config_profiles_path": { "$ref": "#/$defs/path" },
        "config_endpoint_path": { "$ref": "#/$defs/path" },
        "config_credential_path": { "$ref": "#/$defs/path" },
        "config_principal_path": { "$ref": "#/$defs/path" },
        "config_project_path": { "$ref": "#/$defs/path" },
        "credential_principal_path": { "$ref": "#/$defs/path" },
        "directory_reader_access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved_role", "approved_role_effect", "expected_permits",
            "expected_permits_sha256"
          ],
          "properties": {
            "approved_role": { "const": "auditor" },
            "approved_role_effect": { "const": "view-metadata-without-data-or-mutation" },
            "expected_permits": {
              "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["parent_id", "parent_kind", "resource_id", "role"],
                "properties": {
                  "parent_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,253}$" },
                  "parent_kind": { "enum": ["service-account", "group"] },
                  "resource_id": { "type": "string", "pattern": "^tenant-[A-Za-z0-9-]{8,128}$" },
                  "role": { "const": "auditor" }
                }
              }
            },
            "expected_permits_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "directory_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli_path", "config_path", "profile", "project_id", "tenant_id", "page_size",
        "max_pages", "max_records", "timeout_seconds", "snapshot_ttl_seconds",
        "consistency_passes"
      ],
      "properties": {
        "cli_path": { "const": "/usr/local/bin/nebius" },
        "config_path": { "const": "/etc/fs2/security/nebius-directory-reader.yaml" },
        "profile": { "type": "string", "pattern": "^[A-Za-z0-9._-]{3,128}$" },
        "project_id": { "type": "string", "pattern": "^project-[A-Za-z0-9-]{8,128}$" },
        "tenant_id": { "type": "string", "pattern": "^tenant-[A-Za-z0-9-]{8,128}$" },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "max_pages": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_records": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "snapshot_ttl_seconds": { "type": "integer", "minimum": 10800, "maximum": 28800 },
        "consistency_passes": { "const": 2 }
      }
    },
    "kubernetes_authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oidc_issuer", "oidc_issuer_sha256", "audiences", "audiences_sha256",
        "username_claim", "username_prefix", "groups_claim", "groups_prefix",
        "provider_subject_field", "provider_email_field", "provider_group_field",
        "probe_token_path", "probe_token_sha256"
      ],
      "properties": {
        "oidc_issuer": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$" },
        "oidc_issuer_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{3,253}$" }
        },
        "audiences_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "username_claim": { "enum": ["sub", "email"] },
        "username_prefix": { "type": "string", "pattern": "^[A-Za-z0-9:@._+/-]{0,128}$" },
        "groups_claim": { "const": "groups" },
        "groups_prefix": { "type": "string", "pattern": "^[A-Za-z0-9:@._+/-]{0,128}$" },
        "provider_subject_field": { "const": "tenant_user_account.metadata.id" },
        "provider_email_field": { "const": "attributes.email" },
        "provider_group_field": { "const": "metadata.name" },
        "probe_token_path": { "const": "/etc/fs2/security/network-policy-provider-oidc-probe.jwt" },
        "probe_token_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "execution_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "kubernetes_authentication_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tenant_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "query_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider_collection_authority_sha256": { "$ref": "#/$defs/sha256" },
    "valid_from": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
    }
  }
}
