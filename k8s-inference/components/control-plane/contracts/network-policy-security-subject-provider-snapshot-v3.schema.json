{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/contracts/network-policy-security-subject-provider-snapshot-v3.schema.json",
  "title": "Byte-pinned repeat-stable provider/IAM subject snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["signed", "signature"],
  "properties": {
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "snapshot_id", "provider", "adapter", "trust_anchor_sha256",
        "provider_collection_authority_sha256", "execution_sha256",
        "kubernetes_authentication_sha256", "provider_principal", "provider_authorization",
        "api_endpoint_sha256", "provider_issuer_sha256", "tenant_sha256", "query_sha256",
        "complete", "pagination", "raw_collections", "human_users", "human_groups",
        "captured_at", "expires_at", "signer_key_id"
      ],
      "properties": {
        "schema": { "const": "fs2-serve.nebius.ai/security-subject-provider-snapshot/v3" },
        "snapshot_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" },
        "provider": { "const": "nebius-iam" },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": { "const": "fs2-serve.nebius.ai/nebius-iam-human-directory/v3" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "trust_anchor_sha256": { "$ref": "#/$defs/sha256" },
        "provider_collection_authority_sha256": { "$ref": "#/$defs/sha256" },
        "execution_sha256": { "$ref": "#/$defs/sha256" },
        "kubernetes_authentication_sha256": { "$ref": "#/$defs/sha256" },
        "provider_principal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "credential_sha256"],
          "properties": {
            "type": { "const": "service-account" },
            "id": { "type": "string", "pattern": "^serviceaccount-[A-Za-z0-9-]{8,128}$" },
            "credential_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "api_endpoint_sha256": { "$ref": "#/$defs/sha256" },
        "provider_issuer_sha256": { "$ref": "#/$defs/sha256" },
        "tenant_sha256": { "$ref": "#/$defs/sha256" },
        "query_sha256": { "$ref": "#/$defs/sha256" },
        "provider_authorization": { "$ref": "#/$defs/providerAuthorization" },
        "complete": { "const": true },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_count", "page_size", "consistency", "collections"],
          "properties": {
            "subject_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "page_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "consistency": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "passes", "collection_sha256"],
              "properties": {
                "mode": { "const": "double-collect-byte-identical" },
                "passes": { "const": 2 },
                "collection_sha256": { "$ref": "#/$defs/sha256" }
              }
            },
            "collections": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/collection" }
            }
          }
        },
        "raw_collections": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "array", "minItems": 1, "maxItems": 10000,
            "items": { "$ref": "#/$defs/rawPage" }
          }
        },
        "human_users": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider_subject_id", "username", "groups"],
            "properties": {
              "provider_subject_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,253}$" },
              "username": { "type": "string", "pattern": "^[A-Za-z0-9:@._+/-]{3,253}$" },
              "groups": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[A-Za-z0-9:@._+/-]{1,253}$" }
              }
            }
          }
        },
        "human_groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9:@._+/-]{1,253}$" }
        },
        "captured_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "signer_key_id": { "$ref": "#/$defs/sha256" }
      }
    },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rawPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "request_token", "response", "next_token"],
      "properties": {
        "operation": { "type": "string", "minLength": 1, "maxLength": 512 },
        "request_token": { "type": "string", "maxLength": 8192 },
        "response": { "type": "object" },
        "next_token": { "type": "string", "maxLength": 8192 }
      }
    },
    "providerAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle", "collections"],
      "properties": {
        "cycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode", "authorization_before_sha256", "directory_collection_sha256",
            "authorization_after_sha256", "cycle_sha256"
          ],
          "properties": {
            "mode": { "const": "authorization-directory-directory-authorization" },
            "authorization_before_sha256": { "$ref": "#/$defs/sha256" },
            "directory_collection_sha256": { "$ref": "#/$defs/sha256" },
            "authorization_after_sha256": { "$ref": "#/$defs/sha256" },
            "cycle_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "collections": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "phase", "evidence", "sha256"],
            "properties": {
              "index": { "type": "integer", "minimum": 0, "maximum": 1 },
              "phase": { "enum": ["before-directory", "after-directory"] },
              "evidence": { "$ref": "#/$defs/providerAuthorizationEvidence" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "providerAuthorizationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whoami", "membership_pages", "principal_group_ids", "subject_permit_pages",
        "effective_permits", "effective_roles", "access_contract_sha256",
        "page_count", "record_count"
      ],
      "properties": {
        "whoami": { "type": "object" },
        "membership_pages": {
          "type": "array", "minItems": 1, "maxItems": 10000,
          "items": { "$ref": "#/$defs/rawPage" }
        },
        "principal_group_ids": {
          "type": "array", "maxItems": 100000, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,253}$" }
        },
        "subject_permit_pages": {
          "type": "array", "minItems": 1, "maxItems": 100000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["subject_id", "subject_kind", "pages"],
            "properties": {
              "subject_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,253}$" },
              "subject_kind": { "enum": ["service-account", "group"] },
              "pages": {
                "type": "array", "minItems": 1, "maxItems": 10000,
                "items": { "$ref": "#/$defs/rawPage" }
              }
            }
          }
        },
        "effective_permits": {
          "type": "array", "minItems": 1, "maxItems": 100000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["permit_id", "parent_id", "parent_kind", "resource_id", "role"],
            "properties": {
              "permit_id": { "type": "string", "pattern": "^accesspermit-[A-Za-z0-9-]{8,128}$" },
              "parent_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,253}$" },
              "parent_kind": { "enum": ["service-account", "group"] },
              "resource_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,253}$" },
              "role": { "const": "auditor" }
            }
          }
        },
        "effective_roles": {
          "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
          "items": { "const": "auditor" }
        },
        "access_contract_sha256": { "$ref": "#/$defs/sha256" },
        "page_count": { "type": "integer", "minimum": 2, "maximum": 10000 },
        "record_count": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "request_cursor_sha256", "response_sha256", "next_cursor_sha256"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "request_cursor_sha256": { "$ref": "#/$defs/sha256" },
        "response_sha256": { "$ref": "#/$defs/sha256" },
        "next_cursor_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "const": "" }]
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "page_count", "record_count", "terminal_cursor", "pages", "sha256"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 1 },
        "page_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "record_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "terminal_cursor": { "const": "" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/page" }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
