{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/contracts/network-policy-security-handoff.schema.json",
  "title": "NetworkPolicy security automation handoff",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_server_sha256", "kube_system_uid"],
      "properties": {
        "api_server_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "kube_system_uid": { "type": "string", "minLength": 20, "maxLength": 128 }
      }
    },
    "patchBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "name", "namespace", "patch_type", "patch", "dry_run"],
      "properties": {
        "resource": { "enum": ["configmap", "lease", "networkpolicy"] },
        "name": {
          "enum": [
            "fs2-network-policy-transition",
            "fs2-serve-control-plane-public-envoy-transition-guard",
            "fs2-serve-control-plane-envoy-controller-xds-transition-guard",
            "fs2-serve-control-plane-envoy-default-deny"
          ]
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 63
        },
        "patch_type": { "enum": ["json", "merge"] },
        "patch": {
          "oneOf": [
            { "type": "object", "maxProperties": 8 },
            { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "object" } }
          ]
        },
        "dry_run": { "type": "boolean" }
      }
    },
    "recoveryBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "recovery_reference",
        "topology_uid",
        "topology_sha256",
        "receipt",
        "lease",
        "binding",
        "parameter",
        "delete_allowed"
      ],
      "properties": {
        "mode": { "enum": ["audit-warn", "deny"] },
        "recovery_reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "topology_uid": { "type": "string", "minLength": 20, "maxLength": 128 },
        "topology_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "name", "uid", "resource_version", "sha256"],
          "properties": {
            "namespace": { "const": "fs2-system" },
            "name": { "const": "fs2-network-policy-transition" },
            "uid": { "type": "string", "minLength": 20, "maxLength": 128 },
            "resource_version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "lease": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "name",
            "uid",
            "resource_version",
            "holder_identity",
            "lease_transitions"
          ],
          "properties": {
            "namespace": { "const": "fs2-system" },
            "name": { "const": "fs2-network-policy-transition" },
            "uid": { "type": "string", "minLength": 20, "maxLength": 128 },
            "resource_version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
            "holder_identity": { "type": "string", "minLength": 3, "maxLength": 253 },
            "lease_transitions": { "type": "integer", "minimum": 1 }
          }
        },
        "binding": { "const": "fs2-network-policy-boundary" },
        "parameter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "name"],
          "properties": {
            "namespace": { "const": "fs2-system" },
            "name": { "const": "fs2-network-policy-boundary-parameters" }
          }
        },
        "delete_allowed": { "const": false }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation_id",
        "action",
        "cluster",
        "release",
        "issued_at",
        "expires_at",
        "body"
      ],
      "properties": {
        "schema": { "const": "fs2-serve.nebius.ai/network-policy-security-handoff-request/v1" },
        "operation_id": { "type": "string", "format": "uuid" },
        "action": {
          "enum": ["attest", "patch-exact-kubernetes-object", "set-admission-recovery"]
        },
        "cluster": { "$ref": "#/$defs/cluster" },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "namespace"],
          "properties": {
            "name": { "const": "fs2-serve-control-plane" },
            "namespace": { "const": "fs2-system" }
          }
        },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "body": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "attest" } }, "required": ["action"] },
          "then": { "properties": { "body": { "type": "object", "maxProperties": 0 } } }
        },
        {
          "if": {
            "properties": { "action": { "const": "patch-exact-kubernetes-object" } },
            "required": ["action"]
          },
          "then": { "properties": { "body": { "$ref": "#/$defs/patchBody" } } }
        },
        {
          "if": {
            "properties": { "action": { "const": "set-admission-recovery" } },
            "required": ["action"]
          },
          "then": { "properties": { "body": { "$ref": "#/$defs/recoveryBody" } } }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signed", "signature"],
      "properties": {
        "signed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "operation_id",
            "request_sha256",
            "cluster",
            "issued_at",
            "expires_at",
            "status",
            "signer_key_id",
            "result"
          ],
          "properties": {
            "schema": { "const": "fs2-serve.nebius.ai/network-policy-security-handoff-response/v1" },
            "operation_id": { "type": "string", "format": "uuid" },
            "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "cluster": { "$ref": "#/$defs/cluster" },
            "issued_at": { "type": "string", "format": "date-time" },
            "expires_at": { "type": "string", "format": "date-time" },
            "status": { "const": "approved" },
            "signer_key_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "result": { "type": "object" }
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "description": "Unpadded base64url Ed25519 signature over canonical signed."
        }
      }
    }
  }
}
