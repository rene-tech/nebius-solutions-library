{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/contracts/network-policy-security-provider-trust-anchor-v2.schema.json",
  "title": "Externally pinned authoritative provider directory trust anchor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider",
    "adapter",
    "directory_query",
    "tenant_sha256",
    "query_sha256",
    "snapshot_public_key",
    "snapshot_signer_key_id",
    "valid_from",
    "expires_at"
  ],
  "properties": {
    "schema": { "const": "fs2-serve.nebius.ai/security-provider-trust-anchor/v2" },
    "provider": { "const": "nebius-iam" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "const": "fs2-serve.nebius.ai/nebius-iam-human-directory/v2" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "directory_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli_path",
        "config_path",
        "profile",
        "tenant_id",
        "page_size",
        "max_pages",
        "max_records",
        "timeout_seconds",
        "snapshot_ttl_seconds"
      ],
      "properties": {
        "cli_path": { "const": "/usr/local/bin/nebius" },
        "config_path": { "const": "/etc/fs2/security/nebius-directory-reader.yaml" },
        "profile": { "type": "string", "pattern": "^[A-Za-z0-9._-]{3,128}$" },
        "tenant_id": { "type": "string", "pattern": "^tenant-[A-Za-z0-9-]{8,128}$" },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "max_pages": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_records": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "snapshot_ttl_seconds": { "type": "integer", "minimum": 300, "maximum": 3600 }
      }
    },
    "tenant_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "query_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "snapshot_public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "snapshot_signer_key_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "valid_from": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
