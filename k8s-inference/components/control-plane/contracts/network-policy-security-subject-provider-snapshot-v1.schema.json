{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/contracts/network-policy-security-subject-provider-snapshot-v1.schema.json",
  "title": "Authoritative provider/IAM human subject snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["signed", "signature"],
  "properties": {
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "snapshot_id",
        "provider",
        "adapter",
        "trust_anchor_sha256",
        "tenant_sha256",
        "query_sha256",
        "complete",
        "pagination",
        "human_users",
        "human_groups",
        "captured_at",
        "expires_at",
        "signer_key_id"
      ],
      "properties": {
        "schema": { "const": "fs2-serve.nebius.ai/security-subject-provider-snapshot/v1" },
        "snapshot_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" },
        "provider": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": { "const": "fs2-serve.nebius.ai/nebius-iam-human-directory/v1" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "trust_anchor_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tenant_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "query_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "complete": { "const": true },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page_size", "page_count", "record_count", "terminal_cursor", "pages"],
          "properties": {
            "page_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "page_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "record_count": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "terminal_cursor": { "const": "" },
            "pages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "request_cursor_sha256", "response_sha256", "next_cursor_sha256"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0 },
                  "request_cursor_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "response_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "next_cursor_sha256": {
                    "oneOf": [
                      { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                      { "const": "" }
                    ]
                  }
                }
              }
            }
          }
        },
        "human_users": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["username", "groups"],
            "properties": {
              "username": { "type": "string", "pattern": "^[A-Za-z0-9:@._/-]{3,253}$" },
              "groups": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[A-Za-z0-9:@._/-]{1,253}$" }
              }
            }
          }
        },
        "human_groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9:@._/-]{1,253}$" }
        },
        "captured_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "signer_key_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}
