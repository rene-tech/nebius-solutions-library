[Unit]
Description=FS2 external model-network provider custody direct-mTLS gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fs2-provider-custody
Group=fs2-provider-custody
EnvironmentFile=/etc/fs2-provider-custody/gateway.env
# gateway.env supplies mode-0600 server certificate/key, client CA, policy,
# upstream credential/CA, public listen address and the exact member identity.
# No front proxy or certificate-as-HTTP-header path is supported.
ExecStart=/opt/fs2-provider-custody/bin/fs2-provider-custody-gateway
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
