# Provider-host mTLS termination for the loopback-only custody gateway.
# The deployment substitutes only the three ${...} paths/port from a
# provider-owned versioned release. The public listener never reaches the ASGI
# process without a verified client certificate.
events {}
http {
  server_tokens off;
  client_max_body_size 16m;
  server {
    listen 8443 ssl http2;
    ssl_certificate ${FS2_PROVIDER_GATEWAY_SERVER_CERT};
    ssl_certificate_key ${FS2_PROVIDER_GATEWAY_SERVER_KEY};
    ssl_client_certificate ${FS2_PROVIDER_GATEWAY_CLIENT_CA};
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.3;

    location / {
      proxy_pass http://127.0.0.1:${FS2_PROVIDER_CUSTODY_LISTEN_PORT};
      proxy_pass_request_headers on;
      proxy_set_header Authorization "";
      proxy_set_header Impersonate-User "";
      proxy_set_header Impersonate-Group "";
      proxy_set_header Impersonate-Extra "";
      proxy_set_header X-FS2-Provider-Client-Certificate $ssl_client_escaped_cert;
      proxy_set_header X-Forwarded-For "";
      proxy_set_header X-Forwarded-Host "";
      proxy_set_header X-Forwarded-Proto "";
      proxy_http_version 1.1;
      proxy_request_buffering on;
      proxy_buffering off;
    }
  }
}
