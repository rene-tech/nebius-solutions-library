# ARCHIVED FAIL-CLOSED COMPATIBILITY FILE. Provider policy v3 terminates mutual
# TLS in fs2-provider-custody-gateway itself and must not install a front proxy.
# Retained to preserve predecessor evidence; if an old automation still loads
# this file it returns 503 and cannot manufacture an HTTP identity header.
events {}
http {
  server_tokens off;
  server {
    listen 127.0.0.1:9080;
    return 503;
  }
}
