+        self.last_batch_responses = []
+
+    def with_profile(self, profile_id):
+        return InferenceEngine({**self.api_params, "profile_id": profile_id})
+
+    def request(self, path, payload):
+        token = os.environ["SCIENTIFIC_AI_TOKEN"]
+        origin = os.environ["MINDEVAL_GATEWAY_URL"].rstrip("/")
+        response = httpx.post(origin + path, headers={"authorization": f"Bearer {token}"},
+                              json=payload, timeout=900)
+        response.raise_for_status()
+        return response.json()
+
+    def generate_result(self, messages):
+        result = self.request("/v1/mindeval/completions", {
+            "run_id": self.api_params["run_id"], "profile_id": self.api_params["profile_id"],
+            "role": self.api_params["role"], "model": self.api_params["model"], "messages": messages,
+            "max_completion_tokens": self.api_params.get("max_completion_tokens", 8192),
+            "temperature": self.api_params.get("temperature", 0.7),
+        })
+        self.last_response = result
+        return result
+
+    def generate(self, messages):
+        return self.generate_result(messages)["content"]
+
+    def generate_with_thinking(self, messages):
+        result = self.generate_result(messages)
+        return result["content"], result["reasoning"]
+
+    def batch_generate_with_thinking(self, list_of_messages):
