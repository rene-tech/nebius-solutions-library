+def main(interactions_path, judge_template_version, judge_model_api_params, max_workers, output_path):
+    if judge_template_version != "v0_1":
+        raise ValueError("the calibrated gateway pins judge v0_1")
+    if not 1 <= max_workers <= 5:
+        raise ValueError("max_workers must be between 1 and 5 per team")
+    interactions = load_jsonl(interactions_path)
+    if len({row["profile_id"] for row in interactions}) > 20:
+        raise ValueError("at most 20 profiles per run")
+    engine = InferenceEngine(judge_model_api_params)
+
+    def judge(row):
+        result = engine.judge(row["profile_id"], row["clinician_model"], row["interaction"])
+        return {"parsed_judgment": {**result["judgment"], "Overall score": result["overall_score"],
+                                    "Average score": result["overall_score"]},
+                "unparsed_judgment": result["content"], "thinking_trace": result["reasoning"],
+                "usage": result["usage"], "finish_reason": result["finish_reason"],
+                "telemetry": result["telemetry"], "profile_id": row["profile_id"]}
+
+    with ThreadPoolExecutor(max_workers=max_workers) as pool:
+        save_to_jsonl(list(pool.map(judge, interactions)), output_path)
 
 
