{
  "schema_version": "fs2.scientific-admin-fixture-contract/v1",
  "status": "capability-gated-live-model-readiness",
  "production_behavior": "The authenticated same-origin BFF reports scientific capabilities first. Model readiness reads the delivered scientific catalog. Run routes are registered and called only when a durable scientific batch reader exists; artifact availability is reported independently. Production has no fixture fallback; fixture data is enabled only by Vite fixture mode and tests.",
  "routes": [
    {
      "method": "GET",
      "path": "/admin/api/v1/scientific-capabilities",
      "data_schema": "ScientificCapabilities"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/scientific-runs",
      "data_schema": "ScientificRunList",
      "filters": [
        "cursor",
        "tenant_id",
        "model_id",
        "service_class",
        "access_state",
        "admission_state",
        "run_status",
        "limit"
      ]
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/scientific-runs/{run_id}",
      "data_schema": "ScientificRunDetail"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/scientific-models",
      "data_schema": "ScientificModelReadinessList"
    }
  ],
  "service_classes": [
    "presentation",
    "interactive",
    "customer-batch",
    "bulk-backfill"
  ],
  "execution_modes": [
    "scientific-batch",
    "hybrid"
  ],
  "access": {
    "profiles": [
      "standard",
      "academic"
    ],
    "states": [
      "not-required",
      "unverified",
      "verified",
      "blocked"
    ],
    "credentials_exposed": false,
    "receipt_digest_is_non_secret": true,
    "request_time_license_receipt_required": false,
    "deployment_authorization_states": [
      "Granted",
      "Authorized"
    ],
    "native_gate_invariant": "Native AlphaFold3 and native BindCraft/PyRosetta are admitted by generated deployment-bound use and execution authorization, never a caller licence receipt. Formal acceptance is advisory. Alternatives retain a distinct model identity and explicit-alternative relationship."
  },
  "attempt_admission": {
    "fields": [
      "admitted_at",
      "resolved_pool_id",
      "admitted_resource_flavor",
      "accelerator_resource_name",
      "gpu_count",
      "pod_count",
      "node_count"
    ],
    "invariant": "Actual Kueue admission is projected only from the persisted controller or canonical result record; missing values remain unavailable and are never inferred from scheduling preference."
  },
  "gpu_accounting": {
    "evidence_states": [
      "measured",
      "estimated",
      "unavailable"
    ],
    "required_totals": [
      "allocated",
      "active",
      "idle_total",
      "grace_drain",
      "reconciliation_delta"
    ],
    "idle_causes": [
      "image-pull",
      "artifact-load",
      "restore",
      "warmup",
      "between-stages",
      "scheduler-hold",
      "unattributed"
    ],
    "invariant": "Every numeric GPU value includes its evidence state and source. Estimated and unavailable values are visibly labelled and never rendered as measured."
  },
  "fast_start_tiers": [
    "cold",
    "container-image-local",
    "model-artifact-local",
    "runtime-checkpoint-restore",
    "gpu-memory-snapshot-restore",
    "warm-replica",
    "not-observed"
  ],
  "detail_sections": [
    "attribution",
    "model_backend_identity",
    "access_admission",
    "service_class_decision",
    "queue_priority_admission",
    "lifecycle_phases",
    "gpu_accounting",
    "dag_stages_attempts",
    "artifacts",
    "errors_retries_cancellation",
    "observability_links"
  ],
  "protected_data": {
    "payloads_exposed": false,
    "credentials_exposed": false,
    "raw_api_keys_exposed": false
  },
  "pending_producers": {
    "scientific-controller": "durable scientific batch run state",
    "scientific-artifacts": "canonical artifact results and semantic validation"
  }
}
