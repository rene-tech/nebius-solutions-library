{
  "schema_version": "fs2.admin-api.contract/v1",
  "api_prefix": "/admin/api/v1",
  "route_profile": "fully enabled operational success surface; feature-disabled problem-only stubs are listed separately",
  "openapi_url": "/internal/openapi.json",
  "authentication_handoff": "bootstrap bearer exchanges server-side for a same-origin HttpOnly operator session at POST /admin/api/v1/session; the bootstrap credential is never browser-stored",
  "session": {
    "endpoint": "/admin/api/v1/session",
    "cookie": "__Host-fs2_admin_session",
    "cookie_attributes": [
      "Secure",
      "HttpOnly",
      "SameSite=Strict",
      "Path=/",
      "no Domain"
    ],
    "ttl_seconds": {
      "minimum": 300,
      "maximum": 86400
    },
    "csrf_boundary": "exact trusted Host and Origin plus SameSite=Strict",
    "cache_control": "no-store"
  },
  "envelope": {
    "fields": [
      "meta",
      "data"
    ],
    "meta_fields": [
      "schema_version",
      "generated_at",
      "context",
      "sources",
      "warnings"
    ],
    "schema_version": "fs2.admin-api/v1"
  },
  "measurement": {
    "fields": [
      "value",
      "unit",
      "state",
      "source",
      "reason"
    ],
    "states": [
      "available",
      "estimated",
      "unavailable"
    ],
    "unavailable_contract": "value is null and reason is non-null"
  },
  "problem": {
    "content_type": "application/problem+json",
    "fields": [
      "type",
      "title",
      "status",
      "code",
      "detail",
      "request_id"
    ],
    "request_id_header": "x-request-id",
    "request_id_authority": "server-generated UUID",
    "status_codes": [
      400,
      401,
      403,
      404,
      409,
      422,
      429,
      503
    ]
  },
  "model_states": [
    "hot",
    "loading",
    "queued",
    "cold",
    "unhealthy",
    "unsupported",
    "unknown"
  ],
  "compatibility_supported_states": [
    "qualified",
    "lean-live-verified"
  ],
  "semantic_health_contract": "hot requires explicit true; false is unhealthy; null is unknown",
  "model_identity_projection": {
    "activation_authority": "versioned-lean-live-route-inventory",
    "active_runtime_fields": [
      "variant_id",
      "kind",
      "source_kind",
      "repository",
      "relationship",
      "nim_artifact_parity"
    ],
    "qualification_fields": [
      "registered",
      "route_active",
      "runtime_ready",
      "semantic_qualified",
      "http_mcp_qualified",
      "cold_start_qualified",
      "elasticity_qualified"
    ],
    "qualification_snapshot": {
      "kind": "reviewed-evidence-snapshot",
      "timestamp_field": "observed_at",
      "current_readiness_authority": "live Kubernetes and control-plane adapters, never the retained evidence snapshot"
    },
    "policy_fields": [
      "license_id",
      "non_clinical",
      "commercial_use"
    ]
  },
  "routes": [
    {
      "method": "POST",
      "path": "/admin/api/v1/session",
      "success_status": 200,
      "data_schema": "OperatorSession",
      "sets_session_cookie": true,
      "cache_control": "no-store"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/session",
      "success_status": 200,
      "data_schema": "OperatorSession",
      "cache_control": "no-store"
    },
    {
      "method": "DELETE",
      "path": "/admin/api/v1/session",
      "success_status": 204,
      "data_schema": null,
      "clears_session_cookie": true,
      "cache_control": "no-store"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/principals",
      "success_status": 200,
      "data_schema": "AdminPrincipalList"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/principals",
      "success_status": 201,
      "data_schema": "OperatorPrincipal"
    },
    {
      "method": "PATCH",
      "path": "/admin/api/v1/principals/{principal_id}",
      "success_status": 200,
      "data_schema": "OperatorPrincipal"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/keys",
      "success_status": 200,
      "data_schema": "AdminApiKeyList"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/keys",
      "success_status": 201,
      "data_schema": "AdminApiKeyDisclosure",
      "secret_disclosure": "one-time",
      "cache_control": "no-store"
    },
    {
      "method": "PATCH",
      "path": "/admin/api/v1/keys/{token_id}",
      "success_status": 200,
      "data_schema": "AdminApiKey"
    },
    {
      "method": "DELETE",
      "path": "/admin/api/v1/keys/{token_id}",
      "success_status": 200,
      "data_schema": "AdminApiKey"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/keys/{token_id}:rotate",
      "success_status": 201,
      "data_schema": "AdminApiKeyDisclosure",
      "secret_disclosure": "one-time",
      "cache_control": "no-store"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/audit",
      "success_status": 200,
      "data_schema": "AdminAuditList"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/context",
      "success_status": 200,
      "data_schema": "AdminContextData"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/overview",
      "success_status": 200,
      "data_schema": "AdminOverview"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/models",
      "success_status": 200,
      "data_schema": "AdminModelList"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/models/{model_id}",
      "success_status": 200,
      "data_schema": "AdminModelDetail"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/operations",
      "success_status": 200,
      "data_schema": "AdminOperationList"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/operations/{operation_id}",
      "success_status": 200,
      "data_schema": "AdminOperationDetail"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/capacity",
      "success_status": 200,
      "data_schema": "AdminCapacity"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/observability",
      "success_status": 200,
      "data_schema": "AdminObservability"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/model-deployments",
      "success_status": 200,
      "data_schema": "ModelDeploymentList"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/model-deployments/{name}",
      "success_status": 200,
      "data_schema": "ModelDeploymentRevision"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/model-deployments/{name}/history",
      "success_status": 200,
      "data_schema": "ModelDeploymentHistory"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/model-deployments/{name}/status",
      "success_status": 200,
      "data_schema": "ModelDeploymentStatusView"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/model-deployments:validate-preview",
      "success_status": 200,
      "data_schema": "ModelDeploymentValidationPreview"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/model-deployments:plan-preview",
      "success_status": 200,
      "data_schema": "ModelDeploymentRenderPreview"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/model-deployments:capabilities",
      "success_status": 200,
      "data_schema": "ModelDeploymentMutationCapabilities"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/model-deployments:apply",
      "success_status": 200,
      "data_schema": "ModelDeploymentMutationResult"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/model-deployments/{name}:drain",
      "success_status": 200,
      "data_schema": "ModelDeploymentMutationResult"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/model-deployments/{name}:rollback",
      "success_status": 200,
      "data_schema": "ModelDeploymentMutationResult"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/model-deployments/{name}:reconcile",
      "success_status": 200,
      "data_schema": "ModelDeploymentMutationResult"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/configuration",
      "success_status": 200,
      "data_schema": "ConfigurationRevision"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/configuration:diff",
      "success_status": 200,
      "data_schema": "ConfigurationDiff"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/configuration:validate",
      "success_status": 200,
      "data_schema": "ConfigurationValidation"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/configuration:plan",
      "success_status": 200,
      "data_schema": "ConfigurationPlan"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/configuration:reconcile",
      "success_status": 200,
      "data_schema": "ReconciliationStatus"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/configuration/reconciliations/{reconciliation_id}",
      "success_status": 200,
      "data_schema": "ReconciliationStatus"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/configuration:rollback",
      "success_status": 200,
      "data_schema": "RollbackPlan"
    },
    {
      "method": "GET",
      "path": "/admin/api/v1/academic-assets",
      "success_status": 200,
      "data_schema": "AcademicAssetReadinessList"
    }
  ],
  "feature_gated_route_groups": [
    {
      "id": "configuration",
      "enabled_when": "the configuration service is configured",
      "disabled_behavior": "routes are absent",
      "paths": [
        "/admin/api/v1/configuration",
        "/admin/api/v1/configuration:diff",
        "/admin/api/v1/configuration:validate",
        "/admin/api/v1/configuration:plan",
        "/admin/api/v1/configuration:reconcile",
        "/admin/api/v1/configuration/reconciliations/{reconciliation_id}",
        "/admin/api/v1/configuration:rollback"
      ]
    },
    {
      "id": "model-deployment-read",
      "enabled_when": "the model controller and durable deployment repository are configured",
      "disabled_behavior": "routes are absent",
      "paths": [
        "/admin/api/v1/model-deployments",
        "/admin/api/v1/model-deployments/{name}",
        "/admin/api/v1/model-deployments/{name}/history",
        "/admin/api/v1/model-deployments/{name}/status"
      ]
    },
    {
      "id": "model-deployment-preview",
      "enabled_when": "the model controller renderer is configured",
      "disabled_behavior": "routes are absent",
      "paths": [
        "/admin/api/v1/model-deployments:validate-preview",
        "/admin/api/v1/model-deployments:plan-preview"
      ]
    },
    {
      "id": "model-deployment-mutation",
      "enabled_when": "model controller writes are enabled",
      "disabled_behavior": "capabilities, drain, rollback, and reconcile are absent; apply, adopt, and delete return a 501 problem when preview is enabled without a writer",
      "paths": [
        "/admin/api/v1/model-deployments:capabilities",
        "/admin/api/v1/model-deployments:apply",
        "/admin/api/v1/model-deployments/{name}:drain",
        "/admin/api/v1/model-deployments/{name}:rollback",
        "/admin/api/v1/model-deployments/{name}:reconcile"
      ]
    }
  ],
  "feature_disabled_problem_routes": [
    {
      "method": "POST",
      "path": "/admin/api/v1/model-deployments:apply",
      "status": 501,
      "code": "model_deployment_writer_disabled"
    },
    {
      "method": "POST",
      "path": "/admin/api/v1/model-deployments/{name}:adopt",
      "status": 501,
      "code": "model_deployment_writer_disabled"
    },
    {
      "method": "DELETE",
      "path": "/admin/api/v1/model-deployments/{name}",
      "status": 501,
      "code": "model_deployment_writer_disabled"
    }
  ],
  "shared_context_query": [
    "project",
    "cluster",
    "region",
    "from",
    "to",
    "timezone"
  ],
  "operation_filters": [
    "limit",
    "cursor",
    "tenant_id",
    "model_id",
    "principal_id",
    "api_key_prefix",
    "status",
    "error_code"
  ],
  "observability_filters": [
    "model_id",
    "operation_id"
  ],
  "capacity_contract": {
    "allocation_state": "estimated from bounded Pod requests",
    "health_state": "unavailable without an explicit GPU health source",
    "kueue_quantities": [
      "nominal_quota",
      "reservation",
      "usage",
      "borrowed"
    ]
  },
  "model_deployment_configuration_options": {
    "endpoint": "/admin/api/v1/model-deployments:capabilities",
    "authority": "the installed InfrastructureEnvelope and its qualified model tuples",
    "source_revision_field": "configuration_revision",
    "option_fields": [
      "model_ref",
      "suggested_name",
      "namespace",
      "default_spec",
      "pool_choices",
      "local_queue_choices",
      "priority_class_choices",
      "tenant_choices",
      "scale_to_zero_qualified"
    ],
    "default_invariant": "every emitted default_spec passes the same live envelope validator with an accepted disposition",
    "failure_contract": "incomplete, malformed, unpinned, or currently unplaceable qualified tuples are omitted; the browser never fabricates a fallback"
  },
  "observability_component_fields": [
    "installed",
    "health",
    "data_present",
    "launch"
  ],
  "bounds": {
    "maximum_time_range_days": 31,
    "maximum_project_characters": 128,
    "maximum_cluster_characters": 128,
    "maximum_region_characters": 64,
    "maximum_timezone_characters": 64,
    "maximum_model_search_characters": 128,
    "maximum_tenant_characters": 120,
    "maximum_model_id_characters": 128,
    "maximum_principal_id_characters": 200,
    "maximum_api_key_prefix_characters": 64,
    "maximum_error_code_characters": 64,
    "maximum_model_page_size": 256,
    "maximum_operation_page_size": 200,
    "maximum_access_page_size": 1000,
    "maximum_model_deployment_namespace_characters": 63,
    "maximum_model_deployment_name_characters": 253,
    "maximum_model_deployment_page_size": 200,
    "maximum_cursor_characters": 512
  },
  "forbidden_response_fields": [
    "request_body",
    "response_body",
    "request_ciphertext",
    "response_ciphertext",
    "request_hmac",
    "response_hmac",
    "idempotency_key",
    "error_detail",
    "traceparent",
    "gpu_uuids",
    "pod_uid",
    "node_uid",
    "raw_api_key",
    "database_url",
    "kubeconfig"
  ]
}
