[Unit]
Description=FS2 read-only credential evidence authority
After=network-online.target
Wants=network-online.target
ConditionPathIsReadWrite=/run
ConditionPathExists=/etc/fs2-credential-authority/config.json

[Service]
Type=simple
User=root
Group=fs2-credential-auditors
UMask=0077
RuntimeDirectory=fs2-credential-authority
RuntimeDirectoryMode=0750
StateDirectory=fs2-credential-authority
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/fs2/k8s-inference/scripts/credential_authority_service.py
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/run/fs2-credential-authority /var/lib/fs2-credential-authority
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
