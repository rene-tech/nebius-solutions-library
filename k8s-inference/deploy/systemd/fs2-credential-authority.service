[Unit]
Description=FS2 read-only credential evidence authority
After=network-online.target fs2-credential-authority.socket
Wants=network-online.target
Requires=fs2-credential-authority.socket
ConditionPathIsReadWrite=/run
ConditionPathExists=/etc/fs2-credential-authority/config.json
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=fs2-credential-auditors
UMask=0077
StateDirectory=fs2-credential-authority
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/fs2/k8s-inference/scripts/credential_authority_service.py
Restart=always
RestartSec=2s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/run/fs2-credential-authority /var/lib/fs2-credential-authority
# AF_INET/AF_INET6 are restricted to the independently operated mTLS evidence
# anchor by the host firewall. Provider APIs and the anchor are read-only.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
