[Unit]
Description=FS2 credential evidence authority activation socket

[Socket]
ListenStream=/run/fs2-credential-authority/v1.sock
FileDescriptorName=credential-authority
SocketMode=0660
SocketUser=root
SocketGroup=fs2-credential-auditors
DirectoryMode=0750
Accept=no
RemoveOnStop=no

[Install]
WantedBy=sockets.target
