{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/bindcraft-open-freebindcraft-parameters/v1",
  "title": "Open FreeBindCraft parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "shard_count", "base_seed", "target_chains", "hotspots", "binder_length", "accepted_designs_per_shard", "max_trajectories_per_shard"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/bindcraft-open-freebindcraft-parameters/v1"},
    "shard_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "base_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "target_chains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9]$"}
    },
    "hotspots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chain", "residue"],
        "properties": {
          "chain": {"type": "string", "pattern": "^[A-Za-z0-9]$"},
          "residue": {"type": "integer", "minimum": 1, "maximum": 9999}
        }
      }
    },
    "binder_length": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 40, "maximum": 200},
        "maximum": {"type": "integer", "minimum": 40, "maximum": 200}
      }
    },
    "accepted_designs_per_shard": {"type": "integer", "minimum": 1, "maximum": 10},
    "max_trajectories_per_shard": {"type": "integer", "minimum": 1, "maximum": 1000}
  }
}
