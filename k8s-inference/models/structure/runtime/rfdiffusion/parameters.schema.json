{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/rfdiffusion-upstream-base-parameters/v1",
  "title": "RFdiffusion upstream Base checkpoint parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "shard_count", "base_seed", "contigs", "hotspots", "diffusion_steps", "motif_rmsd_max_a"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/rfdiffusion-upstream-base-parameters/v1"},
    "shard_count": {"type": "integer", "minimum": 1, "maximum": 128},
    "base_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "contigs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "minimum_length", "maximum_length"],
            "properties": {
              "kind": {"const": "generated"},
              "minimum_length": {"type": "integer", "minimum": 1, "maximum": 512},
              "maximum_length": {"type": "integer", "minimum": 1, "maximum": 512}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "chain", "start", "end"],
            "properties": {
              "kind": {"const": "motif"},
              "chain": {"type": "string", "pattern": "^[A-Za-z0-9]$"},
              "start": {"type": "integer", "minimum": 1, "maximum": 9999},
              "end": {"type": "integer", "minimum": 1, "maximum": 9999}
            }
          }
        ]
      }
    },
    "hotspots": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chain", "residue"],
        "properties": {
          "chain": {"type": "string", "pattern": "^[A-Za-z0-9]$"},
          "residue": {"type": "integer", "minimum": 1, "maximum": 9999}
        }
      }
    },
    "diffusion_steps": {"type": "integer", "minimum": 10, "maximum": 200},
    "motif_rmsd_max_a": {"type": "number", "minimum": 0.1, "maximum": 5.0}
  }
}
