#!/usr/bin/env python3
"""Versioned native BindCraft/PyRosetta image entrypoint."""
import runpy, sys
if len(sys.argv) < 2 or sys.argv[1] not in {"run-trajectory", "aggregate"}:
    raise SystemExit("usage: bindcraft-batch {run-trajectory|aggregate} ...")
runpy.run_path("/opt/fs2/bindcraft/runtime_entrypoint.py", run_name="__main__")
