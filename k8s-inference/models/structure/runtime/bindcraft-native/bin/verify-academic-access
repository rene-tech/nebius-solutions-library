#!/usr/bin/env python3
"""Fail-closed gate for tenant-private PyRosetta authorization."""
import argparse
import pathlib
a = argparse.ArgumentParser(); a.add_argument("--profile", required=True); a.add_argument("--receipt", default="/var/run/fs2/academic-access-receipt.json")
args = a.parse_args()
if args.profile != "academic":
    raise SystemExit("academic profile required")
if not pathlib.Path(args.receipt).is_file():
    raise SystemExit("academic access receipt missing")
