  "level_contract": {
    "below_all_thresholds": "Off",
    "boundaries": {
      "end": "the first semantic result the model emits, which for a batch runtime is the same instant as semantic ready",
      "start": "the instant the Pod is scheduled onto a Ready accelerator node, which is the capacity-available point for a batch stage"
    },
    "boundary_rationale": "The published contract assigns queue admission and placement to capacity wait, and assigns image setup, artifact restore, runtime initialisation, weight transfer and compilation to model start. Sandbox and volume setup therefore counts inside model start, not outside it. Measuring from container start instead would silently hide the recursive volume-ownership pass, which the baseline trials showed is the single largest contributor.",
    "measured_value": "model_start_seconds",
    "note": "Capacity wait and Kueue queue wait are reported separately and are deliberately excluded from the level evaluation, exactly as the published contract requires.",
    "source": "k8s-inference/FAST_START_LEVELS.md",
    "thresholds_seconds": {
      "L1": 300,
      "L2": 120,
      "L3": 60,
      "L4": 30
    }
  },
