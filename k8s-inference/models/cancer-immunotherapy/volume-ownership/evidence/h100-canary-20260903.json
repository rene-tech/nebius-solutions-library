    "defect_found_and_fixed_by_this_live_run": {
      "cause": "The Job dropped CAP_FSETID, so the kernel silently cleared S_ISGID on chmod of a directory whose group the caller does not hold.",
      "fix": "FSETID added to the bootstrap capability set, and the script now verifies the stamped root and exits non-zero instead of reporting success.",
      "further_defects_found_in_review": [
        "find -exec chgrp/chmod dereferenced symlinks, so a link inside the volume could rewrite a target outside it; a reproduction turned an external 0400 file into 0660.",
        "The adopted root could be an arbitrary descendant, while the kubelet only ever compares the mounted volume root.",
        "Rendering the bootstrap beside the stages ordered nothing, so stages could run before or concurrently with the adoption."
      ],
      "regression_tests": [
        "catalog/runtime/tests/test_volume_ownership.py::BootstrapJobTests::test_fsetid_is_present_because_setgid_is_the_whole_marker",
        "catalog/runtime/tests/test_volume_ownership.py::BootstrapScriptExecutionTests::test_a_root_the_kernel_refused_to_stamp_fails_the_job"
      ],
      "symptom": "Adoption left mode 775 instead of 2775 and re-adopted on every pass."
    },
