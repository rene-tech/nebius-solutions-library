{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schemas/cancer-immunotherapy-model-source-qualification/v1",
  "title": "Cancer immunotherapy model source qualification manifest",
  "description": "Decision-grade mapping from customer-requested model names to exact upstream sources, immutable revisions, license/access gates, H100 fit and semantic validators. Research artifact only: it records what was retrieved from primary sources on a stated date and never asserts deployment or qualification state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "retrieved_at",
    "workload",
    "use_class",
    "evidence_policy",
    "discovery",
    "models",
    "open_questions"
  ],
  "properties": {
    "schema": {
      "const": "fs2-serve.nebius.ai/cancer-immunotherapy-model-source-qualification/v1"
    },
    "retrieved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "UTC date on which every revision, license and gate field in this manifest was retrieved from its primary source."
    },
    "workload": {
      "type": "string",
      "minLength": 1
    },
    "use_class": {
      "type": "string",
      "enum": [
        "academic-non-commercial",
        "commercial",
        "mixed"
      ],
      "description": "Declared use class of the proof of concept. License gating verdicts are only valid for this use class."
    },
    "evidence_policy": {
      "type": "string",
      "minLength": 1,
      "description": "States that this manifest is read-only research and carries no deployment or qualification claim."
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/model"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/open_question"
      },
      "description": "Smallest precise user questions still outstanding. Empty only when every requested name is unambiguously resolved."
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read-only observations of what already exists, recorded so downstream tasks do not re-derive them. Cluster observations and local build-host observations are kept strictly separate: a cache on the operator's workstation is not a cluster volume, and a credential that works on one does not imply the other.",
      "required": [
        "method",
        "cluster",
        "build_host"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "How the observations were made, including the fact that they were read-only."
        },
        "cluster": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reachable",
            "context",
            "project",
            "region",
            "observations"
          ],
          "properties": {
            "reachable": {
              "type": "boolean"
            },
            "context": {
              "type": [
                "string",
                "null"
              ]
            },
            "kubeconfig": {
              "type": [
                "string",
                "null"
              ]
            },
            "project": {
              "type": [
                "string",
                "null"
              ]
            },
            "region": {
              "type": [
                "string",
                "null"
              ]
            },
            "accelerator_class": {
              "type": [
                "string",
                "null"
              ]
            },
            "gpu_nodes": {
              "type": [
                "integer",
                "null"
              ]
            },
            "gpus_per_node": {
              "type": [
                "integer",
                "null"
              ]
            },
            "gpu_pool_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "capacity_source": {
              "type": [
                "string",
                "null"
              ]
            },
            "nvidia_driver_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        "build_host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observations"
          ],
          "properties": {
            "observations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        "unverified": {
          "type": "array",
          "description": "Things deliberately not concluded from the observations above, so a later reader does not over-read them.",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_name",
        "role",
        "resolution",
        "identity",
        "code",
        "weights",
        "runtime_recommendation",
        "h100_fit",
        "semantic_validator",
        "access_gates",
        "blockers",
        "sources"
      ],
      "properties": {
        "requested_name": {
          "type": "string",
          "minLength": 1,
          "description": "The name exactly as the customer wrote it."
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "supporting",
            "alternative"
          ],
          "description": "primary/secondary follow the customer's own volume split; supporting models are pipeline dependencies; alternative models are operator-chosen substitutes."
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "rationale"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "resolved",
                "resolved-pending-confirmation",
                "ambiguous"
              ],
              "description": "resolved: exactly one upstream artifact matches the requested name. resolved-pending-confirmation: one artifact matches strongly but the name is generic or a newer generation exists, so a one-line user confirmation is recorded in open_questions. ambiguous: do not proceed without an answer."
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "rejected_candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "candidate",
                  "reason"
                ],
                "properties": {
                  "candidate": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_name",
            "upstream_owner",
            "what_it_is"
          ],
          "properties": {
            "canonical_name": {
              "type": "string",
              "minLength": 1
            },
            "upstream_owner": {
              "type": "string",
              "minLength": 1
            },
            "what_it_is": {
              "type": "string",
              "minLength": 1,
              "description": "One sentence distinguishing a model from a product, workflow or pipeline."
            },
            "artifact_class": {
              "type": "string",
              "enum": [
                "generative-design-model",
                "structure-prediction-model",
                "sequence-design-model",
                "language-model",
                "optimization-framework",
                "pipeline"
              ]
            },
            "paper": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "code": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "revision",
            "revision_kind",
            "license",
            "commercial_use"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "format": "uri"
            },
            "revision": {
              "type": "string",
              "minLength": 7,
              "description": "Immutable git commit SHA, or a tag paired with its resolved commit SHA."
            },
            "revision_kind": {
              "type": "string",
              "enum": [
                "tag",
                "commit",
                "release-tag-and-commit"
              ]
            },
            "revision_label": {
              "type": [
                "string",
                "null"
              ]
            },
            "package": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "index": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "sdist_sha256": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "wheel_sha256": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "commercial_use": {
              "type": "string",
              "enum": [
                "permitted",
                "prohibited",
                "requires-separate-license",
                "unverified"
              ]
            }
          }
        },
        "weights": {
          "type": "array",
          "description": "Every distinct weight artifact needed to run the model. Empty only when the model ships no learned parameters.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "host",
              "locator",
              "revision",
              "license",
              "commercial_use",
              "gate"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "host": {
                "type": "string",
                "enum": [
                  "huggingface",
                  "ngc",
                  "github-release",
                  "upstream-http",
                  "institutional"
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "description": "Immutable revision: HuggingFace commit SHA, OCI digest, or a published file checksum."
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "size_note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "commercial_use": {
                "type": "string",
                "enum": [
                  "permitted",
                  "prohibited",
                  "requires-separate-license",
                  "unverified"
                ]
              },
              "redistribution": {
                "type": "string",
                "enum": [
                  "permitted",
                  "prohibited",
                  "permitted-with-attribution",
                  "unverified"
                ]
              },
              "gate": {
                "type": "string",
                "enum": [
                  "none",
                  "click-through",
                  "account-required",
                  "approval-required",
                  "paid-license"
                ]
              }
            }
          }
        },
        "runtime_recommendation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "choice",
            "rationale"
          ],
          "properties": {
            "choice": {
              "type": "string",
              "enum": [
                "existing-nim",
                "open-runtime",
                "custom-workflow-container"
              ],
              "description": "existing-nim is only valid when an official NIM for this exact model was observed in the registry; it is never inferred from a sibling model."
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "nim_available": {
              "type": "boolean",
              "description": "Whether an official NVIDIA NIM for this exact model was observed. Snapshot support is never assumed from this flag."
            },
            "base_image_hint": {
              "type": [
                "string",
                "null"
              ]
            },
            "serving_shape": {
              "type": "string",
              "enum": [
                "http-service",
                "batch-job",
                "both"
              ],
              "description": "Batch-job models produce ranked design sets over minutes to hours and must not be modelled as low-latency HTTP endpoints."
            }
          }
        },
        "h100_fit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "gpu_count",
            "evidence"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "documented-supported",
                "expected-compatible-untested",
                "documented-unsupported",
                "unverified"
              ],
              "description": "documented-supported requires an upstream statement naming H100 or Hopper. Anything inferred from a generic CUDA claim is expected-compatible-untested."
            },
            "gpu_count": {
              "type": "integer",
              "minimum": 0
            },
            "vram_note": {
              "type": [
                "string",
                "null"
              ]
            },
            "multi_gpu": {
              "type": "string",
              "enum": [
                "single-gpu-only",
                "data-parallel-independent-jobs",
                "tensor-parallel",
                "unverified"
              ]
            },
            "cpu_or_host_dependency": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "semantic_validator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fixture",
            "invocation",
            "success_criteria"
          ],
          "properties": {
            "fixture": {
              "type": "string",
              "minLength": 1,
              "description": "A concrete, reproducible input that ships with the upstream repository or is a named public structure."
            },
            "invocation": {
              "type": "string",
              "minLength": 1
            },
            "success_criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "Scientific acceptance conditions. A transport-level success such as HTTP 200 is never sufficient on its own."
            },
            "expected_runtime_note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "access_gates": {
          "type": "array",
          "description": "Exact one-time credential or license-acceptance steps required before the artifact can be fetched.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gate_id",
              "action",
              "blocking"
            ],
            "properties": {
              "gate_id": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "grantor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "blocking": {
                "type": "boolean"
              },
              "credential_handling": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "External conditions preventing onboarding. Empty means nothing outside our control blocks this model."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "established"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "established": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "open_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "models",
        "question",
        "default_if_unanswered"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "description": "The smallest precise question that resolves the ambiguity. It must be answerable in one line."
        },
        "default_if_unanswered": {
          "type": "string",
          "minLength": 1,
          "description": "What onboarding will assume if no answer arrives, so that work is never blocked silently."
        }
      }
    }
  }
}
