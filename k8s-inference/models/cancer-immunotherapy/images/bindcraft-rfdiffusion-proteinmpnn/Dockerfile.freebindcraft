COPY runtime/fetch_verified.py /opt/fs2/fetch_verified.py
RUN set -eux; \
    apt-get update; \
    apt-get install --yes --no-install-recommends gcc; \
    python /opt/fs2/fetch_verified.py "${CYTHON_URL}" "${CYTHON_SHA256}" /tmp/Cython-3.0.12-cp310-cp310-manylinux_2_17_x86_64.manylinux2014_x86_64.whl; \
    python -m pip install --no-cache-dir /tmp/Cython-3.0.12-cp310-cp310-manylinux_2_17_x86_64.manylinux2014_x86_64.whl; \
    python /opt/fs2/fetch_verified.py "${FREESASA_URL}" "${FREESASA_SHA256}" /tmp/freesasa.tar.gz; \
