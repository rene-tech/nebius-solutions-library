{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2.nebius.ai/schemas/structure-secondary-image-lock.schema.json",
  "title": "FS2 secondary-structure runtime image lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "platform", "registry_default", "publication_policy", "superseded_publications", "images"],
  "properties": {
    "$schema": {"const": "./image-lock.schema.json"},
    "schema": {"const": "fs2.nebius.ai/structure-secondary-image-lock/v2"},
    "platform": {"const": "linux/amd64"},
    "registry_default": {"$ref": "#/$defs/registryRoot"},
    "publication_policy": {"const": "explicit-non-overwriting-build-qualified-tags"},
    "superseded_publications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "digest", "deployable", "reason"],
        "properties": {
          "id": {"type": "string"},
          "target": {"type": "string"},
          "digest": {"$ref": "#/$defs/digest"},
          "deployable": {"const": false},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dockerfile", "repository", "tag", "source", "base_images", "build_args", "external_artifacts", "runtime_contract", "accelerator_support", "smoke", "published_digest"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "dockerfile": {"type": "string", "pattern": "^Dockerfile\\."},
          "repository": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
          "tag": {"type": "string", "pattern": "^[0-9a-f]{40}-h100-r[1-9][0-9]*$"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "revision", "tag", "source_date_epoch"],
            "properties": {
              "repository": {"type": "string", "format": "uri"},
              "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "tag": {"type": "string", "pattern": "^v[0-9]"},
              "source_date_epoch": {"type": "integer", "minimum": 1}
            }
          },
          "base_images": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}},
          "build_args": {"type": "object", "additionalProperties": {"type": "string"}},
          "external_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
          "runtime_contract": {"$ref": "#/$defs/runtimeContract"},
          "accelerator_support": {"$ref": "#/$defs/acceleratorSupport"},
          "smoke": {"type": "string", "pattern": "^/"},
          "published_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "registryRoot": {"type": "string", "pattern": "^[a-z0-9.-]+/[a-z0-9][a-z0-9._/-]*[a-z0-9]$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "mount", "revision", "baked_into_image"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "state": {"enum": ["available-external", "operator-staged-private", "third-party-mirror-verified-not-publisher-byte-compared"]},
        "mount": {"type": "string", "pattern": "^/"},
        "revision": {"type": "string", "minLength": 1},
        "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "localization_marker": {"type": "string", "pattern": "^/"},
        "expected_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[^/]"}
        },
        "baked_into_image": {"const": false}
      }
    },
    "runtimeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "subcommands", "network_policy", "required_mounts", "commands"],
      "properties": {
        "entrypoint": {"type": "string", "pattern": "^/"},
        "preprocess_entrypoint": {"type": "string", "pattern": "^/"},
        "subcommands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "network_policy": {"type": "string", "minLength": 1},
        "required_mounts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/"}
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "acceleratorSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["h100", "blackwell"],
      "properties": {
        "h100": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compute_capability", "status"],
          "properties": {
            "compute_capability": {"const": "9.0"},
            "status": {"type": "string"},
            "extension": {"type": "string"}
          }
        },
        "blackwell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "scope", "native_targets"],
          "properties": {
            "status": {"enum": ["not-qualified", "unsupported"]},
            "scope": {"type": "string"},
            "native_targets": {"type": "array", "maxItems": 0}
          }
        }
      }
    }
  }
}
