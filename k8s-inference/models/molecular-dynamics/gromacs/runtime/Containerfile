ARG NVIDIA_GROMACS_IMAGE=cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/fs2-platform/gromacs-ngc@sha256:0e52e3ae971453898956379952b9ea606f5400cbdb4d439773ecbae4d8f5ad59
FROM ${NVIDIA_GROMACS_IMAGE}
ARG SOURCE_REVISION=development

LABEL org.opencontainers.image.title="Scientific AI NVIDIA GROMACS workflow worker" \
      org.opencontainers.image.source="https://github.com/rene-tech/nebius-solutions-library/tree/main/k8s-inference/models/molecular-dynamics/gromacs" \
      org.opencontainers.image.revision=${SOURCE_REVISION}

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/fs2/gromacs OMP_NUM_THREADS=8
COPY requirements.lock /opt/fs2/requirements.lock
RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 python3-pip python-is-python3 \
    && python3 -m pip install --no-cache-dir --require-hashes -r /opt/fs2/requirements.lock \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 fs2 \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/fs2 fs2 \
    && mkdir -p /mnt/fs2-scientific \
    && chown 10001:10001 /mnt/fs2-scientific
COPY fs2_gromacs /opt/fs2/gromacs/fs2_gromacs
USER 10001:10001
WORKDIR /mnt/fs2-scientific
ENTRYPOINT ["python3", "-m", "fs2_gromacs.worker"]
