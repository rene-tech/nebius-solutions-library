# syntax=docker/dockerfile:1
ARG BASE_IMAGE=cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/fs2-models/h100-fleet/molmim@sha256:fd59b1b45206fe5067033dd7385469ea54e6b670bdd530276e75857f9b459958
FROM ${BASE_IMAGE}

ARG FS2_SOURCE_COMMIT
LABEL ai.nebius.fs2.runtime-portability="dynamic-cuda-capability" \
      org.opencontainers.image.revision="${FS2_SOURCE_COMMIT}" \
      ai.nebius.fs2.molmim-port="perceiver-cmaes-20260918"

RUN python -m pip install --no-cache-dir cma==4.4.0

COPY k8s-inference/models/bionemo/molmim/server.py /opt/fs2/server.py
