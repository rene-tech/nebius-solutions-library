# Build from the solutions-library repository root.
FROM python@sha256:0f5b26b9518d002b6173fd61daad821fa340635ebfec5bba471013f9ca114579
COPY k8s-inference/models/aging/requirements-http.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt
COPY k8s-inference/models/aging /opt/fs2/aging
WORKDIR /opt/fs2
ENV AGING_MODEL=phenoage AGING_DEVICE=cpu PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 65532:65532
EXPOSE 8000
ENTRYPOINT ["python", "-m", "uvicorn", "aging.server:app", "--host", "0.0.0.0", "--port", "8000"]
