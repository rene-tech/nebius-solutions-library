{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/lerobot-source-reference/v1",
  "title": "LeRobot external dataset source reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/lerobot-source-reference/v1"},
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repo_id", "revision"],
          "properties": {
            "kind": {"const": "huggingface"},
            "repo_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "credential_binding": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{0,62}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "storage_binding", "object_prefix", "manifest_sha256"],
          "properties": {
            "kind": {"const": "object-store"},
            "storage_binding": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
            "object_prefix": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,512}$"},
            "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    }
  }
}
