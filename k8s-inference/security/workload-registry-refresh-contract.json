  "failure_policy": {
    "keep_last_valid_revision": true,
    "delete_secret": false,
    "admit_new_digest_after_expiry": false,
    "surface_readiness_failure_before_expiry": true
  },
  "runtime": {
    "owner_id": null,
    "source_commit": null,
    "source_tree": null,
    "image": null,
    "sbom_sha256": null,
    "provenance_sha256": null,
    "admission_proxy_id": null,
    "admission_proxy_executable_sha256": null
  }
