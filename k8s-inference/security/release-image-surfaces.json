{
  "schema": "fs2-serve.nebius.ai/release-image-surfaces/v1",
  "terraform_roots": [
    "modules/jobset-controller",
    "stages/foundation",
    "stages/workloads"
  ],
  "terraform_helm_releases": [
    "modules/jobset-controller/main.tf::jobset",
    "stages/foundation/observability_backends.tf::otel_cluster",
    "stages/foundation/observability_backends.tf::tempo",
    "stages/foundation/releases.tf::cert_manager",
    "stages/foundation/releases.tf::cloudnative_pg",
    "stages/foundation/releases.tf::envoy_gateway",
    "stages/foundation/releases.tf::filesystem_csi",
    "stages/foundation/releases.tf::keda",
    "stages/foundation/releases.tf::kserve_crd",
    "stages/foundation/releases.tf::kserve_resources",
    "stages/foundation/releases.tf::kueue",
    "stages/foundation/releases.tf::loki",
    "stages/foundation/releases.tf::monitoring",
    "stages/foundation/releases.tf::otel_gateway",
    "stages/foundation/releases.tf::otel_node",
    "stages/workloads/control_plane.tf::control_plane",
    "stages/workloads/modelexpress.tf::modelexpress",
    "stages/workloads/observability.tf::dcgm_exporter"
  ],
  "direct_installer_scripts": [
    "addons/scripts/install.sh",
    "observability/scripts/install.sh",
    "stages/infrastructure/bootstrap/bootstrap.sh"
  ],
  "direct_render_surfaces": [
    "addons/cert-manager",
    "addons/envoy-gateway",
    "addons/keda",
    "addons/kserve",
    "addons/kserve-crd",
    "addons/kueue",
    "bootstrap/cert-manager",
    "bootstrap/dcgm-exporter",
    "bootstrap/envoy-gateway",
    "bootstrap/kserve",
    "bootstrap/kserve-crd",
    "bootstrap/kube-prometheus-stack",
    "bootstrap/kueue",
    "observability/kube-prometheus-stack",
    "observability/loki",
    "observability/otel-gateway",
    "observability/otel-node"
  ],
  "direct_surface_anchors": [
    {"id": "addons/cert-manager", "script": "addons/scripts/install.sh", "anchor": "upgrade --install cert-manager "},
    {"id": "addons/envoy-gateway", "script": "addons/scripts/install.sh", "anchor": "upgrade --install envoy-gateway "},
    {"id": "addons/keda", "script": "addons/scripts/install.sh", "anchor": "upgrade --install keda "},
    {"id": "addons/kserve", "script": "addons/scripts/install.sh", "anchor": "upgrade --install kserve \""},
    {"id": "addons/kserve-crd", "script": "addons/scripts/install.sh", "anchor": "upgrade --install kserve-crd "},
    {"id": "addons/kueue", "script": "addons/scripts/install.sh", "anchor": "upgrade --install kueue "},
    {"id": "bootstrap/cert-manager", "script": "stages/infrastructure/bootstrap/bootstrap.sh", "anchor": "install_chart \"$prefix-cert-manager\" cert-manager cert-manager "},
    {"id": "bootstrap/dcgm-exporter", "script": "stages/infrastructure/bootstrap/bootstrap.sh", "anchor": "install_chart \"$prefix-dcgm\" fs2-observability dcgm-exporter "},
    {"id": "bootstrap/envoy-gateway", "script": "stages/infrastructure/bootstrap/bootstrap.sh", "anchor": "install_chart \"$prefix-envoy\" envoy-gateway-system envoy-gateway "},
    {"id": "bootstrap/kserve", "script": "stages/infrastructure/bootstrap/bootstrap.sh", "anchor": "install_chart \"$prefix-kserve\" kserve kserve-resources "},
    {"id": "bootstrap/kserve-crd", "script": "stages/infrastructure/bootstrap/bootstrap.sh", "anchor": "install_chart \"$prefix-kserve-crd\" kserve kserve-crd"},
    {"id": "bootstrap/kube-prometheus-stack", "script": "stages/infrastructure/bootstrap/bootstrap.sh", "anchor": "install_chart \"$prefix-monitoring\" fs2-observability kube-prometheus-stack"},
    {"id": "bootstrap/kueue", "script": "stages/infrastructure/bootstrap/bootstrap.sh", "anchor": "install_chart \"$prefix-kueue\" kueue-system kueue"},
    {"id": "observability/kube-prometheus-stack", "script": "observability/scripts/install.sh", "anchor": "hctl upgrade --install fs2-monitoring "},
    {"id": "observability/loki", "script": "observability/scripts/install.sh", "anchor": "hctl upgrade --install fs2-loki "},
    {"id": "observability/otel-gateway", "script": "observability/scripts/install.sh", "anchor": "hctl upgrade --install fs2-otel-gateway "},
    {"id": "observability/otel-node", "script": "observability/scripts/install.sh", "anchor": "hctl upgrade --install fs2-otel-node "}
  ],
  "catalog_image_sources": [
    "catalog/runtime/contracts/scientific-execution-map.json",
    "catalog/runtime/deployment-runtimes",
    "catalog/runtime/models",
    "catalog/runtime/native"
  ],
  "static_manifest_roots": [
    "acceptance",
    "addons/smoke",
    "models",
    "stages/infrastructure/smoke"
  ],
  "first_party_builds": [
    "components/admin-console/Dockerfile",
    "components/control-plane/Dockerfile"
  ]
}
