{
  "schema": "fs2-serve.nebius.ai/credential-authority-deployment-contract/v7",
  "mode": "read-only",
  "configuration_schema": "security/credential-authority-config.schema.json",
  "source_trust_policy": "security/credential-evidence-source-trust.json",
  "service": "deploy/systemd/fs2-credential-authority.service",
  "socket": "deploy/systemd/fs2-credential-authority.socket",
  "fixed_components": {
    "authority": "scripts/credential_authority_service.py",
    "provider": "scripts/credential_authority_provider.py",
    "client": "scripts/credential_provider_adapter.py",
    "producer_signer": "scripts/credential_evidence_signer.py",
    "external_anchor_client": "scripts/credential_external_anchor_client.py",
    "verifier": "scripts/credential_evidence.py",
    "transparency_verifier": "scripts/credential_transparency.py",
    "operator_handoff_verifier": "scripts/operator_handoff_readonly.py"
  },
  "required_artifact_scope_categories": [
    "operator-receipts",
    "secure-handoff",
    "task-run-roots",
    "terraform-workdirs"
  ],
  "required_artifact_mount_root": "/srv/fs2-credential-custody",
  "terraform_state_source": {
    "operation": "terraform state pull",
    "configuration_owner": "root",
    "configuration_writable_by_clients": false,
    "allowed_backend_types": ["remote", "s3"],
    "caller_state_paths_allowed": false
  },
  "identity_boundaries": {
    "evidence_identity": "provider-expiring-viewer-only",
    "release_identity": "provider-enforced-workload-session-terraform-release-audience",
    "operator_read_identity": "existing-provider-expiring-viewer-kubeconfig-only",
    "operator_proxy_identity": "distinct-projected-token-only-service-discovery-and-pods-portforward",
    "scoped_credential_delivery_identity": "distinct-projected-token-one-named-secret-no-list-or-other-get",
    "global_secret_inventory_identity": "distinct-projected-service-account-token-exact-rbac-closure",
    "global_secret_inventory_kubeconfig": "root-owned-mode-0600-digest-pinned",
    "client_file_custody": "root-owned-mode-0640-distinct-purpose-uid-gid-cgroup-and-process",
    "operation_callers": "exact-operation-to-purpose-map-enforced-by-client-and-so-peercred-authority",
    "operator_proxy_rbac": "exact-fs2-system-role-rolebinding-serviceaccount-uid-rv-and-content-binding",
    "backend_access": "provider-enforced-one-hour-workload-session-per-command-purpose-no-ambient-aws-or-s3",
    "backend_authorization": "provider-expanded-exact-object-grants-no-direct-cross-project-impersonation-or-unscoped-actions",
    "non_release_backend_access": "read-only-no-put-delete-or-multipart",
    "release_backend_access": "state-get-put-and-lock-get-put-delete-no-state-or-version-delete",
    "release_access_or_auth_keys_allowed": false,
    "provider_authorization_closure": "organization-and-descendants-no-direct-or-impersonation-permits",
    "ambient_profile_allowed": false,
    "maximum_release_lifetime_seconds": 3600,
    "maximum_cluster_inventory_lifetime_seconds": 3600
  },
  "inventory": {
    "terraform_secrets": "state-and-live-namespace-name-uid-rv-content-class-generation-binding",
    "helm_release_secrets": "pinned-provider-adapter-exact-uid-rv-content-release-revision-status-binding",
    "service_account_token_secrets": "exact-owner-reference-and-live-service-account-uid-binding",
    "exemption_maximum_lifetime_days": 30,
    "all_project_iam_and_all_cluster_secrets_required": true,
    "uninstantiated_optional_or-dependency_addresses_allowed": true,
    "optional_class_absence": "source-registry-declared-and-provider-proved-all-addresses-absent",
    "partial_optional_class_activation_allowed": false,
    "feature_gated_class_activation": "exact-root-owned-terraform-state-marker-class-and-group-boolean",
    "missing_feature_marker_means_disabled": false,
    "enabled_feature_group_requires_all_fixed-generation-addresses": true,
    "disabled_feature_group_allows_managed-addresses": false,
    "partial_feature_group_activation_allowed": false,
    "nested_module_credential_addresses": "exact-owning-root-and-complete-module-path",
    "module_instance_keys": "canonicalized-only-for-registered-address-comparison",
    "root-level-or-separate-state-alias_allowed": false,
    "every_observed_managed_resource_must_be-classified": true,
    "fixed-v1-secret-adoption": "exact-registry-address-plus-state-live-uid-rv-and-provider-content-no-mutation",
    "fixed-v1-mutable-predecessor_current_write_allowed": false,
    "versioned-successor-secret-class-generation-content-and-immutable-required": true,
    "class_adapter_input_scope": "one-class-all-contiguous-retained-generations-no-global-maps",
    "iam_access_key_inventory": "provider-metadata-projection-before-serialization-zero-secret-fields-observed"
  },
  "state_migration": {
    "mode": "additive-copy-only",
    "initialization_mode": "legacy-copy",
    "source_retained": true,
    "destination_must_be_empty_or-exact-copy": true,
    "overwrite_allowed": false,
    "provider_version_id_required_after_copy": true,
    "wrapper_init_requires_verified_exact_copy": true,
    "execution_authorized": false
  },
  "greenfield_bootstrap": {
    "initialization_mode": "greenfield-empty",
    "legacy_state_or_adoption_evidence_allowed": false,
    "backend_object_and_versions_must_be_absent": true,
    "backend_lock_must_be_absent": true,
    "provider_attested_all_project_iam_inventory_required": true,
    "provider_attested_all_cluster_secret_inventory_required": true,
    "managed_prior_state_must_be_empty": true,
    "fixed_generation_one_create_requires_this_contract": true,
    "fresh_reobservation_required_at_plan_and_apply": true,
    "post_first_apply_mode": "remote-established",
    "post_first_apply_transition": "provider-observed-plan-and-apply-receipt-bound-lineage-version-state-and-credential-genesis",
    "post_first_apply_identity_receipt": "automatic-provider-observed-write-once-before-policy-promotion",
    "post_apply_crash_recovery": "reconcile-immutable-saved-plan-gate-receipts-with-provider-observed-applied-plan",
    "policy_promotion_required_before_next_root_command": true,
    "execution_authorized": false
  },
  "saved_plan_execution": {
    "source_open_mode": "owner-only-o_nofollow-single-descriptor",
    "source_stability_fields": ["device", "inode", "mode", "uid", "gid", "links", "size", "mtime_ns", "ctime_ns", "sha256"],
    "runtime_object": "memfd",
    "required_runtime_seals": ["write", "grow", "shrink", "seal"],
    "terraform_argv": ["-chdir=<exact-root>", "apply", "-input=false", "/proc/self/fd/<sealed-plan>"],
    "native_gate_plan_authority": "kernel-terraform-ancestor-argv-and-fd-not-environment-path",
    "native_gate_pid_reuse_protection": "kernel-process-start-time-before-and-after-fd-duplication",
    "native_gate_execution": "one-new-nonreused-permanent-receipt-generation-per-apply",
    "post_apply_stability_check_required": true,
    "feature_activation_depends_on_native_gate": ["infrastructure", "workloads"],
    "embedded_module_gate_owner": {
      "module": "module.reference_data",
      "owning_root": "workloads",
      "child_native_gate_enabled": false,
      "embedded_mode_requires": "path.root != path.module",
      "parent_gate_inputs_forwarded": [
        "credential_migration_gate_receipt_path",
        "credential_migration_gate_source_commit",
        "credential_migration_gate_receipt_sha256",
        "credential_migration_gate_history",
        "credential_migration_phase"
      ],
      "module_depends_on": "terraform_data.credential_migration_gate",
      "standalone_root": "reference-data",
      "standalone_mode_requires": "path.root == path.module",
      "standalone_requires_exact_root_mapping": true
    }
  },
  "backend_custody": {
    "exact_project_bucket-parent-owner-object-key-endpoint": true,
    "exact_kms-key-parent-project": true,
    "exact_access-log-destination-parent-project-prefix": true,
    "versioning_and_object_lock_required": true,
    "caller_backend_session_hash_required": true,
    "provider_effective_permission_closure_required": true,
    "aws_shared_credentials_file": "root-owned-mode-0644-empty-digest-pinned-sentinel",
    "aws_home_shared_credentials_discovery_allowed": false,
    "actual_backend_credential_source": "provider-attested-workload-identity-exchange-with-nonsecret-identity-commitment",
    "backend_config": "root-owned-mode-0644-non-secret-digest-pinned",
    "ambient_aws_or_s3_environment_allowed": false
  },
  "evidence": {
    "producer_signature": "ed25519",
    "external_anchor_transport": "https-mtls",
    "external_anchor_must_be_independently_operated": true,
    "source_trust_must_be_deployment_authorized": true,
    "minimum_independent_checkpoint_witnesses": 2,
    "checkpoint_consistency_required": true,
    "record_inclusion_proof_required": true,
    "source_pinned_prior_checkpoint_required": true,
    "endpoint_log_genesis_and_witness_binding_required": true,
    "client_verifies_freshness_and_nonce": true,
    "local_audit_stream": "single-lifetime-crash-recoverable-chain"
  },
  "forbidden_operations": [
    "apply",
    "create-credential",
    "delete",
    "disable",
    "replace",
    "revoke",
    "rotate",
    "state-mv",
    "state-rm"
  ],
  "deployment_authorized": false,
  "authorization_blockers": [
    "source-owned transparency trust allowlist is empty",
    "SAI-06 integration/live acceptance is pending",
    "SAI-08 and SAI-09 accepted source successors are absent",
    "production class adapters and backend custody adapter are not configured",
    "provider workload-session, backend-authorization, IAM-metadata-projection, authorization-closure, cluster-inventory, Helm inventory, state-copy, greenfield-bootstrap and greenfield-transition adapters are not configured"
  ]
}
