{
  "schema": "fs2-serve.nebius.ai/credential-authority-deployment-contract/v1",
  "mode": "read-only",
  "configuration_schema": "security/credential-authority-config.schema.json",
  "source_trust_policy": "security/credential-evidence-source-trust.json",
  "service": "deploy/systemd/fs2-credential-authority.service",
  "socket": "deploy/systemd/fs2-credential-authority.socket",
  "fixed_components": {
    "authority": "scripts/credential_authority_service.py",
    "provider": "scripts/credential_authority_provider.py",
    "client": "scripts/credential_provider_adapter.py",
    "producer_signer": "scripts/credential_evidence_signer.py",
    "external_anchor_client": "scripts/credential_external_anchor_client.py",
    "verifier": "scripts/credential_evidence.py"
  },
  "required_artifact_scope_categories": [
    "operator-receipts",
    "secure-handoff",
    "task-run-roots",
    "terraform-workdirs"
  ],
  "required_artifact_mount_root": "/srv/fs2-credential-custody",
  "terraform_state_source": {
    "operation": "terraform state pull",
    "configuration_owner": "root",
    "configuration_writable_by_clients": false,
    "allowed_backend_types": ["remote", "s3"],
    "caller_state_paths_allowed": false
  },
  "evidence": {
    "producer_signature": "ed25519",
    "external_anchor_transport": "https-mtls",
    "external_anchor_must_be_independently_operated": true,
    "source_trust_must_be_deployment_authorized": true,
    "minimum_independent_checkpoint_witnesses": 2,
    "checkpoint_consistency_required": true,
    "client_verifies_freshness_and_nonce": true,
    "local_audit_stream": "single-lifetime-crash-recoverable-chain"
  },
  "forbidden_operations": [
    "apply",
    "create-credential",
    "delete",
    "disable",
    "replace",
    "revoke",
    "rotate",
    "state-mv",
    "state-rm"
  ],
  "deployment_authorized": false
}
