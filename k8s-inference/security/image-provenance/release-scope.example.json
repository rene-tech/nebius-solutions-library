{
  "schema": "fs2-serve.nebius.ai/release-scope/v16",
  "scope": {
    "cluster": "<kube-system-namespace-uid>",
    "namespaces": [
      "fs2-models",
      "fs2-system"
    ],
    "registry_prefixes": [
      "cr.example-region.example.invalid/registryid/"
    ],
    "platform_repository_prefix": "cr.example-region.example.invalid/registryid/fs2-platform/",
    "deploy_principals": [
      "system:serviceaccount:fs2-system:fs2-release-automation"
    ],
    "helm_secret_writers": [],
    "helm_storage": {
      "driver": "sql",
      "connection_identity": "postgres.fs2-system.svc:5432/helm_releases?user=fs2_helm"
    },
    "workload_service_accounts": [
      "fs2-system:fs2-release-automation",
      "fs2-system:fs2-serve-control-plane"
    ],
    "deploy_credential_csi_driver": "secrets-store.csi.k8s.io",
    "deploy_credential_spc": "fs2-release-helm-dsn",
    "security_principals": [
      "system:serviceaccount:fs2-security:fs2-admission-guard"
    ],
    "iam_exempt_subjects": [
      "ServiceAccount:kube-system:namespace-controller"
    ],
    "token_audience": "fs2-release",
    "stage_binding_authority": {
      "namespace": "fs2-system",
      "workload": "deployment/fs2-serve-control-plane"
    },
    "tooling": {
      "kubectl": {
        "path": "/usr/bin/kubectl",
        "sha256": "<sha256 of the kubectl binary bytes>"
      },
      "helm": {
        "path": "/usr/bin/helm",
        "sha256": "<sha256 of the helm binary bytes>"
      },
      "nebius": {
        "path": "/usr/bin/nebius",
        "sha256": "<sha256 of the nebius binary bytes>"
      }
    },
    "run_root": "/var/lib/fs2-release/run-root",
    "provider_endpoint": "https://api.example-region.example.invalid",
    "provider_principal": "<read-only provider service-account id the CLI must authenticate as>",
    "provider_cluster_id": "<managed-k8s-cluster-id>",
    "provider_parent_ids": [
      "<managed-k8s-cluster-id>",
      "<folder-or-project-id>",
      "<cloud-or-tenant-id>"
    ],
    "provider_readonly_roles": [
      "viewer",
      "auditor"
    ],
    "worm_store_uri": "<off-host WORM store URI holding the anchored-heads exports>",
    "worm_bucket": "<object-storage bucket name whose object-lock configuration is verified live>",
    "verification_key_sha256": "<sha256 of cosign.pub>",
    "attestation_key_sha256": "<the OWNER-ORIGINATED attestor public key sha256; the committed 78090e41... fingerprint is a bootstrap placeholder that never verifies (ATTESTATION_KEY_PROVENANCE gate)>",
    "policy_sha256": "<sha256 of policy.yaml>",
    "iam_boundary_sha256": "<sha256 of iam-boundary.yaml>",
    "debug_principals": [
      "system:serviceaccount:fs2-security:fs2-debugger"
    ],
    "workload_pvc_names": [
      "fs2-models/fs2-models-cache",
      "fs2-system/fs2-serve-scratch"
    ],
    "workload_storage_classes": [
      "fs2-standard"
    ],
    "workload_configmap_names": [
      "fs2-system/fs2-serve-config",
      "fs2-models/fs2-models-config"
    ],
    "workload_service_names": [
      "fs2-system/fs2-serve",
      "fs2-system/fs2-serve-internal"
    ],
    "workload_service_selectors": [
      "fs2-system/fs2-serve|app=fs2-serve",
      "fs2-system/fs2-serve-internal|app=fs2-serve,component=control-plane"
    ]
  }
}
