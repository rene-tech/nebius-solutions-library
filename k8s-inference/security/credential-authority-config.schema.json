{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schemas/credential-authority-config-v1.json",
  "title": "FS2 read-only credential authority configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "configuration_id", "attestation_key_path", "artifact_inventory_scopes", "allowed_client_uids", "operations"],
  "properties": {
    "schema": {
      "const": "fs2-serve.nebius.ai/credential-authority-config/v1"
    },
    "configuration_id": {
      "type": "string",
      "minLength": 1
    },
    "attestation_key_path": {
      "type": "string",
      "pattern": "^/"
    },
    "artifact_inventory_scopes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact_scope"}
    },
    "allowed_client_uids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "get",
        "inventory",
        "list-operation",
        "secret-bindings",
        "artifact-inventory",
        "consumer-readiness",
        "prove-consumers",
        "prove-zero-readers",
        "prove-absence",
        "prove-ciphertext-migration",
        "prove-customer-storage-cipher-migration",
        "prove-customer-storage-name-migration",
        "prove-auth-continuity"
      ],
      "patternProperties": {
        "^[a-z][a-z-]+$": {"$ref": "#/$defs/adapter"}
      }
    }
  },
  "$defs": {
    "artifact_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "owner", "purpose", "expires_at", "readers"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "root": {"type": "string", "pattern": "^/"},
        "owner": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "format": "date-time"},
        "readers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "file_sha256", "timeout_seconds"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "file_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120}
      }
    }
  }
}
