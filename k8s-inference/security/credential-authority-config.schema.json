{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schemas/credential-authority-config-v3.json",
  "title": "FS2 read-only credential authority configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "configuration_id", "evidence_producer_key_id", "caller_identities", "operation_callers", "policy", "operations", "evidence_signer", "external_anchor"],
  "properties": {
    "schema": {
      "const": "fs2-serve.nebius.ai/credential-authority-config/v3"
    },
    "configuration_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_producer_key_id": {"type": "string", "minLength": 1},
    "caller_identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release-automation", "operator-read", "operator-proxy", "credential-delivery-general", "credential-delivery-scientific"],
      "properties": {
        "release-automation": {"$ref": "#/$defs/caller_identity"},
        "operator-read": {"$ref": "#/$defs/caller_identity"},
        "operator-proxy": {"$ref": "#/$defs/caller_identity"},
        "credential-delivery-general": {"$ref": "#/$defs/caller_identity"},
        "credential-delivery-scientific": {"$ref": "#/$defs/caller_identity"}
      }
    },
    "operation_callers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["custody-snapshot", "planned-generation-admission", "artifact-inventory", "consumer-readiness", "credential-inventory", "rotation-readiness", "viewer-handoff-inventory", "ciphertext-migration", "authentication-continuity", "release-identity", "operator-read-context", "operator-proxy-context", "scoped-credential-context", "backend-custody", "state-migration-readiness"],
      "patternProperties": {
        "^[a-z][a-z-]+$": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["release-automation", "operator-read", "operator-proxy", "credential-delivery-general", "credential-delivery-scientific"]}
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody-snapshot",
        "planned-generation-admission",
        "artifact-inventory",
        "consumer-readiness",
        "credential-inventory",
        "rotation-readiness",
        "viewer-handoff-inventory",
        "ciphertext-migration",
        "authentication-continuity",
        "release-identity",
        "operator-read-context",
        "operator-proxy-context",
        "scoped-credential-context",
        "backend-custody",
        "state-migration-readiness"
      ],
      "patternProperties": {
        "^[a-z][a-z-]+$": {"$ref": "#/$defs/adapter"}
      }
    },
    "evidence_signer": {"$ref": "#/$defs/adapter"},
    "external_anchor": {"$ref": "#/$defs/adapter"},
    "policy": {"$ref": "#/$defs/policy"}
  },
  "$defs": {
    "caller_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "uid", "gid", "cgroup_path", "executable_path", "executable_sha256", "client_script_path", "client_script_sha256"],
      "properties": {
        "purpose": {"enum": ["release-automation", "operator-read", "operator-proxy", "credential-delivery-general", "credential-delivery-scientific"]},
        "uid": {"type": "integer", "minimum": 1},
        "gid": {"type": "integer", "minimum": 1},
        "cgroup_path": {"type": "string", "pattern": "^/"},
        "executable_path": {"type": "string", "pattern": "^/"},
        "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "client_script_path": {"type": "string", "pattern": "^/"},
        "client_script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifact_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "root", "owner", "purpose", "expires_at", "readers"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["operator-receipts", "secure-handoff", "task-run-roots", "terraform-workdirs"]},
        "root": {"type": "string", "pattern": "^/"},
        "owner": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "format": "date-time"},
        "readers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "file_sha256", "timeout_seconds"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "file_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120}
      }
    },
    "terraform_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_dir", "backend_type", "backend_config_path", "backend_expectation", "legacy_state_source", "terraform_data_dir", "workspace", "saved_plan_paths", "lineage_id"],
      "properties": {
        "configuration_dir": {"type": "string", "pattern": "^/"},
        "backend_type": {"enum": ["remote", "s3"]},
        "backend_config_path": {"type": "string", "pattern": "^/"},
        "backend_expectation": {"$ref": "#/$defs/backend_expectation"},
        "legacy_state_source": {"$ref": "#/$defs/legacy_state_source"},
        "terraform_data_dir": {"type": "string", "pattern": "^/"},
        "workspace": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "saved_plan_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "lineage_id": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "project_id", "evidence_identity", "release_identity", "operator_identity", "operator_proxy_identity", "credential_delivery_identities", "cluster_inventory_identity", "cluster_id", "kubeconfig", "kubeconfig_sha256", "handoff_kubeconfig", "namespaces", "approved_control_plane_cidrs", "terraform_roots", "artifact_inventory_scopes", "credential_registry_path", "consumer_contracts_path", "provider_executables", "class_adapters", "backend_access_identities", "backend_access_identity_adapter", "backend_custody_adapter", "release_identity_adapter", "authorization_closure_adapter", "cluster_authorization_adapter", "operator_proxy_authorization_adapter", "credential_delivery_authorization_adapter", "controller_inventory_adapters", "state_migration_adapter"],
      "properties": {
        "schema": {"const": "fs2-serve.nebius.ai/credential-authority-policy/v2"},
        "project_id": {"type": "string", "minLength": 1},
        "evidence_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["config_path", "config_sha256", "profile", "service_account_id", "credential_kind", "credential_id", "expires_at", "interactive_login_allowed"],
          "properties": {
            "config_path": {"type": "string", "pattern": "^/"},
            "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "profile": {"type": "string", "minLength": 1},
            "service_account_id": {"type": "string", "minLength": 1},
            "credential_kind": {"enum": ["access_keys", "auth_public_keys"]},
            "credential_id": {"type": "string", "minLength": 1},
            "expires_at": {"type": "string", "format": "date-time"},
            "interactive_login_allowed": {"const": false}
          }
        },
        "release_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["config_path", "config_sha256", "profile", "project_id", "service_account_id", "credential_kind", "audience", "provider_issuer", "token_exchange_source", "maximum_lifetime_seconds", "allowed_roles", "allowed_commands", "interactive_login_allowed", "human_principal_allowed", "reader_uid", "reader_gid"],
          "properties": {
            "config_path": {"type": "string", "pattern": "^/"},
            "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "profile": {"type": "string", "minLength": 1},
            "project_id": {"type": "string", "minLength": 1},
            "service_account_id": {"type": "string", "minLength": 1},
            "credential_kind": {"const": "workload_identity_session"},
            "audience": {"const": "terraform-release"},
            "provider_issuer": {"type": "string", "minLength": 1},
            "token_exchange_source": {"type": "string", "minLength": 1},
            "maximum_lifetime_seconds": {"const": 3600},
            "allowed_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["editor", "admin"]}},
            "allowed_commands": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["preflight", "plan", "apply"]}},
            "interactive_login_allowed": {"const": false},
            "human_principal_allowed": {"const": false},
            "reader_uid": {"type": "integer", "minimum": 1},
            "reader_gid": {"type": "integer", "minimum": 1}
          }
        },
        "operator_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id", "service_account_id", "credential_kind", "credential_id", "kubeconfig", "kubeconfig_sha256", "context_name", "maximum_lifetime_seconds", "reader_uid", "reader_gid"],
          "properties": {
            "project_id": {"type": "string", "minLength": 1},
            "service_account_id": {"type": "string", "minLength": 1},
            "credential_kind": {"const": "auth_public_keys"},
            "credential_id": {"type": "string", "minLength": 1},
            "kubeconfig": {"type": "string", "pattern": "^/"},
            "kubeconfig_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "context_name": {"type": "string", "minLength": 1},
            "maximum_lifetime_seconds": {"const": 86400},
            "reader_uid": {"type": "integer", "minimum": 1},
            "reader_gid": {"type": "integer", "minimum": 1}
          }
        },
        "operator_proxy_identity": {"$ref": "#/$defs/scoped_kubernetes_identity"},
        "credential_delivery_identities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["general-access", "scientific-access"],
          "properties": {
            "general-access": {"$ref": "#/$defs/credential_delivery_identity"},
            "scientific-access": {"$ref": "#/$defs/credential_delivery_identity"}
          }
        },
        "cluster_inventory_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service_account_id", "namespace", "name", "uid", "credential_id", "issuer", "audience", "maximum_lifetime_seconds", "allowed_permissions", "denied_permissions"],
          "properties": {
            "service_account_id": {"type": "string", "minLength": 1},
            "namespace": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "uid": {"type": "string", "minLength": 1},
            "credential_id": {"type": "string", "minLength": 1},
            "issuer": {"type": "string", "minLength": 1},
            "audience": {"const": "credential-inventory"},
            "maximum_lifetime_seconds": {"const": 3600},
            "allowed_permissions": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["serviceaccounts:list", "secrets:get", "secrets:list"]}},
            "denied_permissions": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"enum": ["impersonate:*", "pods:create", "pods:exec", "secrets:create", "secrets:delete", "secrets:patch", "secrets:update", "serviceaccounts/token:create", "workloads:create", "workloads:delete", "workloads:patch", "workloads:update"]}}
          }
        },
        "cluster_id": {"type": "string", "minLength": 1},
        "kubeconfig": {"type": "string", "pattern": "^/"},
        "kubeconfig_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "handoff_kubeconfig": {"type": "string", "pattern": "^/"},
        "namespaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "approved_control_plane_cidrs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "credential_registry_path": {"type": "string", "pattern": "^/"},
        "consumer_contracts_path": {"type": "string", "pattern": "^/"},
        "provider_executables": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crane", "kubectl", "nebius", "terraform"],
          "properties": {
            "crane": {"$ref": "#/$defs/executable"},
            "kubectl": {"$ref": "#/$defs/executable"},
            "nebius": {"$ref": "#/$defs/executable"},
            "terraform": {"$ref": "#/$defs/executable"}
          }
        },
        "class_adapters": {
          "type": "object",
          "minProperties": 21,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operations", "adapter"],
            "properties": {
              "operations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["consumer-readiness", "rotation-readiness", "ciphertext-migration", "authentication-continuity"]}
              },
              "adapter": {"$ref": "#/$defs/adapter"}
            }
          }
        },
        "backend_access_identities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "release-automation", "operator-read", "operator-proxy", "credential-delivery-general", "credential-delivery-scientific"],
          "properties": {
            "authority": {"$ref": "#/$defs/backend_access_identity"},
            "release-automation": {"$ref": "#/$defs/backend_access_identity"},
            "operator-read": {"$ref": "#/$defs/backend_access_identity"},
            "operator-proxy": {"$ref": "#/$defs/backend_access_identity"},
            "credential-delivery-general": {"$ref": "#/$defs/backend_access_identity"},
            "credential-delivery-scientific": {"$ref": "#/$defs/backend_access_identity"}
          }
        },
        "backend_access_identity_adapter": {"$ref": "#/$defs/adapter"},
        "backend_custody_adapter": {"$ref": "#/$defs/adapter"},
        "release_identity_adapter": {"$ref": "#/$defs/adapter"},
        "authorization_closure_adapter": {"$ref": "#/$defs/adapter"},
        "cluster_authorization_adapter": {"$ref": "#/$defs/adapter"},
        "operator_proxy_authorization_adapter": {"$ref": "#/$defs/adapter"},
        "credential_delivery_authorization_adapter": {"$ref": "#/$defs/adapter"},
        "controller_inventory_adapters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["helm_release_records"],
          "properties": {
            "helm_release_records": {"$ref": "#/$defs/adapter"}
          }
        },
        "state_migration_adapter": {"$ref": "#/$defs/adapter"},
        "terraform_roots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configuration", "foundation", "infrastructure", "model-artifacts", "reference-data", "workloads"],
          "properties": {
            "configuration": {"$ref": "#/$defs/terraform_root"},
            "foundation": {"$ref": "#/$defs/terraform_root"},
            "infrastructure": {"$ref": "#/$defs/terraform_root"},
            "model-artifacts": {"$ref": "#/$defs/terraform_root"},
            "reference-data": {"$ref": "#/$defs/terraform_root"},
            "workloads": {"$ref": "#/$defs/terraform_root"}
          }
        },
        "artifact_inventory_scopes": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/artifact_scope"}}
      }
    },
    "scoped_kubernetes_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_account_id", "namespace", "name", "uid", "service_account_resource_version", "credential_id", "issuer", "audience", "maximum_lifetime_seconds", "allowed_permissions", "denied_permissions", "kubeconfig", "kubeconfig_sha256", "context_name", "reader_uid", "reader_gid", "rbac_binding"],
      "properties": {
        "service_account_id": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "uid": {"type": "string", "minLength": 1},
        "service_account_resource_version": {"type": "string", "minLength": 1},
        "credential_id": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "audience": {"const": "operator-proxy"},
        "maximum_lifetime_seconds": {"type": "integer", "minimum": 60, "maximum": 900},
        "allowed_permissions": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["pods:get:fs2-system", "pods:list:fs2-system", "pods/portforward:create:fs2-system", "services:get:fs2-system"]}},
        "denied_permissions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "kubeconfig": {"type": "string", "pattern": "^/"},
        "kubeconfig_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "context_name": {"type": "string", "minLength": 1},
        "reader_uid": {"type": "integer", "minimum": 1},
        "reader_gid": {"type": "integer", "minimum": 1},
        "rbac_binding": {"$ref": "#/$defs/rbac_binding"}
      }
    },
    "credential_delivery_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_account_id", "namespace", "name", "uid", "service_account_resource_version", "credential_id", "issuer", "audience", "maximum_lifetime_seconds", "allowed_permissions", "denied_permissions", "kubeconfig", "kubeconfig_sha256", "context_name", "reader_uid", "reader_gid", "rbac_binding", "credential_class", "allowed_secret_namespace", "allowed_secret_name", "secret_key"],
      "properties": {
        "service_account_id": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "uid": {"type": "string", "minLength": 1},
        "service_account_resource_version": {"type": "string", "minLength": 1},
        "credential_id": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "audience": {"pattern": "^scoped-credential-delivery:(general-access|scientific-access)$"},
        "maximum_lifetime_seconds": {"type": "integer", "minimum": 60, "maximum": 300},
        "allowed_permissions": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^secrets:get:[^/]+/[^/]+$"}},
        "denied_permissions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "kubeconfig": {"type": "string", "pattern": "^/"},
        "kubeconfig_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "context_name": {"type": "string", "minLength": 1},
        "reader_uid": {"type": "integer", "minimum": 1},
        "reader_gid": {"type": "integer", "minimum": 1},
        "rbac_binding": {"$ref": "#/$defs/rbac_binding"},
        "credential_class": {"enum": ["pat-bootstrap", "pat-scientific"]},
        "allowed_secret_namespace": {"type": "string", "minLength": 1},
        "allowed_secret_name": {"type": "string", "minLength": 1},
        "secret_key": {"const": "token"}
      }
    },
    "backend_access_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_path", "config_sha256", "profile", "project_id", "service_account_id", "credential_kind", "audience", "provider_issuer", "token_exchange_source", "maximum_lifetime_seconds", "reader_uid", "reader_gid"],
      "properties": {
        "config_path": {"type": "string", "pattern": "^/"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "service_account_id": {"type": "string", "minLength": 1},
        "credential_kind": {"const": "workload_identity_session"},
        "audience": {"pattern": "^terraform-backend:(authority|release-automation|operator-read|operator-proxy|credential-delivery-general|credential-delivery-scientific)$"},
        "provider_issuer": {"type": "string", "minLength": 1},
        "token_exchange_source": {"type": "string", "minLength": 1},
        "maximum_lifetime_seconds": {"const": 3600},
        "reader_uid": {"type": "integer", "minimum": 0},
        "reader_gid": {"type": "integer", "minimum": 0}
      }
    },
    "rbac_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "role_name", "role_uid", "role_resource_version", "role_rules_sha256", "role_binding_name", "role_binding_uid", "role_binding_resource_version", "role_ref_kind", "role_ref_name", "service_account_uid", "service_account_resource_version", "subjects_sha256"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "role_name": {"type": "string", "minLength": 1},
        "role_uid": {"type": "string", "minLength": 1},
        "role_resource_version": {"type": "string", "minLength": 1},
        "role_rules_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role_binding_name": {"type": "string", "minLength": 1},
        "role_binding_uid": {"type": "string", "minLength": 1},
        "role_binding_resource_version": {"type": "string", "minLength": 1},
        "role_ref_kind": {"const": "Role"},
        "role_ref_name": {"type": "string", "minLength": 1},
        "service_account_uid": {"type": "string", "minLength": 1},
        "service_account_resource_version": {"type": "string", "minLength": 1},
        "subjects_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "backend_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "bucket_id", "bucket_parent_id", "bucket_project_id", "bucket_owner_service_account_id", "object_key", "endpoint", "kms_key_id", "kms_key_parent_id", "kms_key_project_id", "logging_destination_bucket_id", "logging_destination_parent_id", "logging_destination_project_id", "access_log_prefix", "object_lock_mode", "object_lock_retention_days"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "bucket_id": {"type": "string", "minLength": 1},
        "bucket_parent_id": {"type": "string", "minLength": 1},
        "bucket_project_id": {"type": "string", "minLength": 1},
        "bucket_owner_service_account_id": {"type": "string", "minLength": 1},
        "object_key": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "pattern": "^https://"},
        "kms_key_id": {"type": "string", "minLength": 1},
        "kms_key_parent_id": {"type": "string", "minLength": 1},
        "kms_key_project_id": {"type": "string", "minLength": 1},
        "logging_destination_bucket_id": {"type": "string", "minLength": 1},
        "logging_destination_parent_id": {"type": "string", "minLength": 1},
        "logging_destination_project_id": {"type": "string", "minLength": 1},
        "access_log_prefix": {"type": "string", "minLength": 1},
        "object_lock_mode": {"enum": ["governance", "compliance"]},
        "object_lock_retention_days": {"type": "integer", "minimum": 1}
      }
    },
    "legacy_state_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "canonical_state_sha256", "lineage", "serial", "retained_reason", "retention_expires_at"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
