    "customer-storage-name-keyring": {"adapter": "customer-storage-name-v1", "authority": "control-plane+postgresql+kubernetes", "consumers": ["customer-storage-reconciler", "migration-job"], "readiness": "old-new-rollback-name-binding-and-deployments-available"},
    "pat-pepper-keyring": {"adapter": "control-plane-pat-pepper-v1", "authority": "control-plane+postgresql+kubernetes", "consumers": ["control-plane", "bootstrap-access-jobs"], "readiness": "old-new-pat-verification-and-deployments-available"},
