{
  "schema": "fs2-serve.nebius.ai/image-security-policy/v1",
  "schedule": {
    "minimum_frequency": "daily",
    "cron_utc": "17 3 * * *"
  },
  "release_gate": {
    "scanners": [
      "vulnerability",
      "secret"
    ],
    "block_fixable_severities": [
      "CRITICAL",
      "HIGH"
    ],
    "maximum_secret_findings": 0,
    "require_digest_bound_result": true
  },
  "remediation_sla": {
    "critical_hours": 24,
    "high_hours": 168,
    "clock_start": "scanner_result_created_at"
  },
  "third_party_images": {
    "inventory": "security/third-party-images.lock.json",
    "promotion_status": "blocked_pending_digest_resolution",
    "requirements": [
      "resolve every rendered image to an immutable sha256 digest",
      "record the registry, repository, tag, digest, and resolution timestamp",
      "scan the digest with vulnerability and secret scanners",
      "reject any fixable CRITICAL or HIGH finding",
      "apply only the reviewed digest-bound values",
      "derive closure from every exact chart+values render and authoritative catalog source",
      "apply the digest inventory through the mandatory Helm post-renderer"
    ]
  },
  "evidence": {
    "retention_days": 90,
    "required_formats": [
      "trivy-json",
      "spdx-json",
      "scan-receipt-json",
      "detached-scan-receipt-signature",
      "attested-release-image-closure-json"
    ],
    "required_bindings": [
      "source_commit",
      "source_tree",
      "subject_digest",
      "scanner_version",
      "scanner_archive_sha256",
      "report_sha256",
      "sbom_sha256",
      "buildkit_provenance_sha256",
      "render_packet_signature_sha256"
    ]
  }
}
