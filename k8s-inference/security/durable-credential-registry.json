  "credentials": [
    {
      "id": "operator-handoff",
      "terraform_root": "infrastructure",
      "address_regexes": [
        "^nebius_iam_v1_service_account\\.operator_handoff(?:_versioned)?(?:\\[.*\\])?$",
        "^nebius_iam_v1_group\\.operator_handoff_viewers(?:_versioned)?(?:\\[.*\\])?$",
        "^nebius_iam_v1_group_membership\\.operator_handoff_viewer(?:_versioned)?(?:\\[.*\\])?$",
        "^nebius_iam_v1_access_permit\\.operator_handoff_viewer(?:_versioned)?(?:\\[.*\\])?$"
      ],
      "owner": "platform-security",
      "purpose": "expiring read-only operator access",
      "readers": ["named handoff recipient"],
      "expiry": {"required": true, "enforced_by": "nebius-iam"},
      "rotation": {"strategy": "dual-read-current-write", "disable_before_delete": true}
    },
    {
      "id": "database-logins",
      "terraform_root": "workloads",
      "address_regexes": [
        "^random_password\\.database(?:\\[.*\\])?$",
        "^kubernetes_secret_v1\\.database_(?:account|account_versioned|consumer|consumer_versioned)(?:\\[.*\\])?$"
      ],
      "owner": "database-operator",
      "purpose": "database owner and least-privilege workload logins",
      "readers": ["cloudnative-pg", "control-plane", "maintenance", "observability"],
      "expiry": {"required": true, "enforced_by": "rotation-controller"},
      "rotation": {"strategy": "dual-read-current-write", "disable_before_delete": true}
    },
    {
      "id": "pat-bootstrap",
      "terraform_root": "workloads",
      "address_regexes": [
        "^random_(?:id|password)\\.bootstrap_access_token_(?:id|secret)$",
        "^kubernetes_secret_v1\\.bootstrap_access(?:_versioned)?(?:\\[.*\\])?$"
      ],
      "owner": "control-plane",
      "purpose": "general API and MCP bootstrap PAT",
      "readers": ["bootstrap-access-job", "authorized operator delivery"],
      "expiry": {"required": true, "enforced_by": "control-plane-pat"},
      "rotation": {"strategy": "dual-read-current-write", "disable_before_delete": true}
    },
    {
      "id": "pat-scientific",
