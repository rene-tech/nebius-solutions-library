{
  "schema": "fs2-serve.nebius.ai/workload-registry-secret-admission-contract/v3",
  "state": "blocked_pending_security_owner_and_runtime_attestation",
  "authority": "Platform Security must independently install and attest the provider-RPC admission proxy before any private workload Secret may be applied.",
  "terraform_root": "stages/workloads",
  "provider_rpc_mode": "broker-immediately-before-secret-create-or-update",
  "credential_source": "external-oidc-broker-exact-subject-pull-only",
  "planning_credential_is_never_forwarded_to_apply": true,
  "planning_model": "stable-per-secret-lease-plus-distinct-invalid-ephemeral-placeholder",
  "provider_proxy_mutates_planned_metadata": false,
  "provider_proxy_mutates_data_wo_revision": false,
  "provider_proxy_mutates_only_write_only_secret_data": true,
  "token_receipt_persisted_in_terraform_state": false,
  "token_revision_persisted_in_terraform_state": false,
  "lease_subject_assignment": "exact-signed-plan-consumers-per-secret-with-no-cross-secret-subject-overlap",
  "maximum_refresh_readiness_age_seconds": 60,
  "minimum_credential_remaining_ttl_at_admission_seconds": 600,
  "admitted_resource_catalog": [
    "kubernetes_secret_v1.nvcrio_cred[0]",
    "kubernetes_secret_v1.dcgm_exporter_nvcrio[0]",
    "kubernetes_secret_v1.modelexpress_nvcrio[0]"
  ],
  "admitted_secret_identity_catalog": [
    {
      "resource": "kubernetes_secret_v1.nvcrio_cred[0]",
      "namespace": "fs2-models",
      "name": "nvcrio-cred"
    },
    {
      "resource": "kubernetes_secret_v1.dcgm_exporter_nvcrio[0]",
      "namespace": "fs2-observability",
      "name": "fs2-dcgm-exporter-nvcrio"
    },
    {
      "resource": "kubernetes_secret_v1.modelexpress_nvcrio[0]",
      "namespace_from_signed_plan": "var.model_express.namespace",
      "name": "fs2-modelexpress-nvcrio"
    }
  ],
  "enabled_secret_inventory": {
    "source": "exact-workload-inputs-and-signed-workload-plan",
    "terraform_variable": "var.nvcrio_secret_inventory",
    "terraform_derived_value": "local.workload_registry_secret_inventory",
    "allowed_keys": ["models", "observability", "modelexpress"],
    "nonempty_subset_required_when_private_pull_is_enabled": true,
    "static_superset_allowed": false,
    "extra_or_missing_resource_allowed": false,
    "required_row_fields": [
      "resource_address",
      "namespace",
      "name",
      "subjects",
      "subject_scope_sha256",
      "derivation_sha256"
    ],
    "inventory_sha256_must_match_planning_authorization_refresh_readiness_admission_and_handoff": true
  },
  "direct_secret_admission": {
    "source": "charts/addons/modelexpress/deploy.sh",
    "resource_address": "direct_secret.modelexpress_pull",
    "release_name": "modelexpress",
    "namespace_from_signed_invocation": "NAMESPACE",
    "name": "fs2-modelexpress-pull",
    "command": "apply-registry-secret",
    "broker_at_admission_required": true
  },
  "admitted_api_operations": ["create", "update"],
  "required_sequence_per_resource_rpc": [
    "verify-signed-plan-and-exact-provider-ancestor",
    "verify-distinct-stable-lease-and-noncredential-ephemeral-placeholder",
    "verify-refresh-owner-readiness-age-at-most-60-seconds",
    "derive-this-secret-private-image-subjects-from-signed-plan-lease-and-closure",
    "broker-new-exact-subject-pull-only-credential",
    "verify-issued-at-and-at-least-600-seconds-remaining",
    "replace-only-write-only-secret-bytes-without-changing-planned-metadata-or-lease-generation",
    "forward-one-create-or-update-rpc",
    "record-distinct-token-receipt-and-token-revision-in-external-signed-handoff-without-credential-bytes"
  ],
  "authoritative_handoff": {
    "schema": "fs2-serve.nebius.ai/workload-registry-secret-admission-handoff/v2",
    "producer": "externally-trusted-signed-terraform-apply-capsule",
    "consumer": "release-promotion-gate",
    "signature_required": true,
    "complete_one_to_one_resource_set_required": true,
    "resource_set_must_equal_enabled_secret_inventory_not_static_catalog": true,
    "required_row_fields": [
      "resource_address",
      "namespace",
      "name",
      "kubernetes_uid",
      "kubernetes_resource_version",
      "api_response_sha256",
      "lease_id",
      "lease_generation",
      "subject_scope_sha256",
      "derivation_sha256",
      "authorized_subjects",
      "token_receipt_sha256",
      "token_revision",
      "issued_at",
      "expires_at",
      "docker_config_sha256",
      "planned_metadata_sha256",
      "observed_metadata_sha256"
    ],
    "required_equalities": [
      "lease-and-subject-scope-equal-signed-plan",
      "planned-metadata-sha256-equals-observed-metadata-sha256",
      "api-response-identity-equals-signed-plan-secret-identity",
      "handoff-resource-set-equals-enabled-secret-inventory",
      "refresh-readiness-inventory-sha256-equals-signed-plan-inventory-sha256",
      "receipt-subjects-equal-lease-subjects",
      "each-private-subject-is-assigned-to-exactly-one-secret-lease",
      "docker-config-sha256-equals-broker-receipt"
    ],
    "required_uniqueness": [
      "lease_id",
      "token_receipt_sha256",
      "lease_id-plus-token_revision"
    ],
    "credential_bytes_forbidden": true,
    "terraform_apply_success_requires_verified_handoff": true
  },
  "fail_closed": {
    "ambient_terraform_registry_variables_allowed": false,
    "terraform_evaluation_placeholder_forwarded_to_provider_allowed": false,
    "unreviewed_secret_address_allowed": false,
    "stale_refresh_readiness_allowed": false,
    "credential_reuse_across_resource_rpcs_allowed": false,
    "shared_token_receipt_or_revision_across_secrets_allowed": false,
    "provider_mutation_of_planned_metadata_allowed": false,
    "provider_mutation_of_planned_data_wo_revision_allowed": false,
    "terraform_success_without_complete_signed_handoff_allowed": false,
    "provider_rpc_after_credential_expiry_allowed": false,
    "delete_or_replace_last_valid_secret_on_failure": false
  },
  "runtime": {
    "proxy_id": null,
    "source_commit": null,
    "source_tree": null,
    "executable_sha256": null,
    "provider_protocol_sha256": null,
    "sbom_sha256": null,
    "provenance_sha256": null,
    "handoff_signer_id": null,
    "handoff_public_key_sha256": null,
    "handoff_verifier_sha256": null
  }
}
