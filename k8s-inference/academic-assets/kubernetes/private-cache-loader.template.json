{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "ACADEMIC_ASSET_LOADER_NAME",
    "namespace": "fs2-models",
    "labels": {
      "app.kubernetes.io/name": "academic-asset-loader",
      "app.kubernetes.io/part-of": "fs2-serve",
      "app.kubernetes.io/managed-by": "fs2-academic-assets-ingestion"
    }
  },
  "spec": {
    "automountServiceAccountToken": false,
    "enableServiceLinks": false,
    "restartPolicy": "Never",
    "securityContext": {
      "fsGroup": 65532,
      "fsGroupChangePolicy": "OnRootMismatch",
      "runAsGroup": 65532,
      "runAsNonRoot": true,
      "runAsUser": 65532,
      "seccompProfile": {"type": "RuntimeDefault"}
    },
    "containers": [
      {
        "name": "loader",
        "image": "cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/fs2-platform/fs2-serve-control-plane@sha256:e40c69a6363d1b873780869e3d8301121c7da410435f5d76481986cf2994b571",
        "imagePullPolicy": "IfNotPresent",
        "command": ["python3", "-c", "import time; time.sleep(3600)"],
        "resources": {
          "requests": {"cpu": "50m", "memory": "64Mi"},
          "limits": {"cpu": "250m", "memory": "256Mi"}
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {"drop": ["ALL"]},
          "readOnlyRootFilesystem": true
        },
        "volumeMounts": [
          {"name": "private-cache", "mountPath": "/private-cache"}
        ]
      }
    ],
    "volumes": [
      {
        "name": "private-cache",
        "persistentVolumeClaim": {
          "claimName": "cancer-immunotherapy-academic-assets-rwx-v1"
        }
      }
    ]
  }
}
