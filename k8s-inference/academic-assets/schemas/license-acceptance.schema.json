{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/academic-license-acceptance/v1",
  "title": "Non-secret academic license acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "asset_id",
    "accepted",
    "accepted_at",
    "accepted_by_role",
    "scope",
    "distribution_scope",
    "terms",
    "source_claims"
  ],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/academic-license-acceptance/v1"},
    "asset_id": {"enum": ["alphafold3", "pyrosetta-bindcraft"]},
    "accepted": {"type": "boolean"},
    "accepted_at": {"type": "string", "format": "date-time"},
    "accepted_by_role": {
      "enum": ["authorized-individual", "authorized-organization-representative"]
    },
    "scope": {"const": "academic-noncommercial"},
    "distribution_scope": {"enum": ["individual-only", "organization-internal"]},
    "terms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "sha256"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "source_claims": {"type": "object", "minProperties": 3}
  }
}
