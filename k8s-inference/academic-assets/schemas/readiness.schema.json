{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/academic-assets-readiness/v1",
  "title": "Admin-safe academic asset readiness projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generation", "state", "assets", "fallbacks"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/academic-assets-readiness/v1"},
    "generation": {"type": ["string", "null"]},
    "state": {"enum": ["Blocked", "Ready"]},
    "assets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "model_id", "display_name", "state", "stages", "artifact_sha256", "runtime_image_digest"],
        "properties": {
          "asset_id": {"type": "string"},
          "model_id": {"enum": ["alphafold3", "bindcraft"]},
          "display_name": {"type": "string"},
          "state": {
            "enum": [
              "MissingLicenseAcceptance",
              "InvalidContract",
              "MissingArtifact",
              "MissingCache",
              "InvalidCacheReceipt",
              "MissingImage",
              "InvalidImageReceipt",
              "MissingDeployment",
              "InvalidDeploymentReceipt",
              "MissingSemanticReadiness",
              "InvalidSemanticReceipt",
              "Ready"
            ]
          },
          "stages": {
            "type": "object",
            "additionalProperties": false,
            "required": ["license_acceptance", "artifact", "private_cache", "private_image", "deployment", "semantic_readiness"],
            "properties": {
              "license_acceptance": {"enum": ["missing", "accepted"]},
              "artifact": {"enum": ["missing", "verified"]},
              "private_cache": {"enum": ["missing", "invalid", "ready"]},
              "private_image": {"enum": ["missing", "invalid", "ready"]},
              "deployment": {"enum": ["missing", "invalid", "ready"]},
              "semantic_readiness": {"enum": ["missing", "invalid", "ready"]}
            }
          },
          "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "runtime_image_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "fallbacks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id", "state", "aliases", "does_not_satisfy"],
        "properties": {
          "model_id": {"enum": ["openfold3", "open-binder"]},
          "state": {"const": "IndependentFallback"},
          "aliases": {"const": []},
          "does_not_satisfy": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["alphafold3", "bindcraft"]}
          }
        }
      }
    }
  }
}
