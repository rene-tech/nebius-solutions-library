{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/academic-asset-technical-staging/v1",
  "title": "Non-acceptance technical staging marker",
  "type": "object",
  "required": ["schema", "asset_id", "status", "purpose", "artifact_status", "tenant_binding_status", "activation_allowed", "required_entitlements", "next_step"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/academic-asset-technical-staging/v1"},
    "asset_id": {"enum": ["alphafold3", "pyrosetta-bindcraft"]},
    "status": {"const": "pending-authorized-representative"},
    "purpose": {"const": "technical-staging-only"},
    "artifact_status": {"enum": ["ArtifactStaged", "ArtifactRejected", "MissingArtifact"]},
    "tenant_binding_status": {"const": "PendingNamedTenantAndInstitution"},
    "activation_allowed": {"const": false},
    "required_entitlements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_artifact": {"type": "string"},
    "quarantined_artifact": {"type": "string"},
    "next_step": {"type": "string", "minLength": 1}
  },
  "not": {
    "anyOf": [
      {"required": ["actor"]},
      {"required": ["signature"]},
      {"required": ["accepted_terms_sha256"]},
      {"required": ["accepted_at"]}
    ]
  }
}
