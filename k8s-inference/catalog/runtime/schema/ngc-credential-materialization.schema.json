{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/ngc-credential-materialization/v3",
  "title": "Fresh platform-owned NGC key observed in securely pre-created Kubernetes Secrets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "materialized_at", "valid_until", "platform_owner", "delivery_mode", "key_origin", "validity_status", "compromise_review_status", "issuer_receipt_sha256", "server_observation_sha256", "credential_generation_sha256", "key_fingerprint_sha256", "server_observation", "optional_backend_eligibility_receipt", "values_suppressed", "legacy_ngc_secret_copied", "legacy_plaintext_rotation_source_used", "legacy_phase_7c_hmac_reused", "exposed_evo_bearer_reused", "secrets"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/ngc-credential-materialization/v3"},
    "status": {"const": "fresh-platform-key-precreated-and-observed"},
    "materialized_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "platform_owner": {"const": "fs2-serve-platform"},
    "delivery_mode": {"const": "securely-pre-created-existing-kubernetes-secrets"},
    "key_origin": {"const": "new-platform-owned-secure-injection"},
    "validity_status": {"const": "verified-current"},
    "compromise_review_status": {"const": "no-known-exposure"},
    "issuer_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "server_observation_sha256": {"$ref": "#/$defs/sha256"},
    "credential_generation_sha256": {"$ref": "#/$defs/sha256"},
    "key_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "server_observation": {"$ref": "#/$defs/serverObservation"},
    "optional_backend_eligibility_receipt": {"type": "null"},
    "values_suppressed": {"const": true},
    "legacy_ngc_secret_copied": {"const": false},
    "legacy_plaintext_rotation_source_used": {"const": false},
    "legacy_phase_7c_hmac_reused": {"const": false},
    "exposed_evo_bearer_reused": {"const": false},
    "secrets": {
      "type": "array",
      "prefixItems": [{"$ref": "#/$defs/pullSecret"}, {"$ref": "#/$defs/runtimeSecret"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
    "resourceVersion": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "serverObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "observed_at", "api_server_identity_sha256", "observer_principal_sha256", "values_recorded", "metadata_fields"],
      "properties": {
        "method": {"const": "authenticated-kubernetes-apiserver-get"},
        "observed_at": {"type": "string", "format": "date-time"},
        "api_server_identity_sha256": {"$ref": "#/$defs/sha256"},
        "observer_principal_sha256": {"$ref": "#/$defs/sha256"},
        "values_recorded": {"const": false},
        "metadata_fields": {"const": ["apiVersion", "kind", "metadata.name", "metadata.namespace", "metadata.resourceVersion", "metadata.uid", "type", "data-key-set"]}
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "api_version", "kind", "namespace", "name", "uid", "resource_version", "secret_type", "data_keys", "observed_at", "key_fingerprint_sha256"],
      "properties": {
        "requirement_id": {"type": "string"},
        "api_version": {"const": "v1"},
        "kind": {"const": "Secret"},
        "namespace": {"const": "fs2-models"},
        "name": {"type": "string"},
        "uid": {"$ref": "#/$defs/uid"},
        "resource_version": {"$ref": "#/$defs/resourceVersion"},
        "secret_type": {"enum": ["Opaque", "kubernetes.io/dockerconfigjson"]},
        "data_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observed_at": {"type": "string", "format": "date-time"},
        "key_fingerprint_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pullSecret": {
      "allOf": [
        {"$ref": "#/$defs/secret"},
        {"properties": {"requirement_id": {"const": "fs2-models/ngc-pull-secret"}, "name": {"const": "fs2-ngc-pull"}, "secret_type": {"const": "kubernetes.io/dockerconfigjson"}, "data_keys": {"const": [".dockerconfigjson"]}}}
      ]
    },
    "runtimeSecret": {
      "allOf": [
        {"$ref": "#/$defs/secret"},
        {"properties": {"requirement_id": {"const": "fs2-models/ngc-runtime-secret"}, "name": {"const": "fs2-ngc-runtime"}, "secret_type": {"const": "Opaque"}, "data_keys": {"const": ["NGC_API_KEY"]}}}
      ]
    }
  }
}
