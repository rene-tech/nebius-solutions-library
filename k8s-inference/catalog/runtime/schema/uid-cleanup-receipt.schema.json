{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/uid-cleanup-receipt/v4",
  "title": "Attempt/runtime/node-placement/GPU-allocation-bound cleanup receipt v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_digest", "status", "model_id", "model_digest", "attempt_id", "runtime_tuple_digest", "completed_at", "namespace", "node_identity", "gpu_identity", "expected_resource_uids", "resources", "temporary_paths_absent", "gpu_clients_after", "retained_artifact_digests"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/uid-cleanup-receipt/v4"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "status": {"const": "PASS"},
    "model_id": {"type": "string", "minLength": 1},
    "model_digest": {"$ref": "#/$defs/digest"},
    "attempt_id": {"type": "string", "minLength": 1},
    "runtime_tuple_digest": {"$ref": "#/$defs/digest"},
    "completed_at": {"$ref": "#/$defs/timestamp"},
    "namespace": {"enum": ["fs2-faststart", "fs2-models"]},
    "node_identity": {"$ref": "#/$defs/node"},
    "gpu_identity": {"$ref": "#/$defs/gpu"},
    "expected_resource_uids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/resourceIdentity"}},
    "resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/resourceResult"}},
    "temporary_paths_absent": {"const": true},
    "gpu_clients_after": {"const": 0},
    "retained_artifact_digests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "uid", "provider_id_sha256"],
      "properties": {"name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/uid"}, "provider_id_sha256": {"$ref": "#/$defs/digest"}}
    },
    "gpu": {
      "type": "object", "additionalProperties": false,
      "required": ["class", "node_preset", "node_count", "node_topology", "workload_count", "workload_topology", "allocated_uuids", "node_inventory_sha256"],
      "properties": {"class": {"type": "string", "minLength": 1}, "node_preset": {"enum": ["b300-1x", "b300-8x"]}, "node_count": {"enum": [1, 8]}, "node_topology": {"enum": ["single-gpu", "eight-gpu-nvlink"]}, "workload_count": {"type": "integer", "minimum": 1, "maximum": 8}, "workload_topology": {"enum": ["single-gpu", "single-node-multi-gpu"]}, "allocated_uuids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^GPU-"}}, "node_inventory_sha256": {"$ref": "#/$defs/digest"}}
    },
    "resourceIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["api_version", "kind", "namespace", "name", "uid"],
      "properties": {"api_version": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "namespace": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/uid"}}
    },
    "resourceResult": {
      "type": "object", "additionalProperties": false,
      "required": ["api_version", "kind", "namespace", "name", "uid", "precondition_uid", "final_state"],
      "properties": {"api_version": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "namespace": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/uid"}, "precondition_uid": {"$ref": "#/$defs/uid"}, "final_state": {"const": "absent"}}
    }
  }
}
