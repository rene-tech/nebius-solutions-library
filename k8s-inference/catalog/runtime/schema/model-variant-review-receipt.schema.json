{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/model-variant-review-receipt/v4",
  "title": "Independent signed route review for one exact model variant",
  "$comment": "Non-authoritative shape only; reviewer trust, independence, freshness and exact evidence joins require executable verification.",
  "x-fs2-authority": "non-authoritative-shape-only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_digest", "status", "decision", "variant_id", "candidate_id", "candidate_digest", "runtime_profile", "variant_digest", "canonical_model_digest", "serving_binding_digest", "scale_contract_digest", "attestor_policy_sha256", "artifact_manifest_digest", "supply_receipt_digest", "runtime_tuple_digest", "cold_cohort_digest", "warm_cohort_digest", "qualification_receipt_digest", "backend_readiness_receipt_digest", "preemption_receipt_digest", "zero_to_ready_receipt_digest", "return_to_zero_receipt_digest", "reviewer_identity_sha256", "review_commit", "valid_until"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/model-variant-review-receipt/v4"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "status": {"const": "PASS"},
    "decision": {"const": "approve-route"},
    "variant_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_digest": {"$ref": "#/$defs/digest"},
    "runtime_profile": {"enum": ["portable", "blackwell-sm103"]},
    "variant_digest": {"$ref": "#/$defs/digest"},
    "canonical_model_digest": {"$ref": "#/$defs/digest"},
    "serving_binding_digest": {"$ref": "#/$defs/digest"},
    "scale_contract_digest": {"$ref": "#/$defs/digest"},
    "attestor_policy_sha256": {"$ref": "#/$defs/digest"},
    "artifact_manifest_digest": {"$ref": "#/$defs/digest"},
    "supply_receipt_digest": {"$ref": "#/$defs/digest"},
    "runtime_tuple_digest": {"$ref": "#/$defs/digest"},
    "cold_cohort_digest": {"$ref": "#/$defs/digest"},
    "warm_cohort_digest": {"$ref": "#/$defs/digest"},
    "qualification_receipt_digest": {"$ref": "#/$defs/digest"},
    "backend_readiness_receipt_digest": {"$ref": "#/$defs/digest"},
    "preemption_receipt_digest": {"$ref": "#/$defs/digest"},
    "zero_to_ready_receipt_digest": {"$ref": "#/$defs/digest"},
    "return_to_zero_receipt_digest": {"$ref": "#/$defs/digest"},
    "reviewer_identity_sha256": {"$ref": "#/$defs/digest"},
    "review_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "valid_until": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"}
  }
}
