{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/scientific-run-request/v1",
  "title": "Scientific batch run request",
  "description": "User-authored request for POST /v1/models/{model_id}/variants/{variant_id}:submit, or the explicitly declared default alias. Idempotency is supplied in the Idempotency-Key HTTP header; queue, image, command, environment, and accelerator placement remain operator-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "service_class",
    "input_manifest",
    "parameters"
  ],
  "properties": {
    "schema": {
      "const": "fs2-serve.nebius.ai/scientific-run-request/v1"
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "service_class": {
      "enum": [
        "presentation",
        "interactive",
        "customer-batch",
        "bulk-backfill"
      ]
    },
    "input_manifest": {
      "$ref": "#/$defs/artifact_ref"
    },
    "parameters": {
      "type": "object",
      "maxProperties": 256
    },
    "client_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "correlation_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+_-]*$",
          "maxLength": 128
        },
        "compression": {
          "enum": [
            "gzip",
            "zstd",
            "none"
          ]
        }
      }
    }
  }
}
