{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/boltzgen-parameters/v1",
  "title": "BoltzGen scientific run parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "batches"
  ],
  "properties": {
    "protocol": {
      "enum": [
        "protein-anything",
        "peptide-anything",
        "protein-small_molecule",
        "nanobody-anything",
        "antibody-anything",
        "protein-redesign"
      ]
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shard_id",
          "num_designs",
          "budget",
          "reuse_completed"
        ],
        "properties": {
          "shard_id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$",
            "maxLength": 32
          },
          "num_designs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "budget": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "reuse_completed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
