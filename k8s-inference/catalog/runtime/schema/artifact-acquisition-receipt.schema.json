{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/artifact-acquisition-receipt/v4",
  "title": "fs2-serve post-Job immutable artifact acquisition receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_digest", "worker_result_digest", "operation_id", "model_id", "model_digest", "method", "source", "artifact_manifest_digest", "artifact_content_digest", "content_uri", "prerequisite_ids", "storage", "credential_source", "token_used", "publication", "controller_owner", "acquisition_plan_sha256", "helper_image", "execution", "filesystem_write_proof", "lock_path", "capacity_bound_bytes", "reserve_bytes", "free_bytes_before", "free_bytes_after", "outcome", "cleanup"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/artifact-acquisition-receipt/v4"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "worker_result_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"},
    "model_id": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"},
    "model_digest": {"$ref": "#/$defs/digest"},
    "method": {"enum": ["huggingface-public-snapshot", "ngc-target-node-nimcache"]},
    "source": {"type": "object", "additionalProperties": false, "required": ["repository", "revision"], "properties": {"repository": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 40}}},
    "artifact_manifest_digest": {"$ref": "#/$defs/digest"},
    "artifact_content_digest": {"$ref": "#/$defs/digest"},
    "content_uri": {"type": "string", "pattern": "^(?:sfs://fs2-cache/mnt/fs2-serve-cache|pvc://fs2-models/qwen3-8b-weights)/models/[a-z0-9-]+/sha256/[0-9a-f]{64}$"},
    "prerequisite_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "storage": {"type": "object", "additionalProperties": false, "required": ["mode", "contract", "pvc_namespace", "pvc_name"], "properties": {"mode": {"enum": ["sfs-pvc", "provider-block-pvc"]}, "contract": {"enum": ["fs2-models/shared-cache-pvc", "fs2-serve.nebius.ai/provider-block-pvc/v1"]}, "pvc_namespace": {"const": "fs2-models"}, "pvc_name": {"enum": ["fs2-cache", "qwen3-8b-weights"]}}},
    "credential_source": {"enum": ["none-public-revision", "kubernetes-secret-value-suppressed"]},
    "token_used": {"type": "boolean"},
    "publication": {"enum": ["atomic-content-addressed-sfs", "atomic-content-addressed-provider-block-pvc"]},
    "controller_owner": {"enum": ["fs2-serve-acquirer", "nim-operator-nimcache"]},
    "acquisition_plan_sha256": {"$ref": "#/$defs/digest"},
    "helper_image": {"oneOf": [{"$ref": "#/$defs/helperImage"}, {"type": "null"}]},
    "execution": {"$ref": "#/$defs/execution"},
    "filesystem_write_proof": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/writeProof"}]},
    "lock_path": {"type": "string", "minLength": 1},
    "capacity_bound_bytes": {"type": "integer", "minimum": 1},
    "reserve_bytes": {"type": "integer", "minimum": 0},
    "free_bytes_before": {"type": "integer", "minimum": 0},
    "free_bytes_after": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["acquired", "already-present"]},
    "cleanup": {"$ref": "#/$defs/cleanup"}
  },
  "allOf": [
    {"if": {"properties": {"method": {"const": "huggingface-public-snapshot"}}}, "then": {"properties": {"helper_image": {"$ref": "#/$defs/helperImage"}, "worker_result_digest": {"$ref": "#/$defs/digest"}}}, "else": {"properties": {"helper_image": {"type": "null"}, "worker_result_digest": {"type": "null"}}}},
    {"if": {"properties": {"storage": {"properties": {"mode": {"const": "provider-block-pvc"}}}}}, "then": {"properties": {"filesystem_write_proof": {"$ref": "#/$defs/writeProof"}}}, "else": {"properties": {"filesystem_write_proof": {"type": "null"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "k8sUid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
    "helperImage": {"type": "object", "additionalProperties": false, "required": ["id", "reference", "digest", "admission_receipt_digest", "registry_identity_sha256", "build_identity_sha256", "helper_contract_sha256"], "properties": {"id": {"const": "fs2-acquisition-helper"}, "reference": {"type": "string", "pattern": "^[^@\\s]+/fs2-serve/acquisition-helper@sha256:[0-9a-f]{64}$"}, "digest": {"$ref": "#/$defs/imageDigest"}, "admission_receipt_digest": {"$ref": "#/$defs/digest"}, "registry_identity_sha256": {"$ref": "#/$defs/digest"}, "build_identity_sha256": {"$ref": "#/$defs/digest"}, "helper_contract_sha256": {"$ref": "#/$defs/digest"}}},
    "job": {"type": "object", "additionalProperties": false, "required": ["api_version", "kind", "namespace", "name", "uid"], "properties": {"api_version": {"const": "batch/v1"}, "kind": {"const": "Job"}, "namespace": {"const": "fs2-models"}, "name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/k8sUid"}}},
    "pod": {"type": "object", "additionalProperties": false, "required": ["api_version", "kind", "namespace", "name", "uid", "owner_job_uid"], "properties": {"api_version": {"const": "v1"}, "kind": {"const": "Pod"}, "namespace": {"const": "fs2-models"}, "name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/k8sUid"}, "owner_job_uid": {"$ref": "#/$defs/k8sUid"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["run_as_non_root", "run_as_uid", "run_as_gid", "fs_group", "supplemental_groups_policy", "seccomp_profile", "job", "pod"], "properties": {"run_as_non_root": {"const": true}, "run_as_uid": {"const": 10001}, "run_as_gid": {"const": 10001}, "fs_group": {"const": 10001}, "supplemental_groups_policy": {"const": "Strict"}, "seccomp_profile": {"const": "RuntimeDefault"}, "job": {"$ref": "#/$defs/job"}, "pod": {"$ref": "#/$defs/pod"}}},
    "writeProof": {"type": "object", "additionalProperties": false, "required": ["filesystem_type", "probe_path", "operation", "bytes_written", "payload_sha256", "file_uid", "file_gid", "file_mode", "marker_removed", "directory_fsync"], "properties": {"filesystem_type": {"const": "ext4"}, "probe_path": {"const": "/mnt/fs2-provider-block/models/qwen3-8b"}, "operation": {"const": "exclusive-create-write-fsync-read-unlink"}, "bytes_written": {"type": "integer", "minimum": 1}, "payload_sha256": {"$ref": "#/$defs/digest"}, "file_uid": {"const": 10001}, "file_gid": {"const": 10001}, "file_mode": {"const": "0600"}, "marker_removed": {"const": true}, "directory_fsync": {"const": true}}},
    "cleanupResource": {"type": "object", "additionalProperties": false, "required": ["api_version", "kind", "namespace", "name", "uid", "delete_precondition_uid", "final_state", "replacement_uid", "replacement_touched"], "properties": {"api_version": {"type": "string", "minLength": 1}, "kind": {"enum": ["Job", "Pod"]}, "namespace": {"const": "fs2-models"}, "name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/k8sUid"}, "owner_job_uid": {"$ref": "#/$defs/k8sUid"}, "delete_precondition_uid": {"$ref": "#/$defs/k8sUid"}, "final_state": {"const": "absent"}, "replacement_uid": {"oneOf": [{"$ref": "#/$defs/k8sUid"}, {"type": "null"}]}, "replacement_touched": {"const": false}}},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["completed_at", "observer_identity_sha256", "controller_identity_sha256", "api_server_observed", "expected_resources", "resources", "temporary_path_absent", "write_marker_absent", "foreign_uids_touched"], "properties": {"completed_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "observer_identity_sha256": {"$ref": "#/$defs/digest"}, "controller_identity_sha256": {"$ref": "#/$defs/digest"}, "api_server_observed": {"const": true}, "expected_resources": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/job"}, {"$ref": "#/$defs/pod"}], "items": false}, "resources": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/cleanupResource"}}, "temporary_path_absent": {"const": true}, "write_marker_absent": {"const": true}, "foreign_uids_touched": {"const": false}}}
  }
}
