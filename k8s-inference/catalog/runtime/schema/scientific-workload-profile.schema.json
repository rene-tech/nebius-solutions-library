{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/scientific-workload-profile/v1",
  "title": "Scientific workload profile",
  "description": "Model-to-scientific-batch adapter contract. Candidate profiles remain unrouted; qualified profiles require complete immutable identity, access, semantic, scheduler, and live-route evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_id",
    "display_name",
    "execution_mode",
    "state",
    "route_exposed",
    "source",
    "execution_identity",
    "interface",
    "access",
    "resources",
    "workload",
    "semantic_validation",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "fs2-serve.nebius.ai/scientific-workload-profile/v1"
    },
    "model_id": {
      "$ref": "#/$defs/model_id"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "execution_mode": {
      "enum": [
        "scientific-batch",
        "hybrid"
      ]
    },
    "state": {
      "enum": [
        "candidate-unqualified",
        "qualified",
        "active"
      ]
    },
    "route_exposed": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "revision",
        "review_url",
        "classification"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git",
            "huggingface"
          ]
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*/[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "maxLength": 96
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "review_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "classification": {
          "enum": [
            "candidate-input",
            "qualified-input"
          ]
        }
      }
    },
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_revision",
        "runtime_image_digest",
        "runtime_recipe_sha256",
        "workload_recipe_sha256",
        "artifact_manifest_digest",
        "execution_identity_sha256"
      ],
      "properties": {
        "model_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runtime_image_digest": {
          "description": "Immutable runtime image identity; null only while the profile remains an unrouted candidate.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runtime_recipe_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "workload_recipe_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_manifest_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "execution_identity_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "submit_endpoint",
        "request_schema",
        "result_schema",
        "parameter_schema",
        "operations",
        "service_classes",
        "mcp"
      ],
      "properties": {
        "protocol": {
          "const": "scientific-batch-v1"
        },
        "submit_endpoint": {
          "type": "string",
          "pattern": "^/v1/models/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?:submit$",
          "maxLength": 256
        },
        "request_schema": {
          "const": "fs2-serve.nebius.ai/scientific-run-request/v1"
        },
        "result_schema": {
          "const": "fs2-serve.nebius.ai/scientific-run-result/v1"
        },
        "parameter_schema": {
          "type": "string",
          "pattern": "^fs2-serve\\.nebius\\.ai/[a-z0-9-]+/v[1-9][0-9]*$",
          "maxLength": 256
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 64
          }
        },
        "service_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "presentation",
              "interactive",
              "customer-batch",
              "bulk-backfill"
            ]
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "discoverable",
            "invocable",
            "tool_name",
            "description"
          ],
          "properties": {
            "discoverable": {
              "type": "boolean"
            },
            "invocable": {
              "type": "boolean"
            },
            "tool_name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 128
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "state",
        "receipt_digest",
        "credentials_embedded"
      ],
      "properties": {
        "profile": {
          "enum": [
            "standard",
            "academic"
          ]
        },
        "state": {
          "enum": [
            "not-required",
            "unverified",
            "verified",
            "blocked"
          ]
        },
        "receipt_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "credentials_embedded": {
          "const": false
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu_count",
        "gpu_topology",
        "host_architectures",
        "compatible_pool_ids",
        "required_node_labels"
      ],
      "properties": {
        "gpu_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "gpu_topology": {
          "enum": [
            "single-gpu",
            "single-node-multi-gpu"
          ]
        },
        "host_architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "amd64",
              "arm64"
            ]
          }
        },
        "compatible_pool_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[-_a-z0-9.]*[a-z0-9])?$",
            "maxLength": 63
          }
        },
        "required_node_labels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          }
        }
      }
    },
    "workload": {
      "$ref": "#/$defs/workload"
    },
    "semantic_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_id",
        "state"
      ],
      "properties": {
        "validator_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[-_a-z0-9.]*[a-z0-9])?$",
          "maxLength": 128
        },
        "state": {
          "enum": [
            "candidate-unqualified",
            "qualified",
            "active"
          ]
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h100_semantic_receipt_sha256",
        "public_completion_receipt_sha256",
        "scheduler_eligibility_receipt_sha256",
        "execution_map_sha256",
        "qualified_at"
      ],
      "properties": {
        "h100_semantic_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "public_completion_receipt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null until a real run produces it. These receipts are circular by nature: a completed public run and a real scheduled admission cannot exist before the model is dispatchable, so requiring them to enable dispatch is unsatisfiable. A profile may therefore be active with them null, but never qualified."
        },
        "scheduler_eligibility_receipt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null until a real run produces it. These receipts are circular by nature: a completed public run and a real scheduled admission cannot exist before the model is dispatchable, so requiring them to enable dispatch is unsatisfiable. A profile may therefore be active with them null, but never qualified."
        },
        "execution_map_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "qualified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commercial_use",
        "non_clinical",
        "limitations"
      ],
      "properties": {
        "commercial_use": {
          "enum": [
            "allowed",
            "license-dependent",
            "prohibited",
            "blocked"
          ]
        },
        "non_clinical": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "candidate-unqualified"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "route_exposed": {
            "const": false
          },
          "source": {
            "properties": {
              "classification": {
                "const": "candidate-input"
              }
            }
          },
          "execution_identity": {
            "properties": {
              "artifact_manifest_digest": {
                "type": "null"
              },
              "execution_identity_sha256": {
                "type": "null"
              }
            }
          },
          "interface": {
            "properties": {
              "mcp": {
                "properties": {
                  "discoverable": {
                    "const": true
                  },
                  "invocable": {
                    "const": false
                  }
                }
              }
            }
          },
          "semantic_validation": {
            "properties": {
              "state": {
                "const": "candidate-unqualified"
              }
            }
          },
          "qualification": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "qualified",
              "active"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "qualification"
        ],
        "properties": {
          "route_exposed": {
            "const": true
          },
          "source": {
            "properties": {
              "classification": {
                "const": "qualified-input"
              }
            }
          },
          "execution_identity": {
            "properties": {
              "runtime_image_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "artifact_manifest_digest": {
                "$ref": "#/$defs/sha256"
              },
              "execution_identity_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "interface": {
            "properties": {
              "mcp": {
                "properties": {
                  "discoverable": {
                    "const": true
                  },
                  "invocable": {
                    "const": true
                  }
                }
              }
            }
          },
          "access": {
            "oneOf": [
              {
                "properties": {
                  "profile": {
                    "const": "standard"
                  },
                  "state": {
                    "const": "not-required"
                  },
                  "receipt_digest": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "profile": {
                    "const": "academic"
                  },
                  "state": {
                    "const": "verified"
                  },
                  "receipt_digest": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            ]
          },
          "semantic_validation": {
            "properties": {
              "state": {
                "enum": [
                  "qualified",
                  "active"
                ]
              }
            }
          }
        }
      }
    },
    {
      "description": "A null completion or scheduler-eligibility receipt may never imply qualification. state active is dispatchable-but-not-yet-qualified; state qualified requires both.",
      "if": {
        "properties": {
          "state": {
            "const": "qualified"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "qualification": {
            "properties": {
              "public_completion_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "scheduler_eligibility_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 63
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "needs",
        "resource_class",
        "admission_mode",
        "min_parallelism",
        "max_parallelism",
        "checkpoint_mode",
        "preemption_mode"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stage_id"
        },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/stage_id"
          }
        },
        "resource_class": {
          "enum": [
            "cpu",
            "gpu"
          ]
        },
        "admission_mode": {
          "enum": [
            "independent-jobs",
            "gang-jobset"
          ]
        },
        "min_parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "checkpoint_mode": {
          "enum": [
            "none",
            "restart",
            "resume"
          ]
        },
        "preemption_mode": {
          "enum": [
            "non_preemptible",
            "restartable",
            "checkpointable"
          ]
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages",
        "retry",
        "cancellation"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_attempts",
            "retryable_exit_codes"
          ],
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "retryable_exit_codes": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 64,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              }
            }
          }
        },
        "cancellation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "grace_seconds"
          ],
          "properties": {
            "mode": {
              "enum": [
                "terminate-attempt",
                "checkpoint-then-terminate"
              ]
            },
            "grace_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            }
          }
        }
      }
    }
  }
}
