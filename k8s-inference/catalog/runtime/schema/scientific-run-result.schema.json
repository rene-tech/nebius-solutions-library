{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/scientific-run-result/v1",
  "title": "Scientific batch terminal result",
  "description": "Durable terminal operation result with exact execution, scheduling, attempt, and artifact identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation_id",
    "batch_id",
    "workload_id",
    "terminal_status",
    "submitted_at",
    "completed_at",
    "execution_identity",
    "access_admission",
    "scheduling_snapshot",
    "input_manifest",
    "output_manifest",
    "attempts",
    "semantic_validation",
    "error"
  ],
  "properties": {
    "schema": {
      "const": "fs2-serve.nebius.ai/scientific-run-result/v1"
    },
    "operation_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "batch_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "workload_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "terminal_status": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "variant_id",
        "model_revision",
        "runtime_image_digest",
        "runtime_recipe_sha256",
        "workload_recipe_sha256",
        "model_artifact_manifest_digest",
        "execution_identity_sha256"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/model_id"
        },
        "variant_id": {
          "$ref": "#/$defs/model_id"
        },
        "model_revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "runtime_image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runtime_recipe_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "workload_recipe_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_artifact_manifest_digest": {
          "$ref": "#/$defs/sha256"
        },
        "execution_identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "access_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "state",
        "receipt_digest"
      ],
      "properties": {
        "profile": {
          "enum": [
            "standard",
            "academic"
          ]
        },
        "state": {
          "enum": [
            "not-required",
            "verified"
          ]
        },
        "receipt_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile": {
                "const": "academic"
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "verified"
              }
            }
          }
        }
      ]
    },
    "scheduling_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_revision",
        "captured_at",
        "service_class",
        "tenant_queue",
        "model_lane",
        "stages"
      ],
      "properties": {
        "policy_revision": {
          "$ref": "#/$defs/opaque_id"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "service_class": {
          "enum": [
            "presentation",
            "interactive",
            "customer-batch",
            "bulk-backfill"
          ]
        },
        "tenant_queue": {
          "$ref": "#/$defs/opaque_id"
        },
        "model_lane": {
          "$ref": "#/$defs/opaque_id"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stage_scheduling_decision"
          }
        }
      }
    },
    "input_manifest": {
      "$ref": "#/$defs/artifact_ref"
    },
    "output_manifest": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifact_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 655360,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "semantic_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_id",
        "status",
        "receipt_digest"
      ],
      "properties": {
        "validator_id": {
          "$ref": "#/$defs/k8s_name"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "receipt_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "maxLength": 64
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "terminal_status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "output_manifest": {
            "$ref": "#/$defs/artifact_ref"
          },
          "error": {
            "type": "null"
          },
          "semantic_validation": {
            "properties": {
              "status": {
                "const": "passed"
              },
              "receipt_digest": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "attempts": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "k8s_name": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$",
      "maxLength": 253
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 63
    },
    "pool_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[-_a-z0-9.]*[a-z0-9])?$",
      "maxLength": 128
    },
    "extended_resource_name": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+/[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 253
    },
    "stage_scheduling_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "resource_class",
        "resolved_cluster_queue",
        "resolved_local_queue",
        "workload_priority_class",
        "workload_priority_value",
        "resolved_pool_preference",
        "accelerator_resource_name",
        "accelerator_count",
        "max_queue_seconds",
        "max_execution_seconds",
        "checkpoint_mode",
        "preemption_mode"
      ],
      "properties": {
        "stage_id": {
          "$ref": "#/$defs/stage_id"
        },
        "resource_class": {
          "enum": [
            "cpu",
            "gpu"
          ]
        },
        "resolved_cluster_queue": {
          "$ref": "#/$defs/k8s_name"
        },
        "resolved_local_queue": {
          "$ref": "#/$defs/k8s_name"
        },
        "workload_priority_class": {
          "$ref": "#/$defs/k8s_name"
        },
        "workload_priority_value": {
          "type": "integer"
        },
        "resolved_pool_preference": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pool_id"
          }
        },
        "accelerator_resource_name": {
          "oneOf": [
            {
              "$ref": "#/$defs/extended_resource_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "accelerator_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "max_queue_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "max_execution_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "checkpoint_mode": {
          "enum": [
            "none",
            "restart",
            "resume"
          ]
        },
        "preemption_mode": {
          "enum": [
            "non_preemptible",
            "restartable",
            "checkpointable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resource_class": {
                "const": "gpu"
              }
            },
            "required": [
              "resource_class"
            ]
          },
          "then": {
            "properties": {
              "resolved_pool_preference": {
                "minItems": 1
              },
              "accelerator_resource_name": {
                "$ref": "#/$defs/extended_resource_name"
              },
              "accelerator_count": {
                "minimum": 1
              }
            }
          },
          "else": {
            "properties": {
              "resolved_pool_preference": {
                "maxItems": 0
              },
              "accelerator_resource_name": {
                "type": "null"
              },
              "accelerator_count": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "scheduling_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolved_pool_id",
        "admitted_resource_flavor",
        "accelerator_resource_name",
        "accelerator_count",
        "admitted_at"
      ],
      "properties": {
        "resolved_pool_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/pool_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "admitted_resource_flavor": {
          "oneOf": [
            {
              "$ref": "#/$defs/k8s_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "accelerator_resource_name": {
          "oneOf": [
            {
              "$ref": "#/$defs/extended_resource_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "accelerator_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "admitted_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "accelerator_count": {
                "minimum": 1
              }
            },
            "required": [
              "accelerator_count"
            ]
          },
          "then": {
            "properties": {
              "resolved_pool_id": {
                "$ref": "#/$defs/pool_id"
              },
              "admitted_resource_flavor": {
                "$ref": "#/$defs/k8s_name"
              },
              "accelerator_resource_name": {
                "$ref": "#/$defs/extended_resource_name"
              }
            }
          },
          "else": {
            "properties": {
              "resolved_pool_id": {
                "type": "null"
              },
              "admitted_resource_flavor": {
                "type": "null"
              },
              "accelerator_resource_name": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+_-]*$",
          "maxLength": 128
        },
        "compression": {
          "enum": [
            "gzip",
            "zstd",
            "none"
          ]
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "stage_id",
        "shard_id",
        "attempt_number",
        "status",
        "started_at",
        "completed_at",
        "scheduling_admission",
        "kueue_workload_uid",
        "k8s_job_uid",
        "pod_uids",
        "node_uids",
        "gpu_uuids",
        "checkpoint_input",
        "checkpoint_output"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "stage_id": {
          "$ref": "#/$defs/stage_id"
        },
        "shard_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/k8s_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "preempted"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "scheduling_admission": {
          "oneOf": [
            {
              "$ref": "#/$defs/scheduling_admission"
            },
            {
              "type": "null"
            }
          ]
        },
        "kueue_workload_uid": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "k8s_job_uid": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "pod_uids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "node_uids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "gpu_uuids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "checkpoint_input": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint_output": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "succeeded",
                  "preempted"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "scheduling_admission": {
                "$ref": "#/$defs/scheduling_admission"
              }
            }
          }
        }
      ]
    }
  }
}
