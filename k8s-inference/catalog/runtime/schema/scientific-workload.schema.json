{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/scientific-workload/v1",
  "title": "Scientific workload DAG",
  "description": "Operator-owned stage, retry, cancellation, and progress-checkpoint semantics for a scientific batch adapter. The ordered stage list must be topological; the onboarding compiler enforces cross-item references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stages",
    "storage",
    "retry",
    "cancellation"
  ],
  "properties": {
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "storage": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/storage"
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "retryable_exit_codes"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "retryable_exit_codes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          }
        }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "grace_seconds"
      ],
      "properties": {
        "mode": {
          "enum": [
            "terminate-attempt",
            "checkpoint-then-terminate"
          ]
        },
        "grace_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "needs",
        "resource_class",
        "admission_mode",
        "min_parallelism",
        "max_parallelism",
        "checkpoint_mode",
        "preemption_mode"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stage_id"
        },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/stage_id"
          }
        },
        "resource_class": {
          "enum": [
            "cpu",
            "gpu"
          ]
        },
        "resources": {
          "$ref": "#/$defs/stage_resources"
        },
        "admission_mode": {
          "enum": [
            "independent-jobs",
            "gang-jobset"
          ]
        },
        "min_parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "checkpoint_mode": {
          "enum": [
            "none",
            "restart",
            "resume"
          ]
        },
        "preemption_mode": {
          "enum": [
            "non_preemptible",
            "restartable",
            "checkpointable"
          ]
        }
      }
    },
    "stage_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_millis",
        "memory_bytes",
        "ephemeral_storage_request_gib",
        "gpu_count",
        "limits"
      ],
      "properties": {
        "cpu_millis": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "ephemeral_storage_request_gib": {"type": "number", "exclusiveMinimum": 0},
        "gpu_count": {"type": "integer", "minimum": 0, "maximum": 8},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_millis", "memory_bytes", "ephemeral_storage_bytes"],
          "properties": {
            "cpu_millis": {"type": "integer", "minimum": 1},
            "memory_bytes": {"type": "integer", "minimum": 1},
            "ephemeral_storage_bytes": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "minimum_bytes", "access_mode", "read_only", "stages"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[-_a-z0-9.]*[a-z0-9])?$",
          "maxLength": 128
        },
        "purpose": {"enum": ["reference-data", "run-artifacts", "model-artifacts"]},
        "minimum_bytes": {"type": "integer", "minimum": 1},
        "access_mode": {"enum": ["ReadWriteOnce", "ReadWriteMany"]},
        "read_only": {"type": "boolean"},
        "stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stage_id"}
        }
      }
    },
    "stage_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 63
    }
  }
}
