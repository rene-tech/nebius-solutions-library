{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/model-variant-runtime-tuple/v1",
  "title": "Signed exact B300 runtime tuple for a model variant",
  "$comment": "Non-authoritative shape only; signed tuple, supply and artifact subjects must be reopened by the executable verifier.",
  "x-fs2-authority": "non-authoritative-shape-only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_digest", "status", "captured_at", "variant_id", "variant_digest", "supply_receipt_digest", "worker", "runtime", "artifact", "kernels", "valid_until"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/model-variant-runtime-tuple/v1"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "status": {"const": "PASS"},
    "captured_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "variant_id": {"$ref": "#/$defs/id"},
    "variant_digest": {"$ref": "#/$defs/digest"},
    "supply_receipt_digest": {"$ref": "#/$defs/digest"},
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_sha256", "region", "cluster_sha256", "node_name", "node_uid", "worker_image_reference", "worker_image_digest", "driver_version", "cuda_version", "device_plugin_reference", "device_plugin_digest", "gpu_class", "gpu_architecture", "compute_capability", "allocated_gpu_count", "gpu_uuids"],
      "properties": {
        "project_sha256": {"$ref": "#/$defs/digest"},
        "region": {"const": "us-north1"},
        "cluster_sha256": {"$ref": "#/$defs/digest"},
        "node_name": {"type": "string", "minLength": 1},
        "node_uid": {"$ref": "#/$defs/k8sUid"},
        "worker_image_reference": {"$ref": "#/$defs/imageReference"},
        "worker_image_digest": {"$ref": "#/$defs/imageDigest"},
        "driver_version": {"type": "string", "pattern": "^[0-9]{3}\\.[0-9]{2,3}\\.[0-9]{2}$"},
        "cuda_version": {"type": "string", "pattern": "^(?:1[3-9]|[2-9][0-9])\\.[0-9]+(?:\\.[0-9]+)?$"},
        "device_plugin_reference": {"$ref": "#/$defs/imageReference"},
        "device_plugin_digest": {"$ref": "#/$defs/imageDigest"},
        "gpu_class": {"const": "NVIDIA B300"},
        "gpu_architecture": {"const": "sm_103"},
        "compute_capability": {"const": "10.3"},
        "allocated_gpu_count": {"const": 1},
        "gpu_uuids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^GPU-[A-Za-z0-9-]+$"}}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "image_repository", "image_reference", "image_digest", "source_revision", "argv_sha256", "execution_identity_sha256", "network_startup"],
      "properties": {
        "architecture": {"enum": ["portable", "blackwell-sm103"]},
        "image_repository": {"type": "string", "minLength": 1},
        "image_reference": {"$ref": "#/$defs/imageReference"},
        "image_digest": {"$ref": "#/$defs/imageDigest"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "argv_sha256": {"$ref": "#/$defs/digest"},
        "execution_identity_sha256": {"$ref": "#/$defs/digest"},
        "network_startup": {"const": "deny-egress-mounted-content-address-only"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "content_sha256", "mount_read_only", "network_denied_startup"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "mount_read_only": {"const": true},
        "network_denied_startup": {"const": true}
      }
    },
    "kernels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "architecture", "binary_sha256", "dispatch_count"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.$:@/+\\-]{3,255}$"},
          "architecture": {"const": "sm_103"},
          "binary_sha256": {"$ref": "#/$defs/digest"},
          "dispatch_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "valid_until": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "imageReference": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"},
    "k8sUid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"}
  }
}
