{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/external-secrets-provider-build-eligibility-receipt/v1",
  "title": "Separately reviewed eligibility receipt for an optional External Secrets provider build",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "reviewed_at", "valid_until", "operator", "provider", "foundation_release_commit", "controller_image_digest", "crd_bundle_sha256", "provider_build_sha256", "compatibility_test_sha256", "review_commit", "reviewer_identity_sha256", "signed_attestation_digest", "values_suppressed"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/external-secrets-provider-build-eligibility-receipt/v1"},
    "status": {"const": "eligible"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "operator": {"const": "external-secrets-2.5.0"},
    "provider": {"const": "nebiusmysterybox"},
    "foundation_release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "controller_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "crd_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_build_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compatibility_test_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewer_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signed_attestation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "values_suppressed": {"const": true}
  }
}
