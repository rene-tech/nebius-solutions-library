{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/rfdiffusion-parameters/v1",
  "title": "RFdiffusion v1.1.0 scientific run parameters",
  "description": "Bounded public inputs for unconditional backbone design or motif scaffolding. The adapter performs the remaining cross-field contig, length, motif, and seed-range checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "contigs",
    "num_designs",
    "seed",
    "diffuser_T"
  ],
  "properties": {
    "schema": {
      "const": "fs2-serve.nebius.ai/rfdiffusion-parameters/v1"
    },
    "operation": {
      "enum": [
        "design-backbone",
        "scaffold-motif"
      ]
    },
    "contigs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9/-]+$"
      }
    },
    "num_designs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "diffuser_T": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "hotspot_residues": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][0-9]{1,5}$"
      }
    },
    "input_pdb_artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "motif_ca_rmsd_limit": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "scaffold-motif"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "input_pdb_artifact_id"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "input_pdb_artifact_id"
              ]
            },
            {
              "required": [
                "hotspot_residues"
              ]
            }
          ]
        }
      }
    }
  ]
}
