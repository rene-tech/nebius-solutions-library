{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/runtime-startup-receipt/v1",
  "title": "fs2-serve mounted-content network-denied runtime startup receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model_id", "artifact_manifest_digest", "artifact_uri", "mounted_content_path", "effective_argv", "served_model_alias", "pod", "network_policy", "network_probe", "timestamps"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/runtime-startup-receipt/v1"},
    "model_id": {"enum": ["qwen3-8b", "glm-5-2-fp8", "nv-reason-cxr-3b"]},
    "artifact_manifest_digest": {"$ref": "#/$defs/digest"},
    "artifact_uri": {"type": "string", "minLength": 1},
    "mounted_content_path": {"type": "string", "pattern": "^/"},
    "effective_argv": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "served_model_alias": {"type": "string", "minLength": 1},
    "pod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "kind", "namespace", "name", "uid", "owner_uid", "service_account_uid", "container_name", "container_id", "runtime_image_digest"],
      "properties": {
        "api_version": {"const": "v1"}, "kind": {"const": "Pod"}, "namespace": {"const": "fs2-models"}, "name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/uid"}, "owner_uid": {"$ref": "#/$defs/uid"}, "service_account_uid": {"$ref": "#/$defs/uid"}, "container_name": {"const": "model"}, "container_id": {"type": "string", "pattern": "^containerd://[0-9a-f]{64}$"}, "runtime_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "kind", "namespace", "name", "uid", "resource_version", "pod_selector", "policy_types", "egress", "observed_at"],
      "properties": {
        "api_version": {"const": "networking.k8s.io/v1"}, "kind": {"const": "NetworkPolicy"}, "namespace": {"const": "fs2-models"}, "name": {"type": "string", "pattern": "^[a-z0-9-]+-runtime-deny-egress$"}, "uid": {"$ref": "#/$defs/uid"}, "resource_version": {"type": "string", "minLength": 1}, "pod_selector": {"type": "object"}, "policy_types": {"const": ["Egress"]}, "egress": {"const": []}, "observed_at": {"$ref": "#/$defs/time"}
      }
    },
    "network_probe": {
      "type": "object", "additionalProperties": false, "required": ["dns", "https", "model_registry", "observed_at"], "properties": {"dns": {"const": "blocked"}, "https": {"const": "blocked"}, "model_registry": {"const": "blocked"}, "observed_at": {"$ref": "#/$defs/time"}}
    },
    "timestamps": {
      "type": "object", "additionalProperties": false, "required": ["policy_observed_at", "process_started_at", "ready_at"], "properties": {"policy_observed_at": {"$ref": "#/$defs/time"}, "process_started_at": {"$ref": "#/$defs/time"}, "ready_at": {"$ref": "#/$defs/time"}}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
    "time": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
