{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/return-to-zero-receipt/v5",
  "title": "fs2-serve fenced PostgreSQL-intent return-to-zero receipt v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_digest", "status", "observed_at", "model_id", "model_digest", "scale_contract_digest", "runtime_tuple_digest", "intent", "controller", "target", "replicas", "replica_ownership", "timestamps", "drain", "cleanup"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/return-to-zero-receipt/v5"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "status": {"const": "PASS"},
    "observed_at": {"$ref": "#/$defs/time"},
    "model_id": {"type": "string", "minLength": 1},
    "model_digest": {"$ref": "#/$defs/digest"},
    "scale_contract_digest": {"$ref": "#/$defs/digest"},
    "runtime_tuple_digest": {"$ref": "#/$defs/digest"},
    "intent": {"$ref": "#/$defs/intent"},
    "controller": {"$ref": "#/$defs/controller"},
    "target": {"$ref": "#/$defs/target"},
    "replicas": {
      "type": "object", "additionalProperties": false,
      "required": ["previous", "desired", "observed"],
      "properties": {"previous": {"type": "integer", "minimum": 0}, "desired": {"type": "integer", "minimum": 0}, "observed": {"type": "integer", "minimum": 0}}
    },
    "replica_ownership": {"$ref": "#/$defs/replicaOwnership"},
    "timestamps": {
      "type": "object", "additionalProperties": false,
      "required": ["last_activity_at", "cooldown_elapsed_at", "drain_started_at", "mutation_at", "zero_observed_at", "duration_seconds"],
      "properties": {"last_activity_at": {"$ref": "#/$defs/time"}, "cooldown_elapsed_at": {"$ref": "#/$defs/time"}, "drain_started_at": {"$ref": "#/$defs/time"}, "mutation_at": {"$ref": "#/$defs/time"}, "zero_observed_at": {"$ref": "#/$defs/time"}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0}}
    },
    "drain": {
      "type": "object", "additionalProperties": false,
      "required": ["new_admissions_stopped", "active_assignments_before", "active_assignments_after", "preemption_notice_sha256", "interrupted_attempt_ids"],
      "properties": {"new_admissions_stopped": {"const": true}, "active_assignments_before": {"type": "integer", "minimum": 0}, "active_assignments_after": {"const": 0}, "preemption_notice_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "interrupted_attempt_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_resource_uids", "resources", "foreign_uids_touched", "gpu_clients_after", "temporary_paths_absent", "retained_artifact_digests"],
      "properties": {"expected_resource_uids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/resource"}}, "resources": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/resourceResult"}}, "foreign_uids_touched": {"const": false}, "gpu_clients_after": {"const": 0}, "temporary_paths_absent": {"const": true}, "retained_artifact_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "intent_id", "operation_id", "operation_attempt", "fence_operation_id", "model_id", "model_revision", "binding_digest", "action", "subject_sha256", "store_contract_sha256", "submitter_service_account_uid", "submitter_database_role", "claim_owner_service_account_uid", "claim_owner_database_role", "controller_id", "previous_fencing_token", "fencing_token", "database_now", "claim_started_at", "leader_lease_uid", "leader_lease_resource_version", "leader_lease_holder_identity", "claim_lease_expires_at"],
      "properties": {
        "schema": {"const": "fs2-serve.nebius.ai/postgres-activation-intent/v3"},
        "intent_id": {"type": "string", "format": "uuid"},
        "operation_id": {"type": "null"},
        "operation_attempt": {"const": 0},
        "fence_operation_id": {"type": "string", "format": "uuid"},
        "model_id": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"},
        "model_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "binding_digest": {"$ref": "#/$defs/digest"},
        "action": {"const": "deactivate"},
        "subject_sha256": {"$ref": "#/$defs/digest"},
        "store_contract_sha256": {"$ref": "#/$defs/digest"},
        "submitter_service_account_uid": {"$ref": "#/$defs/uid"},
        "submitter_database_role": {"const": "fs2_activation_submitter"},
        "claim_owner_service_account_uid": {"$ref": "#/$defs/uid"},
        "claim_owner_database_role": {"const": "fs2_activation_claim_owner"},
        "controller_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "previous_fencing_token": {"type": "integer", "minimum": 0},
        "fencing_token": {"type": "integer", "minimum": 1},
        "database_now": {"$ref": "#/$defs/time"},
        "claim_started_at": {"$ref": "#/$defs/time"},
        "leader_lease_uid": {"$ref": "#/$defs/uid"},
        "leader_lease_resource_version": {"type": "string", "minLength": 1},
        "leader_lease_holder_identity": {"type": "string", "minLength": 1},
        "claim_lease_expires_at": {"$ref": "#/$defs/time"}
      }
    },
    "controller": {
      "type": "object", "additionalProperties": false,
      "required": ["class", "namespace", "deployment_name", "deployment_uid", "pod_name", "pod_uid", "pod_owner_deployment_uid", "service_account_name", "service_account_uid", "leader_lease_name", "leader_lease_uid", "leader_lease_resource_version", "leader_lease_holder_identity", "leader_lease_renew_time", "leader_lease_duration_seconds", "leader_role_namespace", "leader_role_name", "target_role_namespace", "target_role_name", "submitter_service_account_name", "submitter_service_account_uid", "submitter_deployment_name", "submitter_deployment_uid", "submitter_pod_name", "submitter_pod_uid", "submitter_pod_owner_deployment_uid", "submitter_database_role", "claim_owner_database_role", "submitter_database_secret", "claim_owner_database_secret", "database_grants_sha256", "activation_store_sha256", "activation_store_ddl_sha256", "auth_class", "intent_interface_sha256", "identity_sha256"],
      "properties": {"class": {"const": "fs2-model-activation-controller"}, "namespace": {"const": "fs2-system"}, "deployment_name": {"const": "fs2-serve-control-plane-activation"}, "deployment_uid": {"$ref": "#/$defs/uid"}, "pod_name": {"type": "string", "minLength": 1}, "pod_uid": {"$ref": "#/$defs/uid"}, "pod_owner_deployment_uid": {"$ref": "#/$defs/uid"}, "service_account_name": {"const": "fs2-model-activation-controller"}, "service_account_uid": {"$ref": "#/$defs/uid"}, "leader_lease_name": {"const": "fs2-serve-activation-controller"}, "leader_lease_uid": {"$ref": "#/$defs/uid"}, "leader_lease_resource_version": {"type": "string", "minLength": 1}, "leader_lease_holder_identity": {"type": "string", "minLength": 1}, "leader_lease_renew_time": {"$ref": "#/$defs/time"}, "leader_lease_duration_seconds": {"const": 30}, "leader_role_namespace": {"const": "fs2-system"}, "leader_role_name": {"const": "fs2-serve-control-plane-activation-leader"}, "target_role_namespace": {"const": "fs2-models"}, "target_role_name": {"const": "fs2-serve-control-plane-activation-targets"}, "submitter_service_account_name": {"const": "fs2-serve-control-plane"}, "submitter_service_account_uid": {"$ref": "#/$defs/uid"}, "submitter_deployment_name": {"const": "fs2-serve-control-plane"}, "submitter_deployment_uid": {"$ref": "#/$defs/uid"}, "submitter_pod_name": {"type": "string", "minLength": 1}, "submitter_pod_uid": {"$ref": "#/$defs/uid"}, "submitter_pod_owner_deployment_uid": {"$ref": "#/$defs/uid"}, "submitter_database_role": {"const": "fs2_activation_submitter"}, "claim_owner_database_role": {"const": "fs2_activation_claim_owner"}, "submitter_database_secret": {"$ref": "#/$defs/databaseSecret"}, "claim_owner_database_secret": {"$ref": "#/$defs/databaseSecret"}, "database_grants_sha256": {"$ref": "#/$defs/digest"}, "activation_store_sha256": {"$ref": "#/$defs/digest"}, "activation_store_ddl_sha256": {"$ref": "#/$defs/digest"}, "auth_class": {"const": "postgres-role-grants-plus-projected-ksa-lease-operation-fence"}, "intent_interface_sha256": {"$ref": "#/$defs/digest"}, "identity_sha256": {"$ref": "#/$defs/digest"}}
    },
    "databaseSecret": {"type": "object", "additionalProperties": false, "required": ["namespace", "name", "uid", "resource_version", "type", "key_set"], "properties": {"namespace": {"const": "fs2-system"}, "name": {"enum": ["fs2-activation-submitter-db", "fs2-activation-claim-owner-db"]}, "uid": {"$ref": "#/$defs/uid"}, "resource_version": {"type": "string", "minLength": 1}, "type": {"const": "Opaque"}, "key_set": {"const": ["dsn"]}}},
    "replicaOwnership": {"type": "object", "additionalProperties": false, "required": ["schema", "api_server_identity_sha256", "target_uid", "target_resource_version", "managed_fields_resource_version", "managed_fields_observed_at", "replica_field_manager", "replica_field_path", "fields_v1_sha256", "gitops_manager", "gitops_owns_replicas", "foreign_replica_managers", "ownership_annotation_sha256"], "properties": {"schema": {"const": "fs2-serve.nebius.ai/replica-field-ownership-receipt/v1"}, "api_server_identity_sha256": {"$ref": "#/$defs/digest"}, "target_uid": {"$ref": "#/$defs/uid"}, "target_resource_version": {"type": "string", "minLength": 1}, "managed_fields_resource_version": {"type": "string", "minLength": 1}, "managed_fields_observed_at": {"$ref": "#/$defs/time"}, "replica_field_manager": {"const": "fs2-model-activation-controller"}, "replica_field_path": {"const": "f:spec/f:replicas"}, "fields_v1_sha256": {"$ref": "#/$defs/digest"}, "gitops_manager": {"const": "argocd-application-controller"}, "gitops_owns_replicas": {"const": false}, "foreign_replica_managers": {"const": []}, "ownership_annotation_sha256": {"$ref": "#/$defs/digest"}}},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["api_version", "kind", "namespace", "name", "uid", "resource_version", "observed_generation", "template_identity_sha256"],
      "properties": {"api_version": {"enum": ["apps/v1", "apps.nvidia.com/v1alpha1"]}, "kind": {"enum": ["Deployment", "NIMService"]}, "namespace": {"const": "fs2-models"}, "name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/uid"}, "resource_version": {"type": "string", "minLength": 1}, "observed_generation": {"type": "integer", "minimum": 1}, "template_identity_sha256": {"$ref": "#/$defs/digest"}}
    },
    "resource": {"type": "object", "additionalProperties": false, "required": ["api_version", "kind", "namespace", "name", "uid"], "properties": {"api_version": {"type": "string", "minLength": 1}, "kind": {"enum": ["Deployment", "NIMService", "Pod"]}, "namespace": {"const": "fs2-models"}, "name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/uid"}}},
    "resourceResult": {"type": "object", "additionalProperties": false, "required": ["api_version", "kind", "namespace", "name", "uid", "precondition_uid", "final_state"], "properties": {"api_version": {"type": "string", "minLength": 1}, "kind": {"enum": ["Deployment", "NIMService", "Pod"]}, "namespace": {"const": "fs2-models"}, "name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/uid"}, "precondition_uid": {"$ref": "#/$defs/uid"}, "final_state": {"enum": ["absent", "retained-scaled-zero"]}}}
  }
}
