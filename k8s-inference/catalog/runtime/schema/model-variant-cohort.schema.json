{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/model-variant-cohort/v3",
  "title": "Failure-complete cold or warm model-variant cohort",
  "$comment": "Non-authoritative shape only; totals, failures, timestamps and semantic subjects are recomputed by the executable verifier.",
  "x-fs2-authority": "non-authoritative-shape-only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_digest", "status", "variant_id", "variant_digest", "cohort_kind", "runtime_tuple_digest", "artifact_manifest_digest", "attempts_total", "successes_total", "failures_total", "failures_in_denominator", "attempts", "valid_until"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/model-variant-cohort/v3"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "status": {"const": "PASS"},
    "variant_id": {"$ref": "#/$defs/id"},
    "variant_digest": {"$ref": "#/$defs/digest"},
    "cohort_kind": {"enum": ["cold", "warm"]},
    "runtime_tuple_digest": {"$ref": "#/$defs/digest"},
    "artifact_manifest_digest": {"$ref": "#/$defs/digest"},
    "attempts_total": {"type": "integer", "minimum": 1},
    "successes_total": {"type": "integer", "minimum": 1},
    "failures_total": {"type": "integer", "minimum": 0},
    "failures_in_denominator": {"const": true},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/attempt"}
    },
    "valid_until": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "allOf": [
    {
      "if": {"properties": {"cohort_kind": {"const": "cold"}}, "required": ["cohort_kind"]},
      "then": {
        "properties": {
          "attempts_total": {"type": "integer", "minimum": 3},
          "attempts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/attempt"}}
        }
      }
    },
    {
      "if": {"properties": {"cohort_kind": {"const": "warm"}}, "required": ["cohort_kind"]},
      "then": {
        "properties": {
          "attempts_total": {"type": "integer", "minimum": 10},
          "attempts": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/attempt"}}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"},
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "status", "t0", "completed_at", "duration_seconds", "failure_reason", "semantic_receipt_digest", "output_sha256", "kernel_dispatch_sha256", "pre_t0_work_sha256", "pod_uid", "node_uid", "gpu_uuid", "cold_boundary_receipt_digest"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "t0": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "completed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "failure_reason": {"type": ["string", "null"], "minLength": 1},
        "semantic_receipt_digest": {"$ref": "#/$defs/nullableDigest"},
        "output_sha256": {"$ref": "#/$defs/nullableDigest"},
        "kernel_dispatch_sha256": {"$ref": "#/$defs/nullableDigest"},
        "pre_t0_work_sha256": {"$ref": "#/$defs/digest"},
        "pod_uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
        "node_uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
        "gpu_uuid": {"type": "string", "pattern": "^GPU-[A-Za-z0-9-]+$"},
        "cold_boundary_receipt_digest": {"$ref": "#/$defs/nullableDigest"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
          "then": {
            "properties": {
              "failure_reason": {"const": null},
              "semantic_receipt_digest": {"$ref": "#/$defs/digest"},
              "output_sha256": {"$ref": "#/$defs/digest"},
              "kernel_dispatch_sha256": {"$ref": "#/$defs/digest"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "FAIL"}}, "required": ["status"]},
          "then": {
            "properties": {
              "failure_reason": {"type": "string", "minLength": 1},
              "semantic_receipt_digest": {"const": null},
              "output_sha256": {"const": null},
              "kernel_dispatch_sha256": {"const": null}
            }
          }
        }
      ]
    }
  }
}
