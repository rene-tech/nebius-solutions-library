{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/scientific-source-candidate-receipts/v1",
  "title": "Scientific source candidate receipts",
  "description": "Immutable upstream HEAD observations used only to start review. These receipts are not build, artifact, access, license, hardware, semantic, performance, or production qualification evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observed_on",
    "receipts"
  ],
  "properties": {
    "schema": {
      "const": "fs2-serve.nebius.ai/scientific-source-candidate-receipts/v1"
    },
    "observed_on": {
      "type": "string",
      "format": "date"
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "upstream_name",
          "backend_identity",
          "status",
          "qualification_state",
          "observation_method",
          "source",
          "access_profile",
          "access_state",
          "notes"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "upstream_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "backend_identity": {
            "const": "native-upstream"
          },
          "status": {
            "const": "candidate"
          },
          "qualification_state": {
            "const": "unqualified"
          },
          "observation_method": {
            "const": "git-ls-remote-head"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "repository",
              "revision",
              "review_url"
            ],
            "properties": {
              "kind": {
                "const": "git"
              },
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*/[A-Za-z0-9_][A-Za-z0-9._-]*$",
                "maxLength": 96
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "review_url": {
                "type": "string",
                "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/tree/[0-9a-f]{40}$",
                "maxLength": 2048
              }
            }
          },
          "access_profile": {
            "enum": [
              "standard",
              "academic"
            ]
          },
          "access_state": {
            "const": "unverified"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  }
}
