{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/artifact-acquisition-worker-result/v1",
  "title": "Unpromotable in-Pod artifact acquisition worker result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_digest", "operation_id", "model_id", "model_digest", "method", "source", "artifact_manifest_digest", "artifact_content_digest", "content_uri", "prerequisite_ids", "storage", "credential_source", "token_used", "publication", "controller_owner", "acquisition_plan_sha256", "helper_image", "execution", "filesystem_write_proof", "lock_path", "capacity_bound_bytes", "reserve_bytes", "free_bytes_before", "free_bytes_after", "outcome", "cleanup"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/artifact-acquisition-worker-result/v1"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"},
    "model_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "model_digest": {"$ref": "#/$defs/digest"},
    "method": {"const": "huggingface-public-snapshot"},
    "source": {"type": "object"},
    "artifact_manifest_digest": {"$ref": "#/$defs/digest"},
    "artifact_content_digest": {"$ref": "#/$defs/digest"},
    "content_uri": {"type": "string", "minLength": 1},
    "prerequisite_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
    "storage": {"type": "object"},
    "credential_source": {"const": "none-public-revision"},
    "token_used": {"const": false},
    "publication": {"enum": ["atomic-content-addressed-sfs", "atomic-content-addressed-provider-block-pvc"]},
    "controller_owner": {"const": "fs2-serve-acquirer"},
    "acquisition_plan_sha256": {"$ref": "#/$defs/digest"},
    "helper_image": {"$ref": "#/$defs/helperImage"},
    "execution": {"$ref": "#/$defs/execution"},
    "filesystem_write_proof": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "lock_path": {"type": "string", "minLength": 1},
    "capacity_bound_bytes": {"type": "integer", "minimum": 1},
    "reserve_bytes": {"type": "integer", "minimum": 0},
    "free_bytes_before": {"type": "integer", "minimum": 0},
    "free_bytes_after": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["acquired", "already-present"]},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["temporary_path_absent"], "properties": {"temporary_path_absent": {"const": true}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "k8sUid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
    "helperImage": {"type": "object", "additionalProperties": false, "required": ["id", "reference", "digest", "admission_receipt_digest", "registry_identity_sha256", "build_identity_sha256", "helper_contract_sha256"], "properties": {"id": {"const": "fs2-acquisition-helper"}, "reference": {"type": "string", "pattern": "^[^@\\s]+/fs2-serve/acquisition-helper@sha256:[0-9a-f]{64}$"}, "digest": {"$ref": "#/$defs/imageDigest"}, "admission_receipt_digest": {"$ref": "#/$defs/digest"}, "registry_identity_sha256": {"$ref": "#/$defs/digest"}, "build_identity_sha256": {"$ref": "#/$defs/digest"}, "helper_contract_sha256": {"$ref": "#/$defs/digest"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["run_as_non_root", "run_as_uid", "run_as_gid", "fs_group", "supplemental_groups_policy", "seccomp_profile", "job", "pod"], "properties": {"run_as_non_root": {"const": true}, "run_as_uid": {"const": 10001}, "run_as_gid": {"const": 10001}, "fs_group": {"const": 10001}, "supplemental_groups_policy": {"const": "Strict"}, "seccomp_profile": {"const": "RuntimeDefault"}, "job": {"$ref": "#/$defs/job"}, "pod": {"$ref": "#/$defs/pod"}}},
    "job": {"type": "object", "additionalProperties": false, "required": ["api_version", "kind", "namespace", "name", "uid"], "properties": {"api_version": {"const": "batch/v1"}, "kind": {"const": "Job"}, "namespace": {"const": "fs2-models"}, "name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/k8sUid"}}},
    "pod": {"type": "object", "additionalProperties": false, "required": ["api_version", "kind", "namespace", "name", "uid", "owner_job_uid"], "properties": {"api_version": {"const": "v1"}, "kind": {"const": "Pod"}, "namespace": {"const": "fs2-models"}, "name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/k8sUid"}, "owner_job_uid": {"$ref": "#/$defs/k8sUid"}}}
  }
}
