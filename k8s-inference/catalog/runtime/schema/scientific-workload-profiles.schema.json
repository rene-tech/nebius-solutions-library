                    "type",
                    "additionalProperties"
                  ],
                  "type": "object"
                }
              ]
            },
            "parameter_schema_sha256": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "protocol": {
              "const": "scientific-batch-v1"
