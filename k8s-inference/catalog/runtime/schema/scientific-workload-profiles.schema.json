              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "variant_submit_endpoint": {
              "maxLength": 256,
              "pattern": "^/v1/models/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/variants/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?:submit$",
              "type": "string"
            }
          },
          "required": [
            "protocol",
            "variant_submit_endpoint",
            "default_submit_endpoint",
            "request_schema",
            "result_schema",
            "parameter_schema",
            "parameter_schema_sha256",
            "parameter_schema_definition",
            "operations",
            "service_classes",
            "mcp"
          ],
          "type": "object"
        },
        "model_id": {
          "$ref": "#/$defs/model_id"
