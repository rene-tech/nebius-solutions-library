              "const": "fs2-serve.nebius.ai/scientific-run-request/v1"
            },
            "result_schema": {
              "const": "fs2-serve.nebius.ai/scientific-run-result/v1"
            },
            "service_classes": {
              "items": {
                "enum": [
                  "presentation",
