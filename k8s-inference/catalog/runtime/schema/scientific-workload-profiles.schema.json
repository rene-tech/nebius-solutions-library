            },
            "limitations": {
              "items": {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "non_clinical": {
              "type": "boolean"
            }
          },
          "required": [
