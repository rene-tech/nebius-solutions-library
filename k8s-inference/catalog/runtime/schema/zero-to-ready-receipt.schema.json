{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/zero-to-ready-receipt/v5",
  "title": "fs2-serve DB-fenced zero-to-ready and isolated-startup receipt v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_digest", "status", "observed_at", "model_id", "model_digest", "scale_contract_digest", "runtime_tuple_digest", "intent", "controller", "target", "replicas", "replica_ownership", "runtime_startup", "timestamps", "readiness", "warmup", "preemption"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/zero-to-ready-receipt/v5"},
    "receipt_digest": {"$ref": "#/$defs/digest"}, "status": {"const": "PASS"}, "observed_at": {"$ref": "#/$defs/time"},
    "model_id": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"}, "model_digest": {"$ref": "#/$defs/digest"},
    "scale_contract_digest": {"$ref": "#/$defs/digest"}, "runtime_tuple_digest": {"$ref": "#/$defs/digest"},
    "intent": {"$ref": "#/$defs/intent"}, "controller": {"$ref": "#/$defs/controller"}, "target": {"$ref": "#/$defs/target"},
    "replicas": {"type": "object", "additionalProperties": false, "required": ["previous", "desired", "observed"], "properties": {"previous": {"type": "integer", "minimum": 0}, "desired": {"type": "integer", "minimum": 0}, "observed": {"type": "integer", "minimum": 0}}},
    "replica_ownership": {"$ref": "#/$defs/replicaOwnership"},
    "runtime_startup": {"oneOf": [{"$ref": "#/$defs/runtimeStartup"}, {"type": "null"}]},
    "timestamps": {"type": "object", "additionalProperties": false, "required": ["accepted_at", "mutation_at", "ready_at", "duration_seconds"], "properties": {"accepted_at": {"$ref": "#/$defs/time"}, "mutation_at": {"$ref": "#/$defs/time"}, "ready_at": {"$ref": "#/$defs/time"}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0}}},
    "readiness": {"type": "object", "additionalProperties": false, "required": ["method", "path", "expected_status", "observed_status", "checked_at"], "properties": {"method": {"enum": ["GET", "POST"]}, "path": {"type": "string", "pattern": "^/"}, "expected_status": {"type": "integer", "minimum": 100, "maximum": 599}, "observed_status": {"type": "integer", "minimum": 100, "maximum": 599}, "checked_at": {"$ref": "#/$defs/time"}}},
    "warmup": {"type": "object", "additionalProperties": false, "required": ["required", "status", "checked_at"], "properties": {"required": {"type": "boolean"}, "status": {"enum": ["PASS", "not-required"]}, "checked_at": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}}},
    "preemption": {"type": "object", "additionalProperties": false, "required": ["notice_observed", "new_admissions", "attempt_outcome"], "properties": {"notice_observed": {"type": "boolean"}, "new_admissions": {"enum": ["allow", "stop"]}, "attempt_outcome": {"enum": ["PASS", "PREEMPTED"]}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "time": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
    "databaseSecret": {"type": "object", "additionalProperties": false, "required": ["namespace", "name", "uid", "resource_version", "type", "key_set"], "properties": {"namespace": {"const": "fs2-system"}, "name": {"enum": ["fs2-activation-submitter-db", "fs2-activation-claim-owner-db"]}, "uid": {"$ref": "#/$defs/uid"}, "resource_version": {"type": "string", "minLength": 1}, "type": {"const": "Opaque"}, "key_set": {"const": ["dsn"]}}},
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "intent_id", "operation_id", "operation_attempt", "fence_operation_id", "model_id", "model_revision", "binding_digest", "action", "subject_sha256", "store_contract_sha256", "submitter_service_account_uid", "submitter_database_role", "claim_owner_service_account_uid", "claim_owner_database_role", "controller_id", "previous_fencing_token", "fencing_token", "database_now", "claim_started_at", "leader_lease_uid", "leader_lease_resource_version", "leader_lease_holder_identity", "claim_lease_expires_at"],
      "properties": {"schema": {"const": "fs2-serve.nebius.ai/postgres-activation-intent/v3"}, "intent_id": {"type": "string", "format": "uuid"}, "operation_id": {"type": "string", "format": "uuid"}, "operation_attempt": {"type": "integer", "minimum": 0, "maximum": 10}, "fence_operation_id": {"type": "string", "format": "uuid"}, "model_id": {"type": "string", "minLength": 1}, "model_revision": {"type": "string", "minLength": 1}, "binding_digest": {"$ref": "#/$defs/digest"}, "action": {"const": "activate"}, "subject_sha256": {"$ref": "#/$defs/digest"}, "store_contract_sha256": {"$ref": "#/$defs/digest"}, "submitter_service_account_uid": {"$ref": "#/$defs/uid"}, "submitter_database_role": {"const": "fs2_activation_submitter"}, "claim_owner_service_account_uid": {"$ref": "#/$defs/uid"}, "claim_owner_database_role": {"const": "fs2_activation_claim_owner"}, "controller_id": {"type": "string", "minLength": 1}, "previous_fencing_token": {"type": "integer", "minimum": 0}, "fencing_token": {"type": "integer", "minimum": 1}, "database_now": {"$ref": "#/$defs/time"}, "claim_started_at": {"$ref": "#/$defs/time"}, "leader_lease_uid": {"$ref": "#/$defs/uid"}, "leader_lease_resource_version": {"type": "string", "minLength": 1}, "leader_lease_holder_identity": {"type": "string", "minLength": 1}, "claim_lease_expires_at": {"$ref": "#/$defs/time"}}
    },
    "controller": {
      "type": "object", "additionalProperties": false,
      "required": ["class", "namespace", "deployment_name", "deployment_uid", "pod_name", "pod_uid", "pod_owner_deployment_uid", "service_account_name", "service_account_uid", "leader_lease_name", "leader_lease_uid", "leader_lease_resource_version", "leader_lease_holder_identity", "leader_lease_renew_time", "leader_lease_duration_seconds", "leader_role_namespace", "leader_role_name", "target_role_namespace", "target_role_name", "submitter_service_account_name", "submitter_service_account_uid", "submitter_deployment_name", "submitter_deployment_uid", "submitter_pod_name", "submitter_pod_uid", "submitter_pod_owner_deployment_uid", "submitter_database_role", "claim_owner_database_role", "submitter_database_secret", "claim_owner_database_secret", "database_grants_sha256", "activation_store_sha256", "activation_store_ddl_sha256", "auth_class", "intent_interface_sha256", "identity_sha256"],
      "properties": {"class": {"const": "fs2-model-activation-controller"}, "namespace": {"const": "fs2-system"}, "deployment_name": {"const": "fs2-serve-control-plane-activation"}, "deployment_uid": {"$ref": "#/$defs/uid"}, "pod_name": {"type": "string", "minLength": 1}, "pod_uid": {"$ref": "#/$defs/uid"}, "pod_owner_deployment_uid": {"$ref": "#/$defs/uid"}, "service_account_name": {"const": "fs2-model-activation-controller"}, "service_account_uid": {"$ref": "#/$defs/uid"}, "leader_lease_name": {"const": "fs2-serve-activation-controller"}, "leader_lease_uid": {"$ref": "#/$defs/uid"}, "leader_lease_resource_version": {"type": "string", "minLength": 1}, "leader_lease_holder_identity": {"type": "string", "minLength": 1}, "leader_lease_renew_time": {"$ref": "#/$defs/time"}, "leader_lease_duration_seconds": {"const": 30}, "leader_role_namespace": {"const": "fs2-system"}, "leader_role_name": {"const": "fs2-serve-control-plane-activation-leader"}, "target_role_namespace": {"const": "fs2-models"}, "target_role_name": {"const": "fs2-serve-control-plane-activation-targets"}, "submitter_service_account_name": {"const": "fs2-serve-control-plane"}, "submitter_service_account_uid": {"$ref": "#/$defs/uid"}, "submitter_deployment_name": {"const": "fs2-serve-control-plane"}, "submitter_deployment_uid": {"$ref": "#/$defs/uid"}, "submitter_pod_name": {"type": "string", "minLength": 1}, "submitter_pod_uid": {"$ref": "#/$defs/uid"}, "submitter_pod_owner_deployment_uid": {"$ref": "#/$defs/uid"}, "submitter_database_role": {"const": "fs2_activation_submitter"}, "claim_owner_database_role": {"const": "fs2_activation_claim_owner"}, "submitter_database_secret": {"$ref": "#/$defs/databaseSecret"}, "claim_owner_database_secret": {"$ref": "#/$defs/databaseSecret"}, "database_grants_sha256": {"$ref": "#/$defs/digest"}, "activation_store_sha256": {"$ref": "#/$defs/digest"}, "activation_store_ddl_sha256": {"$ref": "#/$defs/digest"}, "auth_class": {"const": "postgres-role-grants-plus-projected-ksa-lease-operation-fence"}, "intent_interface_sha256": {"$ref": "#/$defs/digest"}, "identity_sha256": {"$ref": "#/$defs/digest"}}
    },
    "target": {"type": "object", "additionalProperties": false, "required": ["api_version", "kind", "namespace", "name", "uid", "resource_version", "observed_generation", "template_identity_sha256"], "properties": {"api_version": {"enum": ["apps/v1", "apps.nvidia.com/v1alpha1"]}, "kind": {"enum": ["Deployment", "NIMService"]}, "namespace": {"const": "fs2-models"}, "name": {"type": "string", "minLength": 1}, "uid": {"$ref": "#/$defs/uid"}, "resource_version": {"type": "string", "minLength": 1}, "observed_generation": {"type": "integer", "minimum": 1}, "template_identity_sha256": {"$ref": "#/$defs/digest"}}},
    "replicaOwnership": {"type": "object", "additionalProperties": false, "required": ["schema", "api_server_identity_sha256", "target_uid", "target_resource_version", "managed_fields_resource_version", "managed_fields_observed_at", "replica_field_manager", "replica_field_path", "fields_v1_sha256", "gitops_manager", "gitops_owns_replicas", "foreign_replica_managers", "ownership_annotation_sha256"], "properties": {"schema": {"const": "fs2-serve.nebius.ai/replica-field-ownership-receipt/v1"}, "api_server_identity_sha256": {"$ref": "#/$defs/digest"}, "target_uid": {"$ref": "#/$defs/uid"}, "target_resource_version": {"type": "string", "minLength": 1}, "managed_fields_resource_version": {"type": "string", "minLength": 1}, "managed_fields_observed_at": {"$ref": "#/$defs/time"}, "replica_field_manager": {"const": "fs2-model-activation-controller"}, "replica_field_path": {"const": "f:spec/f:replicas"}, "fields_v1_sha256": {"$ref": "#/$defs/digest"}, "gitops_manager": {"const": "argocd-application-controller"}, "gitops_owns_replicas": {"const": false}, "foreign_replica_managers": {"const": []}, "ownership_annotation_sha256": {"$ref": "#/$defs/digest"}}},
    "runtimeStartup": {"type": "object", "additionalProperties": false, "required": ["schema", "model_id", "artifact_manifest_digest", "artifact_uri", "mounted_content_path", "effective_argv", "served_model_alias", "pod", "network_policy", "network_probe", "timestamps"], "properties": {"schema": {"const": "fs2-serve.nebius.ai/runtime-startup-receipt/v1"}, "model_id": {"enum": ["qwen3-8b", "glm-5-2-fp8", "nv-reason-cxr-3b"]}, "artifact_manifest_digest": {"$ref": "#/$defs/digest"}, "artifact_uri": {"type": "string", "minLength": 1}, "mounted_content_path": {"type": "string", "pattern": "^/"}, "effective_argv": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "served_model_alias": {"type": "string", "minLength": 1}, "pod": {"type": "object"}, "network_policy": {"type": "object"}, "network_probe": {"type": "object"}, "timestamps": {"type": "object"}}}
  }
}
