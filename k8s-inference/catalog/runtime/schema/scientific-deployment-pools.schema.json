{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/scientific-deployment-pools/v1",
  "title": "Reviewed deployment pools usable by scientific workload profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "deployment", "evidence", "pools"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/scientific-deployment-pools/v1"},
    "deployment": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"},
    "evidence": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/#-]*$"},
    "pools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pool_id", "accelerator_class", "accelerator_resource_name", "gpus_per_node", "capacity_type"],
        "properties": {
          "pool_id": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"},
          "accelerator_class": {"const": "nvidia-h100-sxm5-80gb"},
          "accelerator_resource_name": {"const": "nvidia.com/gpu"},
          "gpus_per_node": {"type": "integer", "minimum": 1, "maximum": 8},
          "capacity_type": {"enum": ["regular", "preemptible"]}
        }
      }
    }
  }
}
