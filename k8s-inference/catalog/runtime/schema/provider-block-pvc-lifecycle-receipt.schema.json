{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/provider-block-pvc-lifecycle-receipt/v4",
  "title": "fs2-serve provider block PVC lifecycle qualification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_digest", "status", "observed_at", "model_id", "model_digest", "artifact_manifest_digest", "artifact_content_digest", "content_uri", "acquisition_receipt_digest", "storage_class_admission_receipt_digest", "writer_admission_receipt_digest", "storage_class", "claim", "acquirer_job", "writer_fence", "handoff", "replacement", "runtime", "scale_to_zero"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/provider-block-pvc-lifecycle-receipt/v4"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "status": {"const": "PASS"},
    "observed_at": {"type": "string", "format": "date-time"},
    "model_id": {"const": "qwen3-8b"},
    "model_digest": {"$ref": "#/$defs/digest"},
    "artifact_manifest_digest": {"$ref": "#/$defs/digest"},
    "artifact_content_digest": {"$ref": "#/$defs/digest"},
    "content_uri": {"type": "string", "pattern": "^pvc://fs2-models/qwen3-8b-weights/models/qwen3-8b/sha256/[0-9a-f]{64}$"},
    "acquisition_receipt_digest": {"$ref": "#/$defs/digest"},
    "storage_class_admission_receipt_digest": {"$ref": "#/$defs/digest"},
    "writer_admission_receipt_digest": {"$ref": "#/$defs/digest"},
    "storage_class": {"$ref": "#/$defs/storageClass"},
    "claim": {"$ref": "#/$defs/claim"},
    "acquirer_job": {"$ref": "#/$defs/acquirer"},
    "writer_fence": {
      "type": "object", "additionalProperties": false,
      "required": ["controller_identity_sha256", "writer_admission_complete_mount_set_sha256", "lease", "api_observation"],
      "properties": {
        "controller_identity_sha256": {"$ref": "#/$defs/digest"},
        "writer_admission_complete_mount_set_sha256": {"$ref": "#/$defs/digest"},
        "lease": {
          "type": "object", "additionalProperties": false,
          "required": ["uid", "resource_version", "holder_identity", "fencing_token"],
          "properties": {"uid": {"$ref": "#/$defs/uid"}, "resource_version": {"type": "string", "minLength": 1}, "holder_identity": {"type": "string", "minLength": 1}, "fencing_token": {"type": "integer", "minimum": 1}}
        },
        "api_observation": {
          "type": "object", "additionalProperties": false,
          "required": ["observed_at", "api_server_identity_sha256", "claim_uid", "claim_resource_version", "active_writer_uids", "denied_second_writer_request_uid", "denial_reason"],
          "properties": {
            "observed_at": {"type": "string", "format": "date-time"}, "api_server_identity_sha256": {"$ref": "#/$defs/digest"}, "claim_uid": {"$ref": "#/$defs/uid"}, "claim_resource_version": {"type": "string", "minLength": 1},
            "active_writer_uids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/uid"}}, "denied_second_writer_request_uid": {"$ref": "#/$defs/uid"}, "denial_reason": {"const": "fs2-provider-block-sole-writer-fence-conflict"}
          }
        }
      }
    },
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["closed_at", "writer_admission_receipt_digest", "writer_admission_complete_mount_set_sha256", "no_active_writers", "active_writer_uids", "sole_writer_uid", "payload_read_only_after_handoff", "runtime_read_only_admitted", "lease_uid", "lease_resource_version_after_release", "lease_holder_identity_after_release", "released_fencing_token", "api_server_observed"],
      "properties": {
        "closed_at": {"type": "string", "format": "date-time"},
        "writer_admission_receipt_digest": {"$ref": "#/$defs/digest"},
        "writer_admission_complete_mount_set_sha256": {"$ref": "#/$defs/digest"},
        "no_active_writers": {"const": true},
        "active_writer_uids": {"const": []},
        "sole_writer_uid": {"$ref": "#/$defs/uid"},
        "payload_read_only_after_handoff": {"const": true},
        "runtime_read_only_admitted": {"const": true},
        "lease_uid": {"$ref": "#/$defs/uid"},
        "lease_resource_version_after_release": {"type": "string", "minLength": 1},
        "lease_holder_identity_after_release": {"type": "null"},
        "released_fencing_token": {"type": "integer", "minimum": 1},
        "api_server_observed": {"const": true}
      }
    },
    "replacement": {
      "type": "object", "additionalProperties": false,
      "required": ["controlled", "original_node", "replacement_node", "detached_at", "attached_at", "no_multi_attach", "attach_attempts", "manifest_reverified"],
      "properties": {
        "controlled": {"const": true},
        "original_node": {"$ref": "#/$defs/node"},
        "replacement_node": {"$ref": "#/$defs/node"},
        "detached_at": {"type": "string", "format": "date-time"},
        "attached_at": {"type": "string", "format": "date-time"},
        "no_multi_attach": {"const": true},
        "attach_attempts": {"type": "integer", "minimum": 1},
        "manifest_reverified": {"const": true}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["deployment_namespace", "deployment_name", "deployment_uid", "runtime_tuple_digest", "node", "pvc_read_only", "gpu_count", "semantic_receipt_digest"],
      "properties": {
        "deployment_namespace": {"const": "fs2-models"},
        "deployment_name": {"const": "qwen3-8b"},
        "deployment_uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
        "runtime_tuple_digest": {"$ref": "#/$defs/digest"},
        "node": {"$ref": "#/$defs/node"},
        "pvc_read_only": {"const": true},
        "gpu_count": {"const": 1},
        "semantic_receipt_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "scale_to_zero": {
      "type": "object", "additionalProperties": false,
      "required": ["from_replicas", "to_replicas", "return_to_zero_receipt_digest", "claim_retained", "claim_state", "no_active_writers"],
      "properties": {
        "from_replicas": {"const": 1},
        "to_replicas": {"const": 0},
        "return_to_zero_receipt_digest": {"$ref": "#/$defs/digest"},
        "claim_retained": {"const": true},
        "claim_state": {"const": "Bound"},
        "no_active_writers": {"const": true}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "uid", "provider_id_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
        "provider_id_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "storageClass": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": {"const": "storage.k8s.io/v1"},
        "kind": {"const": "StorageClass"},
        "metadata": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "uid", "resourceVersion"],
          "properties": {
            "name": {"const": "fs2-network-ssd-retain"},
            "uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
            "resourceVersion": {"type": "string", "minLength": 1}
          }
        },
        "spec": {
          "type": "object", "additionalProperties": false,
          "required": ["provisioner", "reclaimPolicy", "volumeBindingMode", "allowVolumeExpansion", "parameters"],
          "properties": {
            "provisioner": {"const": "compute.csi.nebius.com"},
            "reclaimPolicy": {"const": "Retain"},
            "volumeBindingMode": {"const": "WaitForFirstConsumer"},
            "allowVolumeExpansion": {"const": true},
            "parameters": {
              "const": {
                "type": "NETWORK_SSD",
                "csi.storage.k8s.io/fstype": "ext4"
              }
            }
          }
        }
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace", "name", "uid", "resource_version", "volume_name", "capacity_bytes", "access_modes", "volume_mode", "phase", "bound_at", "bound_after_acquirer_scheduled"],
      "properties": {
        "namespace": {"const": "fs2-models"},
        "name": {"const": "qwen3-8b-weights"},
        "uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
        "resource_version": {"type": "string", "minLength": 1},
        "volume_name": {"type": "string", "minLength": 1},
        "capacity_bytes": {"type": "integer", "minimum": 68719476736},
        "access_modes": {"const": ["ReadWriteOnce"]},
        "volume_mode": {"const": "Filesystem"},
        "phase": {"const": "Bound"},
        "bound_at": {"type": "string", "format": "date-time"},
        "bound_after_acquirer_scheduled": {"const": true}
      }
    },
    "acquirer": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace", "name", "uid", "resource_version", "scheduled_at", "completed_at", "node", "node_selector", "tolerations", "gpu_count", "first_consumer", "sole_writer", "phase"],
      "properties": {
        "namespace": {"const": "fs2-models"},
        "name": {"type": "string", "pattern": "^qwen3-8b-cache-"},
        "uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"},
        "resource_version": {"type": "string", "minLength": 1},
        "scheduled_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "node": {"$ref": "#/$defs/node"},
        "node_selector": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string"}},
        "tolerations": {"type": "array", "minItems": 1},
        "gpu_count": {"const": 0},
        "first_consumer": {"const": true},
        "sole_writer": {"const": true},
        "phase": {"const": "Succeeded"}
      }
    }
  }
}
