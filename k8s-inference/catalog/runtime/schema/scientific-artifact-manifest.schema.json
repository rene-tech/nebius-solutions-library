{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/scientific-artifact-manifest/v1",
  "title": "Scientific artifact manifest",
  "description": "Typed immutable inputs or outputs for one scientific operation. Artifact references contain identities, never local paths or bearer URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "fs2-serve.nebius.ai/scientific-artifact-manifest/v1"
    },
    "manifest_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "semantic_type",
          "artifact"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "maxLength": 128
          },
          "semantic_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*/v[1-9][0-9]*$",
            "maxLength": 128
          },
          "artifact": {
            "$ref": "#/$defs/artifact_ref"
          }
        }
      }
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+_-]*$",
          "maxLength": 128
        },
        "compression": {
          "enum": [
            "gzip",
            "zstd",
            "none"
          ]
        }
      }
    }
  }
}
