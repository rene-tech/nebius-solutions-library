{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/faststart-job-admission/v2",
  "title": "Signed single-B300 fast-start Job admission subject",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_digest", "status", "approved_at", "model_id", "model_digest", "job_kind", "runtime_tuple_digest", "artifact_manifest_digest", "placement_receipt_digest", "prerequisite_receipt_digest", "content_uri", "job", "review_scope"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/faststart-job-admission/v2"},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "approved"},
    "approved_at": {"type": "string", "format": "date-time"},
    "model_id": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"},
    "model_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "job_kind": {"enum": ["donor", "snapshot"]},
    "runtime_tuple_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "placement_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prerequisite_receipt_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "content_uri": {"type": "string", "minLength": 1},
    "review_scope": {"const": "reviewed-single-b300-faststart/v1"},
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "command", "command_sha256"],
      "properties": {
        "image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
