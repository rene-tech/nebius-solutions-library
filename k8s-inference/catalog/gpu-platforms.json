      "url": "https://docs.nebius.com/compute/virtual-machines/types",
      "retrieved_at": "2026-08-31",
      "description": "Published GPU families, platform IDs, regions, presets, CPU hosts, and GPU-cluster eligibility."
    },
    "nebius-live-platform-api": {
      "kind": "official-live-api",
      "url": "https://docs.nebius.com/compute/virtual-machines/list-platforms",
      "retrieved_at": "2026-08-31",
      "description": "Project-scoped live source for platform, preset, GPU-cluster, and allowed_for_preemptibles fields; representative authorized projects were queried without retaining project identifiers.",
      "commands": [
        "nebius compute platform list --parent-id <project-id> --all --format json"
      ],
      "cli_version": "0.12.206"
    },
    "nebius-mk8s-gpu": {
      "kind": "official-documentation",
      "url": "https://docs.nebius.com/kubernetes/gpu/set-up",
      "retrieved_at": "2026-08-31",
      "description": "Managed GPU image, driver preset, manual GPU Operator, MIG, Network Operator, and node-replacement guidance."
    },
    "nebius-mk8s-compatibility-api": {
      "kind": "official-live-api",
      "url": "https://docs.nebius.com/cli/reference/mk8s/node-group/get-compatibility-matrix",
      "retrieved_at": "2026-08-31",
      "description": "Live Managed Kubernetes platform, operating-system, and driver-preset compatibility source.",
      "commands": [
        "nebius mk8s node-group get-compatibility-matrix --cluster-kubernetes-version 1.35 --format json"
      ],
      "cli_version": "0.12.206"
    },
    "nebius-capacity-advisor": {
      "kind": "official-documentation",
      "url": "https://docs.nebius.com/compute/virtual-machines/capacity-advisor",
      "retrieved_at": "2026-08-31",
      "description": "Runtime availability source by region, platform, preset, fabric, and regular, preemptible, or reserved capacity type; not supported by the Terraform provider."
    },
    "solutions-library-platforms": {
      "kind": "official-source-code",
      "url": "https://github.com/nebius/nebius-solutions-library/blob/2491f885fa77e7b2a43eb9210a7b32674d38ff44/soperator/modules/available_resources/platform.tf#L1-L61",
      "retrieved_at": "2026-08-31",
      "description": "Pinned Solutions Library platform-to-host-architecture and region mapping, including Grace-based GB300.",
      "repository_revision": "2491f885fa77e7b2a43eb9210a7b32674d38ff44"
    },
    "solutions-library-presets": {
      "kind": "official-source-code",
