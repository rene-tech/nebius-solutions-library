{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["securityCustody", "generation", "subjectSha256", "envelopeJson", "envelopeSha256"],
  "properties": {
    "securityCustody": {"const": "external-platform-security"},
    "generation": {"type": "integer", "minimum": 1},
    "subjectSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "envelopeJson": {"type": "string", "minLength": 2, "maxLength": 786432},
    "envelopeSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
