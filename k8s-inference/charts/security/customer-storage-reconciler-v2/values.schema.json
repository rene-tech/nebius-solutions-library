{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "authority", "contract", "rollout", "predecessor", "custody", "storage", "resources"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]},
        "pullSecrets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "generation", "manifestSha256", "predecessorCompatibilitySha256", "providerIdentitySha256", "securityGroupId", "nodeGroupId", "nodeSelectorKey", "nodeSelectorValue", "taintKey", "taintValue", "taintEffect"],
      "properties": {
        "schema": {"const": "fs2-serve.nebius.ai/customer-storage-provider-egress-handoff/v1"},
        "generation": {"type": "string", "pattern": "^g[0-9]{14}-[a-f0-9]{12}$"},
        "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "predecessorCompatibilitySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "providerIdentitySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "securityGroupId": {"type": "string", "pattern": "^vpcsecuritygroup-[a-z0-9]+$"},
        "nodeGroupId": {"type": "string", "pattern": "^mk8snodegroup-[a-z0-9]+$"},
        "nodeSelectorKey": {"const": "workload.fs2.nebius/customer-storage-egress"},
        "nodeSelectorValue": {"type": "string", "pattern": "^g[0-9]{14}-[a-f0-9]{12}$"},
        "taintKey": {"const": "workload.fs2.nebius/customer-storage-egress"},
        "taintValue": {"type": "string", "pattern": "^g[0-9]{14}-[a-f0-9]{12}$"},
        "taintEffect": {"const": "NoSchedule"}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "sha256", "configMapName", "trustConfigMapName", "networkPolicyName", "kubernetesApiCidrs"],
      "properties": {
        "generation": {"type": "string", "pattern": "^g[0-9]{14}-[a-f0-9]{12}$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "configMapName": {"type": "string", "pattern": "^fs2-customer-storage-egress-contract-g[0-9]{14}-[a-f0-9]{12}$"},
        "trustConfigMapName": {"type": "string", "pattern": "^fs2-customer-storage-egress-trust-g[0-9]{14}-[a-f0-9]{12}$"},
        "networkPolicyName": {"type": "string", "pattern": "^fs2-customer-storage-egress-g[0-9]{14}-[a-f0-9]{12}$"},
        "kubernetesApiCidrs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$|^[0-9A-Fa-f:]+/128$"}}
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation"],
      "properties": {
        "generation": {"type": "string", "pattern": "^r[0-9]{14}-[a-f0-9]{12}$"}
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "receiptSha256", "deploymentUid", "deploymentSpecSha256", "networkPolicyUid", "networkPolicySha256", "contractUid", "contractDataSha256", "policyUid", "policySpecSha256", "bindingUid", "bindingSpecSha256"],
      "properties": {
        "schema": {"const": "fs2-serve.nebius.ai/customer-storage-egress-predecessor/v1"},
        "receiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "deploymentUid": {"type": "string", "minLength": 1},
        "deploymentSpecSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "networkPolicyUid": {"type": "string", "minLength": 1},
        "networkPolicySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "contractUid": {"type": "string", "minLength": 1},
        "contractDataSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policyUid": {"type": "string", "minLength": 1},
        "policySpecSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bindingUid": {"type": "string", "minLength": 1},
        "bindingSpecSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedSai10Commit", "independentReviewReceiptSha256"],
      "properties": {
        "acceptedSai10Commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "independentReviewReceiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "region", "defaultMode", "quotaBytes", "excludedTenants", "resourceCredentialsSecretName", "iamCredentialsSecretName", "databaseSecretName", "cryptoSecretName", "storageGeneration", "keyTtlDays", "rotationWindowDays", "actionTimeoutSeconds"],
      "properties": {
        "projectId": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "defaultMode": {"const": "user"},
        "quotaBytes": {"type": "integer", "minimum": 1},
        "excludedTenants": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "resourceCredentialsSecretName": {"type": "string", "minLength": 1},
        "iamCredentialsSecretName": {"type": "string", "minLength": 1},
        "databaseSecretName": {"type": "string", "minLength": 1},
        "cryptoSecretName": {"type": "string", "pattern": "^fs2-serve-storage-keyring(-v[2-9][0-9]*)?$"},
        "storageGeneration": {"type": "integer", "minimum": 1},
        "keyTtlDays": {"type": "integer", "minimum": 1, "maximum": 365},
        "rotationWindowDays": {"type": "integer", "minimum": 1, "maximum": 364},
        "actionTimeoutSeconds": {"type": "number", "minimum": 1, "maximum": 120}
      }
    },
    "resources": {"type": "object"}
  }
}
