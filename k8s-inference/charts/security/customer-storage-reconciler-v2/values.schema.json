{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "authority", "contract", "rollout", "activation", "predecessor", "custody", "storage", "resources"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]},
        "pullSecrets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "generation", "laneId", "manifestSha256", "priorHeadReceiptSha256", "iamInventoryReceiptSha256", "rbacInventoryReceiptSha256", "predecessorCompatibilitySha256", "boundaryPolicySha256", "workloadPolicySha256", "releaseValuesSha256", "providerIdentitySha256", "securityGroupId", "nodeGroupId", "protectedNodeSchedulingLabelsSha256", "nodeSelectorKey", "nodeSelectorValue", "taintKey", "taintValue", "taintEffect"],
      "properties": {
        "schema": {"const": "fs2-serve.nebius.ai/customer-storage-provider-egress-handoff/v13"},
        "generation": {"type": "string", "pattern": "^g[0-9]{14}-[a-f0-9]{12}$"},
        "laneId": {"type": "string", "pattern": "^l[0-9]{14}-[a-f0-9]{12}$"},
        "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "priorHeadReceiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "iamInventoryReceiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rbacInventoryReceiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "predecessorCompatibilitySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "boundaryPolicySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "workloadPolicySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "releaseValuesSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "providerIdentitySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "securityGroupId": {"type": "string", "pattern": "^vpcsecuritygroup-[a-z0-9]+$"},
        "nodeGroupId": {"type": "string", "pattern": "^mk8snodegroup-[a-z0-9]+$"},
        "protectedNodeSchedulingLabelsSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "nodeSelectorKey": {"type": "string", "pattern": "^workload\\.fs2\\.nebius/customer-storage-egress-[a-f0-9]{12}$"},
        "nodeSelectorValue": {"type": "string", "pattern": "^l[0-9]{14}-[a-f0-9]{12}$"},
        "taintKey": {"type": "string", "pattern": "^workload\\.fs2\\.nebius/customer-storage-egress-[a-f0-9]{12}$"},
        "taintValue": {"type": "string", "pattern": "^l[0-9]{14}-[a-f0-9]{12}$"},
        "taintEffect": {"const": "NoSchedule"}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "sha256", "configMapName", "trustConfigMapName", "networkPolicyName", "kubernetesApiCidrs"],
      "properties": {
        "generation": {"type": "string", "pattern": "^g[0-9]{14}-[a-f0-9]{12}$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "configMapName": {"type": "string", "pattern": "^fs2-storage-v3-contract-g[0-9]{14}-[a-f0-9]{12}$"},
        "trustConfigMapName": {"type": "string", "pattern": "^fs2-storage-v3-trust-g[0-9]{14}-[a-f0-9]{12}$"},
        "networkPolicyName": {"type": "string", "pattern": "^fs2-storage-v3-network-policy-g[0-9]{14}-[a-f0-9]{12}$"},
        "kubernetesApiCidrs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$|^[0-9A-Fa-f:]+/128$"}}
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation"],
      "properties": {
        "generation": {"type": "string", "pattern": "^r[0-9]{14}-[a-f0-9]{12}$"}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "clusterId", "publicKeyConfigMapName", "caConfigMapName", "receiptAuthorityRegistrySha256", "minimumEpoch", "cutoverReceiptSha256"],
      "properties": {
        "endpoint": {"type": "string", "pattern": "^https://[^/]+/v1/storage-reconciler/activation$"},
        "clusterId": {"type": "string", "minLength": 1},
        "publicKeyConfigMapName": {"type": "string", "pattern": "^fs2-storage-activation-trust-r[0-9]{14}-[a-f0-9]{12}$"},
        "caConfigMapName": {"type": "string", "pattern": "^fs2-storage-activation-ca-r[0-9]{14}-[a-f0-9]{12}$"},
        "receiptAuthorityRegistrySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "minimumEpoch": {"type": "integer", "minimum": 1},
        "cutoverReceiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "receiptSha256", "deploymentUid", "deploymentSpecSha256", "networkPolicyUid", "networkPolicySha256", "contractUid", "contractDataSha256", "policyUid", "policySpecSha256", "bindingUid", "bindingSpecSha256"],
      "properties": {
        "schema": {"const": "fs2-serve.nebius.ai/customer-storage-egress-predecessor/v1"},
        "receiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "deploymentUid": {"type": "string", "minLength": 1},
        "deploymentSpecSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "networkPolicyUid": {"type": "string", "minLength": 1},
        "networkPolicySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "contractUid": {"type": "string", "minLength": 1},
        "contractDataSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policyUid": {"type": "string", "minLength": 1},
        "policySpecSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bindingUid": {"type": "string", "minLength": 1},
        "bindingSpecSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedSai10Commit", "acceptedSai10Tree", "independentReviewReceiptSha256"],
      "properties": {
        "acceptedSai10Commit": {"const": "057386a3e0c616d79735adb43a97c19c48046608"},
        "acceptedSai10Tree": {"const": "a244a4264b1ad5ad782848eed04d9986524921b4"},
        "independentReviewReceiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "region", "defaultMode", "quotaBytes", "excludedTenants", "resourceCredentialsSecretName", "iamCredentialsSecretName", "databaseSecretName", "cryptoSecretName", "storageGeneration", "keyTtlDays", "rotationWindowDays", "actionTimeoutSeconds", "drainGraceSeconds"],
      "properties": {
        "projectId": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "defaultMode": {"const": "user"},
        "quotaBytes": {"type": "integer", "minimum": 1},
        "excludedTenants": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "resourceCredentialsSecretName": {"type": "string", "minLength": 1},
        "iamCredentialsSecretName": {"type": "string", "minLength": 1},
        "databaseSecretName": {"type": "string", "minLength": 1},
        "cryptoSecretName": {"type": "string", "pattern": "^fs2-serve-storage-keyring(-v[2-9][0-9]*)?$"},
        "storageGeneration": {"type": "integer", "minimum": 1},
        "keyTtlDays": {"type": "integer", "minimum": 1, "maximum": 365},
        "rotationWindowDays": {"type": "integer", "minimum": 1, "maximum": 364},
        "actionTimeoutSeconds": {"type": "number", "minimum": 1, "maximum": 120},
        "drainGraceSeconds": {"type": "integer", "minimum": 150, "maximum": 600}
      }
    },
    "resources": {"type": "object"}
  }
}
