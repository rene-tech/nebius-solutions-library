{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["securityCustody", "ownership", "image", "admission", "tls", "replicaCount", "service", "resources", "nodeSelector", "tolerations", "affinity", "networkPolicy"],
  "properties": {
    "securityCustody": {"const": "external-platform-security"},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "legacyReleaseName"],
      "properties": {
        "mode": {"const": "preserve-legacy-selector"},
        "legacyReleaseName": {"const": "fs2-serve-control-plane"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[^@\\s]+$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Never"]},
        "pullSecrets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "configMapName", "configSha256", "policySha256", "securityHandoffSha256", "caBundle", "ownerLookupNamespaces"],
      "properties": {
        "namespace": {"const": "fs2-models"},
        "configMapName": {"type": "string", "pattern": "^fs2-nim-admission-[a-f0-9]{16}$"},
        "configSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "securityHandoffSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "caBundle": {"type": "string", "minLength": 1},
        "ownerLookupNamespaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$"}}
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "secretUid", "secretResourceVersion", "secretType", "generationSha256", "certificateSha256", "publicKeySpkiSha256", "caSha256", "serviceDnsName"],
      "properties": {
        "secretName": {"type": "string", "pattern": "^fs2-nim-admission-tls-[a-f0-9]{16}$"},
        "secretUid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "secretResourceVersion": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "secretType": {"const": "kubernetes.io/tls"},
        "generationSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "certificateSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "publicKeySpkiSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "caSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "serviceDnsName": {"const": "fs2-serve-control-plane-nim-admission.fs2-system.svc"}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 2, "maximum": 20},
    "service": {"type": "object", "required": ["port"], "properties": {"port": {"const": 8443}}},
    "resources": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "networkPolicy": {
      "type": "object",
      "required": ["webhookSourceCidrs", "kubernetesApiCidrs", "dns"],
      "properties": {
        "webhookSourceCidrs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "kubernetesApiCidrs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dns": {"type": "object", "required": ["namespaceLabels", "podLabels", "port"], "properties": {"namespaceLabels": {"type": "object"}, "podLabels": {"type": "object"}, "port": {"const": 53}}}
      }
    }
  }
}
