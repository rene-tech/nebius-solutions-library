{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "replicaCount", "modelNamespace", "systemNamespace", "authorityNamespace", "authorizerUsername", "transitionWriterUsername", "maintenanceWriterUsername", "custodianUsername", "recoveryUsername", "auditorUsername", "custodyTrustDomain", "custodianPrincipalId", "recoveryPrincipalId", "certificateWriterUsername", "cainjectorUsername", "custodianGroups", "recoveryGroups", "auditorGroups", "authorizerGroups", "transitionWriterGroups", "maintenanceWriterGroups", "certificateWriterGroups", "cainjectorGroups", "acquisitionServiceAccountName", "scientificWriterServiceAccountName", "directJobWriterUsername", "jobsetWriterUsername", "modelControllerWriterUsername", "transitionHolder", "maintenanceHolder", "impersonationCapableClusterRoles", "impersonationCapableRoles", "kubernetesApiUrl", "kubernetesApiCidrs", "apiTimeoutSeconds", "tokenExpirationSeconds", "service", "certificate", "resources", "nodeSelector", "tolerations", "affinity", "topologySpreadConstraints"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^@\\s]+/network-boundary-authority$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Never"]}
      },
      "additionalProperties": false
    },
    "replicaCount": {"type": "integer", "minimum": 2, "maximum": 20},
    "modelNamespace": {"const": "fs2-models"},
    "systemNamespace": {"const": "fs2-system"},
    "authorityNamespace": {"const": "fs2-network-security"},
    "authorizerUsername": {"const": "fs2-model-network-authorizer"},
    "transitionWriterUsername": {"const": "fs2-model-network-transition"},
    "maintenanceWriterUsername": {"const": "fs2-model-network-maintenance"},
    "custodianUsername": {"const": "fs2-model-network-custodian"},
    "recoveryUsername": {"const": "fs2-model-network-recovery"},
    "auditorUsername": {"const": "fs2-model-network-auditor"},
    "custodyTrustDomain": {"type": "string", "minLength": 1, "maxLength": 253},
    "custodianPrincipalId": {"type": "string", "minLength": 1, "maxLength": 253},
    "recoveryPrincipalId": {"type": "string", "minLength": 1, "maxLength": 253},
    "certificateWriterUsername": {"const": "system:serviceaccount:cert-manager:cert-manager"},
    "cainjectorUsername": {"const": "system:serviceaccount:cert-manager:cert-manager-cainjector"},
    "custodianGroups": {"const": ["fs2:model-network-custodian", "system:authenticated"]},
    "recoveryGroups": {"const": ["fs2:model-network-recovery", "system:authenticated"]},
    "auditorGroups": {"const": ["fs2:model-network-auditor", "system:authenticated"]},
    "authorizerGroups": {"const": ["fs2:model-network-authorizer", "system:authenticated"]},
    "transitionWriterGroups": {"const": ["fs2:model-network-transition", "system:authenticated"]},
    "maintenanceWriterGroups": {"const": ["fs2:model-network-maintenance", "system:authenticated"]},
    "certificateWriterGroups": {"const": ["system:serviceaccounts", "system:serviceaccounts:cert-manager", "system:authenticated"]},
    "cainjectorGroups": {"const": ["system:serviceaccounts", "system:serviceaccounts:cert-manager", "system:authenticated"]},
    "acquisitionServiceAccountName": {"const": "fs2-catalog-acquisition"},
    "scientificWriterServiceAccountName": {"const": "fs2-scientific-job-writer"},
    "directJobWriterUsername": {"const": "system:serviceaccount:fs2-system:fs2-scientific-job-writer"},
    "jobsetWriterUsername": {"type": "string", "minLength": 1, "maxLength": 1024},
    "modelControllerWriterUsername": {"const": "system:serviceaccount:fs2-system:fs2-serve-control-plane-controller"},
    "transitionHolder": {"type": "string", "pattern": "^$|^[a-z][a-z0-9]{5,11}:[1-9][0-9]*:[a-f0-9]{32}$"},
    "maintenanceHolder": {"type": "string", "pattern": "^$|^[a-z][a-z0-9]{5,11}:[1-9][0-9]*:[a-f0-9]{32}$"},
    "impersonationCapableClusterRoles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"}
    },
    "impersonationCapableRoles": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?/[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"}
    },
    "kubernetesApiUrl": {"const": "https://kubernetes.default.svc"},
    "kubernetesApiCidrs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32$|^[0-9a-fA-F:]+/128$"}
    },
    "apiTimeoutSeconds": {"type": "string", "pattern": "^(?:0\\.[1-9][0-9]*|[1-9](?:\\.[0-9]+)?|10(?:\\.0+)?)$"},
    "tokenExpirationSeconds": {"type": "integer", "minimum": 600, "maximum": 3600},
    "service": {
      "type": "object",
      "required": ["port", "targetPort"],
      "properties": {
        "port": {"const": 443},
        "targetPort": {"type": "integer", "minimum": 1024, "maximum": 65535}
      },
      "additionalProperties": false
    },
    "certificate": {
      "type": "object",
      "required": ["secretName", "caSecretName", "bootstrapIssuerName", "caCertificateName", "servingIssuerName"],
      "properties": {
        "secretName": {"const": "fs2-model-network-boundary-tls"},
        "caSecretName": {"const": "fs2-model-network-boundary-ca"},
        "bootstrapIssuerName": {"const": "fs2-model-network-boundary-selfsigned"},
        "caCertificateName": {"const": "fs2-model-network-boundary-ca"},
        "servingIssuerName": {"const": "fs2-model-network-boundary-ca"}
      },
      "additionalProperties": false
    },
    "resources": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array", "minItems": 2}
  },
  "additionalProperties": false
}
