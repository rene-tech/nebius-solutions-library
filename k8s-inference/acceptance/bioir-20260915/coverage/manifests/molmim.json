{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "fs2-bioir-coverage-molmim",
    "namespace": "fs2-bioir-coverage",
    "labels": {
      "evaluation": "fs2-bioir-20260915",
      "lane": "coverage",
      "benchmark-model": "molmim"
    }
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "image": "cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/fs2-models/h100-fleet/molmim@sha256:fd59b1b45206fe5067033dd7385469ea54e6b670bdd530276e75857f9b459958",
        "imagePullPolicy": "IfNotPresent",
        "livenessProbe": {
          "failureThreshold": 6,
          "httpGet": {
            "path": "/v1/health/ready",
            "port": "http",
            "scheme": "HTTP"
          },
          "initialDelaySeconds": 300,
          "periodSeconds": 30,
          "successThreshold": 1,
          "timeoutSeconds": 5
        },
        "name": "molmim",
        "ports": [
          {
            "containerPort": 8000,
            "name": "http",
            "protocol": "TCP"
          }
        ],
        "readinessProbe": {
          "failureThreshold": 180,
          "httpGet": {
            "path": "/v1/health/ready",
            "port": "http",
            "scheme": "HTTP"
          },
          "periodSeconds": 5,
          "successThreshold": 1,
          "timeoutSeconds": 3
        },
        "resources": {
          "limits": {
            "cpu": "16",
            "memory": "64Gi",
            "nvidia.com/gpu": "1"
          },
          "requests": {
            "cpu": "8",
            "memory": "24Gi",
            "nvidia.com/gpu": "1"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "mountPath": "/dev/shm",
            "name": "dshm"
          },
          {
            "name": "evaluation-client",
            "mountPath": "/eval",
            "readOnly": true
          }
        ]
      }
    ],
    "dnsPolicy": "ClusterFirst",
    "nodeSelector": {
      "kubernetes.io/hostname": "computeinstance-e00r9tdjfszjs3angk"
    },
    "restartPolicy": "Never",
    "schedulerName": "default-scheduler",
    "securityContext": {
      "runAsGroup": 1000,
      "runAsNonRoot": true,
      "runAsUser": 1000,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "terminationGracePeriodSeconds": 60,
    "tolerations": [
      {
        "effect": "NoSchedule",
        "key": "dedicated",
        "operator": "Equal",
        "value": "fs2-inference"
      }
    ],
    "volumes": [
      {
        "emptyDir": {
          "medium": "Memory",
          "sizeLimit": "8Gi"
        },
        "name": "dshm"
      },
      {
        "name": "evaluation-client",
        "configMap": {
          "name": "fs2-bioir-coverage-client"
        }
      }
    ],
    "activeDeadlineSeconds": 14400,
    "initContainers": []
  }
}
