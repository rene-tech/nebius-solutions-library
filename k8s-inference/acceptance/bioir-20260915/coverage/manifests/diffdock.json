{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "fs2-bioir-coverage-diffdock",
    "namespace": "fs2-bioir-coverage",
    "labels": {
      "evaluation": "fs2-bioir-20260915",
      "lane": "coverage",
      "benchmark-model": "diffdock"
    }
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "env": [
          {
            "name": "FS2_PORT",
            "value": "8000"
          }
        ],
        "image": "cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/fs2-models/h100-fleet/diffdock@sha256:471db264f4c544e1798c090f13b6cf94b3fbd304fb2c91e9f63a3dd33c9d81d7",
        "imagePullPolicy": "IfNotPresent",
        "livenessProbe": {
          "failureThreshold": 4,
          "httpGet": {
            "path": "/healthz",
            "port": "http",
            "scheme": "HTTP"
          },
          "periodSeconds": 15,
          "successThreshold": 1,
          "timeoutSeconds": 3
        },
        "name": "runtime",
        "ports": [
          {
            "containerPort": 8000,
            "name": "http",
            "protocol": "TCP"
          }
        ],
        "readinessProbe": {
          "failureThreshold": 6,
          "httpGet": {
            "path": "/readyz",
            "port": "http",
            "scheme": "HTTP"
          },
          "periodSeconds": 5,
          "successThreshold": 1,
          "timeoutSeconds": 3
        },
        "resources": {
          "limits": {
            "cpu": "24",
            "memory": "200Gi",
            "nvidia.com/gpu": "1"
          },
          "requests": {
            "cpu": "8",
            "memory": "64Gi",
            "nvidia.com/gpu": "1"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "readOnlyRootFilesystem": true
        },
        "startupProbe": {
          "failureThreshold": 360,
          "httpGet": {
            "path": "/readyz",
            "port": "http",
            "scheme": "HTTP"
          },
          "periodSeconds": 5,
          "successThreshold": 1,
          "timeoutSeconds": 3
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "mountPath": "/tmp",
            "name": "tmp"
          },
          {
            "name": "evaluation-client",
            "mountPath": "/eval",
            "readOnly": true
          }
        ]
      }
    ],
    "dnsPolicy": "ClusterFirst",
    "enableServiceLinks": false,
    "nodeSelector": {
      "kubernetes.io/hostname": "computeinstance-e00r9tdjfszjs3angk"
    },
    "restartPolicy": "Never",
    "schedulerName": "default-scheduler",
    "securityContext": {
      "fsGroup": 10001,
      "runAsGroup": 10001,
      "runAsNonRoot": true,
      "runAsUser": 10001,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "terminationGracePeriodSeconds": 30,
    "tolerations": [
      {
        "effect": "NoSchedule",
        "key": "dedicated",
        "operator": "Equal",
        "value": "fs2-inference"
      }
    ],
    "volumes": [
      {
        "emptyDir": {
          "sizeLimit": "16Gi"
        },
        "name": "tmp"
      },
      {
        "name": "evaluation-client",
        "configMap": {
          "name": "fs2-bioir-coverage-client"
        }
      }
    ],
    "activeDeadlineSeconds": 14400,
    "initContainers": []
  }
}
