{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "fs2-bioir-coverage-msa-cold-search",
    "namespace": "fs2-bioir-coverage",
    "labels": {
      "evaluation": "fs2-bioir-20260915",
      "lane": "coverage",
      "benchmark-model": "msa-search-pdb70"
    }
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "command": [
          "python",
          "-m",
          "uvicorn",
          "local_server:app",
          "--host",
          "0.0.0.0",
          "--port",
          "8000"
        ],
        "image": "cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/fs2-models/h100-fleet/msa-search-pdb70@sha256:8049b921688cd65c1c87cfbae38d3ec02db472e419ba762a6320766529a7663d",
        "imagePullPolicy": "IfNotPresent",
        "livenessProbe": {
          "failureThreshold": 6,
          "httpGet": {
            "path": "/v1/health/live",
            "port": "http",
            "scheme": "HTTP"
          },
          "initialDelaySeconds": 20,
          "periodSeconds": 30,
          "successThreshold": 1,
          "timeoutSeconds": 3
        },
        "name": "msa-search-pdb70",
        "ports": [
          {
            "containerPort": 8000,
            "name": "http",
            "protocol": "TCP"
          }
        ],
        "readinessProbe": {
          "failureThreshold": 20,
          "httpGet": {
            "path": "/v1/health/ready",
            "port": "http",
            "scheme": "HTTP"
          },
          "periodSeconds": 3,
          "successThreshold": 1,
          "timeoutSeconds": 2
        },
        "resources": {
          "limits": {
            "cpu": "8",
            "memory": "8Gi"
          },
          "requests": {
            "cpu": "2",
            "memory": "2Gi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "mountPath": "/cache",
            "name": "cache"
          },
          {
            "name": "evaluation-client",
            "mountPath": "/eval",
            "readOnly": true
          }
        ]
      }
    ],
    "dnsPolicy": "ClusterFirst",
    "nodeSelector": {
      "kubernetes.io/hostname": "computeinstance-e00krzha55t0sg3t56"
    },
    "restartPolicy": "Never",
    "schedulerName": "default-scheduler",
    "securityContext": {
      "fsGroup": 65532,
      "runAsGroup": 65532,
      "runAsNonRoot": true,
      "runAsUser": 65532,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "terminationGracePeriodSeconds": 30,
    "tolerations": [
      {
        "key": "dedicated",
        "operator": "Equal",
        "value": "fs2-inference",
        "effect": "NoSchedule"
      }
    ],
    "volumes": [
      {
        "emptyDir": {
          "sizeLimit": "4Gi"
        },
        "name": "cache"
      },
      {
        "name": "evaluation-client",
        "configMap": {
          "name": "fs2-bioir-coverage-client"
        }
      }
    ],
    "activeDeadlineSeconds": 14400,
    "initContainers": []
  }
}
