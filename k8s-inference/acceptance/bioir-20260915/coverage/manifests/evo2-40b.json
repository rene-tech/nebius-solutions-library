{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "fs2-bioir-coverage-evo2-40b",
    "namespace": "fs2-models",
    "labels": {
      "evaluation": "fs2-bioir-20260915",
      "lane": "coverage",
      "benchmark-model": "evo2-40b"
    }
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "args": [
          "--host",
          "127.0.0.1",
          "--port",
          "8001"
        ],
        "command": [
          "python3",
          "/opt/fs2-evo2/evo2_serve.py"
        ],
        "env": [
          {
            "name": "CUDA_CACHE_PATH",
            "value": "/tmp/fs2-bioir/cuda_cache_path"
          },
          {
            "name": "EVO2_MODEL_PATH",
            "value": "/model-cache/evo2_40b.pt"
          },
          {
            "name": "PYTORCH_CUDA_ALLOC_CONF",
            "value": "expandable_segments:True"
          },
          {
            "name": "TORCH_EXTENSIONS_DIR",
            "value": "/tmp/fs2-bioir/torch_extensions_dir"
          },
          {
            "name": "TORCHINDUCTOR_CACHE_DIR",
            "value": "/tmp/fs2-bioir/torchinductor_cache_dir"
          },
          {
            "name": "TRITON_CACHE_DIR",
            "value": "/tmp/fs2-bioir/triton_cache_dir"
          },
          {
            "name": "TRITON_PTXAS_PATH",
            "value": "/usr/local/cuda/bin/ptxas"
          }
        ],
        "image": "cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/fs2-models/evo2-runtime@sha256:383f9979021bd3fe018c4dbba675610e0a5f7282b2164db1d8386611351de6f5",
        "imagePullPolicy": "IfNotPresent",
        "name": "model",
        "resources": {
          "limits": {
            "cpu": "64",
            "ephemeral-storage": "32Gi",
            "memory": "256Gi",
            "nvidia.com/gpu": "2"
          },
          "requests": {
            "cpu": "16",
            "ephemeral-storage": "8Gi",
            "memory": "128Gi",
            "nvidia.com/gpu": "2"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "mountPath": "/model-cache",
            "name": "model-cache",
            "readOnly": true
          },
          {
            "name": "evaluation-client",
            "mountPath": "/eval",
            "readOnly": true
          }
        ]
      },
      {
        "command": [
          "python3",
          "/opt/fs2-evo2/evo2_proxy.py"
        ],
        "image": "cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/fs2-models/evo2-runtime@sha256:383f9979021bd3fe018c4dbba675610e0a5f7282b2164db1d8386611351de6f5",
        "imagePullPolicy": "IfNotPresent",
        "livenessProbe": {
          "failureThreshold": 4,
          "httpGet": {
            "path": "/v1/runtime",
            "port": "http",
            "scheme": "HTTP"
          },
          "periodSeconds": 30,
          "successThreshold": 1,
          "timeoutSeconds": 3
        },
        "name": "relay",
        "ports": [
          {
            "containerPort": 8000,
            "name": "http",
            "protocol": "TCP"
          }
        ],
        "readinessProbe": {
          "failureThreshold": 3,
          "httpGet": {
            "path": "/v1/health/ready",
            "port": "http",
            "scheme": "HTTP"
          },
          "periodSeconds": 5,
          "successThreshold": 1,
          "timeoutSeconds": 3
        },
        "resources": {
          "limits": {
            "cpu": "2",
            "ephemeral-storage": "2Gi",
            "memory": "1Gi"
          },
          "requests": {
            "cpu": "250m",
            "ephemeral-storage": "256Mi",
            "memory": "256Mi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "startupProbe": {
          "failureThreshold": 240,
          "httpGet": {
            "path": "/v1/health/ready",
            "port": "http",
            "scheme": "HTTP"
          },
          "periodSeconds": 15,
          "successThreshold": 1,
          "timeoutSeconds": 5
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "name": "evaluation-client",
            "mountPath": "/eval",
            "readOnly": true
          }
        ]
      }
    ],
    "dnsPolicy": "ClusterFirst",
    "enableServiceLinks": false,
    "initContainers": [],
    "nodeSelector": {
      "kubernetes.io/hostname": "computeinstance-e00m0hsph76ajt9sdb"
    },
    "restartPolicy": "Never",
    "schedulerName": "default-scheduler",
    "securityContext": {
      "fsGroup": 65532,
      "fsGroupChangePolicy": "OnRootMismatch",
      "runAsGroup": 65532,
      "runAsNonRoot": true,
      "runAsUser": 65532,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "terminationGracePeriodSeconds": 30,
    "tolerations": [
      {
        "effect": "NoSchedule",
        "key": "dedicated",
        "operator": "Equal",
        "value": "fs2-inference"
      }
    ],
    "volumes": [
      {
        "name": "model-cache",
        "persistentVolumeClaim": {
          "claimName": "evo2-40b-cache-rwx-ecc3e914"
        }
      },
      {
        "name": "evaluation-client",
        "configMap": {
          "name": "fs2-bioir-coverage-client"
        }
      }
    ],
    "activeDeadlineSeconds": 14400
  }
}
