items": [{"text": "Womit", "start_seconds": 65.6, "end_seconds": 65.92, "confidence": null}, {"text": "würden", "start_seconds": 65.92, "end_seconds": 66.16, "confidence": null}, {"text": "Sie", "start_seconds": 66.16, "end_seconds": 66.24, "confidence": null}, {"text": "Ihre", "start_seconds": 66.24, "end_seconds": 66.48, "confidence": null}, {"text": "Zeit", "start_seconds": 66.48, "end_seconds": 66.64, "confidence": null}, {"text": "lieber", "start_seconds": 66.64, "end_seconds": 66.96, "confidence": null}, {"text": "verbringen", "start_seconds": 66.96, "end_seconds": 67.2, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 97, "segment_id": 9, "revision": 12, "text": "Also ich verbringe meine Zeit momentan überwiegend mit Arbeiten. Das tue ich auch trotzdem, aber", "granularity": "word", "items": [{"text": "Also", "start_seconds": 68.4, "end_seconds": 68.48, "confidence": null}, {"text": "ich", "start_seconds": 68.96, "end_seconds": 69.04, "confidence": null}, {"text": "verbringe", "start_seconds": 69.52, "end_seconds": 69.76, "confidence": null}, {"text": "meine", "start_seconds": 70.16, "end_seconds": 70.24, "confidence": null}, {"text": "Zeit", "start_seconds": 70.56, "end_seconds": 70.8, "confidence": null}, {"text": "momentan", "start_seconds": 70.8, "end_seconds": 71.28, "confidence": null}, {"text": "überwiegend", "start_seconds": 71.28, "end_seconds": 71.76, "confidence": null}, {"text": "mit", "start_seconds": 71.76, "end_seconds": 71.84, "confidence": null}, {"text": "Arbeiten.", "start_seconds": 71.84, "end_seconds": 72.08, "confidence": null}, {"text": "Das", "start_seconds": 72.8, "end_seconds": 73.04, "confidence": null}, {"text": "tue", "start_seconds": 73.04, "end_seconds": 73.2, "confidence": null}, {"text": "ich", "start_seconds": 73.2, "end_seconds": 73.28, "confidence": null}, {"text": "auch", "start_seconds": 73.28, "end_seconds": 73.52, "confidence": null}, {"text": "trotzdem,", "start_seconds": 73.52, "end_seconds": 73.92, "confidence": null}, {"text": "aber", "start_seconds": 74.48, "end_seconds": 74.56, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 114, "segment_id": 10, "revision": 17, "text": " es bremst mich natürlich so ein bisschen aus. Ich bin nicht so leistungsfähig, ich bin auch nicht so motiviert wie sonst, habe mühemorgens in die Gänge zu kommen", "granularity": "word", "items": [{"text": " es", "start_seconds": 75.84, "end_seconds": 76.16, "confidence": null}, {"text": "bremst", "start_seconds": 76.16, "end_seconds": 76.48, "confidence": null}, {"text": "mich", "start_seconds": 76.48, "end_seconds": 76.64, "confidence": null}, {"text": "natürlich", "start_seconds": 76.64, "end_seconds": 76.88, "confidence": null}, {"text": "so", "start_seconds": 76.88, "end_seconds": 76.96, "confidence": null}, {"text": "ein", "start_seconds": 76.96, "end_seconds": 77.12, "confidence": null}, {"text": "bisschen", "start_seconds": 77.12, "end_seconds": 77.28, "confidence": null}, {"text": "aus.", "start_seconds": 77.28, "end_seconds": 77.6, "confidence": null}, {"text": "Ich", "start_seconds": 77.92, "end_seconds": 78.08, "confidence": null}, {"text": "bin", "start_seconds": 78.08, "end_seconds": 78.24, "confidence": null}, {"text": "nicht", "start_seconds": 78.24, "end_seconds": 78.4, "confidence": null}, {"text": "so", "start_seconds": 78.4, "end_seconds": 78.56, "confidence": null}, {"text": "leistungsfähig,", "start_seconds": 78.56, "end_seconds": 79.12, "confidence": null}, {"text": "ich", "start_seconds": 79.6, "end_seconds": 79.76, "confidence": null}, {"text": "bin", "start_seconds": 79.76, "end_seconds": 79.92, "confidence": null}, {"text": "auch", "start_seconds": 79.92, "end_seconds": 80.08, "confidence": null}, {"text": "nicht", "start_seconds": 80.08, "end_seconds": 80.16, "confidence": null}, {"text": "so", "start_seconds": 81.04, "end_seconds": 81.36, "confidence": null}, {"text": "motiviert", "start_seconds": 81.36, "end_seconds": 81.92, "confidence": null}, {"text": "wie", "start_seconds": 81.92, "end_seconds": 82.16, "confidence": null}, {"text": "sonst,", "start_seconds": 82.16, "end_seconds": 82.32, "confidence": null}, {"text": "habe", "start_seconds": 82.8, "end_seconds": 83.04, "confidence": null}, {"text": "mühemorgens", "start_seconds": 83.04, "end_seconds": 83.68, "confidence": null}, {"text": "in", "start_seconds": 83.68, "end_seconds": 83.84, "confidence": null}, {"text": "die", "start_seconds": 83.84, "end_seconds": 83.92, "confidence": null}, {"text": "Gänge", "start_seconds": 83.92, "end_seconds": 84.32, "confidence": null}, {"text": "zu", "start_seconds": 84.32, "end_seconds": 84.4, "confidence": null}, {"text": "kommen", "start_seconds": 84.4, "end_seconds": 84.48, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 118, "segment_id": 11, "revision": 4, "text": " Ja, ist halt nicht so toll", "granularity": "word", "items": [{"text": " Ja,", "start_seconds": 87.52, "end_seconds": 87.6, "confidence": null}, {"text": "ist", "start_seconds": 88.0, "end_seconds": 88.24, "confidence": null}, {"text": "halt", "start_seconds": 88.24, "end_seconds": 88.32, "confidence": null}, {"text": "nicht", "start_seconds": 88.32, "end_seconds": 88.48, "confidence": null}, {"text": "so", "start_seconds": 88.48, "end_seconds": 88.64, "confidence": null}, {"text": "toll", "start_seconds": 88.64, "end_seconds": 88.8, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 127, "segment_id": 12, "revision": 9, "text": " richtig ausgebremst. Ja, was heißt ausgebremst? Ich funktioniere schon, aber", "granularity": "word", "items": [{"text": " richtig", "start_seconds": 92.56, "end_seconds": 92.88, "confidence": null}, {"text": "ausgebremst.", "start_seconds": 92.88, "end_seconds": 93.36, "confidence": null}, {"text": "Ja,", "start_seconds": 94.08, "end_seconds": 94.24, "confidence": null}, {"text": "was", "start_seconds": 94.24, "end_seconds": 94.4, "confidence": null}, {"text": "heißt", "start_seconds": 94.4, "end_seconds": 94.64, "confidence": null}, {"text": "ausgebremst?", "start_seconds": 94.64, "end_seconds": 95.2, "confidence": null}, {"text": "Ich", "start_seconds": 95.36, "end_seconds": 95.44, "confidence": null}, {"text": "funktioniere", "start_seconds": 95.44, "end_seconds": 96.0, "confidence": null}, {"text": "schon,", "start_seconds": 96.0, "end_seconds": 96.32, "confidence": null}, {"text": "aber", "start_seconds": 96.32, "end_seconds": 96.4, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 145, "segment_id": 13, "revision": 18, "text": " unter Schmerzen sozusagen, also ich nehme ab und zu ein bisschen Iboprofen um das zu lindern, aber ich versuche halt nicht zu übertreiben, weil ich weiß, dass ja auch belastet den Körper.", "granularity": "word", "items": [{"text": " unter", "start_seconds": 97.44, "end_seconds": 97.76, "confidence": null}, {"text": "Schmerzen", "start_seconds": 97.76, "end_seconds": 98.24, "confidence": null}, {"text": "sozusagen,", "start_seconds": 98.24, "end_seconds": 98.48, "confidence": null}, {"text": "also", "start_seconds": 99.12, "end_seconds": 99.2, "confidence": null}, {"text": "ich", "start_seconds": 99.76, "end_seconds": 99.92, "confidence": null}, {"text": "nehme", "start_seconds": 99.92, "end_seconds": 100.4, "confidence": null}, {"text": "ab", "start_seconds": 100.4, "end_seconds": 100.56, "confidence": null}, {"text": "und", "start_seconds": 100.56, "end_seconds": 100.64, "confidence": null}, {"text": "zu", "start_seconds": 100.64, "end_seconds": 100.88, "confidence": null}, {"text": "ein", "start_seconds": 100.88, "end_seconds": 100.96, "confidence": null}, {"text": "bisschen", "start_seconds": 100.96, "end_seconds": 101.04, "confidence": nul