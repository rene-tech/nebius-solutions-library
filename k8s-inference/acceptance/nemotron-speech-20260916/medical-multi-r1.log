 "confidence": null}, {"text": "der", "start_seconds": 381.36, "end_seconds": 381.44, "confidence": null}, {"text": "darf", "start_seconds": 381.44, "end_seconds": 381.6, "confidence": null}, {"text": "natürlich", "start_seconds": 381.6, "end_seconds": 381.76, "confidence": null}, {"text": "gerne", "start_seconds": 381.76, "end_seconds": 382.08, "confidence": null}, {"text": "mitkommen", "start_seconds": 382.08, "end_seconds": 382.24, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 485, "segment_id": 54, "revision": 9, "text": " und dass wir dann so ein bisschen in die konkreten Planungen reingehen. Ich möchte das heute nicht überfrachten.", "granularity": "word", "items": [{"text": " und", "start_seconds": 383.6, "end_seconds": 383.68, "confidence": null}, {"text": "dass", "start_seconds": 383.68, "end_seconds": 383.84, "confidence": null}, {"text": "wir", "start_seconds": 383.84, "end_seconds": 383.92, "confidence": null}, {"text": "dann", "start_seconds": 383.92, "end_seconds": 384.16, "confidence": null}, {"text": "so", "start_seconds": 384.16, "end_seconds": 384.24, "confidence": null}, {"text": "ein", "start_seconds": 384.24, "end_seconds": 384.32, "confidence": null}, {"text": "bisschen", "start_seconds": 384.32, "end_seconds": 384.48, "confidence": null}, {"text": "in", "start_seconds": 384.48, "end_seconds": 384.72, "confidence": null}, {"text": "die", "start_seconds": 384.72, "end_seconds": 384.88, "confidence": null}, {"text": "konkreten", "start_seconds": 384.88, "end_seconds": 385.28, "confidence": null}, {"text": "Planungen", "start_seconds": 385.28, "end_seconds": 385.84, "confidence": null}, {"text": "reingehen.", "start_seconds": 385.84, "end_seconds": 386.16, "confidence": null}, {"text": "Ich", "start_seconds": 386.24, "end_seconds": 386.4, "confidence": null}, {"text": "möchte", "start_seconds": 386.4, "end_seconds": 386.64, "confidence": null}, {"text": "das", "start_seconds": 386.64, "end_seconds": 386.8, "confidence": null}, {"text": "heute", "start_seconds": 386.8, "end_seconds": 387.04, "confidence": null}, {"text": "nicht", "start_seconds": 387.04, "end_seconds": 387.2, "confidence": null}, {"text": "überfrachten.", "start_seconds": 387.2, "end_seconds": 387.6, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 487, "segment_id": 55, "revision": 2, "text": " Das gut", "granularity": "word", "items": [{"text": " Das", "start_seconds": 390.48, "end_seconds": 390.64, "confidence": null}, {"text": "gut", "start_seconds": 390.64, "end_seconds": 390.72, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 511, "segment_id": 56, "revision": 24, "text": " kommen auch bestimmt wieder neue Fragen. Genau. Ja, dann gucken Sie einfach in der Woche einfach nächste Woche, wie Sie möchten, sehe zu, dass sie schnell einen Termin am Rhematologen kriegen, aber ich würde es heute erstmal gerne dabei belasten. Alles gut", "granularity": "word", "items": [{"text": " kommen", "start_seconds": 392.96, "end_seconds": 393.2, "confidence": null}, {"text": "auch", "start_seconds": 393.2, "end_seconds": 393.36, "confidence": null}, {"text": "bestimmt", "start_seconds": 393.36, "end_seconds": 393.6, "confidence": null}, {"text": "wieder", "start_seconds": 393.6, "end_seconds": 393.84, "confidence": null}, {"text": "neue", "start_seconds": 393.84, "end_seconds": 394.08, "confidence": null}, {"text": "Fragen.", "start_seconds": 394.08, "end_seconds": 394.64, "confidence": null}, {"text": "Genau.", "start_seconds": 394.88, "end_seconds": 394.96, "confidence": null}, {"text": "Ja,", "start_seconds": 395.68, "end_seconds": 396.0, "confidence": null}, {"text": "dann", "start_seconds": 396.0, "end_seconds": 396.16, "confidence": null}, {"text": "gucken", "start_seconds": 396.16, "end_seconds": 396.4, "confidence": null}, {"text": "Sie", "s