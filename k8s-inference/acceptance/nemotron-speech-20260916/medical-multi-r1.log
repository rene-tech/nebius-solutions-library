": 680, "segment_id": 84, "revision": 7, "text": "Und Sie wünschen sich eine Lösung und ich schlage Ihnen vor", "granularity": "word", "items": [{"text": "Und", "start_seconds": 512.48, "end_seconds": 512.72, "confidence": null}, {"text": "Sie", "start_seconds": 512.72, "end_seconds": 512.96, "confidence": null}, {"text": "wünschen", "start_seconds": 512.96, "end_seconds": 513.28, "confidence": null}, {"text": "sich", "start_seconds": 513.28, "end_seconds": 513.52, "confidence": null}, {"text": "eine", "start_seconds": 513.52, "end_seconds": 513.68, "confidence": null}, {"text": "Lösung", "start_seconds": 513.68, "end_seconds": 513.76, "confidence": null}, {"text": "und", "start_seconds": 514.4, "end_seconds": 514.56, "confidence": null}, {"text": "ich", "start_seconds": 514.56, "end_seconds": 514.72, "confidence": null}, {"text": "schlage", "start_seconds": 514.72, "end_seconds": 515.2, "confidence": null}, {"text": "Ihnen", "start_seconds": 515.2, "end_seconds": 515.44, "confidence": null}, {"text": "vor", "start_seconds": 515.44, "end_seconds": 515.52, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 689, "segment_id": 85, "revision": 9, "text": "sich mal ein bisschen rauszunehmen, weil ich den Eindruck habe, dass es vor allen Dingen", "granularity": "word", "items": [{"text": "sich", "start_seconds": 518.24, "end_seconds": 518.32, "confidence": null}, {"text": "mal", "start_seconds": 518.64, "end_seconds": 518.72, "confidence": null}, {"text": "ein", "start_seconds": 518.72, "end_seconds": 518.8, "confidence": null}, {"text": "bisschen", "start_seconds": 518.8, "end_seconds": 519.12, "confidence": null}, {"text": "rauszunehmen,", "start_seconds": 519.12, "end_seconds": 519.44, "confidence": null}, {"text": "weil", "start_seconds": 519.92, "end_seconds": 520.08, "confidence": null}, {"text": "ich", "start_seconds": 520.08, "end_seconds": 520.4, "confidence": null}, {"text": "den", "start_seconds