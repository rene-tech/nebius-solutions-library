on": 9, "text": " und möglichst eine Erklärung finden, wie es mit Ihrem Schlaf", "granularity": "word", "items": [{"text": " und", "start_seconds": 196.0, "end_seconds": 196.08, "confidence": null}, {"text": "möglichst", "start_seconds": 196.64, "end_seconds": 197.12, "confidence": null}, {"text": "eine", "start_seconds": 197.12, "end_seconds": 197.2, "confidence": null}, {"text": "Erklärung", "start_seconds": 197.2, "end_seconds": 197.68, "confidence": null}, {"text": "finden,", "start_seconds": 197.68, "end_seconds": 197.76, "confidence": null}, {"text": "wie", "start_seconds": 198.4, "end_seconds": 198.72, "confidence": null}, {"text": "es", "start_seconds": 198.72, "end_seconds": 199.04, "confidence": null}, {"text": "mit", "start_seconds": 199.04, "end_seconds": 199.12, "confidence": null}, {"text": "Ihrem", "start_seconds": 200.08, "end_seconds": 200.48, "confidence": null}, {"text": "Schlaf", "start_seconds": 200.48, "end_seconds": 200.56, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 266, "segment_id": 35, "revision": 2, "text": " schlecht", "granularity": "word", "items": [{"text": " schlecht", "start_seconds": 202.8, "end_seconds": 202.96, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 273, "segment_id": 36, "revision": 7, "text": "Ich weiß nicht, wann ich es letzte Mal mehr als fünf Stunden ein Stück geschlafen habe", "granularity": "word", "items": [{"text": "Ich", "start_seconds": 205.12, "end_seconds": 205.28, "confidence": null}, {"text": "weiß", "start_seconds": 205.28, "end_seconds": 205.6, "confidence": null}, {"text": "nicht,", "start_seconds": 205.6, "end_seconds": 205.84, "confidence": null}, {"text": "wann", "start_seconds": 205.84, "end_seconds": 206.08, "confidence": null}, {"text": "ich", "start_seconds": 206.08, "end_seconds": 206.16, "confidence": null}, {"text": "es", "start_seconds": 206.16, "end_