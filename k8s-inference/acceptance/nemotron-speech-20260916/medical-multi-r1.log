l}, {"text": "vertragen", "start_seconds": 313.2, "end_seconds": 313.68, "confidence": null}, {"text": "und", "start_seconds": 313.68, "end_seconds": 313.76, "confidence": null}, {"text": "wo", "start_seconds": 313.76, "end_seconds": 313.92, "confidence": null}, {"text": "es", "start_seconds": 313.92, "end_seconds": 314.08, "confidence": null}, {"text": "nicht", "start_seconds": 314.08, "end_seconds": 314.24, "confidence": null}, {"text": "so", "start_seconds": 314.24, "end_seconds": 314.4, "confidence": null}, {"text": "gelenkt", "start_seconds": 314.4, "end_seconds": 314.72, "confidence": null}, {"text": "zerstörungen", "start_seconds": 314.72, "end_seconds": 315.28, "confidence": null}, {"text": "kommt", "start_seconds": 315.28, "end_seconds": 315.36, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 404, "segment_id": 43, "revision": 4, "text": "Ich kann mir das nur nicht versprechen.", "granularity": "word", "items": [{"text": "Ich", "start_seconds": 316.48, "end_seconds": 316.64, "confidence": null}, {"text": "kann", "start_seconds": 316.64, "end_seconds": 316.96, "confidence": null}, {"text": "mir", "start_seconds": 316.96, "end_seconds": 317.04, "confidence": null}, {"text": "das", "start_seconds": 317.04, "end_seconds": 317.2, "confidence": null}, {"text": "nur", "start_seconds": 317.2, "end_seconds": 317.28, "confidence": null}, {"text": "nicht", "start_seconds": 317.28, "end_seconds": 317.52, "confidence": null}, {"text": "versprechen.", "start_seconds": 317.52, "end_seconds": 317.76, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 412, "segment_id": 44, "revision": 8, "text": " Also trotz Medikamente kann es auch anders verlaufen", "granularity": "word", "items": [{"text": " Also", "start_seconds": 319.28, "end_seconds": 319.52, "confidence": null}, {"text": "trotz", "start_seconds": 319.52, "end_seconds": 319.92, "con