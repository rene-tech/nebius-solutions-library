t": "so", "start_seconds": 336.24, "end_seconds": 336.4, "confidence": null}, {"text": "alles", "start_seconds": 336.4, "end_seconds": 336.48, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 427, "segment_id": 47, "revision": 7, "text": " glaube so mein Gefühl für dieses Gespräch wäre, dass war, dass man bei dieser", "granularity": "word", "items": [{"text": " glaube", "start_seconds": 337.68, "end_seconds": 337.92, "confidence": null}, {"text": "so", "start_seconds": 337.92, "end_seconds": 338.08, "confidence": null}, {"text": "mein", "start_seconds": 338.08, "end_seconds": 338.32, "confidence": null}, {"text": "Gefühl", "start_seconds": 338.32, "end_seconds": 338.56, "confidence": null}, {"text": "für", "start_seconds": 338.56, "end_seconds": 338.8, "confidence": null}, {"text": "dieses", "start_seconds": 338.8, "end_seconds": 338.96, "confidence": null}, {"text": "Gespräch", "start_seconds": 338.96, "end_seconds": 339.36, "confidence": null}, {"text": "wäre,", "start_seconds": 339.36, "end_seconds": 339.68, "confidence": null}, {"text": "dass", "start_seconds": 339.68, "end_seconds": 339.84, "confidence": null}, {"text": "war,", "start_seconds": 339.84, "end_seconds": 339.92, "confidence": null}, {"text": "dass", "start_seconds": 340.56, "end_seconds": 340.72, "confidence": null}, {"text": "man", "start_seconds": 340.72, "end_seconds": 340.88, "confidence": null}, {"text": "bei", "start_seconds": 340.88, "end_seconds": 341.04, "confidence": null}, {"text": "dieser", "start_seconds": 341.04, "end_seconds": 341.12, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 437, "segment_id": 48, "revision": 10, "text": " Information belassen und ich mit Ihnen überlegen würde, zu welchem Rheumatologen Sie gerne gehen möchten", "granularity": "word", "items": [{"text": " Information", "start_seconds": 342.24, "end_seconds": 342.4, "confidence": null}, {"text": "belassen", "start_seconds": 342.8, "end_seconds": 343.12, "confidence": null}, {"text": "und", "start_seconds": 343.84, "end_seconds": 343.92, "confidence": null}, {"text": "ich", "start_seconds": 344.4, "end_seconds": 344.56, "confidence": null}, {"text": "mit", "start_seconds": 344.56, "end_seconds": 344.72, "confidence": null}, {"text": "Ihnen", "start_seconds": 344.72, "end_seconds": 344.96, "confidence": null}, {"text": "überlegen", "start_seconds": 344.96, "end_seconds": 345.28, "confidence": null}, {"text": "würde,", "start_seconds": 345.28, "end_seconds": 345.52, "confidence": null}, {"text": "zu", "start_seconds": 345.52, "end_seconds": 345.6, "confidence": null}, {"text": "welchem", "start_seconds": 345.6, "end_seconds": 345.84, "confidence": null}, {"text": "Rheumatologen", "start_seconds": 345.84, "end_seconds": 346.48, "confidence": null}, {"text": "Sie", "start_seconds": 346.48, "end_seconds": 346.72, "confidence": null}, {"text": "gerne", "start_seconds": 346.72, "end_seconds": 346.96, "confidence": null}, {"text": "gehen", "start_seconds": 346.96, "end_seconds": 347.12, "confidence": null}, {"text": "möchten", "start_seconds": 347.12, "end_seconds": 347.28, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 449, "segment_id": 49, "revision": 12, "text": " und dass wir dann erstmal abwarten, was dir empfiehlt und wir dann sehr gerne auch mit mir nochmal über Nebenwirkungen sprechen können", "granularity": "word", "items": [{"text": " und", "start_seconds": 348.64, "end_seconds": 348.88, "confidence": null}, {"text": "dass", "start_seconds": 348.88, "end_seconds": 348.96, "confidence": null}, {"text": "wir", "start_seconds": 348.96, "end_seconds": 349.12, "confidence": null}, {"text": "dann", "start_seconds": 349.12, "end_seconds": 349.28, "confidence": null}, {"text": "erstmal", "start_seconds": 349.28, "end_seconds": 349.44, "confidence": null}, {"text": "abwarte