onfidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 295, "segment_id": 39, "revision": 2, "text": " und das Gewicht", "granularity": "word", "items": [{"text": " und", "start_seconds": 225.12, "end_seconds": 225.2, "confidence": null}, {"text": "das", "start_seconds": 225.2, "end_seconds": 225.36, "confidence": null}, {"text": "Gewicht", "start_seconds": 225.36, "end_seconds": 225.6, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 302, "segment_id": 40, "revision": 7, "text": "Es sind vier Kilo weg in den letzten sechs Wochen, obwohl sie viel Appetit", "granularity": "word", "items": [{"text": "Es", "start_seconds": 226.96, "end_seconds": 227.12, "confidence": null}, {"text": "sind", "start_seconds": 227.12, "end_seconds": 227.36, "confidence": null}, {"text": "vier", "start_seconds": 227.36, "end_seconds": 227.52, "confidence": null}, {"text": "Kilo", "start_seconds": 227.52, "end_seconds": 227.84, "confidence": null}, {"text": "weg", "start_seconds": 227.84, "end_seconds": 228.24, "confidence": null}, {"text": "in", "start_seconds": 228.24, "end_seconds": 228.32, "confidence": null}, {"text": "den", "start_seconds": 228.32, "end_seconds": 228.4, "confidence": null}, {"text": "letzten", "start_seconds": 228.4, "end_seconds": 228.64, "confidence": null}, {"text": "sechs", "start_seconds": 228.64, "end_seconds": 228.88, "confidence": null}, {"text": "Wochen,", "start_seconds": 228.88, "end_seconds": 228.96, "confidence": null}, {"text": "obwohl", "start_seconds": 229.76, "end_seconds": 230.08, "confidence": null}, {"text": "sie", "start_seconds": 230.08, "end_seconds": 230.24, "confidence": null}, {"text": "viel", "start_seconds": 230.24, "end_seconds": 230.48, "confidence": null}, {"text": "Appetit", "start_seconds": 230.48, "end_seconds": 230.64, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 307, "segment_id": 41, "revision": 5, "text": " und vier Kilo sind für mich eine ganze Menge ehrlich gesagt", "granularity": "word", "items": [{"text": " und", "start_seconds": 234.72, "end_seconds": 235.04, "confidence": null}, {"text": "vier", "start_seconds": 235.04, "end_seconds": 235.2, "confidence": null}, {"text": "Kilo", "start_seconds": 235.2, "end_seconds": 235.52, "confidence": null}, {"text": "sind", "start_seconds": 235.52, "end_seconds": 235.68, "confidence": null}, {"text": "für", "start_seconds": 235.68, "end_seconds": 235.76, "confidence": null}, {"text": "mich", "start_seconds": 235.76, "end_seconds": 235.84, "confidence": null}, {"text": "eine", "start_seconds": 235.84, "end_seconds": 236.0, "confidence": null}, {"text": "ganze", "start_seconds": 236.0, "end_seconds": 236.16, "confidence": null}, {"text": "Menge", "start_seconds": 236.16, "end_seconds": 236.4, "confidence": null}, {"text": "ehrlich", "start_seconds": 236.4, "end_seconds": 236.72, "confidence": null}, {"text": "gesagt", "start_seconds": 236.72, "end_seconds": 236.8, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 309, "segment_id": 42, "revision": 2, "text": "Ja", "granularity": "word", "items": [{"text": "Ja", "start_seconds": 238.4, "end_seconds": 238.48, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 318, "segment_id": 43, "revision": 9, "text": " vielleicht erzählen Sie mir noch zwei, drei Dinge aus Ihrem sonstigen Leben, wenn Sie mögen", "granularity": "word", "items": [{"text": " vielleicht", "start_seconds": 240.4, "end_seconds": 240.48, "confidence": null}, {"text": "erzählen", "start_seconds": 240.88, "end_seconds": 241.2, "confidence": null}, {"text": "Sie", "start_seconds": 241.2, "end_seconds": 241.28, "confidence": null}, {"text": "mir", "start_seconds": 241.28, "end_seconds": 241.44, "confidence": null}, {"text": "noch", "start_seconds": 241.44, "end_seconds": 241.52, "confidence": null}, {"text": "zwei,", "start_seconds": 241.52, "end_seconds": 241.76, "confidence": null}, {"text": "drei", "start_seconds": 241.76, "end_seconds": 241.92, "confidence": null}, {"text": "Dinge", "start_seconds": 241.92, "end_seconds": 242.0, "confidence": null}, {"text": "aus", "start_seconds": 242.56, "end_seconds": 242.8, "confidence": null}, {"text": "Ihrem", "start_seconds": 242.8, "end_seconds": 243.12, "confidence": null}, {"text": "sonstigen", "start_seconds": 243.12, "end_seconds": 243.44, "confidence": null}, {"text": "Leben,", "start_seconds": 243.44, "end_seconds": 243.76, "confidence": null}, {"text": "wenn", "start_seconds": 243.76, "end_seconds": 243.92, "confidence": null}, {"text": "Sie", "start_seconds": 243.92, "end_seconds": 244.16, "confidence": null}, {"text": "mögen", "start_seconds": 244.16, "end_seconds": 244.24, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 324, "segment_id": 44, "revision": 6, "text": "Was machen Sie genau beruflich? Ich studiere", "granularity": "word", "items": [{"text": "Was", "start_seconds": 245.92, "end_seconds": 246.16, "confidence": null}, {"text": "machen", "start_seconds": 246.16, "end_seconds": 246.32, "confidence": null}, {"text": "Sie", "start_seconds": 246.32, "end_seconds": 246.48, "confidence": null}, {"text": "genau", "start_seconds": 246.48, "end_seconds": 246.56, "confidence": null}, {"text": "beruflich?", "start_seconds": 246.96, "end_seconds": 247.28, "confidence": null}, {"text": "Ich", "start_seconds": 248.4, "end_seconds": 248.72, "confidence": null}, {"text": "studiere", "start_seconds": 248.72, "end_seconds": 249.04, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 338, "segment_id": 45, "revision": 14, "text": " Maschinenbau, ich habe gerade Prüfungsphase, muss ich ein bisschen mehr machen als sonst, aber es ist nicht hier wirklich dranmatisch", "granularity": "word", "items": [{"text": " Maschinenbau,", "start_seconds": 250.4, "end_seconds": 251.04, "confidence": null}, {"text": "ich", "start_seconds": 251.68, "end_seconds": 251.84, "confidence": null}, {"text": "habe", "start_seconds": 251.84, "end_seconds": 252.16, "confidence": null}, {"text": "gerade", "start_seconds": 252.16, "end_seconds": 252.24, "confidence": null}, {"text": "Prüfungsphase,", "start_seconds": 252.72, "end_seconds": 253.36, "confidence": null}, {"text": "muss", "start_seconds": 254.0, "end_seconds": 254.16, "confidence": null}, {"text": "ich", "start_seconds": 254.16, "end_seconds": 254.4, "confidence": null}, {"text": "ein", "start_seconds": 254.4, "end_seconds": 254.48, "confidence": null}, {"text": "bisschen", "start_seconds": 254.48, "end_seconds": 254.64, "confidence": null}, {"text": "mehr", "start_seconds": 254.64, "end_seconds": 254.88, "confidence": null}, {"text": "machen", "start_seconds": 254.88, "end_seconds": 254.96, "confidence": null}, {"text": "als", "start_seconds": 255.28, "end_seconds": 255.44, "confidence": null}, {"text": "sonst,", "start_seconds": 255.44, "end_seconds": 255.68, "confidence": null}, {"text": "aber", "start_seconds": 255.68, "end_seconds": 255.84, "confidence": null}, {"text": "es", "start_seconds": 255.84, "end_seconds": 255.92, "confidence": null}, {"text": "ist", "start_seconds": 255.92, "end_seconds": 256.08, "confidence": null}, {"text": "nicht", "start_seconds": 256.08, "end_seconds": 256.16, "confidence": null}, {"text": "hier", "start_seconds": 256.56, "end_seconds": 256.64, "confidence": null}, {"text": "wirklich", "start_seconds": 256.64, "end_seconds": 256.8, "confidence": null}, {"text": "dranmatisch", "start_seconds": 256.8, "end_seconds": 257.36, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 345, "segment_id": 46, "revision": 7, "text": " verdiene mir ein bisschen was neben mir dazu, bisschen Au", "granularity": "word", "items": [{"text": " verdiene", "start_seconds": 259.6, "end_seconds": 260.08, "confidence": null}, {"text": "mir", "start_seconds": 260.08, "end_seconds": 260.16, "confidence": null}, {"text": "ein", "start_seconds": 260.16, "end_seconds": 260.32, "confidence": null}, {"text": "bisschen", "start_seconds": 260.32, "end_seconds": 260.56, "confidence": null}, {"text": "was", "start_seconds": 260.56, "end_seconds": 260.64, "confidence": null}, {"text": "neben", "start_seconds": 261.04, "end_seconds": 261.36, "confidence": null}, {"text": "mir", "start_seconds": 261.36, "end_seconds": 261.44, "confidence": null}, {"text": "dazu,", "start_seconds": 261.76, "end_seconds": 261.92, "confidence": null}, {"text": "bisschen", "start_seconds": 262.48, "end_seconds": 262.56, "confidence": null}, {"text": "Au", "start_seconds": 263.68, "end_seconds": 263.76, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 353, "segment_id": 47, "revision": 8, "text": "toschrauben oder Fahrräder oder so, was was mich eher entspannt als", "granularity": "word", "items": [{"text": "toschrauben", "start_seconds": 263.76, "end_seconds": 264.4, "confidence": null}, {"text": "oder", "start_seconds": 264.4, "end_seconds": 264.48, "confidence": null}, {"text": "Fahrräder", "start_seconds": 264.88, "end_seconds": 265.52, "confidence": null}, {"text": "oder", "start_seconds": 265.52, "end_seconds": 265.68, "confidence": null}, {"text": "so,", "start_seconds": 265.68, "end_seconds": 265.76, "confidence": null}, {"text": "was", "start_seconds": 266.08, "end_seconds": 266.32, "confidence": null}, {"text": "was", "start_seconds": 266.32, "end_seconds": 266.56, "confidence": null}, {"text": "mich", "start_seconds": 266.56, "end_seconds": 266.72, "confidence": null}, {"text": "eher", "start_seconds": 266.72, "end_seconds": 267.12, "confidence": null}, {"text": "