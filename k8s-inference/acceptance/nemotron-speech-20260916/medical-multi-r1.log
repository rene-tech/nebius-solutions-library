": "wo", "start_seconds": 253.2, "end_seconds": 253.28, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 364, "segment_id": 32, "revision": 7, "text": " außer Ruhe und Schonung eigentlich kein Kraut gegen Gewachsen ist", "granularity": "word", "items": [{"text": " außer", "start_seconds": 255.36, "end_seconds": 255.68, "confidence": null}, {"text": "Ruhe", "start_seconds": 255.68, "end_seconds": 256.16, "confidence": null}, {"text": "und", "start_seconds": 256.16, "end_seconds": 256.24, "confidence": null}, {"text": "Schonung", "start_seconds": 256.56, "end_seconds": 257.12, "confidence": null}, {"text": "eigentlich", "start_seconds": 257.12, "end_seconds": 257.28, "confidence": null}, {"text": "kein", "start_seconds": 257.28, "end_seconds": 257.6, "confidence": null}, {"text": "Kraut", "start_seconds": 257.6, "end_seconds": 257.84, "confidence": null}, {"text": "gegen", "start_seconds": 257.84, "end_seconds": 258.08, "confidence": null}, {"text": "Gewachsen", "start_seconds": 258.08, "end_seconds": 258.48, "confidence": null}, {"text": "ist", "start_seconds": 258.48, "end_seconds": 258.56, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 374, "segment_id": 33, "revision": 10, "text": "Die Antibiotika schaden mehr als dass sie nützen, weil die natürlich nur gegen bakterielle Infekte helfen", "granularity": "word", "items": [{"text": "Die", "start_seconds": 259.92, "end_seconds": 260.16, "confidence": null}, {"text": "Antibiotika", "start_seconds": 260.16, "end_seconds": 260.88, "confidence": null}, {"text": "schaden", "start_seconds": 261.52, "end_seconds": 261.68, "confidence": null}, {"text": "mehr", "start_seconds": 261.68, "end_seconds": 261.76, "confidence": null}, {"text": "als", "start_seconds": 262.08, "end_seconds": 262.24, "confidence": null}, {"text": "dass", "start_seconds": 262.24, "end_seconds": 262.32, "confidence":