ssion_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 58, "segment_id": 4, "revision": 10, "text": " meine Nasennebenhöhlen sind eigentlich ständig zu ab und zu, denke ich, dass ich Fieber habe", "granularity": "word", "items": [{"text": " meine", "start_seconds": 41.44, "end_seconds": 41.6, "confidence": null}, {"text": "Nasennebenhöhlen", "start_seconds": 41.6, "end_seconds": 42.48, "confidence": null}, {"text": "sind", "start_seconds": 42.48, "end_seconds": 42.64, "confidence": null}, {"text": "eigentlich", "start_seconds": 42.64, "end_seconds": 42.72, "confidence": null}, {"text": "ständig", "start_seconds": 43.12, "end_seconds": 43.28, "confidence": null}, {"text": "zu", "start_seconds": 43.68, "end_seconds": 43.76, "confidence": null}, {"text": "ab", "start_seconds": 44.32, "end_seconds": 44.4, "confidence": null}, {"text": "und", "start_seconds": 44.4, "end_seconds": 44.56, "confidence": null}, {"text": "zu,", "start_seconds": 44.56, "end_seconds": 44.88, "confidence": null}, {"text": "denke", "start_seconds": 44.88, "end_seconds": 45.04, "confidence": null}, {"text": "ich,", "start_seconds": 45.04, "end_seconds": 45.12, "confidence": null}, {"text": "dass", "start_seconds": 45.12, "end_seconds": 45.28, "confidence": null}, {"text": "ich", "start_seconds": 45.28, "end_seconds": 45.44, "confidence": null}, {"text": "Fieber", "start_seconds": 45.44, "end_seconds": 45.92, "confidence": null}, {"text": "habe", "start_seconds": 45.92, "end_seconds": 46.0, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 69, "segment_id": 5, "revision": 11, "text": " und das nervt ohne Ende. Ich habe da auch keine Zeit zu kurz gesagt, das muss aufhören und deswegen bin ich hier", "granularity": "word", "items": [{"text": " und", "start_seconds": 48.16, "end_seconds": 48.48, "confidence": null}, {"text": "das", "start_seconds": 48.48, "end_seconds": 48.72, "confidence": null}, {"text": "nervt", "start_seco