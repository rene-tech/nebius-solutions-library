"da.", "start_seconds": 428.96, "end_seconds": 429.04, "confidence": null}, {"text": "Ja,", "start_seconds": 429.84, "end_seconds": 429.92, "confidence": null}, {"text": "das", "start_seconds": 430.64, "end_seconds": 430.8, "confidence": null}, {"text": "ist", "start_seconds": 430.8, "end_seconds": 430.88, "confidence": null}, {"text": "ein", "start_seconds": 430.88, "end_seconds": 431.12, "confidence": null}, {"text": "Dilemma,", "start_seconds": 431.12, "end_seconds": 431.68, "confidence": null}, {"text": "ne", "start_seconds": 431.68, "end_seconds": 431.76, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 592, "segment_id": 68, "revision": 7, "text": "Also ihn leuchtet aber schon ein, was ich ihnen empfehle", "granularity": "word", "items": [{"text": "Also", "start_seconds": 434.16, "end_seconds": 434.24, "confidence": null}, {"text": "ihn", "start_seconds": 434.56, "end_seconds": 434.64, "confidence": null}, {"text": "leuchtet", "start_seconds": 434.64, "end_seconds": 435.04, "confidence": null}, {"text": "aber", "start_seconds": 435.04, "end_seconds": 435.2, "confidence": null}, {"text": "schon", "start_seconds": 435.2, "end_seconds": 435.28, "confidence": null}, {"text": "ein,", "start_seconds": 435.76, "end_seconds": 435.84, "confidence": null}, {"text": "was", "start_seconds": 436.16, "end_seconds": 436.32, "confidence": null}, {"text": "ich", "start_seconds": 436.32, "end_seconds": 436.56, "confidence": null}, {"text": "ihnen", "start_seconds": 436.56, "end_seconds": 436.8, "confidence": null}, {"text": "empfehle", "start_seconds": 436.8, "end_seconds": 436.96, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 598, "segment_id": 69, "revision": 6, "text": " theoretisch ja, was würden Sie Ihrem besten Freund empfehlen", "granularity": "word", "items": [{"text": " theoretisch", "start_seconds": 438.72, "end_seconds": 439.52, "confidence": null}, {"text": "ja,", "start_seconds": 439.52, "end_seconds": 439.6, "confidence": null}, {"text": "was", "start_seconds": 440.32, "end_seconds": 440.4, "confidence": null}, {"text": "würden", "start_seconds": 440.4, "end_seconds": 440.64, "confidence": null}, {"text": "Sie", "start_seconds": 440.64, "end_seconds": 440.8, "confidence": null}, {"text": "Ihrem", "start_seconds": 440.8, "end_seconds": 440.96, "confidence": null}, {"text": "besten", "start_seconds": 440.96, "end_seconds": 441.28, "confidence": null}, {"text": "Freund", "start_seconds": 441.28, "end_seconds": 441.52, "confidence": null}, {"text": "empfehlen", "start_seconds": 441.52, "end_seconds": 441.76, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 611, "segment_id": 70, "revision": 13, "text": " bei bei anderen Leuten ist es immer anders, ne, ja ich gebe zu, ich würde sagen, dass ich krank schreiben auch mit dem Quatsch, wenn ihre Freundin", "granularity": "word", "items": [{"text": " bei", "start_seconds": 446.88, "end_seconds": 446.96, "confidence": null}, {"text": "bei", "start_seconds": 446.96, "end_seconds": 447.12, "confidence": null}, {"text": "anderen", "start_seconds": 447.12, "end_seconds": 447.44, "confidence": null}, {"text": "Leuten", "start_seconds": 447.44, "end_seconds": 447.84, "confidence": null}, {"text": "ist", "start_seconds": 447.84, "end_seconds": 447.92, "confidence": null}, {"text": "es", "start_seconds": 447.92, "end_seconds": 448.08, "confidence": null}, {"text": "immer", "start_seconds": 448.08, "end_seconds": 448.24, "confidence": null}, {"text": "anders,", "start_seconds": 448.24, "end_seconds": 448.64, "confidence": null}, {"text": "ne,", "start_seconds": 448.64, "end_seconds": 448.96, "confidence": null}, {"text": "ja", "start_seconds": 448.96, "end_seconds": 449.12, "confidence": null}, {"text": "ich", "start_seconds": 449.12, "end_seconds": 449.28, "confidence": null}, {"text": "g