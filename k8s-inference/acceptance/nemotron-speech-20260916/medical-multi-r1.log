l}, {"text": "auch", "start_seconds": 192.24, "end_seconds": 192.32, "confidence": null}, {"text": "ziemlich", "start_seconds": 193.2, "end_seconds": 193.44, "confidence": null}, {"text": "typisch", "start_seconds": 193.44, "end_seconds": 193.76, "confidence": null}, {"text": "begonnen", "start_seconds": 193.76, "end_seconds": 194.16, "confidence": null}, {"text": "haben", "start_seconds": 194.16, "end_seconds": 194.24, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 290, "segment_id": 23, "revision": 15, "text": "was ich jetzt nicht gehört habe, ist, dass Sie zwischendrin mal irgendwie eine Pause gemacht haben. Sie sprechen von Ebo Prophäen und anderen Hilfsmitteln, aber Pause", "granularity": "word", "items": [{"text": "was", "start_seconds": 195.52, "end_seconds": 195.68, "confidence": null}, {"text": "ich", "start_seconds": 195.68, "end_seconds": 195.84, "confidence": null}, {"text": "jetzt", "start_seconds": 195.84, "end_seconds": 195.92, "confidence": null}, {"text": "nicht", "start_seconds": 195.92, "end_seconds": 196.08, "confidence": null}, {"text": "gehört", "start_seconds": 196.08, "end_seconds": 196.4, "confidence": null}, {"text": "habe,", "start_seconds": 196.4, "end_seconds": 196.64, "confidence": null}, {"text": "ist,", "start_seconds": 196.64, "end_seconds": 196.72, "confidence": null}, {"text": "dass", "start_seconds": 196.72, "end_seconds": 196.96, "confidence": null}, {"text": "Sie", "start_seconds": 196.96, "end_seconds": 197.12, "confidence": null}, {"text": "zwischendrin", "start_seconds": 197.12, "end_seconds": 197.6, "confidence": null}, {"text": "mal", "start_seconds": 197.6, "end_seconds": 197.92, "confidence": null}, {"text": "irgendwie", "start_seconds": 197.92, "end_seconds": 198.24, "confidence": null}, {"text": "eine", "start_seconds": 198.24, "end_seconds": 198.4, "confidence": null}, {"text": "Pause", "start_seconds": 198.4, "end_seconds": 198.64, "confidence": nu