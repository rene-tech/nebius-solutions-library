, "revision": 9, "text": " jetzt nicht wenn ich gerannt bin oder so. Ich sitze auf dem Sofa und plötzlich gebe das los, also", "granularity": "word", "items": [{"text": " jetzt", "start_seconds": 48.24, "end_seconds": 48.4, "confidence": null}, {"text": "nicht", "start_seconds": 48.4, "end_seconds": 48.56, "confidence": null}, {"text": "wenn", "start_seconds": 48.56, "end_seconds": 48.72, "confidence": null}, {"text": "ich", "start_seconds": 48.72, "end_seconds": 48.8, "confidence": null}, {"text": "gerannt", "start_seconds": 48.8, "end_seconds": 49.12, "confidence": null}, {"text": "bin", "start_seconds": 49.12, "end_seconds": 49.36, "confidence": null}, {"text": "oder", "start_seconds": 49.36, "end_seconds": 49.52, "confidence": null}, {"text": "so.", "start_seconds": 49.52, "end_seconds": 49.84, "confidence": null}, {"text": "Ich", "start_seconds": 49.92, "end_seconds": 50.0, "confidence": null}, {"text": "sitze", "start_seconds": 50.0, "end_seconds": 50.4, "confidence": null}, {"text": "auf", "start_seconds": 50.4, "end_seconds": 50.48, "confidence": null}, {"text": "dem", "start_seconds": 50.48, "end_seconds": 50.56, "confidence": null}, {"text": "Sofa", "start_seconds": 50.56, "end_seconds": 50.88, "confidence": null}, {"text": "und", "start_seconds": 50.88, "end_seconds": 51.04, "confidence": null}, {"text": "plötzlich", "start_seconds": 51.04, "end_seconds": 51.36, "confidence": null}, {"text": "gebe", "start_seconds": 51.36, "end_seconds": 51.52, "confidence": null}, {"text": "das", "start_seconds": 51.52, "end_seconds": 51.76, "confidence": null}, {"text": "los,", "start_seconds": 51.76, "end_seconds": 51.84, "confidence": null}, {"text": "also", "start_seconds": 52.16, "end_seconds": 52.24, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 67, "segment_id": 10, "revision": 3, "text": " so bisschen", "granularity": "word", "items": [{"text": " so", "start_seconds": 53.92, "end_seconds": 54.0, "confidence": null}, {"text": "bisschen", "start_seconds": 54.4, "end_seconds": 54.48, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 71, "segment_id": 11, "revision": 4, "text": " bringt unangenehm", "granularity": "word", "items": [{"text": " bringt", "start_seconds": 58.64, "end_seconds": 59.04, "confidence": null}, {"text": "unangenehm", "start_seconds": 59.04, "end_seconds": 59.44, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 86, "segment_id": 12, "revision": 15, "text": " in der Tat, also in Ruhe pocht ihr Herz wie gegen einen Widerstand und und heftig sehr sehr schnell. Ja, haben Sie mal gemessen", "granularity": "word", "items": [{"text": " in", "start_seconds": 60.64, "end_seconds": 60.88, "confidence": null}, {"text": "der", "start_seconds": 60.88, "end_seconds": 60.96, "confidence": null}, {"text": "Tat,", "start_seconds": 60.96, "end_seconds": 61.2, "confidence": null}, {"text": "also", "start_seconds": 62.32, "end_seconds": 62.4, "confidence": null}, {"text": "in", "start_seconds": 62.8, "end_seconds": 63.12, "confidence": null}, {"text": "Ruhe", "start_seconds": 63.12, "end_seconds": 63.52, "confidence": null}, {"text": "pocht", "start_seconds": 63.52, "end_seconds": 63.92, "confidence": null}, {"text": "ihr", "start_seconds": 63.92, "end_seconds": 64.16, "confidence": null}, {"text": "Herz", "start_seconds": 64.16, "end_seconds": 64.24, "confidence": null}, {"text": "wie", "start_seconds": 65.04, "end_seconds": 65.28, "confidence": null}, {"text": "gegen", "start_seconds": 65.28, "end_seconds": 65.52, "confidence": null}, {"text": "einen", "start_seconds": 65.52, "end_seconds": 65.68, "confidence": null}, {"text": "Widerstand", "start_seconds": 65.68, "end_seconds": 65.92, "confidence": null}, {"text": "und", "start_seconds": 66.8, "end_seconds": 66.96, "confidence": null}, {"text": "und", "start_seconds": 66.96, "end_seconds": 67.2, "confidence": null}, {"text": "heftig", "start_seconds": 67.2, "end_seconds": 67.52, "confidence": null}, {"text": "sehr", "start_seconds": 67.52, "end_seconds": 67.68, "confidence": null}, {"text": "sehr", "start_seconds": 67.68, "end_seconds": 67.84, "confidence": null}, {"text": "schnell.", "start_seconds": 67.84, "end_seconds": 67.92, "confidence": null}, {"text": "Ja,", "start_seconds": 68.64, "end_seconds": 68.96, "confidence": null}, {"text": "haben", "start_seconds": 68.96, "end_seconds": 69.12, "confidence": null}, {"text": "Sie", "start_seconds": 69.12, "end_seconds": 69.2, "confidence": null}, {"text": "mal", "start_seconds": 69.2, "end_seconds": 69.28, "confidence": null}, {"text": "gemessen", "start_seconds": 69.28, "end_seconds": 69.52, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 92, "segment_id": 13, "revision": 6, "text": "Ja hundertsechzig Schläge pro Minute", "granularity": "word", "items": [{"text": "Ja", "start_seconds": 70.64, "end_seconds": 70.72, "confidence": null}, {"text": "hundertsechzig", "start_seconds": 71.2, "end_seconds": 71.84, "confidence": null}, {"text": "Schläge", "start_seconds": 71.84, "end_seconds": 72.32, "confidence": null}, {"text": "pro", "start_seconds": 72.32, "end_seconds": 72.4, "confidence": null}, {"text": "Minute", "start_seconds": 72.72, "end_seconds": 72.88, "confidence": null}]}, {"type": "transcript.final", "session_id": "39d0d082-7520-4554-ae04-41201290441b", "sequence": 95, "segment_id": 14, "revision": 3, "text": "Seit wann sagen Sie", "granularity": "word", "items": [{"text": "Seit", "start_seconds": 76.88, "end_seconds": 77.2, "confidence": null}, {"text": "wann", "start_seconds": 77.2, "end_seconds": 77.52, "confidence": null}, {"text": "sagen", "start_seconds": 77.52, "end_seconds": 77.76, "confidence": null}, {"text": "Sie", "start_seconds": 77.76, "end_seconds": 77.84, "confidence": null}]}, {"type": "