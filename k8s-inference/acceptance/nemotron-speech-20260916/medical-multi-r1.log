.4, "confidence": null}, {"text": "gut,", "start_seconds": 238.4, "end_seconds": 238.48, "confidence": null}, {"text": "ohne", "start_seconds": 238.8, "end_seconds": 239.04, "confidence": null}, {"text": "dass", "start_seconds": 239.04, "end_seconds": 239.12, "confidence": null}, {"text": "Nebenwirkung", "start_seconds": 239.84, "end_seconds": 240.32, "confidence": null}, {"text": "auftreten.", "start_seconds": 240.32, "end_seconds": 240.64, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 316, "segment_id": 32, "revision": 7, "text": " Mein Beruf in Zukunft, also ich bin Sportlehrerin", "granularity": "word", "items": [{"text": " Mein", "start_seconds": 243.2, "end_seconds": 243.44, "confidence": null}, {"text": "Beruf", "start_seconds": 243.44, "end_seconds": 243.6, "confidence": null}, {"text": "in", "start_seconds": 244.16, "end_seconds": 244.32, "confidence": null}, {"text": "Zukunft,", "start_seconds": 244.32, "end_seconds": 244.4, "confidence": null}, {"text": "also", "start_seconds": 244.88, "end_seconds": 245.04, "confidence": null}, {"text": "ich", "start_seconds": 245.04, "end_seconds": 245.12, "confidence": null}, {"text": "bin", "start_seconds": 245.12, "end_seconds": 245.36, "confidence": null}, {"text": "Sportlehrerin", "start_seconds": 245.36, "end_seconds": 246.0, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 322, "segment_id": 33, "revision": 6, "text": "Das kann ich ja dann irgendwann nicht mehr ausüben oder", "granularity": "word", "items": [{"text": "Das", "start_seconds": 247.6, "end_seconds": 247.76, "confidence": null}, {"text": "kann", "start_seconds": 247.76, "end_seconds": 247.92, "confidence": null}, {"text": "ich", "start_seconds": 247.92, "end_seconds": 248.08, "confidence": null}, {"text": "ja", "start_seconds": 248.08, "end_seconds": 248.24, "confidence": null}, {"text": "dann", "start_seconds": 