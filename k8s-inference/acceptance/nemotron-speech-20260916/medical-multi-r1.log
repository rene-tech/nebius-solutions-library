nds": 76.88, "confidence": null}, {"text": "es", "start_seconds": 77.36, "end_seconds": 77.44, "confidence": null}, {"text": "gedacht,", "start_seconds": 77.44, "end_seconds": 77.84, "confidence": null}, {"text": "es", "start_seconds": 77.84, "end_seconds": 77.92, "confidence": null}, {"text": "geben", "start_seconds": 77.92, "end_seconds": 78.4, "confidence": null}, {"text": "vom", "start_seconds": 78.4, "end_seconds": 78.56, "confidence": null}, {"text": "Volleyball", "start_seconds": 79.28, "end_seconds": 79.84, "confidence": null}, {"text": "oder", "start_seconds": 79.84, "end_seconds": 80.08, "confidence": null}, {"text": "so,", "start_seconds": 80.08, "end_seconds": 80.16, "confidence": null}, {"text": "sondern", "start_seconds": 80.64, "end_seconds": 80.96, "confidence": null}, {"text": "irgendwie", "start_seconds": 80.96, "end_seconds": 81.36, "confidence": null}, {"text": "leichte", "start_seconds": 81.36, "end_seconds": 81.76, "confidence": null}, {"text": "Prellung", "start_seconds": 81.76, "end_seconds": 82.24, "confidence": null}, {"text": "oder", "start_seconds": 82.24, "end_seconds": 82.32, "confidence": null}, {"text": "irgendwie", "start_seconds": 83.2, "end_seconds": 83.52, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 120, "segment_id": 10, "revision": 3, "text": " sonst nix", "granularity": "word", "items": [{"text": " sonst", "start_seconds": 85.76, "end_seconds": 86.24, "confidence": null}, {"text": "nix", "start_seconds": 86.24, "end_seconds": 86.32, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 126, "segment_id": 11, "revision": 6, "text": "Ich habe tatsächlich eine nicht so gute Nachhalt für sie", "granularity": "word", "items": [{"text": "Ich", "start_seconds": 87.6, "end_seconds": 87.76, "confidence": null}, {"text": "habe", "start_seconds": 87.76, "end_seconds": 87.92, "confidence": null}, {"text": "tatsächlich", "start_seconds": 87.92, "end_seconds": 88.08, "confidence": null}, {"text": "eine", "start_seconds": 88.48, "end_seconds": 88.8, "confidence": null}, {"text": "nicht", "start_seconds": 88.8, "end_seconds": 88.88, "confidence": null}, {"text": "so", "start_seconds": 88.88, "end_seconds": 89.04, "confidence": null}, {"text": "gute", "start_seconds": 89.04, "end_seconds": 89.28, "confidence": null}, {"text": "Nachhalt", "start_seconds": 89.28, "end_seconds": 89.76, "confidence": null}, {"text": "für", "start_seconds": 89.76, "end_seconds": 90.0, "confidence": null}, {"text": "sie", "start_seconds": 90.0, "end_seconds": 90.08, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 137, "segment_id": 12, "revision": 11, "text": "Die Laborwerte, die wir abgenommen haben, sprechen dafür, dass bei Ihnen einen Rollenmar vorliegt, ein Gelenkrolmar", "granularity": "word", "items": [{"text": "Die", "start_seconds": 91.36, "end_seconds": 91.68, "confidence": null}, {"text": "Laborwerte,", "start_seconds": 91.68, "end_seconds": 92.32, "confidence": null}, {"text": "die", "start_seconds": 92.32, "end_seconds": 92.4, "confidence": null}, {"text": "wir", "start_seconds": 92.4, "end_seconds": 92.56, "confidence": null}, {"text": "abgenommen", "start_seconds": 92.56, "end_seconds": 92.88, "confidence": null}, {"text": "haben,", "start_seconds": 92.88, "end_seconds": 92.96, "confidence": null}, {"text": "sprechen", "start_seconds": 93.28, "end_seconds": 93.6, "confidence": null}, {"text": "dafür,", "start_seconds": 93.6, "end_seconds": 93.92, "confidence": null}, {"text": "dass", "start_seconds": 93.92, "end_seconds": 94.24, "confidence": null}, {"text": "bei", "start_seconds": 94.24, "end_seconds": 94.32, "confidence": null}, {"text": "Ihnen", "start_seconds": 94.32, "end_seconds": 94.64, "confidence": null}, {"text": "einen", "start_seconds": 94.64, "end_seconds": 94.88, "confidence": null}, {"text": "Rollenmar", "start_seconds": 94.88, "end_seconds": 95.44, "confidence": null}, {"text": "vorliegt,", "start_seconds": 95.44, "end_seconds": 95.84, "confidence": null}, {"text": "ein", "start_seconds": 95.84, "end_seconds": 96.0, "confidence": null}, {"text": "Gelenkrolmar", "start_seconds": 96.0, "end_seconds": 96.72, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 142, "segment_id": 13, "revision": 5, "text": " weiß nicht, ob Sie davon schon mal was gehört haben", "granularity": "word", "items": [{"text": " weiß", "start_seconds": 99.12, "end_seconds": 99.36, "confidence": null}, {"text": "nicht,", "start_seconds": 99.36, "end_seconds": 99.44, "confidence": null}, {"text": "ob", "start_seconds": 99.44, "end_seconds": 99.6, "confidence": null}, {"text": "Sie", "start_seconds": 99.6, "end_seconds": 99.84, "confidence": null}, {"text": "davon", "start_seconds": 99.84, "end_seconds": 100.08, "confidence": null}, {"text": "schon", "start_seconds": 100.08, "end_seconds": 100.24, "confidence": null}, {"text": "mal", "start_seconds": 100.24, "end_seconds": 100.32, "confidence": null}, {"text": "was", "start_seconds": 100.32, "end_seconds": 100.4, "confidence": null}, {"text": "gehört", "start_seconds": 100.4, "end_seconds": 100.8, "confidence": null}, {"text": "haben", "start_seconds": 100.8, "end_seconds": 100.88, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 147, "segment_id": 14, "revision": 5, "text": "Ja doch schon, also", "granularity": "word", "items": [{"text": "Ja", "start_seconds": 103.76, "end_seconds": 103.84, "confidence": null}, {"text": "doch", "start_seconds": 105.12, "end_seconds": 105.28, "confidence": null}, {"text": "schon,", "start_seconds": 105.28, "end_seconds": 105.36, "confidence": null}, {"text": "also", "start_seconds": 105.84, "end_seconds": 105.92, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 152, "segment_id": 15, "revision": 5, "text": " meine Großtante hatte Räume. Genau", "granularity": "word", "items": [{"text": " meine", "start_seconds": 109.36, "end_seconds": 109.44, "confidence": null}, {"text": "Großtante", "start_seconds": 109.76, "end_seconds": 110.24, "confidence": null}, {"text": "hatte", "start_seconds": 110.24, "end_seconds": 110.48, "confidence": null}, {"text": "Räume.", "start_seconds": 110.48, "end_seconds": 110.88, "confidence": null}, {"text": "Genau", "start_seconds": 111.2, "end_seconds": 111.36, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 157, "segment_id": 16, "revision": 5, "text": "aber das ist jetzt sicher, dass", "granularity": "word", "items": [{"text": "aber", "start_seconds": 112.8, "end_seconds": 112.88, "confidence": null}, {"text": "das", "start_seconds": 113.12, "end_seconds": 113.2, "confidence": null}, {"text": "ist", "start_seconds": 113.2, "end_seconds": 113.36, "confidence": null}, {"text": "jetzt", "start_seconds": 113.36, "end_seconds": 113.52, "confidence": null}, {"text": "sicher,", "start_seconds": 113.52, "end_seconds": 113.76, "confidence": null}, {"text": "dass", "start_seconds": 114.24, "end_seconds": 114.32, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 161, "segment_id": 17, "revision": 4, "text": " die Laborwehrte sind eindeutig", "granularity": "word", "items": [{"text": " die", "start_seconds": 116.72, "end_seconds": 116.8, "confidence": null}, {"text": "Laborwehrte", "start_seconds": 117.12, "end_seconds": 117.6, "confidence": null}, {"text": "sind", "start_seconds": 117.6, "end_seconds": 117.76, "confidence": null}, {"text": "eindeutig", "start_seconds": 117.76, "end_seconds": 118.08, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 178, "segment_id": 18, "revision": 17, "text": " dafür, ich denke, dass wenn der weiteren Behandlung nochmal einen Rheumatologen hinzuziehen würden, aber ich gehe jetzt erstmal davon aus, dass das tatsächlich räume ist, was Sie haben", "granularity": "word", "items": [{"text": " dafür,", "start_seconds": 119.28, "end_seconds": 119.44, "confidence": null}, {"text": "ich", "start_seconds": 120.24, "end_seconds": 120.48, "confidence": null}, {"text": "denke,", "start_seconds": 120.48, "end_seconds": 120.64, "confidence": null}, {"text": "dass", "start_seconds": 120.64, "end_seconds": 120.88, "confidence": null}, {"text": "wenn", "start_seconds": 120.88, "end_seconds": 121.12, "confidence": null}, {"text": "der", "start_seconds": 121.12, "end_seconds": 121.2, "confidence": null}, {"text": "weiteren", "start_seconds": 121.2, "end_seconds": 121.52, "confidence": null}, {"text": "Behandlung", "start_seconds": 121.52, "end_seconds": 121.84, "confidence": null}, {"text": "nochmal", "start_seconds": 121.84, "end_seconds": 122.08, "confidence": null}, {"text": "einen", "start_seconds": 122.08, "end_seconds": 122.24, "confidence": null}, {"text": "Rheumatologen", "start_seconds": 122.24, "end_seconds": 122.88, "confidence": null}, {"text": "hinzuziehen", "start_seconds": 122.88, "end_seconds": 123.44, "confidence": null}, {"text": "würden,", "start_seconds": 123.44, "end_seconds": 123.76, "confidence": null}, {"text": "aber", "start_seconds": 123.76, "end_seconds": 123.92, "confidence": null}, {"text": "ich", "start_seconds": 123.92, "end_seconds": 124.16, "confidence": null}, {"text": "gehe", "start_seconds": 124.16, "end_seconds": 124.4, "confidence": null}, {"text": "jetzt", "start_seconds": 124.4, "end_seconds": 124.56, "confidence": null}, {"text": "erstmal", "start_seconds": 124.56, "end_seconds": 124.88, "confidence": null}, {"text": "davon", "start_seconds": 124.88, "end_seconds": 125.12, "confidence": null}, {"text": "aus,", "start_seconds": 125.12, "end_seconds": 125.2, "confidence": null}, {"text": "dass", "start_seconds": 125.92, "end_seconds": 126.16, "confidence": null}, {"text": "das", "start_seconds": 126.16, "end_seconds": 126.4, "confidence": null}, {"text": "tatsächlich", "start_seconds": 126.4, "end_seconds": 126.56, "confidence": null}, {"text": "räume", "start_seconds": 127.12, "end_seconds": 127.52, "confidence": null}, {"text": "ist,", "start_seconds": 127.52, "end_seconds": 127.6, "confidence": null}, {"text": "was", "start_seconds": 128.24, "end_seconds": 128.4, "confidence": null}, {"text": "Sie", "start_seconds": 128.4, "end_seconds": 128.56, "confidence": null}, {"text": "haben", "start_seconds": 128.56, "end_seconds": 128.64, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 183, "segment_id": 19, "revision": 5, "text": " Geht jetzt ein bisschen plötzlich. Das habe ich jetzt gar nicht", "granularity": "word", "items": [{"text": " Geht", "start_seconds": 137.36, "end_seconds": 137.6, "confidence": null}, {"text": "jetzt", "start_seconds": 137.6, "end_seconds": 137.76, "confidence": null}, {"text": "ein", "start_seconds": 137.76, "end_seconds": 137.84, "confidence": null}, {"text": "bisschen", "start_seconds": 137.84, "end_seconds": 138.08, "confidence": null}, {"text": "plötzlich.", "start_seconds": 138.08, "end_seconds": 138.16, "confidence": null}, {"text": "Das", "start_seconds": 139.04, "end_seconds": 139.2, "confidence": null}, {"text": "habe", "start_seconds": 139.2, "end_seconds": 139.28, "confidence": null}, {"text": "ich", "start_seconds": 139.28, "end_seconds": 139.44, "confidence": null}, {"text": "jetzt", "start_seconds": 139.44, "end_seconds": 139.6, "confidence": null}, {"text": "gar", "start_seconds": 139.6, "end_seconds": 139.76, "confidence": null}, {"text": "nicht", "start_seconds": 139.76, "end_seconds": 139.84, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 189, "segment_id": 20, "revision": 6, "text": "Habe ich gar nicht so erwartet. Das nervig", "granularity": "word", "items": [{"text": "Habe", "start_seconds": 142.32, "end_seconds": 142.56, "confidence": null}, {"text": "ich", "start_seconds": 142.56, "end_seconds": 142.64, "confidence": null}, {"text": "gar", "start_seconds": 142.64, "end_seconds": 142.72, "confidence": null}, {"text": "nicht", "start_seconds": 142.72, "end_seconds": 142.8, "confidence": null}, {"text": "so", "start_seconds": 142.8, "end_seconds": 143.04, "confidence": null}, {"text": "erwartet.", "start_seconds": 143.04, "end_seconds": 143.52, "confidence": null}, {"text": "Das", "start_seconds": 144.48, "end_seconds": 144.72, "confidence": null}, {"text": "nervig", "start_seconds": 144.72, "end_seconds": 144.88, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 193, "segment_id": 21, "revision": 4, "text": " sie sagten, dass ihre Großtante das hatte", "granularity": "word", "items": [{"text": " sie", "start_seconds": 150.64, "end_seconds": 150.88, "confidence": null}, {"text": "sagten,", "start_seconds": 150.88, "end_seconds": 151.04, "confidence": null}, {"text": "dass", "start_seconds": 151.04, "end_seconds": 151.2, "confidence": null}, {"text": "ihre", "start_seconds": 151.2, "end_seconds": 151.44, "confidence": null}, {"text": "Großtante", "start_seconds": 151.44, "end_seconds": 152.08, "confidence": null}, {"text": "das", "start_seconds": 152.08, "end_seconds": 152.24, "confidence": null}, {"text": "hatte", "start_seconds": 152.24, "end_seconds": 152.32, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 195, "segment_id": 22, "revision": 2, "text": " Ja", "granularity": "word", "items": [{"text": " Ja", "start_seconds": 154.08, "end_seconds": 154.16, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 198, "segment_id": 23, "revision": 3, "text": " später im Rollstuhl", "granularity": "word", "items": [{"text": " später", "start_seconds": 157.52, "end_seconds": 157.76, "confidence": null}, {"text": "im", "start_seconds": 157.76, "end_seconds": 157.92, "confidence": null}, {"text": "Rollstuhl", "start_seconds": 157.92, "end_seconds": 158.4, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 210, "segment_id": 24, "revision": 12, "text": " weiß irgendwie viel sie von Rollen wissen, ob es ihn helfen würde, wenn ich ihn dazu ein bisschen sage, das ist nicht immer bei jedem gleich", "granularity": "word", "items": [{"text": " weiß", "start_seconds": 164.08, "end_seconds": 164.4, "confidence": null}, {"text": "irgendwie", "start_seconds": 164.4, "end_seconds": 164.72, "confidence": null}, {"text": "viel", "start_seconds": 164.72, "end_seconds": 164.88, "confidence": null}, {"text": "sie", "start_seconds": 164.88, "end_seconds": 164.96, "confidence": null}, {"text": "von", "start_seconds": 164.96, "end_seconds": 165.12, "confidence": null}, {"text": "Rollen", "start_seconds": 165.12, "end_seconds": 165.44, "confidence": null}, {"text": "wissen,", "start_seconds": 165.44, "end_seconds": 165.6, "confidence": null}, {"text": "ob", "start_seconds": 165.6, "end_seconds": 165.76, "confidence": null}, {"text": "es", "start_seconds": 165.76, "end_seconds": 165.92, "confidence": null}, {"text": "ihn", "start_seconds": 165.92, "end_seconds": 166.0, "confidence": null}, {"text": "helfen", "start_seconds": 166.0, "end_seconds": 166.24, "confidence": null}, {"text": "würde,", "start_seconds": 166.24, "end_seconds": 166.48, "confidence": null}, {"text": "wenn", "start_seconds": 166.48, "end_seconds": 166.64, "confidence": null}, {"text": "ich", "start_seconds": 166.64, "end_seconds": 166.88, "confidence": null}, {"text": "ihn", "start_seconds": 166.88, "end_seconds": 166.96, "confidence": null}, {"text": "dazu", "start_seconds": 167.44, "end_seconds": 167.68, "confidence": null}, {"text": "ein", "start_seconds": 167.68, "end_seconds": 167.84, "confidence": null}, {"text": "bisschen", "start_seconds": 167.84, "end_seconds": 168.08, "confidence": null}, {"text": "sage,", "start_seconds": 168.08, "end_seconds": 168.16, "confidence": null}, {"text": "das", "start_seconds": 168.56, "end_seconds": 168.64, "confidence": null}, {"text": "ist", "start_seconds": 168.64, "end_seconds": 168.72, "confidence": null}, {"text": "nicht", "start_seconds": 168.72, "end_seconds": 168.88, "confidence": null}, {"text": "immer", "start_seconds": 168.88, "end_seconds": 169.12, "confidence": null}, {"text": "bei", "start_seconds": 169.12, "end_seconds": 169.28, "confidence": null}, {"text": "jedem", "start_seconds": 169.28, "end_seconds": 169.68, "confidence": null}, {"text": "gleich", "start_seconds": 169.68, "end_seconds": 169.84, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 219, "segment_id": 25, "revision": 9, "text": "Aber trotzdem endet er dann so, oder wir sind ein bisschen zu erzählen", "granularity": "word", "items": [{"text": "Aber", "start_seconds": 172.8, "end_seconds": 173.04, "confidence": null}, {"text": "trotzdem", "start_seconds": 173.04, "end_seconds": 173.2, "confidence": null}, {"text": "endet", "start_seconds": 173.92, "end_seconds": 174.32, "confidence": null}, {"text": "er", "start_seconds": 174.32, "end_seconds": 174.56, "confidence": null}, {"text": "dann", "start_seconds": 174.56, "end_seconds": 174.72, "confidence": null}, {"text": "so,", "start_seconds": 174.72, "end_seconds": 174.96, "confidence": null}, {"text": "oder", "start_seconds": 174.96, "end_seconds": 175.04, "confidence": null}, {"text": "wir", "start_seconds": 176.24, "end_seconds": 176.32, "confidence": null}, {"text": "sind", "start_seconds": 176.32, "end_seconds": 176.56, "confidence": null}, {"text": "ein", "start_seconds": 176.56, "end_seconds": 176.72, "confidence": null}, {"text": "bisschen", "start_seconds": 176.72, "end_seconds": 176.96, "confidence": null}, {"text": "zu", "start_seconds": 176.96, "end_seconds": 177.04, "confidence": null}, {"text": "erzählen", "start_seconds": 177.04, "end_seconds": 177.28, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 226, "segment_id": 26, "revision": 7, "text": "Das ist tatsächlich so, dass es bei verschiedenen Menschen ganz unterschiedlich laufen kann", "granularity": "word", "items": [{"text": "Das", "start_seconds": 180.96, "end_seconds": 181.12, "confidence": null}, {"text": "ist", "start_seconds": 181.12, "end_seconds": 181.2, "confidence": null}, {"text": "tatsächlich", "start_seconds": 181.2, "end_seconds": 181.52, "confidence": null}, {"text": "so,", "start_seconds": 181.52, "end_seconds": 181.76, "confidence": null}, {"text": "dass", "start_seconds": 181.76, "end_seconds": 181.92, "confidence": null}, {"text": "es", "start_seconds": 181.92, "end_seconds": 182.08, "confidence": null}, {"text": "bei", "start_seconds": 182.08, "end_seconds": 182.32, "confidence": null}, {"text": "verschiedenen", "start_seconds": 182.32, "end_seconds": 182.72, "confidence": null}, {"text": "Menschen", "start_seconds": 182.72, "end_seconds": 183.04, "confidence": null}, {"text": "ganz", "start_seconds": 183.04, "end_seconds": 183.28, "confidence": null}, {"text": "unterschiedlich", "start_seconds": 183.28, "end_seconds": 183.76, "confidence": null}, {"text": "laufen", "start_seconds": 183.76, "end_seconds": 184.08, "confidence": null}, {"text": "kann", "start_seconds": 184.08, "end_seconds": 184.16, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 238, "segment_id": 27, "revision": 12, "text": " Und das was sie bei ihrer Großtante gesehen haben, muss nicht das sein, was bei ihnen auftritt. Das ist überhaupt nicht vorhersagbar.", "granularity": "word", "items": [{"text": " Und", "start_seconds": 185.92, "end_seconds": 186.08, "confidence": null}, {"text": "das", "start_seconds": 186.08, "end_seconds": 186.24, "confidence": null}, {"text": "was", "start_seconds": 186.24, "end_seconds": 186.48, "confidence": null}, {"text": "sie", "start_seconds": 186.48, "end_seconds": 186.56, "confidence": null}, {"text": "bei", "start_seconds": 186.56, "end_seconds": 186.72, "confidence": null}, {"text": "ihrer", "start_seconds": 186.72, "end_seconds": 187.12, "confidence": null}, {"text": "Großtante", "start_seconds": 187.12, "end_seconds": 187.68, "confidence": null}, {"text": "gesehen", "start_seconds": 187.68, "end_seconds": 187.92, "confidence": null}, {"text": "haben,", "start_seconds": 187.92, "end_seconds": 188.0, "confidence": null}, {"text": "muss", "start_seconds": 188.32, "end_seconds": 188.48, "confidence": null}, {"text": "nicht", "start_seconds": 188.48, "end_seconds": 188.72, "confidence": null}, {"text": "das", "start_seconds": 188.72, "end_seconds": 188.88, "confidence": null}, {"text": "sein,", "start_seconds": 188.88, "end_seconds": 189.04, "confidence": null}, {"text": "was", "start_seconds": 189.04, "end_seconds": 189.2, "confidence": null}, {"text": "bei", "start_seconds": 189.2, "end_seconds": 189.36, "confidence": null}, {"text": "ihnen", "start_seconds": 189.36, "end_seconds": 189.6, "confidence": null}, {"text": "auftritt.", "start_seconds": 189.6, "end_seconds": 190.0, "confidence": null}, {"text": "Das", "start_seconds": 191.04, "end_seconds": 191.2, "confidence": null}, {"text": "ist", "start_seconds": 191.2, "end_seconds": 191.28, "confidence": null}, {"text": "überhaupt", "start_seconds": 191.28, "end_seconds": 191.52, "confidence": null}, {"text": "nicht", "start_seconds": 191.52, "end_seconds": 191.68, "confidence": null}, {"text": "vorhersagbar.", "start_seconds": 191.68, "end_seconds": 192.32, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 252, "segment_id": 28, "revision": 14, "text": " Das ist vorstellbar, dass eine erbliche Komponente da ist, wenn das in der Familie war, aber das heißt überhaupt nicht, dass dann auch die Verläufe immer gleich sind", "granularity": "word", "items": [{"text": " Das", "start_seconds": 193.76, "end_seconds": 193.84, "confidence": null}, {"text": "ist", "start_seconds": 193.84, "end_seconds": 194.0, "confidence": null}, {"text": "vorstellbar,", "start_seconds": 194.0, "end_seconds": 194.48, "confidence": null}, {"text": "dass", "start_seconds": 194.48, "end_seconds": 194.64, "confidence": null}, {"text": "eine", "start_seconds": 194.64, "end_seconds": 194.72, "confidence": null}, {"text": "erbliche", "start_seconds": 194.72, "end_seconds": 195.12, "confidence": null}, {"text": "Komponente", "start_seconds": 195.12, "end_seconds": 195.52, "confidence": null}, {"text": "da", "start_seconds": 195.52, "end_seconds": 195.68, "confidence": null}, {"text": "ist,", "start_seconds": 195.68, "end_seconds": 195.84, "confidence": null}, {"text": "wenn", "start_seconds": 195.84, "end_seconds": 196.0, "confidence": null}, {"text": "das", "start_seconds": 196.0, "end_seconds": 196.16, "confidence": null}, {"text": "in", "start_seconds": 196.16, "end_seconds": 196.24, "confidence": null}, {"text": "der", "start_seconds": 196.24, "end_seconds": 196.32, "confidence": null}, {"text": "Familie", "start_seconds": 196.32, "end_seconds": 196.4, "confidence": null}, {"text": "war,", "start_seconds": 196.8, "end_seconds": 196.88, "confidence": null}, {"text": "aber", "start_seconds": 198.0, "end_seconds": 198.24, "confidence": null}, {"text": "das", "start_seconds": 198.24, "end_seconds": 198.32, "confidence": null}, {"text": "heißt", "start_seconds": 198.32, "end_seconds": 198.56, "confidence": null}, {"text": "überhaupt", "start_seconds": 198.56, "end_seconds": 198.8, "confidence": null}, {"text": "nicht,", "start_seconds": 198.8, "end_seconds": 198.96, "confidence": null}, {"text": "dass", "start_seconds": 198.96, "end_seconds": 199.12, "confidence": null}, {"text": "dann", "start_seconds": 199.12, "end_seconds": 199.28, "confidence": null}, {"text": "auch", "start_seconds": 199.28, "end_seconds": 199.36, "confidence": null}, {"text": "die", "start_seconds": 199.36, "end_seconds": 199.6, "confidence": null}, {"text": "Verläufe", "start_seconds": 199.6, "end_seconds": 199.92, "confidence": null}, {"text": "immer", "start_seconds": 200.48, "end_seconds": 200.8, "confidence": null}, {"text": "gleich", "start_seconds": 200.8, "end_seconds": 201.04, "confidence": null}, {"text": "sind", "start_seconds": 201.04, "end_seconds": 201.12, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 257, "segment_id": 29, "revision": 5, "text": " Das heißt ja dann schon, dass ich jetzt schwere", "granularity": "word", "items": [{"text": " Das", "start_seconds": 205.12, "end_seconds": 205.2, "confidence": null}, {"text": "heißt", "start_seconds": 205.2, "end_seconds": 205.52, "confidence": null}, {"text": "ja", "start_seconds": 205.52, "end_seconds": 205.68, "confidence": null}, {"text": "dann", "start_seconds": 205.68, "end_seconds": 205.76, "confidence": null}, {"text": "schon,", "start_seconds": 205.76, "end_seconds": 205.92, "confidence": null}, {"text": "dass", "start_seconds": 205.92, "end_seconds": 206.08, "confidence": null}, {"text": "ich", "start_seconds": 206.08, "end_seconds": 206.24, "confidence": null}, {"text": "jetzt", "start_seconds": 206.24, "end_seconds": 206.48, "confidence": null}, {"text": "schwere", "start_seconds": 206.48, "end_seconds": 206.72, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 284, "segment_id": 30, "revision": 27, "text": " Medikamente nehmen muss oder hier läuft das ab. Ja schwere Medikamente, also es gibt Medikamente, mit denen man heute die diese Erkrankung sehr gut häufig, sehr gut kontrollieren kann, so dass sie nicht fortschreitet und dass diese Gelenkserstörung gar nicht erst auftreten.", "granularity": "word", "items": [{"text": " Medikamente", "start_seconds": 207.76, "end_seconds": 208.24, "confidence": null}, {"text": "nehmen", "start_seconds": 208.24, "end_seconds": 208.48, "confidence": null}, {"text": "muss", "start_seconds": 208.48, "end_seconds": 208.56, "confidence": null}, {"text": "oder", "start_seconds": 208.96, "end_seconds": 209.04, "confidence": null}, {"text": "hier", "start_seconds": 209.76, "end_seconds": 209.92, "confidence": null}, {"text": "läuft", "start_seconds": 209.92, "end_seconds": 210.16, "confidence": null}, {"text": "das", "start_seconds": 210.16, "end_seconds": 210.4, "confidence": null}, {"text": "ab.", "start_seconds": 210.4, "end_seconds": 210.64, "confidence": null}, {"text": "Ja", "start_seconds": 210.8, "end_seconds": 210.88, "confidence": null}, {"text": "schwere", "start_seconds": 211.68, "end_seconds": 211.92, "confidence": null}, {"text": "Medikamente,", "start_seconds": 211.92, "end_seconds": 212.4, "confidence": null}, {"text": "also", "start_seconds": 212.4, "end_seconds": 212.56, "confidence": null}, {"text": "es", "start_seconds": 212.56, "end_seconds": 212.64, "confidence": null}, {"text": "gibt", "start_seconds": 212.64, "end_seconds": 212.8, "confidence": null}, {"text": "Medikamente,", "start_seconds": 212.8, "end_seconds": 213.12, "confidence": null}, {"text": "mit", "start_seconds": 213.52, "end_seconds": 213.6, "confidence": null}, {"text": "denen", "start_seconds": 213.6, "end_seconds": 213.84, "confidence": null}, {"text": "man", "start_seconds": 213.84, "end_seconds": 213.92, "confidence": null}, {"text": "heute", "start_seconds": 213.92, "end_seconds": 214.32, "confidence": null}, {"text": "die", "start_seconds": 214.32, "end_seconds": 214.64, "confidence": null}, {"text": "diese", "start_seconds": 214.64, "end_seconds": 214.72, "confidence": 