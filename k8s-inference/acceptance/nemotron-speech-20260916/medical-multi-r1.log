, "end_seconds": 457.52, "confidence": null}, {"text": "zu", "start_seconds": 457.52, "end_seconds": 457.6, "confidence": null}, {"text": "thematisieren,", "start_seconds": 457.6, "end_seconds": 458.48, "confidence": null}, {"text": "ehrlich", "start_seconds": 458.48, "end_seconds": 458.72, "confidence": null}, {"text": "gesagt,", "start_seconds": 458.72, "end_seconds": 458.88, "confidence": null}, {"text": "aber", "start_seconds": 459.28, "end_seconds": 459.36, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 624, "segment_id": 72, "revision": 5, "text": " deckt jetzt auch nicht den Eindruck, als ob sie", "granularity": "word", "items": [{"text": " deckt", "start_seconds": 461.04, "end_seconds": 461.2, "confidence": null}, {"text": "jetzt", "start_seconds": 461.2, "end_seconds": 461.36, "confidence": null}, {"text": "auch", "start_seconds": 461.36, "end_seconds": 461.44, "confidence": null}, {"text": "nicht", "start_seconds": 461.44, "end_seconds": 461.6, "confidence": null}, {"text": "den", "start_seconds": 461.6, "end_seconds": 461.92, "confidence": null}, {"text": "Eindruck,", "start_seconds": 461.92, "end_seconds": 462.4, "confidence": null}, {"text": "als", "start_seconds": 462.4, "end_seconds": 462.64, "confidence": null}, {"text": "ob", "start_seconds": 462.64, "end_seconds": 462.8, "confidence": null}, {"text": "sie", "start_seconds": 462.8, "end_seconds": 462.88, "confidence": null}]}, {"type": "transcript.final", "session_id": "9bd79f8f-87ca-43a4-9f61-0c6ff05b627f", "sequence": 628, "segment_id": 73, "revision": 4, "text": " das total gut findet, wie es mir geht.", "granularity": "word", "items": [{"text": " das", "start_seconds": 464.24, "end_seconds": 464.48, "confidence": null}, {"text": "total", "start_seconds": 464.48, "end_seconds": 464.8, "confidence": null}, {"text": "gut", "start_seconds": 464.8, "end_seconds": 464.96, "confidence": null}, {"text": "findet,", "start_seconds": 46