8, "confidence": null}, {"text": "schon", "start_seconds": 263.68, "end_seconds": 263.76, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 340, "segment_id": 37, "revision": 9, "text": " mich gerade bei mir passieren konnte. Sie fragen sich, was ihr falsch gemacht haben", "granularity": "word", "items": [{"text": " mich", "start_seconds": 270.24, "end_seconds": 270.32, "confidence": null}, {"text": "gerade", "start_seconds": 270.32, "end_seconds": 270.72, "confidence": null}, {"text": "bei", "start_seconds": 270.72, "end_seconds": 270.88, "confidence": null}, {"text": "mir", "start_seconds": 270.88, "end_seconds": 271.04, "confidence": null}, {"text": "passieren", "start_seconds": 271.04, "end_seconds": 271.36, "confidence": null}, {"text": "konnte.", "start_seconds": 271.36, "end_seconds": 271.44, "confidence": null}, {"text": "Sie", "start_seconds": 272.24, "end_seconds": 272.4, "confidence": null}, {"text": "fragen", "start_seconds": 272.4, "end_seconds": 272.56, "confidence": null}, {"text": "sich,", "start_seconds": 272.56, "end_seconds": 272.64, "confidence": null}, {"text": "was", "start_seconds": 272.64, "end_seconds": 272.88, "confidence": null}, {"text": "ihr", "start_seconds": 272.88, "end_seconds": 272.96, "confidence": null}, {"text": "falsch", "start_seconds": 272.96, "end_seconds": 273.28, "confidence": null}, {"text": "gemacht", "start_seconds": 273.28, "end_seconds": 273.44, "confidence": null}, {"text": "haben", "start_seconds": 273.84, "end_seconds": 273.92, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 347, "segment_id": 38, "revision": 7, "text": "wir wissen gar nicht, warum rollen aber jemanden auftritt", "granularity": "word", "items": [{"text": "wir", "start_seconds": 277.84, "end_seconds": 278.0, "confidence": null}, {"text": "wissen", "start_seconds": 278.0, "end_seconds": 278.4, "confidence": null}, {"text": "gar", "start_seconds": 278.4, "end_seconds": 278.56, "confidence": null}, {"text": "nicht,", "start_seconds": 278.56, "end_seconds": 278.64, "confidence": null}, {"text": "warum", "start_seconds": 279.04, "end_seconds": 279.44, "confidence": null}, {"text": "rollen", "start_seconds": 279.44, "end_seconds": 279.76, "confidence": null}, {"text": "aber", "start_seconds": 279.76, "end_seconds": 279.92, "confidence": null}, {"text": "jemanden", "start_seconds": 279.92, "end_seconds": 280.32, "confidence": null}, {"text": "auftritt", "start_seconds": 280.32, "end_seconds": 280.64, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 352, "segment_id": 39, "revision": 5, "text": "Wir wissen nichts, was jemand falsch machen könnte", "granularity": "word", "items": [{"text": "Wir", "start_seconds": 281.84, "end_seconds": 282.0, "confidence": null}, {"text": "wissen", "start_seconds": 282.0, "end_seconds": 282.24, "confidence": null}, {"text": "nichts,", "start_seconds": 282.24, "end_seconds": 282.56, "confidence": null}, {"text": "was", "start_seconds": 282.56, "end_seconds": 282.8, "confidence": null}, {"text": "jemand", "start_seconds": 282.8, "end_seconds": 283.04, "confidence": null}, {"text": "falsch", "start_seconds": 283.04, "end_seconds": 283.36, "confidence": null}, {"text": "machen", "start_seconds": 283.36, "end_seconds": 283.6, "confidence": null}, {"text": "könnte", "start_seconds": 283.6, "end_seconds": 283.76, "confidence": null}]}, {"type": "transcript.final", "session_id": "64720822-5806-49b5-a223-5bb3215d0e3e", "sequence": 367, "segment_id": 40, "revision": 15, "text": "Also ich will jetzt nicht mal sagen, Sie haben nicht falsch gemacht, weil von der Erkrankung so wenig verstanden, sie tritt auf und wir wissen nicht warum sie bei dem einen Auftritt, wenn dem anderen nicht", "granularity": "word", "items": [{"text": "Also", "start_seconds": 286.8, "end_seconds": 286.96, "confidence": null}, {"text": "ich", "start_seconds": 286.96, "end_seconds": 287.04, "confidence": null}, {"text": "will", "start_seconds": 287.04, "end_seconds": 287.2, "confidence": null}, {"text": "jetzt", "start_seconds": 287.2, "end_seconds": 287.36, "confidence": null}, {"text": "nicht", "start_seconds": 287.36, "end_seconds": 287.44, "confidence": null}, {"text": "mal", "start_seconds": 287.44, "end_seconds": 287.52, "confidence": null}, {"text": "sagen,", "start_seconds": 287.52, "end_seconds": 287.84, "confidence": null}, {"text": "Sie", "start_seconds": 287.84, "end_seconds": 287.92, "confidence": null}, {"text": "haben", "start_seconds": 287.92, "end_seconds": 288.16, "confidence": null}, {"text": "nicht", "start_seconds": 288.16, "end_seconds": 288.4, "confidence": null}, {"text": "falsch", "start_seconds": 288.4, "end_seconds": 288.64, "confidence": null}, {"text": "gemacht,", "start_seconds": 288.64, "end_seconds": 288.8, "confidence": null}, {"text": "weil", "start_seconds": 288.8, "end_seconds": 289.04, "confidence": null}, {"text": "von", "start_seconds": 289.04, "end_seconds": 289.12, "confidence": null}, {"text": "der", "start_seconds": 289.12, "end_seconds": 289.2, "confidence": null}, {"text": "Erkrankung", "start_seconds": 289.2, "end_seconds": 289.6, "confidence": null}, {"text": "so", "start_seconds": 289.6, "end_seconds": 289.76, "confidence": null}, {"text": "wenig", "start_seconds": 289.76, "end_seconds": 290.0, "confidence": null}, {"text": "verstanden,", "start_seconds": 290.0, "end_seconds": 290.24, "confidence": null}, {"text": "sie", "start_seconds": 290.88, "end_seconds": 290.96, "confidence": null}, {"text": "tritt", "start_seconds": 290.96, "end_seconds": 291.12, "confidence": null}, {"text": "auf", "start_seconds": 291.12, "end_seconds": 291.36, "confidence": null}, {"text": "und", "start_seconds": 291.36, "end_seconds": 291.52, "confidence": null}, {"text": "wir", "start_seconds": 291.52, "end_seconds": 291.76, "confidence": null}, {"text": "wi