{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "fs2-speech-snapshot-multi-speech-multi-0916-r1",
    "namespace": "fs2-models",
    "labels": {
      "fs2.nebius.ai/test-only": "true",
      "snapshot.fs2.nebius/task": "fs2-h100-fleet-snapshot-options-r20260907",
      "snapshot.fs2.nebius/model": "nemotron-speech-multilingual-0.6b",
      "workload.fs2.nebius/owner": "nemotron-speech-20260916"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "nodeSelector": {
      "kubernetes.io/hostname": "computeinstance-e00fkt1bsa4ec657sn"
    },
    "tolerations": [
      {
        "key": "dedicated",
        "operator": "Equal",
        "value": "fs2-inference",
        "effect": "NoSchedule"
      }
    ],
    "securityContext": {
      "runAsUser": 10001,
      "runAsGroup": 10001,
      "supplementalGroups": [
