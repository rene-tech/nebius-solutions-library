            "type": "string",
            "enum": [
              "raw",
              "enriched"
            ],
            "default": "raw",
            "description": "raw runs the CPU data pipeline; enriched consumes a verified processed-JSON artifact and skips preprocessing."
          },
          "raw_input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Required for enriched input; the original raw-input digest bound by the relocatable handoff."
          },
          "fold_job_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "default": 1,
            "description": "Number of fold jobs in the input JSON. The CPU stage packages one data JSON per fold job and the GPU stage consumes the package, so this bounds the expected output inventory."
          }
        }
      }
