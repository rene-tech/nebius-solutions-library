                "start": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9999
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9999
                }
              }
            }
          },
          "design_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "hotspot_residues": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][1-9][0-9]{0,3}$"
            }
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
