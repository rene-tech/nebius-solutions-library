{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2.nebius.ai/schemas/private-preprocess-result-v1.json",
  "title": "FS2 immutable private preprocessing result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "request_sha256", "input_sha256", "reference_manifest_sha256",
    "backend", "privacy_mode", "created_at", "duration_seconds", "content"
  ],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/private-preprocess-result/v1"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "reference_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "backend": {"enum": ["colabfold-search", "protenix-inputprep", "alphafold3-data"]},
    "privacy_mode": {"enum": ["private-only", "public-opt-in"]},
    "created_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_sha256", "expanded_bytes", "file_count", "files"],
      "properties": {
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "expanded_bytes": {"type": "integer", "minimum": 1},
        "file_count": {"type": "integer", "minimum": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
