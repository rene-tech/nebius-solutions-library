{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2.nebius.ai/schemas/reference-data-source-catalog-v1.json",
  "title": "FS2 reference-data source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "bundles"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/reference-data-source-catalog/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "bundles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/bundle"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "revision", "description", "upstream", "access",
        "sizing", "update_policy", "objects"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": "string", "minLength": 1},
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "revision", "source_url", "source_sha256"],
          "properties": {
            "project": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "source_url": {"type": "string", "pattern": "^https://"},
            "source_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "redistribution", "staging_policy", "terms"],
          "properties": {
            "state": {"enum": ["public", "academic-gated", "commercial-gated", "unresolved"]},
            "redistribution": {"enum": ["allowed-with-attribution", "component-terms", "prohibited", "review-required"]},
            "staging_policy": {"enum": ["automatic-public", "terms-receipt-required", "entitlement-receipt-required"]},
            "terms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["component", "license", "url", "verification"],
                "properties": {
                  "component": {"type": "string", "minLength": 1},
                  "license": {"type": "string", "minLength": 1},
                  "url": {"type": "string", "pattern": "^https://"},
                  "verification": {"enum": ["primary-source-verified", "upstream-terms-review-required"]}
                }
              }
            }
          }
        },
        "sizing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compressed_bytes", "expanded_bytes", "expanded_bytes_kind"],
          "properties": {
            "compressed_bytes": {"type": "integer", "minimum": 1},
            "expanded_bytes": {"type": ["integer", "null"], "minimum": 1},
            "expanded_bytes_kind": {"enum": ["exact", "upstream-estimate", "not-published"]}
          }
        },
        "update_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cadence", "mutable_aliases_allowed", "promotion"],
          "properties": {
            "cadence": {"type": "string", "minLength": 1},
            "mutable_aliases_allowed": {"const": false},
            "promotion": {"const": "new-revision-after-offline-validation"}
          }
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceObject"}
        }
      }
    },
    "sourceObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "source", "target", "transform", "source_bytes",
        "source_integrity", "license_component"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["url"],
              "properties": {"url": {"type": "string", "pattern": "^(https|file)://"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["url_env"],
              "properties": {"url_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}}
            }
          ]
        },
        "target": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "transform": {"enum": ["none", "gzip", "zstd", "tar.gz", "tar.zst", "zip"]},
        "source_bytes": {"type": "integer", "minimum": 1},
        "source_integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest", "cryptographic"],
          "properties": {
            "algorithm": {"enum": ["sha256", "md5", "etag", "s3-multipart-etag"]},
            "digest": {"type": "string", "pattern": "^[A-Fa-f0-9-]{8,160}$"},
            "cryptographic": {"type": "boolean"}
          }
        },
        "license_component": {"type": "string", "minLength": 1},
        "overwrite": {"type": "boolean", "default": false}
      }
    }
  }
}
