{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2.nebius.ai/schemas/reference-data-published-manifest-v1.json",
  "title": "FS2 immutable reference-data publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "bundle_id", "revision", "source_catalog_sha256", "created_at",
    "access_receipt_sha256", "source_objects", "content", "storage"
  ],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/reference-data-manifest/v1"},
    "bundle_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 160},
    "source_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "access_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "source_objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_bytes", "source_sha256", "target", "transform"],
        "properties": {
          "id": {"type": "string"},
          "source_bytes": {"type": "integer", "minimum": 1},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "target": {"type": "string"},
          "transform": {"type": "string"}
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_sha256", "expanded_bytes", "file_count", "inventory_sha256"],
      "properties": {
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "expanded_bytes": {"type": "integer", "minimum": 1},
        "file_count": {"type": "integer", "minimum": 1},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
              "bytes": {"type": "integer", "minimum": 0},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shared_filesystem_uri", "object_manifest_prefix",
        "host_root", "dataset_sub_path", "inventory_uri"
      ],
      "properties": {
        "shared_filesystem_uri": {"type": "string", "pattern": "^file:///"},
        "object_manifest_prefix": {"type": ["string", "null"], "pattern": "^s3://"},
        "host_root": {"type": "string", "pattern": "^/[^\\u0000]*$"},
        "dataset_sub_path": {
          "type": "string",
          "pattern": "^datasets/[a-z0-9][a-z0-9._-]{0,127}/[^/]{1,160}/sha256/[a-f0-9]{64}$"
        },
        "inventory_uri": {"type": "string", "pattern": "^file:///"}
      }
    }
  },
  "allOf": [
    {
      "description": "An inventory longer than 4096 files is published separately and referenced only by inventory_sha256.",
      "if": {
        "properties": {"content": {"properties": {"file_count": {"minimum": 4097}}, "required": ["file_count"]}},
        "required": ["content"]
      },
      "then": {"properties": {"content": {"not": {"required": ["files"]}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
