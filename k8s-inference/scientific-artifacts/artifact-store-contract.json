{
  "schema": "fs2-serve.nebius.ai/scientific-artifact-store-contract/v1",
  "description": "The exact seam between the Terraform-provisioned scientific result store and the control-plane chart that consumes it. Terraform owns everything under `terraform`; the control-plane chart owns the value declarations and templates named under `chart`. A key that one side emits and the other does not declare leaves the store silently unconfigured, so both halves are asserted against this file.",
  "object_layout": {
    "root": "scientific/v1",
    "tenant_prefix": "scientific/v1/tenants/<tenant>/",
    "operation_prefix": "scientific/v1/tenants/<tenant>/operations/<operation>/",
    "object_key": "scientific/v1/tenants/<tenant>/operations/<operation>/stages/<stage>/shards/<shard>/attempts/<attempt>/<input|output>/sha256/<digest>",
    "segments": [
      "tenant",
      "operation",
      "stage",
      "shard",
      "attempt",
      "direction",
      "digest"
    ],
    "bounds": {
      "max_shard": 1023,
      "max_attempt": 10
    }
  },
  "storage": {
    "versioning_policy": "ENABLED",
    "storage_class": "STANDARD",
    "addressing_style": "path",
    "verify_tls": true,
    "object_roles": [
      "storage.uploader",
      "storage.object-viewer",
      "storage.object-lister"
    ],
    "writer_path_template": "scientific/v1/tenants/<tenant>/*",
    "credential_mode": "TENANT_ISOLATED_BROKER_KEYS",
    "broker_operation_seconds": 120,
    "kubernetes_broker_identity_object_roles": [],
    "tenant_provider_group_object_roles": [
      "storage.uploader",
      "storage.object-viewer",
      "storage.object-lister"
    ],
    "migration_phase": "legacy-overlap",
    "legacy_shared_provider_authorized": true,
    "ordinary_apply_irreversible_cutover": false,
    "lifecycle_rule_ids": [
      "abort-incomplete-multipart-uploads",
      "remove-expired-delete-markers"
    ],
    "abort_incomplete_multipart_upload_days": 1,
    "noncurrent_version_expiration_days": null,
    "expired_object_delete_marker": true,
    "current_object_expiration": "application-owned"
  },
  "credential_broker": {
    "namespace": "fs2-system",
    "service_template": "fs2-artifact-{tenant_hash}",
    "schema": "fs2-serve.nebius.ai/artifact-tenant-broker-routing/v1",
    "authority_sources": [
      "verified PAT and operation owner",
      "Ed25519 executor capability and active fenced lease",
      "Ed25519 scientific workload capability and active exact attempt",
      "Ed25519 operator capability and active tenant-scoped session"
    ],
    "provider_binding_fields": [
      "access_key_id",
      "active_generation",
      "generations",
      "revision",
      "secret_reference_id"
    ],
    "forbidden_handoff_fields": [
      "aws_secret_access_key",
      "secret_access_key",
      "secret_key",
      "secret_value"
    ],
    "provider_bindings_annotation": "fs2.nebius.ai/artifact-provider-bindings-revision",
    "provider_endpoint": "https://storage.<region>.nebius.cloud",
    "provider_key_custody": "one tenant key per broker pod; no provider key in gateway",
    "authority_custody": "Ed25519 private key in issuer only; public key in tenant brokers; gateway has neither",
    "operation_policy": "one authoritative tenant, canonical object, action and immutable version when applicable",
    "credentials_returned_to_gateway": false,
    "credential_rotation": "additive retained generations; bucket policy and broker mount select only active_generation"
  },
  "abandoned_upload_cleanup": {
    "grace_seconds": 3600,
    "claim": "append-only finalization fence",
    "discovery": "HEAD plus bounded exact-prefix version list; exactly one current non-null version, no delete marker or pagination",
    "delete": "exact VersionId only after durable version ledger",
    "receipt": "append-only exact-version-deleted proof retained outside operation foreign keys; absence remains purge-fenced and retryable",
    "fairness": "append-only attempt timestamps rotate unresolved claims before newly eligible uploads can starve"
  },
  "chart": {
    "scientificArtifacts": [
      "addressingStyle",
      "authorityIssuer",
      "bucket",
      "credentialBroker",
      "downloadHandleTtlSeconds",
      "egressCidrs",
      "enabled",
      "endpoint",
      "handleTtlSeconds",
      "inlineContentMaxBytes",
      "maxBytes",
      "mediaTypes",
      "region",
      "retentionSeconds",
      "uploadHandleTtlSeconds",
      "verifyTls"
    ],
    "scientificBatch": [
      "apiTimeoutSeconds",
      "enabled",
      "executionMap",
      "executionMapConfigMapName",
      "executionMapKey",
      "kubernetesApiUrl",
      "leaseSeconds",
      "namespace",
      "pollSeconds",
      "schedulingContractConfigMapName",
      "schedulingContractKey",
      "schedulingContractNamespace",
      "schedulingContractSchema",
      "schedulingContractSha256",
      "tokenExpirationSeconds",
      "workers",
      "writesEnabled"
    ],
    "networkPolicy": [
      "artifactStoreCidrs"
    ],
    "podAnnotations": [
      "fs2.nebius.ai/artifact-provider-bindings-revision"
    ],
    "forbidden_values": [
      "artifactService"
    ]
  },
  "control_plane_environment": [
    "FS2_ARTIFACT_HANDLE_TTL_SECONDS",
    "FS2_ARTIFACT_CREDENTIAL_BROKER_AUDIENCE",
    "FS2_ARTIFACT_CREDENTIAL_BROKER_CA_FILE",
    "FS2_ARTIFACT_CREDENTIAL_BROKER_TOKEN_FILE",
    "FS2_ARTIFACT_CREDENTIAL_BROKER_URL_TEMPLATE",
    "FS2_ARTIFACT_AUTHORITY_ISSUER_AUDIENCE",
    "FS2_ARTIFACT_AUTHORITY_ISSUER_CA_FILE",
    "FS2_ARTIFACT_AUTHORITY_ISSUER_TOKEN_FILE",
    "FS2_ARTIFACT_AUTHORITY_ISSUER_URL",
    "FS2_ARTIFACT_DOWNLOAD_HANDLE_TTL_SECONDS",
    "FS2_ARTIFACT_MAX_BYTES",
    "FS2_ARTIFACT_MEDIA_TYPES",
    "FS2_ARTIFACT_RETENTION_SECONDS",
    "FS2_ARTIFACT_UPLOAD_HANDLE_TTL_SECONDS",
    "FS2_ARTIFACT_STORE_ADDRESSING_STYLE",
    "FS2_ARTIFACT_STORE_BUCKET",
    "FS2_ARTIFACT_STORE_ENDPOINT",
    "FS2_ARTIFACT_STORE_REGION",
    "FS2_ARTIFACT_STORE_VERIFY_TLS",
    "FS2_SCIENTIFIC_ARTIFACTS_ENABLED"
  ],
  "gates": {
    "scientific_batch.enabled": "storage.scientific_artifacts.enabled",
    "scientific_batch.writes_enabled": "scientific_batch.enabled",
    "storage_independently_deployable": true
  }
}
