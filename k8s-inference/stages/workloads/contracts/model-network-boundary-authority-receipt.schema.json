{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/model-network-boundary-authority/v3",
  "title": "Externally signed model-network boundary custody receipt",
  "type": "object",
  "required": ["schema", "phase", "cluster_id", "authority_namespace", "issued_at", "expires_at", "verification_window", "deployment", "service", "webhook", "acquisition_writer", "scientific_writer", "jobset_writer", "release_inventory", "external_custody", "custody", "rbac_census", "tls", "protected_objects", "payload_sha256"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/model-network-boundary-authority/v3"},
    "phase": {"enum": ["bootstrap", "armed"]},
    "cluster_id": {"type": "string", "pattern": "^mk8scluster-[a-z0-9]+$"},
    "authority_namespace": {"const": "fs2-network-security"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "verification_window": {
      "type": "object",
      "required": ["first_observed_at", "last_observed_at", "first_snapshot_sha256", "last_snapshot_sha256"],
      "properties": {
        "first_observed_at": {"type": "string", "format": "date-time"},
        "last_observed_at": {"type": "string", "format": "date-time"},
        "first_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "last_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "digest"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[^@\\s]+/network-boundary-authority$"},
            "digest": {"$ref": "#/$defs/imageDigest"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "webhook": {
      "type": "object",
      "required": ["name", "uid", "resource_version", "spec_sha256"],
      "properties": {
        "name": {"const": "fs2-model-network-boundary"},
        "uid": {"type": "string", "minLength": 1},
        "resource_version": {"type": "string", "minLength": 1},
        "spec_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["namespace", "name", "uid", "resource_version", "object_sha256", "endpoints_uid", "endpoints_resource_version", "endpoints_object_sha256", "ready_endpoints", "serving_certificate_sha256"],
      "properties": {
        "namespace": {"const": "fs2-network-security"},
        "name": {"const": "fs2-model-network-boundary"},
        "uid": {"type": "string", "minLength": 1},
        "resource_version": {"type": "string", "minLength": 1},
        "object_sha256": {"$ref": "#/$defs/sha256"},
        "endpoints_uid": {"type": "string", "minLength": 1},
        "endpoints_resource_version": {"type": "string", "minLength": 1},
        "endpoints_object_sha256": {"$ref": "#/$defs/sha256"},
        "ready_endpoints": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/readyEndpoint"}},
        "serving_certificate_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "acquisition_writer": {
      "type": "object",
      "required": ["username", "service_account_uid", "resource_version"],
      "properties": {
        "username": {"const": "system:serviceaccount:fs2-system:fs2-catalog-acquisition"},
        "service_account_uid": {"type": "string", "minLength": 1},
        "resource_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scientific_writer": {
      "oneOf": [
        {"type": "null"},
        {
      "type": "object",
      "required": ["username", "service_account_uid", "resource_version"],
      "properties": {
        "username": {"const": "system:serviceaccount:fs2-system:fs2-scientific-job-writer"},
        "service_account_uid": {"type": "string", "minLength": 1},
        "resource_version": {"type": "string", "minLength": 1}
      },
          "additionalProperties": false
        }
      ]
    },
    "jobset_writer": {
      "type": "object",
      "required": ["username", "deployment_uid", "deployment_resource_version"],
      "properties": {
        "username": {"type": "string", "pattern": "^system:serviceaccount:jobset-system:fs2-[a-z][a-z0-9]{5,11}-jobset-controller$"},
        "deployment_uid": {"type": "string", "minLength": 1},
        "deployment_resource_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "release_inventory": {
      "type": "object",
      "required": ["sha256", "entries"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "entries": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/releaseEntry"}}
      },
      "additionalProperties": false
    },
    "external_custody": {
      "type": "object",
      "required": ["schema", "policy_id", "policy_revision", "provider_trust_root_sha256", "attestation_sha256", "gateway_policy_sha256", "cluster_resource_version", "gateway_egress_host_cidrs", "freeze_transaction_id", "freeze_expires_at", "frozen_resources_sha256"],
      "properties": {
        "schema": {"const": "fs2-serve.nebius.ai/model-network-boundary-provider-custody/v3"},
        "policy_id": {"type": "string", "minLength": 1, "maxLength": 253},
        "policy_revision": {"type": "string", "minLength": 1, "maxLength": 253},
        "provider_trust_root_sha256": {"$ref": "#/$defs/sha256"},
        "attestation_sha256": {"$ref": "#/$defs/sha256"},
        "gateway_policy_sha256": {"$ref": "#/$defs/sha256"},
        "cluster_resource_version": {"type": "integer", "minimum": 0},
        "gateway_egress_host_cidrs": {
          "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^((([0-9]{1,3}\\.){3}[0-9]{1,3})/32|([0-9A-Fa-f:]+)/128)$"}
        },
        "freeze_transaction_id": {"type": "string", "pattern": "^[a-z][a-z0-9]{5,31}:[1-9][0-9]*:[a-f0-9]{32}$"},
        "freeze_expires_at": {"type": "string", "format": "date-time"},
        "frozen_resources_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "custody": {
      "type": "object",
      "required": ["trust_root_sha256", "provider", "credentials"],
      "properties": {
        "trust_root_sha256": {"$ref": "#/$defs/sha256"},
        "provider": {
          "type": "object",
          "required": ["kind", "trust_domain", "custodian_principal_id", "recovery_principal_id"],
          "properties": {
            "kind": {"const": "nebius-iam"},
            "trust_domain": {"type": "string", "minLength": 1, "maxLength": 253},
            "custodian_principal_id": {"type": "string", "minLength": 1, "maxLength": 253},
            "recovery_principal_id": {"type": "string", "minLength": 1, "maxLength": 253}
          },
          "additionalProperties": false
        },
        "credentials": {
          "type": "object",
          "required": ["authorizer", "transition", "maintenance", "auditor", "custodian", "recovery"],
          "properties": {
            "authorizer": {"$ref": "#/$defs/credential"},
            "transition": {"$ref": "#/$defs/credential"},
            "maintenance": {"$ref": "#/$defs/credential"},
            "auditor": {"$ref": "#/$defs/credential"},
            "custodian": {"$ref": "#/$defs/credential"},
            "recovery": {"$ref": "#/$defs/credential"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "rbac_census": {
      "type": "object",
      "required": ["cluster_roles", "cluster_role_bindings", "roles", "role_bindings", "privileged_capability_cluster_roles", "privileged_capability_roles", "bound_privileged_capability_roles", "provider_authorized_privileged_bindings"],
      "properties": {
        "cluster_roles": {"$ref": "#/$defs/collection"},
        "cluster_role_bindings": {"$ref": "#/$defs/collection"},
        "roles": {"$ref": "#/$defs/collection"},
        "role_bindings": {"$ref": "#/$defs/collection"},
        "privileged_capability_cluster_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 253}
        },
        "privileged_capability_roles": {
          "type": "array",
          "maxItems": 2048,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?/[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"}
        },
        "bound_privileged_capability_roles": {
          "type": "array", "maxItems": 4096, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "provider_authorized_privileged_bindings": {
          "type": "array", "maxItems": 4096, "uniqueItems": true,
          "items": {"$ref": "#/$defs/bindingIdentity"}
        }
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "required": ["serving_secret", "ca_secret", "webhook_ca_bundle_sha256"],
      "properties": {
        "serving_secret": {"$ref": "#/$defs/objectIdentity"},
        "ca_secret": {"$ref": "#/$defs/objectIdentity"},
        "webhook_ca_bundle_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "protected_objects": {
      "type": "array",
      "minItems": 40,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["resource", "namespace", "name", "uid", "resource_version", "object_sha256"],
        "properties": {
          "resource": {"type": "string", "minLength": 1, "maxLength": 253},
          "namespace": {"type": "string", "maxLength": 63},
          "name": {"type": "string", "minLength": 1, "maxLength": 253},
          "uid": {"type": "string", "minLength": 1},
          "resource_version": {"type": "string", "minLength": 1},
          "object_sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "credential": {
      "type": "object",
      "required": ["username", "groups", "extras", "authentication_mode", "provider_principal_id", "kubeconfig_sha256", "client_certificate_sha256", "issuer_ca_sha256", "gateway_server"],
      "properties": {
        "username": {"enum": ["fs2-model-network-authorizer", "fs2-model-network-transition", "fs2-model-network-maintenance", "fs2-model-network-auditor", "fs2-model-network-custodian", "fs2-model-network-recovery"]},
        "groups": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 253}
        },
        "extras": {"type": "object", "maxProperties": 0},
        "authentication_mode": {"const": "x509-client-certificate"},
        "provider_principal_id": {"type": "string", "minLength": 1, "maxLength": 253},
        "kubeconfig_sha256": {"$ref": "#/$defs/sha256"},
        "client_certificate_sha256": {"$ref": "#/$defs/sha256"},
        "issuer_ca_sha256": {"$ref": "#/$defs/sha256"},
        "gateway_server": {"type": "string", "pattern": "^https://[^/?#]+(?::[0-9]{1,5})?$"}
      },
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "required": ["resource_version", "items_sha256"],
      "properties": {
        "resource_version": {"type": "string", "minLength": 1},
        "items_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "objectIdentity": {
      "type": "object",
      "required": ["namespace", "name", "uid", "resource_version", "object_sha256"],
      "properties": {
        "namespace": {"const": "fs2-network-security"},
        "name": {"enum": ["fs2-model-network-boundary-tls", "fs2-model-network-boundary-ca"]},
        "uid": {"type": "string", "minLength": 1},
        "resource_version": {"type": "string", "minLength": 1},
        "object_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "readyEndpoint": {
      "type": "object",
      "required": ["pod_name", "pod_uid", "pod_resource_version", "node_name", "ip"],
      "properties": {
        "pod_name": {"type": "string", "minLength": 1},
        "pod_uid": {"type": "string", "minLength": 1},
        "pod_resource_version": {"type": "string", "minLength": 1},
        "node_name": {"type": "string", "minLength": 1},
        "ip": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "releaseEntry": {
      "type": "object",
      "required": ["group", "resource", "namespace", "name", "operations", "objectSha256"],
      "properties": {
        "group": {"type": "string"},
        "resource": {"type": "string", "minLength": 1},
        "namespace": {"const": "fs2-system"},
        "name": {"type": "string", "minLength": 1},
        "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CREATE", "UPDATE", "DELETE"]}},
        "objectSha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "bindingIdentity": {
      "type": "object",
      "required": ["kind", "namespace", "name", "role_ref", "object_sha256"],
      "properties": {
        "kind": {"enum": ["RoleBinding", "ClusterRoleBinding"]},
        "namespace": {"const": "fs2-system"},
        "name": {"type": "string", "minLength": 1},
        "role_ref": {"type": "string", "minLength": 1},
        "object_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
