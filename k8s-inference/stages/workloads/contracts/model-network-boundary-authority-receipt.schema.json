{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs2-serve.nebius.ai/schema/model-network-boundary-authority/v2",
  "title": "Externally signed model-network boundary custody receipt",
  "type": "object",
  "required": ["schema", "cluster_id", "authority_namespace", "issued_at", "expires_at", "deployment", "webhook", "acquisition_writer", "scientific_writer", "custody", "rbac_census", "tls", "protected_objects", "payload_sha256"],
  "properties": {
    "schema": {"const": "fs2-serve.nebius.ai/model-network-boundary-authority/v2"},
    "cluster_id": {"type": "string", "pattern": "^mk8scluster-[a-z0-9]+$"},
    "authority_namespace": {"const": "fs2-network-security"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "deployment": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "digest"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[^@\\s]+/network-boundary-authority$"},
            "digest": {"$ref": "#/$defs/imageDigest"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "webhook": {
      "type": "object",
      "required": ["name", "uid", "resource_version", "spec_sha256"],
      "properties": {
        "name": {"const": "fs2-model-network-boundary"},
        "uid": {"type": "string", "minLength": 1},
        "resource_version": {"type": "string", "minLength": 1},
        "spec_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "acquisition_writer": {
      "type": "object",
      "required": ["username", "service_account_uid", "resource_version"],
      "properties": {
        "username": {"const": "system:serviceaccount:fs2-system:fs2-catalog-acquisition"},
        "service_account_uid": {"type": "string", "minLength": 1},
        "resource_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scientific_writer": {
      "type": "object",
      "required": ["username", "service_account_uid", "resource_version"],
      "properties": {
        "username": {"const": "system:serviceaccount:fs2-system:fs2-scientific-job-writer"},
        "service_account_uid": {"type": "string", "minLength": 1},
        "resource_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "custody": {
      "type": "object",
      "required": ["trust_root_sha256", "provider", "credentials"],
      "properties": {
        "trust_root_sha256": {"$ref": "#/$defs/sha256"},
        "provider": {
          "type": "object",
          "required": ["kind", "trust_domain", "custodian_principal_id", "recovery_principal_id"],
          "properties": {
            "kind": {"const": "nebius-iam"},
            "trust_domain": {"type": "string", "minLength": 1, "maxLength": 253},
            "custodian_principal_id": {"type": "string", "minLength": 1, "maxLength": 253},
            "recovery_principal_id": {"type": "string", "minLength": 1, "maxLength": 253}
          },
          "additionalProperties": false
        },
        "credentials": {
          "type": "object",
          "required": ["authorizer", "transition", "maintenance", "auditor", "custodian", "recovery"],
          "properties": {
            "authorizer": {"$ref": "#/$defs/credential"},
            "transition": {"$ref": "#/$defs/credential"},
            "maintenance": {"$ref": "#/$defs/credential"},
            "auditor": {"$ref": "#/$defs/credential"},
            "custodian": {"$ref": "#/$defs/credential"},
            "recovery": {"$ref": "#/$defs/credential"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "rbac_census": {
      "type": "object",
      "required": ["cluster_roles", "cluster_role_bindings", "roles", "role_bindings", "impersonation_capable_cluster_roles", "impersonation_capable_roles", "bound_impersonation_roles"],
      "properties": {
        "cluster_roles": {"$ref": "#/$defs/collection"},
        "cluster_role_bindings": {"$ref": "#/$defs/collection"},
        "roles": {"$ref": "#/$defs/collection"},
        "role_bindings": {"$ref": "#/$defs/collection"},
        "impersonation_capable_cluster_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 253}
        },
        "impersonation_capable_roles": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?/[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"}
        },
        "bound_impersonation_roles": {"type": "array", "maxItems": 0}
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "required": ["serving_secret", "ca_secret", "webhook_ca_bundle_sha256"],
      "properties": {
        "serving_secret": {"$ref": "#/$defs/objectIdentity"},
        "ca_secret": {"$ref": "#/$defs/objectIdentity"},
        "webhook_ca_bundle_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "protected_objects": {
      "type": "array",
      "minItems": 40,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["resource", "namespace", "name", "uid", "resource_version", "object_sha256"],
        "properties": {
          "resource": {"type": "string", "minLength": 1, "maxLength": 253},
          "namespace": {"type": "string", "maxLength": 63},
          "name": {"type": "string", "minLength": 1, "maxLength": 253},
          "uid": {"type": "string", "minLength": 1},
          "resource_version": {"type": "string", "minLength": 1},
          "object_sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "credential": {
      "type": "object",
      "required": ["username", "groups", "extras", "authentication_mode", "provider_principal_id", "kubeconfig_sha256", "client_certificate_sha256", "issuer_ca_sha256"],
      "properties": {
        "username": {"enum": ["fs2-model-network-authorizer", "fs2-model-network-transition", "fs2-model-network-maintenance", "fs2-model-network-auditor", "fs2-model-network-custodian", "fs2-model-network-recovery"]},
        "groups": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 253}
        },
        "extras": {"type": "object", "maxProperties": 0},
        "authentication_mode": {"const": "x509-client-certificate"},
        "provider_principal_id": {"type": "string", "minLength": 1, "maxLength": 253},
        "kubeconfig_sha256": {"$ref": "#/$defs/sha256"},
        "client_certificate_sha256": {"$ref": "#/$defs/sha256"},
        "issuer_ca_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "required": ["resource_version", "items_sha256"],
      "properties": {
        "resource_version": {"type": "string", "minLength": 1},
        "items_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "objectIdentity": {
      "type": "object",
      "required": ["namespace", "name", "uid", "resource_version", "object_sha256"],
      "properties": {
        "namespace": {"const": "fs2-network-security"},
        "name": {"enum": ["fs2-model-network-boundary-tls", "fs2-model-network-boundary-ca"]},
        "uid": {"type": "string", "minLength": 1},
        "resource_version": {"type": "string", "minLength": 1},
        "object_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
