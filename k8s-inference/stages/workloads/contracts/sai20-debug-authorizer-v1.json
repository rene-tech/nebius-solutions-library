{
  "schema": "fs2-serve.nebius.ai/sai20-debug-authorizer-contract/v1",
  "admission_review_version": "admission.k8s.io/v1",
  "side_effects": "NoneOnDryRun",
  "dry_run_contract": {
    "request_field": "AdmissionRequest.dryRun",
    "true": "deny_before_authority_evaluation_without_lease_consumption_or_record_store_write",
    "false_or_absent": "evaluate_exact_authority_and_durably_append_allow_or_deny_before_response"
  },
  "protected_namespaces": [
    "cnpg-system",
    "fs2-data",
    "fs2-observability",
    "fs2-system"
  ],
  "protected_subresources": {
    "pods/attach": [
      "CONNECT"
    ],
    "pods/ephemeralcontainers": [
      "UPDATE"
    ],
    "pods/exec": [
      "CONNECT"
    ],
    "pods/portforward": [
      "CONNECT"
    ],
    "pods/proxy": [
      "CONNECT"
    ]
  },
  "decision_contract": {
    "target_inventory": "require_exact_signed_namespace_pod_name_uid_and_credential_classification",
    "unknown_or_replacement_uid": "deny_generation_refresh_required",
    "unprotected_target": "ephemeralcontainers_requires_exact_active_lease;other_connect_may_allow_without_lease_only_when_exact_signed_uid_is_credential_free",
    "protected_target": "require_exact_active_lease_for_exact_signed_uid",
    "credential_boundary": [
      "source_owned_complete_pod_secret_reference_contract",
      "every_nonempty_secret_reference_regardless_of_secret_inventory",
      "every_explicit_projected_service_account_token_with_exact_audience_expiration_and_path",
      "api_injected_default_service_account_token_normalized_by_exact_observed_profile_without_random_volume_name",
      "privileged_service_account_inventory",
      "signed_controller_parent_uid_credential_surface_and_rollout_lineage",
      "live_observed_controller_identity_for_every_native_parent_child_edge",
      "ephemeral_container_update_intersects_exact_lease_and_credential_custody"
    ],
    "identity_match": [
      "uid",
      "username",
      "groups",
      "extra"
    ],
    "target_match": [
      "customer_request_sha256",
      "tenant_id",
      "model_id",
      "namespace",
      "pod_name",
      "pod_uid",
      "subresource",
      "operation"
    ],
    "ephemeral_container_admission_operation": "UPDATE_for_signed_patch_or_update_lease",
    "ephemeral_container_spec": "require_exact_dual_signed_full_spec_and_sha256",
    "ephemeral_container_image": "require_digest_pinned_image_and_explicit_absolute_command",
    "ephemeral_container_security": "require_nonroot_no_privilege_escalation_drop_all_runtime_default_readonly_root",
    "ephemeral_container_storage": "forbid_all_volumeMounts_and_volumeDevices_including_secret_projected_service_account_token_csi_pvc_hostpath_and_runtime_volumes",
    "ephemeral_container_namespace_isolation": "forbid_targetContainerName_and_deny_hostPID_hostIPC_hostNetwork_or_shareProcessNamespace_targets",
    "time_match": "issued_at_minus_skew_le_server_now_lt_expires_at_plus_skew",
    "maximum_lease_seconds": 900,
    "maximum_activation_seconds": 604800,
    "maximum_clock_skew_seconds": 5,
    "activation_scope": "require_exact_dual_signed_customer_request_tenant_model_principal_and_pod_uid",
    "decision_record": "non_dry_run_durably_append_allow_or_deny_before_response_and_retain_exactly_7776000_seconds",
    "stale_or_replayed_lease": "deny",
    "unavailable_or_invalid_evidence": "deny"
  },
  "response_contract": {
    "echo_request_uid": true,
    "deny_has_audit_annotation": true,
    "include_no_credentials_or_payloads": true
  }
}
