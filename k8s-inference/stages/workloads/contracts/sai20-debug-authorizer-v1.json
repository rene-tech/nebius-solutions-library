{
  "schema": "fs2-serve.nebius.ai/sai20-debug-authorizer-contract/v1",
  "admission_review_version": "admission.k8s.io/v1",
  "protected_namespaces": [
    "cnpg-system",
    "fs2-data",
    "fs2-observability",
    "fs2-system"
  ],
  "protected_subresources": {
    "pods/attach": [
      "CONNECT"
    ],
    "pods/ephemeralcontainers": [
      "UPDATE"
    ],
    "pods/exec": [
      "CONNECT"
    ],
    "pods/portforward": [
      "CONNECT"
    ],
    "pods/proxy": [
      "CONNECT"
    ]
  },
  "decision_contract": {
    "target_inventory": "require_exact_signed_namespace_pod_name_uid_and_credential_classification",
    "unknown_or_replacement_uid": "deny_generation_refresh_required",
    "unprotected_target": "allow_without_lease_only_when_exact_signed_uid_is_credential_free",
    "protected_target": "require_exact_active_lease_for_exact_signed_uid",
    "credential_boundary": [
      "source_owned_complete_pod_secret_reference_contract",
      "every_nonempty_secret_reference_regardless_of_secret_inventory",
      "privileged_service_account_inventory",
      "signed_controller_parent_uid_and_credential_surface",
      "ephemeral_container_update_intersects_exact_lease_and_credential_custody"
    ],
    "identity_match": [
      "uid",
      "username",
      "groups",
      "extra"
    ],
    "target_match": [
      "namespace",
      "pod_name",
      "pod_uid",
      "subresource",
      "operation"
    ],
    "ephemeral_container_admission_operation": "UPDATE_for_signed_patch_or_update_lease",
    "time_match": "issued_at_minus_skew_le_server_now_lt_expires_at_plus_skew",
    "maximum_lease_seconds": 900,
    "maximum_clock_skew_seconds": 5,
    "stale_or_replayed_lease": "deny",
    "unavailable_or_invalid_evidence": "deny"
  },
  "response_contract": {
    "echo_request_uid": true,
    "deny_has_audit_annotation": true,
    "include_no_credentials_or_payloads": true
  }
}
