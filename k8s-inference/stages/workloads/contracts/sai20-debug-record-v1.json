{
  "schema": "fs2-serve.nebius.ai/sai20-debug-record-contract/v1",
  "retention_seconds": 7776000,
  "retention_semantics": "append_only_from_decided_at_through_retention_expires_at_then_exact_ttl_purge",
  "scope": "non_dry_run_admission_requests_only",
  "admission_request_dry_run": {
    "true": "deny_without_record_write_or_lease_consumption",
    "false_or_absent": "durably_record_allow_or_deny_before_admission_response"
  },
  "commit_order": "non_dry_run_durable_record_commit_before_admission_response",
  "decisions": [
    "allow",
    "deny"
  ],
  "required_fields": [
    "record_id",
    "request_uid",
    "dry_run",
    "decision",
    "decided_at",
    "retention_expires_at",
    "lease_id",
    "customer_request_sha256",
    "audit_id",
    "tenant_id",
    "model_id",
    "principal_id",
    "principal_uid",
    "namespace",
    "pod_name",
    "pod_uid",
    "subresource",
    "operation",
    "reason_sha256",
    "source_commit",
    "source_tree",
    "policy_sha256"
  ],
  "prohibited_fields": [
    "authorization_header",
    "bearer_token",
    "client_private_key",
    "customer_request_body",
    "customer_response_body",
    "secret_data"
  ]
}
