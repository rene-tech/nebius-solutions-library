{
  "schema": "fs2-serve.nebius.ai/sai20-bootstrap-guard/v5",
  "protected_names": [
    "fs2-database-authority-bootstrap-guard-binding-v5",
    "fs2-database-authority-bootstrap-guard-v5",
    "fs2-database-authority-object-custody-binding-v4",
    "fs2-database-authority-object-custody-v4",
    "fs2-database-exact-owner-binding-v4",
    "fs2-database-exact-owner-v4",
    "fs2-database-ingress-exact-spec-binding-v4",
    "fs2-database-ingress-exact-spec-v4",
    "fs2-database-peer-identity-binding-v5",
    "fs2-database-peer-identity-v5",
    "fs2-database-policy-freeze-binding-v4",
    "fs2-database-policy-freeze-v4"
  ],
  "policy": {
    "name": "fs2-database-authority-bootstrap-guard-v5",
    "spec": {
      "failurePolicy": "Fail",
      "matchConstraints": {
        "matchPolicy": "Equivalent",
        "resourceRules": [
          {
            "apiGroups": [
              "admissionregistration.k8s.io"
            ],
            "apiVersions": [
              "v1"
            ],
            "operations": [
              "CREATE",
              "UPDATE",
              "DELETE"
            ],
            "resources": [
              "validatingadmissionpolicies",
              "validatingadmissionpolicybindings"
            ],
            "scope": "Cluster"
          }
        ]
      },
      "variables": [
        {
          "expression": "request.operation == 'DELETE' ? oldObject.metadata : object.metadata",
          "name": "targetMetadata"
        },
        {
          "expression": "variables.targetMetadata.name in ${protected_names_json}",
          "name": "protectedObject"
        },
        {
          "expression": "request.userInfo.username == ${executor_username_json} && request.userInfo.groups.size() == ${executor_group_count} && request.userInfo.groups.all(group, group in ${executor_groups_json}) && ((${executor_extra_json} == {} && !has(request.userInfo.extra)) || (has(request.userInfo.extra) && request.userInfo.extra == ${executor_extra_json}))",
          "name": "custodian"
        }
      ],
      "validations": [
        {
          "expression": "!variables.protectedObject || request.operation != 'DELETE'",
          "message": "SAI-20 bootstrap and successor authority objects are non-deletable",
          "reason": "Forbidden"
        },
        {
          "expression": "!variables.protectedObject || variables.custodian",
          "message": "SAI-20 bootstrap and successor authority mutation requires the exact externally enrolled custodian",
          "reason": "Forbidden"
        }
      ]
    }
  },
  "binding": {
    "name": "fs2-database-authority-bootstrap-guard-binding-v5",
    "spec": {
      "matchResources": {
        "matchPolicy": "Equivalent"
      },
      "policyName": "fs2-database-authority-bootstrap-guard-v5",
      "validationActions": [
        "Deny"
      ]
    }
  }
}
