# Copy to a mode-0600 run directory outside Git. Never put secret values here.
kubeconfig_path = "/absolute/run-scoped/path/kubeconfig"
run_root        = "/absolute/run-scoped/path"
run_id           = "rreplace01"
cluster_id       = "mk8scluster-REPLACE"
cluster_name     = "fs2-disposable-rreplace01"
kube_context     = "fs2-disposable-rreplace01"
kube_system_uid  = "00000000-0000-0000-0000-000000000000"
project_id       = "project-REPLACE-WITH-EXACT-APPROVED-ID"

# Public-edge releases also require a separate mode-0600, <=15-minute
# bootstrap kubeconfig plus release/runtime credentials no longer than eight
# hours. Their common validity must extend beyond bootstrap expiry by
# `minimum_rollback_seconds` (7200 by default).
# Supply the three current and two prior exact userInfo tuples, including UID,
# sorted groups/extras and cryptographically verified expiry. Principals are
# derived from distinct prior/current/successor epochs; callers cannot choose a
# stable username. The prior credentials remain unexpired during the plan-time
# proof: on a fresh rotation the prior runtime owner must still have its exact
# current authority and the prior bootstrap may retain only the imported,
# exact-name cluster and namespace binding-rotation roles. It remains denied
# protected-object mutation. A retry may contain only exact prior/target
# binding states with matching permissions. An
# apply-deferred postflight requires both prior credentials to be denied after
# the binding rotation.
# Supply the recovery-signed v3 subject inventory plus the separately signed,
# mode-0600 provider/IAM snapshot named by
# `security_subject_provider_snapshot_path`. Callers cannot supply the provider
# key, tenant or query. External security pins them in the root-owned, mode-0400
# `/etc/fs2/security/network-policy-provider-trust-anchor-v3.json`, including
# exact adapter/CLI/config/credential hashes, parsed profile-to-credential
# paths, provider endpoint and issuer, non-human principal, its sole exact
# read-only IAM role, and Kubernetes issuer/audience/claim mapping. The snapshot
# verification key lives in the separate root-owned collection-authority file
# whose digest is pinned by the trust anchor; its private signing key remains
# outside both documents. The adapter clears inherited environment state
# and enumerates provider whoami, the directory-reader service account's
# complete group-membership closure, every direct/group-inherited binding and
# referenced role, plus users, groups and memberships directly; it never
# accepts a caller-provided transcript. Effective permissions and authorization
# evidence must be exact and byte-identical across two collections. The
# provider receipt includes the raw responses for two byte-identical complete
# bounded pagination sweeps. Preflight executes the pinned adapter again and
# requires the fresh output to match, then has the selected API server
# authenticate the fixed root-owned OIDC probe through TokenReview. The
# recovery-signed inventory must match
# its users/groups and provenance byte-for-byte. Trust, authority, provider
# snapshot and inventory must remain valid through bootstrap expiry plus the
# configured rollback floor; the adapter TTL is exactly 10800-28800 seconds.
# Bootstrap paginates every live Namespace, ServiceAccount, Role,
# RoleBinding, ClusterRole, ClusterRoleBinding and CSR twice, includes every
# bound User/Group/ServiceAccount in the authorization closure, derives named targets from every RBAC rule, then
# checks exact token, signer, impersonation, namespace/finalize and exhaustive
# RBAC-delegation denial, then repeats the complete double inventory after all
# SubjectAccessReviews and requires exact equality.
# The bootstrap credential only updates the externally preprovisioned permanent
# boundary and is expired before workloads may plan; the runtime owner has only
# exact-name protected-object mutation and no RBAC binding update authority.
# Every rotation advances prior/current/successor epochs. The prior applied
# RoleBindings preauthorize the current runtime owner and <=15-minute bootstrap;
# the desired bindings retain only the new current runtime owner and next
# successor identities. External security must first preprovision the exact
# stable role definitions and initial bindings; declarative import adopts them.
# Dedicated cluster and namespace bootstrap bindings authorize only exact-name
# subject rotation, with prior/current bootstraps as bounded pre-apply subjects. The desired
# binding retains current/successor bootstraps for exact binding rotation and
# refresh-only crash retry; it cannot mutate Roles or protected runtime state.
# Mutation bindings still retire the prior/current bootstrap authority.
# Bootstrap is permitted exact-name update but not create or delete, and
# postflight binds exact object UID/RV/spec state.
# All credential, snapshot and key files are immutable within the current epoch
# directory. External security automation precreates the socket parent as
# enforcer-UID:peer-GID mode 02710; no process needs CAP_CHOWN.

# Pass the exact infra-disposable `target_contract` output. It is required and
# authoritative for project, region, network, tenant, and source-registry
# identity; the deployment workflow renders it automatically.
# Pass the exact `accelerator_pool_contract` output. It is the required,
# authoritative v2 accelerator identity/capacity input. The deployment workflow
# renders it automatically; do not retype it. `infrastructure_contract` is an
# optional B300-only v1 compatibility proof; if supplied, pass the exact
# infra-disposable output documented by the legacy profile example.

# This is a reference to an externally created Secret, never credential data.
grafana_admin_secret_ref = {
  name         = "fs2-grafana-admin"
  user_key     = "admin-user"
  password_key = "admin-password"
}

# Generated from deployment.observability.alertmanager by inference-stack.
# Alertmanager remains private; Grafana is its authenticated operator surface.
alertmanager = {
  enabled   = false
  retention = "120h"
  storage = {
    storage_class_name = "compute-csi-default-sc"
    size_gib           = 10
  }
}

# Fresh disposable bootstrap only. Supply through a separate mode-0600 tfvars
# file; values enter local Terraform state and are destroyed with the run.
# bootstrap_grafana_credentials = {
#   username = "admin"
#   password = "replace-with-a-long-random-value"
# }
