# Copy to a mode-0600 run directory outside Git. Never put secret values here.
kubeconfig_path = "/absolute/run-scoped/path/kubeconfig"
run_root        = "/absolute/run-scoped/path"
run_id           = "rreplace01"
cluster_id       = "mk8scluster-REPLACE"
cluster_name     = "fs2-disposable-rreplace01"
kube_context     = "fs2-disposable-rreplace01"
kube_system_uid  = "00000000-0000-0000-0000-000000000000"
project_id       = "project-REPLACE-WITH-EXACT-APPROVED-ID"

# Public-edge releases also require a separate mode-0600, <=15-minute
# bootstrap kubeconfig plus release/runtime credentials no longer than eight
# hours. Their common validity must extend beyond bootstrap expiry by
# `minimum_rollback_seconds` (7200 by default).
# Supply all three exact `kubectl auth whoami -o json` userInfo tuples (release,
# security owner, bootstrap), including UID, sorted groups/extras and the
# credential's cryptographically verified expiry, in the private tfvars file.
# Supply the complete externally signed `security_subject_inventory`; an
# operator-entered `denied_human_subjects` list is rejected. The inventory pins
# this API-server hash and kube-system UID, names every human user/group, and is
# valid through the rollback window. Bootstrap performs explicit
# SubjectAccessReviews for protected mutation, namespace/finalize, token,
# impersonation and delegation.
# The bootstrap credential creates the permanent boundary but is expired before
# workloads may plan; the runtime owner has only exact-name get/patch/update.
# Every rotation uses a new `identity_epoch` and new immutable credential/key
# files under that epoch directory. External security automation precreates the
# socket parent as enforcer-UID:peer-GID mode 02710; no process needs CAP_CHOWN.

# Pass the exact infra-disposable `target_contract` output. It is required and
# authoritative for project, region, network, tenant, and source-registry
# identity; the deployment workflow renders it automatically.
# Pass the exact `accelerator_pool_contract` output. It is the required,
# authoritative v2 accelerator identity/capacity input. The deployment workflow
# renders it automatically; do not retype it. `infrastructure_contract` is an
# optional B300-only v1 compatibility proof; if supplied, pass the exact
# infra-disposable output documented by the legacy profile example.

# This is a reference to an externally created Secret, never credential data.
grafana_admin_secret_ref = {
  name         = "fs2-grafana-admin"
  user_key     = "admin-user"
  password_key = "admin-password"
}

# Generated from deployment.observability.alertmanager by inference-stack.
# Alertmanager remains private; Grafana is its authenticated operator surface.
alertmanager = {
  enabled   = false
  retention = "120h"
  storage = {
    storage_class_name = "compute-csi-default-sc"
    size_gib           = 10
  }
}

# Fresh disposable bootstrap only. Supply through a separate mode-0600 tfvars
# file; values enter local Terraform state and are destroyed with the run.
# bootstrap_grafana_credentials = {
#   username = "admin"
#   password = "replace-with-a-long-random-value"
# }
