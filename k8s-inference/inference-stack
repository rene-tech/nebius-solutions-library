) -> Path:
    variables = dict(contract["stages"]["infrastructure"])
    variables["source_commit"] = commit
    variables["nebius_profile"] = nebius_profile
    path = run_root / "infrastructure.tfvars.json"
    private_json(path, variables)
    return path


def ensure_kubeconfig(
    *,
    nebius: str,
    nebius_profile: str,
    kubectl: str,
    run_root: Path,
    cluster_id: str,
    cluster_name: str,
) -> tuple[Path, str]:
    kubeconfig = run_root / "kubeconfig"
    if kubeconfig.is_symlink():
        raise DeploymentError(f"kubeconfig path must not be a symlink: {kubeconfig}")
    environment = clean_environment()
    environment["KUBECONFIG"] = str(kubeconfig)
    run(
        [
            nebius,
            "--profile",
            nebius_profile,
            "mk8s",
            "cluster",
            "get-credentials",
            "--id",
            cluster_id,
            "--external",
            "--force",
            "--context-name",
            cluster_name,
        ],
        env=environment,
    )
    if not kubeconfig.is_file():
        raise DeploymentError("Nebius CLI did not create the run-scoped kubeconfig")
    kubeconfig.chmod(0o600)
    result = run(
        [
            kubectl,
            "--kubeconfig",
            str(kubeconfig),
            "--context",
            cluster_name,
            "get",
            "namespace",
            "kube-system",
            "-o",
            "jsonpath={.metadata.uid}",
        ],
        env=environment,
        capture=True,
    )
    uid = result.stdout.strip()
    if len(uid) < 20:
        raise DeploymentError("kube-system did not return a valid namespace UID")
    return kubeconfig, uid


def legacy_registry_delivery_contract(
    contract: Mapping[str, Any], target_contract: Mapping[str, Any]
) -> dict[str, Any]:
    """Upgrade an existing state whose target registry predates the v1 output."""
    registry = target_contract.get("source_registry")
    if not isinstance(registry, dict):
        raise DeploymentError(
            "the existing infrastructure state has neither a registry-delivery output nor a legacy target registry"
        )
    registry_id = str(registry.get("id", ""))
    fqdn = str(registry.get("fqdn", "")).rstrip("/")
    if not registry_id.startswith("registry-") or not fqdn:
        raise DeploymentError("the legacy infrastructure target registry is malformed")
    policy = contract["artifact_delivery"]
    target_region = contract["target"]["region"]
    cross_region_hosts = sorted(
        host
        for host in policy["source_hosts"]
        if (match := re.fullmatch(r"cr\.([a-z0-9-]+)\.nebius\.cloud", host))
        and match.group(1) != target_region
    )
    return {
        "schema": "fs2-serve.nebius.ai/registry-delivery/v1",
        "mode": policy["mode"],
        "repository_prefix": policy["repository_prefix"],
        "target_registry": {
            "id": registry_id,
            "project_id": registry.get("project_id", contract["target"]["project_id"]),
            "region": target_region,
            "fqdn": fqdn,
            "repository_root": f"{fqdn}/{registry_id.removeprefix('registry-')}",
        },
        "upstream": {
            "source_hosts": policy["source_hosts"],
            "nebius_registries": {},
        },
        "promotion_cross_region_required": bool(cross_region_hosts)
        and policy["mode"] == "regional-mirror",
        "runtime_cross_region_pull_required": bool(cross_region_hosts)
        and policy["mode"] == "direct-source",
        "cross_region_source_hosts": cross_region_hosts,
        "derived_from_legacy_state": True,
    }


def infrastructure_outputs(
    terraform: str,
    run_root: Path,
    contract: Mapping[str, Any],
    *,
    nebius: str,
    nebius_profile: str,
    kubectl: str,
) -> dict[str, Any]:
    environment = stage_environment(run_root, "infrastructure", contract)
    state, _, _ = stage_paths(run_root, "infrastructure")
    terraform_init(terraform, INFRA_ROOT, state, environment)
    cluster_id = terraform_json_output(terraform, INFRA_ROOT, "cluster_id", environment)
    cluster_name = terraform_json_output(
        terraform, INFRA_ROOT, "cluster_name", environment
    )
    kubeconfig, kube_system_uid = ensure_kubeconfig(
        nebius=nebius,
        nebius_profile=nebius_profile,
        kubectl=kubectl,
        run_root=run_root,
        cluster_id=cluster_id,
        cluster_name=cluster_name,
    )
    target_contract = terraform_json_output(
        terraform, INFRA_ROOT, "target_contract", environment
    )
    registry_delivery = terraform_optional_json_output(
        terraform, INFRA_ROOT, "registry_delivery_contract", environment
    )
    if registry_delivery is None:
        registry_delivery = legacy_registry_delivery_contract(contract, target_contract)
    reference_data_enabled = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("reference_data", {})
        .get("enabled")
        is True
    )
    reference_data_storage = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "reference_data_storage_contract", environment
        )
        if reference_data_enabled
        else None
    )
    reference_data_access = (
        terraform_optional_json_output(
            terraform,
            INFRA_ROOT,
            "reference_data_object_storage_access",
            environment,
        )
        if reference_data_enabled
        else None
    )
    reference_data_lifecycle = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "reference_data_lifecycle", environment
        )
        if reference_data_enabled
        else None
    )
    return {
        "run_root": str(run_root.resolve()),
        "nebius_profile": nebius_profile,
        "kubeconfig_path": str(kubeconfig.resolve()),
        "run_id": contract["run_id"],
        "cluster_id": cluster_id,
        "cluster_name": cluster_name,
        "kube_context": cluster_name,
        "kube_system_uid": kube_system_uid,
        "project_id": contract["target"]["project_id"],
        "target_contract": target_contract,
        "infrastructure_contract": terraform_optional_json_output(
            terraform, INFRA_ROOT, "infrastructure_contract", environment
        ),
        "accelerator_pool_contract": terraform_json_output(
            terraform, INFRA_ROOT, "accelerator_pool_contract", environment
        ),
        "registry_delivery_contract": registry_delivery,
        "public_edge_contract": terraform_json_output(
            terraform, INFRA_ROOT, "public_edge_contract", environment
        ),
        "reference_data_storage_contract": reference_data_storage,
        "reference_data_object_storage_access": reference_data_access,
        "reference_data_lifecycle": reference_data_lifecycle,
    }


def write_downstream_variables(
    run_root: Path,
    contract: Mapping[str, Any],
    dynamic: Mapping[str, Any],
) -> tuple[Path, Path]:
    identity_keys = (
        "run_root",
        "kubeconfig_path",
        "run_id",
        "cluster_id",
        "cluster_name",
        "kube_context",
        "kube_system_uid",
        "project_id",
        "target_contract",
        "infrastructure_contract",
        "accelerator_pool_contract",
    )
    identity = {key: dynamic[key] for key in identity_keys}
    foundation = {**contract["stages"]["foundation"], **identity}
    workloads = {
        **rewritten_workloads(contract, dynamic),
        **identity,
        "nebius_profile": dynamic.get("nebius_profile", "sandbox"),
        "public_edge_contract": dynamic["public_edge_contract"],
    }
    reference_data = workloads.get("reference_data")
    if isinstance(reference_data, Mapping):
        enabled = reference_data.get("enabled") is True
        storage_contract = dynamic.get("reference_data_storage_contract")
        object_access = dynamic.get("reference_data_object_storage_access")
        if enabled and (
            not isinstance(storage_contract, Mapping)
            or not isinstance(object_access, Mapping)
        ):
            raise DeploymentError(
                "enabled reference data requires complete infrastructure storage and object-access outputs"
            )
        workloads["reference_data"] = {
            **reference_data,
            "storage_contract": storage_contract if enabled else None,
            "object_storage_access": object_access if enabled else None,
        }
    admin_contract = contract.get("admin_configuration", {})
    if isinstance(admin_contract, Mapping) and admin_contract.get("enabled") is True:
        configuration, configuration_sha256, scaling = derived_admin_configuration(
            contract,
            dynamic,
            workloads,
        )
        workloads.update(
            {
                "admin_configuration": configuration,
                "admin_configuration_sha256": configuration_sha256,
                "model_scaling_overrides": scaling,
            }
        )
    if foundation["grafana_publication"]["enabled"]:
        edge = dynamic["public_edge_contract"]
        origin = edge.get("public_origin")
        parsed = urlsplit(origin or "")
        if (
            edge.get("mode") != "public"
            or parsed.scheme != "https"
            or not parsed.hostname
            or parsed.path not in ("", "/")
            or parsed.query
            or parsed.fragment
            or parsed.username
            or parsed.password
        ):
            raise DeploymentError(
                "external Grafana publication requires an exact HTTPS public origin from the infrastructure output"
            )
        origin = origin.rstrip("/")
        foundation["grafana_publication"] = {
            **foundation["grafana_publication"],
            "external_base_url": origin,
        }
        workloads["admin_observability_links"] = {
            "allowed_hosts": [parsed.hostname],
            "grafana": {
                "url": f"{origin}/admin/observability/grafana",
                "verified_external_route": True,
            },
            "prometheus": {
                "url": f"{origin}/admin/observability/grafana/explore",
                "verified_external_route": True,
            },
            "loki": {
                "url": f"{origin}/admin/observability/grafana/explore",
                "verified_external_route": True,
            },
            "otel": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "dcgm": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "kueue": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "keda": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "alertmanager": {"url": "", "verified_external_route": False},
            "tempo": {"url": "", "verified_external_route": False},
        }
    foundation_path = run_root / "foundation.tfvars.json"
    workloads_path = run_root / "workloads.tfvars.json"
    private_json(foundation_path, foundation)
    private_json(workloads_path, workloads)
    return foundation_path, workloads_path


def plan_stage(
    terraform: str,
    *,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
    variable_file: Path,
    destroy: bool = False,
) -> tuple[Path, dict[str, Any], dict[str, str]]:
    root = stage_root(stage)
    state, _, _ = stage_paths(run_root, stage)
    environment = stage_environment(
        run_root,
        stage,
        contract,
        include_secrets=not destroy,
    )
    terraform_init(terraform, root, state, environment)
    suffix = "destroy" if destroy else "plan"
    plan_path = run_root / f"{stage}-{suffix}.tfplan"
    document = plan_json(
        terraform,
        root=root,
        environment=environment,
        variable_file=variable_file,
        plan_path=plan_path,
        json_path=run_root / f"{stage}-{suffix}.plan.json",
        destroy=destroy,
    )
    return plan_path, document, environment


def apply_plan(
    terraform: str,
    root: Path,
    plan_path: Path,
    environment: Mapping[str, str],
) -> None:
    run(
        [terraform, f"-chdir={root}", "apply", "-input=false", str(plan_path)],
        env=environment,
    )


def workload_endpoint_outputs(
    terraform: str,
    run_root: Path,
    contract: Mapping[str, Any],
) -> dict[str, Any]:
    """Read all non-secret, customer-facing workload endpoints."""
    environment = stage_environment(
        run_root, "workloads", contract, include_secrets=False
    )
    outputs = {
        "mcp_endpoint_url": terraform_json_output(
            terraform, WORKLOADS_ROOT, "mcp_endpoint_url", environment
        ),
        "admin_web_interface_url": terraform_json_output(
            terraform, WORKLOADS_ROOT, "admin_web_interface_url", environment
        ),
        "inference_base_url": terraform_json_output(
            terraform, WORKLOADS_ROOT, "inference_base_url", environment
        ),
        "grafana_url": terraform_optional_json_output(
            terraform, WORKLOADS_ROOT, "grafana_url", environment
        ),
    }
    reference_enabled = (
        contract.get("stages", {})
        .get("workloads", {})
        .get("reference_data", {})
        .get("enabled")
        is True
    )
    outputs["reference_data"] = (
        terraform_optional_json_output(
            terraform, WORKLOADS_ROOT, "reference_data_status", environment
        )
        if reference_enabled
        else None
    )
    outputs["reference_data_contract"] = (
        terraform_optional_json_output(
            terraform, WORKLOADS_ROOT, "reference_data_contract", environment
        )
        if reference_enabled
        else None
    )
    return outputs


def workload_access_bundle(
    terraform: str,
    run_root: Path,
    contract: Mapping[str, Any],
) -> dict[str, Any]:
    """Read the explicit sensitive connection bundle from workloads state."""

    environment = stage_environment(
        run_root, "workloads", contract, include_secrets=False
    )
    bundle = terraform_json_output(
        terraform, WORKLOADS_ROOT, "access_bundle", environment
    )
    if not isinstance(bundle, dict) or bundle.get("schema") != "fs2-serve.nebius.ai/access-bundle/v1":
        raise DeploymentError("the workloads access bundle is missing or malformed")

    cluster = bundle.get("cluster")
    endpoints = bundle.get("endpoints")
    credentials = bundle.get("credentials")
    mcp_access = bundle.get("mcp_access")
    reference_data = bundle.get("reference_data")
    reference_data_contract = bundle.get("reference_data_contract")
    if not all(
        isinstance(value, dict)
        for value in (cluster, endpoints, credentials, mcp_access)
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")

    def has_non_empty_strings(document: Mapping[str, Any], fields: tuple[str, ...]) -> bool:
        return all(
            isinstance(document.get(field), str) and bool(document[field].strip())
            for field in fields
        )

    if not has_non_empty_strings(
        cluster,
        (
            "project_id",
            "region",
            "cluster_id",
            "cluster_name",
            "kube_context",
            "kubeconfig_command",
        ),
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    if not has_non_empty_strings(endpoints, ("mcp_url", "inference_base_url")):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    if any(
        key not in endpoints
        or (endpoints[key] is not None and not isinstance(endpoints[key], str))
        for key in ("admin_portal_url", "grafana_url")
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")

    shared_token = credentials.get("mcp_inference_token")
    if (
        not has_non_empty_strings(
            credentials,
            ("admin_bootstrap_token", "mcp_inference_token", "inference_access_token"),
        )
        or credentials.get("inference_access_token") != shared_token
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    grafana = credentials.get("grafana")
    if not isinstance(grafana, dict) or not has_non_empty_strings(
        grafana, ("username", "password")
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    scopes = mcp_access.get("scopes")
    if (
        not has_non_empty_strings(
            mcp_access, ("principal_id", "tenant_id")
        )
        or not isinstance(scopes, list)
        or not {"mcp.invoke", "inference.invoke"}.issubset(scopes)
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    if reference_data is not None:
        if not isinstance(reference_data, dict) or not has_non_empty_strings(
            reference_data,
            ("filesystem_id", "bucket_id", "bucket_name", "cpu_pool_id"),
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
        lifecycle = reference_data.get("lifecycle")
        if (
            not isinstance(lifecycle, dict)
            or lifecycle.get("retention_mode") not in {"retain", "disposable"}
            or (
                lifecycle.get("retention_mode") == "retain"
                and (
                    lifecycle.get("destroy_status")
                    != "partial-destroy-requires-adoption"
                    or lifecycle.get("destroy_completion")
                    != "downstream-only-infrastructure-retained"
                    or lifecycle.get("adoption_status")
                    != "ids-exported-for-explicit-state-adoption"
                )
            )
            or (
                lifecycle.get("retention_mode") == "disposable"
                and (
                    lifecycle.get("destroy_status")
                    != "eligible-only-while-bucket-empty"
                    or lifecycle.get("destroy_completion")
                    != "full-only-when-versioned-bucket-empty"
                )
            )
            or not isinstance(reference_data.get("pipeline"), (dict, type(None)))
            or not isinstance(reference_data.get("status_service"), (str, type(None)))
            or not isinstance(reference_data_contract, dict)
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
        storage = reference_data_contract.get("storage")
        plane = reference_data_contract.get("plane")
        if (
            not isinstance(storage, dict)
            or not isinstance(plane, dict)
            or storage.get("filesystem", {}).get("id")
            != reference_data["filesystem_id"]
            or storage.get("object_storage", {}).get("id")
            != reference_data["bucket_id"]
            or storage.get("object_storage", {}).get("name")
            != reference_data["bucket_name"]
            or storage.get("cpu_pool", {}).get("id")
            != reference_data["cpu_pool_id"]
            or plane.get("status_service") != reference_data["status_service"]
            or plane.get("pipeline") != reference_data["pipeline"]
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
    elif reference_data_contract is not None:
        raise DeploymentError("the workloads access bundle is missing or malformed")
    return bundle


def state_ready(
    terraform: str,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
) -> bool:
    state, _, _ = stage_paths(run_root, stage)
    if not state.exists():
        return False
    environment = stage_environment(run_root, stage, contract, include_secrets=False)
    terraform_init(terraform, stage_root(stage), state, environment)
    result = subprocess.run(
        [
            terraform,
            f"-chdir={stage_root(stage)}",
            "output",
            "-json",
            STAGE_COMPLETION_OUTPUTS[stage],
        ],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return False
    try:
        return json.loads(result.stdout) is not None
    except json.JSONDecodeError:
        return False


def state_has_resources(
    terraform: str,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
) -> bool:
    state, _, _ = stage_paths(run_root, stage)
    if not state.exists():
        return False
    environment = stage_environment(run_root, stage, contract, include_secrets=False)
    terraform_init(terraform, stage_root(stage), state, environment)
    return bool(state_addresses(terraform, stage_root(stage), environment))


def apply_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
    configuration_environment: Mapping[str, str],
) -> None:
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="infrastructure",
        contract=contract,
        variable_file=infrastructure_variables,
    )
    apply_plan(args.terraform, INFRA_ROOT, plan_path, environment)

    dynamic = infrastructure_outputs(
        args.terraform,
        run_root,
        contract,
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
    )
    mirror_selected_images(args, run_root, contract, dynamic)
    foundation_variables, workloads_variables = write_downstream_variables(
        run_root, contract, dynamic
    )

    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="foundation",
        contract=contract,
        variable_file=foundation_variables,
    )
    apply_plan(args.terraform, FOUNDATION_ROOT, plan_path, environment)

    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="workloads",
        contract=contract,
        variable_file=workloads_variables,
    )
    apply_plan(args.terraform, WORKLOADS_ROOT, plan_path, environment)

    # Record the accepted root contract after all of its staged consumers converge.
    apply_plan(
        args.terraform,
        DEPLOY_ROOT,
        run_root / "configuration.tfplan",
        configuration_environment,
    )

    endpoints = workload_endpoint_outputs(args.terraform, run_root, contract)
    print(json.dumps({"status": "applied", **endpoints}, indent=2))


def plan_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    if not state_ready(args.terraform, run_root, "infrastructure", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="infrastructure",
            contract=contract,
            variable_file=infrastructure_variables,
        )
        print(
            "Planned infrastructure. Apply it before foundation can be planned against the new API server."
        )
        return

    _, infrastructure_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="infrastructure",
        contract=contract,
        variable_file=infrastructure_variables,
    )
    if plan_changes_managed_resources_or_outputs(infrastructure_plan):
        print(
            "Planned infrastructure changes. Apply infrastructure and rerun plan before planning foundation."
        )
        return

    dynamic = infrastructure_outputs(
        args.terraform,
        run_root,
        contract,
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
    )
    if "artifact_delivery" not in dynamic["accelerator_pool_contract"]:
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="infrastructure",
            contract=contract,
            variable_file=infrastructure_variables,
        )
        print(
            "Planned the registry-delivery contract upgrade. Apply infrastructure before planning downstream stages."
        )
        return
    foundation_variables, workloads_variables = write_downstream_variables(
        run_root, contract, dynamic
    )
    if not state_ready(args.terraform, run_root, "foundation", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="foundation",
            contract=contract,
            variable_file=foundation_variables,
        )
        print("Planned foundation. Apply it before custom resources can be planned.")
        return

    _, foundation_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="foundation",
        contract=contract,
        variable_file=foundation_variables,
    )
    if plan_changes_managed_resources_or_outputs(foundation_plan):
        print(
            "Planned foundation changes. Apply foundation and rerun plan before planning workloads."
        )
        return

    if not state_ready(args.terraform, run_root, "workloads", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="workloads",
            contract=contract,
            variable_file=workloads_variables,
        )
        print("Planned workloads.")
        return

    plan_stage(
        args.terraform,
        run_root=run_root,
        stage="workloads",
        contract=contract,
        variable_file=workloads_variables,
    )
    print("Planned all three existing states after upstream handoffs converged.")


def destroy_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    reference_infrastructure = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("reference_data", {})
    )
    retained_mode = (
        isinstance(reference_infrastructure, Mapping)
        and reference_infrastructure.get("enabled") is True
        and reference_infrastructure.get("lifecycle", {}).get("retention_mode")
        == "retain"
    )
    resources = {
        stage: state_has_resources(args.terraform, run_root, stage, contract)
        for stage in ("infrastructure", "foundation", "workloads")
    }
    retain_infrastructure = retained_mode and resources["infrastructure"]
    infrastructure_variables = (
        None
        if retain_infrastructure
        else write_infrastructure_variables(
            run_root, contract, commit, args.nebius_profile
        )
    )
    cached_foundation = run_root / "foundation.tfvars.json"
    cached_workloads = run_root / "workloads.tfvars.json"
    downstream: tuple[Path, Path] | None = None
    dynamic: dict[str, Any] | None = None
    if retain_infrastructure:
        if not state_ready(args.terraform, run_root, "infrastructure", contract):
            raise DeploymentError(
                "retained reference infrastructure exists but its completion output "
                "is unavailable; no resource was changed"
            )
        dynamic = infrastructure_outputs(
            args.terraform,
            run_root,
            contract,
            nebius=args.nebius,
            nebius_profile=args.nebius_profile,
            kubectl=args.kubectl,
        )
        if not isinstance(dynamic.get("reference_data_storage_contract"), Mapping):
            raise DeploymentError(
                "retained reference infrastructure is missing its non-secret storage "
                "contract; no resource was changed"
            )
        if not isinstance(dynamic.get("reference_data_lifecycle"), Mapping):
            raise DeploymentError(
                "retained reference infrastructure is missing its lifecycle output; "
                "no resource was changed"
            )
    if resources["foundation"] or resources["workloads"]:
        if (
            cached_foundation.is_file()
            and not cached_foundation.is_symlink()
            and cached_workloads.is_file()
            and not cached_workloads.is_symlink()
        ):
            downstream = (cached_foundation, cached_workloads)
        elif state_ready(args.terraform, run_root, "infrastructure", contract):
            if dynamic is None:
                dynamic = infrastructure_outputs(
                    args.terraform,
                    run_root,
                    contract,
                    nebius=args.nebius,
                    nebius_profile=args.nebius_profile,
                    kubectl=args.kubectl,
                )
            downstream = write_downstream_variables(run_root, contract, dynamic)
        else:
            raise DeploymentError(
                "downstream resources exist but their private generated tfvars and a complete infrastructure handoff are both unavailable"
            )

    retained_workload_outputs: dict[str, Any] = {
        "reference_data": None,
        "reference_data_contract": None,
    }
    if (
        retain_infrastructure
        and resources["workloads"]
        and state_ready(args.terraform, run_root, "workloads", contract)
    ):
        retained_workload_outputs = workload_endpoint_outputs(
            args.terraform, run_root, contract
        )

    destroy_order: tuple[tuple[str, Path | None], ...] = (
        ("workloads", downstream[1] if downstream else None),
        ("foundation", downstream[0] if downstream else None),
    )
    if not retain_infrastructure:
        destroy_order += (("infrastructure", infrastructure_variables),)

    destroyed_stages: list[str] = []
    for stage, variable_file in destroy_order:
        if not resources[stage]:
            continue
        if variable_file is None:
            raise DeploymentError(
                f"cannot destroy {stage}: its generated private variable file is unavailable"
            )
        plan_path, _, environment = plan_stage(
            args.terraform,
            run_root=run_root,
            stage=stage,
            contract=contract,
            variable_file=variable_file,
            destroy=True,
        )
        apply_plan(args.terraform, stage_root(stage), plan_path, environment)
        destroyed_stages.append(stage)

    if retain_infrastructure:
        assert dynamic is not None
        storage = dynamic["reference_data_storage_contract"]
        lifecycle = dynamic["reference_data_lifecycle"]
        applied_status = retained_workload_outputs.get("reference_data")
        applied_contract = retained_workload_outputs.get("reference_data_contract")
        last_applied_status_service = (
            applied_status.get("status_service")
            if isinstance(applied_status, Mapping)
            else None
        )
        last_applied_pipeline = (
            applied_status.get("pipeline")
            if isinstance(applied_status, Mapping)
            else None
        )
        last_applied_plane = (
            applied_contract.get("plane")
            if isinstance(applied_contract, Mapping)
            else None
        )
        reference_data = {
            "lifecycle": lifecycle,
            "filesystem_id": storage.get("filesystem", {}).get("id"),
            "bucket_id": storage.get("object_storage", {}).get("id"),
            "bucket_name": storage.get("object_storage", {}).get("name"),
            "cpu_pool_id": storage.get("cpu_pool", {}).get("id"),
            "status_service": None,
            "pipeline": None,
            "last_applied": {
                "status_service": last_applied_status_service,
                "pipeline": last_applied_pipeline,
            },
        }
        reference_data_contract = {
            "storage": storage,
            "plane": None,
            "last_applied_plane": last_applied_plane,
        }
        receipt_path = run_root / "reference-data-retention.json"
        result = {
            "schema": "fs2-serve.nebius.ai/destroy-result/v1",
            "status": "partial-destroy",
            "completion": "downstream-destroyed-infrastructure-retained",
            "destroyed_stages": destroyed_stages,
            "retained_stages": ["infrastructure"],
            "reference_data": reference_data,
            "reference_data_contract": reference_data_contract,
            "adoption": {
                "required_before_full_destroy": True,
                "status": lifecycle.get("adoption_status"),
                "receipt_path": str(receipt_path),
                "next_step": (
                    "adopt or migrate the retained filesystem and bucket into a "
                    "separate durable Terraform state before destroying infrastructure"
                ),
            },
        }
        private_json(receipt_path, result)
        print(json.dumps(result, indent=2))
        return

    print(
        json.dumps(
            {
                "schema": "fs2-serve.nebius.ai/destroy-result/v1",
                "status": "destroyed",
                "completion": "complete",
                "destroyed_stages": destroyed_stages,
                "retained_stages": [],
                "reference_data": None,
                "reference_data_contract": None,
                "evidence_root": str(run_root),
            },
            indent=2,
        )
    )


def status_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    stages: dict[str, Any] = {}
    workloads_ready = False
    infrastructure_reference_data: Any | None = None
    infrastructure_reference_data_contract: Any | None = None
    for stage in ("infrastructure", "foundation", "workloads"):
        state, _, _ = stage_paths(run_root, stage)
        if not state.exists():
            stages[stage] = {"state": "absent", "addresses": 0, "complete": False}
            continue
        environment = stage_environment(
            run_root, stage, contract, include_secrets=False
        )
        terraform_init(args.terraform, stage_root(stage), state, environment)
        addresses = state_addresses(args.terraform, stage_root(stage), environment)
        complete = state_ready(args.terraform, run_root, stage, contract)
        stages[stage] = {
            "state": "ready" if complete else ("partial" if addresses else "empty"),
            "addresses": len(addresses),
            "complete": complete,
        }
        if stage == "workloads":
            workloads_ready = complete
        if (
            stage == "infrastructure"
            and complete
            and contract.get("stages", {})
            .get("infrastructure", {})
            .get("reference_data", {})
            .get("enabled")
            is True
        ):
            storage = terraform_optional_json_output(
                args.terraform,
                INFRA_ROOT,
                "reference_data_storage_contract",
                environment,
            )
            if isinstance(storage, Mapping):
                lifecycle = terraform_optional_json_output(
                    args.terraform,
                    INFRA_ROOT,
                    "reference_data_lifecycle",
                    environment,
                )
                infrastructure_reference_data = {
                    "lifecycle": (
                        lifecycle
                        if isinstance(lifecycle, Mapping)
                        else storage.get("lifecycle")
                    ),
                    "filesystem_id": storage.get("filesystem", {}).get("id"),
                    "bucket_id": storage.get("object_storage", {}).get("id"),
                    "bucket_name": storage.get("object_storage", {}).get("name"),
                    "cpu_pool_id": storage.get("cpu_pool", {}).get("id"),
                    "status_service": None,
                    "pipeline": None,
                }
                infrastructure_reference_data_contract = {
                    "storage": storage,
                    "plane": None,
                }
    endpoints = (
        workload_endpoint_outputs(args.terraform, run_root, contract)
        if workloads_ready
        else {
            "mcp_endpoint_url": None,
            "admin_web_interface_url": None,
            "inference_base_url": None,
            "grafana_url": None,
            "reference_data": None,
            "reference_data_contract": None,
        }
    )
    # A previously applied workloads state can remain otherwise complete while the
    # newly enabled reference-data module is intentionally held behind its own
    # review gate. Keep the normal status surface truthful in that transition:
    # report the live infrastructure identities and retained lifecycle until the
    # workload-owned status service and pipeline replace this fallback.
    if (
        endpoints["reference_data"] is None
        and infrastructure_reference_data is not None
    ):
        endpoints["reference_data"] = infrastructure_reference_data
    if (
        endpoints["reference_data_contract"] is None
        and infrastructure_reference_data_contract is not None
    ):
        endpoints["reference_data_contract"] = (
            infrastructure_reference_data_contract
        )
    print(
        json.dumps(
            {"run_root": str(run_root), "stages": stages, **endpoints},
            indent=2,
        )
    )


def output_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    """Print the intentionally requested sensitive post-apply access bundle."""
    if not state_ready(args.terraform, run_root, "workloads", contract):
        raise DeploymentError(
            "workloads are not applied; run inference-stack apply before requesting endpoints"
        )
    print(
        json.dumps(
            workload_access_bundle(args.terraform, run_root, contract),
            indent=2,
        )
    )


def internal_proxy_command(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> list[str]:
    """Build the non-secret command that serves an internal-only edge."""
    if not state_ready(args.terraform, run_root, "workloads", contract):
        raise DeploymentError(
            "workloads are not applied; run inference-stack apply before starting the proxy"
        )

    infrastructure_environment = stage_environment(
        run_root, "infrastructure", contract, include_secrets=False
    )
    infrastructure_state, _, _ = stage_paths(run_root, "infrastructure")
    terraform_init(
        args.terraform,
        INFRA_ROOT,
        infrastructure_state,
        infrastructure_environment,
    )
    cluster_id = terraform_json_output(
        args.terraform, INFRA_ROOT, "cluster_id", infrastructure_environment
    )
    cluster_name = terraform_json_output(
        args.terraform, INFRA_ROOT, "cluster_name", infrastructure_environment
    )
    public_edge = terraform_json_output(
        args.terraform,
        INFRA_ROOT,
        "public_edge_contract",
        infrastructure_environment,
    )
    kubeconfig, _ = ensure_kubeconfig(
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
        run_root=run_root,
        cluster_id=cluster_id,
        cluster_name=cluster_name,
    )

    if not isinstance(public_edge, dict) or public_edge.get("mode") != "internal-only":
        raise DeploymentError(
            "this deployment has a public edge and does not require an operator proxy"
        )
    port_forward = public_edge.get("port_forward")
    if not isinstance(port_forward, dict) or port_forward.get("enabled") is not True:
        raise DeploymentError("the Terraform port-forward contract is malformed")
    expected = {
        "bind_address": "127.0.0.1",
        "control_plane_service": "fs2-serve-control-plane",
        "control_plane_port": 8080,
        "admin_console_service": "fs2-serve-control-plane-admin-console",
        "admin_console_port": 8080,
    }
    if any(port_forward.get(key) != value for key, value in expected.items()):
        raise DeploymentError("the Terraform port-forward contract is unsupported")
    try:
        local_ports = [
            int(port_forward["control_plane_local_port"]),
            int(port_forward["admin_console_local_port"]),
            int(port_forward["operator_proxy_port"]),
        ]
    except (KeyError, TypeError, ValueError) as exc:
        raise DeploymentError(
            "the Terraform port-forward contract is malformed"
        ) from exc
    application_origin = f"http://localhost:{local_ports[2]}"
    operator_endpoint = f"http://127.0.0.1:{local_ports[2]}"
    if (
        port_forward.get("application_origin") != application_origin
        or port_forward.get("operator_endpoint") != operator_endpoint
    ):
        raise DeploymentError("the Terraform loopback origins do not match its ports")
    endpoints = workload_endpoint_outputs(args.terraform, run_root, contract)
    expected_endpoints = {
        "mcp_endpoint_url": f"{application_origin}/mcp",
        "admin_web_interface_url": f"{application_origin}/admin/",
    }
    if any(endpoints.get(key) != value for key, value in expected_endpoints.items()):
        raise DeploymentError(
            "the workload endpoint outputs do not match the edge contract"
        )

    return [
        sys.executable,
        str(INTERNAL_EDGE_PROXY),
        "--kubeconfig",
        str(kubeconfig),
        "--context",
        cluster_name,
        "--kubectl",
        args.kubectl,
        "--control-plane-local-port",
        str(local_ports[0]),
        "--admin-console-local-port",
        str(local_ports[1]),
        "--operator-proxy-port",
        str(local_ports[2]),
        "--mcp-endpoint-url",
        endpoints["mcp_endpoint_url"],
        "--admin-web-interface-url",
        endpoints["admin_web_interface_url"],
    ]


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Plan, apply, inspect, or destroy Kubernetes inference from one terraform.tfvars file."
    )
    parser.add_argument(
        "command",
        choices=(
            "validate",
            "preflight",
            "plan",
            "apply",
            "destroy",
            "status",
            "output",
            "proxy",
        ),
    )
    parser.add_argument(
        "--var-file",
        type=Path,
        default=DEPLOY_ROOT / "terraform.tfvars",
        help="customer terraform.tfvars file (default: k8s-inference/terraform.tfvars)",
    )
    parser.add_argument(
        "--run-root",
        type=Path,
        help="private state/evidence directory; defaults to an XDG state path bound to the tfvars path",
    )
    parser.add_argument("--terraform", default="terraform")
    parser.add_argument("--kubectl", default="kubectl")
    parser.add_argument("--nebius", default="nebius")
    parser.add_argument(
        "--crane",
        default="crane",
        help="OCI registry client used for digest-preserving regional mirrors",
    )
    parser.add_argument(
        "--nebius-profile",
        default=os.environ.get("NEBIUS_PROFILE", "sandbox"),
        help="authenticated Nebius CLI profile (default: NEBIUS_PROFILE or sandbox)",
    )
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    os.umask(0o077)
    args = parse_args(argv)
    variable_file = args.var_file.expanduser().resolve()
    if not variable_file.is_file():
        raise DeploymentError(
            f"configuration does not exist: {variable_file}; copy terraform.tfvars.example first"
        )
    run_root = (args.run_root or default_run_root(variable_file)).expanduser().resolve()
    private_directory(run_root)

    lock_path = run_root / ".inference-stack.lock"
    if lock_path.is_symlink():
        raise DeploymentError(f"lock path must not be a symlink: {lock_path}")
    with lock_path.open("a+", encoding="utf-8") as lock:
        lock_path.chmod(0o600)
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise DeploymentError(
                f"another inference-stack process owns {run_root}"
            ) from exc

        contract, configuration_environment = validate_configuration(
            args.terraform, variable_file, run_root
        )
        proxy_arguments: list[str] | None = None
        commit = source_commit()
        if args.command == "validate":
            validate_stage_roots(args.terraform, run_root)
            print(
                json.dumps(
                    {
                        "status": "valid",
                        "run_root": str(run_root),
                        "deployment": contract["name"],
                        "profiles": contract["profiles"],
                        "accelerator_pools": contract["selected_accelerator_pool_ids"],
                        "models": contract["selected_model_ids"],
                    },
                    indent=2,
                )
            )
        elif args.command == "preflight":
            preflight_accelerators(args, contract)
        elif args.command == "plan":
            plan_stack(args, run_root, contract, commit)
        elif args.command == "apply":
            require_deployable_images(contract)
            apply_stack(
                args,
                run_root,
                contract,
                commit,
                configuration_environment,
            )
        elif args.command == "destroy":
            destroy_stack(args, run_root, contract, commit)
        elif args.command == "output":
            output_stack(args, run_root, contract)
        elif args.command == "proxy":
            proxy_arguments = internal_proxy_command(args, run_root, contract)
        else:
            status_stack(args, run_root, contract)
    if proxy_arguments is not None:
        try:
            run(proxy_arguments, env=clean_environment())
        except KeyboardInterrupt:
            pass
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except DeploymentError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(2)
