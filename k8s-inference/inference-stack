        result = subprocess.run(
            command,
            env=clean_environment(),
            text=True,
            capture_output=True,
            check=False,
        )
        if result.returncode != 0:
            raise DeploymentError(f"cannot capture exhaustive {resource} custody census")
        try:
            document = json.loads(result.stdout)
            resource_version = document["metadata"]["resourceVersion"]
            items = document["items"]
        except (KeyError, TypeError, json.JSONDecodeError) as exc:
            raise DeploymentError(f"the {resource} custody census is malformed") from exc
        if not isinstance(resource_version, str) or not resource_version or not isinstance(items, list):
            raise DeploymentError(f"the {resource} custody census has no exact API identity")
        semantic_items = sorted(
            (_semantic_kubernetes_object(item) for item in items if isinstance(item, dict)),
            key=lambda item: (
                item.get("metadata", {}).get("namespace", ""),
                item.get("metadata", {}).get("name", ""),
            ),
        )
        if len(semantic_items) != len(items):
            raise DeploymentError(f"the {resource} custody census contains a non-object")
        return {
            "resource_version": resource_version,
            "items_sha256": hashlib.sha256(
                json.dumps(semantic_items, sort_keys=True, separators=(",", ":")).encode()
            ).hexdigest(),
            "items": items,
        }

    collections = {
        "cluster_roles": audited_collection("clusterroles.rbac.authorization.k8s.io", all_namespaces=False),
        "cluster_role_bindings": audited_collection("clusterrolebindings.rbac.authorization.k8s.io", all_namespaces=False),
        "roles": audited_collection("roles.rbac.authorization.k8s.io", all_namespaces=True),
        "role_bindings": audited_collection("rolebindings.rbac.authorization.k8s.io", all_namespaces=True),
    }
    census_claim = receipt.get("rbac_census")
    if not isinstance(census_claim, dict):
        raise DeploymentError("the authority receipt has no exhaustive RBAC census")
    for name, collection in collections.items():
        claim = census_claim.get(name)
        if not isinstance(claim, dict) or any(
            claim.get(field) != collection[field]
            for field in ("resource_version", "items_sha256")
        ):
            raise DeploymentError(f"the signed {name} census is stale")

    def grants_privileged_identity_or_workload_access(item: Mapping[str, Any]) -> bool:
        rules = item.get("rules", [])
        return isinstance(rules, list) and any(
            isinstance(rule, Mapping)
            and isinstance(rule.get("verbs"), list)
            and isinstance(rule.get("resources"), list)
            and isinstance(rule.get("apiGroups", []), list)
            and (
                (
                    any(verb in {"impersonate", "*"} for verb in rule["verbs"])
                    and any(
                        group in {"", "authentication.k8s.io", "*"}
                        for group in rule["apiGroups"]
                    )
                    and any(
                        resource
                        in {
                            "users",
                            "groups",
                            "serviceaccounts",
                            "uids",
                            "userextras",
                            "*",
                        }
                        or str(resource).startswith("userextras/")
                        for resource in rule["resources"]
                    )
                )
                or (
                    any(verb in {"bind", "escalate", "*"} for verb in rule["verbs"])
                    and any(
                        group in {"rbac.authorization.k8s.io", "*"}
                        for group in rule["apiGroups"]
                    )
                    and any(
                        resource in {"roles", "clusterroles", "*"}
                        for resource in rule["resources"]
                    )
                )
                or (
                    any(verb in {"approve", "sign", "*"} for verb in rule["verbs"])
                    and any(
                        group in {"certificates.k8s.io", "*"}
                        for group in rule["apiGroups"]
                    )
                    and any(
                        resource
                        in {
                            "certificatesigningrequests",
                            "certificatesigningrequests/approval",
                            "signers",
                            "*",
                        }
                        for resource in rule["resources"]
                    )
                )
                or (
                    any(
                        verb in {"create", "get", "list", "watch", "update", "patch", "*"}
                        for verb in rule["verbs"]
                    )
                    and (
                        (
                            any(group in {"", "*"} for group in rule["apiGroups"])
                            and any(
                                resource
                                in {"serviceaccounts/token", "secrets", "*"}
                                for resource in rule["resources"]
                            )
                        )
                        or (
                            any(
                                group in {"certificates.k8s.io", "*"}
                                for group in rule["apiGroups"]
                            )
                            and any(
                                resource in {"certificatesigningrequests", "*"}
                                for resource in rule["resources"]
                            )
                        )
                    )
                )
                or (
                    any(
                        verb
                        in {
                            "create",
                            "get",
                            "list",
                            "watch",
                            "update",
                            "patch",
                            "delete",
                            "deletecollection",
                            "*",
                        }
                        for verb in rule["verbs"]
                    )
                    and (
                        (
                            any(group in {"", "*"} for group in rule["apiGroups"])
                            and any(
                                resource
                                in {
                                    "pods",
                                    "pods/attach",
                                    "pods/ephemeralcontainers",
                                    "pods/exec",
                                    "pods/log",
                                    "pods/portforward",
                                    "pods/proxy",
                                    "replicationcontrollers",
                                    "replicationcontrollers/scale",
                                    "*",
                                }
                                for resource in rule["resources"]
                            )
                        )
                        or (
                            any(group in {"apps", "*"} for group in rule["apiGroups"])
                            and any(
                                resource
                                in {
                                    "daemonsets",
                                    "deployments",
                                    "deployments/scale",
                                    "replicasets",
                                    "replicasets/scale",
                                    "statefulsets",
                                    "statefulsets/scale",
                                    "*",
                                }
                                for resource in rule["resources"]
                            )
                        )
                        or (
                            any(group in {"batch", "*"} for group in rule["apiGroups"])
                            and any(
                                resource in {"cronjobs", "jobs", "*"}
                                for resource in rule["resources"]
                            )
                        )
                        or (
                            any(
                                group in {"jobset.x-k8s.io", "*"}
                                for group in rule["apiGroups"]
                            )
                            and any(
                                resource in {"jobsets", "*"}
                                for resource in rule["resources"]
                            )
                        )
                    )
                )
            )
            for rule in rules
        )

    capable_cluster_roles = sorted(
        item.get("metadata", {}).get("name")
        for item in collections["cluster_roles"]["items"]
        if grants_privileged_identity_or_workload_access(item)
    )
    capable_roles = sorted(
        f"{item.get('metadata', {}).get('namespace')}/{item.get('metadata', {}).get('name')}"
        for item in collections["roles"]["items"]
        if grants_privileged_identity_or_workload_access(item)
    )
    if (
        capable_cluster_roles != census_claim.get("privileged_capability_cluster_roles")
        or capable_roles != census_claim.get("privileged_capability_roles")
    ):
        raise DeploymentError(
            "the signed privileged identity, Secret-read, workload-mutation, and exec role census is incomplete"
        )
    bound_privileged_roles: list[str] = []
    privileged_bindings: list[dict[str, str]] = []
    for item in collections["cluster_role_bindings"]["items"]:
        role_ref = item.get("roleRef", {})
        if role_ref.get("kind") == "ClusterRole" and role_ref.get("name") in capable_cluster_roles:
            metadata = item.get("metadata", {})
            identifier = f"clusterrolebinding//{metadata.get('name')}"
            bound_privileged_roles.append(identifier)
            privileged_bindings.append(
                {
                    "kind": "ClusterRoleBinding",
                    "namespace": "",
                    "name": str(metadata.get("name", "")),
                    "role_ref": (
                        f"{role_ref.get('apiGroup', '')}/{role_ref.get('kind', '')}/"
                        f"{role_ref.get('name', '')}"
                    ),
                    "object_sha256": _json_sha256(
                        _semantic_kubernetes_object(item)
                    ),
                }
            )
    for item in collections["role_bindings"]["items"]:
        metadata = item.get("metadata", {})
        role_ref = item.get("roleRef", {})
        referenced = (
            role_ref.get("name")
            if role_ref.get("kind") == "ClusterRole"
            else f"{metadata.get('namespace')}/{role_ref.get('name')}"
        )
        capable = (
            referenced in capable_cluster_roles
            if role_ref.get("kind") == "ClusterRole"
            else referenced in capable_roles
        )
        if capable:
            identifier = f"rolebinding/{metadata.get('namespace')}/{metadata.get('name')}"
            bound_privileged_roles.append(identifier)
            privileged_bindings.append(
                {
                    "kind": "RoleBinding",
                    "namespace": str(metadata.get("namespace", "")),
                    "name": str(metadata.get("name", "")),
                    "role_ref": (
                        f"{role_ref.get('apiGroup', '')}/{role_ref.get('kind', '')}/"
                        f"{role_ref.get('name', '')}"
                    ),
                    "object_sha256": _json_sha256(
                        _semantic_kubernetes_object(item)
                    ),
                }
            )
    bound_privileged_roles.sort()
    privileged_bindings.sort(
        key=lambda item: (item["kind"], item["namespace"], item["name"])
    )
    if (
        census_claim.get("bound_privileged_capability_roles")
        != bound_privileged_roles
        or census_claim.get("provider_authorized_privileged_bindings")
        != privileged_bindings
        or provider_attestation.get("authorized_privileged_bindings")
        != privileged_bindings
    ):
        raise DeploymentError(
            "live privileged identity, Secret, workload, and exec bindings differ "
            "from the provider-authorized finite inventory"
        )

    static_binding = next(
        (
            item
            for item in protected
            if item.get("resource")
            == "validatingadmissionpolicybindings.admissionregistration.k8s.io"
            and item.get("name") == "fs2-model-network-static-custody-binding"
        ),
        None,
    )
    if not isinstance(static_binding, dict):
        raise DeploymentError("the static custody binding is absent from signed inventory")
    live_static = subprocess.run(
        [
            kubectl,
            "--kubeconfig",
            str(auditor),
            "--context",
            context,
            "get",
            "validatingadmissionpolicybinding.admissionregistration.k8s.io",
            "fs2-model-network-static-custody-binding",
            "--output",
            "json",
        ],
        env=clean_environment(),
        text=True,
        capture_output=True,
        check=False,
    )
    try:
        annotations = json.loads(live_static.stdout)["metadata"]["annotations"]
    except (KeyError, TypeError, json.JSONDecodeError) as exc:
        raise DeploymentError("the live static custody binding is malformed") from exc
    expected_cluster_hash = hashlib.sha256(
        json.dumps(capable_cluster_roles, separators=(",", ":")).encode()
    ).hexdigest()
    expected_role_hash = hashlib.sha256(
        json.dumps(capable_roles, separators=(",", ":")).encode()
    ).hexdigest()
    if (
        live_static.returncode != 0
        or annotations.get(
            "fs2-serve.nebius.ai/privileged-capability-cluster-roles-sha256"
        )
        != expected_cluster_hash
        or annotations.get(
            "fs2-serve.nebius.ai/privileged-capability-roles-sha256"
        )
        != expected_role_hash
    ):
        raise DeploymentError("the API-native impersonation guard is not bound to the live census")

    webhook = receipt.get("webhook", {})
    deployment = receipt.get("deployment", {})
    acquisition_writer = receipt.get("acquisition_writer", {})
    scientific_writer = receipt.get("scientific_writer", {})
    if not isinstance(webhook, dict):
        raise DeploymentError("the authority webhook claim is malformed")
    matching = [
        item
        for item in protected
        if item.get("resource")
        == "validatingwebhookconfigurations.admissionregistration.k8s.io"
        and item.get("name") == "fs2-model-network-boundary"
    ]
    if (
        len(matching) != 1
        or webhook.get("name") != "fs2-model-network-boundary"
        or webhook.get("uid") != matching[0].get("uid")
        or webhook.get("resource_version") != matching[0].get("resource_version")
        or not re.fullmatch(r"[a-f0-9]{64}", str(webhook.get("spec_sha256", "")))
        or webhook.get("spec_sha256") != live_webhook_sha256
    ):
        raise DeploymentError("the signed authority webhook identity is inconsistent")
    if not isinstance(deployment, dict):
        raise DeploymentError("the authority Deployment claim is malformed")
    image = deployment.get("image", {})
    if (
        not isinstance(image, dict)
        or not isinstance(image.get("repository"), str)
        or not image["repository"].endswith("/network-boundary-authority")
        or not re.fullmatch(r"sha256:[a-f0-9]{64}", str(image.get("digest", "")))
        or live_authority_image != f"{image['repository']}@{image['digest']}"
    ):
        raise DeploymentError(
            "the authority Deployment does not use its dedicated digest-pinned image"
        )
    if (
        not isinstance(live_authority_replicas, int)
        or isinstance(live_authority_replicas, bool)
        or live_authority_replicas < 2
    ):
        raise DeploymentError("the boundary authority must have at least two replicas")

    jobset_writer = receipt.get("jobset_writer")
    live_jobset_writer = live_authority_environment.get(
        "FS2_NETWORK_BOUNDARY_ADMISSION_JOBSET_WRITER"
    )
    jobset_match = re.fullmatch(
        r"system:serviceaccount:jobset-system:(fs2-[a-z][a-z0-9]{5,11}-jobset-controller)",
        live_jobset_writer or "",
    )
    if not isinstance(jobset_writer, dict) or jobset_match is None:
        raise DeploymentError("the live authority has no exact run-scoped JobSet writer")
    jobset_deployment = subprocess.run(
        [
            kubectl,
            "--kubeconfig",
            str(auditor),
            "--context",
            context,
            "--namespace",
            "jobset-system",
            "get",
            "deployment.apps",
            jobset_match.group(1),
            "--output",
            "json",
        ],
        env=clean_environment(),
        text=True,
        capture_output=True,
        check=False,
    )
    try:
        jobset_metadata = json.loads(jobset_deployment.stdout)["metadata"]
    except (KeyError, TypeError, json.JSONDecodeError) as exc:
        raise DeploymentError("the run-scoped JobSet controller is unavailable") from exc
    if (
        jobset_deployment.returncode != 0
        or jobset_writer.get("username") != live_jobset_writer
        or jobset_writer.get("deployment_uid") != jobset_metadata.get("uid")
        or jobset_writer.get("deployment_resource_version")
        != jobset_metadata.get("resourceVersion")
    ):
        raise DeploymentError(
            "the authority JobSet writer differs from the live foundation controller"
        )

    service_claim = receipt.get("service")
    service_matches = [
        item
        for item in protected
        if item.get("resource") == "services"
        and item.get("namespace") == "fs2-network-security"
        and item.get("name") == "fs2-model-network-boundary"
    ]
    if (
        not isinstance(service_claim, dict)
        or len(service_matches) != 1
        or any(
            service_claim.get(field) != service_matches[0].get(field)
            for field in (
                "namespace",
                "name",
                "uid",
                "resource_version",
                "object_sha256",
            )
        )
        or service_claim.get("serving_certificate_sha256")
        != live_serving_certificate_sha256
    ):
        raise DeploymentError(
            "the authority Service or serving certificate is not live-equal to its receipt"
        )

    service_endpoints = _authority_ready_endpoints(
        kubectl=kubectl,
        auditor=auditor,
        context=context,
        serving_certificate_sha256=live_serving_certificate_sha256,
    )
    ready_endpoints = service_endpoints["ready_endpoints"]
    if (
        len(ready_endpoints) != live_authority_replicas
        or len({item["node_name"] for item in ready_endpoints})
        != len(ready_endpoints)
        or service_claim.get("endpoints_uid") != service_endpoints["uid"]
        or service_claim.get("endpoints_resource_version")
        != service_endpoints["resource_version"]
        or service_claim.get("endpoints_object_sha256")
        != service_endpoints["object_sha256"]
        or service_claim.get("ready_endpoints") != ready_endpoints
    ):
        raise DeploymentError(
            "every authority replica must be a distinct-node, TLS-current ready Service endpoint"
        )
    acquisition_accounts = [
        item
        for item in protected
        if item.get("resource") == "serviceaccounts"
        and item.get("namespace") == "fs2-system"
        and item.get("name") == "fs2-catalog-acquisition"
    ]
    if (
        not isinstance(acquisition_writer, dict)
        or len(acquisition_accounts) != 1
        or acquisition_writer.get("username")
        != "system:serviceaccount:fs2-system:fs2-catalog-acquisition"
        or acquisition_writer.get("service_account_uid")
        != acquisition_accounts[0].get("uid")
        or acquisition_writer.get("resource_version")
        != acquisition_accounts[0].get("resource_version")
    ):
        raise DeploymentError(
            "the dedicated catalog acquisition identity is not live-bound"
        )
    scientific_account_result = subprocess.run(
        [
            kubectl,
            "--kubeconfig",
            str(auditor),
            "--context",
            context,
            "--namespace",
            "fs2-system",
            "get",
            "serviceaccount",
            "fs2-scientific-job-writer",
            "--output",
            "json",
        ],
        env=clean_environment(),
        text=True,
        capture_output=True,
        check=False,
    )
    if scientific_account_result.returncode != 0:
        if receipt.get("phase") != "bootstrap" or scientific_writer is not None:
            raise DeploymentError(
                "only bootstrap may omit a not-yet-created scientific writer"
            )
    else:
        try:
            scientific_metadata = json.loads(scientific_account_result.stdout)[
                "metadata"
            ]
        except (KeyError, TypeError, json.JSONDecodeError) as exc:
            raise DeploymentError(
                "the dedicated scientific writer identity is unavailable"
            ) from exc
        if (
            not isinstance(scientific_writer, dict)
            or scientific_writer.get("username")
            != "system:serviceaccount:fs2-system:fs2-scientific-job-writer"
            or scientific_writer.get("service_account_uid")
            != scientific_metadata.get("uid")
            or scientific_writer.get("resource_version")
            != scientific_metadata.get("resourceVersion")
            or scientific_writer.get("username")
            == acquisition_writer.get("username")
        ):
            raise DeploymentError(
                "the dedicated scientific writer is not live-bound or distinct"
            )
    operation_lock_resources = {
        "leases.coordination.k8s.io/fs2-system/fs2-model-network-transition",
        "leases.coordination.k8s.io/fs2-system/fs2-model-network-maintenance",
    }
    frozen_resources = {
        f"{resource}/{namespace or '_cluster'}/{name}"
        for resource, namespace, name in required
    } - operation_lock_resources
    frozen_resources.add(
        f"deployments.apps/jobset-system/{jobset_match.group(1)}"
    )
    if scientific_account_result.returncode == 0:
        frozen_resources.add(
            "serviceaccounts/fs2-system/fs2-scientific-job-writer"
        )
    if sorted(
        provider_attestation.get("mutation_freeze", {}).get(
            "protected_kubernetes_resources", []
        )
    ) != sorted(frozen_resources):
        raise DeploymentError(
            "the external provider mutation freeze does not cover every receipt-bound authority and writer object"
        )
    snapshot_projection = {
        "protected_objects": first_object_snapshot,
        "rbac_collections": {
            name: {
                "resource_version": value["resource_version"],
                "items_sha256": value["items_sha256"],
            }
            for name, value in collections.items()
        },
        "ready_endpoints": ready_endpoints,
        "service_endpoints": service_endpoints,
        "serving_certificate_sha256": live_serving_certificate_sha256,
        "jobset_writer": jobset_writer,
        "acquisition_writer": acquisition_writer,
        "scientific_writer": scientific_writer,
        "provider_attestation_sha256": provider_attestation_sha256,
        "release_inventory_sha256": release_claim["sha256"],
    }
    snapshot_sha256 = _json_sha256(snapshot_projection)
    verification_window = receipt.get("verification_window")
    try:
        first_observed_at = datetime.fromisoformat(
            verification_window["first_observed_at"].replace("Z", "+00:00")
        )
        last_observed_at = datetime.fromisoformat(
            verification_window["last_observed_at"].replace("Z", "+00:00")
        )
    except (KeyError, TypeError, ValueError) as exc:
        raise DeploymentError("the authority verification window is malformed") from exc
    if (
        not isinstance(verification_window, dict)
        or first_observed_at.tzinfo is None
        or last_observed_at.tzinfo is None
        or not (
            first_observed_at
            <= last_observed_at
            <= issued_at
            <= expires_at
        )
        or last_observed_at - first_observed_at > timedelta(seconds=30)
        or issued_at - last_observed_at > timedelta(seconds=30)
        or verification_window.get("first_snapshot_sha256") != snapshot_sha256
        or verification_window.get("last_snapshot_sha256") != snapshot_sha256
    ):
        raise DeploymentError(
            "the signed authority receipt does not prove one stable two-read snapshot"
        )

    second_object_snapshot: dict[str, Any] = {}
    for resource, namespace, name in sorted(required):
        command = [
            kubectl,
            "--kubeconfig",
            str(auditor),
            "--context",
            context,
        ]
        if namespace:
            command.extend(["--namespace", namespace])
        command.extend(["get", resource, name, "--output", "json"])
        second = subprocess.run(
            command,
            env=clean_environment(),
            text=True,
            capture_output=True,
            check=False,
        )
        try:
            live = json.loads(second.stdout)
            metadata = live["metadata"]
        except (KeyError, TypeError, json.JSONDecodeError) as exc:
            raise DeploymentError(
                f"the second custody read for {resource}/{name} is malformed"
            ) from exc
        if second.returncode != 0:
            raise DeploymentError(
                f"the second custody read for {resource}/{name} failed"
            )
        second_object_snapshot["/".join((resource, namespace, name))] = {
            "uid": metadata.get("uid"),
            "resource_version": metadata.get("resourceVersion"),
            "object_sha256": _json_sha256(_semantic_kubernetes_object(live)),
        }
    second_collections = {
        "cluster_roles": audited_collection(
            "clusterroles.rbac.authorization.k8s.io", all_namespaces=False
        ),
        "cluster_role_bindings": audited_collection(
            "clusterrolebindings.rbac.authorization.k8s.io", all_namespaces=False
        ),
        "roles": audited_collection(
            "roles.rbac.authorization.k8s.io", all_namespaces=True
        ),
        "role_bindings": audited_collection(
            "rolebindings.rbac.authorization.k8s.io", all_namespaces=True
        ),
    }
    second_service_endpoints = _authority_ready_endpoints(
        kubectl=kubectl,
        auditor=auditor,
        context=context,
        serving_certificate_sha256=live_serving_certificate_sha256,
    )
    second_snapshot_projection = {
        **snapshot_projection,
        "protected_objects": second_object_snapshot,
        "rbac_collections": {
            name: {
                "resource_version": value["resource_version"],
                "items_sha256": value["items_sha256"],
            }
            for name, value in second_collections.items()
        },
        "ready_endpoints": second_service_endpoints["ready_endpoints"],
        "service_endpoints": second_service_endpoints,
    }
    if (
        second_object_snapshot != first_object_snapshot
        or _json_sha256(second_snapshot_projection) != snapshot_sha256
    ):
        raise DeploymentError(
            "authority or RBAC state changed between the two custody reads"
        )
    completed_at = datetime.now(UTC)
    if expires_at - completed_at < timedelta(minutes=5):
        raise DeploymentError(
            "the signed authority receipt has less than five minutes remaining after live verification"
        )
    if freeze_active_until - completed_at < timedelta(minutes=10):
        raise DeploymentError(
            "the external provider mutation freeze has less than ten minutes remaining before apply"
        )
    return receipt


def model_network_boundary_credential(
    *,
    kubectl: str,
    shared_kubeconfig: str,
    context: str,
    phase: str,
    cluster_id: str,
    trust_root_sha256: str,
    provider_trust_root_sha256: str,
) -> tuple[str, str, dict[str, Any]]:
    """Require a signed, distinct X.509 credential and prove its live identity."""

    if phase == "prepare":
        environment_name = "FS2_NETWORK_AUTHORIZER_KUBECONFIG"
        expected_username = "fs2-model-network-authorizer"
        credential_kind = "authorizer"
        expected_receipt_phase = "bootstrap"
    elif phase == "prepare-transition":
        environment_name = "FS2_NETWORK_TRANSITION_KUBECONFIG"
        expected_username = "fs2-model-network-transition"
        credential_kind = "transition"
        expected_receipt_phase = "bootstrap"
    elif phase == "maintenance":
        environment_name = "FS2_NETWORK_MAINTENANCE_KUBECONFIG"
        expected_username = "fs2-model-network-maintenance"
        credential_kind = "maintenance"
        expected_receipt_phase = "armed"
    else:
        environment_name = "FS2_NETWORK_TRANSITION_KUBECONFIG"
        expected_username = "fs2-model-network-transition"
        credential_kind = "transition"
        expected_receipt_phase = "armed"
    raw_path = os.environ.get(environment_name, "")
    if not raw_path:
        raise DeploymentError(
            f"{environment_name} must name the separately issued model-network credential"
        )
    credential = Path(raw_path)
    shared = Path(shared_kubeconfig)
    if (
        not credential.is_absolute()
        or credential.is_symlink()
        or not credential.is_file()
        or credential.resolve() == shared.resolve()
    ):
        raise DeploymentError(
            f"{environment_name} must be an absolute regular file distinct from the shared kubeconfig"
        )
    if credential.stat().st_mode & 0o077:
        raise DeploymentError(f"{environment_name} must not be group/world accessible")
    authenticated = subprocess.run(
        [
            kubectl,
            "--kubeconfig",
            str(credential),
            "--context",
            context,
            "auth",
            "whoami",
            "-o",
            "json",
        ],
        env=clean_environment(),
        text=True,
        capture_output=True,
        check=False,
    )
    if authenticated.returncode != 0:
        raise DeploymentError(
            f"cannot authenticate the separate {environment_name} credential: "
            + (
                authenticated.stderr.strip()
                or authenticated.stdout.strip()
                or "kubectl auth whoami failed"
            )
        )
    try:
        observed_identity = _exact_kubernetes_user_info(
            json.loads(authenticated.stdout), environment_name
        )
        username = observed_identity["username"]
    except (DeploymentError, json.JSONDecodeError) as exc:
        raise DeploymentError(
            f"{environment_name} returned no exact authenticated username"
        ) from exc
    if username != expected_username:
        raise DeploymentError(
            f"{environment_name} authenticates as {username!r}, not {expected_username!r}"
        )
    custody = model_network_boundary_authority_custody(
        kubectl=kubectl,
        context=context,
        cluster_id=cluster_id,
        credential=credential,
        credential_kind=credential_kind,
        expected_username=expected_username,
        expected_receipt_phase=expected_receipt_phase,
        observed_identity=observed_identity,
        trust_root_sha256=trust_root_sha256,
        provider_trust_root_sha256=provider_trust_root_sha256,
    )
    return str(credential.resolve()), expected_username, custody


def ensure_control_plane_helm_release_idle(
    *,
    kubectl: str,
    kubeconfig: str,
    context: str,
    allow_absent: bool = False,
) -> None:
    """Reject a transition while the latest Helm release is pending."""

    result = subprocess.run(
        [
            kubectl,
            "--kubeconfig",
            kubeconfig,
            "--context",
            context,
            "-n",
            "fs2-system",
            "get",
            "secrets,configmaps",
            "-l",
            "owner=helm,name=fs2-serve-control-plane",
            "-o",
            "json",
        ],
        env=clean_environment(),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise DeploymentError(
            "cannot inspect the control-plane Helm release before arming the network boundary: "
            + (result.stderr.strip() or result.stdout.strip() or "unknown error")
        )
    try:
        document = json.loads(result.stdout)
        releases = [
            item
            for item in document["items"]
            if isinstance(item, dict)
            and item.get("metadata", {}).get("labels", {}).get("owner") == "helm"
            and item.get("metadata", {}).get("labels", {}).get("name")
            == "fs2-serve-control-plane"
        ]
        if not releases and allow_absent:
            return
        latest = max(releases, key=lambda item: int(item["metadata"]["labels"]["version"]))
        status = latest["metadata"]["labels"]["status"]
    except (KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
        raise DeploymentError(
            "the control-plane Helm release history is missing or malformed"
        ) from exc
    if not isinstance(status, str) or status.startswith("pending-"):
        raise DeploymentError(
            f"the latest control-plane Helm release is not idle: {status!r}"
        )


def workload_endpoint_outputs(
    terraform: str,
    run_root: Path,
    contract: Mapping[str, Any],
) -> dict[str, Any]:
    """Read all non-secret, customer-facing workload endpoints."""
    environment = stage_environment(
        run_root, "workloads", contract, include_secrets=False
    )
    outputs = {
        "mcp_endpoint_url": terraform_json_output(
            terraform, WORKLOADS_ROOT, "mcp_endpoint_url", environment
        ),
        "admin_web_interface_url": terraform_json_output(
            terraform, WORKLOADS_ROOT, "admin_web_interface_url", environment
        ),
        "inference_base_url": terraform_json_output(
            terraform, WORKLOADS_ROOT, "inference_base_url", environment
        ),
        "grafana_url": terraform_optional_json_output(
            terraform, WORKLOADS_ROOT, "grafana_url", environment
        ),
        "alertmanager_url": terraform_optional_json_output(
            terraform, WORKLOADS_ROOT, "alertmanager_url", environment
        ),
        "tempo_explore_url": terraform_optional_json_output(
            terraform, WORKLOADS_ROOT, "tempo_explore_url", environment
        ),
    }
    reference_enabled = (
        contract.get("stages", {})
        .get("workloads", {})
        .get("reference_data", {})
        .get("enabled")
        is True
    )
    outputs["reference_data"] = (
        terraform_optional_json_output(
            terraform, WORKLOADS_ROOT, "reference_data_status", environment
        )
        if reference_enabled
        else None
    )
    outputs["reference_data_contract"] = (
        terraform_optional_json_output(
            terraform, WORKLOADS_ROOT, "reference_data_contract", environment
        )
        if reference_enabled
        else None
    )
    scientific_enabled = (
        contract.get("stages", {})
        .get("workloads", {})
        .get("scientific_artifacts", {})
        .get("enabled")
        is True
    )
    outputs["scientific_artifacts"] = (
        terraform_optional_json_output(
            terraform, WORKLOADS_ROOT, "scientific_artifacts_status", environment
        )
        if scientific_enabled
        else None
    )
    outputs["scientific_artifacts_contract"] = (
        terraform_optional_json_output(
            terraform, WORKLOADS_ROOT, "scientific_artifacts_contract", environment
        )
        if scientific_enabled
        else None
    )
    return outputs


def workload_access_bundle(
    terraform: str,
    run_root: Path,
    contract: Mapping[str, Any],
) -> dict[str, Any]:
    """Read the explicit sensitive connection bundle from workloads state."""

    environment = stage_environment(
        run_root, "workloads", contract, include_secrets=False
    )
    bundle = terraform_json_output(
        terraform, WORKLOADS_ROOT, "access_bundle", environment
    )
    if (
        not isinstance(bundle, dict)
        or bundle.get("schema") != "fs2-serve.nebius.ai/access-bundle/v1"
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")

    cluster = bundle.get("cluster")
    endpoints = bundle.get("endpoints")
    credentials = bundle.get("credentials")
    mcp_access = bundle.get("mcp_access")
    scientific_access = bundle.get("scientific_access")
    reference_data = bundle.get("reference_data")
    reference_data_contract = bundle.get("reference_data_contract")
    if not all(
        isinstance(value, dict)
        for value in (cluster, endpoints, credentials, mcp_access)
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")

    def has_non_empty_strings(
        document: Mapping[str, Any], fields: tuple[str, ...]
    ) -> bool:
        return all(
            isinstance(document.get(field), str) and bool(document[field].strip())
            for field in fields
        )

    if not has_non_empty_strings(
        cluster,
        (
            "project_id",
            "region",
            "cluster_id",
            "cluster_name",
            "kube_context",
            "kubeconfig_command",
        ),
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    if not has_non_empty_strings(endpoints, ("mcp_url", "inference_base_url")):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    if any(
        key not in endpoints
        or (endpoints[key] is not None and not isinstance(endpoints[key], str))
        for key in (
            "admin_portal_url",
            "grafana_url",
            "alertmanager_url",
            "tempo_explore_url",
        )
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")

    shared_token = credentials.get("mcp_inference_token")
    if (
        not has_non_empty_strings(
            credentials,
            ("admin_bootstrap_token", "mcp_inference_token", "inference_access_token"),
        )
        or credentials.get("inference_access_token") != shared_token
        or "scientific_access_token" not in credentials
        or "scientific_access" not in bundle
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    grafana = credentials.get("grafana")
    if not isinstance(grafana, dict) or not has_non_empty_strings(
        grafana, ("username", "password")
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    scopes = mcp_access.get("scopes")
    if (
        not has_non_empty_strings(mcp_access, ("principal_id", "tenant_id"))
        or not isinstance(scopes, list)
        or not {"mcp.invoke", "inference.invoke"}.issubset(scopes)
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")

    academic_assets = contract.get("academic_assets")
    academic_fleet_enabled = (
        isinstance(academic_assets, dict) and academic_assets.get("enabled") is True
    )
    if academic_fleet_enabled:
        academic_tenant_id = academic_assets.get("tenant_id")
        scientific_token = credentials.get("scientific_access_token")
        scientific_scopes = (
            scientific_access.get("scopes")
            if isinstance(scientific_access, dict)
            else None
        )
        scientific_models = (
            scientific_access.get("models")
            if isinstance(scientific_access, dict)
            else None
        )
        scientific_max_concurrency = (
            scientific_access.get("max_concurrency")
            if isinstance(scientific_access, dict)
            else None
        )
        if (
            not isinstance(academic_tenant_id, str)
            or not academic_tenant_id.strip()
            or not isinstance(scientific_token, str)
            or not scientific_token.strip()
            or scientific_token == shared_token
            or not isinstance(scientific_access, dict)
            or not has_non_empty_strings(
                scientific_access, ("principal_id", "tenant_id")
            )
            or scientific_access.get("tenant_id") != academic_tenant_id
            or scientific_access.get("principal_id") == mcp_access.get("principal_id")
            or not isinstance(scientific_scopes, list)
            or not {
                "mcp.invoke",
                "inference.invoke",
                "use.nonclinical",
                "use.noncommercial",
            }.issubset(scientific_scopes)
            or not isinstance(scientific_models, list)
            or not scientific_models
            or not all(
                isinstance(model_id, str) and model_id.strip()
                for model_id in scientific_models
            )
            or not isinstance(scientific_max_concurrency, int)
            or isinstance(scientific_max_concurrency, bool)
            or not 1 <= scientific_max_concurrency <= 100
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
    elif (
        credentials.get("scientific_access_token") is not None
        or scientific_access is not None
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    if reference_data is not None:
        if not isinstance(reference_data, dict) or not has_non_empty_strings(
            reference_data,
            ("filesystem_id", "bucket_id", "bucket_name", "cpu_pool_id"),
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
        lifecycle = reference_data.get("lifecycle")
        if (
            not isinstance(lifecycle, dict)
            or lifecycle.get("retention_mode") not in {"retain", "disposable"}
            or (
                lifecycle.get("retention_mode") == "retain"
                and (
                    lifecycle.get("destroy_status") != "blocked-retained"
                    or lifecycle.get("destroy_completion")
                    != "full-stack-destroy-incomplete-infrastructure-retained"
                    or lifecycle.get("adoption_status")
                    != "ids-exported-for-explicit-state-adoption"
                )
            )
            or (
                lifecycle.get("retention_mode") == "disposable"
                and (
                    lifecycle.get("destroy_status")
                    != "eligible-only-while-bucket-empty"
                    or lifecycle.get("destroy_completion")
                    != "full-only-when-versioned-bucket-empty"
                )
            )
            or not isinstance(reference_data.get("pipeline"), (dict, type(None)))
            or not isinstance(reference_data.get("status_service"), (str, type(None)))
            or not isinstance(reference_data_contract, dict)
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
        storage = reference_data_contract.get("storage")
        plane = reference_data_contract.get("plane")
        if (
            not isinstance(storage, dict)
            or not isinstance(plane, dict)
            or storage.get("filesystem", {}).get("id")
            != reference_data["filesystem_id"]
            or storage.get("object_storage", {}).get("id")
            != reference_data["bucket_id"]
            or storage.get("object_storage", {}).get("name")
            != reference_data["bucket_name"]
            or storage.get("cpu_pool", {}).get("id") != reference_data["cpu_pool_id"]
            or plane.get("status_service") != reference_data["status_service"]
            or plane.get("pipeline") != reference_data["pipeline"]
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
    elif reference_data_contract is not None:
        raise DeploymentError("the workloads access bundle is missing or malformed")

    scientific_artifacts = bundle.get("scientific_artifacts")
    if scientific_artifacts is not None:
        if not isinstance(scientific_artifacts, dict) or not has_non_empty_strings(
            scientific_artifacts,
            ("bucket_id", "bucket_name", "endpoint", "object_key", "writer_role"),
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
        lifecycle = scientific_artifacts.get("lifecycle")
        if (
            not isinstance(lifecycle, dict)
            or lifecycle.get("retention_mode") not in {"retain", "disposable"}
            or scientific_artifacts.get("writer_role") != "storage.object-editor"
            or scientific_artifacts.get("credential_secret")
            != "fs2-system/fs2-serve-artifact-store"
            or not isinstance(scientific_artifacts.get("credential_revision"), int)
            or scientific_artifacts["credential_revision"] < 1
            or not isinstance(scientific_artifacts.get("batch_enabled"), bool)
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
        # The bundle is the operator's copy of every live credential, so an S3
        # secret leaking into it would be the worst possible regression.
        if any(
            key in scientific_artifacts
            for key in ("secret_access_key", "secret_key", "credentials")
        ):
            raise DeploymentError(
                "the scientific artifact bundle must never carry object-storage secret material"
            )
    return bundle


def state_ready(
    terraform: str,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
) -> bool:
    state, _, _ = stage_paths(run_root, stage)
    if not state.exists():
        return False
    environment = stage_environment(run_root, stage, contract, include_secrets=False)
    terraform_init(terraform, stage_root(stage), state, environment)
    result = subprocess.run(
        [
            terraform,
            f"-chdir={stage_root(stage)}",
            "output",
            "-json",
            STAGE_COMPLETION_OUTPUTS[stage],
        ],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return False
    try:
        return json.loads(result.stdout) is not None
    except json.JSONDecodeError:
        return False


def state_has_resources(
    terraform: str,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
) -> bool:
    state, _, _ = stage_paths(run_root, stage)
    if not state.exists():
        return False
    environment = stage_environment(run_root, stage, contract, include_secrets=False)
    terraform_init(terraform, stage_root(stage), state, environment)
    return bool(state_addresses(terraform, stage_root(stage), environment))


def apply_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
    configuration_environment: Mapping[str, str],
) -> None:
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="infrastructure",
        contract=contract,
        variable_file=infrastructure_variables,
    )
    apply_plan(args.terraform, INFRA_ROOT, plan_path, environment)

    dynamic = infrastructure_outputs(
        args.terraform,
        run_root,
        contract,
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
    )
    mirror_selected_images(args, run_root, contract, dynamic)
    foundation_variables, workloads_variables = write_downstream_variables(
        run_root, contract, dynamic
    )

    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="foundation",
        contract=contract,
        variable_file=foundation_variables,
    )
    apply_plan(args.terraform, FOUNDATION_ROOT, plan_path, environment)

    transition = contract["stages"]["workloads"]["model_runtime_network_policy"]
    transition_phase = transition.get("phase", "prepare")
    trust_root_sha256 = transition.get("authority_trust_root_sha256", "")
    provider_trust_root_sha256 = transition.get(
        "provider_trust_root_sha256", ""
    )
    boundary_kubeconfig, boundary_username, authority_receipt = (
        model_network_boundary_credential(
            kubectl=args.kubectl,
            shared_kubeconfig=dynamic["kubeconfig_path"],
            context=dynamic["kube_context"],
            phase=transition_phase,
            cluster_id=dynamic["cluster_id"],
            trust_root_sha256=trust_root_sha256,
            provider_trust_root_sha256=provider_trust_root_sha256,
        )
    )

    def apply_workloads(
        boundary_holder_identity: str = "",
        operation_lock_identity: str = "",
        operation_writer_username: str = "",
    ) -> None:
        overrides = {
            "FS2_NETWORK_TRANSITION_LOCK_IDENTITY": boundary_holder_identity,
            "FS2_NETWORK_TRANSITION_WRITER_USERNAME": operation_writer_username,
            "TF_VAR_model_network_transition_lock_identity": boundary_holder_identity,
            "TF_VAR_model_network_operation_lock_identity": operation_lock_identity,
            "TF_VAR_model_network_transition_writer_username": operation_writer_username,
            "TF_VAR_model_network_transition_lock_required": json.dumps(
                bool(operation_lock_identity)
            ),
            "TF_VAR_model_network_boundary_kubeconfig_path": boundary_kubeconfig,
            "TF_VAR_model_network_helm_kubeconfig_path": (
                boundary_kubeconfig
                if transition_phase in {"prepare", "maintenance", "rollback-helm"}
                else dynamic["kubeconfig_path"]
            ),
            "TF_VAR_model_network_boundary_authority_receipt": json.dumps(
                authority_receipt, sort_keys=True, separators=(",", ":")
            ),
        }
        if operation_lock_identity:
            ensure_control_plane_helm_release_idle(
                kubectl=args.kubectl,
                kubeconfig=dynamic["kubeconfig_path"],
                context=dynamic["kube_context"],
                allow_absent=transition_phase == "prepare",
            )
        plan_path, workloads_plan, environment = plan_stage(
            args.terraform,
            run_root=run_root,
            stage="workloads",
            contract=contract,
            variable_file=workloads_variables,
            environment_overrides=overrides,
        )
        validate_model_network_policy_rollback_plan(workloads_plan, contract)
        validate_model_network_frozen_plan(workloads_plan, contract)
        validate_model_network_maintenance_plan(workloads_plan, contract)
        if operation_lock_identity:
            ensure_control_plane_helm_release_idle(
                kubectl=args.kubectl,
                kubeconfig=dynamic["kubeconfig_path"],
                context=dynamic["kube_context"],
                allow_absent=transition_phase == "prepare",
            )
        revalidated_kubeconfig, revalidated_username, revalidated_receipt = (
            model_network_boundary_credential(
                kubectl=args.kubectl,
                shared_kubeconfig=dynamic["kubeconfig_path"],
                context=dynamic["kube_context"],
                phase=transition_phase,
                cluster_id=dynamic["cluster_id"],
                trust_root_sha256=trust_root_sha256,
                provider_trust_root_sha256=provider_trust_root_sha256,
            )
        )
        if (
            revalidated_kubeconfig != boundary_kubeconfig
            or revalidated_username != boundary_username
            or revalidated_receipt != authority_receipt
        ):
            raise DeploymentError(
                "the model-network custody snapshot changed after planning; discard the saved plan"
            )
        apply_plan(args.terraform, WORKLOADS_ROOT, plan_path, environment)
        if operation_lock_identity:
            ensure_control_plane_helm_release_idle(
                kubectl=args.kubectl,
                kubeconfig=dynamic["kubeconfig_path"],
                context=dynamic["kube_context"],
            )

    if transition_phase == "prepare":
        if boundary_username != "fs2-model-network-authorizer":
            raise DeploymentError("prepare requires the separate network authorizer")
        transition_kubeconfig, transition_username, transition_receipt = (
            model_network_boundary_credential(
                kubectl=args.kubectl,
                shared_kubeconfig=dynamic["kubeconfig_path"],
                context=dynamic["kube_context"],
                phase="prepare-transition",
                cluster_id=dynamic["cluster_id"],
                trust_root_sha256=trust_root_sha256,
                provider_trust_root_sha256=provider_trust_root_sha256,
            )
        )
        if transition_receipt != authority_receipt:
            raise DeploymentError(
                "authorizer and transition credentials are not bound to one signed authority receipt"
            )
        ensure_control_plane_helm_release_idle(
            kubectl=args.kubectl,
            kubeconfig=dynamic["kubeconfig_path"],
            context=dynamic["kube_context"],
            allow_absent=True,
        )
        with model_network_transition_lock(
            kubectl=args.kubectl,
            kubeconfig=transition_kubeconfig,
            context=dynamic["kube_context"],
            run_id=contract["run_id"],
        ) as (lock_identity, transition_writer_username):
            if transition_writer_username != transition_username:
                raise DeploymentError(
                    "the Lease writer differs from the separately verified transition credential"
                )
            apply_workloads(
                lock_identity,
                lock_identity,
                transition_writer_username,
            )
    elif transition_phase == "maintenance":
        stable_holder = model_network_boundary_holder(
            kubectl=args.kubectl,
            kubeconfig=boundary_kubeconfig,
            context=dynamic["kube_context"],
        )
        ensure_control_plane_helm_release_idle(
            kubectl=args.kubectl,
            kubeconfig=dynamic["kubeconfig_path"],
            context=dynamic["kube_context"],
        )
        with model_network_transition_lock(
            kubectl=args.kubectl,
            kubeconfig=boundary_kubeconfig,
            context=dynamic["kube_context"],
            run_id=contract["run_id"],
            lease_name="fs2-model-network-maintenance",
            expected_username="fs2-model-network-maintenance",
            expected_groups=(
                "fs2:model-network-maintenance",
                "system:authenticated",
            ),
        ) as (lock_identity, maintenance_writer_username):
            if maintenance_writer_username != boundary_username:
                raise DeploymentError(
                    "the maintenance Lease writer differs from its verified credential"
                )
            apply_workloads(
                stable_holder,
                lock_identity,
                maintenance_writer_username,
            )
    else:
        # This first check precedes the transition lock. Once the lock is held,
        # the already-installed API admission fence blocks every new Helm
        # release-storage mutation; the second check in apply_workloads catches
        # an operation that became pending immediately before the fence armed.
        ensure_control_plane_helm_release_idle(
            kubectl=args.kubectl,
            kubeconfig=dynamic["kubeconfig_path"],
            context=dynamic["kube_context"],
        )
        with model_network_transition_lock(
            kubectl=args.kubectl,
            kubeconfig=boundary_kubeconfig,
            context=dynamic["kube_context"],
            run_id=contract["run_id"],
        ) as (lock_identity, transition_writer_username):
            if transition_writer_username != boundary_username:
                raise DeploymentError(
                    "the Lease writer differs from the separately verified transition credential"
                )
            apply_workloads(
                lock_identity,
                lock_identity,
                transition_writer_username,
            )

    # Record the accepted root contract after all of its staged consumers converge.
    apply_plan(
        args.terraform,
        DEPLOY_ROOT,
        run_root / "configuration.tfplan",
        configuration_environment,
    )

    endpoints = workload_endpoint_outputs(args.terraform, run_root, contract)
    print(json.dumps({"status": "applied", **endpoints}, indent=2))


def plan_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    if not state_ready(args.terraform, run_root, "infrastructure", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="infrastructure",
            contract=contract,
            variable_file=infrastructure_variables,
        )
        print(
            "Planned infrastructure. Apply it before foundation can be planned against the new API server."
        )
        return

    _, infrastructure_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="infrastructure",
        contract=contract,
        variable_file=infrastructure_variables,
    )
    if plan_changes_managed_resources_or_outputs(infrastructure_plan):
        print(
            "Planned infrastructure changes. Apply infrastructure and rerun plan before planning foundation."
        )
        return

    dynamic = infrastructure_outputs(
        args.terraform,
        run_root,
        contract,
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
    )
    if "artifact_delivery" not in dynamic["accelerator_pool_contract"]:
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="infrastructure",
            contract=contract,
            variable_file=infrastructure_variables,
        )
        print(
            "Planned the registry-delivery contract upgrade. Apply infrastructure before planning downstream stages."
        )
        return
    foundation_variables, workloads_variables = write_downstream_variables(
        run_root, contract, dynamic
    )
    if not state_ready(args.terraform, run_root, "foundation", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="foundation",
            contract=contract,
            variable_file=foundation_variables,
        )
        print("Planned foundation. Apply it before custom resources can be planned.")
        return

    _, foundation_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="foundation",
        contract=contract,
        variable_file=foundation_variables,
    )
    if plan_changes_managed_resources_or_outputs(foundation_plan):
        print(
            "Planned foundation changes. Apply foundation and rerun plan before planning workloads."
        )
        return

    transition_phase = contract["stages"]["workloads"][
        "model_runtime_network_policy"
    ].get("phase", "prepare")
    transition = contract["stages"]["workloads"]["model_runtime_network_policy"]
    boundary_kubeconfig, _boundary_username, authority_receipt = (
        model_network_boundary_credential(
            kubectl=args.kubectl,
            shared_kubeconfig=dynamic["kubeconfig_path"],
            context=dynamic["kube_context"],
            phase=transition_phase,
            cluster_id=dynamic["cluster_id"],
            trust_root_sha256=transition.get("authority_trust_root_sha256", ""),
            provider_trust_root_sha256=transition.get(
                "provider_trust_root_sha256", ""
            ),
        )
    )
    workloads_overrides = {
        "TF_VAR_model_network_boundary_kubeconfig_path": boundary_kubeconfig,
        "TF_VAR_model_network_helm_kubeconfig_path": (
            boundary_kubeconfig
            if transition_phase in {"prepare", "maintenance", "rollback-helm"}
            else dynamic["kubeconfig_path"]
        ),
        "TF_VAR_model_network_boundary_authority_receipt": json.dumps(
            authority_receipt, sort_keys=True, separators=(",", ":")
        ),
    }

    if not state_ready(args.terraform, run_root, "workloads", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="workloads",
            contract=contract,
            variable_file=workloads_variables,
            environment_overrides=workloads_overrides,
        )
        print("Planned workloads.")
        return

    _, workloads_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="workloads",
        contract=contract,
        variable_file=workloads_variables,
        environment_overrides=workloads_overrides,
    )
    validate_model_network_policy_rollback_plan(workloads_plan, contract)
    validate_model_network_frozen_plan(workloads_plan, contract)
    validate_model_network_maintenance_plan(workloads_plan, contract)
    print("Planned all three existing states after upstream handoffs converged.")


def destroy_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    reference_infrastructure = (
        contract.get("stages", {}).get("infrastructure", {}).get("reference_data", {})
    )
    scientific_infrastructure = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("scientific_artifacts", {})
    )
    reference_retained = (
        isinstance(reference_infrastructure, Mapping)
        and reference_infrastructure.get("enabled") is True
        and reference_infrastructure.get("lifecycle", {}).get("retention_mode")
        == "retain"
    )
    scientific_retained = (
        isinstance(scientific_infrastructure, Mapping)
        and scientific_infrastructure.get("enabled") is True
        and scientific_infrastructure.get("lifecycle", {}).get("retention_mode")
        == "retain"
    )
    retained_mode = reference_retained or scientific_retained
    resources = {
        stage: state_has_resources(args.terraform, run_root, stage, contract)
        for stage in ("infrastructure", "foundation", "workloads")
    }
    retain_infrastructure = retained_mode and resources["infrastructure"]
    infrastructure_variables = (
        None
        if retain_infrastructure
        else write_infrastructure_variables(
            run_root, contract, commit, args.nebius_profile
        )
    )
    cached_foundation = run_root / "foundation.tfvars.json"
    cached_workloads = run_root / "workloads.tfvars.json"
    downstream: tuple[Path, Path] | None = None
    dynamic: dict[str, Any] | None = None
    if retain_infrastructure:
        if not state_ready(args.terraform, run_root, "infrastructure", contract):
            raise DeploymentError(
                "retained reference infrastructure exists but its completion output "
                "is unavailable; no resource was changed"
            )
        dynamic = infrastructure_outputs(
            args.terraform,
            run_root,
            contract,
            nebius=args.nebius,
            nebius_profile=args.nebius_profile,
            kubectl=args.kubectl,
        )
        if reference_retained and not isinstance(
            dynamic.get("reference_data_storage_contract"), Mapping
        ):
            raise DeploymentError(
                "retained reference infrastructure is missing its non-secret storage "
                "contract; no resource was changed"
            )
        if reference_retained and not isinstance(
            dynamic.get("reference_data_lifecycle"), Mapping
        ):
            raise DeploymentError(
                "retained reference infrastructure is missing its lifecycle output; "
                "no resource was changed"
            )
        if scientific_retained and not isinstance(
            dynamic.get("scientific_artifacts_storage_contract"), Mapping
        ):
            raise DeploymentError(
                "retained scientific artifact storage is missing its non-secret bucket "
                "contract; no resource was changed"
            )
        if scientific_retained and not isinstance(
            dynamic.get("scientific_artifacts_lifecycle"), Mapping
        ):
            raise DeploymentError(
                "retained scientific artifact storage is missing its lifecycle output; "
                "no resource was changed"
            )
    if resources["foundation"] or resources["workloads"]:
        if (
            cached_foundation.is_file()
            and not cached_foundation.is_symlink()
            and cached_workloads.is_file()
            and not cached_workloads.is_symlink()
        ):
            downstream = (cached_foundation, cached_workloads)
        elif state_ready(args.terraform, run_root, "infrastructure", contract):
            if dynamic is None:
                dynamic = infrastructure_outputs(
                    args.terraform,
                    run_root,
                    contract,
                    nebius=args.nebius,
                    nebius_profile=args.nebius_profile,
                    kubectl=args.kubectl,
                )
            downstream = write_downstream_variables(run_root, contract, dynamic)
        else:
            raise DeploymentError(
                "downstream resources exist but their private generated tfvars and a complete infrastructure handoff are both unavailable"
            )

    retained_workload_outputs: dict[str, Any] = {
        "reference_data": None,
        "reference_data_contract": None,
        "scientific_artifacts": None,
        "scientific_artifacts_contract": None,
    }
    if (
        retain_infrastructure
        and resources["workloads"]
        and state_ready(args.terraform, run_root, "workloads", contract)
    ):
        retained_workload_outputs = workload_endpoint_outputs(
            args.terraform, run_root, contract
        )

    destroy_order: tuple[tuple[str, Path | None], ...] = (
        ("workloads", downstream[1] if downstream else None),
        ("foundation", downstream[0] if downstream else None),
    )
    if not retain_infrastructure:
        destroy_order += (("infrastructure", infrastructure_variables),)

    destroyed_stages: list[str] = []
    for stage, variable_file in destroy_order:
        if not resources[stage]:
            continue
        if variable_file is None:
            raise DeploymentError(
                f"cannot destroy {stage}: its generated private variable file is unavailable"
            )
        plan_path, _, environment = plan_stage(
            args.terraform,
            run_root=run_root,
            stage=stage,
            contract=contract,
            variable_file=variable_file,
            destroy=True,
        )
        apply_plan(args.terraform, stage_root(stage), plan_path, environment)
        destroyed_stages.append(stage)

    if retain_infrastructure:
        assert dynamic is not None
        storage = dynamic.get("reference_data_storage_contract")
        lifecycle = dynamic.get("reference_data_lifecycle")
        applied_status = retained_workload_outputs.get("reference_data")
        applied_contract = retained_workload_outputs.get("reference_data_contract")
        last_applied_status_service = (
            applied_status.get("status_service")
            if isinstance(applied_status, Mapping)
            else None
        )
        last_applied_pipeline = (
            applied_status.get("pipeline")
            if isinstance(applied_status, Mapping)
            else None
        )
        last_applied_plane = (
            applied_contract.get("plane")
            if isinstance(applied_contract, Mapping)
            else None
        )
        reference_data = (
            None
            if not reference_retained
            else {
                "lifecycle": lifecycle,
                "filesystem_id": storage.get("filesystem", {}).get("id"),
                "bucket_id": storage.get("object_storage", {}).get("id"),
                "bucket_name": storage.get("object_storage", {}).get("name"),
                "cpu_pool_id": storage.get("cpu_pool", {}).get("id"),
                "status_service": None,
                "pipeline": None,
                "last_applied": {
                    "status_service": last_applied_status_service,
                    "pipeline": last_applied_pipeline,
                },
            }
        )
        reference_data_contract = (
            None
            if not reference_retained
            else {
                "storage": storage,
                "plane": None,
                "last_applied_plane": last_applied_plane,
            }
        )
        scientific_storage = dynamic.get("scientific_artifacts_storage_contract")
        scientific_lifecycle = dynamic.get("scientific_artifacts_lifecycle")
        scientific_artifacts = (
            None
            if not scientific_retained
            else {
                "lifecycle": scientific_lifecycle,
                "bucket_id": (scientific_storage or {})
                .get("object_storage", {})
                .get("id"),
                "bucket_name": (scientific_storage or {})
                .get("object_storage", {})
                .get("name"),
                "object_key": (scientific_storage or {})
                .get("layout", {})
                .get("object_key"),
                "last_applied": retained_workload_outputs.get("scientific_artifacts"),
            }
        )
        scientific_artifacts_contract = (
            None
            if not scientific_retained
            else {
                "storage": scientific_storage,
            }
        )
        adoption_lifecycle = lifecycle if reference_retained else scientific_lifecycle
        receipt_path = run_root / (
            "reference-data-retention.json"
            if reference_retained
            else "scientific-artifacts-retention.json"
        )
        result = {
            "schema": "fs2-serve.nebius.ai/destroy-result/v1",
            "status": "infrastructure-retained",
            "completion": "full-stack-destroy-incomplete-infrastructure-retained",
            "destroyed_stages": destroyed_stages,
            "retained_stages": ["infrastructure"],
            "reference_data": reference_data,
            "reference_data_contract": reference_data_contract,
            "scientific_artifacts": scientific_artifacts,
            "scientific_artifacts_contract": scientific_artifacts_contract,
            "adoption": {
                "required_before_full_destroy": True,
                "status": (adoption_lifecycle or {}).get("adoption_status"),
                "receipt_path": str(receipt_path),
                "next_step": (
                    "adopt or migrate every retained filesystem and bucket into a "
                    "separate durable Terraform state before destroying infrastructure"
                ),
            },
        }
        private_json(receipt_path, result)
        print(json.dumps(result, indent=2))
        return

    print(
        json.dumps(
            {
                "schema": "fs2-serve.nebius.ai/destroy-result/v1",
                "status": "destroyed",
                "completion": "complete",
                "destroyed_stages": destroyed_stages,
                "retained_stages": [],
                "reference_data": None,
                "reference_data_contract": None,
                "scientific_artifacts": None,
                "scientific_artifacts_contract": None,
                "evidence_root": str(run_root),
            },
            indent=2,
        )
    )


def status_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    stages: dict[str, Any] = {}
    workloads_ready = False
    infrastructure_reference_data: Any | None = None
    infrastructure_reference_data_contract: Any | None = None
    infrastructure_scientific_artifacts: Any | None = None
    for stage in ("infrastructure", "foundation", "workloads"):
        state, _, _ = stage_paths(run_root, stage)
        if not state.exists():
            stages[stage] = {"state": "absent", "addresses": 0, "complete": False}
            continue
        environment = stage_environment(
            run_root, stage, contract, include_secrets=False
        )
        terraform_init(args.terraform, stage_root(stage), state, environment)
        addresses = state_addresses(args.terraform, stage_root(stage), environment)
        complete = state_ready(args.terraform, run_root, stage, contract)
        stages[stage] = {
            "state": "ready" if complete else ("partial" if addresses else "empty"),
            "addresses": len(addresses),
            "complete": complete,
        }
        if stage == "workloads":
            workloads_ready = complete
        if (
            stage == "infrastructure"
            and complete
            and contract.get("stages", {})
            .get("infrastructure", {})
            .get("reference_data", {})
            .get("enabled")
            is True
        ):
            storage = terraform_optional_json_output(
                args.terraform,
                INFRA_ROOT,
                "reference_data_storage_contract",
                environment,
            )
            if isinstance(storage, Mapping):
                lifecycle = terraform_optional_json_output(
                    args.terraform,
                    INFRA_ROOT,
                    "reference_data_lifecycle",
                    environment,
                )
                infrastructure_reference_data = {
                    "lifecycle": (
                        lifecycle
                        if isinstance(lifecycle, Mapping)
                        else storage.get("lifecycle")
                    ),
                    "filesystem_id": storage.get("filesystem", {}).get("id"),
                    "bucket_id": storage.get("object_storage", {}).get("id"),
                    "bucket_name": storage.get("object_storage", {}).get("name"),
                    "cpu_pool_id": storage.get("cpu_pool", {}).get("id"),
                    "status_service": None,
                    "pipeline": None,
                }
                infrastructure_reference_data_contract = {
                    "storage": storage,
                    "plane": None,
                }
        if (
            stage == "infrastructure"
            and complete
            and contract.get("stages", {})
            .get("infrastructure", {})
            .get("scientific_artifacts", {})
            .get("enabled")
            is True
        ):
            artifact_storage = terraform_optional_json_output(
                args.terraform,
                INFRA_ROOT,
                "scientific_artifacts_storage_contract",
                environment,
            )
            if isinstance(artifact_storage, Mapping):
                artifact_lifecycle = terraform_optional_json_output(
                    args.terraform,
                    INFRA_ROOT,
                    "scientific_artifacts_lifecycle",
                    environment,
                )
                infrastructure_scientific_artifacts = {
                    "lifecycle": (
                        artifact_lifecycle
                        if isinstance(artifact_lifecycle, Mapping)
                        else artifact_storage.get("lifecycle")
                    ),
                    "bucket_id": artifact_storage.get("object_storage", {}).get("id"),
                    "bucket_name": artifact_storage.get("object_storage", {}).get(
                        "name"
                    ),
                    "endpoint": artifact_storage.get("object_storage", {}).get(
                        "endpoint"
                    ),
                    "region": artifact_storage.get("region"),
                    "object_key": artifact_storage.get("layout", {}).get("object_key"),
                    "writer_role": artifact_storage.get("writer", {}).get("role"),
                    "writer_paths": artifact_storage.get("writer", {}).get("paths"),
                    "secret_delivery": artifact_storage.get("writer", {}).get(
                        "secret_delivery"
                    ),
                    "retention": artifact_storage.get("retention"),
                    "credential_secret": "fs2-system/fs2-serve-artifact-store",
                }
    endpoints = (
        workload_endpoint_outputs(args.terraform, run_root, contract)
        if workloads_ready
        else {
            "mcp_endpoint_url": None,
            "admin_web_interface_url": None,
            "inference_base_url": None,
            "grafana_url": None,
            "alertmanager_url": None,
            "tempo_explore_url": None,
            "reference_data": None,
            "reference_data_contract": None,
            "scientific_artifacts": None,
            "scientific_artifacts_contract": None,
        }
    )
    # A previously applied workloads state can remain otherwise complete while the
    # newly enabled reference-data module is intentionally held behind its own
    # review gate. Keep the normal status surface truthful in that transition:
    # report the live infrastructure identities and retained lifecycle until the
    # workload-owned status service and pipeline replace this fallback.
    if (
        endpoints["reference_data"] is None
        and infrastructure_reference_data is not None
    ):
        endpoints["reference_data"] = infrastructure_reference_data
    if (
        endpoints["reference_data_contract"] is None
        and infrastructure_reference_data_contract is not None
    ):
        endpoints["reference_data_contract"] = infrastructure_reference_data_contract
    # The store can be provisioned and correct while the batch workloads that
    # consume it are still gated off. Report the live bucket identity rather
    # than pretending the feature is absent.
    if (
        endpoints.get("scientific_artifacts") is None
        and infrastructure_scientific_artifacts is not None
    ):
        endpoints["scientific_artifacts"] = infrastructure_scientific_artifacts
    print(
        json.dumps(
            {"run_root": str(run_root), "stages": stages, **endpoints},
            indent=2,
        )
    )


