def _read_private_evidence(path: Path, *, label: str) -> tuple[dict[str, Any], str]:
    if not path.is_absolute() or path.is_symlink() or not path.is_file():
        raise DeploymentError(f"{label} must be an absolute regular file")
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or metadata.st_mode & 0o077
            or metadata.st_nlink != 1
            or not 1 <= metadata.st_size <= _MAX_CUSTODY_DOCUMENT_BYTES
        ):
            raise DeploymentError(f"{label} is not private append-only evidence")
        value = b""
        while len(value) <= _MAX_CUSTODY_DOCUMENT_BYTES:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            value += chunk
        after = os.fstat(descriptor)
        if (
            len(value) != metadata.st_size
            or any(
                getattr(metadata, field) != getattr(after, field)
                for field in (
                    "st_dev",
                    "st_ino",
                    "st_mode",
                    "st_uid",
                    "st_nlink",
                    "st_size",
                    "st_mtime_ns",
                    "st_ctime_ns",
                )
            )
        ):
            raise DeploymentError(f"{label} changed while being read")
    finally:
        os.close(descriptor)
    try:
        document = json.loads(value)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError(f"{label} is not canonical JSON") from exc
    if not isinstance(document, dict):
        raise DeploymentError(f"{label} is not a JSON object")
    return document, hashlib.sha256(value).hexdigest()


def _terraform_value_projection(document: Mapping[str, Any], key: str) -> dict[str, Any]:
    values = document.get(key)
    if not isinstance(values, Mapping):
        raise DeploymentError(f"Terraform document has no {key} projection")

    def module_projection(module: Mapping[str, Any]) -> dict[str, Any]:
        resources = module.get("resources", [])
        children = module.get("child_modules", [])
        if not isinstance(resources, list) or not isinstance(children, list):
            raise DeploymentError("Terraform value projection is malformed")
        projected_resources = []
        for resource in resources:
            if not isinstance(resource, Mapping):
                raise DeploymentError("Terraform resource projection is malformed")
            projected_resources.append(
                {
                    key: resource.get(key)
                    for key in (
                        "address",
                        "mode",
                        "type",
                        "name",
                        "index",
                        "provider_name",
                        "schema_version",
                        "values",
                    )
                    if key in resource
                }
            )
        projected_children = [
            {
                "address": child.get("address"),
                "module": module_projection(child),
            }
            for child in children
            if isinstance(child, Mapping)
        ]
        if len(projected_children) != len(children):
            raise DeploymentError("Terraform child-module projection is malformed")
        return {
            "resources": sorted(
                projected_resources, key=lambda resource: str(resource.get("address"))
            ),
            "child_modules": sorted(
                projected_children, key=lambda child: str(child.get("address"))
            ),
        }

    root_module = values.get("root_module", {})
    outputs = values.get("outputs", {})
    if not isinstance(root_module, Mapping) or not isinstance(outputs, Mapping):
        raise DeploymentError("Terraform root values or outputs are malformed")
    return {"root_module": module_projection(root_module), "outputs": outputs}


def reconcile_indeterminate_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    configuration_environment: Mapping[str, str],
) -> None:
    transition = contract["stages"]["workloads"]["model_runtime_network_policy"]
    provider_trust_root_sha256 = transition.get(
        "provider_trust_root_sha256", ""
    )
    signature_verifier_sha256 = transition.get(
        "signature_verifier_sha256", ""
    )
    provider_attestation = provider_custody_preflight(args, contract)

    def journal_guard(
        operation: str, request_document: Mapping[str, Any]
    ) -> dict[str, Any]:
        return _provider_apply_journal_operation(
            attestation=provider_attestation,
            operation=operation,
            request_document=request_document,
            provider_trust_root_sha256=provider_trust_root_sha256,
            signature_verifier_sha256=signature_verifier_sha256,
        )

    journal_observation = _complete_unresolved_provider_apply_journal(
        journal_guard=journal_guard
    )
    unresolved = _unresolved_indeterminate_applies(
        run_root, journal_observation
    )
    if not unresolved:
        raise DeploymentError(
            "reconcile-indeterminate requires an unresolved provider-custodied marker"
        )
    selected_record = sorted(
        unresolved,
        key=lambda record: (
            str(record["marker"]["journal_opened_at"]),
            str(record["marker"]["apply_id"]),
        ),
    )[-1]
    marker = dict(selected_record["marker"])
    marker_sha256 = _json_sha256(marker)
    stage = str(marker.get("stage", ""))
    expected_root = DEPLOY_ROOT if stage == "configuration" else stage_root(stage)
    saved_plan_path = run_root / str(marker["saved_plan_name"])
    if (
        saved_plan_path.parent.resolve() != run_root.resolve()
        or saved_plan_path.is_symlink()
        or not saved_plan_path.is_file()
        or _sha256_file(saved_plan_path) != marker.get("saved_plan_sha256")
    ):
        raise DeploymentError("the exact aborted saved plan is unavailable or changed")
    current_source_commit = source_commit()
    current_source_tree = run(
        ["git", "-C", str(REPOSITORY_ROOT), "rev-parse", "HEAD^{tree}"],
        capture=True,
        env=clean_environment(),
    ).stdout.strip()
    if (
        provider_attestation.get("cluster_id") != marker.get("cluster_id")
        or provider_attestation.get("project_id") != marker.get("project_id")
        or provider_attestation.get("mutation_freeze", {}).get("transaction_id")
        == marker.get("custody_transaction_id")
        or current_source_commit != marker.get("source_commit")
        or current_source_tree != marker.get("source_tree")
    ):
        raise DeploymentError(
            "indeterminate recovery requires the exact source plus a fresh custody transaction for the same target"
        )
    current_transaction_id = str(
        provider_attestation["mutation_freeze"]["transaction_id"]
    )
    recovery_kubeconfig, recovery_username, recovery_receipt = (
        model_network_boundary_credential(
            kubectl=args.kubectl,
            shared_kubeconfig=None,
            context=str(provider_attestation["client_tools"]["kubectl"]["context"]),
            phase="reconcile-indeterminate",
            cluster_id=str(marker["cluster_id"]),
            project_id=str(marker["project_id"]),
            nebius=args.nebius,
            nebius_profile=args.nebius_profile,
            trust_root_sha256=transition.get("authority_trust_root_sha256", ""),
            provider_trust_root_sha256=transition.get(
                "provider_trust_root_sha256", ""
            ),
            signature_verifier_sha256=transition.get(
                "signature_verifier_sha256", ""
            ),
        )
    )
    if recovery_username != "fs2-model-network-recovery":
        raise DeploymentError("indeterminate recovery used the wrong phase identity")
    stable_custody_sha256 = _provider_custody_stable_sha256(provider_attestation)

    def recovery_custody_guard() -> datetime:
        observed, _digest, active_until = _verified_provider_custody(
            cluster_id=str(marker["cluster_id"]),
            project_id=str(marker["project_id"]),
            nebius=args.nebius,
            nebius_profile=args.nebius_profile,
            provider_trust_root_sha256=transition.get(
                "provider_trust_root_sha256", ""
            ),
            signature_verifier_sha256=transition.get(
                "signature_verifier_sha256", ""
            ),
        )
        if (
            _provider_custody_stable_sha256(observed) != stable_custody_sha256
            or observed.get("mutation_freeze", {}).get("transaction_id")
            != current_transaction_id
        ):
            raise DeploymentError(
                "fresh recovery custody changed during indeterminate reconciliation"
            )
        return active_until

    def recovery_journal_guard(
        operation: str, request_document: Mapping[str, Any]
    ) -> dict[str, Any]:
        recovery_custody_guard()
        return _provider_apply_journal_operation(
            attestation=provider_attestation,
            operation=operation,
            request_document=request_document,
            provider_trust_root_sha256=provider_trust_root_sha256,
            signature_verifier_sha256=signature_verifier_sha256,
        )

    def recovery_settlement_guard(
        apply_marker: Mapping[str, Any], deadline: datetime
    ) -> dict[str, Any]:
        return _provider_operation_settlement(
            attestation=provider_attestation,
            marker=apply_marker,
            deadline=deadline,
        )

    active_until = recovery_custody_guard()
    settlement = _provider_operation_settlement(
        attestation=provider_attestation,
        marker=marker,
        deadline=active_until - timedelta(minutes=2),
    )
    recovery_custody_guard()

    if stage == "configuration":
        state_path = run_root / "configuration.tfstate"
        variable_file = args.var_file.expanduser().resolve()
        environment = dict(configuration_environment)
    else:
        state_path, variable_file, _data_path = stage_paths(run_root, stage)
        environment = stage_environment(run_root, stage, contract)
    if stage == "workloads":
        environment.update(
            {
                "TF_VAR_model_network_boundary_kubeconfig_path": recovery_kubeconfig,
                "TF_VAR_model_network_helm_kubeconfig_path": recovery_kubeconfig,
                "TF_VAR_model_network_boundary_authority_receipt": json.dumps(
                    recovery_receipt, sort_keys=True, separators=(",", ":")
                ),
            }
        )
    terraform_init(args.terraform, expected_root, state_path, environment)
    refresh_plan_path = run_root / f"{stage}-{marker['apply_id']}.refresh-only.tfplan"
    refresh_json_path = run_root / f"{stage}-{marker['apply_id']}.refresh-only.plan.json"
    if refresh_plan_path.exists() or refresh_json_path.exists():
        raise DeploymentError(
            "indeterminate refresh evidence already exists; it must be reviewed in place"
        )
    run(
        [
            args.terraform,
            f"-chdir={expected_root}",
            "plan",
            "-refresh-only",
            "-input=false",
            "-lock=true",
            f"-var-file={variable_file}",
            f"-out={refresh_plan_path}",
        ],
        env=environment,
    )
    refresh_plan_path.chmod(0o600)
    refresh_show = run(
        [
            args.terraform,
            f"-chdir={expected_root}",
            "show",
            "-json",
            str(refresh_plan_path),
        ],
        env=environment,
        capture=True,
    )
    private_text(refresh_json_path, refresh_show.stdout)
    try:
        refresh_document = json.loads(refresh_show.stdout)
    except json.JSONDecodeError as exc:
        raise DeploymentError("refresh-only saved plan is not readable JSON") from exc
    unresolved_apply_ids = tuple(
        str(record["marker"]["apply_id"]) for record in unresolved
    )
    apply_plan(
        args.terraform,
        expected_root,
        refresh_plan_path,
        environment,
        custody_guard=recovery_custody_guard,
        indeterminate_root=run_root,
        stage=stage,
        custody_project_id=str(marker["project_id"]),
        custody_cluster_id=str(marker["cluster_id"]),
        custody_transaction_id=current_transaction_id,
        credential_epochs_sha256=_provider_credential_epochs_sha256(
            provider_attestation
        ),
        target_postconditions_sha256=_json_sha256(
            _terraform_value_projection(refresh_document, "planned_values")
        ),
        journal_guard=recovery_journal_guard,
        settlement_guard=recovery_settlement_guard,
        reconciling_apply_ids=unresolved_apply_ids,
    )
    recovery_custody_guard()
    refreshed_state = run(
        [
            args.terraform,
            f"-chdir={expected_root}",
            "show",
            "-json",
            str(state_path),
        ],
        env=environment,
        capture=True,
    )
    target_plan = run(
        [
            args.terraform,
            f"-chdir={expected_root}",
            "show",
            "-json",
            str(saved_plan_path),
        ],
        env=environment,
        capture=True,
    )
    try:
        refreshed_document = json.loads(refreshed_state.stdout)
        target_document = json.loads(target_plan.stdout)
    except json.JSONDecodeError as exc:
        raise DeploymentError(
            "Terraform state or original target plan is not readable after refresh"
        ) from exc
    refreshed_projection = _terraform_value_projection(refreshed_document, "values")
    target_projection = _terraform_value_projection(target_document, "planned_values")
    target_postconditions_sha256 = _json_sha256(target_projection)
    if (
        refreshed_projection != target_projection
        or target_postconditions_sha256
        != marker.get("target_postconditions_sha256")
    ):
        raise DeploymentError(
            "remote operations settled, but refreshed state does not satisfy the exact "
            "saved-plan postconditions; keep the indeterminate marker unresolved"
        )
    final_expiry = recovery_custody_guard()
    resolution_observation = _assert_no_unresolved_indeterminate_apply(
        run_root,
        journal_guard=recovery_journal_guard,
        allowed_apply_ids=unresolved_apply_ids,
    )
    resolution_request = {
        "schema": _PROVIDER_APPLY_JOURNAL_REQUEST_SCHEMA,
        "operation": "resolve",
        "expected_journal_resource_version": resolution_observation[
            "journal_resource_version"
        ],
        "expected_checkpoint_sha256": resolution_observation[
            "checkpoint_sha256"
        ],
        "apply_id": marker["apply_id"],
        "marker_sha256": marker_sha256,
        "resolution": {
            "schema": _INDETERMINATE_RESOLUTION_SCHEMA,
            "resolution_kind": "fresh-recovery",
            "resolution_custody_transaction_id": current_transaction_id,
            "provider_settlement_sha256": _json_sha256(settlement),
            "refresh_plan_sha256": _sha256_file(refresh_plan_path),
            "refreshed_state_projection_sha256": _json_sha256(
                refreshed_projection
            ),
            "target_postconditions_sha256": target_postconditions_sha256,
            "remote_operations_terminal": True,
            "target_postconditions_satisfied": True,
            "custody_valid_until": final_expiry.isoformat().replace(
                "+00:00", "Z"
            ),
        },
    }
    resolved_observation = recovery_journal_guard(
        "resolve", resolution_request
    )
    resolved_record = next(
        (
            record
            for record in resolved_observation["records"]
            if record["marker"]["apply_id"] == marker["apply_id"]
        ),
        None,
    )
    if not isinstance(resolved_record, Mapping):
        raise DeploymentError(
            "provider apply journal omitted the recovery resolution"
        )
    _require_journal_resolution_matches_request(
        resolved_record, resolution_request
    )
    remaining_observation = _complete_unresolved_provider_apply_journal(
        journal_guard=recovery_journal_guard,
        expected_checkpoint_sha256=str(
            resolved_observation["checkpoint_sha256"]
        ),
    )
    remaining = _unresolved_indeterminate_applies(
        run_root, remaining_observation
    )
    expected_remaining_records = {
        record["marker"]["apply_id"]: record
        for record in _unresolved_indeterminate_applies(
            run_root, resolution_observation
        )
    }
    removed_recovery_record = expected_remaining_records.pop(
        str(marker["apply_id"]), None
    )
    if removed_recovery_record is None:
        raise DeploymentError(
            "provider recovery checkpoint lost the selected unresolved apply before its CAS"
        )
    if {
        record["marker"]["apply_id"]: record for record in remaining
    } != expected_remaining_records:
        raise DeploymentError(
            "provider recovery checkpoint changed an unresolved record other "
            "than the exact recovered apply"
        )
    if any(
        record["marker"]["apply_id"] == marker["apply_id"]
        for record in remaining
    ):
        raise DeploymentError(
            "provider apply journal did not commit the exact signed recovery resolution"
        )
    print(
        json.dumps(
            {
                "status": (
                    "indeterminate-apply-reconciled"
                    if not remaining
                    else "indeterminate-apply-reconciled-more-pending"
                ),
                "apply_id": marker["apply_id"],
                "resolution": "provider-authority-append-only-cas",
                "journal_resource_version": remaining_observation[
                    "journal_resource_version"
                ],
                "remaining_unresolved": [
                    record["marker"]["apply_id"] for record in remaining
                ],
            },
            indent=2,
        )
    )


def apply_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
    configuration_environment: Mapping[str, str],
) -> None:
    transition = contract["stages"]["workloads"]["model_runtime_network_policy"]
    transition_phase = transition.get("phase", "prepare")
    trust_root_sha256 = transition.get("authority_trust_root_sha256", "")
    provider_trust_root_sha256 = transition.get(
        "provider_trust_root_sha256", ""
    )
    signature_verifier_sha256 = transition.get(
        "signature_verifier_sha256", ""
    )
    preflight_attestation = provider_custody_preflight(args, contract)
    preflight_cluster_id = str(preflight_attestation["cluster_id"])
    kubectl_tool = preflight_attestation["client_tools"]["kubectl"]
    preflight_context = str(kubectl_tool["context"])
    custody_transaction_id = str(
        preflight_attestation["mutation_freeze"]["transaction_id"]
    )
    boundary_credential_kind = (
        "authorizer"
        if transition_phase == "prepare"
        else "maintenance"
        if transition_phase == "maintenance"
        else "transition"
    )
    boundary_kubeconfig_sha256 = str(
        preflight_attestation["credentials"][boundary_credential_kind][
            "kubeconfig_sha256"
        ]
    )
    auditor_kubeconfig = os.environ.get("FS2_NETWORK_AUDITOR_KUBECONFIG", "")
    auditor_kubeconfig_sha256 = str(
        preflight_attestation["credentials"]["auditor"]["kubeconfig_sha256"]
    )
    boundary_kubeconfig, boundary_username, authority_receipt = (
        model_network_boundary_credential(
            kubectl=args.kubectl,
            shared_kubeconfig=None,
            context=preflight_context,
            phase=transition_phase,
            cluster_id=preflight_cluster_id,
            project_id=contract["target"]["project_id"],
            nebius=args.nebius,
            nebius_profile=args.nebius_profile,
            trust_root_sha256=trust_root_sha256,
            provider_trust_root_sha256=provider_trust_root_sha256,
            signature_verifier_sha256=signature_verifier_sha256,
        )
    )
    expected_external_custody = authority_receipt.get("external_custody", {})

    def custody_guard() -> datetime:
        attestation, _attestation_sha256, active_until = (
            _verified_provider_custody(
                cluster_id=preflight_cluster_id,
                project_id=contract["target"]["project_id"],
                nebius=args.nebius,
                nebius_profile=args.nebius_profile,
                provider_trust_root_sha256=provider_trust_root_sha256,
                signature_verifier_sha256=signature_verifier_sha256,
            )
        )
        if (
            not isinstance(expected_external_custody, Mapping)
            or attestation.get("client_tools")
            != preflight_attestation.get("client_tools")
            or attestation.get("credentials")
            != preflight_attestation.get("credentials")
            or _provider_custody_stable_sha256(attestation)
            != expected_external_custody.get("stable_policy_sha256")
            or attestation.get("mutation_freeze", {}).get("transaction_id")
            != expected_external_custody.get("freeze_transaction_id")
            or attestation.get("provider_gateway", {}).get(
                "provider_inventory_sha256"
            )
            != expected_external_custody.get("provider_inventory_sha256")
            or _json_sha256(attestation.get("kubernetes_authorization", {}))
            != expected_external_custody.get(
                "kubernetes_authorization_sha256"
            )
            or _provider_authority_census_stable_sha256(
                attestation.get("provider_authority_census", {})
            )
            != expected_external_custody.get(
                "provider_authority_census_sha256"
            )
            or _json_sha256(
                attestation.get("provider_authority_census", {})
                .get("snapshot", {})
                .get("gateway_runtime_measurements", {})
            )
            != expected_external_custody.get(
                "gateway_runtime_measurements_sha256"
            )
        ):
            raise DeploymentError(
                "provider custody changed during the saved-plan transaction"
            )
        return active_until

    def journal_guard(
        operation: str, request_document: Mapping[str, Any]
    ) -> dict[str, Any]:
        custody_guard()
        return _provider_apply_journal_operation(
            attestation=preflight_attestation,
            operation=operation,
            request_document=request_document,
            provider_trust_root_sha256=provider_trust_root_sha256,
            signature_verifier_sha256=signature_verifier_sha256,
        )

    def settlement_guard(
        marker: Mapping[str, Any], deadline: datetime
    ) -> dict[str, Any]:
        return _provider_operation_settlement(
            attestation=preflight_attestation,
            marker=marker,
            deadline=deadline,
        )

    # No infrastructure, registry, Kubernetes, or root-state mutation may
    # precede this independently signed and live-reconciled boundary.
    custody_guard()
    _assert_no_unresolved_indeterminate_apply(
        run_root, journal_guard=journal_guard
    )
    credential_epochs_sha256 = _provider_credential_epochs_sha256(
        preflight_attestation
    )
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    plan_path, infrastructure_plan, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="infrastructure",
        contract=contract,
        variable_file=infrastructure_variables,
    )
    apply_plan(
        args.terraform,
        INFRA_ROOT,
        plan_path,
        environment,
        custody_guard=custody_guard,
        indeterminate_root=run_root,
        stage="infrastructure",
        custody_project_id=contract["target"]["project_id"],
        custody_cluster_id=preflight_cluster_id,
        custody_transaction_id=custody_transaction_id,
        credential_epochs_sha256=credential_epochs_sha256,
        target_postconditions_sha256=_json_sha256(
            _terraform_value_projection(infrastructure_plan, "planned_values")
        ),
        journal_guard=journal_guard,
        settlement_guard=settlement_guard,
    )

    dynamic = infrastructure_outputs(
        args.terraform,
        run_root,
        contract,
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
        provider_attestation=preflight_attestation,
    )
    if (
        dynamic["cluster_id"] != preflight_cluster_id
        or dynamic["kube_context"] != preflight_context
    ):
        raise DeploymentError(
            "infrastructure outputs differ from the provider-signed cluster/context"
        )
    revalidated_kubeconfig, revalidated_username, revalidated_receipt = (
        model_network_boundary_credential(
            kubectl=args.kubectl,
            shared_kubeconfig=dynamic["kubeconfig_path"],
            context=preflight_context,
            phase=transition_phase,
            cluster_id=preflight_cluster_id,
            project_id=contract["target"]["project_id"],
            nebius=args.nebius,
            nebius_profile=args.nebius_profile,
            trust_root_sha256=trust_root_sha256,
            provider_trust_root_sha256=provider_trust_root_sha256,
            signature_verifier_sha256=signature_verifier_sha256,
        )
    )
    if (
        revalidated_kubeconfig != boundary_kubeconfig
        or revalidated_username != boundary_username
        or revalidated_receipt != authority_receipt
    ):
        raise DeploymentError(
            "model-network custody changed during infrastructure convergence"
        )
    custody_guard()
    mirror_selected_images(args, run_root, contract, dynamic)
    custody_guard()
    foundation_variables, workloads_variables = write_downstream_variables(
        run_root, contract, dynamic
    )

    plan_path, foundation_plan, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="foundation",
        contract=contract,
        variable_file=foundation_variables,
    )
    apply_plan(
        args.terraform,
        FOUNDATION_ROOT,
        plan_path,
        environment,
        custody_guard=custody_guard,
        indeterminate_root=run_root,
        stage="foundation",
        custody_project_id=contract["target"]["project_id"],
        custody_cluster_id=preflight_cluster_id,
        custody_transaction_id=custody_transaction_id,
        credential_epochs_sha256=credential_epochs_sha256,
        target_postconditions_sha256=_json_sha256(
            _terraform_value_projection(foundation_plan, "planned_values")
        ),
        journal_guard=journal_guard,
        settlement_guard=settlement_guard,
    )
    custody_guard()

    def apply_workloads(
        boundary_holder_identity: str = "",
        operation_lock_identity: str = "",
        operation_writer_username: str = "",
    ) -> None:
        overrides = {
            "FS2_NETWORK_TRANSITION_LOCK_IDENTITY": boundary_holder_identity,
            "FS2_NETWORK_TRANSITION_WRITER_USERNAME": operation_writer_username,
            "TF_VAR_model_network_transition_lock_identity": boundary_holder_identity,
            "TF_VAR_model_network_operation_lock_identity": operation_lock_identity,
            "TF_VAR_model_network_transition_writer_username": operation_writer_username,
            "TF_VAR_model_network_transition_lock_required": json.dumps(
                bool(operation_lock_identity)
            ),
            "TF_VAR_model_network_boundary_kubeconfig_path": boundary_kubeconfig,
            "TF_VAR_model_network_helm_kubeconfig_path": (
                boundary_kubeconfig
            ),
            "TF_VAR_model_network_boundary_authority_receipt": json.dumps(
                authority_receipt, sort_keys=True, separators=(",", ":")
            ),
        }
        if operation_lock_identity:
            ensure_control_plane_helm_release_idle(
                kubectl=args.kubectl,
                kubectl_tool=kubectl_tool,
                kubeconfig=auditor_kubeconfig,
                kubeconfig_sha256=auditor_kubeconfig_sha256,
                context=preflight_context,
                allow_absent=transition_phase == "prepare",
            )
        plan_path, workloads_plan, environment = plan_stage(
            args.terraform,
            run_root=run_root,
            stage="workloads",
            contract=contract,
            variable_file=workloads_variables,
            environment_overrides=overrides,
        )
        validate_model_network_policy_rollback_plan(workloads_plan, contract)
        validate_model_network_frozen_plan(workloads_plan, contract)
        validate_model_network_maintenance_plan(workloads_plan, contract)
        if operation_lock_identity:
            ensure_control_plane_helm_release_idle(
                kubectl=args.kubectl,
                kubectl_tool=kubectl_tool,
                kubeconfig=auditor_kubeconfig,
                kubeconfig_sha256=auditor_kubeconfig_sha256,
                context=preflight_context,
                allow_absent=transition_phase == "prepare",
            )
        revalidated_kubeconfig, revalidated_username, revalidated_receipt = (
            model_network_boundary_credential(
                kubectl=args.kubectl,
                shared_kubeconfig=dynamic["kubeconfig_path"],
                context=dynamic["kube_context"],
                phase=transition_phase,
                cluster_id=dynamic["cluster_id"],
                project_id=contract["target"]["project_id"],
                nebius=args.nebius,
                nebius_profile=args.nebius_profile,
                trust_root_sha256=trust_root_sha256,
                provider_trust_root_sha256=provider_trust_root_sha256,
                signature_verifier_sha256=signature_verifier_sha256,
            )
        )
        if (
            revalidated_kubeconfig != boundary_kubeconfig
            or revalidated_username != boundary_username
            or revalidated_receipt != authority_receipt
        ):
            raise DeploymentError(
                "the model-network custody snapshot changed after planning; discard the saved plan"
            )
        apply_plan(
            args.terraform,
            WORKLOADS_ROOT,
            plan_path,
            environment,
            custody_guard=custody_guard,
            indeterminate_root=run_root,
            stage="workloads",
            custody_project_id=contract["target"]["project_id"],
            custody_cluster_id=preflight_cluster_id,
            custody_transaction_id=custody_transaction_id,
            credential_epochs_sha256=credential_epochs_sha256,
            target_postconditions_sha256=_json_sha256(
                _terraform_value_projection(workloads_plan, "planned_values")
            ),
            journal_guard=journal_guard,
            settlement_guard=settlement_guard,
        )
        if operation_lock_identity:
            ensure_control_plane_helm_release_idle(
                kubectl=args.kubectl,
                kubectl_tool=kubectl_tool,
                kubeconfig=auditor_kubeconfig,
                kubeconfig_sha256=auditor_kubeconfig_sha256,
                context=preflight_context,
            )

    if transition_phase == "prepare":
        if boundary_username != "fs2-model-network-authorizer":
            raise DeploymentError("prepare requires the separate network authorizer")
        transition_kubeconfig, transition_username, transition_receipt = (
            model_network_boundary_credential(
                kubectl=args.kubectl,
                shared_kubeconfig=dynamic["kubeconfig_path"],
                context=dynamic["kube_context"],
                phase="prepare-transition",
                cluster_id=dynamic["cluster_id"],
                project_id=contract["target"]["project_id"],
                nebius=args.nebius,
                nebius_profile=args.nebius_profile,
                trust_root_sha256=trust_root_sha256,
                provider_trust_root_sha256=provider_trust_root_sha256,
                signature_verifier_sha256=signature_verifier_sha256,
            )
        )
        if transition_receipt != authority_receipt:
            raise DeploymentError(
                "authorizer and transition credentials are not bound to one signed authority receipt"
            )
        ensure_control_plane_helm_release_idle(
            kubectl=args.kubectl,
            kubectl_tool=kubectl_tool,
            kubeconfig=auditor_kubeconfig,
            kubeconfig_sha256=auditor_kubeconfig_sha256,
            context=preflight_context,
            allow_absent=True,
        )
        transition_kubeconfig_sha256 = str(
            preflight_attestation["credentials"]["transition"][
                "kubeconfig_sha256"
            ]
        )
        with model_network_transition_lock(
            kubectl=args.kubectl,
            kubectl_tool=kubectl_tool,
            kubeconfig=transition_kubeconfig,
            kubeconfig_sha256=transition_kubeconfig_sha256,
            context=preflight_context,
            custody_expires_at=custody_guard(),
            run_id=contract["run_id"],
        ) as (lock_identity, transition_writer_username):
            if transition_writer_username != transition_username:
                raise DeploymentError(
                    "the Lease writer differs from the separately verified transition credential"
                )
            apply_workloads(
                lock_identity,
                lock_identity,
                transition_writer_username,
            )
    elif transition_phase == "maintenance":
        stable_holder = model_network_boundary_holder(
            kubectl=args.kubectl,
            kubectl_tool=kubectl_tool,
            kubeconfig=auditor_kubeconfig,
            kubeconfig_sha256=auditor_kubeconfig_sha256,
            context=preflight_context,
        )
        ensure_control_plane_helm_release_idle(
            kubectl=args.kubectl,
            kubectl_tool=kubectl_tool,
            kubeconfig=auditor_kubeconfig,
            kubeconfig_sha256=auditor_kubeconfig_sha256,
            context=preflight_context,
        )
        with model_network_transition_lock(
            kubectl=args.kubectl,
            kubectl_tool=kubectl_tool,
            kubeconfig=boundary_kubeconfig,
            kubeconfig_sha256=boundary_kubeconfig_sha256,
            context=preflight_context,
            custody_expires_at=custody_guard(),
            run_id=contract["run_id"],
            lease_name="fs2-model-network-maintenance",
            expected_username="fs2-model-network-maintenance",
            expected_groups=(
                "fs2:model-network-maintenance",
                "system:authenticated",
            ),
        ) as (lock_identity, maintenance_writer_username):
            if maintenance_writer_username != boundary_username:
                raise DeploymentError(
                    "the maintenance Lease writer differs from its verified credential"
                )
            apply_workloads(
                stable_holder,
                lock_identity,
                maintenance_writer_username,
            )
    else:
        # This first check precedes the transition lock. Once the lock is held,
        # the already-installed API admission fence blocks every new Helm
        # release-storage mutation; the second check in apply_workloads catches
        # an operation that became pending immediately before the fence armed.
        ensure_control_plane_helm_release_idle(
            kubectl=args.kubectl,
            kubectl_tool=kubectl_tool,
            kubeconfig=auditor_kubeconfig,
            kubeconfig_sha256=auditor_kubeconfig_sha256,
            context=preflight_context,
        )
        with model_network_transition_lock(
            kubectl=args.kubectl,
            kubectl_tool=kubectl_tool,
            kubeconfig=boundary_kubeconfig,
            kubeconfig_sha256=boundary_kubeconfig_sha256,
            context=preflight_context,
            custody_expires_at=custody_guard(),
            run_id=contract["run_id"],
        ) as (lock_identity, transition_writer_username):
            if transition_writer_username != boundary_username:
                raise DeploymentError(
                    "the Lease writer differs from the separately verified transition credential"
                )
            apply_workloads(
                lock_identity,
                lock_identity,
                transition_writer_username,
            )

    # Record the accepted root contract after all of its staged consumers converge.
    configuration_plan, _configuration_plan_sha256 = _read_private_evidence(
        run_root / "configuration.plan.json",
        label="configuration saved-plan JSON",
    )
    apply_plan(
        args.terraform,
        DEPLOY_ROOT,
        run_root / "configuration.tfplan",
        configuration_environment,
        custody_guard=custody_guard,
        indeterminate_root=run_root,
        stage="configuration",
        custody_project_id=contract["target"]["project_id"],
        custody_cluster_id=preflight_cluster_id,
        custody_transaction_id=custody_transaction_id,
        credential_epochs_sha256=credential_epochs_sha256,
        target_postconditions_sha256=_json_sha256(
            _terraform_value_projection(configuration_plan, "planned_values")
        ),
        journal_guard=journal_guard,
        settlement_guard=settlement_guard,
    )

    endpoints = workload_endpoint_outputs(args.terraform, run_root, contract)
    print(json.dumps({"status": "applied", **endpoints}, indent=2))


def plan_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    if not state_ready(args.terraform, run_root, "infrastructure", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="infrastructure",
            contract=contract,
            variable_file=infrastructure_variables,
        )
        print(
            "Planned infrastructure. Apply it before foundation can be planned against the new API server."
        )
        return

    _, infrastructure_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="infrastructure",
        contract=contract,
        variable_file=infrastructure_variables,
    )
    if plan_changes_managed_resources_or_outputs(infrastructure_plan):
        print(
            "Planned infrastructure changes. Apply infrastructure and rerun plan before planning foundation."
        )
        return

    provider_attestation = provider_custody_preflight(args, contract)
    dynamic = infrastructure_outputs(
        args.terraform,
        run_root,
        contract,
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
        provider_attestation=provider_attestation,
    )
    if "artifact_delivery" not in dynamic["accelerator_pool_contract"]:
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="infrastructure",
            contract=contract,
            variable_file=infrastructure_variables,
        )
        print(
            "Planned the registry-delivery contract upgrade. Apply infrastructure before planning downstream stages."
        )
        return
    foundation_variables, workloads_variables = write_downstream_variables(
        run_root, contract, dynamic
    )
    if not state_ready(args.terraform, run_root, "foundation", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="foundation",
            contract=contract,
            variable_file=foundation_variables,
        )
        print("Planned foundation. Apply it before custom resources can be planned.")
        return

    _, foundation_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="foundation",
        contract=contract,
        variable_file=foundation_variables,
    )
    if plan_changes_managed_resources_or_outputs(foundation_plan):
        print(
            "Planned foundation changes. Apply foundation and rerun plan before planning workloads."
        )
        return

    transition_phase = contract["stages"]["workloads"][
        "model_runtime_network_policy"
    ].get("phase", "prepare")
    transition = contract["stages"]["workloads"]["model_runtime_network_policy"]
    boundary_kubeconfig, _boundary_username, authority_receipt = (
        model_network_boundary_credential(
            kubectl=args.kubectl,
            shared_kubeconfig=dynamic["kubeconfig_path"],
            context=dynamic["kube_context"],
            phase=transition_phase,
            cluster_id=dynamic["cluster_id"],
            project_id=contract["target"]["project_id"],
            nebius=args.nebius,
            nebius_profile=args.nebius_profile,
            trust_root_sha256=transition.get("authority_trust_root_sha256", ""),
            provider_trust_root_sha256=transition.get(
                "provider_trust_root_sha256", ""
            ),
            signature_verifier_sha256=transition.get(
                "signature_verifier_sha256", ""
            ),
        )
    )
    workloads_overrides = {
        "TF_VAR_model_network_boundary_kubeconfig_path": boundary_kubeconfig,
        "TF_VAR_model_network_helm_kubeconfig_path": (
            boundary_kubeconfig
            if transition_phase in {"prepare", "maintenance", "rollback-helm"}
            else dynamic["kubeconfig_path"]
        ),
        "TF_VAR_model_network_boundary_authority_receipt": json.dumps(
            authority_receipt, sort_keys=True, separators=(",", ":")
        ),
    }

    if not state_ready(args.terraform, run_root, "workloads", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="workloads",
            contract=contract,
            variable_file=workloads_variables,
            environment_overrides=workloads_overrides,
        )
        print("Planned workloads.")
        return

    _, workloads_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="workloads",
        contract=contract,
        variable_file=workloads_variables,
        environment_overrides=workloads_overrides,
    )
    validate_model_network_policy_rollback_plan(workloads_plan, contract)
    validate_model_network_frozen_plan(workloads_plan, contract)
    validate_model_network_maintenance_plan(workloads_plan, contract)
    print("Planned all three existing states after upstream handoffs converged.")


def destroy_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    transition = contract["stages"]["workloads"]["model_runtime_network_policy"]
    provider_trust_root_sha256 = transition.get(
        "provider_trust_root_sha256", ""
    )
    signature_verifier_sha256 = transition.get(
        "signature_verifier_sha256", ""
    )
    provider_attestation = provider_custody_preflight(args, contract)
    stable_custody_sha256 = _provider_custody_stable_sha256(
        provider_attestation
    )
    custody_transaction_id = str(
        provider_attestation["mutation_freeze"]["transaction_id"]
    )

    def custody_guard() -> datetime:
        observed, _digest, active_until = _verified_provider_custody(
            cluster_id=str(provider_attestation["cluster_id"]),
            project_id=str(provider_attestation["project_id"]),
            nebius=args.nebius,
            nebius_profile=args.nebius_profile,
            provider_trust_root_sha256=provider_trust_root_sha256,
            signature_verifier_sha256=signature_verifier_sha256,
        )
        if (
            _provider_custody_stable_sha256(observed) != stable_custody_sha256
            or observed.get("mutation_freeze", {}).get("transaction_id")
            != custody_transaction_id
        ):
            raise DeploymentError(
                "provider custody changed during the destroy transaction"
            )
        return active_until

    def journal_guard(
        operation: str, request_document: Mapping[str, Any]
    ) -> dict[str, Any]:
        custody_guard()
        return _provider_apply_journal_operation(
            attestation=provider_attestation,
            operation=operation,
            request_document=request_document,
            provider_trust_root_sha256=provider_trust_root_sha256,
            signature_verifier_sha256=signature_verifier_sha256,
        )

    def settlement_guard(
        marker: Mapping[str, Any], deadline: datetime
    ) -> dict[str, Any]:
        return _provider_operation_settlement(
            attestation=provider_attestation,
            marker=marker,
            deadline=deadline,
        )

    _assert_no_unresolved_indeterminate_apply(
        run_root, journal_guard=journal_guard
    )
    credential_epochs_sha256 = _provider_credential_epochs_sha256(
        provider_attestation
    )
    reference_infrastructure = (
        contract.get("stages", {}).get("infrastructure", {}).get("reference_data", {})
    )
    scientific_infrastructure = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("scientific_artifacts", {})
    )
    reference_retained = (
        isinstance(reference_infrastructure, Mapping)
        and reference_infrastructure.get("enabled") is True
        and reference_infrastructure.get("lifecycle", {}).get("retention_mode")
        == "retain"
    )
    scientific_retained = (
        isinstance(scientific_infrastructure, Mapping)
        and scientific_infrastructure.get("enabled") is True
        and scientific_infrastructure.get("lifecycle", {}).get("retention_mode")
        == "retain"
    )
    retained_mode = reference_retained or scientific_retained
    resources = {
        stage: state_has_resources(args.terraform, run_root, stage, contract)
        for stage in ("infrastructure", "foundation", "workloads")
    }
    retain_infrastructure = retained_mode and resources["infrastructure"]
    infrastructure_variables = (
        None
        if retain_infrastructure
        else write_infrastructure_variables(
            run_root, contract, commit, args.nebius_profile
        )
    )
    cached_foundation = run_root / "foundation.tfvars.json"
    cached_workloads = run_root / "workloads.tfvars.json"
    downstream: tuple[Path, Path] | None = None
    dynamic: dict[str, Any] | None = None
    if retain_infrastructure:
        if not state_ready(args.terraform, run_root, "infrastructure", contract):
            raise DeploymentError(
                "retained reference infrastructure exists but its completion output "
                "is unavailable; no resource was changed"
            )
        dynamic = infrastructure_outputs(
            args.terraform,
            run_root,
            contract,
            nebius=args.nebius,
            nebius_profile=args.nebius_profile,
            kubectl=args.kubectl,
            provider_attestation=provider_attestation,
        )
        if reference_retained and not isinstance(
            dynamic.get("reference_data_storage_contract"), Mapping
        ):
            raise DeploymentError(
                "retained reference infrastructure is missing its non-secret storage "
                "contract; no resource was changed"
            )
        if reference_retained and not isinstance(
            dynamic.get("reference_data_lifecycle"), Mapping
        ):
            raise DeploymentError(
                "retained reference infrastructure is missing its lifecycle output; "
                "no resource was changed"
            )
        if scientific_retained and not isinstance(
            dynamic.get("scientific_artifacts_storage_contract"), Mapping
        ):
            raise DeploymentError(
                "retained scientific artifact storage is missing its non-secret bucket "
                "contract; no resource was changed"
            )
        if scientific_retained and not isinstance(
            dynamic.get("scientific_artifacts_lifecycle"), Mapping
        ):
            raise DeploymentError(
                "retained scientific artifact storage is missing its lifecycle output; "
                "no resource was changed"
            )
    if resources["foundation"] or resources["workloads"]:
        if (
            cached_foundation.is_file()
            and not cached_foundation.is_symlink()
            and cached_workloads.is_file()
            and not cached_workloads.is_symlink()
        ):
            downstream = (cached_foundation, cached_workloads)
        elif state_ready(args.terraform, run_root, "infrastructure", contract):
            if dynamic is None:
                dynamic = infrastructure_outputs(
                    args.terraform,
                    run_root,
                    contract,
                    nebius=args.nebius,
                    nebius_profile=args.nebius_profile,
                    kubectl=args.kubectl,
                    provider_attestation=provider_attestation,
                )
            downstream = write_downstream_variables(run_root, contract, dynamic)
        else:
            raise DeploymentError(
                "downstream resources exist but their private generated tfvars and a complete infrastructure handoff are both unavailable"
            )

    retained_workload_outputs: dict[str, Any] = {
        "reference_data": None,
        "reference_data_contract": None,
        "scientific_artifacts": None,
        "scientific_artifacts_contract": None,
    }
    if (
        retain_infrastructure
        and resources["workloads"]
        and state_ready(args.terraform, run_root, "workloads", contract)
    ):
        retained_workload_outputs = workload_endpoint_outputs(
            args.terraform, run_root, contract
        )

    destroy_order: tuple[tuple[str, Path | None], ...] = (
        ("workloads", downstream[1] if downstream else None),
        ("foundation", downstream[0] if downstream else None),
    )
    if not retain_infrastructure:
        destroy_order += (("infrastructure", infrastructure_variables),)

    destroyed_stages: list[str] = []
    for stage, variable_file in destroy_order:
        if not resources[stage]:
            continue
        if variable_file is None:
            raise DeploymentError(
                f"cannot destroy {stage}: its generated private variable file is unavailable"
            )
        plan_path, destroy_plan, environment = plan_stage(
            args.terraform,
            run_root=run_root,
            stage=stage,
            contract=contract,
            variable_file=variable_file,
            destroy=True,
        )
        apply_plan(
            args.terraform,
            stage_root(stage),
            plan_path,
            environment,
            custody_guard=custody_guard,
            indeterminate_root=run_root,
            stage=stage,
            custody_project_id=str(provider_attestation["project_id"]),
            custody_cluster_id=str(provider_attestation["cluster_id"]),
            custody_transaction_id=custody_transaction_id,
            credential_epochs_sha256=credential_epochs_sha256,
            target_postconditions_sha256=_json_sha256(
                _terraform_value_projection(destroy_plan, "planned_values")
            ),
            journal_guard=journal_guard,
            settlement_guard=settlement_guard,
        )
        destroyed_stages.append(stage)

    if retain_infrastructure:
        assert dynamic is not None
        storage = dynamic.get("reference_data_storage_contract")
        lifecycle = dynamic.get("reference_data_lifecycle")
        applied_status = retained_workload_outputs.get("reference_data")
        applied_contract = retained_workload_outputs.get("reference_data_contract")
        last_applied_status_service = (
            applied_status.get("status_service")
            if isinstance(applied_status, Mapping)
            else None
        )
        last_applied_pipeline = (
            applied_status.get("pipeline")
            if isinstance(applied_status, Mapping)
            else None
        )
        last_applied_plane = (
            applied_contract.get("plane")
            if isinstance(applied_contract, Mapping)
            else None
        )
        reference_data = (
            None
            if not reference_retained
            else {
                "lifecycle": lifecycle,
                "filesystem_id": storage.get("filesystem", {}).get("id"),
                "bucket_id": storage.get("object_storage", {}).get("id"),
                "bucket_name": storage.get("object_storage", {}).get("name"),
                "cpu_pool_id": storage.get("cpu_pool", {}).get("id"),
                "status_service": None,
                "pipeline": None,
                "last_applied": {
                    "status_service": last_applied_status_service,
                    "pipeline": last_applied_pipeline,
                },
            }
        )
        reference_data_contract = (
            None
            if not reference_retained
            else {
                "storage": storage,
                "plane": None,
                "last_applied_plane": last_applied_plane,
            }
        )
        scientific_storage = dynamic.get("scientific_artifacts_storage_contract")
        scientific_lifecycle = dynamic.get("scientific_artifacts_lifecycle")
        scientific_artifacts = (
            None
            if not scientific_retained
            else {
                "lifecycle": scientific_lifecycle,
                "bucket_id": (scientific_storage or {})
                .get("object_storage", {})
                .get("id"),
                "bucket_name": (scientific_storage or {})
                .get("object_storage", {})
                .get("name"),
                "object_key": (scientific_storage or {})
                .get("layout", {})
                .get("object_key"),
                "last_applied": retained_workload_outputs.get("scientific_artifacts"),
            }
        )
        scientific_artifacts_contract = (
            None
            if not scientific_retained
            else {
                "storage": scientific_storage,
            }
        )
        adoption_lifecycle = lifecycle if reference_retained else scientific_lifecycle
        receipt_path = run_root / (
            "reference-data-retention.json"
            if reference_retained
            else "scientific-artifacts-retention.json"
        )
        result = {
            "schema": "fs2-serve.nebius.ai/destroy-result/v1",
            "status": "infrastructure-retained",
            "completion": "full-stack-destroy-incomplete-infrastructure-retained",
            "destroyed_stages": destroyed_stages,
            "retained_stages": ["infrastructure"],
            "reference_data": reference_data,
            "reference_data_contract": reference_data_contract,
            "scientific_artifacts": scientific_artifacts,
            "scientific_artifacts_contract": scientific_artifacts_contract,
            "adoption": {
                "required_before_full_destroy": True,
                "status": (adoption_lifecycle or {}).get("adoption_status"),
                "receipt_path": str(receipt_path),
                "next_step": (
                    "adopt or migrate every retained filesystem and bucket into a "
                    "separate durable Terraform state before destroying infrastructure"
                ),
            },
        }
        private_json(receipt_path, result)
        print(json.dumps(result, indent=2))
        return

    print(
        json.dumps(
            {
                "schema": "fs2-serve.nebius.ai/destroy-result/v1",
                "status": "destroyed",
                "completion": "complete",
                "destroyed_stages": destroyed_stages,
                "retained_stages": [],
                "reference_data": None,
                "reference_data_contract": None,
                "scientific_artifacts": None,
                "scientific_artifacts_contract": None,
                "evidence_root": str(run_root),
            },
            indent=2,
        )
    )


def status_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    stages: dict[str, Any] = {}
    workloads_ready = False
    infrastructure_reference_data: Any | None = None
    infrastructure_reference_data_contract: Any | None = None
    infrastructure_scientific_artifacts: Any | None = None
    for stage in ("infrastructure", "foundation", "workloads"):
        state, _, _ = stage_paths(run_root, stage)
        if not state.exists():
            stages[stage] = {"state": "absent", "addresses": 0, "complete": False}
            continue
        environment = stage_environment(
            run_root, stage, contract, include_secrets=False
        )
        terraform_init(args.terraform, stage_root(stage), state, environment)
        addresses = state_addresses(args.terraform, stage_root(stage), environment)
        complete = state_ready(args.terraform, run_root, stage, contract)
        stages[stage] = {
            "state": "ready" if complete else ("partial" if addresses else "empty"),
            "addresses": len(addresses),
            "complete": complete,
        }
        if stage == "workloads":
            workloads_ready = complete
        if (
            stage == "infrastructure"
            and complete
            and contract.get("stages", {})
            .get("infrastructure", {})
            .get("reference_data", {})
            .get("enabled")
            is True
        ):
            storage = terraform_optional_json_output(
                args.terraform,
                INFRA_ROOT,
                "reference_data_storage_contract",
                environment,
            )
            if isinstance(storage, Mapping):
                lifecycle = terraform_optional_json_output(
                    args.terraform,
                    INFRA_ROOT,
                    "reference_data_lifecycle",
                    environment,
                )
                infrastructure_reference_data = {
                    "lifecycle": (
                        lifecycle
                        if isinstance(lifecycle, Mapping)
                        else storage.get("lifecycle")
                    ),
                    "filesystem_id": storage.get("filesystem", {}).get("id"),
                    "bucket_id": storage.get("object_storage", {}).get("id"),
                    "bucket_name": storage.get("object_storage", {}).get("name"),
                    "cpu_pool_id": storage.get("cpu_pool", {}).get("id"),
                    "status_service": None,
                    "pipeline": None,
                }
                infrastructure_reference_data_contract = {
                    "storage": storage,
                    "plane": None,
                }
        if (
            stage == "infrastructure"
            and complete
            and contract.get("stages", {})
            .get("infrastructure", {})
            .get("scientific_artifacts", {})
            .get("enabled")
            is True
        ):
            artifact_storage = terraform_optional_json_output(
                args.terraform,
                INFRA_ROOT,
                "scientific_artifacts_storage_contract",
                environment,
            )
            if isinstance(artifact_storage, Mapping):
                artifact_lifecycle = terraform_optional_json_output(
                    args.terraform,
                    INFRA_ROOT,
                    "scientific_artifacts_lifecycle",
                    environment,
                )
                infrastructure_scientific_artifacts = {
                    "lifecycle": (
                        artifact_lifecycle
                        if isinstance(artifact_lifecycle, Mapping)
                        else artifact_storage.get("lifecycle")
                    ),
                    "bucket_id": artifact_storage.get("object_storage", {}).get("id"),
                    "bucket_name": artifact_storage.get("object_storage", {}).get(
                        "name"
                    ),
                    "endpoint": artifact_storage.get("object_storage", {}).get(
                        "endpoint"
                    ),
                    "region": artifact_storage.get("region"),
                    "object_key": artifact_storage.get("layout", {}).get("object_key"),
                    "writer_role": artifact_storage.get("writer", {}).get("role"),
                    "writer_paths": artifact_storage.get("writer", {}).get("paths"),
                    "secret_delivery": artifact_storage.get("writer", {}).get(
                        "secret_delivery"
                    ),
                    "retention": artifact_storage.get("retention"),
                    "credential_secret": "fs2-system/fs2-serve-artifact-store",
                }
    endpoints = (
        workload_endpoint_outputs(args.terraform, run_root, contract)
        if workloads_ready
        else {
            "mcp_endpoint_url": None,
            "admin_web_interface_url": None,
            "inference_base_url": None,
            "grafana_url": None,
            "alertmanager_url": None,
            "tempo_explore_url": None,
            "reference_data": None,
            "reference_data_contract": None,
            "scientific_artifacts": None,
            "scientific_artifacts_contract": None,
        }
    )
    # A previously applied workloads state can remain otherwise complete while the
    # newly enabled reference-data module is intentionally held behind its own
    # review gate. Keep the normal status surface truthful in that transition:
    # report the live infrastructure identities and retained lifecycle until the
    # workload-owned status service and pipeline replace this fallback.
    if (
        endpoints["reference_data"] is None
        and infrastructure_reference_data is not None
    ):
        endpoints["reference_data"] = infrastructure_reference_data
    if (
        endpoints["reference_data_contract"] is None
        and infrastructure_reference_data_contract is not None
    ):
        endpoints["reference_data_contract"] = infrastructure_reference_data_contract
    # The store can be provisioned and correct while the batch workloads that
    # consume it are still gated off. Report the live bucket identity rather
    # than pretending the feature is absent.
    if (
        endpoints.get("scientific_artifacts") is None
        and infrastructure_scientific_artifacts is not None
    ):
        endpoints["scientific_artifacts"] = infrastructure_scientific_artifacts
    print(
        json.dumps(
            {"run_root": str(run_root), "stages": stages, **endpoints},
            indent=2,
        )
    )


def output_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    """Print the intentionally requested sensitive post-apply access bundle."""
    if not state_ready(args.terraform, run_root, "workloads", contract):
        raise DeploymentError(
            "workloads are not applied; run inference-stack apply before requesting endpoints"
        )
    print(
        json.dumps(
            workload_access_bundle(args.terraform, run_root, contract),
            indent=2,
        )
    )


def internal_proxy_command(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> list[str]:
    """Build the non-secret command that serves an internal-only edge."""
    if not state_ready(args.terraform, run_root, "workloads", contract):
        raise DeploymentError(
            "workloads are not applied; run inference-stack apply before starting the proxy"
        )

    infrastructure_environment = stage_environment(
        run_root, "infrastructure", contract, include_secrets=False
    )
    infrastructure_state, _, _ = stage_paths(run_root, "infrastructure")
    terraform_init(
        args.terraform,
        INFRA_ROOT,
        infrastructure_state,
        infrastructure_environment,
    )
    cluster_id = terraform_json_output(
        args.terraform, INFRA_ROOT, "cluster_id", infrastructure_environment
    )
    cluster_name = terraform_json_output(
        args.terraform, INFRA_ROOT, "cluster_name", infrastructure_environment
    )
    public_edge = terraform_json_output(
        args.terraform,
        INFRA_ROOT,
        "public_edge_contract",
        infrastructure_environment,
    )
    kubeconfig, _ = ensure_kubeconfig(
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
        run_root=run_root,
        cluster_id=cluster_id,
        cluster_name=cluster_name,
    )

    if not isinstance(public_edge, dict) or public_edge.get("mode") != "internal-only":
        raise DeploymentError(
            "this deployment has a public edge and does not require an operator proxy"
        )
    port_forward = public_edge.get("port_forward")
    if not isinstance(port_forward, dict) or port_forward.get("enabled") is not True:
        raise DeploymentError("the Terraform port-forward contract is malformed")
    expected = {
        "bind_address": "127.0.0.1",
        "control_plane_service": "fs2-serve-control-plane",
        "control_plane_port": 8080,
        "admin_console_service": "fs2-serve-control-plane-admin-console",
        "admin_console_port": 8080,
    }
    if any(port_forward.get(key) != value for key, value in expected.items()):
        raise DeploymentError("the Terraform port-forward contract is unsupported")
    try:
        local_ports = [
            int(port_forward["control_plane_local_port"]),
            int(port_forward["admin_console_local_port"]),
            int(port_forward["operator_proxy_port"]),
        ]
    except (KeyError, TypeError, ValueError) as exc:
        raise DeploymentError(
            "the Terraform port-forward contract is malformed"
        ) from exc
    application_origin = f"http://localhost:{local_ports[2]}"
    operator_endpoint = f"http://127.0.0.1:{local_ports[2]}"
    if (
        port_forward.get("application_origin") != application_origin
        or port_forward.get("operator_endpoint") != operator_endpoint
    ):
        raise DeploymentError("the Terraform loopback origins do not match its ports")
    endpoints = workload_endpoint_outputs(args.terraform, run_root, contract)
    expected_endpoints = {
        "mcp_endpoint_url": f"{application_origin}/mcp",
        "admin_web_interface_url": f"{application_origin}/admin/",
    }
    if any(endpoints.get(key) != value for key, value in expected_endpoints.items()):
        raise DeploymentError(
            "the workload endpoint outputs do not match the edge contract"
        )

    return [
        sys.executable,
        str(INTERNAL_EDGE_PROXY),
        "--kubeconfig",
        str(kubeconfig),
        "--context",
        cluster_name,
        "--kubectl",
        args.kubectl,
        "--control-plane-local-port",
        str(local_ports[0]),
        "--admin-console-local-port",
        str(local_ports[1]),
        "--operator-proxy-port",
        str(local_ports[2]),
        "--mcp-endpoint-url",
        endpoints["mcp_endpoint_url"],
        "--admin-web-interface-url",
        endpoints["admin_web_interface_url"],
    ]


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Plan, apply, inspect, or destroy Kubernetes inference from one terraform.tfvars file."
    )
    parser.add_argument(
        "command",
        choices=(
            "validate",
            "preflight",
            "plan",
            "apply",
            "reconcile-indeterminate",
            "destroy",
            "status",
            "output",
            "proxy",
        ),
    )
    parser.add_argument(
        "--var-file",
        type=Path,
        default=DEPLOY_ROOT / "terraform.tfvars",
        help="customer terraform.tfvars file (default: k8s-inference/terraform.tfvars)",
    )
    parser.add_argument(
        "--run-root",
        type=Path,
        help="private state/evidence directory; defaults to an XDG state path bound to the tfvars path",
    )
    parser.add_argument("--terraform", default="terraform")
    parser.add_argument("--kubectl", default="kubectl")
    parser.add_argument("--nebius", default="nebius")
    parser.add_argument(
        "--crane",
        default="crane",
        help="OCI registry client used for digest-preserving regional mirrors",
    )
    parser.add_argument(
        "--nebius-profile",
        default=os.environ.get("NEBIUS_PROFILE", "sandbox"),
        help="authenticated Nebius CLI profile (default: NEBIUS_PROFILE or sandbox)",
    )
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    os.umask(0o077)
    args = parse_args(argv)
    require_terraform_version(args.terraform)
    variable_file = args.var_file.expanduser().resolve()
    if not variable_file.is_file():
        raise DeploymentError(
            f"configuration does not exist: {variable_file}; copy terraform.tfvars.example first"
        )
    run_root = (args.run_root or default_run_root(variable_file)).expanduser().resolve()
    private_directory(run_root)

    lock_path = run_root / ".inference-stack.lock"
    if lock_path.is_symlink():
        raise DeploymentError(f"lock path must not be a symlink: {lock_path}")
    with lock_path.open("a+", encoding="utf-8") as lock:
        lock_path.chmod(0o600)
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise DeploymentError(
                f"another inference-stack process owns {run_root}"
            ) from exc

        contract, configuration_environment = validate_configuration(
            args.terraform, variable_file, run_root
        )
        proxy_arguments: list[str] | None = None
        commit = source_commit()
        if args.command == "validate":
            validate_stage_roots(args.terraform, run_root)
            print(
                json.dumps(
                    {
                        "status": "valid",
                        "run_root": str(run_root),
                        "deployment": contract["name"],
                        "profiles": contract["profiles"],
                        "accelerator_pools": contract["selected_accelerator_pool_ids"],
                        "models": contract["selected_model_ids"],
                    },
                    indent=2,
                )
            )
        elif args.command == "preflight":
            preflight_accelerators(args, contract)
        elif args.command == "plan":
            plan_stack(args, run_root, contract, commit)
        elif args.command == "apply":
            require_deployable_images(contract)
            apply_stack(
                args,
                run_root,
                contract,
                commit,
                configuration_environment,
            )
        elif args.command == "reconcile-indeterminate":
            reconcile_indeterminate_stack(
                args,
                run_root,
                contract,
                configuration_environment,
            )
        elif args.command == "destroy":
            destroy_stack(args, run_root, contract, commit)
        elif args.command == "output":
            output_stack(args, run_root, contract)
        elif args.command == "proxy":
            proxy_arguments = internal_proxy_command(args, run_root, contract)
        else:
            status_stack(args, run_root, contract)
    if proxy_arguments is not None:
        try:
            run(proxy_arguments, env=clean_environment())
        except KeyboardInterrupt:
            pass
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except DeploymentError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(2)
