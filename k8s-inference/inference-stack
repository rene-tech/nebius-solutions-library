    variables["nebius_iam_token_file"] = CAPSULE_TOOL_PATHS["nebius_token"]
    path = run_root / "infrastructure.tfvars.json"
    private_json(path, variables)
    return path


def ensure_kubeconfig(
    *,
    nebius: str,
    nebius_profile: str,
    kubectl: str,
    run_root: Path,
    cluster_id: str,
    cluster_name: str,
) -> tuple[Path, str]:
    require_brokered_profile(nebius_profile)
    kubeconfig = run_root / "kubeconfig"
    if kubeconfig.is_symlink():
        raise DeploymentError(f"kubeconfig path must not be a symlink: {kubeconfig}")
    environment = brokered_auth_environment()
    environment["KUBECONFIG"] = str(kubeconfig)
    run(
        [
            nebius,
            "mk8s",
            "cluster",
            "get-credentials",
            "--id",
            cluster_id,
            "--external",
            "--force",
            "--context-name",
            cluster_name,
        ],
        env=environment,
    )
    if not kubeconfig.is_file():
        raise DeploymentError("Nebius CLI did not create the run-scoped kubeconfig")
    kubeconfig.chmod(0o600)
    result = run(
        [
            kubectl,
            "--kubeconfig",
            str(kubeconfig),
            "--context",
            cluster_name,
            "get",
            "namespace",
            "kube-system",
            "-o",
            "jsonpath={.metadata.uid}",
        ],
        env=environment,
        capture=True,
    )
    uid = result.stdout.strip()
    if len(uid) < 20:
        raise DeploymentError("kube-system did not return a valid namespace UID")
    return kubeconfig, uid


def sealed_normal_proxy_kubeconfig(
    *, kubectl: str, run_root: Path, cluster_id: str, cluster_name: str
) -> tuple[Path, tuple[int, ...]]:
    """Obtain an ordinary proxy credential without handing it to the operator."""

    raise DeploymentError(
        "retired: proxy credentials remain in the root broker and are never exported"
    )
    del kubectl
    contract = retained_run_contract(run_root)
    configuration = _brokered_ordinary_kubeconfig(
        cluster_id=cluster_id,
        cluster_name=cluster_name,
        deployment_contract_sha256=hashlib.sha256(
            _canonical_bytes(contract) + b"\n"
        ).hexdigest(),
    )
    sealed = _sealed_memfd(
        "ordinary-proxy-kubeconfig", _canonical_bytes(configuration) + b"\n"
    )
    return Path(f"/proc/self/fd/{sealed}"), (sealed,)


def existing_read_only_kubeconfig(
    *,
    kubectl: str,
    run_root: Path,
    cluster_id: str,
    cluster_name: str,
    configuration: object | None = None,
    activation_envelope: object | None = None,
) -> tuple[Path, tuple[int, ...], str, str, str]:
    """Seal one tenant/model-scoped, at-most-seven-day debug credential."""

    raise DeploymentError(
        "retired: debug credentials remain in the root broker and are never exported"
    )
    if activation_envelope is None:
        activation_envelope = _current_debug_activation(run_root)
    activation = _verify_debug_activation(activation_envelope)
    if configuration is None:
        configuration = _brokered_debug_kubeconfig(
            activation_envelope,
            activation,
        )
    if not isinstance(configuration, dict) or set(configuration) != {
        "apiVersion",
        "clusters",
        "contexts",
        "current-context",
        "kind",
        "preferences",
        "users",
    }:
        raise DeploymentError(
            "debug kubeconfig must be one exact self-contained JSON configuration"
        )
    clusters = configuration["clusters"]
    contexts = configuration["contexts"]
    users = configuration["users"]
    if (
        configuration["apiVersion"] != "v1"
        or configuration["kind"] != "Config"
        or configuration["preferences"] != {}
        or configuration["current-context"] != cluster_name
        or not isinstance(clusters, list)
        or not isinstance(contexts, list)
        or not isinstance(users, list)
        or len(clusters) != 1
        or len(contexts) != 1
        or len(users) != 1
    ):
        raise DeploymentError("debug kubeconfig does not name one exact context")
    cluster = clusters[0]
    context = contexts[0]
    user = users[0]
    if (
        not isinstance(cluster, dict)
        or set(cluster) != {"name", "cluster"}
        or cluster["name"] != cluster_name
        or not isinstance(cluster["cluster"], dict)
        or set(cluster["cluster"]) != {"certificate-authority-data", "server"}
        or not isinstance(cluster["cluster"]["server"], str)
        or not cluster["cluster"]["server"].startswith("https://")
        or not isinstance(context, dict)
        or set(context) != {"name", "context"}
        or context["name"] != cluster_name
        or not isinstance(context["context"], dict)
        or set(context["context"]) != {"cluster", "namespace", "user"}
        or context["context"]["cluster"] != cluster_name
        or context["context"]["namespace"] != "fs2-system"
        or not isinstance(user, dict)
        or set(user) != {"name", "user"}
        or user["name"] != context["context"]["user"]
        or not isinstance(user["user"], dict)
        or set(user["user"]) != {"client-certificate-data", "client-key-data"}
    ):
        raise DeploymentError(
            "debug kubeconfig contains an external path, plugin, token, or unsupported authority"
        )
    try:
        ca_raw = base64.b64decode(
            cluster["cluster"]["certificate-authority-data"], validate=True
        )
        certificate_raw = base64.b64decode(
            user["user"]["client-certificate-data"], validate=True
        )
        key_raw = base64.b64decode(
            user["user"]["client-key-data"], validate=True
        )
    except (ValueError, TypeError, binascii.Error) as exc:
        raise DeploymentError("debug kubeconfig embeds malformed credential data") from exc
    if any(not value or len(value) > 1024 * 1024 for value in (ca_raw, certificate_raw, key_raw)):
        raise DeploymentError("debug kubeconfig embeds an unbounded credential")
    if set(activation) != {
        "activated_at",
        "app_id",
        "authorization",
        "certificate_sha256",
        "cluster_ca_sha256",
        "cluster_id",
        "cluster_name",
        "credential_broker_id",
        "enabled",
        "expires_at",
        "issuer",
        "kubeconfig_sha256",
        "model_id",
        "records_retention_dependency",
        "schema",
        "server",
        "tenant_id",
    }:
        raise DeploymentError("debug activation violates its exact tenant/model schema")
    try:
        activated_at = datetime.fromisoformat(
            str(activation["activated_at"]).replace("Z", "+00:00")
        )
        expires_at = datetime.fromisoformat(
            str(activation["expires_at"]).replace("Z", "+00:00")
        )
    except ValueError as exc:
        raise DeploymentError("debug activation timestamps are malformed") from exc
    now = datetime.now(timezone.utc)
    if (
        activation["schema"] != "fs2-serve.nebius.ai/debug-activation/v1"
        or activation["enabled"] is not True
        or activation["records_retention_dependency"] != "SAI-02:90-day-purge"
        or not isinstance(activation["app_id"], str)
        or activation["cluster_id"] != cluster_id
        or activation["cluster_name"] != cluster_name
        or not isinstance(activation["credential_broker_id"], str)
        or re.fullmatch(
            r"[a-z0-9][a-z0-9._-]{0,127}", activation["credential_broker_id"]
        )
        is None
        or activation["server"] != cluster["cluster"]["server"]
        or activation["cluster_ca_sha256"] != hashlib.sha256(ca_raw).hexdigest()
        or activation["kubeconfig_sha256"]
        != hashlib.sha256(_canonical_bytes(configuration) + b"\n").hexdigest()
        or not isinstance(activation["tenant_id"], str)
        or re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}", activation["tenant_id"])
        is None
        or not isinstance(activation["model_id"], str)
        or re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._/-]{0,255}", activation["model_id"])
        is None
        or activated_at.tzinfo is None
        or expires_at.tzinfo is None
        or not (activated_at <= now < expires_at)
        or expires_at - activated_at > timedelta(days=7)
        or activation["certificate_sha256"]
        != hashlib.sha256(certificate_raw).hexdigest()
    ):
        raise DeploymentError(
            "debug activation is not current, tenant/model scoped, or bounded to seven days"
        )
    try:
        UUID(activation["app_id"])
    except ValueError as exc:
        raise DeploymentError("debug activation App identity is malformed") from exc
    authorization = activation["authorization"]
    expected_identity = f"fs2-debug:{activation['tenant_id']}:{activation['model_id']}"
    expected_services = [
        "fs2-serve-control-plane",
        "fs2-serve-control-plane-admin-console",
    ]
    expected_role_rules = [
        {
            "api_groups": [""],
            "resource_names": expected_services,
            "resources": ["services"],
            "verbs": ["get"],
        },
        {
            "api_groups": [""],
            "resource_names": [],
            "resources": ["pods"],
            "verbs": ["get", "list"],
        },
        {
            "api_groups": [""],
            "resource_names": [],
            "resources": ["pods/portforward"],
            "verbs": ["create"],
        },
    ]
    if (
        not isinstance(authorization, dict)
        or set(authorization) != {
            "decision",
            "identity",
            "namespace",
            "review_sha256",
            "role",
            "role_binding",
        }
        or authorization["decision"] != "allow-port-forward-only"
        or authorization["identity"] != expected_identity
        or authorization["namespace"] != "fs2-system"
        or not isinstance(authorization["review_sha256"], str)
        or re.fullmatch(r"[a-f0-9]{64}", authorization["review_sha256"]) is None
        or authorization["review_sha256"] == "0" * 64
    ):
        raise DeploymentError(
            "debug activation lacks the exact signed port-forward authorization review"
        )
    role = authorization["role"]
    binding = authorization["role_binding"]
    if (
        not isinstance(role, dict)
        or set(role) != {
            "name",
            "namespace",
            "resource_version",
            "rules",
            "uid",
        }
        or role["name"] != "fs2-debug-port-forward"
        or role["namespace"] != "fs2-system"
        or role["rules"] != expected_role_rules
        or not isinstance(role["resource_version"], str)
        or not role["resource_version"]
        or re.fullmatch(r"[a-f0-9-]{20,64}", str(role["uid"])) is None
        or not isinstance(binding, dict)
        or set(binding) != {
            "name",
            "namespace",
            "resource_version",
            "role_name",
            "subjects",
            "uid",
        }
        or binding["name"] != "fs2-debug-port-forward"
        or binding["namespace"] != "fs2-system"
        or binding["role_name"] != role["name"]
        or binding["subjects"] != [{"kind": "User", "name": expected_identity}]
        or not isinstance(binding["resource_version"], str)
        or not binding["resource_version"]
        or re.fullmatch(r"[a-f0-9-]{20,64}", str(binding["uid"])) is None
    ):
        raise DeploymentError(
            "debug activation does not bind the exact live Role and RoleBinding"
        )
    ca_fd = _sealed_memfd("debug-ca", ca_raw)
    certificate_fd = _sealed_memfd("debug-certificate", certificate_raw)
    key_fd = _sealed_memfd("debug-key", key_raw)
    kubeconfig_raw = _canonical_bytes(configuration) + b"\n"
    kubeconfig_fd = _sealed_memfd("debug-kubeconfig", kubeconfig_raw)
    material_fds = (ca_fd, certificate_fd, key_fd, kubeconfig_fd)
    pass_fds = tuple(sorted({*CAPSULE_PASS_FDS, *material_fds}))
    environment = clean_environment()
    environment.update({"OPENSSL_CONF": "/dev/null", "OPENSSL_MODULES": "/nonexistent"})
    keep_kubeconfig = False
    try:
        identity = subprocess.run(
            [
                CAPSULE_TOOL_PATHS["openssl"],
                "x509",
                "-in",
                f"/proc/self/fd/{certificate_fd}",
                "-noout",
                "-subject",
                "-nameopt",
                "RFC2253",
                "-enddate",
            ],
            env=environment,
            text=True,
            capture_output=True,
            check=False,
            pass_fds=pass_fds,
            close_fds=True,
        )
        expected_subject = f"subject=CN={expected_identity}"
        output_lines = identity.stdout.strip().splitlines()
        if identity.returncode != 0 or expected_subject not in output_lines:
            raise DeploymentError(
                "debug certificate subject is not bound to its tenant/model"
            )
        expiry_lines = [line for line in output_lines if line.startswith("notAfter=")]
        if len(expiry_lines) != 1:
            raise DeploymentError("debug certificate expiry is unavailable")
        try:
            certificate_expiry = datetime.strptime(
                expiry_lines[0][len("notAfter=") :], "%b %d %H:%M:%S %Y %Z"
            ).replace(tzinfo=timezone.utc)
        except ValueError as exc:
            raise DeploymentError("debug certificate expiry is malformed") from exc
        if (
            activated_at.microsecond != 0
            or expires_at.microsecond != 0
            or certificate_expiry != expires_at
            or certificate_expiry > activated_at + timedelta(days=7)
        ):
            raise DeploymentError(
                "debug certificate expiry must equal the authorized activation expiry"
            )
        certificate_public = subprocess.run(
            [
                CAPSULE_TOOL_PATHS["openssl"],
                "x509",
                "-in",
                f"/proc/self/fd/{certificate_fd}",
                "-noout",
                "-pubkey",
            ],
            env=environment,
            text=True,
            capture_output=True,
            check=False,
            pass_fds=pass_fds,
            close_fds=True,
        )
        private_public = subprocess.run(
            [
                CAPSULE_TOOL_PATHS["openssl"],
                "pkey",
                "-in",
                f"/proc/self/fd/{key_fd}",
                "-pubout",
            ],
            env=environment,
            text=True,
            capture_output=True,
            check=False,
            pass_fds=pass_fds,
            close_fds=True,
        )
        if (
            certificate_public.returncode != 0
            or private_public.returncode != 0
            or certificate_public.stdout != private_public.stdout
        ):
            raise DeploymentError("debug private key does not match its certificate")
        verify = subprocess.run(
            [
                CAPSULE_TOOL_PATHS["openssl"],
                "verify",
                "-CAfile",
                f"/proc/self/fd/{ca_fd}",
                f"/proc/self/fd/{certificate_fd}",
            ],
            env=environment,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            pass_fds=pass_fds,
            close_fds=True,
        )
        if verify.returncode != 0:
            raise DeploymentError(
                "debug certificate is not signed by the embedded cluster CA"
            )
        keep_kubeconfig = True
        return (
            Path(f"/proc/self/fd/{kubeconfig_fd}"),
            (kubeconfig_fd,),
            activation["tenant_id"],
            activation["model_id"],
            activation["app_id"],
        )
    finally:
        for descriptor in (ca_fd, certificate_fd, key_fd):
            os.close(descriptor)
        if not keep_kubeconfig:
            os.close(kubeconfig_fd)


def legacy_registry_delivery_contract(
    contract: Mapping[str, Any], target_contract: Mapping[str, Any]
) -> dict[str, Any]:
    """Upgrade an existing state whose target registry predates the v1 output."""
    registry = target_contract.get("source_registry")
    if not isinstance(registry, dict):
        raise DeploymentError(
            "the existing infrastructure state has neither a registry-delivery output nor a legacy target registry"
        )
    registry_id = str(registry.get("id", ""))
    fqdn = str(registry.get("fqdn", "")).rstrip("/")
    if not registry_id.startswith("registry-") or not fqdn:
        raise DeploymentError("the legacy infrastructure target registry is malformed")
    policy = contract["artifact_delivery"]
    target_region = contract["target"]["region"]
    cross_region_hosts = sorted(
        host
        for host in policy["source_hosts"]
        if (match := re.fullmatch(r"cr\.([a-z0-9-]+)\.nebius\.cloud", host))
        and match.group(1) != target_region
    )
    return {
        "schema": "fs2-serve.nebius.ai/registry-delivery/v1",
        "mode": policy["mode"],
        "repository_prefix": policy["repository_prefix"],
        "target_registry": {
            "id": registry_id,
            "project_id": registry.get("project_id", contract["target"]["project_id"]),
            "region": target_region,
            "fqdn": fqdn,
            "repository_root": f"{fqdn}/{registry_id.removeprefix('registry-')}",
        },
        "upstream": {
            "source_hosts": policy["source_hosts"],
            "nebius_registries": {},
        },
        "promotion_cross_region_required": bool(cross_region_hosts)
        and policy["mode"] == "regional-mirror",
        "runtime_cross_region_pull_required": bool(cross_region_hosts)
        and policy["mode"] == "direct-source",
        "cross_region_source_hosts": cross_region_hosts,
        "derived_from_legacy_state": True,
    }


def infrastructure_outputs(
    terraform: str,
    run_root: Path,
    contract: Mapping[str, Any],
    *,
    nebius: str,
    nebius_profile: str,
    kubectl: str,
) -> dict[str, Any]:
    environment = stage_environment(run_root, "infrastructure", contract)
    state, _, _ = stage_paths(run_root, "infrastructure")
    terraform_init(terraform, INFRA_ROOT, state, environment)
    cluster_id = terraform_json_output(terraform, INFRA_ROOT, "cluster_id", environment)
    cluster_name = terraform_json_output(
        terraform, INFRA_ROOT, "cluster_name", environment
    )
    kubeconfig, kube_system_uid = ensure_kubeconfig(
        nebius=nebius,
        nebius_profile=nebius_profile,
        kubectl=kubectl,
        run_root=run_root,
        cluster_id=cluster_id,
        cluster_name=cluster_name,
    )
    target_contract = terraform_json_output(
        terraform, INFRA_ROOT, "target_contract", environment
    )
    registry_delivery = terraform_optional_json_output(
        terraform, INFRA_ROOT, "registry_delivery_contract", environment
    )
    if registry_delivery is None:
        registry_delivery = legacy_registry_delivery_contract(contract, target_contract)
    reference_data_enabled = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("reference_data", {})
        .get("enabled")
        is True
    )
    reference_data_storage = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "reference_data_storage_contract", environment
        )
        if reference_data_enabled
        else None
    )
    reference_data_access = (
        terraform_optional_json_output(
            terraform,
            INFRA_ROOT,
            "reference_data_object_storage_access",
            environment,
        )
        if reference_data_enabled
        else None
    )
    reference_data_lifecycle = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "reference_data_lifecycle", environment
        )
        if reference_data_enabled
        else None
    )
    scientific_artifacts_enabled = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("scientific_artifacts", {})
        .get("enabled")
        is True
    )
    scientific_artifacts_storage = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "scientific_artifacts_storage_contract", environment
        )
        if scientific_artifacts_enabled
        else None
    )
    # Carries only the access-key ID, the opaque MysteryBox reference and a
    # revision. The S3 secret is resolved ephemerally inside the workloads
    # apply and never reaches this process, a tfvars file or a receipt.
    scientific_artifacts_access = (
        terraform_optional_json_output(
            terraform,
            INFRA_ROOT,
            "scientific_artifacts_object_storage_access",
            environment,
        )
        if scientific_artifacts_enabled
        else None
    )
    scientific_artifacts_lifecycle = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "scientific_artifacts_lifecycle", environment
        )
        if scientific_artifacts_enabled
        else None
    )
    # A general CPU pool is optional, so the output is read only when the facade
    # declared one. Its absence is a valid deployment, not a missing handoff.
    general_cpu_pools = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "general_cpu_pool_contract", environment
        )
        if contract.get("stages", {}).get("infrastructure", {}).get("cpu_pools")
        else None
    )
    return {
        "run_root": str(run_root.resolve()),
        "nebius_profile": nebius_profile,
        "kubeconfig_path": str(kubeconfig.resolve()),
        "run_id": contract["run_id"],
        "cluster_id": cluster_id,
        "general_cpu_pool_contract": general_cpu_pools,
        "cluster_name": cluster_name,
        "kube_context": cluster_name,
        "kube_system_uid": kube_system_uid,
        "project_id": contract["target"]["project_id"],
        "target_contract": target_contract,
        "infrastructure_contract": terraform_optional_json_output(
            terraform, INFRA_ROOT, "infrastructure_contract", environment
        ),
        "accelerator_pool_contract": terraform_json_output(
            terraform, INFRA_ROOT, "accelerator_pool_contract", environment
        ),
        "registry_delivery_contract": registry_delivery,
        "public_edge_contract": terraform_json_output(
            terraform, INFRA_ROOT, "public_edge_contract", environment
        ),
        "public_edge_availability_contract": terraform_json_output(
            terraform,
            INFRA_ROOT,
            "public_edge_availability_contract",
            environment,
        ),
        "reference_data_storage_contract": reference_data_storage,
        "reference_data_object_storage_access": reference_data_access,
        "reference_data_lifecycle": reference_data_lifecycle,
        "scientific_artifacts_storage_contract": scientific_artifacts_storage,
        "scientific_artifacts_object_storage_access": scientific_artifacts_access,
        "scientific_artifacts_lifecycle": scientific_artifacts_lifecycle,
    }


def existing_controller_ownership(
    run_root: Path, cluster_id: str, handoff_receipt: str | None
) -> bool:
    """Recognize a completed handoff without repeating it for every new model.

    The initial receipt still proves the transition. Later model/template
    changes do not invalidate that transition when the same accepted state
    already has a single GPU controller owner and no legacy GPU serving objects.
    Exact static CPU services are a separate Terraform-owned lane.
    """
    state_path = run_root / "workloads.tfstate"
    if not handoff_receipt or state_path.is_symlink() or not state_path.is_file():
        return False
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
        resources = state["resources"]
        inputs = {
            resource["name"]: resource["instances"][0]["attributes"]["input"]["value"]
            for resource in resources
            if resource.get("mode") == "managed"
            and resource.get("type") == "terraform_data"
            and not resource.get("module")
            and resource.get("name") in {"cluster_contract", "model_controller_contract"}
        }
        controller = inputs["model_controller_contract"]
        accepted = controller.get("accepted_handoff_receipt") or controller.get("expected_handoff_receipt")
        if (
            inputs["cluster_contract"]["cluster_id"] != cluster_id
            or controller.get("workload_owner") != "controller"
            or accepted != handoff_receipt
        ):
            return False
        cpu_resources = set()
        for resource in resources:
            if (
                resource.get("mode") != "managed"
                or resource.get("type") != "terraform_data"
                or resource.get("name") != "cpu_model_runtime_contract"
                or resource.get("module")
            ):
                continue
            for instance in resource.get("instances", []):
                cpu = instance["attributes"]["input"]["value"]
                for document in (cpu["deployment"], cpu["service_manifest"]):
                    metadata = document["metadata"]
                    cpu_resources.add((document["kind"], metadata["namespace"], metadata["name"]))
                deployment = cpu["deployment"]
                account = deployment["spec"]["template"]["spec"].get("serviceAccountName")
                if account:
                    cpu_resources.add(("ServiceAccount", deployment["metadata"]["namespace"], account))
        for resource in resources:
            if resource.get("mode") != "managed" or resource.get("type") != "kubernetes_manifest":
                continue
            if resource.get("name") == "model_scaler" and resource.get("instances"):
                return False
            if resource.get("name") == "model":
                for instance in resource.get("instances", []):
                    manifest = instance["attributes"]["manifest"]["value"]
                    metadata = manifest.get("metadata", {})
                    if (manifest.get("kind"), metadata.get("namespace"), metadata.get("name")) in cpu_resources:
                        continue
                    if manifest.get("kind") in {"Deployment", "Service", "ServiceAccount", "ConfigMap"}:
                        return False
        return True
    except (OSError, ValueError, KeyError, IndexError, TypeError):
        return False


def write_downstream_variables(
    run_root: Path,
    contract: Mapping[str, Any],
    dynamic: Mapping[str, Any],
) -> tuple[Path, Path]:
    identity_keys = (
        "run_root",
        "kubeconfig_path",
        "run_id",
        "cluster_id",
        "cluster_name",
        "kube_context",
        "kube_system_uid",
        "project_id",
        "target_contract",
        "infrastructure_contract",
        "accelerator_pool_contract",
        "public_edge_availability_contract",
    )
    identity = {key: dynamic[key] for key in identity_keys}
    foundation = {**contract["stages"]["foundation"], **identity}
    workloads = {
        **rewritten_workloads(contract, dynamic),
        **identity,
        "nebius_profile": dynamic.get("nebius_profile", "sandbox"),
        "nebius_iam_token_file": CAPSULE_TOOL_PATHS["nebius_token"],
        "public_edge_contract": dynamic["public_edge_contract"],
    }
    controller = workloads.get("model_controller")
    if isinstance(controller, Mapping):
        workloads["model_controller"] = {
            **controller,
            "existing_controller_ownership": existing_controller_ownership(
                run_root, dynamic["cluster_id"], controller.get("handoff_receipt")
            ),
        }
    reference_data = workloads.get("reference_data")
    if isinstance(reference_data, Mapping):
        enabled = reference_data.get("enabled") is True
        storage_contract = dynamic.get("reference_data_storage_contract")
        object_access = dynamic.get("reference_data_object_storage_access")
        if enabled and (
            not isinstance(storage_contract, Mapping)
            or not isinstance(object_access, Mapping)
        ):
            raise DeploymentError(
                "enabled reference data requires complete infrastructure storage and object-access outputs"
            )
        workloads["reference_data"] = {
            **reference_data,
            "storage_contract": storage_contract if enabled else None,
            "object_storage_access": object_access if enabled else None,
        }
    scientific_artifacts = workloads.get("scientific_artifacts")
    if isinstance(scientific_artifacts, Mapping):
        enabled = scientific_artifacts.get("enabled") is True
        storage_contract = dynamic.get("scientific_artifacts_storage_contract")
        object_access = dynamic.get("scientific_artifacts_object_storage_access")
        if enabled and (
            not isinstance(storage_contract, Mapping)
            or not isinstance(object_access, Mapping)
        ):
            raise DeploymentError(
                "an enabled scientific artifact store requires complete infrastructure "
                "bucket and object-access outputs"
            )
        if enabled and set(object_access) != {
            "key_id",
            "access_key_id",
            "secret_reference_id",
            "resource_version",
        }:
            raise DeploymentError(
                "the scientific artifact access handoff must contain exactly the key's "
                "non-secret identifiers: resource ID, access-key ID, MysteryBox reference "
                "and cloud resource version"
            )
        workloads["scientific_artifacts"] = {
            **scientific_artifacts,
            "storage_contract": storage_contract if enabled else None,
            "object_storage_access": object_access if enabled else None,
        }
    general_cpu_lane = workloads.get("general_cpu_lane")
    if isinstance(general_cpu_lane, Mapping):
        pool_contract = dynamic.get("general_cpu_pool_contract")
        if general_cpu_lane.get("enabled") is True and not isinstance(
            pool_contract, Mapping
        ):
            raise DeploymentError(
                "an enabled general CPU lane requires the infrastructure general-CPU pool contract"
            )
        if isinstance(pool_contract, Mapping):
            # The lane exists to keep general aggregation off the reference-data
            # nodes, so a pool contract that claims that filesystem is refused
            # rather than quietly admitted.
            if pool_contract.get("reference_data_filesystem") is not False:
                raise DeploymentError(
                    "a general CPU pool must never carry the reference-data filesystem"
                )
            if pool_contract.get("schema") != "fs2-serve.nebius.ai/general-cpu-pools/v1":
                raise DeploymentError(
                    "the general CPU pool handoff must be the v1 general-CPU pool contract"
                )
        workloads["general_cpu_pools"] = (
            pool_contract if general_cpu_lane.get("enabled") is True else None
        )
    scientific_batch = workloads.get("scientific_batch")
    if isinstance(scientific_batch, Mapping):
        artifacts_enabled = (
            isinstance(scientific_artifacts, Mapping)
            and scientific_artifacts.get("enabled") is True
        )
        if scientific_batch.get("enabled") is True and not artifacts_enabled:
            raise DeploymentError(
                "staged scientific batch execution requires the dedicated artifact store"
            )
        if scientific_batch.get("writes_enabled") is True and not (
            scientific_batch.get("enabled") is True
        ):
            raise DeploymentError(
                "scientific batch Kubernetes writes require the batch controller gate"
            )
    admin_contract = contract.get("admin_configuration", {})
    if isinstance(admin_contract, Mapping) and admin_contract.get("enabled") is True:
        configuration, configuration_sha256, scaling = derived_admin_configuration(
            contract,
            dynamic,
            workloads,
        )
        workloads.update(
            {
                "admin_configuration": configuration,
                "admin_configuration_sha256": configuration_sha256,
                "model_scaling_overrides": scaling,
            }
        )
    if foundation["grafana_publication"]["enabled"]:
        edge = dynamic["public_edge_contract"]
        origin = edge.get("public_origin")
        parsed = urlsplit(origin or "")
        if (
            edge.get("mode") != "public"
            or parsed.scheme != "https"
            or not parsed.hostname
            or parsed.path not in ("", "/")
            or parsed.query
            or parsed.fragment
            or parsed.username
            or parsed.password
        ):
            raise DeploymentError(
                "external Grafana publication requires an exact HTTPS public origin from the infrastructure output"
            )
        origin = origin.rstrip("/")
        foundation["grafana_publication"] = {
            **foundation["grafana_publication"],
            "external_base_url": origin,
        }
        alertmanager_enabled = (
            isinstance(foundation.get("alertmanager"), Mapping)
            and foundation["alertmanager"].get("enabled") is True
        )
        workloads["admin_observability_links"] = {
            "allowed_hosts": [parsed.hostname],
            "grafana": {
                "url": f"{origin}/admin/observability/grafana",
                "verified_external_route": True,
            },
            "prometheus": {
                "url": f"{origin}/admin/observability/grafana/explore",
                "verified_external_route": True,
            },
            "loki": {
                "url": f"{origin}/admin/observability/grafana/explore",
                "verified_external_route": True,
            },
            "otel": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "dcgm": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "kueue": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "keda": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "alertmanager": (
                {
                    "url": f"{origin}/admin/observability/grafana/alerting/silences",
                    "verified_external_route": True,
                }
                if alertmanager_enabled
                else {"url": "", "verified_external_route": False}
            ),
            "tempo": {
                "url": f"{origin}/admin/observability/grafana/explore",
                "verified_external_route": True,
            },
        }
    foundation_path = run_root / "foundation.tfvars.json"
    workloads_path = run_root / "workloads.tfvars.json"
    private_json(foundation_path, foundation)
    private_json(workloads_path, workloads)
    return foundation_path, workloads_path


def plan_stage(
    terraform: str,
    *,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
    variable_file: Path,
    destroy: bool = False,
) -> tuple[Path, dict[str, Any], dict[str, str]]:
    if stage == "workloads" and not destroy:
        expected_batch = (
            contract.get("stages", {}).get("workloads", {}).get("scientific_batch")
        )
        if isinstance(expected_batch, Mapping):
            if variable_file.is_symlink() or not variable_file.is_file():
                raise DeploymentError(
                    "the generated workloads input must be a regular file before planning"
                )
            try:
                workload_variables = json.loads(
                    variable_file.read_text(encoding="utf-8")
                )
            except (OSError, json.JSONDecodeError) as error:
                raise DeploymentError(
                    "the generated workloads input is not readable canonical JSON"
                ) from error
            actual_batch = (
                workload_variables.get("scientific_batch")
                if isinstance(workload_variables, Mapping)
                else None
            )
            if actual_batch != expected_batch:
                raise DeploymentError(
                    "the generated scientific batch input differs from the customer "
                    "configuration; regenerate staged inputs with inference-stack"
                )
    root = stage_root(stage)
    state, _, _ = stage_paths(run_root, stage)
    environment = stage_environment(
        run_root,
        stage,
        contract,
        include_secrets=not destroy,
    )
    terraform_init(terraform, root, state, environment)
    suffix = "destroy" if destroy else "plan"
    plan_path = run_root / f"{stage}-{suffix}.tfplan"
    document = plan_json(
        terraform,
        root=root,
        environment=environment,
        variable_file=variable_file,
        plan_path=plan_path,
        json_path=run_root / f"{stage}-{suffix}.plan.json",
        destroy=destroy,
    )
    return plan_path, document, environment


def _read_cgroup_events(descriptor: int) -> tuple[bytes, bool]:
    raw = os.pread(descriptor, 64 * 1024, 0)
    fields: dict[str, str] = {}
    for line in raw.decode("ascii").splitlines():
        parts = line.split()
        if len(parts) != 2 or parts[0] in fields:
            raise DeploymentError("mutation cgroup.events is malformed")
        fields[parts[0]] = parts[1]
    if fields.get("populated") not in {"0", "1"}:
        raise DeploymentError("mutation cgroup.events omits an exact populated state")
    return raw, fields["populated"] == "1"


def open_mutation_cgroup(started: Mapping[str, Any]) -> dict[str, int]:
    payload = started["ledger_payload"]
    path = Path(payload["cgroup_path"])
    root = Path("/sys/fs/cgroup/fs2-public-edge-mutations")
    if path != root / started["attempt_id"] or path.is_symlink():
        raise DeploymentError("mutation ledger returned an unexpected cgroup path")
    for parent in (Path("/sys"), Path("/sys/fs"), Path("/sys/fs/cgroup"), root):
        details = os.stat(parent, follow_symlinks=False)
        if (
            not stat.S_ISDIR(details.st_mode)
            or details.st_uid != 0
            or stat.S_IMODE(details.st_mode) & 0o022
        ):
            raise DeploymentError("mutation cgroup authority parent is not protected")
    directory_fd = os.open(
        path,
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        directory_details = os.fstat(directory_fd)
        if (
            directory_details.st_uid != 0
            or directory_details.st_ino != payload["cgroup_inode"]
            or stat.S_IMODE(directory_details.st_mode) & 0o022
        ):
            raise DeploymentError("mutation cgroup identity differs from signed ledger receipt")
        descriptors: dict[str, int] = {}
        for name, flags in (
            ("procs", os.O_WRONLY),
            ("events", os.O_RDONLY),
            ("kill", os.O_WRONLY),
        ):
            descriptor = os.open(
                f"cgroup.{name}",
                flags | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=directory_fd,
            )
            details = os.fstat(descriptor)
            if not stat.S_ISREG(details.st_mode) or details.st_uid != 0:
                os.close(descriptor)
                raise DeploymentError(f"mutation cgroup.{name} is not root-owned")
            descriptors[name] = descriptor
        events_raw, populated = _read_cgroup_events(descriptors["events"])
        if (
            populated
            or hashlib.sha256(events_raw).hexdigest()
            != payload["cgroup_events_sha256"]
            or payload["cgroup_kill_deadline_unix"]
            != started["record"]["started_at_unix"] + MAXIMUM_MUTATION_SECONDS
        ):
            raise DeploymentError("mutation cgroup was populated or changed before spawn")
        return descriptors
    except Exception:
        for descriptor in locals().get("descriptors", {}).values():
            os.close(descriptor)
        raise
    finally:
        os.close(directory_fd)


def mutation_cgroup_empty_sha256(descriptors: Mapping[str, int]) -> str | None:
    raw, populated = _read_cgroup_events(descriptors["events"])
    if populated:
        return None
    return hashlib.sha256(raw).hexdigest()


def terminate_mutation_cgroup(descriptors: Mapping[str, int]) -> str:
    os.write(descriptors["kill"], b"1\n")
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        result = mutation_cgroup_empty_sha256(descriptors)
        if result is not None:
            return result
        time.sleep(0.1)
    raise DeploymentError(
        "mutation cgroup remained populated after the root watchdog kill request"
    )


def sealed_mutation_authority(path: Path) -> tuple[int, int, os.stat_result, str]:
    """Stable-open a caller-owned artifact and seal its exact bytes for a child."""

    source_fd = os.open(
        path,
        os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        before = os.fstat(source_fd)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid not in {0, os.getuid()}
            or stat.S_IMODE(before.st_mode) & 0o022
            or before.st_size < 1
        ):
            raise DeploymentError(
                "mutation authority must be a protected regular file owned by root or the caller"
            )
        raw = os.pread(source_fd, before.st_size, 0)
        after = os.fstat(source_fd)
        identity = lambda value: (
            value.st_dev,
            value.st_ino,
            value.st_size,
            value.st_mtime_ns,
            value.st_ctime_ns,
        )
        if len(raw) != before.st_size or identity(before) != identity(after):
            raise DeploymentError("mutation authority changed while it was opened")
        sealed_fd = _sealed_memfd("mutation-authority", raw)
        return source_fd, sealed_fd, before, hashlib.sha256(raw).hexdigest()
    except Exception:
        os.close(source_fd)
        raise


def execute_fenced_mutation(
    command: Sequence[str],
    *,
    run_root: Path,
    stage: str,
    root: Path,
    operation: str,
    authority_path: Path,
    environment: Mapping[str, str],
    accepted_return_codes: set[int] | None = None,
    reconciliation_of: str | None = None,
    capture_output: bool = False,
) -> subprocess.CompletedProcess[str]:
    """Run every provider/registry mutation under one external durable fence.

    The root-owned ledger records intent before spawn.  The root watchdog owns
    the complete cgroup, so timeout, interruption, direct-process exit, and
    surviving provider/plugin descendants have the same settlement outcome.
    A reconciliation command may name exactly one already-pending receipt but
    cannot bypass any other pending mutation.
    """

    if accepted_return_codes is None:
        accepted_return_codes = {0}
    if not command or not all(isinstance(item, str) and item for item in command):
        raise DeploymentError("fenced mutation command is malformed")
    if stage not in {
        "configuration",
        "infrastructure",
        "foundation",
        "workloads",
        "registry",
    }:
        raise DeploymentError("fenced mutation stage is outside the accepted contract")
    run_root_descriptor = os.open(
        run_root,
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        # Serialize the check/intent/spawn/terminal sequence. A crash releases
        # the kernel lock but leaves the fsynced intent for the next caller.
        fcntl.flock(run_root_descriptor, fcntl.LOCK_EX)
        pending = unresolved_mutation_records(run_root)
        if reconciliation_of is None:
            if pending:
                raise DeploymentError(
                    f"{len(pending)} mutation(s) have indeterminate state; run "
                    "the accepted reconcile command before any later mutation"
                )
        else:
            if re.fullmatch(r"[a-f0-9]{64}", reconciliation_of) is None:
                raise DeploymentError("reconciled mutation receipt digest is malformed")
            pending_digests = {item[2] for item in pending}
            if reconciliation_of not in pending_digests or pending_digests != {
                reconciliation_of
            }:
                raise DeploymentError(
                    "reconciliation runner is not bound to the sole exact pending mutation"
                )
        source_fd, authority_fd, authority_details, authority_sha256 = (
            sealed_mutation_authority(authority_path)
        )
        authority_reference = f"/proc/self/fd/{authority_fd}"
        authority_text = str(authority_path)
        effective_command = [
            item.replace(authority_text, authority_reference) for item in command
        ]
        started = record_mutation_started(
            run_root,
            stage=stage,
            root=root,
            operation=operation,
            command=effective_command,
            authority_path=authority_path,
            authority_details=authority_details,
            authority_sha256=authority_sha256,
            reconciliation_of=reconciliation_of,
        )
        # Refresh the short-lived cloud lease immediately before the accepted
        # process tree starts.  No caller may reuse the token from a prior
        # registry copy, plan, apply, or reconciliation operation.
        refreshed_environment = brokered_auth_environment(environment)
        print(f"+ {command_text(effective_command)}", file=sys.stderr)
        cgroup_descriptors = open_mutation_cgroup(started)
        try:
            process = subprocess.Popen(
                effective_command,
                env=refreshed_environment,
                text=True,
                stdout=subprocess.PIPE if capture_output else None,
                stderr=subprocess.PIPE if capture_output else None,
                close_fds=True,
                pass_fds=tuple(
                    sorted(
                        {
                            *CAPSULE_PASS_FDS,
                            *brokered_auth_pass_fds(refreshed_environment),
                            cgroup_descriptors["procs"],
                            authority_fd,
                        }
                    )
                ),
                start_new_session=True,
                preexec_fn=lambda: os.write(cgroup_descriptors["procs"], b"0\n"),
            )
            stdout, stderr = process.communicate(timeout=MAXIMUM_MUTATION_SECONDS)
            return_code = process.returncode
        except (subprocess.TimeoutExpired, KeyboardInterrupt, OSError) as exc:
            cgroup_events_sha256 = terminate_mutation_cgroup(cgroup_descriptors)
            if "process" in locals():
                try:
                    process.wait(timeout=30)
                except subprocess.TimeoutExpired as reap_error:
                    raise DeploymentError(
                        "root watchdog emptied the cgroup but the direct mutation process was not reaped"
                    ) from reap_error
            record_mutation_outcome(
                run_root,
                started=started,
                outcome=type(exc).__name__,
                cgroup_events_sha256=cgroup_events_sha256,
            )
            raise DeploymentError(
                "fenced mutation ended without a terminal result; run the accepted "
                "reconcile command before any later mutation"
            ) from exc
        finally:
            os.close(cgroup_descriptors["procs"])
        if return_code not in accepted_return_codes:
            cgroup_events_sha256 = terminate_mutation_cgroup(cgroup_descriptors)
            record_mutation_outcome(
                run_root,
                started=started,
                outcome=f"exit-{return_code}",
                cgroup_events_sha256=cgroup_events_sha256,
            )
            raise DeploymentError(
                f"fenced mutation returned {return_code}; run the accepted "
                "reconcile command before any later mutation"
            )
        cgroup_events_sha256 = mutation_cgroup_empty_sha256(cgroup_descriptors)
        if cgroup_events_sha256 is None:
            cgroup_events_sha256 = terminate_mutation_cgroup(cgroup_descriptors)
            record_mutation_outcome(
                run_root,
                started=started,
                outcome="surviving-process-tree",
                cgroup_events_sha256=cgroup_events_sha256,
            )
            raise DeploymentError(
                "mutation command returned while descendants remained; the "
                "accepted cgroup watchdog terminated the tree and reconciliation is required"
            )
        after = os.fstat(source_fd)
        if (
            authority_details.st_dev,
            authority_details.st_ino,
            authority_details.st_size,
            authority_details.st_mtime_ns,
            authority_details.st_ctime_ns,
        ) != (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
            after.st_ctime_ns,
        ):
            raise DeploymentError(
                "mutation authority pathname inode changed during the fenced operation"
            )
        record_mutation_terminal_success(
            run_root,
            started=started,
            cgroup_events_sha256=cgroup_events_sha256,
            exit_code=return_code,
        )
        return subprocess.CompletedProcess(
            effective_command, return_code, stdout=stdout, stderr=stderr
        )
    finally:
        if "cgroup_descriptors" in locals():
            for name in ("events", "kill"):
                descriptor = cgroup_descriptors.get(name, -1)
                if descriptor >= 0:
                    os.close(descriptor)
        for name in ("authority_fd", "source_fd"):
            descriptor = locals().get(name, -1)
            if isinstance(descriptor, int) and descriptor >= 0:
                os.close(descriptor)
        os.close(run_root_descriptor)


def apply_plan(
    terraform: str,
    root: Path,
    plan_path: Path,
    environment: Mapping[str, str],
) -> None:
    stage = {
        DEPLOY_ROOT: "configuration",
        INFRA_ROOT: "infrastructure",
        FOUNDATION_ROOT: "foundation",
        WORKLOADS_ROOT: "workloads",
    }.get(root)
    if stage is None:
        raise DeploymentError("Terraform mutation root is outside the staged contract")
    execute_fenced_mutation(
        [terraform, f"-chdir={root}", "apply", "-input=false", str(plan_path)],
        run_root=plan_path.parent,
        stage=stage,
        root=root,
        operation="terraform-saved-plan-apply",
        authority_path=plan_path,
        environment=environment,
    )


def indeterminate_mutation_records(
    run_root: Path,
) -> list[tuple[Path, dict[str, Any], str]]:
    records: list[tuple[Path, dict[str, Any], str]] = []
    for path in sorted(MUTATION_SETTLEMENT_ROOT.glob("*.started.json")):
        record = _external_signed_record(
            path,
            "fs2-serve.nebius.ai/mutation-ledger-receipt/v2",
        )
        if record.get("run_root") != str(run_root):
            continue
        raw = path.read_bytes()
        receipt_sha256 = hashlib.sha256(raw).hexdigest()
        if (
            record.get("action") != "started"
            or record.get("event_status") != "pending"
            or record.get("stage") not in {
                "configuration",
                "infrastructure",
                "foundation",
                "workloads",
                "registry",
            }
            or not isinstance(record.get("recorded_at_unix"), int)
            or not isinstance(record.get("attempt_id"), str)
            or path != MUTATION_SETTLEMENT_ROOT / f"{record.get('attempt_id')}.started.json"
            or record.get("predecessor_receipt_sha256") != "0" * 64
            or record.get("cgroup_path")
            != f"/sys/fs/cgroup/fs2-public-edge-mutations/{record.get('attempt_id')}"
            or record.get("cgroup_populated") is not False
            or record.get("cgroup_kill_deadline_unix", 0)
            != record.get("mutation_started_at_unix", -MAXIMUM_MUTATION_SECONDS)
            + MAXIMUM_MUTATION_SECONDS
        ):
            raise DeploymentError("external mutation-started ledger record is malformed")
        terminal_path = MUTATION_SETTLEMENT_ROOT / f"{record['attempt_id']}.terminal.json"
        if terminal_path.exists():
            terminal = _external_signed_record(
                terminal_path,
                "fs2-serve.nebius.ai/mutation-ledger-receipt/v2",
            )
            if (
                terminal.get("action") != "terminal"
                or terminal.get("event_status") != "success"
                or terminal.get("accepted_commit") != record["accepted_commit"]
                or terminal.get("accepted_tree") != record["accepted_tree"]
                or terminal.get("attempt_id") != record["attempt_id"]
                or terminal.get("stage") != record["stage"]
                or terminal.get("run_root") != record["run_root"]
                or terminal.get("project_id") != record["project_id"]
                or terminal.get("reconciliation_of") != record.get("reconciliation_of")
                or terminal.get("predecessor_receipt_sha256") != receipt_sha256
                or terminal.get("recorded_at_unix", 0) < record["recorded_at_unix"]
                or terminal.get("cgroup_path") != record["cgroup_path"]
                or terminal.get("cgroup_inode") != record["cgroup_inode"]
                or terminal.get("cgroup_kill_deadline_unix")
                != record["cgroup_kill_deadline_unix"]
                or terminal.get("mutation_started_at_unix")
                != record["mutation_started_at_unix"]
                or terminal.get("accepted_exit_code")
                not in (
                    {0, 2}
                    if record.get("operation") == "reconcile-refresh-plan"
                    else {0}
                )
                or terminal.get("cgroup_populated") is not False
            ):
                raise DeploymentError("external mutation terminal does not close its exact intent")
            continue
        records.append((path, record, receipt_sha256))
    return records


def _canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=True
    ).encode("ascii")


def _sealed_memfd(label: str, value: bytes) -> int:
    descriptor = os.memfd_create(label, os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING)
    offset = 0
    while offset < len(value):
        written = os.write(descriptor, value[offset:])
        if written <= 0:
            os.close(descriptor)
            raise DeploymentError(f"cannot write sealed {label}")
        offset += written
    os.fchmod(descriptor, 0o600)
    seals = fcntl.F_SEAL_SEAL | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_GROW | fcntl.F_SEAL_WRITE
    if fcntl.fcntl(descriptor, fcntl.F_ADD_SEALS, seals) != 0:
        os.close(descriptor)
        raise DeploymentError(f"cannot seal {label}")
    os.lseek(descriptor, 0, os.SEEK_SET)
    return descriptor


def _verify_debug_signed_envelope(
    envelope: object, *, expected_schema: str, authority_role: str, label: str
) -> Mapping[str, Any]:
    """Authenticate one canonical debug lifecycle envelope."""

    if not isinstance(envelope, dict) or set(envelope) != {
        "payload",
        "payload_sha256",
        "schema",
        "signature",
    }:
        raise DeploymentError(f"{label} is not one exact signed envelope")
    payload = envelope["payload"]
    if (
        envelope["schema"] != expected_schema
        or not isinstance(payload, Mapping)
    ):
        raise DeploymentError("debug activation envelope schema is unsupported")
    payload_raw = _canonical_bytes(payload)
    if envelope["payload_sha256"] != hashlib.sha256(payload_raw).hexdigest():
        raise DeploymentError("debug activation payload digest does not match")
    issuer = payload.get("issuer")
    if not isinstance(issuer, Mapping) or set(issuer) != {"id", "key_id"}:
        raise DeploymentError("debug activation issuer is malformed")
    trust_path = CAPSULE_TOOL_PATHS.get("internal_debug_activation_trust", "")
    match = re.fullmatch(r"/proc/self/fd/([0-9]+)", trust_path)
    if match is None:
        raise DeploymentError("debug activation trust root is not descriptor-pinned")
    trust_fd = int(match.group(1))
    trust_raw = os.pread(trust_fd, os.fstat(trust_fd).st_size, 0)
    try:
        trust = json.loads(trust_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("debug activation issuer registry is malformed") from exc
    if (
        _canonical_bytes(trust) + b"\n" != trust_raw
        or not isinstance(trust, dict)
        or set(trust) != {"brokers", "issuers", "schema"}
        or trust["schema"]
        != "fs2-serve.nebius.ai/trusted-internal-debug-activation-issuers/v1"
        or not isinstance(trust["issuers"], list)
    ):
        raise DeploymentError("debug activation issuer registry is not canonical v1")
    matches = [
        record
        for record in trust["issuers"]
        if isinstance(record, dict)
        and set(record) == {"id", "key_id", "public_key", "role"}
        and record.get("id") == issuer["id"]
        and record.get("key_id") == issuer["key_id"]
        and record.get("role") == authority_role
    ]
    if len(matches) != 1:
        raise DeploymentError(
            "debug activation is not signed by one source-enrolled authority"
        )
    try:
        public_key = base64.urlsafe_b64decode(
            str(matches[0]["public_key"])
            + "=" * (-len(str(matches[0]["public_key"])) % 4)
        )
        signature = base64.urlsafe_b64decode(
            str(envelope["signature"])
            + "=" * (-len(str(envelope["signature"])) % 4)
        )
    except (ValueError, binascii.Error) as exc:
        raise DeploymentError("debug activation signature encoding is malformed") from exc
    if (
        len(public_key) != 32
        or len(signature) != 64
        or issuer["key_id"]
        != "sha256:" + hashlib.sha256(public_key).hexdigest()
    ):
        raise DeploymentError("debug activation key identity is malformed")
    key_fd = _sealed_memfd(
        "debug-activation-key",
        bytes.fromhex("302a300506032b6570032100") + public_key,
    )
    payload_fd = _sealed_memfd("debug-activation-payload", payload_raw)
    signature_fd = _sealed_memfd("debug-activation-signature", signature)
    try:
        result = subprocess.run(
            [
                CAPSULE_TOOL_PATHS["openssl"],
                "pkeyutl",
                "-verify",
                "-pubin",
                "-keyform",
                "DER",
                "-inkey",
                f"/proc/self/fd/{key_fd}",
                "-rawin",
                "-in",
                f"/proc/self/fd/{payload_fd}",
                "-sigfile",
                f"/proc/self/fd/{signature_fd}",
            ],
            env={
                **clean_environment(),
                "OPENSSL_CONF": "/dev/null",
                "OPENSSL_MODULES": "/nonexistent",
            },
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            pass_fds=tuple(
                sorted(
                    {
                        *CAPSULE_PASS_FDS,
                        key_fd,
                        payload_fd,
                        signature_fd,
                    }
                )
            ),
            close_fds=True,
        )
    finally:
        os.close(key_fd)
        os.close(payload_fd)
        os.close(signature_fd)
    if result.returncode != 0:
        raise DeploymentError("debug activation signature is invalid")
    return payload


def _verify_debug_activation(envelope: object) -> Mapping[str, Any]:
    return _verify_debug_signed_envelope(
        envelope,
        expected_schema="fs2-serve.nebius.ai/signed-debug-activation/v1",
        authority_role="tenant-model-debug-activation-authority",
        label="debug activation",
    )


def _verify_debug_revocation(envelope: object) -> Mapping[str, Any]:
    return _verify_debug_signed_envelope(
        envelope,
        expected_schema="fs2-serve.nebius.ai/signed-debug-activation-revocation/v1",
        authority_role="tenant-model-debug-revocation-authority",
