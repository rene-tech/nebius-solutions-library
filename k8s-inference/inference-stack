class DeploymentError(RuntimeError):
    """A bounded, user-actionable deployment failure."""


def _is_exact_host_route(value: object) -> bool:
    if not isinstance(value, str):
        return False
    try:
        network = ipaddress.ip_network(value, strict=True)
    except ValueError:
        return False
    return network.prefixlen == network.max_prefixlen


def command_text(arguments: Sequence[str]) -> str:
    """Return a readable command containing no secret environment values."""
    return " ".join(arguments)


def run(
    arguments: Sequence[str],
    *,
    env: Mapping[str, str] | None = None,
    capture: bool = False,
    input_text: str | None = None,
) -> subprocess.CompletedProcess[str]:
    print(f"+ {command_text(arguments)}", file=sys.stderr)
    try:
        return subprocess.run(
            list(arguments),
            env=dict(env) if env is not None else None,
            input=input_text,
            text=True,
            check=True,
            stdout=subprocess.PIPE if capture else sys.stderr,
            stderr=subprocess.PIPE if capture else None,
        )
    except FileNotFoundError as exc:
        raise DeploymentError(f"required executable not found: {arguments[0]}") from exc
    except subprocess.CalledProcessError as exc:
        if capture and exc.stderr:
            print(exc.stderr.rstrip(), file=sys.stderr)
        raise DeploymentError(
            f"command failed with exit code {exc.returncode}: {command_text(arguments)}"
        ) from exc


def private_directory(path: Path) -> None:
    if path.exists() and (path.is_symlink() or not path.is_dir()):
        raise DeploymentError(f"run root must be a real directory: {path}")
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)


def private_json(path: Path, value: Any) -> None:
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    descriptor = os.open(temporary, flags, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def private_text(path: Path, value: str) -> None:
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(value)
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def clean_environment() -> dict[str, str]:
    # Stage inputs are generated explicitly. Inherited TF_VAR values could
    # otherwise make the same customer file produce a different deployment.
    return {
        key: value
        for key, value in os.environ.items()
        if not key.startswith("TF_VAR_")
        and not key.startswith("TF_CLI_ARGS")
        and key not in {"TF_DATA_DIR", "TF_WORKSPACE"}
    }


# Write-only Secret arguments (`data_wo`) are a Terraform 1.11 feature. On an
# older binary they are silently unknown attributes, which would put credential
# material back into state, so the whole flow refuses to run below 1.11.
MINIMUM_TERRAFORM_VERSION = (1, 11, 0)


def require_terraform_version(terraform: str) -> tuple[int, int, int]:
    """Fail closed unless the binary supports write-only resource arguments."""

    result = subprocess.run(
        [terraform, "version", "-json"],
        capture_output=True,
        text=True,
        env=clean_environment(),
    )
    if result.returncode != 0:
        raise DeploymentError(
            f"cannot determine the Terraform version using {terraform!r}"
        )
    try:
        raw = json.loads(result.stdout)["terraform_version"]
        version = tuple(int(part) for part in raw.split("-")[0].split(".")[:3])
    except (KeyError, ValueError, json.JSONDecodeError) as error:
        raise DeploymentError("Terraform reported an unreadable version") from error
    if len(version) != 3 or version < MINIMUM_TERRAFORM_VERSION:
        wanted = ".".join(str(part) for part in MINIMUM_TERRAFORM_VERSION)
        raise DeploymentError(
            f"Terraform {raw} is too old; write-only Secret data requires {wanted} or newer"
        )
    return version  # type: ignore[return-value]


def terraform_environment(run_root: Path, stage: str) -> dict[str, str]:
    environment = clean_environment()
    data_directory = run_root / "terraform-data" / stage
    private_directory(data_directory)
    environment["TF_DATA_DIR"] = str(data_directory)
    environment["TF_IN_AUTOMATION"] = "1"
    return environment


def terraform_init(
    terraform: str,
    root: Path,
    backend: Path,
    environment: Mapping[str, str],
) -> None:
    if backend.is_symlink():
        raise DeploymentError(
            f"Terraform backend path must not be a symlink: {backend}"
        )
    run(
        [
            terraform,
            f"-chdir={root}",
            "init",
            "-input=false",
            "-reconfigure",
            f"-backend-config=path={backend}",
        ],
        env=environment,
    )


def validate_stage_roots(terraform: str, run_root: Path) -> None:
    for stage in ("infrastructure", "foundation", "workloads"):
        environment = terraform_environment(run_root, f"validate-{stage}")
        root = stage_root(stage)
        run(
            [
                terraform,
                f"-chdir={root}",
                "init",
                "-backend=false",
                "-input=false",
            ],
            env=environment,
        )
        run(
            [terraform, f"-chdir={root}", "validate", "-no-color"],
            env=environment,
        )


def terraform_json_output(
    terraform: str,
    root: Path,
    name: str,
    environment: Mapping[str, str],
) -> Any:
    result = run(
        [terraform, f"-chdir={root}", "output", "-json", name],
        env=environment,
        capture=True,
    )
    return json.loads(result.stdout)


def terraform_optional_json_output(
    terraform: str,
    root: Path,
    name: str,
    environment: Mapping[str, str],
) -> Any | None:
    """Read an output that Terraform legitimately omits when its value is null."""
    result = run(
        [terraform, f"-chdir={root}", "output", "-json"],
        env=environment,
        capture=True,
    )
    outputs = json.loads(result.stdout)
    output = outputs.get(name)
    if output is None:
        return None
    if not isinstance(output, dict) or "value" not in output:
        raise DeploymentError(f"Terraform returned malformed output {name!r}")
    return output["value"]


def state_addresses(
    terraform: str,
    root: Path,
    environment: Mapping[str, str],
) -> list[str]:
    result = subprocess.run(
        [terraform, f"-chdir={root}", "state", "list"],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return []
    return [line for line in result.stdout.splitlines() if line.strip()]


def plan_json(
    terraform: str,
    *,
    root: Path,
    environment: Mapping[str, str],
    variable_file: Path,
    plan_path: Path,
    json_path: Path,
    destroy: bool = False,
) -> dict[str, Any]:
    if plan_path.is_symlink() or json_path.is_symlink():
        raise DeploymentError("plan and plan JSON paths must not be symlinks")
    arguments = [
        terraform,
        f"-chdir={root}",
        "plan",
        "-input=false",
        "-lock=true",
        f"-var-file={variable_file}",
        f"-out={plan_path}",
    ]
    if destroy:
        arguments.insert(3, "-destroy")
    run(arguments, env=environment)
    plan_path.chmod(0o600)
    result = run(
        [terraform, f"-chdir={root}", "show", "-json", str(plan_path)],
        env=environment,
        capture=True,
    )
    private_text(json_path, result.stdout)
    return json.loads(result.stdout)


def planned_output(document: Mapping[str, Any], name: str) -> Any:
    try:
        return document["planned_values"]["outputs"][name]["value"]
    except (KeyError, TypeError) as exc:
        raise DeploymentError(
            f"configuration plan did not produce output {name!r}"
        ) from exc


def plan_changes_managed_resources_or_outputs(document: Mapping[str, Any]) -> bool:
    """Return whether a stage handoff must converge before its consumer plans."""
    unchanged_actions = (["no-op"], ["read"])
    for resource in document.get("resource_changes", []):
        if resource.get("mode", "managed") != "managed":
            continue
        actions = resource.get("change", {}).get("actions", [])
        if actions not in unchanged_actions:
            return True
    for output in document.get("output_changes", {}).values():
        actions = output.get("actions", [])
        if actions not in unchanged_actions:
            return True
    return False


def validate_model_network_policy_rollback_plan(
    document: Mapping[str, Any], contract: Mapping[str, Any]
) -> None:
    """Keep deny removal isolated from Helm or any other workload mutation.

    Terraform dependency ordering cannot make two unrelated changes in one plan
    safe. During the rollback-remove-deny phase, the supported wrapper therefore
    accepts only deletion of the namespace deny and its one-shot apply-fence
    receipt plus the transition receipt's state update. The exact saved plan is
    applied only after this check.
    """
    transition = (
        contract.get("stages", {})
        .get("workloads", {})
        .get("model_runtime_network_policy", {})
    )
    if (
        not isinstance(transition, Mapping)
        or transition.get("phase") != "rollback-remove-deny"
    ):
        return

    def without_holder(value: Any) -> Any:
        if isinstance(value, Mapping):
            cleaned = {key: without_holder(item) for key, item in value.items()}
            annotations = cleaned.get("annotations")
            if isinstance(annotations, dict):
                annotations.pop("fs2-serve.nebius.ai/network-transition-holder", None)
            return cleaned
        if isinstance(value, list):
            return [without_holder(item) for item in value]
        return value

    holder_refresh_addresses = {
        "kubernetes_manifest.model_runtime_network_boundary_marker_admission",
        "kubernetes_manifest.model_runtime_network_boundary_marker_admission_binding[0]",
        "kubernetes_manifest.model_runtime_network_controller_freeze_admission",
        "kubernetes_manifest.model_runtime_network_controller_freeze_admission_binding[0]",
        "kubernetes_manifest.model_runtime_network_helm_freeze_admission",
        "kubernetes_manifest.model_runtime_network_helm_freeze_admission_binding[0]",
        "kubernetes_manifest.model_runtime_network_lease_guard_admission",
        "kubernetes_manifest.model_runtime_network_lease_guard_admission_binding",
        "kubernetes_manifest.model_runtime_network_transition_guard_admission",
        "kubernetes_manifest.model_runtime_network_transition_guard_admission_binding[0]",
        "kubernetes_config_map_v1.model_runtime_network_enforcement[0]",
    }
    holder_refresh_prefixes = (
        "kubernetes_manifest.model_runtime_network_profile_admission[",
        "kubernetes_manifest.model_runtime_network_profile_admission_binding[",
        "kubernetes_network_policy_v1.model_runtime_base_profile[",
        "kubernetes_network_policy_v1.model_runtime_modelexpress_profile[",
        "kubernetes_network_policy_v1.model_namespace_support_profile[",
    )
    changes: dict[str, list[str]] = {}
    for resource in document.get("resource_changes", []):
        if resource.get("mode", "managed") != "managed":
            continue
        actions = resource.get("change", {}).get("actions", [])
        if actions in (["no-op"], ["read"]):
            continue
        address = resource.get("address")
        if not isinstance(address, str) or not all(
            isinstance(action, str) for action in actions
        ):
            raise DeploymentError(
                "the workloads rollback plan has a malformed resource change"
            )
        change = resource.get("change", {})
        if (
            actions == ["update"]
            and (
                address in holder_refresh_addresses
                or address.startswith(holder_refresh_prefixes)
            )
            and without_holder(change.get("before"))
            == without_holder(change.get("after"))
        ):
            continue
        changes[address] = actions
    allowed = {
        "kubernetes_network_policy_v1.model_namespace_default_deny[0]": ["delete"],
        "terraform_data.model_runtime_network_policy_apply_fence[0]": ["delete"],
        "terraform_data.model_runtime_network_policy_transition": ["update"],
    }
    # A prior apply can crash after either state transition. Retrying that exact
    # saved plan may therefore contain neither change or just the remaining one.
    # Accept any subset, but never a third address or different action.
    if any(
        address not in allowed or actions != allowed[address]
        for address, actions in changes.items()
    ):
        rendered = (
            ", ".join(
                f"{address}={'+'.join(actions)}"
                for address, actions in sorted(changes.items())
            )
            or "none"
        )
        raise DeploymentError(
            "rollback-remove-deny must be an isolated saved plan containing only "
            "default-deny/apply-fence deletion, transition receipt update, and exact "
            "holder-token annotation refreshes; observed: "
            f"{rendered}"
        )


def validate_model_network_frozen_plan(
    document: Mapping[str, Any], contract: Mapping[str, Any]
) -> None:
    """Reject control-plane Helm mutation after the external fence is armed."""

    transition = (
        contract.get("stages", {})
        .get("workloads", {})
        .get("model_runtime_network_policy", {})
    )
    if not isinstance(transition, Mapping) or transition.get("phase") not in {
        "inventory",
        "enforce",
        "rollback-remove-deny",
    }:
        return
    for resource in document.get("resource_changes", []):
        if resource.get("address") != "helm_release.control_plane":
            continue
        actions = resource.get("change", {}).get("actions", [])
        if actions not in (["no-op"], ["read"]):
            raise DeploymentError(
                "the separately custodied Helm/controller fence is already active; "
                "roll out the integrated control-plane image before authority "
                "bootstrap or complete deny-first rollback before a later Helm change"
            )


def validate_model_network_maintenance_plan(
    document: Mapping[str, Any], contract: Mapping[str, Any]
) -> None:
    """Allow a routine Helm update without permitting boundary churn or replacement."""

    transition = (
        contract.get("stages", {})
        .get("workloads", {})
        .get("model_runtime_network_policy", {})
    )
    if not isinstance(transition, Mapping) or transition.get("phase") != "maintenance":
        return
    allowed = {
        "helm_release.control_plane": {("update",), ("no-op",), ("read",)},
        "terraform_data.model_runtime_network_policy_transition": {
            ("update",),
            ("no-op",),
            ("read",),
        },
    }
    violations: list[str] = []
    for resource in document.get("resource_changes", []):
        if resource.get("mode", "managed") != "managed":
            continue
        actions = tuple(resource.get("change", {}).get("actions", []))
        if actions in {("no-op",), ("read",)}:
            continue
        address = resource.get("address")
        if not isinstance(address, str) or actions not in allowed.get(address, set()):
            violations.append(f"{address}={'+'.join(actions)}")
    if violations:
        raise DeploymentError(
            "maintenance may update only the control-plane Helm release while "
            "default-deny, its apply fence, marker, policies and admission objects "
            "remain byte-stable; observed: " + ", ".join(sorted(violations))
        )


def source_commit() -> str:
    result = run(
        ["git", "-C", str(REPOSITORY_ROOT), "rev-parse", "HEAD"],
        capture=True,
        env=clean_environment(),
    )
    commit = result.stdout.strip()
    if len(commit) != 40 or any(
        character not in "0123456789abcdef" for character in commit
    ):
        raise DeploymentError(
            "the source checkout does not have an exact Git commit identity"
        )
    return commit


def default_run_root(variable_file: Path) -> Path:
    identity = hashlib.sha256(str(variable_file.resolve()).encode()).hexdigest()[:12]
    state_home = os.environ.get("XDG_STATE_HOME")
    base = Path(state_home) if state_home else Path.home() / ".local" / "state"
    return base / "nebius-k8s-inference" / identity


def validate_configuration(
    terraform: str,
    variable_file: Path,
    run_root: Path,
) -> tuple[dict[str, Any], dict[str, str]]:
    environment = terraform_environment(run_root, "configuration")
    backend = run_root / "configuration.tfstate"
    terraform_init(terraform, DEPLOY_ROOT, backend, environment)
    document = plan_json(
        terraform,
        root=DEPLOY_ROOT,
        environment=environment,
        variable_file=variable_file,
        plan_path=run_root / "configuration.tfplan",
        json_path=run_root / "configuration.plan.json",
    )
    contract = planned_output(document, "deployment_contract")
    private_json(run_root / "deployment-contract.json", contract)
    return contract, environment


def preflight_accelerators(
    args: argparse.Namespace,
    contract: Mapping[str, Any],
) -> None:
    """Validate project-local platform, preset, capacity, and driver facts live."""
    pools = contract["stages"]["infrastructure"].get("custom_accelerator_pools", {})
    if not pools:
        raise DeploymentError(
            "live preflight requires deployment.accelerator_pools; checked-in profile pools are evidence-backed but not a substitute for current capacity"
        )

    project_id = contract["target"]["project_id"]
    target_region = contract["target"]["region"]
    kubernetes_version = contract["stages"]["infrastructure"]["kubernetes_version"]
    checked: list[dict[str, Any]] = []
    for pool_id, pool in sorted(pools.items()):
        platform_result = run(
            [
                args.nebius,
                "--profile",
                args.nebius_profile,
                "compute",
                "platform",
                "get-by-name",
                "--parent-id",
                project_id,
                "--name",
                pool["platform"],
                "--format",
                "json",
            ],
            capture=True,
            env=clean_environment(),
        )
        platform = json.loads(platform_result.stdout)
        presets = {
            item.get("name"): item
            for item in platform.get("spec", {}).get("presets", [])
        }
        if pool["preset"] not in presets:
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: preset {pool['preset']!r} is not offered by platform {pool['platform']!r} in project {project_id}"
            )
        preset = presets[pool["preset"]]
        advertised_gpu_count = preset.get("resources", {}).get("gpu_count")
        if advertised_gpu_count != pool["gpus_per_node"]:
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: gpus_per_node={pool['gpus_per_node']} differs from the live preset value {advertised_gpu_count}"
            )
        if pool["capacity_type"] == "preemptible" and not platform.get(
            "status", {}
        ).get("allowed_for_preemptibles", False):
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: platform {pool['platform']!r} does not allow preemptible capacity in this project"
            )
        if pool["topology"]["mode"] == "gpu_cluster" and not preset.get(
            "allow_gpu_clustering", False
        ):
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: preset {pool['preset']!r} is not GPU-cluster capable"
            )

        compatibility_result = run(
            [
                args.nebius,
                "--profile",
                args.nebius_profile,
                "mk8s",
                "node-group",
                "get-compatibility-matrix",
                "--cluster-kubernetes-version",
                kubernetes_version,
                "--platform",
                pool["platform"],
                "--format",
                "json",
            ],
            capture=True,
            env=clean_environment(),
        )
        compatibility = json.loads(compatibility_result.stdout)
        items = [
            item
            for version in compatibility.get("versions", [])
            if version.get("kubernetes_version") == kubernetes_version
            for item in version.get("items", [])
            if pool["platform"] in item.get("compatible_platforms", [])
            and item.get("os") == pool["os"]
        ]
        driver = pool["driver"]
        compatible = any(
            (
                driver["mode"] == "managed"
                and item.get("drivers_preset") == driver.get("preset")
            )
            or (driver["mode"] == "operator" and not item.get("drivers_preset"))
            for item in items
        )
        if not compatible:
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: OS/driver mode is absent from the live MK8s compatibility matrix"
            )

        reservation = pool.get("reservation_policy")
        reservation_evidence: dict[str, Any] | None = None
        if reservation is not None:
            reservation_ids = reservation.get("reservation_ids", [])
            required_gpu_units = pool["max_nodes"] * pool["gpus_per_node"]
            total_gpu_units = 0.0
            available_gpu_units = 0.0
            groups: list[dict[str, Any]] = []
            for reservation_id in reservation_ids:
                group_result = run(
                    [
                        args.nebius,
                        "--profile",
                        args.nebius_profile,
                        "capacity",
                        "capacity-block-group",
                        "get",
                        "--id",
                        reservation_id,
                        "--format",
                        "json",
                    ],
                    capture=True,
                    env=clean_environment(),
                )
                group = json.loads(group_result.stdout)
                metadata = group.get("metadata", {})
                status = group.get("status", {})
                affinity = status.get("resource_affinity", {}).get("compute_v1", {})
                if (
                    metadata.get("id") != reservation_id
                    or status.get("state") != "STATE_ACTIVE"
                    or status.get("region") != target_region
                    or affinity.get("platform") != pool["platform"]
                ):
                    raise DeploymentError(
                        f"accelerator pool {pool_id!r}: capacity block {reservation_id!r} is not an active {target_region}/{pool['platform']} reservation"
                    )
                limit_text = str(status.get("current_limit", ""))
                usage_units_text = str(status.get("usage", ""))
                usage_text = str(status.get("usage_percentage", ""))
                if (
                    not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", limit_text)
                    or not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", usage_units_text)
                    or not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", usage_text)
                ):
                    raise DeploymentError(
                        f"accelerator pool {pool_id!r}: capacity block {reservation_id!r} has malformed capacity status"
                    )
                current_limit = float(limit_text)
                usage_gpu_units = float(usage_units_text)
                usage_fraction = float(usage_text)
                if (
                    current_limit < 0.0
                    or not 0.0 <= usage_gpu_units <= current_limit
                    or not 0.0 <= usage_fraction <= 1.0
                ):
                    raise DeploymentError(
                        f"accelerator pool {pool_id!r}: capacity block {reservation_id!r} has invalid capacity usage"
                    )
                total_gpu_units += current_limit
                available_gpu_units += current_limit - usage_gpu_units
                groups.append(
                    {
                        "id": reservation_id,
                        "state": status["state"],
                        "current_limit": current_limit,
                        "usage_gpu_units": usage_gpu_units,
                        "usage_fraction": usage_fraction,
                        "active_until": status.get(
                            "current_continuous_interval", {}
                        ).get("end_time"),
                    }
                )
            if total_gpu_units + 1e-9 < required_gpu_units:
                raise DeploymentError(
                    f"accelerator pool {pool_id!r}: capacity blocks reserve {total_gpu_units:g} total GPU units but fixed capacity requires {required_gpu_units}"
                )
            reservation_evidence = {
                "policy": reservation["policy"],
                "required_gpu_units": required_gpu_units,
                "total_gpu_units": total_gpu_units,
                "available_gpu_units": available_gpu_units,
                "groups": groups,
                "status": "compatible",
            }

        pool_evidence = {
            "pool_id": pool_id,
            "platform": pool["platform"],
            "preset": pool["preset"],
            "capacity_type": pool["capacity_type"],
            "driver_mode": driver["mode"],
            "topology": pool["topology"]["mode"],
            "status": "compatible",
        }
        if reservation_evidence is not None:
            pool_evidence["reservation"] = reservation_evidence
        checked.append(pool_evidence)

    print(
        json.dumps(
            {
                "status": "compatible",
                "project_id": project_id,
                "kubernetes_version": kubernetes_version,
                "accelerator_pools": checked,
                "capacity_advisor": "Run Capacity Advisor immediately before apply; availability is not guaranteed by compatibility.",
            },
            indent=2,
        )
    )


def require_deployable_images(contract: Mapping[str, Any]) -> None:
    """Fail before cloud mutation when source-build placeholders remain."""
    workloads = contract["stages"]["workloads"]
    policy = contract["artifact_delivery"]["mode"]
    application_images = {
        "control plane": workloads["control_plane_image"],
        "admin console": workloads["admin_console"]["image"],
    }
    for label, image in application_images.items():
        repository = image["repository"]
        digest = image["digest"]
        if repository.split("/", 1)[0].endswith(".invalid"):
            raise DeploymentError(
                f"{label} image still uses a .invalid source-build placeholder"
            )
        if digest == f"sha256:{'0' * 64}":
            raise DeploymentError(
                f"{label} image still uses the zero digest placeholder"
            )
        if policy == "regional-mirror":
            split_digest_reference(f"{repository}@{digest}", label=label)

    selected_models = set(contract["selected_model_ids"])
    model_images = workloads.get("model_image_overrides", {})
    missing = sorted(selected_models - set(model_images))
    if missing:
        raise DeploymentError(
            "selected models lack both a tfvars image override and a runtime-catalog image: "
            + ", ".join(missing)
        )
    for model_id in sorted(selected_models):
        image = model_images[model_id]
        host = image.split("/", 1)[0]
        if host.endswith(".invalid"):
            raise DeploymentError(
                f"selected model {model_id!r} still uses an unresolved .invalid runtime-catalog image"
            )
        if policy == "regional-mirror":
            split_digest_reference(image, label=f"model {model_id}")

    reference_data = workloads.get("reference_data", {})
    if isinstance(reference_data, Mapping) and reference_data.get("enabled") is True:
        for component in ("status", "pipeline"):
            configuration = reference_data.get(component, {})
            if (
                not isinstance(configuration, Mapping)
                or configuration.get("enabled") is not True
            ):
                continue
            image = configuration.get("image")
            if not isinstance(image, str) or image.split("/", 1)[0].endswith(
                ".invalid"
            ):
                raise DeploymentError(f"reference-data {component} image is unresolved")
            if policy == "regional-mirror":
                split_digest_reference(image, label=f"reference-data {component}")


def split_digest_reference(reference: str, *, label: str) -> tuple[str, str]:
    """Split one immutable OCI reference without accepting a tag-only source."""
    marker = "@sha256:"
    if reference.count("@") != 1 or reference.count(marker) != 1:
        raise DeploymentError(
            f"{label} image must be pinned as repository@sha256:<64 hex>"
        )
    repository, hexadecimal = reference.rsplit(marker, 1)
    if (
        not repository
        or "/" not in repository
        or any(character in repository for character in ("?", "#"))
        or any(character.isspace() for character in repository)
        or ":" in repository.rsplit("/", 1)[-1]
        or len(hexadecimal) != 64
        or any(character not in "0123456789abcdef" for character in hexadecimal)
    ):
        raise DeploymentError(
            f"{label} image must be pinned as repository@sha256:<64 hex>"
        )
    host, path = repository.split("/", 1)
    host_without_port = host.split(":", 1)[0]
    if (
        "." not in host_without_port
        or not re.fullmatch(r"[a-zA-Z0-9.-]+(?::[0-9]+)?", host)
        or any(part in ("", ".", "..") for part in path.split("/"))
        or not re.fullmatch(r"[a-z0-9._/-]+", path)
    ):
        raise DeploymentError(
            f"{label} image must use a fully-qualified registry host and safe repository path"
        )
    return repository, f"sha256:{hexadecimal}"


def source_repository_path(repository: str) -> str:
    """Preserve an upstream repository path, excluding a Nebius registry ID."""
    parts = repository.split("/")
    if len(parts) < 2:
        raise DeploymentError(f"OCI repository has no path: {repository!r}")
    host, path = parts[0], parts[1:]
    if host.startswith("cr.") and host.endswith(".nebius.cloud") and len(path) > 1:
        path = path[1:]
    if not path or any(part in ("", ".", "..") for part in path):
        raise DeploymentError(f"OCI repository has an unsafe path: {repository!r}")
    return "/".join(path)


def selected_image_artifacts(
    contract: Mapping[str, Any],
    registry_delivery: Mapping[str, Any],
) -> list[dict[str, str]]:
    """Return the complete selected source-to-target image closure."""
    expected_policy = contract["artifact_delivery"]
    if (
        registry_delivery.get("schema") != "fs2-serve.nebius.ai/registry-delivery/v1"
        or registry_delivery.get("mode") != expected_policy["mode"]
        or registry_delivery.get("repository_prefix")
        != expected_policy["repository_prefix"]
    ):
        raise DeploymentError(
            "the infrastructure registry-delivery output differs from terraform.tfvars"
        )
    target = registry_delivery.get("target_registry")
    if not isinstance(target, dict):
        raise DeploymentError(
            "the infrastructure registry-delivery output is malformed"
        )
    target_region = contract["target"]["region"]
    target_registry_id = str(target.get("id", ""))
    target_fqdn = str(target.get("fqdn", "")).rstrip("/")
    target_root = str(target.get("repository_root", "")).rstrip("/")
    expected_fqdn = f"cr.{target_region}.nebius.cloud"
    expected_root = f"{expected_fqdn}/{target_registry_id.removeprefix('registry-')}"
    if (
        not re.fullmatch(r"registry-[a-z0-9]+", target_registry_id)
        or target.get("project_id") != contract["target"]["project_id"]
        or target.get("region") != target_region
        or target_fqdn != expected_fqdn
        or target_root != expected_root
    ):
        raise DeploymentError("the infrastructure target registry root is malformed")

    workloads = contract["stages"]["workloads"]
    sources: list[tuple[str, str]] = [
        (
            "application/control-plane",
            f"{workloads['control_plane_image']['repository']}@{workloads['control_plane_image']['digest']}",
        ),
        (
            "application/admin-console",
            f"{workloads['admin_console']['image']['repository']}@{workloads['admin_console']['image']['digest']}",
        ),
    ]
    sources.extend(
        (f"model/{model_id}", workloads["model_image_overrides"][model_id])
        for model_id in contract["selected_model_ids"]
    )
    reference_data = workloads.get("reference_data", {})
    if isinstance(reference_data, Mapping) and reference_data.get("enabled") is True:
        for component in ("status", "pipeline"):
            configuration = reference_data.get(component, {})
            if (
                isinstance(configuration, Mapping)
                and configuration.get("enabled") is True
            ):
                sources.append(
                    (f"reference-data/{component}", str(configuration["image"]))
                )

    prefix = str(registry_delivery.get("repository_prefix", "")).strip("/")
    artifacts: list[dict[str, str]] = []
    target_sources: dict[str, str] = {}
    for name, source_reference in sources:
        source_repository, digest = split_digest_reference(source_reference, label=name)
        relative_repository = source_repository_path(source_repository)
        target_repository = "/".join(
            part for part in (target_root, prefix, relative_repository) if part
        )
        prior_source = target_sources.get(target_repository)
        if prior_source is not None and prior_source != source_repository:
            raise DeploymentError(
                "two distinct upstream repositories collapse to the same target repository: "
                f"{target_repository}"
            )
        target_sources[target_repository] = source_repository
        target_tag = (
            f"{target_repository}:mirror-sha256-{digest.removeprefix('sha256:')}"
        )
        artifacts.append(
            {
                "name": name,
                "source_repository": source_repository,
                "source_reference": source_reference,
                "digest": digest,
                "target_repository": target_repository,
                "target_reference": f"{target_repository}@{digest}",
                "target_tag": target_tag,
            }
        )
    return artifacts


def rewritten_workloads(
    contract: Mapping[str, Any], dynamic: Mapping[str, Any]
) -> dict[str, Any]:
    """Rewrite runtime pulls to the regional target without changing digests."""
    workloads = dict(contract["stages"]["workloads"])
    if contract["artifact_delivery"]["mode"] == "direct-source":
        return workloads
    artifacts = {
        artifact["name"]: artifact
        for artifact in selected_image_artifacts(
            contract, dynamic["registry_delivery_contract"]
        )
    }
    control_plane = dict(workloads["control_plane_image"])
    control_plane["repository"] = artifacts["application/control-plane"][
        "target_repository"
    ]
    workloads["control_plane_image"] = control_plane

    admin_console = dict(workloads["admin_console"])
    admin_image = dict(admin_console["image"])
    admin_image["repository"] = artifacts["application/admin-console"][
        "target_repository"
    ]
    admin_console["image"] = admin_image
    workloads["admin_console"] = admin_console
    workloads["model_image_overrides"] = {
        model_id: artifacts[f"model/{model_id}"]["target_reference"]
        for model_id in contract["selected_model_ids"]
    }
    reference_data = workloads.get("reference_data")
    if isinstance(reference_data, Mapping) and reference_data.get("enabled") is True:
        rewritten_reference_data = dict(reference_data)
        for component in ("status", "pipeline"):
            configuration = rewritten_reference_data.get(component)
            if (
                not isinstance(configuration, Mapping)
                or configuration.get("enabled") is not True
            ):
                continue
            rewritten_configuration = dict(configuration)
            rewritten_configuration["image"] = artifacts[f"reference-data/{component}"][
                "target_reference"
            ]
            rewritten_reference_data[component] = rewritten_configuration
        workloads["reference_data"] = rewritten_reference_data
    return workloads


def canonical_sha256(value: object) -> str:
    """Match the control-plane configuration ETag and Terraform jsonencode digest."""

    payload = json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
        allow_nan=False,
    ).encode()
    return hashlib.sha256(payload).hexdigest()


def _admin_catalog() -> Any:
    """Load the validated packaged catalog without requiring an installed wheel."""

    paths = [str(CATALOG_ROOT), str(SOLUTION_ROOT / "components/control-plane/src")]
    added = [path for path in paths if path not in sys.path]
    sys.path[:0] = added
    try:
        from fs2_serve_catalog.loader import load_catalog
        from fs2_serve.native_catalog import augment_native_catalog

        return augment_native_catalog(
            load_catalog(CATALOG_ROOT), CATALOG_ROOT, repo_root=REPOSITORY_ROOT
        )
    except (ImportError, OSError, ValueError) as exc:
        raise DeploymentError(
            "the canonical model catalog cannot derive the admin baseline"
        ) from exc
    finally:
        for path in added:
            sys.path.remove(path)


def selected_deployment_runtimes(model_images: Mapping[str, str]) -> dict[str, Any]:
    """Select exact runtime digests, independently of a mirror's registry region."""
    selected: dict[str, Any] = {}
    for path in sorted((CATALOG_ROOT / "deployment-runtimes").glob("*.json")):
        entry = json.loads(path.read_text(encoding="utf-8"))
        model_id = entry["model_id"]
        image = model_images.get(model_id)
        if (
            image is None
            or image.rsplit("@", 1)[-1] != entry["record"]["runtime"]["image"]["digest"]
        ):
            continue
        if model_id in selected:
            raise DeploymentError(
                f"model {model_id!r} has ambiguous deployment runtime records"
            )
        selected[model_id] = entry
    return selected


def deployment_runtime_configuration_identities(
    entries: Mapping[str, Any],
) -> dict[str, Any]:
    """Use the control plane's exact artifact identities for the admin baseline."""
    paths = [str(CATALOG_ROOT), str(SOLUTION_ROOT / "components/control-plane/src")]
    added = [path for path in paths if path not in sys.path]
    sys.path[:0] = added
    try:
        from fs2_serve.deployment_runtimes import (
            deployment_runtime_configuration_identity,
        )

        return {
            model_id: deployment_runtime_configuration_identity(entry)
            for model_id, entry in entries.items()
        }
    finally:
        for path in added:
            sys.path.remove(path)


def _admin_pool_ids(
    contract: Mapping[str, Any],
    workloads: Mapping[str, Any],
    pools: Mapping[str, Any],
    *,
    model_id: str,
    accelerator_class: str,
) -> list[str]:
    override = workloads.get("model_pool_overrides", {}).get(model_id)
    if isinstance(override, str) and override:
        candidates = [override]
    else:
        placement = contract.get("selected_model_placements", {}).get(model_id, {})
        compatible = (
            placement.get("compatible_pool_ids", [])
            if isinstance(placement, Mapping)
            else []
        )
        candidates = [value for value in compatible if isinstance(value, str)]
    candidates = [value for value in candidates if value in pools]
    if not candidates:
        normalized = accelerator_class.casefold().replace("_", "-")
        candidates = sorted(
            pool_id
            for pool_id, pool in pools.items()
            if str(pool.get("accelerator_class", "")).casefold().replace("_", "-")
            == normalized
        )
    if not candidates:
        raise DeploymentError(
            f"model {model_id!r} has no selected accelerator pool; set deployment.models.pool_overrides"
        )
    return sorted(dict.fromkeys(candidates))


def _admin_scaling(
    workloads: Mapping[str, Any],
    model_id: str,
) -> dict[str, int]:
    mode = workloads.get("model_scaling_mode")
    if mode not in {"keda", "static"}:
        raise DeploymentError("admin baseline requires a supported model scaling mode")
    configured = workloads.get("model_scaling_overrides", {}).get(model_id, {})
    if not isinstance(configured, Mapping):
        raise DeploymentError(f"model {model_id!r} has an invalid scaling override")
    if mode == "static":
        return {
            "min_replicas": 1,
            "max_replicas": 1,
            "target_queue_depth": 1,
            "polling_interval_seconds": int(workloads["keda_polling_interval_seconds"]),
            "cooldown_seconds": int(workloads["keda_cooldown_period_seconds"]),
        }
    hot = model_id in workloads.get("hot_model_ids", [])
    return {
        "min_replicas": int(configured.get("min_replicas", 1 if hot else 0)),
        "max_replicas": int(configured.get("max_replicas", 1)),
        "target_queue_depth": int(configured.get("target_queue_depth", 1)),
        "polling_interval_seconds": int(
            configured.get(
                "polling_interval_seconds", workloads["keda_polling_interval_seconds"]
            )
        ),
        "cooldown_seconds": int(
            configured.get(
                "cooldown_seconds", workloads["keda_cooldown_period_seconds"]
            )
        ),
    }


def derived_admin_configuration(
    contract: Mapping[str, Any],
    dynamic: Mapping[str, Any],
    workloads: Mapping[str, Any],
) -> tuple[dict[str, Any], str, dict[str, dict[str, int]]]:
    """Project the same tfvars-selected pools, routes, and immutable artifacts into the admin API."""

    accelerator_contract = dynamic.get("accelerator_pool_contract")
    if not isinstance(accelerator_contract, Mapping):
        raise DeploymentError(
            "the accelerator-pool output is unavailable for the admin baseline"
        )
    raw_pools = accelerator_contract.get("pools")
    if not isinstance(raw_pools, Mapping) or not raw_pools:
        raise DeploymentError(
            "the accelerator-pool output contains no pools for the admin baseline"
        )

    catalog = _admin_catalog()
    try:
        routes_document = json.loads(MODEL_ROUTES_PATH.read_text(encoding="utf-8"))
        pool_profiles = json.loads(POOL_PROFILES_PATH.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError(
            "the admin baseline support contracts are unreadable"
        ) from exc
    routes = routes_document.get("routes", {})
    profile_name = contract.get("profiles", {}).get("accelerators")
    queue = pool_profiles.get("profiles", {}).get(profile_name, {}).get("queue", {})
    local_queue = str(queue.get("local_queue_name", "fs2-models-async"))

    pools: dict[str, Any] = {}
    pool_features: dict[str, Mapping[str, Any]] = {}
    for pool_id, raw_pool in sorted(raw_pools.items()):
        if not isinstance(raw_pool, Mapping):
            raise DeploymentError(f"accelerator pool {pool_id!r} is malformed")
        capacity = raw_pool.get("capacity", {})
        node = raw_pool.get("node", {})
        resource_api = raw_pool.get("resource_api", {})
        scheduling = raw_pool.get("scheduling", {})
        selectors = scheduling.get("stable_node_labels", {})
        tolerations = scheduling.get("tolerations", [])
        pools[str(pool_id)] = {
            "resource_name": str(resource_api.get("resource_name", "nvidia.com/gpu")),
            "accelerator_class": str(raw_pool.get("accelerator_class", "")),
            "capacity_type": str(capacity.get("type", "regular")),
            "accelerators_per_node": int(node.get("gpus_per_node", 0)),
            "min_nodes": int(capacity.get("min_nodes", 0)),
            "max_nodes": int(capacity.get("max_nodes", 0)),
            "node_selector": {
                str(key): str(value)
                for key, value in sorted(selectors.items())
                if isinstance(key, str) and isinstance(value, str)
            },
            "tolerations": [
                {
                    "key": str(item.get("key", "")),
                    "operator": str(item.get("operator", "Equal")),
                    "value": item.get("value"),
                    "effect": item.get("effect"),
                    "toleration_seconds": item.get("toleration_seconds"),
                }
                for item in tolerations
                if isinstance(item, Mapping)
            ],
        }
        pool_features[str(pool_id)] = (
            raw_pool.get("features", {})
            if isinstance(raw_pool.get("features", {}), Mapping)
            else {}
        )

    model_images = workloads.get("model_image_overrides", {})
    selected_model_ids = contract.get("selected_model_ids", [])
    deployment_runtimes = selected_deployment_runtimes(
        {
            model_id: model_images[model_id]
            for model_id in selected_model_ids
            if model_id in model_images
        }
    )
    cpu_runtime_model_ids = {
        model_id
        for model_id, entry in deployment_runtimes.items()
        if entry["record"]["resources"]["gpu"]
        == {
            "class": "CPU",
            "count": 0,
            "topology": "cpu-only",
            "placement": None,
            "b300_state": "not-applicable",
            "alternatives": [],
        }
    }
    native_ids = set(
        json.loads(
            (SOLUTION_ROOT / "catalog/profiles/model-profiles.json").read_text(
                encoding="utf-8"
            )
        ).get("managed_native_model_ids", [])
    )
    managed_cpu_ids = cpu_runtime_model_ids & native_ids
    if cpu_runtime_model_ids:
        general_cpu_contract = dynamic.get("general_cpu_pool_contract")
        if not isinstance(general_cpu_contract, Mapping):
            raise DeploymentError(
                "a selected CPU deployment runtime requires the general CPU pool output"
            )
        general_pools = general_cpu_contract.get("pools")
        node_selector = general_cpu_contract.get("node_selector")
        taint = general_cpu_contract.get("taint")
        if (
            general_cpu_contract.get("schema")
            != "fs2-serve.nebius.ai/general-cpu-pools/v1"
            or not isinstance(general_pools, Mapping)
            or len(general_pools) != 1
            or not isinstance(node_selector, Mapping)
            or not node_selector
            or not isinstance(taint, Mapping)
        ):
            raise DeploymentError(
                "a selected CPU deployment runtime requires one exact general CPU pool"
            )
        for pool_id, raw_pool in sorted(general_pools.items()):
            if pool_id in pools or not isinstance(raw_pool, Mapping):
                raise DeploymentError(
                    "the general CPU pool identity is malformed or duplicated"
                )
            pools[str(pool_id)] = {
                "resource_name": "cpu",
                "accelerator_class": "CPU",
                "capacity_type": str(raw_pool.get("capacity_type", "")),
                "accelerators_per_node": 0,
                "min_nodes": int(raw_pool.get("min_nodes", 0)),
                "max_nodes": int(raw_pool.get("max_nodes", 0)),
                "node_selector": {
                    **{
                        str(key): str(value)
                        for key, value in sorted(node_selector.items())
                        if isinstance(key, str) and isinstance(value, str)
                    },
                    "capacity.fs2.nebius/pool-id": str(pool_id),
                },
                "tolerations": [
                    {
                        "key": str(taint.get("key", "")),
                        "operator": "Equal",
                        "value": str(taint.get("value", "")),
                        "effect": str(taint.get("effect", "")),
                        "toleration_seconds": None,
                    }
                ],
            }
            if managed_cpu_ids:
                resources = raw_pool.get("schedulable_capacity", {})
                pools[str(pool_id)].update(
                    {
                        "allocatable_cpu_millis": int(
                            resources.get("cpu_millicores", 0)
                        ),
                        "allocatable_memory_bytes": int(resources.get("memory_mib", 0))
                        * 1048576,
                    }
                )
            pool_features[str(pool_id)] = {}
    deployment_identities = (
        deployment_runtime_configuration_identities(deployment_runtimes)
        if deployment_runtimes
        else {}
    )
    scaling = {
        model_id: (
            {
                "min_replicas": 1,
                "max_replicas": 1,
                "target_queue_depth": 1,
                "polling_interval_seconds": int(
                    workloads["keda_polling_interval_seconds"]
                ),
                "cooldown_seconds": int(workloads["keda_cooldown_period_seconds"]),
            }
            if model_id in cpu_runtime_model_ids and model_id not in managed_cpu_ids
            else _admin_scaling(workloads, model_id)
        )
        for model_id in selected_model_ids
    }
    models: dict[str, Any] = {}
    for model_id in selected_model_ids:
        if (
            model_id not in catalog.records
            or model_id not in catalog.acquisition_plans
            or model_id not in catalog.semantic_requests
        ):
            raise DeploymentError(
                f"model {model_id!r} lacks canonical admin configuration identities"
            )
        value = (
            deployment_runtimes[model_id]["record"]
            if model_id in deployment_runtimes
            else catalog.records[model_id].to_dict()
        )
        route = routes.get(model_id)
        if route is None and model_id in deployment_runtimes:
            # New native models do not rewrite the archived 16-model route
            # inventory. Their selected, validated record owns this metadata.
            route = {
                "mcp": {
                    "enabled": value["interface"]["mcp"]["discoverable"],
                    "tool_name": f"infer_{model_id.replace('-', '_')}",
                }
            }
        image_reference = model_images.get(model_id)
        if not isinstance(route, Mapping) or not isinstance(image_reference, str):
            raise DeploymentError(f"model {model_id!r} lacks a deployed route or image")
        image_repository, image_digest = split_digest_reference(
            image_reference,
            label=f"admin configuration model/{model_id}",
        )
        gpu = value["resources"]["gpu"]
        pool_ids = _admin_pool_ids(
            contract,
            workloads,
            pools,
            model_id=model_id,
            accelerator_class=str(gpu["class"]),
        )
        selected_pool_features = [pool_features[pool_id] for pool_id in pool_ids]
        cache_tier = (
            "node-local"
            if model_id in cpu_runtime_model_ids
            or any(
                item.get("local_cache") == "node-local"
                for item in selected_pool_features
            )
            else "shared-filesystem"
            if any(
                item.get("shared_filesystem") is True for item in selected_pool_features
            )
            else "object-store"
        )
        mcp = route.get("mcp", {})
        mcp_enabled = bool(isinstance(mcp, Mapping) and mcp.get("enabled") is True)
        readiness_timeout = int(value["interface"]["readiness"]["timeout_seconds"])
        acquisition_sha256 = canonical_sha256(
            catalog.acquisition_plans[model_id].to_dict()
        )
        models[model_id] = {
            "model_id": model_id,
            "enabled": True,
            "placement": {
                "pool_ids": pool_ids,
                "accelerators": int(gpu["count"]),
                "topology_policy": "any"
                if model_id in cpu_runtime_model_ids
                else "single-node",
            },
            "autoscaling": scaling[model_id],
            "queue": {
                "local_queue": (
                    str(workloads.get("general_cpu_lane", {}).get("local_queue", ""))
                    if model_id in cpu_runtime_model_ids
                    else local_queue
                ),
                "priority_class": "default",
                "max_queue_seconds": 7200,
            },
            "snapshot": {
                "strategy": "disabled",
                "cache_tier": cache_tier,
                "restore_timeout_seconds": max(600, readiness_timeout),
                "parallelism": 1,
                "require_semantic_check": True,
            },
            "mcp": {
                "exposed": mcp_enabled,
                "tool_name": str(mcp["tool_name"]) if mcp_enabled else None,
            },
            "rate": {
                "requests_per_minute": None,
                "concurrent_requests": 1,
                "accelerator_seconds_per_day": None,
            },
            "artifact": {
                "image_repository": image_repository,
                "image_digest": image_digest,
                "model_revision": str(value["model"]["source"]["revision"]),
                "artifact_manifest_sha256": value["cache"]["artifact"].get(
                    "manifest_digest"
                ),
                "acquisition_contract_sha256": acquisition_sha256,
                "provenance_sha256": catalog.records[model_id].digest,
                "semantic_health_contract_sha256": catalog.semantic_requests[
                    model_id
                ].digest,
            },
        }
        if model_id in managed_cpu_ids:
            models[model_id]["placement"].update(
                {
                    "cpu_millis": int(value["resources"]["cpu_millis"]),
                    "memory_bytes": int(value["resources"]["memory_bytes"]),
                }
            )
        if model_id in deployment_identities:
            identity = deployment_identities[model_id]
            models[model_id]["artifact"].update(
                {
                    key: identity[key]
                    for key in (
                        "model_revision",
                        "artifact_manifest_sha256",
                        "acquisition_contract_sha256",
                        "provenance_sha256",
                        "semantic_health_contract_sha256",
                    )
                }
            )

    configuration = {
        "schema_version": "fs2.admin-configuration/v1",
        "pools": pools,
        "models": models,
    }
    return configuration, canonical_sha256(configuration), scaling


def merge_docker_config(base: Any, extra: Any) -> dict[str, Any]:
    """Merge Docker auth documents without logging or persisting credentials."""
    if not isinstance(base, dict) or not isinstance(extra, dict):
        raise DeploymentError("registry Docker configuration must be a JSON object")
    merged = dict(base)
    for key in ("auths", "credHelpers"):
        base_values = merged.get(key, {})
        extra_values = extra.get(key, {})
        if not isinstance(base_values, dict) or not isinstance(extra_values, dict):
            raise DeploymentError(
                f"registry Docker configuration {key} must be an object"
            )
        merged[key] = {**base_values, **extra_values}
    for key, value in extra.items():
        if key not in {"auths", "credHelpers"}:
            merged[key] = value
    return merged


@contextmanager
def registry_client_environment(
    contract: Mapping[str, Any],
    nebius_profile: str,
) -> Iterator[dict[str, str]]:
    """Materialize optional private registry auth only in an ephemeral directory."""
    environment = clean_environment()
    environment["NEBIUS_PROFILE"] = nebius_profile
    secret_name = contract["secret_environment"]["nvcr_dockerconfig"]
    encoded_extra = os.environ.get(secret_name)
    if not encoded_extra:
        yield environment
        return
    try:
        extra = json.loads(encoded_extra)
    except json.JSONDecodeError as exc:
        raise DeploymentError(
            f"the Docker configuration in environment reference {secret_name!r} is not valid JSON"
        ) from exc

    docker_config_root = Path(
        environment.get("DOCKER_CONFIG", str(Path.home() / ".docker"))
    )
    base_path = docker_config_root / "config.json"
    base: Any = {}
    if base_path.is_file() and not base_path.is_symlink():
        try:
            base = json.loads(base_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            raise DeploymentError(
                "the existing Docker configuration is not valid JSON"
            ) from exc

    with tempfile.TemporaryDirectory(prefix="fs2-registry-auth-") as temporary:
        temporary_root = Path(temporary)
        temporary_root.chmod(0o700)
        private_json(temporary_root / "config.json", merge_docker_config(base, extra))
        environment["DOCKER_CONFIG"] = str(temporary_root)
        yield environment


def crane_digest(
    crane: str,
    reference: str,
    environment: Mapping[str, str],
    *,
    missing_ok: bool = False,
) -> str | None:
    result = subprocess.run(
        [crane, "digest", reference],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        missing_markers = (
            "manifest unknown",
            "manifest_unknown",
            "name unknown",
            "name_unknown",
            "not found",
            "404",
        )
        diagnostic = f"{result.stdout}\n{result.stderr}".lower()
        if missing_ok and any(marker in diagnostic for marker in missing_markers):
            return None
        raise DeploymentError(
            "registry digest lookup failed; verify source existence and operator registry credentials"
        )
    digest = result.stdout.strip()
    if not digest.startswith("sha256:") or len(digest) != 71:
        raise DeploymentError("registry returned a malformed OCI digest")
    return digest


def crane_copy(
    crane: str,
    source: str,
    target_tag: str,
    environment: Mapping[str, str],
) -> None:
    result = subprocess.run(
        [crane, "copy", "--no-clobber", source, target_tag],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise DeploymentError(
            "regional image copy failed; verify upstream pull and target push credentials"
        )


def mirror_selected_images(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    dynamic: Mapping[str, Any],
) -> Path | None:
    """Copy and verify the complete selected image closure before workloads."""
    if contract["artifact_delivery"]["mode"] == "direct-source":
        return None
    artifacts = selected_image_artifacts(
        contract, dynamic["registry_delivery_contract"]
    )
    receipt_images: list[dict[str, str]] = []
    completed_targets: dict[str, str] = {}
    with registry_client_environment(contract, args.nebius_profile) as environment:
        for artifact in artifacts:
            expected = artifact["digest"]
            target_reference = artifact["target_reference"]
            status = completed_targets.get(target_reference)
            if status is None:
                existing = crane_digest(
                    args.crane, artifact["target_tag"], environment, missing_ok=True
                )
                if existing is not None and existing != expected:
                    raise DeploymentError(
                        f"target mirror tag digest mismatch for {artifact['name']}; refusing to overwrite"
                    )
                if existing == expected:
                    status = "existing"
                else:
                    source_digest = crane_digest(
                        args.crane, artifact["source_reference"], environment
                    )
                    if source_digest != expected:
                        raise DeploymentError(
                            f"upstream digest mismatch for {artifact['name']}; refusing to deploy"
                        )
                    print(
                        f"Mirroring {artifact['name']} into the regional registry.",
                        file=sys.stderr,
                    )
                    crane_copy(
                        args.crane,
                        artifact["source_reference"],
                        artifact["target_tag"],
                        environment,
                    )
                    status = "copied"
                if (
                    crane_digest(args.crane, artifact["target_tag"], environment)
                    != expected
                ):
                    raise DeploymentError(
                        f"post-copy tag verification failed for {artifact['name']}"
                    )
                if (
                    crane_digest(args.crane, artifact["target_reference"], environment)
                    != expected
                ):
                    raise DeploymentError(
                        f"post-copy digest-reference verification failed for {artifact['name']}"
                    )
                completed_targets[target_reference] = status
            receipt_images.append(
                {
                    "name": artifact["name"],
                    "source_host": artifact["source_repository"].split("/", 1)[0],
                    "digest": expected,
                    "target_reference": artifact["target_reference"],
                    "status": status,
                }
            )
    receipt = {
        "schema": "fs2-serve.nebius.ai/registry-mirror-receipt/v1",
        "mode": "regional-mirror",
        "registry_id": dynamic["registry_delivery_contract"]["target_registry"]["id"],
        "images": receipt_images,
    }
    path = run_root / "registry-mirror.receipt.json"
    private_json(path, receipt)
    return path


def stage_paths(run_root: Path, stage: str) -> tuple[Path, Path, Path]:
    state_names = {
        "infrastructure": "terraform.tfstate",
        "foundation": "foundation.tfstate",
        "workloads": "workloads.tfstate",
    }
    return (
        run_root / state_names[stage],
        run_root / f"{stage}.tfvars.json",
        run_root / "terraform-data" / stage,
    )


def stage_root(stage: str) -> Path:
    return {
        "infrastructure": INFRA_ROOT,
        "foundation": FOUNDATION_ROOT,
        "workloads": WORKLOADS_ROOT,
    }[stage]


def stage_environment(
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
    *,
    include_secrets: bool = True,
) -> dict[str, str]:
    environment = terraform_environment(run_root, stage)
    if not include_secrets:
        return environment
    secret_names = contract["secret_environment"]

    if stage == "foundation":
        username = os.environ.get(secret_names["grafana_username"])
        password = os.environ.get(secret_names["grafana_password"])
        if not username or not password:
            raise DeploymentError(
                "fresh foundation deployment requires both configured Grafana bootstrap username and password environment references"
            )
        environment["TF_VAR_bootstrap_grafana_credentials"] = json.dumps(
            {"username": username, "password": password},
            separators=(",", ":"),
        )

    if stage == "workloads":
        ngc_key = os.environ.get(secret_names["ngc_api_key"])
        docker_config = os.environ.get(secret_names["nvcr_dockerconfig"])
        requirements = contract["secret_requirements"]
        if requirements["ngc_api_key"] and not ngc_key:
            raise DeploymentError(
                "the selected NIM models require the configured NGC API-key environment reference"
            )
        if requirements["nvcr_dockerconfig"] and not docker_config:
            raise DeploymentError(
                "the selected workloads require the configured NVCR dockerconfig environment reference"
            )
        if ngc_key:
            environment["TF_VAR_ngc_api_key"] = ngc_key
        if docker_config:
            environment["TF_VAR_nvcrio_dockerconfigjson"] = docker_config

    return environment


def write_infrastructure_variables(
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
    nebius_profile: str,
) -> Path:
    variables = dict(contract["stages"]["infrastructure"])
    variables["source_commit"] = commit
    variables["nebius_profile"] = nebius_profile
    path = run_root / "infrastructure.tfvars.json"
    private_json(path, variables)
    return path


def ensure_kubeconfig(
    *,
    nebius: str,
    nebius_profile: str,
    kubectl: str,
    run_root: Path,
    cluster_id: str,
    cluster_name: str,
) -> tuple[Path, str]:
    kubeconfig = run_root / "kubeconfig"
    if kubeconfig.is_symlink():
        raise DeploymentError(f"kubeconfig path must not be a symlink: {kubeconfig}")
    environment = clean_environment()
    environment["KUBECONFIG"] = str(kubeconfig)
    run(
        [
            nebius,
            "--profile",
            nebius_profile,
            "mk8s",
            "cluster",
            "get-credentials",
            "--id",
            cluster_id,
            "--external",
            "--force",
            "--context-name",
            cluster_name,
        ],
        env=environment,
    )
    if not kubeconfig.is_file():
        raise DeploymentError("Nebius CLI did not create the run-scoped kubeconfig")
    kubeconfig.chmod(0o600)
    result = run(
        [
            kubectl,
            "--kubeconfig",
            str(kubeconfig),
            "--context",
            cluster_name,
            "get",
            "namespace",
            "kube-system",
            "-o",
            "jsonpath={.metadata.uid}",
        ],
        env=environment,
        capture=True,
    )
    uid = result.stdout.strip()
    if len(uid) < 20:
        raise DeploymentError("kube-system did not return a valid namespace UID")
    return kubeconfig, uid


def legacy_registry_delivery_contract(
    contract: Mapping[str, Any], target_contract: Mapping[str, Any]
) -> dict[str, Any]:
    """Upgrade an existing state whose target registry predates the v1 output."""
    registry = target_contract.get("source_registry")
    if not isinstance(registry, dict):
        raise DeploymentError(
            "the existing infrastructure state has neither a registry-delivery output nor a legacy target registry"
        )
    registry_id = str(registry.get("id", ""))
    fqdn = str(registry.get("fqdn", "")).rstrip("/")
    if not registry_id.startswith("registry-") or not fqdn:
        raise DeploymentError("the legacy infrastructure target registry is malformed")
    policy = contract["artifact_delivery"]
    target_region = contract["target"]["region"]
    cross_region_hosts = sorted(
        host
        for host in policy["source_hosts"]
        if (match := re.fullmatch(r"cr\.([a-z0-9-]+)\.nebius\.cloud", host))
        and match.group(1) != target_region
    )
    return {
        "schema": "fs2-serve.nebius.ai/registry-delivery/v1",
        "mode": policy["mode"],
        "repository_prefix": policy["repository_prefix"],
        "target_registry": {
            "id": registry_id,
            "project_id": registry.get("project_id", contract["target"]["project_id"]),
            "region": target_region,
            "fqdn": fqdn,
            "repository_root": f"{fqdn}/{registry_id.removeprefix('registry-')}",
        },
        "upstream": {
            "source_hosts": policy["source_hosts"],
            "nebius_registries": {},
        },
        "promotion_cross_region_required": bool(cross_region_hosts)
        and policy["mode"] == "regional-mirror",
        "runtime_cross_region_pull_required": bool(cross_region_hosts)
        and policy["mode"] == "direct-source",
        "cross_region_source_hosts": cross_region_hosts,
        "derived_from_legacy_state": True,
    }


def infrastructure_outputs(
    terraform: str,
    run_root: Path,
    contract: Mapping[str, Any],
    *,
    nebius: str,
    nebius_profile: str,
    kubectl: str,
) -> dict[str, Any]:
    environment = stage_environment(run_root, "infrastructure", contract)
    state, _, _ = stage_paths(run_root, "infrastructure")
    terraform_init(terraform, INFRA_ROOT, state, environment)
    cluster_id = terraform_json_output(terraform, INFRA_ROOT, "cluster_id", environment)
    cluster_name = terraform_json_output(
        terraform, INFRA_ROOT, "cluster_name", environment
    )
    kubeconfig, kube_system_uid = ensure_kubeconfig(
        nebius=nebius,
        nebius_profile=nebius_profile,
        kubectl=kubectl,
        run_root=run_root,
        cluster_id=cluster_id,
        cluster_name=cluster_name,
    )
    target_contract = terraform_json_output(
        terraform, INFRA_ROOT, "target_contract", environment
    )
    registry_delivery = terraform_optional_json_output(
        terraform, INFRA_ROOT, "registry_delivery_contract", environment
    )
    if registry_delivery is None:
        registry_delivery = legacy_registry_delivery_contract(contract, target_contract)
    reference_data_enabled = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("reference_data", {})
        .get("enabled")
        is True
    )
    reference_data_storage = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "reference_data_storage_contract", environment
        )
        if reference_data_enabled
        else None
    )
    reference_data_access = (
        terraform_optional_json_output(
            terraform,
            INFRA_ROOT,
            "reference_data_object_storage_access",
            environment,
        )
        if reference_data_enabled
        else None
    )
    reference_data_lifecycle = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "reference_data_lifecycle", environment
        )
        if reference_data_enabled
        else None
    )
    scientific_artifacts_enabled = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("scientific_artifacts", {})
        .get("enabled")
        is True
    )
    scientific_artifacts_storage = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "scientific_artifacts_storage_contract", environment
        )
        if scientific_artifacts_enabled
        else None
    )
    # Carries only the access-key ID, the opaque MysteryBox reference and a
    # revision. The S3 secret is resolved ephemerally inside the workloads
    # apply and never reaches this process, a tfvars file or a receipt.
    scientific_artifacts_access = (
        terraform_optional_json_output(
            terraform,
            INFRA_ROOT,
            "scientific_artifacts_object_storage_access",
            environment,
        )
        if scientific_artifacts_enabled
        else None
    )
    scientific_artifacts_lifecycle = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "scientific_artifacts_lifecycle", environment
        )
        if scientific_artifacts_enabled
        else None
    )
    # A general CPU pool is optional, so the output is read only when the facade
    # declared one. Its absence is a valid deployment, not a missing handoff.
    general_cpu_pools = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "general_cpu_pool_contract", environment
        )
        if contract.get("stages", {}).get("infrastructure", {}).get("cpu_pools")
        else None
    )
    return {
        "run_root": str(run_root.resolve()),
        "nebius_profile": nebius_profile,
        "kubeconfig_path": str(kubeconfig.resolve()),
        "run_id": contract["run_id"],
        "cluster_id": cluster_id,
        "general_cpu_pool_contract": general_cpu_pools,
        "cluster_name": cluster_name,
        "kube_context": cluster_name,
        "kube_system_uid": kube_system_uid,
        "project_id": contract["target"]["project_id"],
        "target_contract": target_contract,
        "infrastructure_contract": terraform_optional_json_output(
            terraform, INFRA_ROOT, "infrastructure_contract", environment
        ),
        "accelerator_pool_contract": terraform_json_output(
            terraform, INFRA_ROOT, "accelerator_pool_contract", environment
        ),
        "registry_delivery_contract": registry_delivery,
        "public_edge_contract": terraform_json_output(
            terraform, INFRA_ROOT, "public_edge_contract", environment
        ),
        "reference_data_storage_contract": reference_data_storage,
        "reference_data_object_storage_access": reference_data_access,
        "reference_data_lifecycle": reference_data_lifecycle,
        "scientific_artifacts_storage_contract": scientific_artifacts_storage,
        "scientific_artifacts_object_storage_access": scientific_artifacts_access,
        "scientific_artifacts_lifecycle": scientific_artifacts_lifecycle,
    }


def existing_controller_ownership(
    run_root: Path, cluster_id: str, handoff_receipt: str | None
) -> bool:
    """Recognize a completed handoff without repeating it for every new model.

    The initial receipt still proves the transition. Later model/template
    changes do not invalidate that transition when the same accepted state
    already has a single GPU controller owner and no legacy GPU serving objects.
    Exact static CPU services are a separate Terraform-owned lane.
    """
    state_path = run_root / "workloads.tfstate"
    if not handoff_receipt or state_path.is_symlink() or not state_path.is_file():
        return False
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
        resources = state["resources"]
        inputs = {
            resource["name"]: resource["instances"][0]["attributes"]["input"]["value"]
            for resource in resources
            if resource.get("mode") == "managed"
            and resource.get("type") == "terraform_data"
            and not resource.get("module")
            and resource.get("name")
            in {"cluster_contract", "model_controller_contract"}
        }
        controller = inputs["model_controller_contract"]
        accepted = controller.get("accepted_handoff_receipt") or controller.get(
            "expected_handoff_receipt"
        )
        if (
            inputs["cluster_contract"]["cluster_id"] != cluster_id
            or controller.get("workload_owner") != "controller"
            or accepted != handoff_receipt
        ):
            return False
        cpu_resources = set()
        for resource in resources:
            if (
                resource.get("mode") != "managed"
                or resource.get("type") != "terraform_data"
                or resource.get("name") != "cpu_model_runtime_contract"
                or resource.get("module")
            ):
                continue
            for instance in resource.get("instances", []):
                cpu = instance["attributes"]["input"]["value"]
                for document in (cpu["deployment"], cpu["service_manifest"]):
                    metadata = document["metadata"]
                    cpu_resources.add(
                        (document["kind"], metadata["namespace"], metadata["name"])
                    )
                deployment = cpu["deployment"]
                account = deployment["spec"]["template"]["spec"].get(
                    "serviceAccountName"
                )
                if account:
                    cpu_resources.add(
                        ("ServiceAccount", deployment["metadata"]["namespace"], account)
                    )
        for resource in resources:
            if (
                resource.get("mode") != "managed"
                or resource.get("type") != "kubernetes_manifest"
            ):
                continue
            if resource.get("name") == "model_scaler" and resource.get("instances"):
                return False
            if resource.get("name") == "model":
                for instance in resource.get("instances", []):
                    manifest = instance["attributes"]["manifest"]["value"]
                    metadata = manifest.get("metadata", {})
                    if (
                        manifest.get("kind"),
                        metadata.get("namespace"),
                        metadata.get("name"),
                    ) in cpu_resources:
                        continue
                    if manifest.get("kind") in {
                        "Deployment",
                        "Service",
                        "ServiceAccount",
                        "ConfigMap",
                    }:
                        return False
        return True
    except (OSError, ValueError, KeyError, IndexError, TypeError):
        return False


def write_downstream_variables(
    run_root: Path,
    contract: Mapping[str, Any],
    dynamic: Mapping[str, Any],
) -> tuple[Path, Path]:
    identity_keys = (
        "run_root",
        "kubeconfig_path",
        "run_id",
        "cluster_id",
        "cluster_name",
        "kube_context",
        "kube_system_uid",
        "project_id",
        "target_contract",
        "infrastructure_contract",
        "accelerator_pool_contract",
    )
    identity = {key: dynamic[key] for key in identity_keys}
    foundation = {**contract["stages"]["foundation"], **identity}
    workloads = {
        **rewritten_workloads(contract, dynamic),
        **identity,
        "nebius_profile": dynamic.get("nebius_profile", "sandbox"),
        "public_edge_contract": dynamic["public_edge_contract"],
    }
    controller = workloads.get("model_controller")
    if isinstance(controller, Mapping):
        workloads["model_controller"] = {
            **controller,
            "existing_controller_ownership": existing_controller_ownership(
                run_root, dynamic["cluster_id"], controller.get("handoff_receipt")
            ),
        }
    reference_data = workloads.get("reference_data")
    if isinstance(reference_data, Mapping):
        enabled = reference_data.get("enabled") is True
        storage_contract = dynamic.get("reference_data_storage_contract")
        object_access = dynamic.get("reference_data_object_storage_access")
        if enabled and (
            not isinstance(storage_contract, Mapping)
            or not isinstance(object_access, Mapping)
        ):
            raise DeploymentError(
                "enabled reference data requires complete infrastructure storage and object-access outputs"
            )
        workloads["reference_data"] = {
            **reference_data,
            "storage_contract": storage_contract if enabled else None,
            "object_storage_access": object_access if enabled else None,
        }
    scientific_artifacts = workloads.get("scientific_artifacts")
    if isinstance(scientific_artifacts, Mapping):
        enabled = scientific_artifacts.get("enabled") is True
        storage_contract = dynamic.get("scientific_artifacts_storage_contract")
        object_access = dynamic.get("scientific_artifacts_object_storage_access")
        if enabled and (
            not isinstance(storage_contract, Mapping)
            or not isinstance(object_access, Mapping)
        ):
            raise DeploymentError(
                "an enabled scientific artifact store requires complete infrastructure "
                "bucket and object-access outputs"
            )
        if enabled and set(object_access) != {
            "key_id",
            "access_key_id",
            "secret_reference_id",
            "resource_version",
        }:
            raise DeploymentError(
                "the scientific artifact access handoff must contain exactly the key's "
                "non-secret identifiers: resource ID, access-key ID, MysteryBox reference "
                "and cloud resource version"
            )
        workloads["scientific_artifacts"] = {
            **scientific_artifacts,
            "storage_contract": storage_contract if enabled else None,
            "object_storage_access": object_access if enabled else None,
        }
    general_cpu_lane = workloads.get("general_cpu_lane")
    if isinstance(general_cpu_lane, Mapping):
        pool_contract = dynamic.get("general_cpu_pool_contract")
        if general_cpu_lane.get("enabled") is True and not isinstance(
            pool_contract, Mapping
        ):
            raise DeploymentError(
                "an enabled general CPU lane requires the infrastructure general-CPU pool contract"
            )
        if isinstance(pool_contract, Mapping):
            # The lane exists to keep general aggregation off the reference-data
            # nodes, so a pool contract that claims that filesystem is refused
            # rather than quietly admitted.
            if pool_contract.get("reference_data_filesystem") is not False:
                raise DeploymentError(
                    "a general CPU pool must never carry the reference-data filesystem"
                )
            if (
                pool_contract.get("schema")
                != "fs2-serve.nebius.ai/general-cpu-pools/v1"
            ):
                raise DeploymentError(
                    "the general CPU pool handoff must be the v1 general-CPU pool contract"
                )
        workloads["general_cpu_pools"] = (
            pool_contract if general_cpu_lane.get("enabled") is True else None
        )
    scientific_batch = workloads.get("scientific_batch")
    if isinstance(scientific_batch, Mapping):
        artifacts_enabled = (
            isinstance(scientific_artifacts, Mapping)
            and scientific_artifacts.get("enabled") is True
        )
        if scientific_batch.get("enabled") is True and not artifacts_enabled:
            raise DeploymentError(
                "staged scientific batch execution requires the dedicated artifact store"
            )
        if (
            scientific_batch.get("writes_enabled") is True
            and scientific_batch.get("enabled") is not True
        ):
            raise DeploymentError(
                "scientific batch Kubernetes writes require the batch controller gate"
            )
    admin_contract = contract.get("admin_configuration", {})
    if isinstance(admin_contract, Mapping) and admin_contract.get("enabled") is True:
        configuration, configuration_sha256, scaling = derived_admin_configuration(
            contract,
            dynamic,
            workloads,
        )
        workloads.update(
            {
                "admin_configuration": configuration,
                "admin_configuration_sha256": configuration_sha256,
                "model_scaling_overrides": scaling,
            }
        )
    if foundation["grafana_publication"]["enabled"]:
        edge = dynamic["public_edge_contract"]
        origin = edge.get("public_origin")
        parsed = urlsplit(origin or "")
        if (
            edge.get("mode") != "public"
            or parsed.scheme != "https"
            or not parsed.hostname
            or parsed.path not in ("", "/")
            or parsed.query
            or parsed.fragment
            or parsed.username
            or parsed.password
        ):
            raise DeploymentError(
                "external Grafana publication requires an exact HTTPS public origin from the infrastructure output"
            )
        origin = origin.rstrip("/")
        foundation["grafana_publication"] = {
            **foundation["grafana_publication"],
            "external_base_url": origin,
        }
        alertmanager_enabled = (
            isinstance(foundation.get("alertmanager"), Mapping)
            and foundation["alertmanager"].get("enabled") is True
        )
        workloads["admin_observability_links"] = {
            "allowed_hosts": [parsed.hostname],
            "grafana": {
                "url": f"{origin}/admin/observability/grafana",
                "verified_external_route": True,
            },
            "prometheus": {
                "url": f"{origin}/admin/observability/grafana/explore",
                "verified_external_route": True,
            },
            "loki": {
                "url": f"{origin}/admin/observability/grafana/explore",
                "verified_external_route": True,
            },
            "otel": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "dcgm": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "kueue": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "keda": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "alertmanager": (
                {
                    "url": f"{origin}/admin/observability/grafana/alerting/silences",
                    "verified_external_route": True,
                }
                if alertmanager_enabled
                else {"url": "", "verified_external_route": False}
            ),
            "tempo": {
                "url": f"{origin}/admin/observability/grafana/explore",
                "verified_external_route": True,
            },
        }
    foundation_path = run_root / "foundation.tfvars.json"
    workloads_path = run_root / "workloads.tfvars.json"
    private_json(foundation_path, foundation)
    private_json(workloads_path, workloads)
    return foundation_path, workloads_path


def plan_stage(
    terraform: str,
    *,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
    variable_file: Path,
    destroy: bool = False,
    environment_overrides: Mapping[str, str] | None = None,
) -> tuple[Path, dict[str, Any], dict[str, str]]:
    if stage == "workloads" and not destroy:
        expected_batch = (
            contract.get("stages", {}).get("workloads", {}).get("scientific_batch")
        )
        if isinstance(expected_batch, Mapping):
            if variable_file.is_symlink() or not variable_file.is_file():
                raise DeploymentError(
                    "the generated workloads input must be a regular file before planning"
                )
            try:
                workload_variables = json.loads(
                    variable_file.read_text(encoding="utf-8")
                )
            except (OSError, json.JSONDecodeError) as error:
                raise DeploymentError(
                    "the generated workloads input is not readable canonical JSON"
                ) from error
            actual_batch = (
                workload_variables.get("scientific_batch")
                if isinstance(workload_variables, Mapping)
                else None
            )
            if actual_batch != expected_batch:
                raise DeploymentError(
                    "the generated scientific batch input differs from the customer "
                    "configuration; regenerate staged inputs with inference-stack"
                )
    root = stage_root(stage)
    state, _, _ = stage_paths(run_root, stage)
    environment = stage_environment(
        run_root,
        stage,
        contract,
        include_secrets=not destroy,
    )
    if environment_overrides:
        environment.update(environment_overrides)
    terraform_init(terraform, root, state, environment)
    suffix = "destroy" if destroy else "plan"
    plan_path = run_root / f"{stage}-{suffix}.tfplan"
    document = plan_json(
        terraform,
        root=root,
        environment=environment,
        variable_file=variable_file,
        plan_path=plan_path,
        json_path=run_root / f"{stage}-{suffix}.plan.json",
        destroy=destroy,
    )
    return plan_path, document, environment


def apply_plan(
    terraform: str,
    root: Path,
    plan_path: Path,
    environment: Mapping[str, str],
) -> None:
    run(
        [terraform, f"-chdir={root}", "apply", "-input=false", str(plan_path)],
        env=environment,
    )


def _exact_kubernetes_user_info(document: Mapping[str, Any], label: str) -> dict[str, Any]:
    try:
        user_info = document["status"]["userInfo"]
        username = user_info["username"]
        groups = user_info["groups"]
        extras = user_info.get("extra", {})
    except (KeyError, TypeError) as exc:
        raise DeploymentError(f"{label} returned no complete authenticated identity") from exc
    if (
        not isinstance(username, str)
        or not username
        or not isinstance(groups, list)
        or not all(isinstance(group, str) and group for group in groups)
        or len(groups) != len(set(groups))
        or not isinstance(extras, dict)
    ):
        raise DeploymentError(f"{label} returned a malformed authenticated identity")
    return {"username": username, "groups": sorted(groups), "extras": extras}


@contextmanager
def model_network_transition_lock(
    *,
    kubectl: str,
    kubeconfig: str,
    context: str,
    run_id: str,
    lease_name: str = "fs2-model-network-transition",
    expected_username: str = "fs2-model-network-transition",
    expected_groups: tuple[str, ...] = (
        "fs2:model-network-transition",
        "system:authenticated",
    ),
) -> Iterator[tuple[str, str]]:
    """Hold one API-guarded Lease using its separately custodied credential."""
    namespace = "fs2-system"
    name = lease_name
    holder = f"{run_id}:{os.getpid()}:{secrets.token_hex(16)}"
    transition_writer = expected_username
    environment = clean_environment()
    base = [
        kubectl,
        "--kubeconfig",
        kubeconfig,
        "--context",
        context,
    ]
    authenticated = subprocess.run(
        [*base, "auth", "whoami", "-o", "json"],
        env=environment,
        text=True,
        capture_output=True,
        check=False,
    )
    if authenticated.returncode != 0:
        raise DeploymentError(
            "cannot resolve the exact Kubernetes-authenticated transition writer: "
            + (
                authenticated.stderr.strip()
                or authenticated.stdout.strip()
                or "kubectl auth whoami failed"
            )
        )
    try:
        authenticated_info = _exact_kubernetes_user_info(
            json.loads(authenticated.stdout), "kubectl auth whoami"
        )
        authenticated_username = authenticated_info["username"]
    except json.JSONDecodeError as exc:
        raise DeploymentError(
            "kubectl auth whoami returned malformed JSON"
        ) from exc
    if not isinstance(authenticated_username, str) or not authenticated_username:
        raise DeploymentError("the authenticated transition writer is empty")
    if authenticated_username != transition_writer:
        raise DeploymentError(
            "model-network transitions require the dedicated externally custodied writer"
        )
    if authenticated_info["groups"] != sorted(expected_groups) or authenticated_info["extras"]:
        raise DeploymentError(
            "the model-network operation writer group/extra identity is not exact"
        )
    observed = subprocess.run(
        [*base, "-n", namespace, "get", "lease", name, "-o", "json"],
        env=environment,
        text=True,
        capture_output=True,
        check=False,
    )
    now = datetime.now(UTC)
    if observed.returncode != 0:
        raise DeploymentError(
            "the provider-owned model-network operation Lease is unavailable; "
            "the phase writer may update it but can never create or delete it"
        )
    else:
        try:
            lease = json.loads(observed.stdout)
            metadata = lease["metadata"]
            annotations = metadata.get("annotations", {})
            if not isinstance(annotations, dict):
                raise ValueError("Lease annotations are malformed")
            prior_writer = annotations.get(
                "fs2-serve.nebius.ai/network-transition-writer"
            )
            if prior_writer not in {None, authenticated_username}:
                raise DeploymentError(
                    "model-network transition Lease is bound to a different "
                    "authenticated writer"
                )
            spec = lease.get("spec", {})
            if "holderIdentity" not in spec or "leaseTransitions" not in spec:
                raise ValueError("required Lease state is absent")
            current_holder = spec["holderIdentity"]
            renew_time = datetime.fromisoformat(
                spec.get("renewTime", "1970-01-01T00:00:00Z").replace("Z", "+00:00")
            )
            duration = int(spec.get("leaseDurationSeconds", 0))
            transitions = int(spec["leaseTransitions"])
        except (KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
            raise DeploymentError(
                "model-network transition Lease is malformed"
            ) from exc
        if current_holder and renew_time + timedelta(seconds=duration) > now:
            raise DeploymentError(
                f"model-network transition Lease is held by {current_holder!r}"
            )
        patch = [
            {
                "op": "test",
                "path": "/metadata/resourceVersion",
                "value": metadata["resourceVersion"],
            },
            {"op": "test", "path": "/spec/holderIdentity", "value": current_holder},
            (
                {
                    "op": "add",
                    "path": "/metadata/annotations",
                    "value": {
                        "fs2-serve.nebius.ai/network-transition-writer": authenticated_username,
                        "fs2-serve.nebius.ai/network-transition-holder": holder,
                    },
                }
                if "annotations" not in metadata
                else {
                    "op": "add",
                    "path": "/metadata/annotations/fs2-serve.nebius.ai~1network-transition-writer",
                    "value": authenticated_username,
                }
            ),
            {
                "op": "add",
                "path": "/metadata/annotations/fs2-serve.nebius.ai~1network-transition-holder",
                "value": holder,
            },
            {"op": "replace", "path": "/spec/holderIdentity", "value": holder},
            {"op": "replace", "path": "/spec/leaseDurationSeconds", "value": 7200},
            {
                "op": "replace",
                "path": "/spec/renewTime",
                "value": now.isoformat().replace("+00:00", "Z"),
            },
            {
                "op": "replace",
                "path": "/spec/leaseTransitions",
                "value": transitions + 1,
            },
        ]
        run(
            [
                *base,
                "-n",
                namespace,
                "patch",
                "lease",
                name,
                "--type=json",
                "-p",
                json.dumps(patch, separators=(",", ":")),
            ],
            env=environment,
        )
    try:
        yield holder, authenticated_username
    finally:
        release_observed = subprocess.run(
            [*base, "-n", namespace, "get", "lease", name, "-o", "json"],
            env=environment,
            text=True,
            capture_output=True,
            check=False,
        )
        try:
            release_resource_version = json.loads(release_observed.stdout)["metadata"][
                "resourceVersion"
            ]
        except (KeyError, TypeError, json.JSONDecodeError) as exc:
            raise DeploymentError(
                "cannot reconstruct the operation Lease CAS before release"
            ) from exc
        if (
            release_observed.returncode != 0
            or not isinstance(release_resource_version, str)
            or not release_resource_version
        ):
            raise DeploymentError(
                "cannot read the operation Lease immediately before release"
            )
        released_at = datetime.now(UTC).isoformat().replace("+00:00", "Z")
        release_patch = [
            {
                "op": "test",
                "path": "/metadata/resourceVersion",
                "value": release_resource_version,
            },
            {"op": "test", "path": "/spec/holderIdentity", "value": holder},
            {"op": "replace", "path": "/spec/holderIdentity", "value": ""},
            {"op": "replace", "path": "/spec/leaseDurationSeconds", "value": 1},
            {"op": "replace", "path": "/spec/renewTime", "value": released_at},
        ]
        run(
            [
                *base,
                "-n",
                namespace,
                "patch",
                "lease",
                name,
                "--type=json",
                "-p",
                json.dumps(release_patch, separators=(",", ":")),
            ],
            env=environment,
        )


def model_network_boundary_holder(
    *, kubectl: str, kubeconfig: str, context: str
) -> str:
    """Read the immutable marker's stable holder without mutating the boundary."""

    result = subprocess.run(
        [
            kubectl,
            "--kubeconfig",
            kubeconfig,
            "--context",
            context,
            "--namespace",
            "fs2-models",
            "get",
            "configmap",
            "fs2-runtime-network-policy-boundary-v2",
            "--output",
            "json",
        ],
        env=clean_environment(),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise DeploymentError("cannot read the armed model-network boundary marker")
    try:
        marker = json.loads(result.stdout)
        metadata = marker["metadata"]
        holder = metadata["annotations"][
            "fs2-serve.nebius.ai/network-transition-holder"
        ]
        writer = metadata["annotations"][
            "fs2-serve.nebius.ai/network-transition-writer"
        ]
    except (KeyError, TypeError, json.JSONDecodeError) as exc:
        raise DeploymentError("the armed model-network boundary marker is malformed") from exc
    if (
        marker.get("immutable") is not True
        or writer != "fs2-model-network-transition"
        or not isinstance(holder, str)
        or re.fullmatch(r"[a-z][a-z0-9]{5,11}:[1-9][0-9]*:[a-f0-9]{32}", holder)
        is None
    ):
        raise DeploymentError("the armed model-network boundary marker has no stable exact holder")
    return holder


def _sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _semantic_kubernetes_object(value: Mapping[str, Any]) -> dict[str, Any]:
    document = json.loads(json.dumps(value))
    document.pop("status", None)
    metadata = document.get("metadata", {})
    if isinstance(metadata, dict):
        for field in (
            "creationTimestamp",
            "generation",
            "managedFields",
            "resourceVersion",
            "uid",
        ):
            metadata.pop(field, None)
    return document


def _json_sha256(value: Mapping[str, Any]) -> str:
    return hashlib.sha256(
        json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()


def _finite_release_match_conditions(
    entries: list[Mapping[str, Any]],
) -> list[dict[str, str]]:
    if not entries or not all(isinstance(entry, Mapping) for entry in entries):
        raise DeploymentError("the finite signed release inventory is malformed")
    identities = sorted(
        {
            "|".join(
                (
                    str(entry.get("group", "")),
                    str(entry.get("resource", "")),
                    str(entry.get("namespace", "")),
                    str(entry.get("name", "")),
                    str(operation),
                )
            )
            for entry in entries
            for operation in entry.get("operations", [])
        }
    )
    return [
        {
            "name": "finite-signed-release-inventory",
            "expression": (
                json.dumps(identities, separators=(",", ":"))
                + ".exists(identity, identity == request.resource.group + '|' + "
                "request.resource.resource + '|' + request.namespace + '|' + "
                "request.name + '|' + request.operation)"
            ),
        }
    ]


def _verified_provider_custody(
    *,
    cluster_id: str,
    provider_trust_root_sha256: str,
) -> tuple[dict[str, Any], str, datetime]:
    """Verify the independent provider/IAM custody assertion.

    Kubernetes admission cannot match ValidatingAdmissionPolicy or its binding,
    and an in-cluster webhook cannot safely protect its own serving chain.  This
    assertion is therefore signed under a trust root distinct from the receipt
    signer and is a mandatory external prerequisite, not an in-cluster claim.
    """

    paths = {
        "attestation": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_ATTESTATION", "")
        ),
        "signature": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_SIGNATURE", "")
        ),
        "trust root": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_TRUST_ROOT", "")
        ),
    }
    for label, path in paths.items():
        if not path.is_absolute() or path.is_symlink() or not path.is_file():
            raise DeploymentError(
                f"the external provider custody {label} must be an absolute regular file"
            )
    if not re.fullmatch(r"[a-f0-9]{64}", provider_trust_root_sha256):
        raise DeploymentError(
            "the root contract must pin the distinct provider custody trust root"
        )
    if _sha256_file(paths["trust root"]) != provider_trust_root_sha256:
        raise DeploymentError(
            "the provider custody signing key differs from the root-pinned digest"
        )
    verified = subprocess.run(
        [
            os.environ.get("FS2_OPENSSL", "openssl"),
            "dgst",
            "-sha256",
            "-verify",
            str(paths["trust root"]),
            "-signature",
            str(paths["signature"]),
            str(paths["attestation"]),
        ],
        env=clean_environment(),
        text=True,
        capture_output=True,
        check=False,
    )
    if verified.returncode != 0 or verified.stdout.strip() != "Verified OK":
        raise DeploymentError("the external provider custody signature is invalid")
    try:
        attestation = json.loads(paths["attestation"].read_text(encoding="utf-8"))
        if not isinstance(attestation, dict):
            raise TypeError("provider attestation is not an object")
        payload = {
            key: value
            for key, value in attestation.items()
            if key != "payload_sha256"
        }
        observed_at = datetime.fromisoformat(
            attestation["observed_at"].replace("Z", "+00:00")
        )
        expires_at = datetime.fromisoformat(
            attestation["expires_at"].replace("Z", "+00:00")
        )
        mutation_freeze = attestation["mutation_freeze"]
        freeze_active_from = datetime.fromisoformat(
            mutation_freeze["active_from"].replace("Z", "+00:00")
        )
        freeze_active_until = datetime.fromisoformat(
            mutation_freeze["active_until"].replace("Z", "+00:00")
        )
    except (KeyError, TypeError, ValueError, json.JSONDecodeError, OSError) as exc:
        raise DeploymentError("the external provider custody assertion is malformed") from exc
    now = datetime.now(UTC)
    if (
        attestation.get("schema")
        != "fs2-serve.nebius.ai/model-network-boundary-provider-custody/v3"
        or attestation.get("cluster_id") != cluster_id
        or attestation.get("payload_sha256") != _json_sha256(payload)
        or observed_at.tzinfo is None
        or expires_at.tzinfo is None
        or expires_at - observed_at > timedelta(minutes=30)
        or observed_at > now + timedelta(seconds=30)
        or not (observed_at <= now < expires_at)
        or not isinstance(mutation_freeze, dict)
        or not isinstance(mutation_freeze.get("transaction_id"), str)
        or re.fullmatch(
            r"[a-z][a-z0-9]{5,31}:[1-9][0-9]*:[a-f0-9]{32}",
            mutation_freeze["transaction_id"],
        )
        is None
        or mutation_freeze.get("enforcement")
        != "deny-all-protected-kubernetes-mutations"
        or mutation_freeze.get("allowed_principal_ids") != []
        or not isinstance(
            mutation_freeze.get("protected_kubernetes_resources"), list
        )
        or len(mutation_freeze["protected_kubernetes_resources"]) < 5
        or len(mutation_freeze["protected_kubernetes_resources"]) > 128
        or not all(
            isinstance(resource, str) and 0 < len(resource) <= 512
            for resource in mutation_freeze["protected_kubernetes_resources"]
        )
        or len(set(mutation_freeze["protected_kubernetes_resources"]))
        != len(mutation_freeze["protected_kubernetes_resources"])
        or mutation_freeze.get("protected_kubernetes_resource_prefixes")
        != [
            "clusterrolebindings.rbac.authorization.k8s.io/_cluster/",
            "clusterroles.rbac.authorization.k8s.io/_cluster/",
            "rolebindings.rbac.authorization.k8s.io/",
            "roles.rbac.authorization.k8s.io/",
        ]
        or freeze_active_from.tzinfo is None
        or freeze_active_until.tzinfo is None
        or freeze_active_from != observed_at
        or freeze_active_until != expires_at
        or not (freeze_active_from <= now < freeze_active_until)
        or freeze_active_until - now < timedelta(minutes=15)
    ):
        raise DeploymentError(
            "the external provider custody assertion is stale or outside its exact cluster contract"
        )
    credentials = attestation.get("credentials")
    if (
        not isinstance(credentials, dict)
        or set(credentials)
        != {
            "authorizer",
            "transition",
            "maintenance",
            "auditor",
            "custodian",
            "recovery",
        }
        or any(not isinstance(credential, dict) for credential in credentials.values())
    ):
        raise DeploymentError(
            "the provider assertion must enumerate every separately issued credential"
        )
    operation_locks = attestation.get("operation_locks")
    expected_gateway_principals = {
        credential.get("client_certificate_sha256"): {
            "principal_id": credential.get("provider_principal_id"),
            "username": credential.get("username"),
            "groups": credential.get("groups"),
            "status_reader": name == "auditor",
        }
        for name, credential in credentials.items()
        if isinstance(credential, dict)
    }
    if (
        len(expected_gateway_principals) != 6
        or None in expected_gateway_principals
        or not all(
            re.fullmatch(r"[a-f0-9]{64}", str(certificate_sha256))
            for certificate_sha256 in expected_gateway_principals
        )
    ):
        raise DeploymentError(
            "provider custody credentials do not define six gateway certificate principals"
        )
    expected_operation_locks = {
        "leases.coordination.k8s.io/fs2-system/fs2-model-network-transition": {
            "principal_id": credentials["transition"].get("provider_principal_id"),
            "operations": ["PATCH"],
        },
        "leases.coordination.k8s.io/fs2-system/fs2-model-network-maintenance": {
            "principal_id": credentials["maintenance"].get("provider_principal_id"),
            "operations": ["PATCH"],
        },
    }
    if (
        not isinstance(operation_locks, dict)
        or operation_locks.get("enforcement")
        != "provider-gateway-exact-object-resource-version-cas"
        or operation_locks.get("maximum_lease_duration_seconds") != 7200
        or operation_locks.get("delete_allowed") is not False
        or operation_locks.get("create_allowed") is not False
        or operation_locks.get("locks") != expected_operation_locks
    ):
        raise DeploymentError(
            "provider custody must expose the exact non-deletable operation-lock channel"
        )
    gateway = attestation.get("provider_gateway")
    if not isinstance(gateway, dict):
        raise DeploymentError("provider custody has no concrete preventive gateway")
    status_url = gateway.get("status_url")
    parsed_status_url = urlsplit(status_url if isinstance(status_url, str) else "")
    if (
        parsed_status_url.scheme != "https"
        or not parsed_status_url.hostname
        or parsed_status_url.path != "/v1/custody/status"
        or parsed_status_url.query
        or parsed_status_url.fragment
        or gateway.get("direct_control_plane_access")
        != "provider-firewall-gateway-host-routes-only"
        or not isinstance(gateway.get("provider_resource_ids"), dict)
        or set(gateway["provider_resource_ids"])
        != {"gateway", "gateway_firewall", "cluster_endpoint_access"}
        or any(
            not isinstance(resource_id, str) or not resource_id
            for resource_id in gateway["provider_resource_ids"].values()
        )
        or not isinstance(gateway.get("cluster_resource_version"), int)
        or isinstance(gateway.get("cluster_resource_version"), bool)
        or gateway["cluster_resource_version"] < 0
        or not isinstance(gateway.get("gateway_egress_host_cidrs"), list)
        or not 2 <= len(gateway["gateway_egress_host_cidrs"]) <= 8
        or len(set(gateway["gateway_egress_host_cidrs"]))
        != len(gateway["gateway_egress_host_cidrs"])
        or gateway["gateway_egress_host_cidrs"]
        != sorted(gateway["gateway_egress_host_cidrs"])
        or not all(_is_exact_host_route(cidr) for cidr in gateway["gateway_egress_host_cidrs"])
        or not re.fullmatch(r"[a-f0-9]{64}", str(gateway.get("policy_sha256", "")))
    ):
        raise DeploymentError("provider custody gateway identity is incomplete")
    gateway_paths = {
        "CA": Path(os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_GATEWAY_CA", "")),
        "client certificate": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_GATEWAY_CLIENT_CERT", "")
        ),
        "client key": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_GATEWAY_CLIENT_KEY", "")
        ),
    }
    for label, path in gateway_paths.items():
        if (
            not path.is_absolute()
            or path.is_symlink()
            or not path.is_file()
            or path.stat().st_mode & 0o077
        ):
            raise DeploymentError(
                f"the provider custody gateway {label} must be an absolute mode-0600 regular file"
            )
    challenge = secrets.token_hex(32)
    request_body = json.dumps(
        {"challenge": challenge, "cluster_id": cluster_id},
        sort_keys=True,
        separators=(",", ":"),
    ).encode()
    ssl_context = ssl.create_default_context(cafile=str(gateway_paths["CA"]))
    ssl_context.load_cert_chain(
        str(gateway_paths["client certificate"]),
        str(gateway_paths["client key"]),
    )
    try:
        with urlopen(
            Request(
                status_url,
                data=request_body,
                method="POST",
                headers={"Content-Type": "application/json"},
            ),
            context=ssl_context,
            timeout=5,
        ) as response:
            if response.status != 200 or response.headers.get_content_type() != "application/json":
                raise DeploymentError("provider custody gateway status failed closed")
            live_status = json.loads(response.read(262_145))
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        raise DeploymentError("provider custody gateway status is unavailable") from exc
    expected_live_status = {
        "schema": "fs2-serve.nebius.ai/model-network-provider-gateway-status/v1",
        "challenge": challenge,
        "cluster_id": cluster_id,
        "policy_id": attestation.get("policy_id"),
        "policy_revision": attestation.get("policy_revision"),
        "policy_sha256": gateway.get("policy_sha256"),
        "provider_resource_ids": gateway.get("provider_resource_ids"),
        "cluster_resource_version": gateway.get("cluster_resource_version"),
        "control_plane_allowed_cidrs": gateway.get("gateway_egress_host_cidrs"),
        "direct_control_plane_access": "provider-firewall-gateway-host-routes-only",
        "principal_bindings": dict(sorted(expected_gateway_principals.items())),
        "mutation_freeze": mutation_freeze,
        "operation_locks": operation_locks,
    }
    if live_status != expected_live_status:
        raise DeploymentError(
            "live provider custody gateway state differs from the signed full-inventory freeze"
        )
    return attestation, _sha256_file(paths["attestation"]), freeze_active_until


def _decode_kubeconfig_data(value: Any, label: str) -> bytes:
    if not isinstance(value, str) or not value:
        raise DeploymentError(f"the kubeconfig has no embedded {label}")
    try:
        decoded = base64.b64decode(value, validate=True)
    except (ValueError, binascii.Error) as exc:
        raise DeploymentError(f"the kubeconfig {label} is not strict base64") from exc
    if not decoded:
        raise DeploymentError(f"the kubeconfig {label} is empty")
    return decoded


def _provider_bound_kubeconfig_identity(
    *, kubectl: str, kubeconfig: Path, context: str
) -> dict[str, str]:
    """Reconstruct certificate and provider principal facts from kubeconfig bytes."""

    viewed = subprocess.run(
        [
            kubectl,
            "--kubeconfig",
            str(kubeconfig),
            "--context",
            context,
            "config",
            "view",
            "--raw",
            "--minify",
            "--output",
            "json",
        ],
        env=clean_environment(),
        text=True,
        capture_output=True,
        check=False,
    )
    try:
        document = json.loads(viewed.stdout)
        users = document["users"]
        clusters = document["clusters"]
        user = users[0]["user"]
        cluster = clusters[0]["cluster"]
    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as exc:
        raise DeploymentError("the provider kubeconfig projection is malformed") from exc
    forbidden_user_fields = {
        "token",
        "tokenFile",
        "exec",
        "auth-provider",
        "username",
        "password",
        "as",
        "as-groups",
        "as-user-extra",
    }
    if (
        viewed.returncode != 0
        or not isinstance(user, dict)
        or not isinstance(cluster, dict)
        or forbidden_user_fields.intersection(user)
        or set(user) != {"client-certificate-data", "client-key-data"}
        or "certificate-authority-data" not in cluster
        or cluster.get("insecure-skip-tls-verify") is True
    ):
        raise DeploymentError(
            "the network-boundary kubeconfig must be embedded X.509 only, without impersonation or executable credentials"
        )
    certificate = _decode_kubeconfig_data(
        user.get("client-certificate-data"), "client certificate"
    )
    _decode_kubeconfig_data(user.get("client-key-data"), "client key")
    issuer_ca = _decode_kubeconfig_data(
        cluster.get("certificate-authority-data"), "issuer CA"
    )
    inspected = subprocess.run(
        [
            os.environ.get("FS2_OPENSSL", "openssl"),
            "x509",
            "-noout",
            "-ext",
            "subjectAltName",
        ],
        env=clean_environment(),
        input=certificate,
        capture_output=True,
        check=False,
    )
    normalized_certificate = subprocess.run(
        [os.environ.get("FS2_OPENSSL", "openssl"), "x509", "-outform", "DER"],
        env=clean_environment(),
        input=certificate,
        capture_output=True,
        check=False,
    )
    try:
        output = inspected.stdout.decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        raise DeploymentError("the client certificate SAN output is malformed") from exc
    principals = sorted(set(re.findall(r"URI:(spiffe://[^,\s]+)", output)))
    if (
        inspected.returncode != 0
        or normalized_certificate.returncode != 0
        or not normalized_certificate.stdout
        or len(principals) != 1
    ):
        raise DeploymentError(
            "the client certificate must carry exactly one provider-issued SPIFFE principal"
        )
    return {
        "provider_principal_id": principals[0],
        "client_certificate_sha256": hashlib.sha256(
            normalized_certificate.stdout
        ).hexdigest(),
        "issuer_ca_sha256": hashlib.sha256(issuer_ca).hexdigest(),
        "server": str(cluster.get("server", "")),
    }


def _authority_ready_endpoints(
    *,
    kubectl: str,
    auditor: Path,
    context: str,
    serving_certificate_sha256: str,
) -> dict[str, Any]:
    """Capture one live Service endpoint/readiness projection.

    This deliberately reads Endpoints, Pods and every Pod's HTTPS readiness
    response as one fail-closed projection. Callers take the projection twice
    and require exact equality, alongside the two protected-object/RBAC reads.
    """

    endpoints_result = subprocess.run(
        [
            kubectl,
            "--kubeconfig",
            str(auditor),
            "--context",
            context,
            "--namespace",
            "fs2-network-security",
            "get",
            "endpoints",
            "fs2-model-network-boundary",
            "--output",
            "json",
        ],
        env=clean_environment(),
        text=True,
        capture_output=True,
        check=False,
    )
    pods_result = subprocess.run(
        [
            kubectl,
            "--kubeconfig",
            str(auditor),
            "--context",
            context,
            "--namespace",
            "fs2-network-security",
            "get",
            "pods",
            "--selector",
            "app.kubernetes.io/name=fs2-model-network-boundary,app.kubernetes.io/instance=fs2-model-network-boundary,app.kubernetes.io/component=admission",
            "--output",
            "json",
        ],
        env=clean_environment(),
        text=True,
        capture_output=True,
        check=False,
    )
    try:
        endpoints_document = json.loads(endpoints_result.stdout)
        endpoint_metadata = endpoints_document["metadata"]
        pod_items = json.loads(pods_result.stdout)["items"]
        addresses = [
            address
            for subset in endpoints_document.get("subsets", [])
            for address in subset.get("addresses", [])
        ]
    except (KeyError, TypeError, json.JSONDecodeError) as exc:
        raise DeploymentError("the boundary Service endpoint census is malformed") from exc
    if endpoints_result.returncode != 0 or pods_result.returncode != 0:
        raise DeploymentError("the boundary Service endpoint census is unavailable")
    pods_by_uid = {
        pod.get("metadata", {}).get("uid"): pod
        for pod in pod_items
        if isinstance(pod, dict)
    }
    ready_endpoints: list[dict[str, str]] = []
    for address in addresses:
        if not isinstance(address, dict):
            raise DeploymentError("a boundary endpoint address is malformed")
        target = address.get("targetRef", {})
        if not isinstance(target, dict):
            raise DeploymentError("a boundary endpoint targetRef is malformed")
        pod = pods_by_uid.get(target.get("uid"))
        if target.get("kind") != "Pod" or not isinstance(pod, dict):
            raise DeploymentError(
                "a boundary endpoint does not target one inventoried Pod"
            )
        pod_metadata = pod.get("metadata", {})
        pod_spec = pod.get("spec", {})
        pod_status = pod.get("status", {})
        if (
            target.get("name") != pod_metadata.get("name")
            or address.get("ip") != pod_status.get("podIP")
            or not isinstance(pod_spec.get("nodeName"), str)
            or not pod_spec["nodeName"]
        ):
            raise DeploymentError("a boundary endpoint has no stable Pod/node identity")
        readiness = subprocess.run(
            [
                kubectl,
                "--kubeconfig",
                str(auditor),
                "--context",
                context,
                "get",
                "--raw",
                (
                    "/api/v1/namespaces/fs2-network-security/pods/"
                    f"https:{pod_metadata['name']}:8443/proxy/readyz"
                ),
            ],
            env=clean_environment(),
            text=True,
            capture_output=True,
            check=False,
        )
        try:
            readiness_body = json.loads(readiness.stdout)
        except (TypeError, json.JSONDecodeError) as exc:
            raise DeploymentError(
                f"boundary Pod {pod_metadata.get('name')} readiness is malformed"
            ) from exc
        if (
            readiness.returncode != 0
            or readiness_body.get("status") != "ok"
            or readiness_body.get("serving_certificate_sha256")
            != serving_certificate_sha256
        ):
            raise DeploymentError(
                f"boundary Pod {pod_metadata.get('name')} is not API/TLS ready"
            )
        ready_endpoints.append(
            {
                "pod_name": str(pod_metadata.get("name", "")),
                "pod_uid": str(pod_metadata.get("uid", "")),
                "pod_resource_version": str(
                    pod_metadata.get("resourceVersion", "")
                ),
                "node_name": str(pod_spec.get("nodeName", "")),
                "ip": str(address.get("ip", "")),
            }
        )
    ready_endpoints.sort(key=lambda item: item["pod_name"])
    return {
        "uid": str(endpoint_metadata.get("uid", "")),
        "resource_version": str(endpoint_metadata.get("resourceVersion", "")),
        "object_sha256": _json_sha256(
            _semantic_kubernetes_object(endpoints_document)
        ),
        "ready_endpoints": ready_endpoints,
    }


def model_network_boundary_authority_custody(
    *,
    kubectl: str,
    context: str,
    cluster_id: str,
    credential: Path,
    credential_kind: str,
    expected_username: str,
    expected_receipt_phase: str,
    observed_identity: Mapping[str, Any],
    trust_root_sha256: str,
    provider_trust_root_sha256: str,
) -> dict[str, Any]:
    """Verify the externally signed authority receipt and every bound live object."""

    (
        provider_attestation,
        provider_attestation_sha256,
        freeze_active_until,
    ) = _verified_provider_custody(
        cluster_id=cluster_id,
        provider_trust_root_sha256=provider_trust_root_sha256,
    )
    reconstructed_identity = _provider_bound_kubeconfig_identity(
        kubectl=kubectl,
        kubeconfig=credential,
        context=context,
    )

    paths = {
        "receipt": Path(os.environ.get("FS2_NETWORK_BOUNDARY_AUTHORITY_RECEIPT", "")),
        "signature": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_AUTHORITY_SIGNATURE", "")
        ),
        "trust root": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_AUTHORITY_TRUST_ROOT", "")
        ),
    }
    for label, path in paths.items():
        if not path.is_absolute() or path.is_symlink() or not path.is_file():
            raise DeploymentError(
                f"the model-network authority {label} must be an absolute regular file"
            )
    if not re.fullmatch(r"[a-f0-9]{64}", trust_root_sha256):
        raise DeploymentError(
            "the root deployment contract must pin the authority trust-root SHA-256"
        )
    if _sha256_file(paths["trust root"]) != trust_root_sha256:
        raise DeploymentError(
            "the authority signing key differs from the root-pinned digest"
        )
    verified = subprocess.run(
        [
            os.environ.get("FS2_OPENSSL", "openssl"),
            "dgst",
            "-sha256",
            "-verify",
            str(paths["trust root"]),
            "-signature",
            str(paths["signature"]),
            str(paths["receipt"]),
        ],
        env=clean_environment(),
        text=True,
        capture_output=True,
        check=False,
    )
    if verified.returncode != 0 or verified.stdout.strip() != "Verified OK":
        raise DeploymentError(
            "the model-network authority custody signature is invalid"
        )
    try:
        receipt = json.loads(paths["receipt"].read_text(encoding="utf-8"))
        if not isinstance(receipt, dict):
            raise TypeError("receipt is not an object")
        payload = {
            key: value for key, value in receipt.items() if key != "payload_sha256"
        }
        credentials = receipt["custody"]["credentials"]
        credential_claim = credentials[credential_kind]
        issued_at = datetime.fromisoformat(receipt["issued_at"].replace("Z", "+00:00"))
        expires_at = datetime.fromisoformat(
            receipt["expires_at"].replace("Z", "+00:00")
        )
    except (KeyError, TypeError, ValueError, json.JSONDecodeError, OSError) as exc:
        raise DeploymentError(
            "the signed model-network authority receipt is malformed"
        ) from exc
    now = datetime.now(UTC)
    if (
        receipt.get("schema")
        != "fs2-serve.nebius.ai/model-network-boundary-authority/v3"
        or receipt.get("phase") != expected_receipt_phase
        or receipt.get("cluster_id") != cluster_id
        or receipt.get("authority_namespace") != "fs2-network-security"
        or receipt.get("payload_sha256") != _json_sha256(payload)
        or receipt["custody"].get("trust_root_sha256") != trust_root_sha256
        or issued_at.tzinfo is None
        or expires_at.tzinfo is None
        or expires_at - issued_at > timedelta(minutes=15)
        or issued_at > now + timedelta(seconds=60)
        or not (issued_at <= now < expires_at)
    ):
        raise DeploymentError(
            "the signed model-network authority receipt is expired or outside its exact custody contract"
        )
    if (
        credential_claim.get("username") != expected_username
        or credential_claim.get("groups") != observed_identity.get("groups")
        or credential_claim.get("extras") != observed_identity.get("extras")
        or credential_claim.get("authentication_mode") != "x509-client-certificate"
        or credential_claim.get("provider_principal_id")
        != reconstructed_identity["provider_principal_id"]
        or credential_claim.get("kubeconfig_sha256") != _sha256_file(credential)
        or credential_claim.get("client_certificate_sha256")
        != reconstructed_identity["client_certificate_sha256"]
        or credential_claim.get("issuer_ca_sha256")
        != reconstructed_identity["issuer_ca_sha256"]
        or credential_claim.get("gateway_server") != reconstructed_identity["server"]
        or credential_claim.get("gateway_server")
        != provider_attestation.get("provider_gateway", {}).get("api_server_url")
    ):
        raise DeploymentError(
            "the model-network credential is not the exact provider-issued X.509 identity in the signed custody receipt"
        )

    expected_credentials = {
        "authorizer": ("fs2-model-network-authorizer", ["fs2:model-network-authorizer", "system:authenticated"]),
        "transition": ("fs2-model-network-transition", ["fs2:model-network-transition", "system:authenticated"]),
        "maintenance": ("fs2-model-network-maintenance", ["fs2:model-network-maintenance", "system:authenticated"]),
        "auditor": ("fs2-model-network-auditor", ["fs2:model-network-auditor", "system:authenticated"]),
        "custodian": ("fs2-model-network-custodian", ["fs2:model-network-custodian", "system:authenticated"]),
        "recovery": ("fs2-model-network-recovery", ["fs2:model-network-recovery", "system:authenticated"]),
    }
    if set(credentials) != set(expected_credentials):
        raise DeploymentError("the signed custody receipt does not enumerate every exact credential")
    provider_principals: set[str] = set()
    for name, (username, groups) in expected_credentials.items():
        claim = credentials.get(name)
        provider_credential = provider_attestation["credentials"].get(name)
        if (
            not isinstance(claim, dict)
            or not isinstance(provider_credential, dict)
            or claim.get("username") != username
            or claim.get("groups") != groups
            or claim.get("extras") != {}
            or claim.get("authentication_mode") != "x509-client-certificate"
            or not isinstance(claim.get("provider_principal_id"), str)
            or not claim["provider_principal_id"]
            or not re.fullmatch(r"[a-f0-9]{64}", str(claim.get("kubeconfig_sha256", "")))
            or not re.fullmatch(r"[a-f0-9]{64}", str(claim.get("client_certificate_sha256", "")))
            or not re.fullmatch(r"[a-f0-9]{64}", str(claim.get("issuer_ca_sha256", "")))
            or any(
                claim.get(field) != provider_credential.get(field)
                for field in (
                    "username",
                    "groups",
                    "provider_principal_id",
                    "client_certificate_sha256",
                    "issuer_ca_sha256",
                    "gateway_server",
                )
            )
        ):
            raise DeploymentError(f"the signed {name} custody identity is incomplete")
        provider_principals.add(claim["provider_principal_id"])
    if len(provider_principals) != len(expected_credentials):
        raise DeploymentError("model-network custody credentials must use distinct provider principals")
    provider = receipt["custody"].get("provider", {})
    external_custody = receipt.get("external_custody", {})
    if (
        not isinstance(provider, dict)
        or not isinstance(external_custody, dict)
        or credentials["custodian"]["provider_principal_id"]
        != provider.get("custodian_principal_id")
        or credentials["recovery"]["provider_principal_id"]
        != provider.get("recovery_principal_id")
        or external_custody.get("schema") != provider_attestation.get("schema")
        or external_custody.get("policy_id") != provider_attestation.get("policy_id")
        or external_custody.get("policy_revision")
        != provider_attestation.get("policy_revision")
        or external_custody.get("provider_trust_root_sha256")
        != provider_trust_root_sha256
        or external_custody.get("attestation_sha256")
        != provider_attestation_sha256
        or external_custody.get("gateway_policy_sha256")
        != provider_attestation.get("provider_gateway", {}).get("policy_sha256")
        or external_custody.get("cluster_resource_version")
        != provider_attestation.get("provider_gateway", {}).get(
            "cluster_resource_version"
        )
        or external_custody.get("gateway_egress_host_cidrs")
        != provider_attestation.get("provider_gateway", {}).get(
            "gateway_egress_host_cidrs"
        )
        or external_custody.get("freeze_transaction_id")
        != provider_attestation.get("mutation_freeze", {}).get("transaction_id")
        or external_custody.get("freeze_expires_at")
        != provider_attestation.get("mutation_freeze", {}).get("active_until")
        or external_custody.get("frozen_resources_sha256")
        != _json_sha256(
            {
                "resources": sorted(
                    provider_attestation.get("mutation_freeze", {}).get(
                        "protected_kubernetes_resources", []
                    )
                ),
                "resource_prefixes": provider_attestation.get(
                    "mutation_freeze", {}
                ).get("protected_kubernetes_resource_prefixes", []),
            }
        )
        or sorted(provider_attestation.get("exclusive_break_glass_principals", []))
        != sorted(
            [
                credentials["custodian"]["provider_principal_id"],
                credentials["recovery"]["provider_principal_id"],
            ]
        )
    ):
        raise DeploymentError(
            "the authority receipt is not bound to the independent provider/IAM custody assertion"
        )

    auditor_raw = os.environ.get("FS2_NETWORK_AUDITOR_KUBECONFIG", "")
    auditor = Path(auditor_raw)
    auditor_claim = credentials.get("auditor")
    if (
        not auditor.is_absolute()
        or auditor.is_symlink()
        or not auditor.is_file()
        or auditor.resolve() == credential.resolve()
        or auditor.stat().st_mode & 0o077
        or not isinstance(auditor_claim, dict)
        or auditor_claim.get("username") != "fs2-model-network-auditor"
        or auditor_claim.get("authentication_mode") != "x509-client-certificate"
        or auditor_claim.get("kubeconfig_sha256") != _sha256_file(auditor)
    ):
        raise DeploymentError(
