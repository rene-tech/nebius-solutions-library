def validate_scientific_artifact_public_metadata(value: Any) -> None:
    """Keep status/scoped-handoff metadata free of storage credentials."""

    if value is None:
        return
    if not isinstance(value, Mapping):
        raise DeploymentError("the scientific artifact status output is malformed")
    forbidden = {"secret_access_key", "secret_key", "credentials"}
    if forbidden.intersection(value):
        raise DeploymentError(
            "the scientific artifact bundle must never carry object-storage secret material"
        )


