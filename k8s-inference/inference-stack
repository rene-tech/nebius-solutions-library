def kubernetes_secret_values(
    kubectl: str,
    *,
    kubeconfig: Path,
    context: str,
    namespace: str,
    name: str,
    keys: Sequence[str],
    expected_binding: Mapping[str, Any],
) -> dict[str, str]:
    """Read named UTF-8 Secret keys into memory without echoing their values."""

    if not all(
        isinstance(value, str) and value.strip()
        for value in (context, namespace, name, *keys)
    ):
        raise DeploymentError("the workloads credential Secret reference is malformed")
    if kubeconfig.is_symlink() or not kubeconfig.is_file():
        raise DeploymentError("the authority-attested delivery kubeconfig is absent or unsafe")
    result = run(
        [
            kubectl,
            "--kubeconfig",
            str(kubeconfig),
            "--context",
            context,
            "-n",
            namespace,
            "get",
            "secret",
            name,
            "-o",
            "json",
        ],
        env=clean_environment(),
        capture=True,
    )
    try:
        document = json.loads(result.stdout)
        encoded = document["data"]
        metadata = document["metadata"]
        if not isinstance(encoded, dict):
            raise TypeError
        decoded = {
            key: base64.b64decode(value, validate=True)
            for key, value in encoded.items()
            if isinstance(key, str) and isinstance(value, str)
        }
        content_sha256 = canonical_sha256(
            {
                key: hashlib.sha256(value).hexdigest()
                for key, value in decoded.items()
            }
        )
        if (
            len(decoded) != len(encoded)
            or not isinstance(metadata, dict)
            or metadata.get("namespace") != expected_binding.get("namespace")
            or metadata.get("name") != expected_binding.get("name")
            or metadata.get("uid") != expected_binding.get("uid")
            or metadata.get("resourceVersion")
            != expected_binding.get("resource_version")
            or content_sha256 != expected_binding.get("content_sha256")
        ):
            raise DeploymentError(
                "the scoped credential Secret changed after provider attestation"
            )
        values = {
            key: decoded[key].decode("utf-8")
            for key in keys
        }
    except (
        KeyError,
        TypeError,
        UnicodeDecodeError,
        binascii.Error,
        json.JSONDecodeError,
    ) as error:
        raise DeploymentError(
            f"Kubernetes Secret {namespace}/{name} is missing a required UTF-8 value"
        ) from error
    if any(not value for value in values.values()):
        raise DeploymentError(
            f"Kubernetes Secret {namespace}/{name} contains an empty required value"
        )
    return values


def scoped_credential_handoff(
    terraform: str,
    kubectl: str,
    run_root: Path,
    contract: Mapping[str, Any],
    *,
    kind: str,
    expires_in_seconds: int,
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Resolve exactly one requested credential and a value-free audit receipt."""

    if kind not in {"general-access", "scientific-access"}:
        raise DeploymentError("unsupported credential kind")
    if (
        ACTIVE_CREDENTIAL_DELIVERY_IDENTITY is None
        or ACTIVE_CREDENTIAL_DELIVERY_IDENTITY.get("credential_kind") != kind
    ):
        raise DeploymentError(
            "scoped output requires an authority-attested exact-Secret delivery identity"
        )
    if not 300 <= expires_in_seconds <= 86400:
        raise DeploymentError("credential handoff expiry must be 300-86400 seconds")
    environment = stage_environment(
        run_root, "workloads", contract, include_secrets=False
    )
    access = terraform_json_output(
        terraform, WORKLOADS_ROOT, "access_bundle", environment
    )
    if (
        not isinstance(access, dict)
        or access.get("schema") != "fs2-serve.nebius.ai/access-bundle-contract/v2"
        or not isinstance(access.get("credential_secret_refs"), dict)
        or not isinstance(access.get("cluster"), dict)
        or not isinstance(access.get("endpoints"), dict)
    ):
        raise DeploymentError("the workloads access contract is missing or malformed")
    refs = access["credential_secret_refs"]
    context = access["cluster"].get("kube_context")
    mappings = {
        "general-access": ("mcp_inference", ("key",)),
        "scientific-access": ("scientific", ("key",)),
    }
    reference_name, key_fields = mappings[kind]
    reference = refs.get(reference_name)
    if not isinstance(reference, dict):
        raise DeploymentError(f"the requested {kind} credential is not configured")
    keys = tuple(reference.get(field) for field in key_fields)
    delivery_binding = ACTIVE_CREDENTIAL_DELIVERY_IDENTITY.get("secret_binding")
    if (
        not isinstance(delivery_binding, dict)
        or reference.get("namespace") != delivery_binding.get("namespace")
        or reference.get("name") != delivery_binding.get("name")
        or keys != (ACTIVE_CREDENTIAL_DELIVERY_IDENTITY.get("secret_key"),)
        or context != ACTIVE_CREDENTIAL_DELIVERY_IDENTITY.get("context_name")
    ):
        raise DeploymentError(
            "workload output differs from the provider-attested scoped Secret binding"
        )
    values = kubernetes_secret_values(
        kubectl,
        kubeconfig=Path(ACTIVE_CREDENTIAL_DELIVERY_IDENTITY["kubeconfig"]),
        context=context,
        namespace=reference.get("namespace"),
        name=reference.get("name"),
        keys=keys,
        expected_binding=ACTIVE_CREDENTIAL_DELIVERY_IDENTITY["secret_binding"],
    )
    issued_at = datetime.now(UTC).replace(microsecond=0)
    policy_name = "mcp_access" if kind == "general-access" else "scientific_access"
    policy = access.get(policy_name)
    enforced_expiry = policy.get("expires_at") if isinstance(policy, Mapping) else None
    if not isinstance(enforced_expiry, str):
        raise DeploymentError(
            f"the requested {kind} PAT has no server-enforced expiry and cannot be exported"
        )
    try:
        parsed_expiry = datetime.fromisoformat(enforced_expiry.replace("Z", "+00:00"))
    except ValueError as error:
        raise DeploymentError(
            f"the requested {kind} PAT has a malformed server-enforced expiry"
        ) from error
    if parsed_expiry.tzinfo is None:
        raise DeploymentError(
            f"the requested {kind} PAT expiry must include a timezone"
        )
    expires_at = parsed_expiry.astimezone(UTC).replace(microsecond=0)
    if expires_at <= issued_at:
        raise DeploymentError(f"the requested {kind} PAT is expired")
    if expires_at > issued_at + timedelta(seconds=expires_in_seconds):
        raise DeploymentError(
            f"the requested {kind} PAT outlives the requested handoff TTL; rotate it with a bounded server-enforced expiry first"
        )
    credential = {"token": values[keys[0]]}
    handoff = {
        "schema": "fs2-serve.nebius.ai/scoped-credential-handoff/v1",
        "kind": kind,
        "issued_at": issued_at.isoformat().replace("+00:00", "Z"),
        "expires_at": expires_at.isoformat().replace("+00:00", "Z"),
        "endpoints": {
            key: value
            for key, value in access["endpoints"].items()
            if value is not None and key in {"mcp_url", "inference_base_url"}
        },
        "credential": credential,
    }
    receipt_id = str(uuid4())
    receipt = {
        "schema": "fs2-serve.nebius.ai/scoped-credential-receipt/v1",
        "receipt_id": receipt_id,
        "kind": kind,
        "issued_at": handoff["issued_at"],
        "expires_at": handoff["expires_at"],
        "source": {
            "namespace": reference["namespace"],
            "name": reference["name"],
            "keys": list(keys),
        },
    }
    return handoff, receipt


def state_ready(
    terraform: str,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
) -> bool:
    environment = stage_environment(run_root, stage, contract, include_secrets=False)
    terraform_init(terraform, stage_root(stage), environment)
    result = subprocess.run(
        [
            terraform,
            f"-chdir={stage_root(stage)}",
            "output",
            "-json",
            STAGE_COMPLETION_OUTPUTS[stage],
        ],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return False
    try:
        return json.loads(result.stdout) is not None
    except json.JSONDecodeError:
        return False


def state_has_resources(
    terraform: str,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
) -> bool:
    environment = stage_environment(run_root, stage, contract, include_secrets=False)
    terraform_init(terraform, stage_root(stage), environment)
    return bool(state_addresses(terraform, stage_root(stage), environment))


def apply_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
    configuration_environment: Mapping[str, str],
) -> None:
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="infrastructure",
        contract=contract,
        variable_file=infrastructure_variables,
    )
    apply_plan(args.terraform, INFRA_ROOT, plan_path, environment)

    dynamic = infrastructure_outputs(
        args.terraform,
        run_root,
        contract,
        nebius=args.nebius,
        nebius_config=args.nebius_config,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
    )
    mirror_selected_images(args, run_root, contract, dynamic)
    foundation_variables, workloads_variables = write_downstream_variables(
        args.terraform, run_root, contract, dynamic
    )

    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="foundation",
        contract=contract,
        variable_file=foundation_variables,
    )
    apply_plan(args.terraform, FOUNDATION_ROOT, plan_path, environment)

    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="workloads",
        contract=contract,
        variable_file=workloads_variables,
    )
    apply_plan(args.terraform, WORKLOADS_ROOT, plan_path, environment)

    # Record the accepted root contract after all of its staged consumers converge.
    apply_plan(
        args.terraform,
        DEPLOY_ROOT,
        run_root / "configuration.tfplan",
        configuration_environment,
    )

    endpoints = workload_endpoint_outputs(args.terraform, run_root, contract)
    print(json.dumps({"status": "applied", **endpoints}, indent=2))


def plan_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    if not state_ready(args.terraform, run_root, "infrastructure", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="infrastructure",
            contract=contract,
            variable_file=infrastructure_variables,
        )
        print(
            "Planned infrastructure. Apply it before foundation can be planned against the new API server."
        )
        return

    _, infrastructure_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="infrastructure",
        contract=contract,
        variable_file=infrastructure_variables,
    )
    if plan_changes_managed_resources_or_outputs(infrastructure_plan):
        print(
            "Planned infrastructure changes. Apply infrastructure and rerun plan before planning foundation."
        )
        return

    dynamic = infrastructure_outputs(
        args.terraform,
        run_root,
        contract,
        nebius=args.nebius,
        nebius_config=args.nebius_config,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
    )
    if "artifact_delivery" not in dynamic["accelerator_pool_contract"]:
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="infrastructure",
            contract=contract,
            variable_file=infrastructure_variables,
        )
        print(
            "Planned the registry-delivery contract upgrade. Apply infrastructure before planning downstream stages."
        )
        return
    foundation_variables, workloads_variables = write_downstream_variables(
        args.terraform, run_root, contract, dynamic
    )
    if not state_ready(args.terraform, run_root, "foundation", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="foundation",
            contract=contract,
            variable_file=foundation_variables,
        )
        print("Planned foundation. Apply it before custom resources can be planned.")
        return

    _, foundation_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="foundation",
        contract=contract,
        variable_file=foundation_variables,
    )
    if plan_changes_managed_resources_or_outputs(foundation_plan):
        print(
            "Planned foundation changes. Apply foundation and rerun plan before planning workloads."
        )
        return

    if not state_ready(args.terraform, run_root, "workloads", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="workloads",
            contract=contract,
            variable_file=workloads_variables,
        )
        print("Planned workloads.")
        return

    plan_stage(
        args.terraform,
        run_root=run_root,
        stage="workloads",
        contract=contract,
        variable_file=workloads_variables,
    )
    print("Planned all three existing states after upstream handoffs converged.")


def destroy_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    reference_infrastructure = (
        contract.get("stages", {}).get("infrastructure", {}).get("reference_data", {})
    )
    scientific_infrastructure = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("scientific_artifacts", {})
    )
    reference_retained = (
        isinstance(reference_infrastructure, Mapping)
        and reference_infrastructure.get("enabled") is True
        and reference_infrastructure.get("lifecycle", {}).get("retention_mode")
        == "retain"
    )
    scientific_retained = (
        isinstance(scientific_infrastructure, Mapping)
        and scientific_infrastructure.get("enabled") is True
        and scientific_infrastructure.get("lifecycle", {}).get("retention_mode")
        == "retain"
    )
    retained_mode = reference_retained or scientific_retained
    resources = {
        stage: state_has_resources(args.terraform, run_root, stage, contract)
        for stage in ("infrastructure", "foundation", "workloads")
    }
    retain_infrastructure = retained_mode and resources["infrastructure"]
    infrastructure_variables = (
        None
        if retain_infrastructure
        else write_infrastructure_variables(
            run_root, contract, commit, args.nebius_profile
        )
    )
    cached_foundation = run_root / "foundation.tfvars.json"
    cached_workloads = run_root / "workloads.tfvars.json"
    downstream: tuple[Path, Path] | None = None
    dynamic: dict[str, Any] | None = None
    if retain_infrastructure:
        if not state_ready(args.terraform, run_root, "infrastructure", contract):
            raise DeploymentError(
                "retained reference infrastructure exists but its completion output "
                "is unavailable; no resource was changed"
            )
        dynamic = infrastructure_outputs(
            args.terraform,
            run_root,
            contract,
            nebius=args.nebius,
            nebius_config=args.nebius_config,
            nebius_profile=args.nebius_profile,
            kubectl=args.kubectl,
        )
        if reference_retained and not isinstance(
            dynamic.get("reference_data_storage_contract"), Mapping
        ):
            raise DeploymentError(
                "retained reference infrastructure is missing its non-secret storage "
                "contract; no resource was changed"
            )
        if reference_retained and not isinstance(
            dynamic.get("reference_data_lifecycle"), Mapping
        ):
            raise DeploymentError(
                "retained reference infrastructure is missing its lifecycle output; "
                "no resource was changed"
            )
        if scientific_retained and not isinstance(
            dynamic.get("scientific_artifacts_storage_contract"), Mapping
        ):
            raise DeploymentError(
                "retained scientific artifact storage is missing its non-secret bucket "
                "contract; no resource was changed"
            )
        if scientific_retained and not isinstance(
            dynamic.get("scientific_artifacts_lifecycle"), Mapping
        ):
            raise DeploymentError(
                "retained scientific artifact storage is missing its lifecycle output; "
                "no resource was changed"
            )
    if resources["foundation"] or resources["workloads"]:
        if (
            cached_foundation.is_file()
            and not cached_foundation.is_symlink()
            and cached_workloads.is_file()
            and not cached_workloads.is_symlink()
        ):
            downstream = (cached_foundation, cached_workloads)
        elif state_ready(args.terraform, run_root, "infrastructure", contract):
            if dynamic is None:
                dynamic = infrastructure_outputs(
                    args.terraform,
                    run_root,
                    contract,
                    nebius=args.nebius,
                    nebius_config=args.nebius_config,
                    nebius_profile=args.nebius_profile,
                    kubectl=args.kubectl,
                )
            downstream = write_downstream_variables(
                args.terraform, run_root, contract, dynamic
            )
        else:
            raise DeploymentError(
                "downstream resources exist but their private generated tfvars and a complete infrastructure handoff are both unavailable"
            )

    retained_workload_outputs: dict[str, Any] = {
        "reference_data": None,
        "reference_data_contract": None,
        "scientific_artifacts": None,
        "scientific_artifacts_contract": None,
    }
    if (
        retain_infrastructure
        and resources["workloads"]
        and state_ready(args.terraform, run_root, "workloads", contract)
    ):
        retained_workload_outputs = workload_endpoint_outputs(
            args.terraform, run_root, contract
        )

    destroy_order: tuple[tuple[str, Path | None], ...] = (
        ("workloads", downstream[1] if downstream else None),
        ("foundation", downstream[0] if downstream else None),
    )
    if not retain_infrastructure:
        destroy_order += (("infrastructure", infrastructure_variables),)

    destroyed_stages: list[str] = []
    for stage, variable_file in destroy_order:
        if not resources[stage]:
            continue
        if variable_file is None:
            raise DeploymentError(
                f"cannot destroy {stage}: its generated private variable file is unavailable"
            )
        plan_path, _, environment = plan_stage(
            args.terraform,
            run_root=run_root,
            stage=stage,
            contract=contract,
            variable_file=variable_file,
            destroy=True,
        )
        apply_plan(args.terraform, stage_root(stage), plan_path, environment)
        destroyed_stages.append(stage)

    if retain_infrastructure:
        assert dynamic is not None
        storage = dynamic.get("reference_data_storage_contract")
        lifecycle = dynamic.get("reference_data_lifecycle")
        applied_status = retained_workload_outputs.get("reference_data")
        applied_contract = retained_workload_outputs.get("reference_data_contract")
        last_applied_status_service = (
            applied_status.get("status_service")
            if isinstance(applied_status, Mapping)
            else None
        )
        last_applied_pipeline = (
            applied_status.get("pipeline")
            if isinstance(applied_status, Mapping)
            else None
        )
        last_applied_plane = (
            applied_contract.get("plane")
            if isinstance(applied_contract, Mapping)
            else None
        )
        reference_data = (
            None
            if not reference_retained
            else {
                "lifecycle": lifecycle,
                "filesystem_id": storage.get("filesystem", {}).get("id"),
                "bucket_id": storage.get("object_storage", {}).get("id"),
                "bucket_name": storage.get("object_storage", {}).get("name"),
                "cpu_pool_id": storage.get("cpu_pool", {}).get("id"),
                "status_service": None,
                "pipeline": None,
                "last_applied": {
                    "status_service": last_applied_status_service,
                    "pipeline": last_applied_pipeline,
                },
            }
        )
        reference_data_contract = (
            None
            if not reference_retained
            else {
                "storage": storage,
                "plane": None,
                "last_applied_plane": last_applied_plane,
            }
        )
        scientific_storage = dynamic.get("scientific_artifacts_storage_contract")
        scientific_lifecycle = dynamic.get("scientific_artifacts_lifecycle")
        scientific_artifacts = (
            None
            if not scientific_retained
            else {
                "lifecycle": scientific_lifecycle,
                "bucket_id": (scientific_storage or {})
                .get("object_storage", {})
                .get("id"),
                "bucket_name": (scientific_storage or {})
                .get("object_storage", {})
                .get("name"),
                "object_key": (scientific_storage or {})
                .get("layout", {})
                .get("object_key"),
                "last_applied": retained_workload_outputs.get("scientific_artifacts"),
            }
        )
        scientific_artifacts_contract = (
            None
            if not scientific_retained
            else {
                "storage": scientific_storage,
            }
        )
        adoption_lifecycle = lifecycle if reference_retained else scientific_lifecycle
        receipt_path = run_root / (
            "reference-data-retention.json"
            if reference_retained
            else "scientific-artifacts-retention.json"
        )
        result = {
            "schema": "fs2-serve.nebius.ai/destroy-result/v1",
            "status": "infrastructure-retained",
            "completion": "full-stack-destroy-incomplete-infrastructure-retained",
            "destroyed_stages": destroyed_stages,
            "retained_stages": ["infrastructure"],
            "reference_data": reference_data,
            "reference_data_contract": reference_data_contract,
            "scientific_artifacts": scientific_artifacts,
            "scientific_artifacts_contract": scientific_artifacts_contract,
            "adoption": {
                "required_before_full_destroy": True,
                "status": (adoption_lifecycle or {}).get("adoption_status"),
                "receipt_path": str(receipt_path),
                "next_step": (
                    "adopt or migrate every retained filesystem and bucket into a "
                    "separate durable Terraform state before destroying infrastructure"
                ),
            },
        }
        private_json(receipt_path, result)
        print(json.dumps(result, indent=2))
        return

    print(
        json.dumps(
            {
                "schema": "fs2-serve.nebius.ai/destroy-result/v1",
                "status": "destroyed",
                "completion": "complete",
                "destroyed_stages": destroyed_stages,
                "retained_stages": [],
                "reference_data": None,
                "reference_data_contract": None,
                "scientific_artifacts": None,
                "scientific_artifacts_contract": None,
                "evidence_root": str(run_root),
            },
            indent=2,
        )
    )


def status_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    stages: dict[str, Any] = {}
    workloads_ready = False
    infrastructure_reference_data: Any | None = None
    infrastructure_reference_data_contract: Any | None = None
    infrastructure_scientific_artifacts: Any | None = None
    for stage in ("infrastructure", "foundation", "workloads"):
        environment = stage_environment(
            run_root, stage, contract, include_secrets=False
        )
        terraform_init(args.terraform, stage_root(stage), environment)
        addresses = state_addresses(args.terraform, stage_root(stage), environment)
        complete = state_ready(args.terraform, run_root, stage, contract)
        stages[stage] = {
            "state": "ready" if complete else ("partial" if addresses else "empty"),
            "addresses": len(addresses),
            "complete": complete,
        }
        if stage == "workloads":
            workloads_ready = complete
        if (
            stage == "infrastructure"
            and complete
            and contract.get("stages", {})
            .get("infrastructure", {})
            .get("reference_data", {})
            .get("enabled")
            is True
        ):
            storage = terraform_optional_json_output(
                args.terraform,
                INFRA_ROOT,
                "reference_data_storage_contract",
                environment,
            )
            if isinstance(storage, Mapping):
                lifecycle = terraform_optional_json_output(
                    args.terraform,
                    INFRA_ROOT,
                    "reference_data_lifecycle",
                    environment,
                )
                infrastructure_reference_data = {
                    "lifecycle": (
                        lifecycle
                        if isinstance(lifecycle, Mapping)
                        else storage.get("lifecycle")
                    ),
                    "filesystem_id": storage.get("filesystem", {}).get("id"),
                    "bucket_id": storage.get("object_storage", {}).get("id"),
                    "bucket_name": storage.get("object_storage", {}).get("name"),
                    "cpu_pool_id": storage.get("cpu_pool", {}).get("id"),
                    "status_service": None,
                    "pipeline": None,
                }
                infrastructure_reference_data_contract = {
                    "storage": storage,
                    "plane": None,
                }
        if (
            stage == "infrastructure"
            and complete
            and contract.get("stages", {})
            .get("infrastructure", {})
            .get("scientific_artifacts", {})
            .get("enabled")
            is True
        ):
            artifact_storage = terraform_optional_json_output(
                args.terraform,
                INFRA_ROOT,
                "scientific_artifacts_storage_contract",
                environment,
            )
            if isinstance(artifact_storage, Mapping):
                artifact_lifecycle = terraform_optional_json_output(
                    args.terraform,
                    INFRA_ROOT,
                    "scientific_artifacts_lifecycle",
                    environment,
                )
                infrastructure_scientific_artifacts = {
                    "lifecycle": (
                        artifact_lifecycle
                        if isinstance(artifact_lifecycle, Mapping)
                        else artifact_storage.get("lifecycle")
                    ),
                    "bucket_id": artifact_storage.get("object_storage", {}).get("id"),
                    "bucket_name": artifact_storage.get("object_storage", {}).get(
                        "name"
                    ),
                    "endpoint": artifact_storage.get("object_storage", {}).get(
                        "endpoint"
                    ),
                    "region": artifact_storage.get("region"),
                    "object_key": artifact_storage.get("layout", {}).get("object_key"),
                    "writer_role": artifact_storage.get("writer", {}).get("role"),
                    "writer_paths": artifact_storage.get("writer", {}).get("paths"),
                    "secret_delivery": artifact_storage.get("writer", {}).get(
                        "secret_delivery"
                    ),
                    "retention": artifact_storage.get("retention"),
                    "credential_secret": "fs2-system/fs2-serve-artifact-store",
                }
    endpoints = (
        workload_endpoint_outputs(args.terraform, run_root, contract)
        if workloads_ready
        else {
            "mcp_endpoint_url": None,
            "admin_web_interface_url": None,
            "inference_base_url": None,
            "grafana_url": None,
            "alertmanager_url": None,
            "tempo_explore_url": None,
            "reference_data": None,
            "reference_data_contract": None,
            "scientific_artifacts": None,
            "scientific_artifacts_contract": None,
        }
    )
    # A previously applied workloads state can remain otherwise complete while the
    # newly enabled reference-data module is intentionally held behind its own
    # review gate. Keep the normal status surface truthful in that transition:
    # report the live infrastructure identities and retained lifecycle until the
    # workload-owned status service and pipeline replace this fallback.
    if (
        endpoints["reference_data"] is None
        and infrastructure_reference_data is not None
    ):
        endpoints["reference_data"] = infrastructure_reference_data
    if (
        endpoints["reference_data_contract"] is None
        and infrastructure_reference_data_contract is not None
    ):
        endpoints["reference_data_contract"] = infrastructure_reference_data_contract
    # The store can be provisioned and correct while the batch workloads that
    # consume it are still gated off. Report the live bucket identity rather
    # than pretending the feature is absent.
    if (
        endpoints.get("scientific_artifacts") is None
        and infrastructure_scientific_artifacts is not None
    ):
        endpoints["scientific_artifacts"] = infrastructure_scientific_artifacts
    print(
        json.dumps(
            {"run_root": str(run_root), "stages": stages, **endpoints},
            indent=2,
        )
    )


def output_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    """Write one explicitly requested scoped credential to an owner-only file."""
    if not state_ready(args.terraform, run_root, "workloads", contract):
        raise DeploymentError(
            "workloads are not applied; run inference-stack apply before requesting endpoints"
        )
    requested_path = getattr(args, "credential_file", None)
    if requested_path is None:
        raise DeploymentError(
            "output requires --credential-file in an existing owner-only directory"
        )
    kind = getattr(args, "credential_kind", None)
    if kind is None:
        raise DeploymentError("output requires one explicit --credential-kind")
    candidate = requested_path.expanduser().absolute()
    if candidate.is_symlink():
        raise DeploymentError("credential-file must not be a symlink")
    parent = candidate.parent
    if any(path.is_symlink() for path in (parent, *parent.parents)):
        raise DeploymentError("credential-file parent must be a real directory")
    if not parent.is_dir():
        raise DeploymentError("credential-file parent must be a real directory")
    parent_status = parent.stat()
    if (
        parent_status.st_uid != os.geteuid()
        or stat.S_IMODE(parent_status.st_mode) & 0o077
    ):
        raise DeploymentError(
            "credential-file parent must be owner-owned and owner-only"
        )
    destination = parent / candidate.name
    receipt_path = destination.with_name(destination.name + ".receipt.json")
    if destination.exists() or receipt_path.exists():
        raise DeploymentError("credential handoff and receipt destinations must be new")
    handoff, receipt = scoped_credential_handoff(
        args.terraform,
        args.kubectl,
        run_root,
        contract,
        kind=kind,
        expires_in_seconds=args.credential_expires_in_seconds,
    )
    private_json(destination, handoff)
    private_json(receipt_path, receipt)
    print(
        json.dumps(
            {
                "status": "scoped-credential-file-written",
                "kind": kind,
                "receipt_id": receipt["receipt_id"],
                "credential_file": str(destination),
                "receipt_file": str(receipt_path),
                "expires_at": receipt["expires_at"],
                "mode": "0600",
            },
            indent=2,
        )
    )


def internal_proxy_command(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> list[str]:
    """Build the non-secret command that serves an internal-only edge."""
    if ACTIVE_OPERATOR_IDENTITY is None:
        raise DeploymentError("proxy requires the provider-attested operator viewer context")
    if not state_ready(args.terraform, run_root, "workloads", contract):
        raise DeploymentError(
            "workloads are not applied; run inference-stack apply before starting the proxy"
        )

    infrastructure_environment = stage_environment(
        run_root, "infrastructure", contract, include_secrets=False
    )
    terraform_init(
        args.terraform,
        INFRA_ROOT,
        infrastructure_environment,
    )
    cluster_id = terraform_json_output(
        args.terraform, INFRA_ROOT, "cluster_id", infrastructure_environment
    )
    cluster_name = terraform_json_output(
        args.terraform, INFRA_ROOT, "cluster_name", infrastructure_environment
    )
    public_edge = terraform_json_output(
        args.terraform,
        INFRA_ROOT,
        "public_edge_contract",
        infrastructure_environment,
    )
    provider_identity = ACTIVE_OPERATOR_IDENTITY["operator_proxy_identity"]
    if (
        provider_identity.get("cluster_id") != cluster_id
        or ACTIVE_OPERATOR_IDENTITY.get("context_name") != cluster_name
        or set(provider_identity.get("allowed_permissions", []))
        != {
            "pods:get:fs2-system",
            "pods:list:fs2-system",
            "pods/portforward:create:fs2-system",
            "services:get:fs2-system",
        }
        or provider_identity.get("namespace") != "fs2-system"
        or provider_identity.get("rbac_binding", {}).get("namespace")
        != "fs2-system"
        or provider_identity.get("rbac_binding", {}).get("service_account_uid")
        != provider_identity.get("uid")
        or provider_identity.get("rbac_binding", {}).get(
            "service_account_resource_version"
        )
        != provider_identity.get("service_account_resource_version")
        or provider_identity.get("rbac_binding", {}).get("role_ref_kind") != "Role"
        or "secrets:get" not in provider_identity.get("denied_permissions", [])
    ):
        raise DeploymentError(
            "operator port-forward identity or exact RBAC scope differs from this cluster"
        )
    kubeconfig = Path(ACTIVE_OPERATOR_IDENTITY["kubeconfig"])

    if not isinstance(public_edge, dict) or public_edge.get("mode") != "internal-only":
        raise DeploymentError(
            "this deployment has a public edge and does not require an operator proxy"
        )
    port_forward = public_edge.get("port_forward")
    if not isinstance(port_forward, dict) or port_forward.get("enabled") is not True:
        raise DeploymentError("the Terraform port-forward contract is malformed")
    expected = {
        "bind_address": "127.0.0.1",
        "control_plane_service": "fs2-serve-control-plane",
        "control_plane_port": 8080,
        "admin_console_service": "fs2-serve-control-plane-admin-console",
        "admin_console_port": 8080,
    }
    if any(port_forward.get(key) != value for key, value in expected.items()):
        raise DeploymentError("the Terraform port-forward contract is unsupported")
    try:
        local_ports = [
            int(port_forward["control_plane_local_port"]),
            int(port_forward["admin_console_local_port"]),
            int(port_forward["operator_proxy_port"]),
        ]
    except (KeyError, TypeError, ValueError) as exc:
        raise DeploymentError(
            "the Terraform port-forward contract is malformed"
        ) from exc
    application_origin = f"http://localhost:{local_ports[2]}"
    operator_endpoint = f"http://127.0.0.1:{local_ports[2]}"
    if (
        port_forward.get("application_origin") != application_origin
        or port_forward.get("operator_endpoint") != operator_endpoint
    ):
        raise DeploymentError("the Terraform loopback origins do not match its ports")
    endpoints = workload_endpoint_outputs(args.terraform, run_root, contract)
    expected_endpoints = {
        "mcp_endpoint_url": f"{application_origin}/mcp",
        "admin_web_interface_url": f"{application_origin}/admin/",
    }
    if any(endpoints.get(key) != value for key, value in expected_endpoints.items()):
        raise DeploymentError(
            "the workload endpoint outputs do not match the edge contract"
        )

    return [
        sys.executable,
        str(INTERNAL_EDGE_PROXY),
        "--kubeconfig",
        str(kubeconfig),
        "--context",
        cluster_name,
        "--kubectl",
        args.kubectl,
        "--control-plane-local-port",
        str(local_ports[0]),
        "--admin-console-local-port",
        str(local_ports[1]),
        "--operator-proxy-port",
        str(local_ports[2]),
        "--mcp-endpoint-url",
        endpoints["mcp_endpoint_url"],
        "--admin-web-interface-url",
        endpoints["admin_web_interface_url"],
    ]


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Plan, apply, inspect, or destroy Kubernetes inference from one terraform.tfvars file."
    )
    parser.add_argument(
        "command",
        choices=(
            "validate",
            "preflight",
            "plan",
            "apply",
            "destroy",
            "status",
            "output",
            "proxy",
        ),
    )
    parser.add_argument(
        "--var-file",
        type=Path,
        default=DEPLOY_ROOT / "terraform.tfvars",
        help="customer terraform.tfvars file (default: k8s-inference/terraform.tfvars)",
    )
    parser.add_argument(
        "--run-root",
        type=Path,
        help="private state/evidence directory; defaults to an XDG state path bound to the tfvars path",
    )
    parser.set_defaults(**FIXED_EXECUTABLES)
    parser.add_argument(
        "--credential-file",
        type=Path,
        help="owner-only destination required by the output command; secret values are never printed",
    )
    parser.add_argument(
        "--credential-kind",
        choices=("general-access", "scientific-access"),
        help="single scoped credential kind to export; no aggregate export exists",
    )
    parser.add_argument(
        "--credential-expires-in-seconds",
        type=int,
        default=3600,
        help="receipt and delivery-file expiry, from 300 through 86400 seconds",
    )
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    global ACTIVE_BACKEND_IDENTITY
    global ACTIVE_CREDENTIAL_DELIVERY_IDENTITY
    global ACTIVE_OPERATOR_IDENTITY, ACTIVE_RELEASE_IDENTITY
    os.umask(0o077)
    args = parse_args(argv)
    if "NEBIUS_PROFILE" in os.environ or "NEBIUS_CONFIG" in os.environ:
        raise DeploymentError(
            "caller-controlled Nebius profile/configuration is forbidden; use the provider-attested release identity"
        )
    if any(key.startswith(("AWS_", "S3_")) for key in os.environ):
        raise DeploymentError(
            "caller-controlled AWS/S3 backend credentials are forbidden; use the provider-attested purpose identity"
        )
    if args.command == "destroy":
        raise DeploymentError(
            "destroy is disabled while the program-wide no-delete constraint is active"
        )
    if args.command in {"preflight", "plan", "apply"}:
        ACTIVE_RELEASE_IDENTITY = release_identity(args.command)
        ACTIVE_BACKEND_IDENTITY = attested_backend_identity(
            ACTIVE_RELEASE_IDENTITY, "release-automation"
        )
        args.terraform = ACTIVE_RELEASE_IDENTITY["executables"]["terraform"]
        args.kubectl = ACTIVE_RELEASE_IDENTITY["executables"]["kubectl"]
        args.nebius = ACTIVE_RELEASE_IDENTITY["executables"]["nebius"]
        args.crane = ACTIVE_RELEASE_IDENTITY["executables"]["crane"]
        args.nebius_profile = ACTIVE_RELEASE_IDENTITY["profile"]
        args.nebius_config = ACTIVE_RELEASE_IDENTITY["config_path"]
    elif args.command == "proxy":
        ACTIVE_OPERATOR_IDENTITY = operator_proxy_identity()
        ACTIVE_BACKEND_IDENTITY = attested_backend_identity(
            ACTIVE_OPERATOR_IDENTITY, "operator-proxy"
        )
        args.terraform = ACTIVE_OPERATOR_IDENTITY["executables"]["terraform"]
        args.kubectl = ACTIVE_OPERATOR_IDENTITY["executables"]["kubectl"]
        args.nebius = ACTIVE_OPERATOR_IDENTITY["executables"]["nebius"]
        args.crane = ACTIVE_OPERATOR_IDENTITY["executables"]["crane"]
        args.nebius_profile = None
        args.nebius_config = None
    elif args.command == "output":
        if args.credential_kind is None:
            raise DeploymentError("output requires one explicit --credential-kind")
        ACTIVE_CREDENTIAL_DELIVERY_IDENTITY = credential_delivery_identity(
            args.credential_kind
        )
        delivery_purpose = (
            "credential-delivery-general"
            if args.credential_kind == "general-access"
            else "credential-delivery-scientific"
        )
        ACTIVE_BACKEND_IDENTITY = attested_backend_identity(
            ACTIVE_CREDENTIAL_DELIVERY_IDENTITY, delivery_purpose
        )
        args.terraform = ACTIVE_CREDENTIAL_DELIVERY_IDENTITY["executables"]["terraform"]
        args.kubectl = ACTIVE_CREDENTIAL_DELIVERY_IDENTITY["executables"]["kubectl"]
        args.nebius = ACTIVE_CREDENTIAL_DELIVERY_IDENTITY["executables"]["nebius"]
        args.crane = ACTIVE_CREDENTIAL_DELIVERY_IDENTITY["executables"]["crane"]
        args.nebius_profile = None
        args.nebius_config = None
    else:
        ACTIVE_OPERATOR_IDENTITY = operator_read_identity()
        ACTIVE_BACKEND_IDENTITY = attested_backend_identity(
            ACTIVE_OPERATOR_IDENTITY, "operator-read"
        )
        args.terraform = ACTIVE_OPERATOR_IDENTITY["executables"]["terraform"]
        args.kubectl = ACTIVE_OPERATOR_IDENTITY["executables"]["kubectl"]
        args.nebius = ACTIVE_OPERATOR_IDENTITY["executables"]["nebius"]
        args.crane = ACTIVE_OPERATOR_IDENTITY["executables"]["crane"]
        args.nebius_profile = None
        args.nebius_config = None
    os.environ["FS2_KUBECTL_EXECUTABLE"] = args.kubectl
    require_terraform_version(args.terraform)
    variable_file = args.var_file.expanduser().resolve()
    if not variable_file.is_file():
        raise DeploymentError(
            f"configuration does not exist: {variable_file}; copy terraform.tfvars.example first"
        )
    run_root = (
        (args.run_root or default_run_root(variable_file)).expanduser().absolute()
    )
    private_directory(run_root)
    secure_run_root(run_root)

    lock_path = run_root / ".inference-stack.lock"
    if lock_path.is_symlink():
        raise DeploymentError(f"lock path must not be a symlink: {lock_path}")
    try:
        with lock_path.open("a+", encoding="utf-8") as lock:
            lock_path.chmod(0o600)
            try:
                fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as exc:
                raise DeploymentError(
                    f"another inference-stack process owns {run_root}"
                ) from exc

            contract, configuration_environment = validate_configuration(
                args.terraform, variable_file, run_root
            )
            if ACTIVE_RELEASE_IDENTITY is not None and (
                ACTIVE_RELEASE_IDENTITY["project_id"]
                != contract["target"]["project_id"]
            ):
                raise DeploymentError(
                    "release identity project differs from the deployment target"
                )
            proxy_arguments: list[str] | None = None
            commit = source_commit()
            if args.command == "validate":
                validate_stage_roots(args.terraform, run_root)
                print(
                    json.dumps(
                        {
                            "status": "valid",
                            "run_root": str(run_root),
                            "deployment": contract["name"],
                            "profiles": contract["profiles"],
                            "accelerator_pools": contract[
                                "selected_accelerator_pool_ids"
                            ],
                            "models": contract["selected_model_ids"],
                        },
                        indent=2,
                    )
                )
            elif args.command == "preflight":
                preflight_accelerators(args, contract)
            elif args.command == "plan":
                plan_stack(args, run_root, contract, commit)
            elif args.command == "apply":
                require_deployable_images(contract)
                apply_stack(
                    args,
                    run_root,
                    contract,
                    commit,
                    configuration_environment,
                )
            elif args.command == "destroy":
                destroy_stack(args, run_root, contract, commit)
            elif args.command == "output":
                output_stack(args, run_root, contract)
            elif args.command == "proxy":
                proxy_arguments = internal_proxy_command(args, run_root, contract)
            else:
                status_stack(args, run_root, contract)
    finally:
        secure_run_root(run_root)
    if proxy_arguments is not None:
        try:
            run(proxy_arguments, env=clean_environment())
        except KeyboardInterrupt:
            pass
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except DeploymentError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(2)
