    )


def authoritative_state_json(
    terraform: str,
    root: Path,
    environment: Mapping[str, str],
) -> str:
    """Pull the configured backend state without persisting another copy."""

    result = run(
        [terraform, f"-chdir={root}", "state", "pull"],
        env=environment,
        capture=True,
    )
    try:
        document = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise DeploymentError(
            "Terraform did not return an authoritative backend state document"
        ) from error
    if not isinstance(document, dict):
        raise DeploymentError("Terraform backend state is not a JSON object")
    return result.stdout


def normalized_remote_state(document: Mapping[str, Any]) -> dict[str, Any]:
    """Convert `state pull` JSON into the value shape used by the guard."""

    resources: list[dict[str, Any]] = []
    raw_resources = document.get("resources")
    if not isinstance(raw_resources, list):
        raise DeploymentError("Terraform remote state has no resource inventory")
    for resource in raw_resources:
        if not isinstance(resource, Mapping):
            raise DeploymentError("Terraform remote state resource is malformed")
        module = resource.get("module")
        prefix = f"{module}." if isinstance(module, str) and module else ""
        base = f"{prefix}{resource.get('type')}.{resource.get('name')}"
        instances = resource.get("instances")
        if not isinstance(instances, list):
            raise DeploymentError("Terraform remote state instance list is malformed")
        for instance in instances:
            if not isinstance(instance, Mapping) or not isinstance(
                instance.get("attributes"), Mapping
            ):
                raise DeploymentError("Terraform remote state instance is malformed")
            index = instance.get("index_key")
            suffix = (
                ""
                if index is None
                else f"[{json.dumps(index, separators=(',', ':'))}]"
            )
            resources.append(
                {
                    "address": f"{base}{suffix}",
                    "mode": resource.get("mode", "managed"),
                    "type": resource.get("type"),
                    "name": resource.get("name"),
                    "values": instance["attributes"],
                }
            )
    return {"values": {"root_module": {"resources": resources, "child_modules": []}}}


def prepare_credential_migration_gate(
    terraform: str,
    *,
    run_root: Path,
    root: Path,
    environment: dict[str, str],
) -> Path:
    """Create the short-lived receipt consumed by Terraform's native gate."""

    stage = root.name
    identity_receipt = (
        run_root / "fixed-v1-identity.receipt.json"
        if stage == "workloads"
        else run_root / f"{stage}-durable-identity.receipt.json"
    )
    gate_receipt = (
        run_root / f"{stage}-credential-migration-gate-{uuid4().hex}.receipt.json"
    )
    raw_state = authoritative_state_json(terraform, root, environment)
    raw_state_document = json.loads(raw_state)
    state_document = normalized_remote_state(raw_state_document)
    command = [
        sys.executable,
        str(SECRET_MIGRATION_GUARD),
        "capture-apply-gate",
        "-",
        str(gate_receipt),
        "--terraform-configuration",
        str(root),
        "--terraform-root",
        stage,
        "--source-commit",
        source_commit(),
        "--registry",
        str(DURABLE_CREDENTIAL_REGISTRY),
    ]
    if identity_receipt.exists():
        command.extend(["--identity-receipt", str(identity_receipt)])
    run(
        command,
        input_text=json.dumps(
            {
                "state_document": state_document,
                "raw_state_document": raw_state_document,
            },
            separators=(",", ":"),
        ),
        capture=True,
    )
    environment["TF_VAR_credential_migration_gate_receipt_path"] = str(gate_receipt)
    environment["TF_VAR_credential_migration_gate_source_commit"] = source_commit()
    gate_sha256 = hashlib.sha256(gate_receipt.read_bytes()).hexdigest()
    state_list = run(
        [terraform, f"-chdir={root}", "state", "list"],
        env=environment,
        capture=True,
    ).stdout.splitlines()
    gate_pattern = re.compile(
        r'^terraform_data\.credential_apply_gate_generation\["([0-9a-f]{64})"\]$'
    )
    gate_history = sorted(
        match.group(1)
        for address in state_list
        if (match := gate_pattern.fullmatch(address.strip())) is not None
    )
    environment["TF_VAR_credential_migration_gate_receipt_sha256"] = gate_sha256
    environment["TF_VAR_credential_migration_gate_history"] = json.dumps(
        gate_history, separators=(",", ":")
    )
    environment["FS2_TERRAFORM_PLAN_GATE_RECEIPT"] = str(gate_receipt)
    kubeconfig = run_root / "kubeconfig"
    if kubeconfig.is_file() and not kubeconfig.is_symlink():
        environment["KUBECONFIG"] = str(kubeconfig)
    return gate_receipt


