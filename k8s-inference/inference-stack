class DeploymentError(RuntimeError):
    """A bounded, user-actionable deployment failure."""


def command_text(arguments: Sequence[str]) -> str:
    """Return a readable command containing no secret environment values."""
    return " ".join(arguments)


def run(
    arguments: Sequence[str],
    *,
    env: Mapping[str, str] | None = None,
    capture: bool = False,
    input_text: str | None = None,
) -> subprocess.CompletedProcess[str]:
    print(f"+ {command_text(arguments)}", file=sys.stderr)
    try:
        return subprocess.run(
            list(arguments),
            env=dict(env) if env is not None else None,
            input=input_text,
            text=True,
            check=True,
            stdout=subprocess.PIPE if capture else sys.stderr,
            stderr=subprocess.PIPE if capture else None,
        )
    except FileNotFoundError as exc:
        raise DeploymentError(f"required executable not found: {arguments[0]}") from exc
    except subprocess.CalledProcessError as exc:
        if capture and exc.stderr:
            print(exc.stderr.rstrip(), file=sys.stderr)
        raise DeploymentError(
            f"command failed with exit code {exc.returncode}: {command_text(arguments)}"
        ) from exc


def private_directory(path: Path) -> None:
    if any(parent.is_symlink() for parent in (path, *path.parents)):
        raise DeploymentError(f"run root path must not contain a symlink: {path}")
    if path.exists() and (path.is_symlink() or not path.is_dir()):
        raise DeploymentError(f"run root must be a real directory: {path}")
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)


def secure_run_root(run_root: Path) -> None:
    """Make every run-owned artifact private without following links."""

    if run_root.is_symlink() or not run_root.is_dir():
        raise DeploymentError(f"run root must be a real directory: {run_root}")
    for directory, directory_names, file_names in os.walk(
        run_root, topdown=True, followlinks=False
    ):
        current = Path(directory)
        if current.is_symlink():
            raise DeploymentError(f"run root contains a directory symlink: {current}")
        current.chmod(0o700)
        for name in directory_names:
            path = current / name
            if path.is_symlink():
                raise DeploymentError(f"run root contains a directory symlink: {path}")
            path.chmod(0o700)
        for name in file_names:
            path = current / name
            if path.is_symlink():
                raise DeploymentError(f"run root contains a file symlink: {path}")
            mode = stat.S_IMODE(path.stat().st_mode)
            path.chmod(0o700 if mode & stat.S_IXUSR else 0o600)


def private_json(path: Path, value: Any) -> None:
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    descriptor = os.open(temporary, flags, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def private_text(path: Path, value: str) -> None:
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(value)
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def clean_environment() -> dict[str, str]:
    # Stage inputs are generated explicitly. Inherited TF_VAR values could
    # otherwise make the same customer file produce a different deployment.
    return {
        key: value
        for key, value in os.environ.items()
        if not key.startswith("TF_VAR_")
        and not key.startswith("TF_CLI_ARGS")
        and not key.startswith("AWS_")
        and not key.startswith("S3_")
        and key
        not in {
            "TF_DATA_DIR",
            "TF_WORKSPACE",
            "NEBIUS_PROFILE",
            "NEBIUS_CONFIG",
        }
    }


def authority_observation(operation: str, **parameters: Any) -> dict[str, Any]:
    if CREDENTIAL_PROVIDER_ADAPTER.is_symlink() or not CREDENTIAL_PROVIDER_ADAPTER.is_file():
        raise DeploymentError("credential provider adapter is absent or unsafe")
    response = run(
        [sys.executable, str(CREDENTIAL_PROVIDER_ADAPTER)],
        env=clean_environment(),
        capture=True,
        input_text=json.dumps(
            {"operation": operation, **parameters}, separators=(",", ":")
        ),
    )
    try:
        document = json.loads(response.stdout)
    except json.JSONDecodeError as error:
        raise DeploymentError("credential authority evidence is malformed") from error
    if not isinstance(document, dict):
        raise DeploymentError("credential authority evidence is not an object")
    return document


def attested_file(
    path_value: Any,
    digest_value: Any,
    *,
    label: str,
    private: bool,
    reader_uid: int | None = None,
    reader_gid: int | None = None,
) -> str:
    if not isinstance(path_value, str) or not Path(path_value).is_absolute():
        raise DeploymentError(f"{label} path is not absolute")
    path = Path(path_value)
    if path.is_symlink() or not path.is_file():
        raise DeploymentError(f"{label} is absent or unsafe")
    metadata = path.stat()
    if private:
        if (
            not isinstance(reader_uid, int)
            or reader_uid < 1
            or not isinstance(reader_gid, int)
            or reader_gid < 1
            or os.geteuid() != reader_uid
            or os.getegid() != reader_gid
            or metadata.st_uid != 0
            or metadata.st_gid != reader_gid
            or stat.S_IMODE(metadata.st_mode) != 0o640
        ):
            raise DeploymentError(
                f"{label} is not an exact root-custodied authorized-reader file"
            )
    elif metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) & 0o022:
        raise DeploymentError(f"{label} ownership or mode is unsafe")
    for parent in path.parents:
        parent_metadata = parent.stat()
        if (
            parent.is_symlink()
            or not parent.is_dir()
            or parent_metadata.st_uid != 0
            or stat.S_IMODE(parent_metadata.st_mode) & 0o022
        ):
            raise DeploymentError(f"{label} parent chain is mutable")
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    if not isinstance(digest_value, str) or digest != digest_value:
        raise DeploymentError(f"{label} digest differs from authority evidence")
    return str(path)


def attested_executables(document: Mapping[str, Any]) -> dict[str, str]:
    configured = document.get("provider_executables")
    if not isinstance(configured, dict) or set(configured) != set(FIXED_EXECUTABLES):
        raise DeploymentError("authority executable inventory is incomplete")
    result: dict[str, str] = {}
    for name, expected_path in FIXED_EXECUTABLES.items():
        binding = configured.get(name)
        if (
            not isinstance(binding, dict)
            or set(binding) != {"path", "sha256"}
            or binding.get("path") != expected_path
        ):
            raise DeploymentError(f"authority {name} executable is not source-pinned")
        result[name] = attested_file(
            binding["path"], binding["sha256"], label=f"{name} executable", private=False
        )
    return result


def attested_backend_identity(
    document: Mapping[str, Any], purpose: str
) -> dict[str, Any]:
    identity = document.get("backend_access_identity")
    try:
        issued = datetime.fromisoformat(
            str(identity["issued_at"]).replace("Z", "+00:00")
        ).astimezone(UTC)
        expires = datetime.fromisoformat(
            str(identity["expires_at"]).replace("Z", "+00:00")
        ).astimezone(UTC)
    except (KeyError, TypeError, ValueError) as error:
        raise DeploymentError("backend workload identity evidence is malformed") from error
    now = datetime.now(UTC)
    if (
        not isinstance(identity, dict)
        or identity.get("purpose") != purpose
        or identity.get("audience") != f"terraform-backend:{purpose}"
        or identity.get("credential_kind") != "workload_identity_session"
        or identity.get("credential_source")
        != "provider-workload-identity-exchange"
        or not isinstance(identity.get("credential_identity_sha256"), str)
        or re.fullmatch(
            r"[0-9a-f]{64}", identity["credential_identity_sha256"]
        )
        is None
        or identity.get("shared_credentials_file_used") is not False
        or identity.get("environment_credentials_used") is not False
        or identity.get("instance_metadata_used") is not False
        or identity.get("human_principal_allowed") is not False
        or identity.get("impersonation_allowed") is not False
        or issued > now
        or expires <= now
        or expires - issued > timedelta(hours=1)
        or not isinstance(identity.get("profile"), str)
        or not identity["profile"]
        or not isinstance(identity.get("binding_sha256"), str)
        or len(identity["binding_sha256"]) != 64
    ):
        raise DeploymentError("backend access is not a current purpose-bound session")
    result = dict(identity)
    result["config_path"] = attested_file(
        identity.get("config_path"),
        identity.get("config_sha256"),
        label=f"{purpose} backend workload identity configuration",
        private=True,
        reader_uid=identity.get("reader_uid"),
        reader_gid=identity.get("reader_gid"),
    )
    result["shared_credentials_file_path"] = attested_file(
        identity.get("shared_credentials_file_path"),
        identity.get("shared_credentials_file_sha256"),
        label=f"{purpose} disabled AWS shared-credentials sentinel",
        private=False,
    )
    shared_credentials_file = Path(result["shared_credentials_file_path"])
    if (
        stat.S_IMODE(shared_credentials_file.stat().st_mode) != 0o644
        or shared_credentials_file.stat().st_size != 0
        or identity.get("shared_credentials_file_sha256")
        != "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    ):
        raise DeploymentError(
            "backend shared-credentials sentinel is not exact and empty"
        )
    return result


def release_identity(command: str) -> dict[str, Any]:
    """Obtain the provider-derived, externally anchored release identity.

    No command-line flag or inherited environment can choose a Nebius profile,
    project, credential, or config path.  The root authority observes the exact
    short-lived non-human identity and returns value-free evidence.
    """

    if command not in {"preflight", "plan", "apply"}:
        raise DeploymentError(
            f"{command} is not authorized for the release automation identity"
        )
    document = authority_observation("release-identity")
    if document.get("authorizedCallerPurpose") != "release-automation":
        raise DeploymentError("release identity was not issued to release automation")
    try:
        identity = document["release_identity"]
        issued = datetime.fromisoformat(
            identity["issued_at"].replace("Z", "+00:00")
        ).astimezone(UTC)
        expires = datetime.fromisoformat(
            identity["expires_at"].replace("Z", "+00:00")
        ).astimezone(UTC)
    except (KeyError, TypeError, ValueError) as error:
        raise DeploymentError("release identity evidence is malformed") from error
    now = datetime.now(UTC)
    if (
        identity.get("audience") != "terraform-release"
        or identity.get("credential_kind") != "workload_identity_session"
        or identity.get("interactive_login_allowed") is not False
        or identity.get("human_principal_allowed") is not False
        or identity.get("impersonation_allowed") is not False
        or command not in identity.get("allowed_commands", [])
        or issued > now
        or expires <= now
        or expires - issued > timedelta(hours=1)
        or not isinstance(identity.get("profile"), str)
        or not identity["profile"]
        or not isinstance(identity.get("authorization_closure"), dict)
        or identity["authorization_closure"].get("scope")
        != "organization-and-descendants"
    ):
        raise DeploymentError(
            "release identity is not an active automation-only credential for this command"
        )
    identity["config_path"] = attested_file(
        identity.get("config_path"),
        identity.get("config_sha256"),
        label="release workload identity configuration",
        private=True,
        reader_uid=identity.get("reader_uid"),
        reader_gid=identity.get("reader_gid"),
    )
    identity["executables"] = attested_executables(identity)
    return identity


def operator_read_identity() -> dict[str, Any]:
    """Obtain the expiring viewer used only for read-only status/validation."""

    document = authority_observation("operator-read-context")
    if document.get("authorizedCallerPurpose") != "operator-read":
        raise DeploymentError("operator read context was issued to another purpose")
    identity = document.get("operator_identity")
    denials = document.get("denials")
    if (
        not isinstance(identity, dict)
        or identity.get("role") != "viewer"
        or not isinstance(identity.get("authorization_closure"), dict)
        or identity["authorization_closure"].get("scope")
        != "organization-and-descendants"
        or not isinstance(denials, dict)
        or not denials
        or not all(value is True for value in denials.values())
        or document.get("inventory", {}).get("allowed") is not True
    ):
        raise DeploymentError("operator read identity is not an exact read-only viewer")
    expires = datetime.fromisoformat(str(identity.get("expires_at")).replace("Z", "+00:00"))
    if expires.tzinfo is None or expires.astimezone(UTC) <= datetime.now(UTC):
        raise DeploymentError("operator read viewer credential has expired")
    document["kubeconfig"] = attested_file(
        document.get("kubeconfig"),
        document.get("kubeconfig_sha256"),
        label="operator viewer kubeconfig",
        private=True,
        reader_uid=document.get("reader_uid"),
        reader_gid=document.get("reader_gid"),
    )
    document["executables"] = attested_executables(document)
    return document


def operator_proxy_identity() -> dict[str, Any]:
    """Obtain a distinct short-lived identity limited to loopback port-forward."""

    document = authority_observation("operator-proxy-context")
    if document.get("authorizedCallerPurpose") != "operator-proxy":
        raise DeploymentError("operator proxy context was issued to another purpose")
    identity = document.get("operator_proxy_identity")
    required_allowed = {
        "pods:get:fs2-system",
        "pods:list:fs2-system",
        "pods/portforward:create:fs2-system",
        "services:get:fs2-system",
    }
    required_denied = {
        "impersonate:*",
        "pods:create",
        "pods:delete",
        "pods:exec",
        "secrets:create",
        "secrets:delete",
        "secrets:get",
        "secrets:list",
        "secrets:patch",
        "secrets:update",
        "serviceaccounts/token:create",
        "workloads:create",
        "workloads:delete",
        "workloads:patch",
        "workloads:update",
    }
    try:
        issued = datetime.fromisoformat(
            str(identity["issued_at"]).replace("Z", "+00:00")
        ).astimezone(UTC)
        expires = datetime.fromisoformat(
            str(identity["expires_at"]).replace("Z", "+00:00")
        ).astimezone(UTC)
    except (KeyError, TypeError, ValueError) as error:
        raise DeploymentError("operator proxy identity evidence is malformed") from error
    now = datetime.now(UTC)
    if (
        not isinstance(identity, dict)
        or identity.get("audience") != "operator-proxy"
        or set(identity.get("allowed_permissions", [])) != required_allowed
        or not required_denied <= set(identity.get("denied_permissions", []))
        or issued > now
        or expires <= now
        or expires - issued > timedelta(minutes=15)
        or identity.get("namespace") != "fs2-system"
        or identity.get("rbac_binding", {}).get("namespace") != "fs2-system"
        or identity.get("rbac_binding", {}).get("service_account_uid")
        != identity.get("uid")
        or identity.get("rbac_binding", {}).get("service_account_resource_version")
        != identity.get("service_account_resource_version")
        or identity.get("rbac_binding", {}).get("role_ref_kind") != "Role"
    ):
        raise DeploymentError(
            "operator proxy is not an active port-forward-only projected identity"
        )
    document["kubeconfig"] = attested_file(
        document.get("kubeconfig"),
        document.get("kubeconfig_sha256"),
        label="operator port-forward kubeconfig",
        private=True,
        reader_uid=document.get("reader_uid"),
        reader_gid=document.get("reader_gid"),
    )
    document["executables"] = attested_executables(document)
    return document


def credential_delivery_identity(kind: str) -> dict[str, Any]:
    """Obtain a projected token that can read only one current scoped PAT Secret."""

    document = authority_observation(
        "scoped-credential-context", credential_kind=kind
    )
    expected_purpose = (
        "credential-delivery-general"
        if kind == "general-access"
        else "credential-delivery-scientific"
    )
    if document.get("authorizedCallerPurpose") != expected_purpose:
        raise DeploymentError("scoped credential context was issued to another purpose")
    identity = document.get("credential_delivery_identity")
    binding = document.get("secret_binding")
    if not isinstance(identity, dict) or not isinstance(binding, dict):
        raise DeploymentError("scoped credential delivery evidence is malformed")
    expected_permission = (
        f"secrets:get:{binding.get('namespace')}/{binding.get('name')}"
    )
    try:
        issued = datetime.fromisoformat(
            str(identity["issued_at"]).replace("Z", "+00:00")
        ).astimezone(UTC)
        expires = datetime.fromisoformat(
            str(identity["expires_at"]).replace("Z", "+00:00")
        ).astimezone(UTC)
    except (KeyError, TypeError, ValueError) as error:
        raise DeploymentError("scoped credential delivery lifetime is malformed") from error
    required_denials = {
        "impersonate:*",
        "pods:create",
        "pods/portforward:create",
        "secrets:create",
        "secrets:delete",
        "secrets:get:other",
        "secrets:list",
        "secrets:patch",
        "secrets:update",
        "serviceaccounts/token:create",
        "workloads:create",
        "workloads:delete",
        "workloads:patch",
        "workloads:update",
    }
    now = datetime.now(UTC)
    if (
        document.get("credential_kind") != kind
        or identity.get("audience") != f"scoped-credential-delivery:{kind}"
        or identity.get("allowed_permissions") != [expected_permission]
        or not required_denials <= set(identity.get("denied_permissions", []))
        or document.get("secret_key") != "token"
        or issued > now
        or expires <= now
        or expires - issued > timedelta(minutes=5)
    ):
        raise DeploymentError("scoped credential delivery is not exact and least-privilege")
    document["kubeconfig"] = attested_file(
        document.get("kubeconfig"),
        document.get("kubeconfig_sha256"),
        label=f"{kind} credential delivery kubeconfig",
        private=True,
        reader_uid=document.get("reader_uid"),
        reader_gid=document.get("reader_gid"),
    )
    document["executables"] = attested_executables(document)
    return document


def nebius_identity_arguments(args: argparse.Namespace) -> list[str]:
    return [
        args.nebius,
        "--config",
        args.nebius_config,
        "--profile",
        args.nebius_profile,
