def _audit_local_indeterminate_artifacts(run_root: Path) -> None:
    """Fail closed on legacy/local evidence; it never authorizes continuation."""

    directory = _indeterminate_apply_directory(run_root)
    try:
        directory_metadata = directory.lstat()
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(directory_metadata.st_mode) or directory.is_symlink():
        raise DeploymentError(
            "the local indeterminate evidence location is not a real directory"
        )
    with os.scandir(directory) as entries:
        for entry in entries:
            if re.fullmatch(
                r"[a-f0-9]{32}\.(?:indeterminate|resolved)\.json", entry.name
            ) is None:
                raise DeploymentError(
                    "the local indeterminate evidence directory contains an unknown object"
                )
            metadata = entry.stat(follow_symlinks=False)
            if (
                entry.is_symlink()
                or not stat.S_ISREG(metadata.st_mode)
                or metadata.st_uid != 0
                or metadata.st_nlink != 1
                or metadata.st_mode & 0o222
                or not 1 <= metadata.st_size <= _MAX_CUSTODY_DOCUMENT_BYTES
            ):
                raise DeploymentError(
                    "local indeterminate evidence is not a root-custodied, "
                    f"non-writable regular file: {directory / entry.name}"
                )


def _journal_receipt_payload(
    receipt: Mapping[str, Any], *, label: str
) -> dict[str, Any]:
    if not isinstance(receipt, Mapping):
        raise DeploymentError(f"{label} is not an object")
    payload = {key: value for key, value in receipt.items() if key != "payload_sha256"}
    if receipt.get("payload_sha256") != _json_sha256(payload):
        raise DeploymentError(f"{label} payload digest is invalid")
    return dict(receipt)


def _verify_provider_journal_receipt_signature(
    *,
    receipt: Mapping[str, Any],
    encoded_signature: object,
    trust_root: bytes,
    verifier_sha256: str,
    label: str,
) -> None:
    if not isinstance(encoded_signature, str) or not encoded_signature:
        raise DeploymentError(f"{label} has no provider signature")
    try:
        signature = base64.b64decode(encoded_signature, validate=True)
    except (ValueError, binascii.Error) as exc:
        raise DeploymentError(f"{label} provider signature is malformed") from exc
    if not 1 <= len(signature) <= _MAX_CUSTODY_SIGNATURE_BYTES:
        raise DeploymentError(f"{label} provider signature size is invalid")
    document = json.dumps(
        receipt, sort_keys=True, separators=(",", ":")
    ).encode()
    _verify_detached_signature(
        document=document,
        signature=signature,
        trust_root=trust_root,
        verifier_sha256=verifier_sha256,
        label=label,
    )


def _provider_journal_accumulator_start(
    *,
    project_id: str,
    cluster_id: str,
    journal_resource_version: str,
    view: str,
) -> str:
    """Return the domain-separated empty page-view accumulator."""

    if view not in {"unresolved", "affected"}:
        raise DeploymentError("provider journal accumulator view is invalid")

    return _json_sha256(
        {
            "schema": _PROVIDER_APPLY_JOURNAL_ACCUMULATOR_SCHEMA,
            "project_id": project_id,
            "cluster_id": cluster_id,
            "journal_resource_version": journal_resource_version,
            "view": view,
        }
    )


def _provider_journal_accumulator_add(
    accumulator_sha256: str, record: Mapping[str, Any]
) -> str:
    """Commit the next exact signed journal record to an ordered hash chain."""

    if re.fullmatch(r"[a-f0-9]{64}", accumulator_sha256) is None:
        raise DeploymentError("provider journal accumulator prefix is malformed")
    record_sha256 = _json_sha256({"record": record})
    return hashlib.sha256(
        bytes.fromhex(accumulator_sha256) + bytes.fromhex(record_sha256)
    ).hexdigest()


def _verified_provider_apply_journal(
    observation: Mapping[str, Any],
    *,
    action: str,
    request_document: Mapping[str, Any],
    project_id: str,
    cluster_id: str,
    provider_trust_root_sha256: str,
    signature_verifier_sha256: str,
) -> dict[str, Any]:
    """Validate one bounded, checkpoint-pinned provider journal page."""

    if action not in {"observe", "begin", "resolve"}:
        raise DeploymentError("provider apply-journal action is invalid")
    trust_root, actual_trust_root_sha256 = _stable_root_file_bytes(
        Path(os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_TRUST_ROOT", "")),
        label="provider apply-journal trust root",
        maximum_bytes=_MAX_CUSTODY_DOCUMENT_BYTES,
    )
    if (
        not re.fullmatch(r"[a-f0-9]{64}", provider_trust_root_sha256)
        or actual_trust_root_sha256 != provider_trust_root_sha256
    ):
        raise DeploymentError(
            "the provider apply-journal trust root differs from the root contract"
        )
    expected_keys = {
        "schema",
        "action",
        "observed_at",
        "provider_request_id",
        "provider_response_sha256",
        "project_id",
        "cluster_id",
        "journal_resource_version",
        "view",
        "page",
        "checkpoint",
        "checkpoint_sha256",
        "checkpoint_signature",
        "records",
        "observation_sha256",
    }
    try:
        observed_at = datetime.fromisoformat(
            str(observation["observed_at"]).replace("Z", "+00:00")
        )
        journal_revision = int(str(observation["journal_resource_version"]))
    except (KeyError, TypeError, ValueError) as exc:
        raise DeploymentError("provider apply-journal observation is malformed") from exc
    records = observation.get("records")
    page = observation.get("page")
    checkpoint_value = observation.get("checkpoint")
    checkpoint = _journal_receipt_payload(
        checkpoint_value if isinstance(checkpoint_value, Mapping) else {},
        label="provider apply-journal checkpoint",
    )
    checkpoint_payload = {
        key: value for key, value in checkpoint.items() if key != "payload_sha256"
    }
    try:
        checkpoint_created_at = datetime.fromisoformat(
            str(checkpoint["created_at"]).replace("Z", "+00:00")
        )
        checkpoint_sequence = int(str(checkpoint["checkpoint_sequence"]))
        history_event_count = int(str(checkpoint["history_event_count"]))
        unresolved_record_count = int(str(checkpoint["unresolved_record_count"]))
    except (KeyError, TypeError, ValueError) as exc:
        raise DeploymentError(
            "provider apply-journal checkpoint is malformed"
        ) from exc
    expected_checkpoint_keys = {
        "schema",
        "project_id",
        "cluster_id",
        "journal_resource_version",
        "checkpoint_sequence",
        "previous_checkpoint_sha256",
        "history_event_count",
        "history_accumulator_algorithm",
        "history_accumulator_sha256",
        "unresolved_record_count",
        "unresolved_accumulator_algorithm",
        "unresolved_accumulator_sha256",
        "append_only_history",
        "deletion_supported",
        "created_at",
        "payload_sha256",
    }
    previous_checkpoint_sha256 = checkpoint.get("previous_checkpoint_sha256")
    checkpoint_sha256 = _json_sha256(checkpoint)
    semantic = {
        key: value for key, value in observation.items() if key != "observation_sha256"
    }
    now = datetime.now(UTC)
    if (
        set(observation) != expected_keys
        or observation.get("schema") != _PROVIDER_APPLY_JOURNAL_SCHEMA
        or observation.get("action") != action
        or observation.get("project_id") != project_id
        or observation.get("cluster_id") != cluster_id
        or observation.get("view")
        != ("unresolved" if action == "observe" else "affected")
        or observed_at.tzinfo is None
        or observed_at > now + timedelta(seconds=30)
        or now - observed_at > timedelta(minutes=2)
        or not isinstance(observation.get("provider_request_id"), str)
        or not 1 <= len(observation["provider_request_id"]) <= 253
        or re.fullmatch(
            r"[a-f0-9]{64}", str(observation.get("provider_response_sha256", ""))
        )
        is None
        or not isinstance(observation.get("journal_resource_version"), str)
        or re.fullmatch(
            r"(?:0|[1-9][0-9]*)", observation["journal_resource_version"]
        )
        is None
        or journal_revision < 0
        or not isinstance(records, list)
        or len(records) > _PROVIDER_APPLY_JOURNAL_PAGE_SIZE
        or not isinstance(page, Mapping)
        or set(checkpoint) != expected_checkpoint_keys
        or checkpoint.get("schema")
        != _PROVIDER_APPLY_JOURNAL_CHECKPOINT_SCHEMA
        or checkpoint.get("project_id") != project_id
        or checkpoint.get("cluster_id") != cluster_id
        or any(
            not isinstance(checkpoint.get(field), str)
            or re.fullmatch(
                r"(?:0|[1-9][0-9]*)", str(checkpoint.get(field, ""))
            )
            is None
            for field in {
                "journal_resource_version",
                "checkpoint_sequence",
                "history_event_count",
                "unresolved_record_count",
            }
        )
        or checkpoint.get("journal_resource_version")
        != observation.get("journal_resource_version")
        or checkpoint_sequence != journal_revision
        or history_event_count != journal_revision
        or unresolved_record_count < 0
        or unresolved_record_count > history_event_count
        or checkpoint.get("history_accumulator_algorithm")
        != "sha256-append-event-chain-v1"
        or checkpoint.get("unresolved_accumulator_algorithm")
        != "sha256-sorted-signed-record-chain-v1"
        or any(
            re.fullmatch(r"[a-f0-9]{64}", str(checkpoint.get(field, "")))
            is None
            for field in {
                "history_accumulator_sha256",
                "unresolved_accumulator_sha256",
            }
        )
        or (
            journal_revision == 0
            and previous_checkpoint_sha256 is not None
        )
        or (
            journal_revision > 0
            and re.fullmatch(
                r"[a-f0-9]{64}", str(previous_checkpoint_sha256 or "")
            )
            is None
        )
        or checkpoint.get("append_only_history") is not True
        or checkpoint.get("deletion_supported") is not False
        or checkpoint_created_at.tzinfo is None
        or checkpoint_created_at > observed_at
        or checkpoint.get("payload_sha256") != _json_sha256(checkpoint_payload)
        or observation.get("checkpoint_sha256") != checkpoint_sha256
        or observation.get("observation_sha256") != _json_sha256(semantic)
    ):
        raise DeploymentError(
            "provider apply-journal page or checkpoint is stale, incomplete, or malformed"
        )
    _verify_provider_journal_receipt_signature(
        receipt=checkpoint,
        encoded_signature=observation.get("checkpoint_signature"),
        trust_root=trust_root,
        verifier_sha256=signature_verifier_sha256,
        label="provider apply-journal checkpoint",
    )
    expected_checkpoint_sha256 = request_document.get(
        "expected_checkpoint_sha256"
    )
    if (
        (action == "observe" and expected_checkpoint_sha256 is not None)
        and expected_checkpoint_sha256 != checkpoint_sha256
    ):
        raise DeploymentError(
            "provider apply-journal checkpoint changed during the bounded read"
        )
    if action in {"begin", "resolve"} and (
        re.fullmatch(r"[a-f0-9]{64}", str(expected_checkpoint_sha256 or ""))
        is None
        or previous_checkpoint_sha256 != expected_checkpoint_sha256
        or journal_revision
        != int(str(request_document["expected_journal_resource_version"])) + 1
    ):
        raise DeploymentError(
            "provider apply-journal CAS response does not extend the exact prior checkpoint"
        )
    expected_page_keys = {
        "cursor",
        "next_cursor",
        "start_ordinal",
        "end_ordinal",
        "record_count",
        "records_sha256",
        "prefix_accumulator_sha256",
        "page_accumulator_sha256",
    }
    try:
        start_ordinal = int(str(page["start_ordinal"]))
        end_ordinal = int(str(page["end_ordinal"]))
        record_count = page["record_count"]
    except (KeyError, TypeError, ValueError) as exc:
        raise DeploymentError("provider apply-journal range proof is malformed") from exc
    cursor = page.get("cursor")
    next_cursor = page.get("next_cursor")
    for cursor_value in (cursor, next_cursor):
        if cursor_value is not None and (
            not isinstance(cursor_value, str)
            or re.fullmatch(r"[A-Za-z0-9_-]{16,512}", cursor_value) is None
        ):
            raise DeploymentError(
                "provider apply-journal range cursor is malformed"
            )
    if (
        set(page) != expected_page_keys
        or cursor != request_document.get("cursor")
        or not isinstance(record_count, int)
        or isinstance(record_count, bool)
        or record_count != len(records)
        or not isinstance(page.get("start_ordinal"), str)
        or re.fullmatch(r"(?:0|[1-9][0-9]*)", page["start_ordinal"])
        is None
        or not isinstance(page.get("end_ordinal"), str)
        or re.fullmatch(r"(?:0|[1-9][0-9]*)", page["end_ordinal"])
        is None
        or start_ordinal < 0
        or end_ordinal != start_ordinal + record_count
        or re.fullmatch(r"[a-f0-9]{64}", str(page.get("records_sha256", "")))
        is None
        or re.fullmatch(
            r"[a-f0-9]{64}", str(page.get("prefix_accumulator_sha256", ""))
        )
        is None
        or re.fullmatch(
            r"[a-f0-9]{64}", str(page.get("page_accumulator_sha256", ""))
        )
        is None
        or page.get("records_sha256") != _json_sha256({"records": records})
        or (
            start_ordinal == 0
            and page.get("prefix_accumulator_sha256")
            != _provider_journal_accumulator_start(
                project_id=project_id,
                cluster_id=cluster_id,
                journal_resource_version=str(
                    observation["journal_resource_version"]
                ),
                view=str(observation["view"]),
            )
        )
        or (
            action != "observe"
            and (
                cursor is not None
                or next_cursor is not None
                or start_ordinal != 0
                or record_count != 1
            )
        )
    ):
        raise DeploymentError(
            "provider apply-journal range proof is incomplete or malformed"
        )
    apply_ids: list[str] = []
    validated_records: list[dict[str, Any]] = []
    page_accumulator_sha256 = str(page["prefix_accumulator_sha256"])
    for record in records:
        if not isinstance(record, Mapping) or set(record) != {
            "record_resource_version",
            "marker",
            "marker_signature",
            "resolution",
            "resolution_signature",
        }:
            raise DeploymentError("provider apply-journal record is malformed")
        marker = _journal_receipt_payload(
            record.get("marker", {}), label="provider indeterminate marker"
        )
        marker_payload = {
            key: value for key, value in marker.items() if key != "payload_sha256"
        }
        expected_marker_keys = {
            "schema",
            "apply_id",
            "stage",
            "saved_plan_name",
            "saved_plan_sha256",
            "target_postconditions_sha256",
            "source_commit",
            "source_tree",
            "project_id",
            "cluster_id",
            "custody_transaction_id",
            "credential_epochs_sha256",
            "started_at",
            "journal_opened_at",
            "journal_open_resource_version",
            "remote_outcome",
            "payload_sha256",
        }
        try:
            started_at = datetime.fromisoformat(
                str(marker["started_at"]).replace("Z", "+00:00")
            )
            opened_at = datetime.fromisoformat(
                str(marker["journal_opened_at"]).replace("Z", "+00:00")
            )
            marker_revision = int(str(marker["journal_open_resource_version"]))
            record_revision = int(str(record["record_resource_version"]))
        except (KeyError, TypeError, ValueError) as exc:
            raise DeploymentError("provider indeterminate marker is malformed") from exc
        if (
            set(marker) != expected_marker_keys
            or marker.get("schema") != _INDETERMINATE_APPLY_SCHEMA
            or marker.get("project_id") != project_id
            or marker.get("cluster_id") != cluster_id
            or re.fullmatch(r"[a-f0-9]{32}", str(marker.get("apply_id", "")))
            is None
            or marker.get("stage")
            not in {"configuration", "infrastructure", "foundation", "workloads"}
            or (
                marker.get("saved_plan_name")
                not in {
                    f"{marker.get('stage')}.tfplan",
                    f"{marker.get('stage')}-destroy.tfplan",
                }
                and re.fullmatch(
                    rf"{re.escape(str(marker.get('stage', '')))}-[a-f0-9]{{32}}\.refresh-only\.tfplan",
                    str(marker.get("saved_plan_name", "")),
                )
                is None
            )
            or (
                marker.get("saved_plan_name")
                not in {
                    f"{marker.get('stage')}.tfplan",
                    f"{marker.get('stage')}-destroy.tfplan",
                }
                and re.fullmatch(
                    rf"{re.escape(str(marker.get('stage', '')))}-[a-f0-9]{{32}}\.refresh-only\.tfplan",
                    str(marker.get("saved_plan_name", "")),
                )
                is None
            )
            or any(
                re.fullmatch(r"[a-f0-9]{64}", str(marker.get(field, ""))) is None
                for field in {
                    "saved_plan_sha256",
                    "target_postconditions_sha256",
                    "credential_epochs_sha256",
                }
            )
            or any(
                re.fullmatch(r"[a-f0-9]{40}", str(marker.get(field, ""))) is None
                for field in {"source_commit", "source_tree"}
            )
            or re.fullmatch(
                r"[a-z][a-z0-9]{5,31}:[1-9][0-9]*:[a-f0-9]{32}",
                str(marker.get("custody_transaction_id", "")),
            )
            is None
            or started_at.tzinfo is None
            or opened_at.tzinfo is None
            or opened_at < started_at
            or opened_at > checkpoint_created_at
            or not isinstance(marker.get("journal_open_resource_version"), str)
            or marker_revision < 1
            or marker_revision > journal_revision
            or not isinstance(record.get("record_resource_version"), str)
            or record_revision < marker_revision
            or record_revision > journal_revision
            or marker.get("remote_outcome") != "pending-or-indeterminate"
            or marker.get("payload_sha256") != _json_sha256(marker_payload)
        ):
            raise DeploymentError(
                "provider indeterminate marker is outside the exact journal contract"
            )
        _verify_provider_journal_receipt_signature(
            receipt=marker,
            encoded_signature=record.get("marker_signature"),
            trust_root=trust_root,
            verifier_sha256=signature_verifier_sha256,
            label="provider indeterminate marker",
        )
        resolution_value = record.get("resolution")
        resolution_signature = record.get("resolution_signature")
        if resolution_value is None:
            if resolution_signature is not None or record_revision != marker_revision:
                raise DeploymentError(
                    "an unresolved provider journal record has contradictory state"
                )
            resolution: dict[str, Any] | None = None
        else:
            resolution = _journal_receipt_payload(
                resolution_value, label="provider indeterminate resolution"
            )
            expected_resolution_keys = {
                "schema",
                "apply_id",
                "marker_sha256",
                "marker_journal_resource_version",
                "resolution_kind",
                "resolution_custody_transaction_id",
                "provider_settlement_sha256",
                "refresh_plan_sha256",
                "refreshed_state_projection_sha256",
                "target_postconditions_sha256",
                "remote_operations_terminal",
                "target_postconditions_satisfied",
                "resolved_at",
                "journal_previous_resource_version",
                "journal_resolution_resource_version",
                "payload_sha256",
            }
            try:
                resolved_at = datetime.fromisoformat(
                    str(resolution["resolved_at"]).replace("Z", "+00:00")
                )
                previous_revision = int(
                    str(resolution["journal_previous_resource_version"])
                )
                resolution_revision = int(
                    str(resolution["journal_resolution_resource_version"])
                )
            except (KeyError, TypeError, ValueError) as exc:
                raise DeploymentError(
                    "provider indeterminate resolution is malformed"
                ) from exc
            resolution_payload = {
                key: value
                for key, value in resolution.items()
                if key != "payload_sha256"
            }
            kind = resolution.get("resolution_kind")
            if (
                set(resolution) != expected_resolution_keys
                or resolution.get("schema") != _INDETERMINATE_RESOLUTION_SCHEMA
                or resolution.get("apply_id") != marker["apply_id"]
                or resolution.get("marker_sha256") != _json_sha256(marker)
                or resolution.get("marker_journal_resource_version")
                != marker["journal_open_resource_version"]
                or kind not in {"normal-completion", "fresh-recovery"}
                or re.fullmatch(
                    r"[a-z][a-z0-9]{5,31}:[1-9][0-9]*:[a-f0-9]{32}",
                    str(resolution.get("resolution_custody_transaction_id", "")),
                )
                is None
                or (
                    kind == "normal-completion"
                    and resolution.get("resolution_custody_transaction_id")
                    != marker["custody_transaction_id"]
                )
                or (
                    kind == "fresh-recovery"
                    and resolution.get("resolution_custody_transaction_id")
                    == marker["custody_transaction_id"]
                )
                or any(
                    re.fullmatch(
                        r"[a-f0-9]{64}", str(resolution.get(field, ""))
                    )
                    is None
                    for field in {
                        "provider_settlement_sha256",
                        "refresh_plan_sha256",
                        "refreshed_state_projection_sha256",
                        "target_postconditions_sha256",
                    }
                )
                or resolution.get("target_postconditions_sha256")
                != marker["target_postconditions_sha256"]
                or resolution.get("refreshed_state_projection_sha256")
                != marker["target_postconditions_sha256"]
                or (
                    kind == "normal-completion"
                    and resolution.get("refresh_plan_sha256")
                    != marker["saved_plan_sha256"]
                )
                or resolution.get("remote_operations_terminal") is not True
                or resolution.get("target_postconditions_satisfied") is not True
                or resolved_at.tzinfo is None
                or resolved_at < opened_at
                or resolved_at > checkpoint_created_at
                or previous_revision < marker_revision
                or resolution_revision != record_revision
                or resolution_revision != previous_revision + 1
                or resolution.get("payload_sha256")
                != _json_sha256(resolution_payload)
            ):
                raise DeploymentError(
                    "provider indeterminate resolution is outside the exact recovery contract"
                )
            _verify_provider_journal_receipt_signature(
                receipt=resolution,
                encoded_signature=resolution_signature,
                trust_root=trust_root,
                verifier_sha256=signature_verifier_sha256,
                label="provider indeterminate resolution",
            )
        page_accumulator_sha256 = _provider_journal_accumulator_add(
            page_accumulator_sha256, record
        )
        apply_ids.append(str(marker["apply_id"]))
        validated_records.append(
            {
                "record_resource_version": record["record_resource_version"],
                "marker": marker,
                "resolution": resolution,
            }
        )
    if apply_ids != sorted(set(apply_ids)):
        raise DeploymentError(
            "provider apply-journal records are not uniquely sorted by apply ID"
        )
    if page_accumulator_sha256 != page.get("page_accumulator_sha256"):
        raise DeploymentError(
            "provider apply-journal range accumulator does not cover the exact page"
        )
    if action == "observe" and any(
        record["resolution"] is not None for record in validated_records
    ):
        raise DeploymentError(
            "provider unresolved-view page contains a resolved record"
        )
    if action in {"begin", "resolve"}:
        requested_apply_id = (
            request_document.get("marker", {}).get("apply_id")
            if action == "begin"
            else request_document.get("apply_id")
        )
        affected = validated_records[0]
        if (
            affected["marker"]["apply_id"] != requested_apply_id
            or int(str(affected["record_resource_version"])) != journal_revision
            or (action == "begin" and affected["resolution"] is not None)
            or (action == "resolve" and affected["resolution"] is None)
            or (
                action == "resolve"
                and int(
                    str(
                        affected["resolution"][
                            "journal_previous_resource_version"
                        ]
                    )
                )
                != int(str(request_document["expected_journal_resource_version"]))
            )
            or (
                action == "resolve"
                and int(
                    str(
                        affected["resolution"][
                            "journal_resolution_resource_version"
                        ]
                    )
                )
                != journal_revision
            )
        ):
            raise DeploymentError(
                "provider apply-journal affected view differs from the CAS request"
            )
    result = dict(observation)
    result["checkpoint"] = checkpoint
    result["records"] = validated_records
    return result


def _complete_unresolved_provider_apply_journal(
    *,
    journal_guard: Callable[[str, Mapping[str, Any]], dict[str, Any]],
    expected_checkpoint_sha256: str | None = None,
) -> dict[str, Any]:
    """Read every bounded unresolved page from one signed immutable checkpoint."""

    if expected_checkpoint_sha256 is not None and re.fullmatch(
        r"[a-f0-9]{64}", expected_checkpoint_sha256
    ) is None:
        raise DeploymentError("expected provider journal checkpoint is malformed")
    cursor: str | None = None
    seen_cursors: set[str] = set()
    pinned_checkpoint_sha256 = expected_checkpoint_sha256
    aggregate: dict[str, Any] | None = None
    records: list[dict[str, Any]] = []
    expected_ordinal = 0
    unresolved_record_count: int | None = None
    accumulator_sha256: str | None = None
    last_apply_id: str | None = None
    while True:
        observation = journal_guard(
            "observe",
            {
                "schema": _PROVIDER_APPLY_JOURNAL_REQUEST_SCHEMA,
                "operation": "observe",
                "view": "unresolved",
                "cursor": cursor,
                "expected_checkpoint_sha256": pinned_checkpoint_sha256,
                "page_size": _PROVIDER_APPLY_JOURNAL_PAGE_SIZE,
            },
        )
        page = observation.get("page")
        checkpoint = observation.get("checkpoint")
        if not isinstance(page, Mapping) or not isinstance(checkpoint, Mapping):
            raise DeploymentError(
                "provider apply-journal page has no validated checkpoint"
            )
        if aggregate is None:
            aggregate = dict(observation)
            pinned_checkpoint_sha256 = str(observation["checkpoint_sha256"])
            unresolved_record_count = int(
                str(checkpoint["unresolved_record_count"])
            )
            accumulator_sha256 = _provider_journal_accumulator_start(
                project_id=str(observation["project_id"]),
                cluster_id=str(observation["cluster_id"]),
                journal_resource_version=str(
                    observation["journal_resource_version"]
                ),
                view="unresolved",
            )
        elif (
            observation.get("checkpoint_sha256")
            != pinned_checkpoint_sha256
            or observation.get("journal_resource_version")
            != aggregate.get("journal_resource_version")
            or checkpoint != aggregate.get("checkpoint")
        ):
            raise DeploymentError(
                "provider apply-journal checkpoint changed between pages"
            )
        if (
            int(str(page["start_ordinal"])) != expected_ordinal
            or page.get("prefix_accumulator_sha256") != accumulator_sha256
        ):
            raise DeploymentError(
                "provider apply-journal range proof has a gap or overlap"
            )
        page_records = observation.get("records")
        if not isinstance(page_records, list):
            raise DeploymentError("provider apply-journal page has no records")
        for record in page_records:
            apply_id = str(record.get("marker", {}).get("apply_id", ""))
            if last_apply_id is not None and apply_id <= last_apply_id:
                raise DeploymentError(
                    "provider unresolved journal pages are not globally sorted and unique"
                )
            last_apply_id = apply_id
            records.append(record)
        expected_ordinal = int(str(page["end_ordinal"]))
        accumulator_sha256 = str(page["page_accumulator_sha256"])
        next_cursor = page.get("next_cursor")
        if next_cursor is None:
            if (
                unresolved_record_count is None
                or expected_ordinal != unresolved_record_count
                or accumulator_sha256
                != checkpoint.get("unresolved_accumulator_sha256")
            ):
                raise DeploymentError(
                    "provider apply-journal terminal range does not prove the "
                    "complete unresolved view"
                )
            aggregate["records"] = records
            aggregate["complete_unresolved_view"] = True
            return aggregate
        if (
            not page_records
            or unresolved_record_count is None
            or expected_ordinal >= unresolved_record_count
            or next_cursor in seen_cursors
        ):
            raise DeploymentError(
                "provider apply-journal pagination cannot reach the signed checkpoint"
            )
        seen_cursors.add(next_cursor)
        cursor = next_cursor


def _unresolved_indeterminate_applies(
    run_root: Path, journal_observation: Mapping[str, Any]
) -> list[dict[str, Any]]:
    _audit_local_indeterminate_artifacts(run_root)
    if journal_observation.get("complete_unresolved_view") is not True:
        raise DeploymentError(
            "provider apply journal is not a completely proven unresolved view"
        )
    records = journal_observation.get("records")
    if not isinstance(records, list):
        raise DeploymentError("provider apply journal has no validated record set")
    unresolved: list[dict[str, Any]] = []
    for record in records:
        if not isinstance(record, Mapping):
            raise DeploymentError(
                "provider apply journal contains an invalid record"
            )
        if record.get("resolution") is None:
            unresolved.append(dict(record))
    return unresolved


def _require_journal_resolution_matches_request(
    record: Mapping[str, Any], request_document: Mapping[str, Any]
) -> None:
    resolution = record.get("resolution")
    requested = request_document.get("resolution")
    if not isinstance(resolution, Mapping) or not isinstance(requested, Mapping):
        raise DeploymentError(
            "the provider apply journal did not return the requested resolution"
        )
    expected_fields = {
        key: value
        for key, value in requested.items()
        if key != "custody_valid_until"
    }
    actual_fields = {
        key: resolution.get(key) for key in expected_fields
    }
    if (
        record.get("marker", {}).get("apply_id")
        != request_document.get("apply_id")
        or _json_sha256(record.get("marker", {}))
        != request_document.get("marker_sha256")
        or actual_fields != expected_fields
    ):
        raise DeploymentError(
            "the provider-signed resolution differs from the exact settlement and state proof"
        )


def _assert_no_unresolved_indeterminate_apply(
    run_root: Path,
    *,
    journal_guard: Callable[[str, Mapping[str, Any]], dict[str, Any]],
    allowed_apply_ids: Sequence[str] = (),
    expected_checkpoint_sha256: str | None = None,
) -> dict[str, Any]:
    observation = _complete_unresolved_provider_apply_journal(
        journal_guard=journal_guard,
        expected_checkpoint_sha256=expected_checkpoint_sha256,
    )
    allowed = set(allowed_apply_ids)
    unresolved = [
        record
        for record in _unresolved_indeterminate_applies(run_root, observation)
        if record.get("marker", {}).get("apply_id") not in allowed
    ]
    if unresolved:
        raise DeploymentError(
            "mutation is blocked by unresolved provider-custodied apply receipts: "
            + ", ".join(
                str(record.get("marker", {}).get("apply_id"))
                for record in unresolved
            )
            + "; run reconcile-indeterminate under a fresh signed custody epoch"
        )
    return observation


def apply_plan(
    terraform: str,
    root: Path,
    plan_path: Path,
    environment: Mapping[str, str],
    *,
    custody_guard: Callable[[], datetime] | None = None,
    indeterminate_root: Path | None = None,
    stage: str = "",
    custody_project_id: str = "",
    custody_cluster_id: str = "",
    custody_transaction_id: str = "",
    credential_epochs_sha256: str = "",
    target_postconditions_sha256: str = "",
    journal_guard: Callable[[str, Mapping[str, Any]], dict[str, Any]] | None = None,
    settlement_guard: Callable[[Mapping[str, Any], datetime], dict[str, Any]] | None = None,
    reconciling_apply_ids: Sequence[str] = (),
) -> None:
    arguments = [
        terraform,
        f"-chdir={root}",
        "apply",
        "-input=false",
        str(plan_path),
    ]
    if custody_guard is None:
        run(arguments, env=environment)
        return
    if (
        indeterminate_root is None
        or stage not in {"configuration", "infrastructure", "foundation", "workloads"}
        or re.fullmatch(r"project-[a-z0-9]+", custody_project_id) is None
        or re.fullmatch(r"mk8scluster-[a-z0-9]+", custody_cluster_id) is None
        or re.fullmatch(
            r"[a-z][a-z0-9]{5,31}:[1-9][0-9]*:[a-f0-9]{32}",
            custody_transaction_id,
        )
        is None
        or re.fullmatch(r"[a-f0-9]{64}", credential_epochs_sha256) is None
        or re.fullmatch(r"[a-f0-9]{64}", target_postconditions_sha256) is None
        or journal_guard is None
        or settlement_guard is None
        or plan_path.parent.resolve() != indeterminate_root.resolve()
        or (
            plan_path.name not in {f"{stage}.tfplan", f"{stage}-destroy.tfplan"}
            and re.fullmatch(
                rf"{re.escape(stage)}-[a-f0-9]{{32}}\.refresh-only\.tfplan",
                plan_path.name,
            )
            is None
        )
    ):
        raise DeploymentError(
            "a custodied apply requires an external append-only journal identity and exact saved plan"
        )
    journal_observation = _assert_no_unresolved_indeterminate_apply(
        indeterminate_root,
        journal_guard=journal_guard,
        allowed_apply_ids=reconciling_apply_ids,
    )
    prior_unresolved_records = {
        record["marker"]["apply_id"]: record
        for record in _unresolved_indeterminate_applies(
            indeterminate_root, journal_observation
        )
    }
    print(f"+ {command_text(arguments)}", file=sys.stderr)
    expires_at = custody_guard()
    if expires_at - datetime.now(UTC) < timedelta(minutes=10):
        raise DeploymentError(
            "provider custody has less than ten minutes remaining before apply"
        )

    def process_group_alive(process_group_id: int) -> bool:
        try:
            os.killpg(process_group_id, 0)
        except ProcessLookupError:
            return False
        except PermissionError as exc:
            raise DeploymentError(
                "cannot prove custody of the Terraform process group"
            ) from exc
        return True

    apply_id = secrets.token_hex(16)
    apply_started_at = datetime.now(UTC)
    source_identity = source_commit()
    source_tree = run(
        ["git", "-C", str(REPOSITORY_ROOT), "rev-parse", "HEAD^{tree}"],
        capture=True,
        env=clean_environment(),
    ).stdout.strip()
    if re.fullmatch(r"[a-f0-9]{40}", source_tree) is None:
        raise DeploymentError("the source checkout has no exact tree identity")
    begin_request = {
        "schema": _PROVIDER_APPLY_JOURNAL_REQUEST_SCHEMA,
        "operation": "begin",
        "expected_journal_resource_version": journal_observation[
            "journal_resource_version"
        ],
        "expected_checkpoint_sha256": journal_observation[
            "checkpoint_sha256"
        ],
        "marker": {
            "schema": _INDETERMINATE_APPLY_SCHEMA,
            "apply_id": apply_id,
            "stage": stage,
            "saved_plan_name": plan_path.name,
            "saved_plan_sha256": _sha256_file(plan_path),
            "target_postconditions_sha256": target_postconditions_sha256,
            "source_commit": source_identity,
            "source_tree": source_tree,
            "project_id": custody_project_id,
            "cluster_id": custody_cluster_id,
            "custody_transaction_id": custody_transaction_id,
            "credential_epochs_sha256": credential_epochs_sha256,
            "started_at": apply_started_at.isoformat().replace("+00:00", "Z"),
            "remote_outcome": "pending-or-indeterminate",
        },
    }
    opened_observation = journal_guard("begin", begin_request)
    opened_records = {
        record["marker"]["apply_id"]: record
        for record in opened_observation["records"]
    }
    opened_record = opened_records.get(apply_id)
    if (
        not isinstance(opened_record, Mapping)
        or opened_record.get("resolution") is not None
        or {
            key: value
            for key, value in opened_record["marker"].items()
            if key
            not in {
                "journal_opened_at",
                "journal_open_resource_version",
                "payload_sha256",
            }
        }
        != begin_request["marker"]
    ):
        raise DeploymentError(
            "provider apply journal did not atomically open the exact apply marker"
        )
    marker = dict(opened_record["marker"])
    opened_unresolved_observation = _complete_unresolved_provider_apply_journal(
        journal_guard=journal_guard,
        expected_checkpoint_sha256=str(
            opened_observation["checkpoint_sha256"]
        ),
    )
    opened_unresolved_record = next(
        (
            record
            for record in opened_unresolved_observation["records"]
            if record["marker"]["apply_id"] == apply_id
        ),
        None,
    )
    if (
        not isinstance(opened_unresolved_record, Mapping)
        or opened_unresolved_record.get("resolution") is not None
        or opened_unresolved_record.get("marker") != marker
    ):
        raise DeploymentError(
            "provider checkpoint does not include the newly opened unresolved apply"
        )
    opened_unresolved_records = {
        record["marker"]["apply_id"]: record
        for record in _unresolved_indeterminate_applies(
            indeterminate_root, opened_unresolved_observation
        )
    }
    if (
        set(opened_unresolved_records) != set(prior_unresolved_records) | {apply_id}
        or any(
            opened_unresolved_records[prior_apply_id] != prior_record
            for prior_apply_id, prior_record in prior_unresolved_records.items()
        )
    ):
        raise DeploymentError(
            "provider begin checkpoint changed an unresolved record other than the exact new apply"
        )
    apply_environment = dict(environment)
    if "TF_APPEND_USER_AGENT" in apply_environment:
        raise DeploymentError(
            "TF_APPEND_USER_AGENT is reserved for the indeterminate-operation fence"
        )
    apply_environment["TF_APPEND_USER_AGENT"] = (
        f"fs2-network-boundary-apply/{apply_id}"
    )

    def stop_process_tree(process: subprocess.Popen[Any]) -> None:
        """Stop once, then kill and reap the complete credential-bearing group."""

        process_group_id = process.pid
        if not process_group_alive(process_group_id):
            if process.poll() is None:
                process.wait()
            return
        try:
            # SIGSTOP is the credential-use fence: no provider/plugin member can
            # issue another request.  SIGKILL is delivered while every member is
            # still stopped; SIGCONT/SIGTERM would reopen a remote-write window.
            os.killpg(process_group_id, signal.SIGSTOP)
            os.killpg(process_group_id, signal.SIGKILL)
            process.wait(timeout=10)
        except ProcessLookupError:
            if process.poll() is None:
                process.wait()
        except subprocess.TimeoutExpired as exc:
            raise DeploymentError(
                "Terraform process group did not terminate while stopped"
            ) from exc
        if process_group_alive(process_group_id):
            raise DeploymentError("Terraform process group survived custody fencing")

    managed_apply_signals = (signal.SIGINT, signal.SIGTERM)
    previous_apply_signal_handlers: dict[int, Any] = {}
    previous_apply_signal_mask: set[signal.Signals] | None = None

    def terraform_abort_signal(signum: int, _frame: Any) -> None:
        """Convert catchable termination into the common process-group fence."""

        # Block a second catchable termination while the outer BaseException
        # handler stops, kills and reaps the credential-bearing process group.
        for managed_signal in managed_apply_signals:
            signal.signal(managed_signal, signal.SIG_IGN)
        raise DeploymentError(
            f"Terraform apply received {signal.Signals(signum).name}; provider "
            f"apply {apply_id} remains unresolved"
        )

    process: subprocess.Popen[Any] | None = None
    try:
        try:
            for managed_signal in managed_apply_signals:
                previous_apply_signal_handlers[managed_signal] = signal.getsignal(
                    managed_signal
                )
                signal.signal(managed_signal, terraform_abort_signal)
        except BaseException as signal_error:
            for managed_signal, previous_handler in (
                previous_apply_signal_handlers.items()
            ):
                signal.signal(managed_signal, previous_handler)
            raise DeploymentError(
                "cannot install the Terraform apply SIGINT/SIGTERM custody fence"
            ) from signal_error
        try:
            try:
                # Keep catchable termination pending across Popen so the child
                # cannot exist before ``process`` is assigned. Unblocking then
                # routes any pending signal through the common outer fence.
                previous_apply_signal_mask = signal.pthread_sigmask(
                    signal.SIG_BLOCK, managed_apply_signals
                )
                try:
                    process = subprocess.Popen(
                        arguments,
                        env=apply_environment,
                        start_new_session=True,
                    )
                finally:
                    signal.pthread_sigmask(
                        signal.SIG_SETMASK, previous_apply_signal_mask
                    )
                    previous_apply_signal_mask = None
            except FileNotFoundError as exc:
                raise DeploymentError(
                    f"required executable not found: {terraform}"
                ) from exc
            while True:
                try:
                    return_code = process.wait(timeout=5)
                    break
                except subprocess.TimeoutExpired:
                    try:
                        refreshed_expiry = custody_guard()
                        if refreshed_expiry < expires_at:
                            raise DeploymentError(
                                "provider custody validity regressed during apply"
                            )
                        expires_at = refreshed_expiry
                        if refreshed_expiry - datetime.now(UTC) < timedelta(
                            seconds=90
                        ):
                            raise DeploymentError(
                                "provider custody expiry approached during apply"
                            )
                    except BaseException as custody_error:
                        raise DeploymentError(
                            "provider custody failed during apply; the Terraform "
                            "process group must be fenced without resuming credential "
                            f"use and the remote outcome is indeterminate (provider apply {apply_id})"
                        ) from custody_error
            if return_code != 0:
                raise DeploymentError(
                    f"command failed with exit code {return_code}; the complete "
                    "credential-bearing process group must be fenced and reaped, "
                    f"and the remote outcome remains indeterminate (provider apply {apply_id}): "
                    f"{command_text(arguments)}"
                )
            if process_group_alive(process.pid):
                raise DeploymentError(
                    "Terraform returned while a provider/plugin process remained alive; "
                    f"remote outcome is indeterminate (provider apply {apply_id})"
                )
        except BaseException:
            if process is None:
                raise
            # The same fence covers nonzero exit, custody failure, SIGINT,
            # SIGTERM, KeyboardInterrupt and every other post-Popen exception.
            # Ignore repeat catchable termination until the group is reaped.
            for managed_signal in managed_apply_signals:
                signal.signal(managed_signal, signal.SIG_IGN)
            fence_error: BaseException | None = None
            try:
                stop_process_tree(process)
            except BaseException as error:
                fence_error = error
            if fence_error is not None:
                raise DeploymentError(
                    "Terraform execution failed or was interrupted and its "
                    "credential-bearing process group could not be fully fenced "
                    f"and reaped; provider apply {apply_id} remains unresolved "
                    "and no further mutation is permitted"
                ) from fence_error
            raise
    finally:
        if previous_apply_signal_mask is not None:
            signal.pthread_sigmask(
                signal.SIG_SETMASK, previous_apply_signal_mask
            )
        for (
            managed_signal,
            previous_handler,
        ) in previous_apply_signal_handlers.items():
            signal.signal(managed_signal, previous_handler)
    try:
        refreshed_expiry = custody_guard()
    except BaseException as custody_error:
        raise DeploymentError(
            "post-apply custody verification failed; remote outcome is "
            f"indeterminate (provider apply {apply_id})"
        ) from custody_error
    if refreshed_expiry < expires_at or refreshed_expiry - datetime.now(UTC) < timedelta(seconds=60):
        raise DeploymentError(
            "provider custody changed or expired before the post-apply fence; "
            f"remote outcome is indeterminate (provider apply {apply_id})"
        )
    settlement = settlement_guard(marker, refreshed_expiry - timedelta(minutes=2))
    refreshed_state = run(
        [terraform, f"-chdir={root}", "show", "-json"],
        env=environment,
        capture=True,
    )
    target_plan = run(
        [terraform, f"-chdir={root}", "show", "-json", str(plan_path)],
        env=environment,
        capture=True,
    )
    try:
        refreshed_document = json.loads(refreshed_state.stdout)
        target_document = json.loads(target_plan.stdout)
    except json.JSONDecodeError as exc:
        raise DeploymentError(
            f"provider apply {apply_id} completed but its state proof is unreadable; the external marker remains open"
        ) from exc
    refreshed_projection = _terraform_value_projection(refreshed_document, "values")
    target_projection = _terraform_value_projection(target_document, "planned_values")
    if (
        _json_sha256(target_projection) != target_postconditions_sha256
        or refreshed_projection != target_projection
    ):
        raise DeploymentError(
            f"provider apply {apply_id} does not satisfy its signed saved-plan postconditions; the external marker remains open"
        )
    final_expiry = custody_guard()
    resolution_request = {
        "schema": _PROVIDER_APPLY_JOURNAL_REQUEST_SCHEMA,
        "operation": "resolve",
        "expected_journal_resource_version": opened_observation[
            "journal_resource_version"
        ],
        "expected_checkpoint_sha256": opened_observation[
            "checkpoint_sha256"
        ],
        "apply_id": apply_id,
        "marker_sha256": _json_sha256(marker),
        "resolution": {
            "schema": _INDETERMINATE_RESOLUTION_SCHEMA,
            "resolution_kind": "normal-completion",
            "resolution_custody_transaction_id": custody_transaction_id,
            "provider_settlement_sha256": _json_sha256(settlement),
            "refresh_plan_sha256": _sha256_file(plan_path),
            "refreshed_state_projection_sha256": _json_sha256(
                refreshed_projection
            ),
            "target_postconditions_sha256": target_postconditions_sha256,
            "remote_operations_terminal": True,
            "target_postconditions_satisfied": True,
            "custody_valid_until": final_expiry.isoformat().replace(
                "+00:00", "Z"
            ),
        },
    }
    resolved_observation = journal_guard("resolve", resolution_request)
    post_resolution_observation = _assert_no_unresolved_indeterminate_apply(
        indeterminate_root,
        journal_guard=journal_guard,
        allowed_apply_ids=reconciling_apply_ids,
        expected_checkpoint_sha256=str(
            resolved_observation["checkpoint_sha256"]
        ),
    )
    post_resolution_records = {
        record["marker"]["apply_id"]: record
        for record in _unresolved_indeterminate_applies(
            indeterminate_root, post_resolution_observation
        )
    }
    expected_post_resolution_records = dict(opened_unresolved_records)
    expected_post_resolution_records.pop(apply_id)
    if post_resolution_records != expected_post_resolution_records:
        raise DeploymentError(
            "provider resolution checkpoint changed an unresolved record other "
            "than the exact completed apply"
        )
    resolved_record = next(
        (
            record
            for record in resolved_observation["records"]
            if record["marker"]["apply_id"] == apply_id
        ),
        None,
    )
    if not isinstance(resolved_record, Mapping):
        raise DeploymentError(
            "the provider apply journal did not return the signed resolution"
        )
    _require_journal_resolution_matches_request(
        resolved_record, resolution_request
    )


def _exact_kubernetes_user_info(document: Mapping[str, Any], label: str) -> dict[str, Any]:
    try:
        user_info = document["status"]["userInfo"]
        username = user_info["username"]
        groups = user_info["groups"]
        extras = user_info.get("extra", {})
    except (KeyError, TypeError) as exc:
        raise DeploymentError(f"{label} returned no complete authenticated identity") from exc
    if (
        not isinstance(username, str)
        or not username
        or not isinstance(groups, list)
        or not all(isinstance(group, str) and group for group in groups)
        or len(groups) != len(set(groups))
        or not isinstance(extras, dict)
    ):
        raise DeploymentError(f"{label} returned a malformed authenticated identity")
    return {"username": username, "groups": sorted(groups), "extras": extras}


@contextmanager
def model_network_transition_lock(
    *,
    kubectl: str,
    kubectl_tool: Mapping[str, Any],
    kubeconfig: str,
    kubeconfig_sha256: str,
    context: str,
    custody_expires_at: datetime,
    run_id: str,
    lease_name: str = "fs2-model-network-transition",
    expected_username: str = "fs2-model-network-transition",
    expected_groups: tuple[str, ...] = (
        "fs2:model-network-transition",
        "system:authenticated",
    ),
) -> Iterator[tuple[str, str]]:
    """Hold one API-guarded Lease using its separately custodied credential."""
    namespace = "fs2-system"
    name = lease_name
    holder = f"{run_id}:{os.getpid()}:{secrets.token_hex(16)}"
    transition_writer = expected_username
    base = [
        "--kubeconfig",
        kubeconfig,
        "--context",
        context,
    ]
    authenticated = _pinned_kubectl_command(
        kubectl=kubectl,
        tool=kubectl_tool,
        expected_kubeconfig_sha256=kubeconfig_sha256,
        arguments=[*base, "auth", "whoami", "-o", "json"],
    )
    if authenticated.returncode != 0:
        raise DeploymentError(
            "cannot resolve the exact Kubernetes-authenticated transition writer: "
            + (
                authenticated.stderr.decode(errors="replace").strip()
                or authenticated.stdout.decode(errors="replace").strip()
                or "kubectl auth whoami failed"
            )
        )
    try:
        authenticated_info = _exact_kubernetes_user_info(
            json.loads(authenticated.stdout), "kubectl auth whoami"
        )
        authenticated_username = authenticated_info["username"]
    except json.JSONDecodeError as exc:
        raise DeploymentError(
            "kubectl auth whoami returned malformed JSON"
        ) from exc
    if not isinstance(authenticated_username, str) or not authenticated_username:
        raise DeploymentError("the authenticated transition writer is empty")
    if authenticated_username != transition_writer:
        raise DeploymentError(
            "model-network transitions require the dedicated externally custodied writer"
        )
    if authenticated_info["groups"] != sorted(expected_groups) or authenticated_info["extras"]:
        raise DeploymentError(
            "the model-network operation writer group/extra identity is not exact"
        )
    observed = _pinned_kubectl_command(
        kubectl=kubectl,
        tool=kubectl_tool,
        expected_kubeconfig_sha256=kubeconfig_sha256,
        arguments=[*base, "-n", namespace, "get", "lease", name, "-o", "json"],
    )
    now = datetime.now(UTC)
    lease_duration_seconds = min(
        7200,
        int((custody_expires_at - now - timedelta(seconds=30)).total_seconds()),
    )
    if lease_duration_seconds < 60:
        raise DeploymentError(
            "provider custody has insufficient time to acquire an operation Lease"
        )
    if observed.returncode != 0:
        raise DeploymentError(
            "the provider-owned model-network operation Lease is unavailable; "
            "the phase writer may update it but can never create or delete it"
        )
    else:
        try:
            lease = json.loads(observed.stdout)
            metadata = lease["metadata"]
            annotations = metadata.get("annotations", {})
            if not isinstance(annotations, dict):
                raise ValueError("Lease annotations are malformed")
            prior_writer = annotations.get(
                "fs2-serve.nebius.ai/network-transition-writer"
            )
            if prior_writer not in {None, authenticated_username}:
                raise DeploymentError(
                    "model-network transition Lease is bound to a different "
                    "authenticated writer"
                )
            spec = lease.get("spec", {})
            if "holderIdentity" not in spec or "leaseTransitions" not in spec:
                raise ValueError("required Lease state is absent")
            current_holder = spec["holderIdentity"]
            renew_time = datetime.fromisoformat(
                spec.get("renewTime", "1970-01-01T00:00:00Z").replace("Z", "+00:00")
            )
            duration = int(spec.get("leaseDurationSeconds", 0))
            transitions = int(spec["leaseTransitions"])
        except (KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
            raise DeploymentError(
                "model-network transition Lease is malformed"
            ) from exc
        if current_holder and renew_time + timedelta(seconds=duration) > now:
            raise DeploymentError(
                f"model-network transition Lease is held by {current_holder!r}"
            )
        patch = [
            {
                "op": "test",
                "path": "/metadata/resourceVersion",
                "value": metadata["resourceVersion"],
            },
            {"op": "test", "path": "/spec/holderIdentity", "value": current_holder},
            (
                {
                    "op": "add",
                    "path": "/metadata/annotations",
                    "value": {
                        "fs2-serve.nebius.ai/network-transition-writer": authenticated_username,
                        "fs2-serve.nebius.ai/network-transition-holder": holder,
                    },
                }
                if "annotations" not in metadata
                else {
                    "op": "add",
                    "path": "/metadata/annotations/fs2-serve.nebius.ai~1network-transition-writer",
                    "value": authenticated_username,
                }
            ),
            {
                "op": "add",
                "path": "/metadata/annotations/fs2-serve.nebius.ai~1network-transition-holder",
                "value": holder,
            },
            {"op": "replace", "path": "/spec/holderIdentity", "value": holder},
            {
                "op": "replace",
                "path": "/spec/leaseDurationSeconds",
                "value": lease_duration_seconds,
            },
            {
                "op": "replace",
                "path": "/spec/renewTime",
                "value": now.isoformat().replace("+00:00", "Z"),
            },
            {
                "op": "replace",
                "path": "/spec/leaseTransitions",
                "value": transitions + 1,
            },
        ]
        acquired = _pinned_kubectl_command(
            kubectl=kubectl,
            tool=kubectl_tool,
            expected_kubeconfig_sha256=kubeconfig_sha256,
            arguments=[
                *base,
                "-n",
                namespace,
                "patch",
                "lease",
                name,
                "--type=json",
                "-p",
                json.dumps(patch, separators=(",", ":")),
            ],
        )
        if acquired.returncode != 0:
            raise DeploymentError("provider-pinned kubectl could not acquire the operation Lease")
    try:
        yield holder, authenticated_username
    finally:
        release_observed = _pinned_kubectl_command(
            kubectl=kubectl,
            tool=kubectl_tool,
            expected_kubeconfig_sha256=kubeconfig_sha256,
            arguments=[*base, "-n", namespace, "get", "lease", name, "-o", "json"],
        )
        try:
            release_resource_version = json.loads(release_observed.stdout)["metadata"][
                "resourceVersion"
            ]
        except (KeyError, TypeError, UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise DeploymentError(
                "cannot reconstruct the operation Lease CAS before release"
            ) from exc
        if (
            release_observed.returncode != 0
            or not isinstance(release_resource_version, str)
            or not release_resource_version
        ):
            raise DeploymentError(
                "cannot read the operation Lease immediately before release"
            )
        released_at = datetime.now(UTC).isoformat().replace("+00:00", "Z")
        release_patch = [
            {
                "op": "test",
                "path": "/metadata/resourceVersion",
                "value": release_resource_version,
            },
            {"op": "test", "path": "/spec/holderIdentity", "value": holder},
            {"op": "replace", "path": "/spec/holderIdentity", "value": ""},
            {"op": "replace", "path": "/spec/leaseDurationSeconds", "value": 1},
            {"op": "replace", "path": "/spec/renewTime", "value": released_at},
        ]
        released = _pinned_kubectl_command(
            kubectl=kubectl,
            tool=kubectl_tool,
            expected_kubeconfig_sha256=kubeconfig_sha256,
            arguments=[
                *base,
                "-n",
                namespace,
                "patch",
                "lease",
                name,
                "--type=json",
                "-p",
                json.dumps(release_patch, separators=(",", ":")),
            ],
        )
        if released.returncode != 0:
            raise DeploymentError("provider-pinned kubectl could not release the operation Lease")


def model_network_boundary_holder(
    *,
    kubectl: str,
    kubectl_tool: Mapping[str, Any],
    kubeconfig: str,
    kubeconfig_sha256: str,
    context: str,
) -> str:
    """Read the immutable marker's stable holder without mutating the boundary."""

    result = _pinned_kubectl_command(
        kubectl=kubectl,
        tool=kubectl_tool,
        expected_kubeconfig_sha256=kubeconfig_sha256,
        arguments=[
            "--kubeconfig",
            kubeconfig,
            "--context",
            context,
            "--namespace",
            "fs2-models",
            "get",
            "configmap",
            "fs2-runtime-network-policy-boundary-v2",
            "--output",
            "json",
        ],
    )
    if result.returncode != 0:
        raise DeploymentError("cannot read the armed model-network boundary marker")
    try:
        marker = json.loads(result.stdout)
        metadata = marker["metadata"]
        holder = metadata["annotations"][
            "fs2-serve.nebius.ai/network-transition-holder"
        ]
        writer = metadata["annotations"][
            "fs2-serve.nebius.ai/network-transition-writer"
        ]
    except (KeyError, TypeError, json.JSONDecodeError) as exc:
        raise DeploymentError("the armed model-network boundary marker is malformed") from exc
    if (
        marker.get("immutable") is not True
        or writer != "fs2-model-network-transition"
        or not isinstance(holder, str)
        or re.fullmatch(r"[a-z][a-z0-9]{5,11}:[1-9][0-9]*:[a-f0-9]{32}", holder)
        is None
    ):
        raise DeploymentError("the armed model-network boundary marker has no stable exact holder")
    return holder


def _sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _semantic_kubernetes_object(value: Mapping[str, Any]) -> dict[str, Any]:
    document = json.loads(json.dumps(value))
    document.pop("status", None)
    metadata = document.get("metadata", {})
    if isinstance(metadata, dict):
        for field in (
            "creationTimestamp",
            "generation",
            "managedFields",
            "resourceVersion",
            "uid",
        ):
            metadata.pop(field, None)
    return document


def _json_sha256(value: Mapping[str, Any]) -> str:
    return hashlib.sha256(
        json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()


def _provider_credential_epochs_sha256(
    attestation: Mapping[str, Any],
) -> str:
    """Hash the six verified provider credential epochs deterministically."""

    credentials = attestation.get("credentials")
    expected_names = {
        "authorizer",
        "transition",
        "maintenance",
        "auditor",
        "custodian",
        "recovery",
    }
    if not isinstance(credentials, Mapping) or set(credentials) != expected_names:
        raise DeploymentError(
            "provider custody does not contain the exact credential epoch inventory"
        )
    epochs = [
        str(credential.get("credential_epoch", ""))
        for credential in credentials.values()
        if isinstance(credential, Mapping)
    ]
    if (
        len(epochs) != len(expected_names)
        or len(set(epochs)) != len(expected_names)
        or any(re.fullmatch(r"[a-f0-9]{64}", epoch) is None for epoch in epochs)
    ):
        raise DeploymentError(
            "provider custody credential epochs are incomplete or non-unique"
        )
    return _json_sha256({"credential_epochs": sorted(epochs)})


def _finite_release_match_conditions(
    entries: list[Mapping[str, Any]],
) -> list[dict[str, str]]:
    if not entries or not all(isinstance(entry, Mapping) for entry in entries):
        raise DeploymentError("the finite signed release inventory is malformed")
    identities = sorted(
        {
            "|".join(
                (
                    str(entry.get("group", "")),
                    str(entry.get("resource", "")),
                    str(entry.get("namespace", "")),
                    str(entry.get("name", "")),
                    str(operation),
                )
            )
            for entry in entries
            for operation in entry.get("operations", [])
        }
    )
    return [
        {
            "name": "finite-signed-release-inventory",
            "expression": (
                json.dumps(identities, separators=(",", ":"))
                + ".exists(identity, identity == request.resource.group + '|' + "
                "request.resource.resource + '|' + request.namespace + '|' + "
                "request.name + '|' + request.operation)"
            ),
        }
    ]


def _provider_authority_census_stable_sha256(census: Mapping[str, Any]) -> str:
    """Hash provider authority semantics while permitting time-only renewal."""

    stable = copy.deepcopy(dict(census))
    snapshot = stable.get("snapshot")
    if isinstance(snapshot, dict):
        provider_freeze = snapshot.get("provider_mutation_freeze")
        if isinstance(provider_freeze, dict):
            provider_freeze.pop("active_from", None)
            provider_freeze.pop("active_until", None)
        stable["snapshot_sha256"] = _json_sha256(snapshot)
    return _json_sha256(stable)


def _provider_custody_stable_sha256(attestation: Mapping[str, Any]) -> str:
    """Bind renewable custody assertions to one immutable transaction/policy."""

    stable = copy.deepcopy(dict(attestation))
    stable.pop("observed_at", None)
    stable.pop("expires_at", None)
    stable.pop("payload_sha256", None)
    freeze = stable.get("mutation_freeze")
    if isinstance(freeze, dict):
        freeze.pop("active_from", None)
        freeze.pop("active_until", None)
    authority_census = stable.get("provider_authority_census")
    if isinstance(authority_census, dict):
        authority_census_sha256 = _provider_authority_census_stable_sha256(
            authority_census
        )
        snapshot = authority_census.get("snapshot")
        if isinstance(snapshot, dict):
            provider_freeze = snapshot.get("provider_mutation_freeze")
            if isinstance(provider_freeze, dict):
                provider_freeze.pop("active_from", None)
                provider_freeze.pop("active_until", None)
            authority_census["snapshot_sha256"] = _json_sha256(snapshot)
        gateway = stable.get("provider_gateway")
        if isinstance(gateway, dict):
            gateway["provider_authority_census_sha256"] = authority_census_sha256
    return _json_sha256(stable)


def _verified_provider_authority_census(
    *,
    attestation: Mapping[str, Any],
    cluster_id: str,
    project_id: str,
    provider_trust_root_sha256: str,
    member_ids: Sequence[str],
    gateway_members: Sequence[Mapping[str, Any]],
    freeze_active_from: datetime,
    freeze_active_until: datetime,
    freeze_transaction_id: str,
) -> str:
    """Verify two stable provider-native IAM/control-plane observations.

    Gateway labels and gateway-service-account permits are not a complete IAM
    boundary.  A separately pinned, root-owned provider exporter must enumerate
    the project-to-organization scope chain, every identity collection and
    inherited permit, every principal able to mutate the protected provider
    resources, the provider-enforced zero-principal freeze, and measured runtime
    state for every gateway.  The exporter is invoked twice; its complete
    canonical snapshots must be byte-semantically equal to each other and to
    the provider-signed snapshot.
    """

    census = attestation.get("provider_authority_census")
    if not isinstance(census, Mapping) or set(census) != {
        "schema",
        "exporter",
        "snapshot",
        "snapshot_sha256",
    }:
        raise DeploymentError(
            "provider custody has no exact provider-native authority census"
        )
    exporter = census.get("exporter")
    snapshot = census.get("snapshot")
    if (
        census.get("schema")
        != "fs2-serve.nebius.ai/provider-control-plane-authority-census/v1"
        or not isinstance(exporter, Mapping)
        or set(exporter)
        != {
            "path",
            "sha256",
            "format",
            "source_commit",
            "source_tree",
            "provenance_sha256",
            "authority_ca_path",
            "authority_ca_sha256",
            "client_certificate_path",
            "client_certificate_sha256",
            "client_key_path",
            "client_key_sha256",
        }
        or any(
            re.fullmatch(r"[a-f0-9]{64}", str(exporter.get(field, ""))) is None
            for field in (
                "sha256",
                "provenance_sha256",
                "authority_ca_sha256",
                "client_certificate_sha256",
                "client_key_sha256",
            )
        )
        or any(
            re.fullmatch(r"[a-f0-9]{40}", str(exporter.get(field, ""))) is None
            for field in ("source_commit", "source_tree")
        )
        or any(
            not isinstance(exporter.get(field), str)
            or not Path(str(exporter[field])).is_absolute()
            for field in (
                "path",
                "authority_ca_path",
                "client_certificate_path",
                "client_key_path",
            )
        )
        or exporter.get("format") != "static-elf-no-interpreter"
        or not isinstance(snapshot, Mapping)
        or census.get("snapshot_sha256") != _json_sha256(snapshot)
    ):
        raise DeploymentError(
            "provider custody authority exporter provenance or snapshot digest is malformed"
        )
    exporter_path = Path(
        os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_AUTHORITY_EXPORTER", "")
    )
    if str(exporter_path) != exporter.get("path"):
        raise DeploymentError(
            "the provider authority exporter path differs from signed custody"
        )
    exporter_bytes, exporter_sha256 = _stable_root_file_bytes(
        exporter_path,
        label="provider authority exporter",
        maximum_bytes=_MAX_CUSTODY_EXECUTABLE_BYTES,
    )
    _require_static_elf(exporter_bytes, label="provider authority exporter")
    credential_bytes: dict[str, bytes] = {}
    for credential_name, path_field, digest_field in (
        ("authority-ca", "authority_ca_path", "authority_ca_sha256"),
        (
            "client-certificate",
            "client_certificate_path",
            "client_certificate_sha256",
        ),
        ("client-key", "client_key_path", "client_key_sha256"),
    ):
        captured, digest = _stable_root_file_bytes(
            Path(str(exporter[path_field])),
            label=f"provider authority exporter {credential_name}",
            maximum_bytes=_MAX_CUSTODY_DOCUMENT_BYTES,
            private=True,
        )
        if digest != exporter[digest_field]:
            raise DeploymentError(
                f"provider authority exporter {credential_name} differs from signed custody"
            )
        credential_bytes[credential_name] = captured
    if exporter_sha256 != exporter.get("sha256"):
        raise DeploymentError(
            "provider authority exporter artifact differs from signed custody"
        )

    scope_chain = snapshot.get("scope_chain")
    identity_collections = snapshot.get("identity_collections")
    permit_digests = snapshot.get("access_permits_sha256")
    mutation_authorities = snapshot.get("control_plane_mutation_authorities")
    provider_freeze = snapshot.get("provider_mutation_freeze")
    runtime_measurements = snapshot.get("gateway_runtime_measurements")
    signing_material = snapshot.get("signing_material")
    apply_journal = snapshot.get("apply_journal")
    completeness_token = snapshot.get("completeness_token")
    if (
        set(snapshot)
        != {
            "source",
            "provider_api_endpoint",
            "authority_api_server_certificate_sha256",
            "completeness_token",
            "project_id",
            "cluster_id",
            "scope_chain",
            "identity_collections",
            "access_permits_sha256",
            "control_plane_mutation_authorities",
            "provider_mutation_freeze",
            "gateway_runtime_measurements",
            "signing_material",
            "apply_journal",
        }
        or snapshot.get("source") != "nebius-provider-authority-export/v1"
        or re.fullmatch(
            r"https://[^\s/?#]+(?:/[^\s?#]*)?",
            str(snapshot.get("provider_api_endpoint", "")),
        )
        is None
        or re.fullmatch(
            r"[a-f0-9]{64}",
            str(snapshot.get("authority_api_server_certificate_sha256", "")),
        )
        is None
        or snapshot.get("project_id") != project_id
        or snapshot.get("cluster_id") != cluster_id
        or not isinstance(scope_chain, list)
        or not 2 <= len(scope_chain) <= 16
        or not isinstance(identity_collections, list)
        or not isinstance(permit_digests, Mapping)
        or not isinstance(mutation_authorities, list)
        or not 1 <= len(mutation_authorities) <= 256
        or not isinstance(provider_freeze, Mapping)
        or not isinstance(runtime_measurements, Mapping)
        or not isinstance(signing_material, Mapping)
        or not isinstance(apply_journal, Mapping)
        or not isinstance(completeness_token, Mapping)
    ):
        raise DeploymentError(
            "the provider-native authority census is incomplete"
        )
    expected_parent = project_id
    scope_ids: list[str] = []
    for index, raw_scope in enumerate(scope_chain):
        if not isinstance(raw_scope, Mapping) or set(raw_scope) != {
            "kind",
            "id",
            "parent_id",
            "resource_version",
            "semantic_sha256",
        }:
            raise DeploymentError("provider IAM scope-chain entry is malformed")
        kind = raw_scope.get("kind")
        scope_id = raw_scope.get("id")
        parent_id = raw_scope.get("parent_id")
        if (
            kind not in {"project", "folder", "organization"}
            or not isinstance(scope_id, str)
            or not scope_id
            or scope_id != expected_parent
            or not isinstance(parent_id, str)
            or not isinstance(raw_scope.get("resource_version"), int)
            or isinstance(raw_scope.get("resource_version"), bool)
            or raw_scope["resource_version"] < 0
            or re.fullmatch(
                r"[a-f0-9]{64}", str(raw_scope.get("semantic_sha256", ""))
            )
            is None
            or (index == 0 and kind != "project")
            or (index == len(scope_chain) - 1 and (kind != "organization" or parent_id))
            or (index < len(scope_chain) - 1 and not parent_id)
        ):
            raise DeploymentError(
                "provider IAM scope chain is not a complete project-to-organization ancestry"
            )
        scope_ids.append(scope_id)
        expected_parent = parent_id
    if len(scope_ids) != len(set(scope_ids)):
        raise DeploymentError("provider IAM scope chain contains duplicate scopes")
    if (
        set(completeness_token)
        != {
            "scope_root_id",
            "resource_version",
            "provider_response_sha256",
            "effective_iam_inheritance_included",
            "all_mutation_authorities_included",
            "all_gateway_network_paths_included",
            "all_apply_journal_records_included",
        }
        or completeness_token.get("scope_root_id") != scope_ids[-1]
        or not isinstance(completeness_token.get("resource_version"), int)
        or isinstance(completeness_token.get("resource_version"), bool)
        or completeness_token["resource_version"] < 0
        or re.fullmatch(
            r"[a-f0-9]{64}",
            str(completeness_token.get("provider_response_sha256", "")),
        )
        is None
        or completeness_token.get("effective_iam_inheritance_included") is not True
        or completeness_token.get("all_mutation_authorities_included") is not True
        or completeness_token.get("all_gateway_network_paths_included") is not True
        or completeness_token.get("all_apply_journal_records_included") is not True
    ):
        raise DeploymentError(
            "provider-native completeness token does not cover inherited IAM and every gateway path"
        )
    collection_scope_ids: list[str] = []
    for collection in identity_collections:
        if (
            not isinstance(collection, Mapping)
            or set(collection)
            != {
                "scope_id",
                "service_accounts_sha256",
                "groups_sha256",
                "users_sha256",
            }
            or collection.get("scope_id") not in scope_ids
            or any(
                re.fullmatch(r"[a-f0-9]{64}", str(collection.get(field, "")))
                is None
                for field in (
                    "service_accounts_sha256",
                    "groups_sha256",
                    "users_sha256",
                )
            )
        ):
            raise DeploymentError(
                "provider IAM identity collection is not scope-complete"
            )
        collection_scope_ids.append(str(collection["scope_id"]))
    if sorted(collection_scope_ids) != sorted(scope_ids):
        raise DeploymentError(
            "provider IAM identity collections do not cover every inherited scope"
        )
    if (
        not permit_digests
        or any(
            not isinstance(principal_id, str)
            or not principal_id
            or re.fullmatch(r"[a-f0-9]{64}", str(digest)) is None
            for principal_id, digest in permit_digests.items()
        )
    ):
        raise DeploymentError("provider IAM permit census is not principal-complete")

    signing_resource_id = signing_material.get("resource_id")
    if (
        set(signing_material)
        != {"resource_id", "resource_version", "semantic_sha256", "public_key_sha256"}
        or not isinstance(signing_resource_id, str)
        or not signing_resource_id
        or not isinstance(signing_material.get("resource_version"), int)
        or isinstance(signing_material.get("resource_version"), bool)
        or any(
            re.fullmatch(r"[a-f0-9]{64}", str(signing_material.get(field, "")))
            is None
            for field in ("semantic_sha256", "public_key_sha256")
        )
        or signing_material.get("public_key_sha256")
        != provider_trust_root_sha256
    ):
        raise DeploymentError(
            "provider signing material is not bound to the root-pinned trust key"
        )
    journal_resource_id = apply_journal.get("resource_id")
    if (
        set(apply_journal)
        != {
            "resource_id",
            "resource_version",
            "semantic_sha256",
            "api_path_prefix",
            "storage",
            "compare_and_swap",
            "append_only",
            "deletion_supported",
            "receipt_signing_public_key_sha256",
            "journal_protocol",
            "checkpoint_algorithm",
            "unresolved_view_algorithm",
            "page_size",
            "history_retention",
            "pagination_snapshot",
        }
        or not isinstance(journal_resource_id, str)
        or not journal_resource_id
        or not isinstance(apply_journal.get("resource_version"), int)
        or isinstance(apply_journal.get("resource_version"), bool)
        or apply_journal["resource_version"] < 0
        or re.fullmatch(
            r"[a-f0-9]{64}", str(apply_journal.get("semantic_sha256", ""))
        )
        is None
        or apply_journal.get("api_path_prefix")
        != "/v1/effective-authority/apply-journal"
        or apply_journal.get("storage") != "provider-native-durable-multi-az"
        or apply_journal.get("compare_and_swap")
        != "resource-version-required"
        or apply_journal.get("append_only") is not True
        or apply_journal.get("deletion_supported") is not False
        or apply_journal.get("receipt_signing_public_key_sha256")
        != provider_trust_root_sha256
        or apply_journal.get("journal_protocol")
        != _PROVIDER_APPLY_JOURNAL_SCHEMA
        or apply_journal.get("checkpoint_algorithm")
        != "sha256-append-event-chain-v1"
        or apply_journal.get("unresolved_view_algorithm")
        != "sha256-sorted-signed-record-chain-v1"
        or apply_journal.get("page_size")
        != _PROVIDER_APPLY_JOURNAL_PAGE_SIZE
        or apply_journal.get("history_retention")
        != "append-only-unbounded"
        or apply_journal.get("pagination_snapshot")
        != "immutable-checkpoint-cursor"
    ):
        raise DeploymentError(
            "provider apply journal is not immutable, CAS-bound, and root-signed"
        )
    freeze_resource_id = provider_freeze.get("resource_id")
    if not isinstance(freeze_resource_id, str) or not freeze_resource_id:
        raise DeploymentError("provider control-plane freeze has no resource identity")
    authority_access_permit_ids: set[str] = set()
    authority_identities: list[str] = []
    for authority in mutation_authorities:
        if (
            not isinstance(authority, Mapping)
            or set(authority)
            != {
                "principal_id",
                "principal_kind",
                "source_scope_id",
                "role_id",
                "access_permit_id",
                "protected_provider_resources",
                "semantic_sha256",
            }
            or not isinstance(authority.get("principal_id"), str)
            or not authority["principal_id"]
            or authority.get("principal_kind")
            not in {"service-account", "user", "group", "federated-principal"}
            or authority.get("source_scope_id") not in scope_ids
            or not isinstance(authority.get("role_id"), str)
            or not authority["role_id"]
            or not isinstance(authority.get("access_permit_id"), str)
            or not authority["access_permit_id"]
            or not isinstance(authority.get("protected_provider_resources"), list)
            or not authority["protected_provider_resources"]
            or authority["protected_provider_resources"]
            != sorted(set(authority["protected_provider_resources"]))
            or re.fullmatch(
                r"[a-f0-9]{64}", str(authority.get("semantic_sha256", ""))
            )
            is None
        ):
            raise DeploymentError(
                "provider control-plane mutation-authority census is malformed"
            )
        authority_access_permit_ids.add(str(authority["access_permit_id"]))
        authority_identities.append(_json_sha256(authority))
    if authority_identities != sorted(set(authority_identities)):
        raise DeploymentError(
            "provider control-plane mutation-authority census is not unique and sorted"
        )
    if not {
        str(authority["principal_id"]) for authority in mutation_authorities
    }.issubset(set(permit_digests)):
        raise DeploymentError(
            "provider mutation authorities are absent from the complete permit census"
        )

    runtime_fields = {
        "instance_id",
        "measurement_resource_id",
        "measurement_resource_version",
        "release_artifact_sha256",
        "entrypoint_sha256",
        "systemd_unit_sha256",
        "environment_sha256",
        "boot_image_id",
        "boot_image_sha256",
        "process_uid",
        "process_executable_sha256",
        "process_cmdline_sha256",
        "listener_address",
        "listener_port",
        "listener_transport",
        "listener_sha256",
        "provider_attestation_sha256",
        "front_proxy_enabled",
        "tls_termination",
    }
    members_by_id = {
        str(member["member_id"]): member for member in gateway_members
    }
    if set(runtime_measurements) != set(member_ids):
        raise DeploymentError(
            "provider runtime measurements do not cover every gateway member"
        )
    for member_id, measurement in runtime_measurements.items():
        member = members_by_id.get(str(member_id))
        expected_address = str(member.get("listener_address", "")) if member else ""
        expected_port = member.get("listener_port", -1) if member else -1
        if (
            member is None
            or not isinstance(measurement, Mapping)
            or set(measurement) != runtime_fields
            or measurement.get("instance_id") != member["instance"]["id"]
            or not isinstance(measurement.get("measurement_resource_id"), str)
            or not measurement["measurement_resource_id"]
            or not isinstance(measurement.get("measurement_resource_version"), int)
            or isinstance(measurement.get("measurement_resource_version"), bool)
            or measurement["measurement_resource_version"] < 0
            or measurement.get("listener_address") != expected_address
            or measurement.get("listener_port") != expected_port
            or measurement.get("listener_transport") != "tcp"
            or measurement.get("front_proxy_enabled") is not False
            or measurement.get("tls_termination") != "in-process-mutual-tls-1.3"
            or not isinstance(measurement.get("process_uid"), int)
            or isinstance(measurement.get("process_uid"), bool)
            or measurement["process_uid"] <= 0
            or not isinstance(measurement.get("boot_image_id"), str)
            or not measurement["boot_image_id"]
            or any(
                re.fullmatch(r"[a-f0-9]{64}", str(measurement.get(field, "")))
                is None
                for field in {
                    "release_artifact_sha256",
                    "entrypoint_sha256",
                    "systemd_unit_sha256",
                    "environment_sha256",
                    "boot_image_sha256",
                    "process_executable_sha256",
                    "process_cmdline_sha256",
                    "listener_sha256",
                    "provider_attestation_sha256",
                }
            )
        ):
            raise DeploymentError(
                "provider gateway runtime/process/listener measurements are incomplete"
            )

    protected_provider_resources = sorted(
        {
            f"mk8s.cluster/{cluster_id}",
            f"iam.mutation-freeze/{freeze_resource_id}",
            f"iam.signing-material/{signing_resource_id}",
            f"provider.apply-journal/{journal_resource_id}",
            *(
                f"iam.{scope['kind']}/{scope['id']}"
                for scope in scope_chain
            ),
            *(f"compute.instance/{member['instance']['id']}" for member in gateway_members),
            *(f"vpc.security-group/{member['security_group']['id']}" for member in gateway_members),
            *(
                f"vpc.security-rule/{rule['id']}"
                for member in gateway_members
                for rule in member["security_rules"]
            ),
            *(f"iam.service-account/{member['iam_principal_id']}" for member in gateway_members),
            *(
                f"iam.access-permit/{permit['id']}"
                for member in gateway_members
                for permit in member["access_permits"]
            ),
            *(f"iam.access-permit/{permit_id}" for permit_id in authority_access_permit_ids),
            *(
                f"compute.image/{measurement['boot_image_id']}"
                for measurement in runtime_measurements.values()
            ),
            *(
                f"provider.runtime-measurement/{measurement['measurement_resource_id']}"
                for measurement in runtime_measurements.values()
            ),
        }
    )
    protected_provider_resource_prefixes = sorted(
        {
            f"iam.access-permit/{scope_id}/"
            for scope_id in scope_ids
        }
        | {
            f"iam.identity-binding/{scope_id}/"
            for scope_id in scope_ids
        }
        | {
            f"iam.service-account/{scope_id}/"
            for scope_id in scope_ids
        }
        | {
            f"iam.signing-material/{scope_id}/"
            for scope_id in scope_ids
        }
    )
    if any(
        not set(authority["protected_provider_resources"]).issubset(
            protected_provider_resources
        )
        for authority in mutation_authorities
    ):
        raise DeploymentError(
            "provider mutation authority names a resource outside the frozen boundary"
        )
    try:
        provider_freeze_from = datetime.fromisoformat(
            str(provider_freeze["active_from"]).replace("Z", "+00:00")
        )
        provider_freeze_until = datetime.fromisoformat(
            str(provider_freeze["active_until"]).replace("Z", "+00:00")
        )
    except (KeyError, ValueError) as exc:
        raise DeploymentError("provider control-plane freeze time is malformed") from exc
    if (
        set(provider_freeze)
        != {
            "transaction_id",
            "resource_id",
            "resource_version",
            "semantic_sha256",
            "enforcement",
            "allowed_principal_ids",
            "protected_provider_resources",
            "protected_provider_resource_prefixes",
            "self_protection",
            "active_from",
            "active_until",
        }
        or provider_freeze.get("transaction_id") != freeze_transaction_id
        or not isinstance(provider_freeze.get("resource_id"), str)
        or not provider_freeze["resource_id"]
        or not isinstance(provider_freeze.get("resource_version"), int)
        or isinstance(provider_freeze.get("resource_version"), bool)
        or re.fullmatch(
            r"[a-f0-9]{64}", str(provider_freeze.get("semantic_sha256", ""))
        )
        is None
        or provider_freeze.get("enforcement")
        != "provider-control-plane-deny-all-exact-resources-and-scope-collections"
        or provider_freeze.get("allowed_principal_ids") != []
        or provider_freeze.get("protected_provider_resources")
        != protected_provider_resources
        or provider_freeze.get("protected_provider_resource_prefixes")
        != protected_provider_resource_prefixes
        or provider_freeze.get("self_protection")
        != "provider-native-immutable-until-active-until"
        or provider_freeze_from != freeze_active_from
        or provider_freeze_until != freeze_active_until
    ):
        raise DeploymentError(
            "provider control-plane resources are not held by the exact zero-principal freeze"
        )
    observations: list[dict[str, Any]] = []
    observation_request_ids: set[str] = set()
    observation_times: list[datetime] = []
    with ExitStack() as stack:
        credential_fds = {
            name: stack.enter_context(
                _sealed_memfd(f"fs2-provider-authority-{name}", value)
            )
            for name, value in credential_bytes.items()
        }
        inherited_fds = tuple(credential_fds.values())
        exporter_environment = {
            "FS2_PROVIDER_AUTHORITY_API_URL": str(
                snapshot["provider_api_endpoint"]
            ),
            "FS2_PROVIDER_AUTHORITY_API_SERVER_CERT_SHA256": str(
                snapshot["authority_api_server_certificate_sha256"]
            ),
            "FS2_PROVIDER_AUTHORITY_API_CA": (
                f"/proc/self/fd/{credential_fds['authority-ca']}"
            ),
            "FS2_PROVIDER_AUTHORITY_API_CLIENT_CERT": (
                f"/proc/self/fd/{credential_fds['client-certificate']}"
            ),
            "FS2_PROVIDER_AUTHORITY_API_CLIENT_KEY": (
                f"/proc/self/fd/{credential_fds['client-key']}"
            ),
        }
        command = [
            "snapshot",
            "--project-id",
            project_id,
            "--cluster-id",
            cluster_id,
            "--freeze-transaction-id",
            freeze_transaction_id,
            "--output",
            "json",
        ]
        for _index in range(2):
            result = _pinned_custody_command(
                executable_path=exporter_path,
                expected_sha256=exporter_sha256,
                label="provider authority exporter",
                arguments=command,
                environment=exporter_environment,
                timeout=60,
                inherited_fds=inherited_fds,
            )
            try:
                observation = json.loads(result.stdout)
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise DeploymentError(
                    "provider-native authority observation is malformed"
                ) from exc
            if result.returncode != 0 or not isinstance(observation, dict):
                raise DeploymentError(
                    "provider-native authority observation failed closed"
                )
            request_ids = observation.get("provider_request_ids")
            try:
                observation_time = datetime.fromisoformat(
                    str(observation["observed_at"]).replace("Z", "+00:00")
                )
            except (KeyError, ValueError) as exc:
                raise DeploymentError(
                    "provider-native authority observation time is malformed"
                ) from exc
            if (
                set(observation)
                != {
                    "schema",
                    "observed_at",
                    "provider_request_ids",
                    "snapshot",
                    "snapshot_sha256",
                }
                or observation.get("schema")
                != "fs2-serve.nebius.ai/provider-control-plane-authority-observation/v1"
                or observation.get("snapshot") != dict(snapshot)
                or observation.get("snapshot_sha256") != census["snapshot_sha256"]
                or not isinstance(request_ids, list)
                or not request_ids
                or request_ids != sorted(set(request_ids))
                or not all(
                    isinstance(request_id, str) and 1 <= len(request_id) <= 253
                    for request_id in request_ids
                )
                or observation_time.tzinfo is None
                or observation_time > datetime.now(UTC) + timedelta(seconds=30)
                or datetime.now(UTC) - observation_time > timedelta(minutes=2)
                or observation_request_ids.intersection(request_ids)
            ):
                raise DeploymentError(
                    "provider-native authority observation lacks unique live provenance"
                )
            observation_request_ids.update(request_ids)
            observation_times.append(observation_time)
            observations.append(dict(observation["snapshot"]))
    if observations[0] != observations[1] or observation_times[1] < observation_times[0]:
        raise DeploymentError(
            "two provider-native authority observations are not stable and signed-equal"
        )
    return _provider_authority_census_stable_sha256(census)


def _verified_provider_custody(
    *,
    cluster_id: str | None,
    project_id: str,
    nebius: str,
    nebius_profile: str,
    provider_trust_root_sha256: str,
    signature_verifier_sha256: str,
) -> tuple[dict[str, Any], str, datetime]:
    """Verify the independent provider/IAM custody assertion.

    Kubernetes admission cannot match ValidatingAdmissionPolicy or its binding,
    and an in-cluster webhook cannot safely protect its own serving chain.  This
    assertion is therefore signed under a trust root distinct from the receipt
    signer and is a mandatory external prerequisite, not an in-cluster claim.
    """

    paths = {
        "attestation": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_ATTESTATION", "")
        ),
        "signature": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_SIGNATURE", "")
        ),
        "trust root": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_TRUST_ROOT", "")
        ),
    }
    attestation_bytes, attestation_sha256 = _stable_root_file_bytes(
        paths["attestation"],
        label="external provider custody attestation",
        maximum_bytes=_MAX_CUSTODY_DOCUMENT_BYTES,
    )
    signature_bytes, _signature_sha256 = _stable_root_file_bytes(
        paths["signature"],
        label="external provider custody signature",
        maximum_bytes=_MAX_CUSTODY_SIGNATURE_BYTES,
    )
    trust_root_bytes, trust_root_actual_sha256 = _stable_root_file_bytes(
        paths["trust root"],
        label="external provider custody trust root",
        maximum_bytes=_MAX_CUSTODY_DOCUMENT_BYTES,
    )
    if not re.fullmatch(r"[a-f0-9]{64}", provider_trust_root_sha256):
        raise DeploymentError(
            "the root contract must pin the distinct provider custody trust root"
        )
    if trust_root_actual_sha256 != provider_trust_root_sha256:
        raise DeploymentError(
            "the provider custody signing key differs from the root-pinned digest"
        )
    _verify_detached_signature(
        document=attestation_bytes,
        signature=signature_bytes,
        trust_root=trust_root_bytes,
        verifier_sha256=signature_verifier_sha256,
        label="external provider custody",
    )
    try:
        attestation = json.loads(attestation_bytes)
        if not isinstance(attestation, dict):
            raise TypeError("provider attestation is not an object")
        payload = {
            key: value
            for key, value in attestation.items()
            if key != "payload_sha256"
        }
        observed_at = datetime.fromisoformat(
            attestation["observed_at"].replace("Z", "+00:00")
        )
        expires_at = datetime.fromisoformat(
            attestation["expires_at"].replace("Z", "+00:00")
        )
        mutation_freeze = attestation["mutation_freeze"]
        freeze_active_from = datetime.fromisoformat(
            mutation_freeze["active_from"].replace("Z", "+00:00")
        )
        freeze_active_until = datetime.fromisoformat(
            mutation_freeze["active_until"].replace("Z", "+00:00")
        )
    except (KeyError, TypeError, ValueError, json.JSONDecodeError, OSError) as exc:
        raise DeploymentError("the external provider custody assertion is malformed") from exc
    signed_cluster_id = attestation.get("cluster_id")
    if cluster_id is None:
        if (
            not isinstance(signed_cluster_id, str)
            or re.fullmatch(r"mk8scluster-[a-z0-9]+", signed_cluster_id) is None
        ):
            raise DeploymentError("provider custody has no exact managed-cluster identity")
        cluster_id = signed_cluster_id
    now = datetime.now(UTC)
    if (
        attestation.get("schema")
        != "fs2-serve.nebius.ai/model-network-boundary-provider-custody/v8"
        or attestation.get("cluster_id") != cluster_id
        or attestation.get("project_id") != project_id
        or attestation.get("payload_sha256") != _json_sha256(payload)
        or observed_at.tzinfo is None
        or expires_at.tzinfo is None
        or expires_at - observed_at > timedelta(hours=2)
        or observed_at > now + timedelta(seconds=30)
        or not (observed_at <= now < expires_at)
        or not isinstance(mutation_freeze, dict)
        or not isinstance(mutation_freeze.get("transaction_id"), str)
        or re.fullmatch(
            r"[a-z][a-z0-9]{5,31}:[1-9][0-9]*:[a-f0-9]{32}",
            mutation_freeze["transaction_id"],
        )
        is None
        or mutation_freeze.get("enforcement")
        != "deny-all-protected-kubernetes-mutations"
        or mutation_freeze.get("allowed_principal_ids") != []
        or not isinstance(
            mutation_freeze.get("protected_kubernetes_resources"), list
        )
        or len(mutation_freeze["protected_kubernetes_resources"]) < 5
        or len(mutation_freeze["protected_kubernetes_resources"]) > 128
        or not all(
            isinstance(resource, str) and 0 < len(resource) <= 512
            for resource in mutation_freeze["protected_kubernetes_resources"]
        )
        or len(set(mutation_freeze["protected_kubernetes_resources"]))
        != len(mutation_freeze["protected_kubernetes_resources"])
        or mutation_freeze.get("protected_kubernetes_resource_prefixes")
        != [
            "clusterrolebindings.rbac.authorization.k8s.io/_cluster/",
            "clusterroles.rbac.authorization.k8s.io/_cluster/",
            "rolebindings.rbac.authorization.k8s.io/",
            "roles.rbac.authorization.k8s.io/",
        ]
        or freeze_active_from.tzinfo is None
        or freeze_active_until.tzinfo is None
        or freeze_active_from != observed_at
        or freeze_active_until != expires_at
        or not (freeze_active_from <= now < freeze_active_until)
        or freeze_active_until - now < timedelta(minutes=15)
    ):
        raise DeploymentError(
            "the external provider custody assertion is stale or outside its exact cluster contract"
        )
    client_tools = attestation.get("client_tools")
    if (
        not isinstance(client_tools, Mapping)
        or set(client_tools) != {"kubectl", "nebius"}
        or not all(isinstance(tool, Mapping) for tool in client_tools.values())
    ):
        raise DeploymentError("provider custody has no exact signed client-tool inventory")
    nebius_tool = client_tools["nebius"]
    kubectl_tool = client_tools["kubectl"]
    if (
        set(nebius_tool) != {"path", "sha256", "profile", "home_path"}
        or set(kubectl_tool) != {"path", "sha256", "context"}
        or str(Path(nebius)) != nebius_tool.get("path")
        or nebius_profile != nebius_tool.get("profile")
        or not Path(str(nebius_tool.get("path", ""))).is_absolute()
        or not Path(str(kubectl_tool.get("path", ""))).is_absolute()
        or re.fullmatch(r"[a-f0-9]{64}", str(nebius_tool.get("sha256", "")))
        is None
        or re.fullmatch(r"[a-f0-9]{64}", str(kubectl_tool.get("sha256", "")))
        is None
    ):
        raise DeploymentError("provider custody client-tool identity is malformed")
    nebius_home = _root_custody_directory(
        Path(str(nebius_tool.get("home_path", ""))),
        label="signed Nebius CLI home",
        private=True,
    )
    credentials = attestation.get("credentials")
    if (
        not isinstance(credentials, dict)
        or set(credentials)
        != {
            "authorizer",
            "transition",
            "maintenance",
            "auditor",
            "custodian",
            "recovery",
        }
        or any(not isinstance(credential, dict) for credential in credentials.values())
    ):
        raise DeploymentError(
            "the provider assertion must enumerate every separately issued credential"
        )
    credential_epochs: set[str] = set()
    for credential_name, credential in credentials.items():
        if set(credential) != {
            "username",
            "groups",
            "provider_principal_id",
            "kubeconfig_sha256",
            "client_certificate_sha256",
            "issuer_ca_sha256",
            "gateway_server",
            "credential_epoch",
            "not_before",
            "not_after",
        }:
            raise DeploymentError(
                f"provider custody credential {credential_name} is not exact"
            )
        try:
            credential_not_before = datetime.fromisoformat(
                str(credential["not_before"]).replace("Z", "+00:00")
            )
            credential_not_after = datetime.fromisoformat(
                str(credential["not_after"]).replace("Z", "+00:00")
            )
        except (KeyError, ValueError) as exc:
            raise DeploymentError(
                f"provider custody credential {credential_name} validity is malformed"
            ) from exc
        credential_epoch = str(credential.get("credential_epoch", ""))
        if (
            re.fullmatch(r"[a-f0-9]{64}", credential_epoch) is None
            or re.fullmatch(
                r"[a-f0-9]{64}", str(credential.get("kubeconfig_sha256", ""))
            )
            is None
            or credential_epoch in credential_epochs
            or credential_not_before != freeze_active_from
            or credential_not_after != freeze_active_until
        ):
            raise DeploymentError(
                f"provider custody credential {credential_name} is not unique to the active freeze epoch"
            )
        credential_epochs.add(credential_epoch)
    _provider_credential_epochs_sha256(attestation)
    operation_locks = attestation.get("operation_locks")
    expected_gateway_principals = {
        credential.get("client_certificate_sha256"): {
            "principal_id": credential.get("provider_principal_id"),
            "username": credential.get("username"),
            "groups": credential.get("groups"),
            "status_reader": name == "auditor",
            "credential_epoch": credential.get("credential_epoch"),
            "not_before": credential.get("not_before"),
            "not_after": credential.get("not_after"),
        }
        for name, credential in credentials.items()
        if isinstance(credential, dict)
    }
    if (
        len(expected_gateway_principals) != 6
        or None in expected_gateway_principals
        or not all(
            re.fullmatch(r"[a-f0-9]{64}", str(certificate_sha256))
            for certificate_sha256 in expected_gateway_principals
        )
    ):
        raise DeploymentError(
            "provider custody credentials do not define six gateway certificate principals"
        )
    kubernetes_authorization = attestation.get("kubernetes_authorization")
    expected_privileged_certificates = sorted(expected_gateway_principals)
    if (
        not isinstance(kubernetes_authorization, dict)
        or set(kubernetes_authorization)
        != {
            "source_cluster_sha256",
            "authorizers",
            "anonymous_authentication_enabled",
            "static_token_authentication_enabled",
            "legacy_abac_enabled",
            "service_account_issuer",
            "service_account_signing_key_sha256",
            "privileged_client_certificate_sha256",
        }
        or kubernetes_authorization.get("authorizers") != ["Node", "RBAC"]
        or kubernetes_authorization.get("anonymous_authentication_enabled")
        is not False
        or kubernetes_authorization.get("static_token_authentication_enabled")
        is not False
        or kubernetes_authorization.get("legacy_abac_enabled") is not False
        or re.fullmatch(
            r"https://[^\s]+",
            str(kubernetes_authorization.get("service_account_issuer", "")),
        )
        is None
        or not re.fullmatch(
            r"[a-f0-9]{64}",
            str(
                kubernetes_authorization.get(
                    "service_account_signing_key_sha256", ""
                )
            ),
        )
        or kubernetes_authorization.get(
            "privileged_client_certificate_sha256"
        )
        != expected_privileged_certificates
    ):
        raise DeploymentError(
            "provider custody does not prove the closed Node/RBAC control-plane authorizer inventory"
        )
    expected_operation_locks = {
        "leases.coordination.k8s.io/fs2-system/fs2-model-network-transition": {
            "principal_id": credentials["transition"].get("provider_principal_id"),
            "operations": ["PATCH"],
        },
        "leases.coordination.k8s.io/fs2-system/fs2-model-network-maintenance": {
            "principal_id": credentials["maintenance"].get("provider_principal_id"),
            "operations": ["PATCH"],
        },
    }
    if (
        not isinstance(operation_locks, dict)
        or operation_locks.get("enforcement")
        != "provider-gateway-exact-object-resource-version-cas"
        or operation_locks.get("maximum_lease_duration_seconds") != 7200
        or operation_locks.get("delete_allowed") is not False
        or operation_locks.get("create_allowed") is not False
        or operation_locks.get("locks") != expected_operation_locks
    ):
        raise DeploymentError(
            "provider custody must expose the exact non-deletable operation-lock channel"
        )
    gateway = attestation.get("provider_gateway")
    if not isinstance(gateway, dict):
        raise DeploymentError("provider custody has no concrete preventive gateway")
    gateway_members = gateway.get("members")
    member_ids = [
        member.get("member_id")
        for member in gateway_members
        if isinstance(member, dict)
    ] if isinstance(gateway_members, list) else []
    member_cidrs = [
        member.get("host_cidr")
        for member in gateway_members
        if isinstance(member, dict)
    ] if isinstance(gateway_members, list) else []
    provider_inventory = {
        "cluster": {
            "id": gateway.get("cluster_id"),
            "resource_version": gateway.get("cluster_resource_version"),
            "allowed_cidrs": gateway.get("gateway_egress_host_cidrs"),
        },
        "members": gateway_members,
    }
    if (
        gateway.get("direct_control_plane_access")
        != "provider-firewall-exact-hosts-plus-excluded-guard-rbac-closure"
        or gateway.get("cluster_id") != cluster_id
        or not isinstance(gateway.get("cluster_resource_version"), int)
        or isinstance(gateway.get("cluster_resource_version"), bool)
        or gateway["cluster_resource_version"] < 0
        or not isinstance(gateway.get("gateway_egress_host_cidrs"), list)
        or not 2 <= len(gateway["gateway_egress_host_cidrs"]) <= 8
        or len(set(gateway["gateway_egress_host_cidrs"]))
        != len(gateway["gateway_egress_host_cidrs"])
        or gateway["gateway_egress_host_cidrs"]
        != sorted(gateway["gateway_egress_host_cidrs"])
        or not all(_is_exact_host_route(cidr) for cidr in gateway["gateway_egress_host_cidrs"])
        or not isinstance(gateway_members, list)
        or not 2 <= len(gateway_members) <= 8
        or len(member_ids) != len(gateway_members)
        or member_ids != sorted(member_ids)
        or len(member_ids) != len(set(member_ids))
        or member_cidrs != gateway["gateway_egress_host_cidrs"]
        or any(
            not isinstance(member, dict)
            or set(member)
            != {
                "member_id",
                "status_url",
                "host_cidr",
                "listener_address",
                "listener_port",
                "server_certificate_sha256",
                "iam_principal_id",
                "instance",
                "security_group",
                "security_rules",
                "access_permits",
            }
            or not _is_exact_non_loopback_address(member.get("listener_address"))
            or not isinstance(member.get("listener_port"), int)
            or isinstance(member.get("listener_port"), bool)
            or not 1 <= member["listener_port"] <= 65535
            or (lambda parsed: (
                parsed.scheme != "https"
                or not parsed.hostname
                or parsed.path != "/v1/custody/status"
                or bool(parsed.query)
                or bool(parsed.fragment)
            ))(urlsplit(str(member.get("status_url", ""))))
            for member in gateway_members
        )
        or gateway.get("provider_inventory_sha256")
        != _json_sha256(provider_inventory)
        or gateway.get("kubernetes_authorization_sha256")
        != _json_sha256(kubernetes_authorization)
        or gateway.get("provider_authority_census_sha256")
        != _provider_authority_census_stable_sha256(
            attestation.get("provider_authority_census", {})
        )
        or gateway.get("gateway_runtime_measurements_sha256")
        != _json_sha256(
            attestation.get("provider_authority_census", {})
            .get("snapshot", {})
            .get("gateway_runtime_measurements", {})
        )
        or not re.fullmatch(r"[a-f0-9]{64}", str(gateway.get("policy_sha256", "")))
    ):
        raise DeploymentError("provider custody gateway identity is incomplete")

    provider_authority_census_sha256 = _verified_provider_authority_census(
        attestation=attestation,
        cluster_id=cluster_id,
        project_id=project_id,
        provider_trust_root_sha256=provider_trust_root_sha256,
        member_ids=[str(member_id) for member_id in member_ids],
        gateway_members=[
            member for member in gateway_members if isinstance(member, Mapping)
        ],
        freeze_active_from=freeze_active_from,
        freeze_active_until=freeze_active_until,
        freeze_transaction_id=str(mutation_freeze["transaction_id"]),
    )

    def provider_collection(
        arguments: Sequence[str], label: str
    ) -> tuple[list[dict[str, Any]], str]:
        result = _pinned_custody_command(
            executable_path=Path(str(nebius_tool["path"])),
            expected_sha256=str(nebius_tool["sha256"]),
            label="signed Nebius CLI",
            arguments=[
                "--profile",
                nebius_profile,
                *arguments,
                "--all",
                "--format",
                "json",
            ],
            environment={"HOME": nebius_home},
            timeout=30,
        )
        try:
            document = json.loads(result.stdout)
            items = document["items"]
        except (KeyError, TypeError, json.JSONDecodeError) as exc:
            raise DeploymentError(
                f"provider {label} enumeration is malformed"
            ) from exc
        if result.returncode != 0 or not isinstance(items, list) or not all(
            isinstance(item, dict) for item in items
        ):
            raise DeploymentError(f"provider {label} enumeration failed closed")
        semantic_items = sorted(
            items,
            key=lambda item: str(item.get("metadata", {}).get("id", "")),
        )
        ids = [
            item.get("metadata", {}).get("id") for item in semantic_items
        ]
        if any(not isinstance(item_id, str) or not item_id for item_id in ids) or len(ids) != len(set(ids)):
            raise DeploymentError(f"provider {label} enumeration has no unique IDs")
        return semantic_items, _json_sha256(semantic_items)

    def provider_object(
        arguments: Sequence[str], label: str
    ) -> tuple[dict[str, Any], str]:
        result = _pinned_custody_command(
            executable_path=Path(str(nebius_tool["path"])),
            expected_sha256=str(nebius_tool["sha256"]),
            label="signed Nebius CLI",
            arguments=[
                "--profile",
                nebius_profile,
                *arguments,
                "--format",
                "json",
            ],
            environment={"HOME": nebius_home},
            timeout=30,
        )
        try:
            document = json.loads(result.stdout)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise DeploymentError(f"provider {label} read is malformed") from exc
        if result.returncode != 0 or not isinstance(document, dict):
            raise DeploymentError(f"provider {label} read failed closed")
        return document, _json_sha256(document)

    project, project_sha256 = provider_object(
        ["iam", "project", "get", "--id", project_id],
        "project",
    )
    cluster, cluster_sha256 = provider_object(
        ["mk8s", "cluster", "get", "--id", cluster_id],
        "managed Kubernetes cluster",
    )
    if (
        project.get("metadata", {}).get("id") != project_id
        or cluster.get("metadata", {}).get("id") != cluster_id
        or cluster.get("metadata", {}).get("parent_id") != project_id
    ):
        raise DeploymentError(
            "provider project/cluster provenance differs from the custody target"
        )

    instances, instances_sha256 = provider_collection(
        ["compute", "instance", "list", "--parent-id", project_id],
        "gateway instance",
    )
    security_groups, security_groups_sha256 = provider_collection(
        ["vpc", "security-group", "list", "--parent-id", project_id],
        "gateway security-group",
    )
    service_accounts, service_accounts_sha256 = provider_collection(
        ["iam", "service-account", "list", "--parent-id", project_id],
        "gateway service account",
    )
    instances_by_id = {
        item["metadata"]["id"]: item for item in instances
    }
    security_groups_by_id = {
        item["metadata"]["id"]: item for item in security_groups
    }
    service_accounts_by_id = {
        item["metadata"]["id"]: item for item in service_accounts
    }
    declared_instance_ids = sorted(member["instance"]["id"] for member in gateway_members)
    declared_security_group_ids = sorted(
        member["security_group"]["id"] for member in gateway_members
    )
    declared_principal_ids = sorted(
        member["iam_principal_id"] for member in gateway_members
    )
    allowed_gateway_addresses = {
        str(ipaddress.ip_network(cidr, strict=True).network_address)
        for cidr in gateway["gateway_egress_host_cidrs"]
    }
    discovered_instance_ids = sorted(
        item["metadata"]["id"]
        for item in instances
        if any(
            str(interface.get("public_ip_address", {}).get("address", ""))
            in allowed_gateway_addresses
            for interface in item.get("status", {}).get("network_interfaces", [])
            if isinstance(interface, dict)
            and isinstance(interface.get("public_ip_address"), dict)
        )
    )
    discovered_gateway_addresses = sorted(
        str(interface.get("public_ip_address", {}).get("address", ""))
        for item in instances
        for interface in item.get("status", {}).get("network_interfaces", [])
        if isinstance(interface, dict)
        and isinstance(interface.get("public_ip_address"), dict)
        and str(interface.get("public_ip_address", {}).get("address", ""))
        in allowed_gateway_addresses
    )
    discovered_security_group_ids = declared_security_group_ids
    discovered_principal_ids = sorted(
        str(instances_by_id[instance_id].get("spec", {}).get("service_account_id", ""))
        for instance_id in declared_instance_ids
        if instance_id in instances_by_id
    )
    if (
        declared_instance_ids != discovered_instance_ids
        or discovered_gateway_addresses != sorted(allowed_gateway_addresses)
        or declared_security_group_ids != discovered_security_group_ids
        or declared_principal_ids != discovered_principal_ids
        or len(declared_principal_ids) != len(set(declared_principal_ids))
    ):
        raise DeploymentError(
            "declared gateway members do not equal every provider instance owning an exact live API-allowlist address"
        )
    security_rule_hashes: dict[str, str] = {}
    access_permit_hashes: dict[str, str] = {}
    for member in gateway_members:
        instance_id = member["instance"]["id"]
        security_group_id = member["security_group"]["id"]
        principal_id = member["iam_principal_id"]
        instance = instances_by_id.get(instance_id)
        service_account = service_accounts_by_id.get(principal_id)
        security_group = security_groups_by_id.get(security_group_id)
        if instance is None or security_group is None or service_account is None:
            raise DeploymentError(
                f"provider gateway member {member['member_id']} is absent from authoritative project enumeration"
            )
        expected_objects = (
            (instance, member["instance"], "instance"),
            (security_group, member["security_group"], "security group"),
        )
        for live_object, claimed_object, object_label in expected_objects:
            if (
                live_object.get("metadata", {}).get("resource_version")
                != claimed_object.get("resource_version")
                or _json_sha256(live_object) != claimed_object.get("semantic_sha256")
            ):
                raise DeploymentError(
                    f"provider gateway member {member['member_id']} {object_label} differs from the signed full-object projection"
                )
        public_addresses = sorted(
            str(interface.get("public_ip_address", {}).get("address", ""))
            for interface in instance.get("status", {}).get("network_interfaces", [])
            if isinstance(interface, dict)
            and isinstance(interface.get("public_ip_address"), dict)
            and interface.get("public_ip_address", {}).get("address")
        )
        if str(ipaddress.ip_network(member["host_cidr"], strict=True).network_address) not in public_addresses:
            raise DeploymentError(
                f"provider gateway member {member['member_id']} host route is not a live instance address"
            )
        if instance.get("spec", {}).get("service_account_id") != principal_id:
            raise DeploymentError(
                f"provider gateway member {member['member_id']} IAM principal differs from its live instance"
            )
        rules, rule_sha256 = provider_collection(
            ["vpc", "security-rule", "list", "--parent-id", security_group_id],
            f"security rules for {member['member_id']}",
        )
        rule_ids = sorted(item["metadata"]["id"] for item in rules)
        if rule_ids != sorted(item["id"] for item in member["security_rules"]):
            raise DeploymentError(
                f"provider gateway member {member['member_id']} has undeclared or missing firewall rules"
            )
        rule_claims = {item["id"]: item for item in member["security_rules"]}
        if any(
            rule.get("metadata", {}).get("resource_version")
            != rule_claims[rule["metadata"]["id"]].get("resource_version")
            or _json_sha256(rule)
            != rule_claims[rule["metadata"]["id"]].get("semantic_sha256")
            for rule in rules
        ):
            raise DeploymentError(
                f"provider gateway member {member['member_id']} firewall rule semantics drifted"
            )
        security_rule_hashes[security_group_id] = rule_sha256
        permits, permit_sha256 = provider_collection(
            ["iam", "access-permit", "list", "--parent-id", principal_id],
            f"IAM access permits for {member['member_id']}",
        )
        permit_ids = sorted(item["metadata"]["id"] for item in permits)
        if permit_ids != sorted(item["id"] for item in member["access_permits"]):
            raise DeploymentError(
                f"provider gateway member {member['member_id']} has undeclared or missing IAM permits"
            )
        permit_claims = {item["id"]: item for item in member["access_permits"]}
        if any(
            permit.get("metadata", {}).get("resource_version")
            != permit_claims[permit["metadata"]["id"]].get("resource_version")
            or _json_sha256(permit)
            != permit_claims[permit["metadata"]["id"]].get("semantic_sha256")
            for permit in permits
        ):
            raise DeploymentError(
                f"provider gateway member {member['member_id']} IAM permit semantics drifted"
            )
        access_permit_hashes[principal_id] = permit_sha256
    live_provider_enumeration = {
        "project_id": project_id,
        "project_sha256": project_sha256,
        "cluster_sha256": cluster_sha256,
        "instances_sha256": instances_sha256,
        "security_groups_sha256": security_groups_sha256,
        "service_accounts_sha256": service_accounts_sha256,
        "security_rules_sha256": dict(sorted(security_rule_hashes.items())),
        "access_permits_sha256": dict(sorted(access_permit_hashes.items())),
    }
    if attestation.get("provider_enumeration") != live_provider_enumeration:
        raise DeploymentError(
            "signed provider inventory differs from authoritative provider/IAM enumeration"
        )
    if kubernetes_authorization.get("source_cluster_sha256") != cluster_sha256:
        raise DeploymentError(
            "control-plane authorization evidence is not bound to the live provider cluster object"
        )
    gateway_paths = {
        "CA": Path(os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_GATEWAY_CA", "")),
        "client certificate": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_GATEWAY_CLIENT_CERT", "")
        ),
        "client key": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_PROVIDER_GATEWAY_CLIENT_KEY", "")
        ),
    }
    gateway_credential_bytes = {
        label: _stable_root_file_bytes(
            path,
            label=f"provider custody gateway {label}",
            maximum_bytes=_MAX_CUSTODY_DOCUMENT_BYTES,
            private=True,
        )[0]
        for label, path in gateway_paths.items()
    }
    try:
        ca_text = gateway_credential_bytes["CA"].decode("ascii", errors="strict")
    except UnicodeDecodeError as exc:
        raise DeploymentError("provider custody gateway CA is not exact PEM") from exc
    normalized_gateway_certificate = _pinned_signature_verifier(
        ["x509-der"],
        expected_sha256=signature_verifier_sha256,
        input_bytes=gateway_credential_bytes["client certificate"],
    )
    if (
        normalized_gateway_certificate.returncode != 0
        or hashlib.sha256(normalized_gateway_certificate.stdout).hexdigest()
        != attestation["credentials"]["auditor"].get(
            "client_certificate_sha256"
        )
        or hashlib.sha256(gateway_credential_bytes["CA"]).hexdigest()
        != attestation["credentials"]["auditor"].get(
            "issuer_ca_sha256"
        )
    ):
        raise DeploymentError(
            "provider gateway mTLS material differs from the signed auditor epoch"
        )
    ssl_context = ssl.create_default_context(cadata=ca_text)
    with ExitStack() as gateway_stack:
        certificate_fd = gateway_stack.enter_context(
            _sealed_memfd(
                "fs2-provider-gateway-client-certificate",
                gateway_credential_bytes["client certificate"],
            )
        )
        key_fd = gateway_stack.enter_context(
            _sealed_memfd(
                "fs2-provider-gateway-client-key",
                gateway_credential_bytes["client key"],
            )
        )
        ssl_context.load_cert_chain(
            f"/proc/self/fd/{certificate_fd}",
            f"/proc/self/fd/{key_fd}",
        )
    for member in gateway_members:
        parsed_status_url = urlsplit(str(member["status_url"]))
        try:
            with socket.create_connection(
                (str(parsed_status_url.hostname), parsed_status_url.port or 443),
                timeout=5,
            ) as connection:
                with ssl_context.wrap_socket(
                    connection,
                    server_hostname=str(parsed_status_url.hostname),
                ) as tls_connection:
                    peer_certificate = tls_connection.getpeercert(binary_form=True)
        except OSError as exc:
            raise DeploymentError(
                f"provider custody gateway member {member['member_id']} TLS peer is unavailable"
            ) from exc
        if (
            not peer_certificate
            or hashlib.sha256(peer_certificate).hexdigest()
            != member.get("server_certificate_sha256")
        ):
            raise DeploymentError(
                f"provider custody gateway member {member['member_id']} serving certificate is not the signed leaf"
            )
        challenge = secrets.token_hex(32)
        request_body = json.dumps(
            {"challenge": challenge, "cluster_id": cluster_id},
            sort_keys=True,
            separators=(",", ":"),
        ).encode()
        try:
            with urlopen(
                Request(
                    str(member["status_url"]),
                    data=request_body,
                    method="POST",
                    headers={"Content-Type": "application/json"},
                ),
                context=ssl_context,
                timeout=5,
            ) as response:
                if response.status != 200 or response.headers.get_content_type() != "application/json":
                    raise DeploymentError("provider custody gateway status failed closed")
                live_status = json.loads(response.read(262_145))
        except (OSError, ValueError, json.JSONDecodeError) as exc:
            raise DeploymentError(
                f"provider custody gateway member {member['member_id']} is unavailable"
            ) from exc
        expected_live_status = {
            "schema": "fs2-serve.nebius.ai/model-network-provider-gateway-status/v4",
            "challenge": challenge,
            "cluster_id": cluster_id,
            "policy_id": attestation.get("policy_id"),
            "policy_revision": attestation.get("policy_revision"),
            "policy_sha256": gateway.get("policy_sha256"),
            "member_id": member["member_id"],
            "member": member,
            "provider_inventory_sha256": gateway.get("provider_inventory_sha256"),
            "kubernetes_authorization_sha256": gateway.get(
                "kubernetes_authorization_sha256"
            ),
            "provider_authority_census_sha256": provider_authority_census_sha256,
            "gateway_runtime_measurements_sha256": gateway.get(
                "gateway_runtime_measurements_sha256"
            ),
            "gateway_members": gateway_members,
            "cluster_resource_version": gateway.get("cluster_resource_version"),
            "control_plane_allowed_cidrs": gateway.get("gateway_egress_host_cidrs"),
            "direct_control_plane_access": "provider-firewall-exact-hosts-plus-excluded-guard-rbac-closure",
            "principal_bindings": dict(sorted(expected_gateway_principals.items())),
            "mutation_freeze": mutation_freeze,
            "operation_locks": operation_locks,
        }
        if live_status != expected_live_status:
            raise DeploymentError(
                f"live provider custody gateway member {member['member_id']} differs from the signed full inventory"
            )
    return attestation, attestation_sha256, freeze_active_until


def _provider_operation_settlement(
    *,
    attestation: Mapping[str, Any],
    marker: Mapping[str, Any],
    deadline: datetime,
) -> dict[str, Any]:
    """Wait for an aborted apply's complete provider operation set to settle."""

    census = attestation.get("provider_authority_census")
    exporter = census.get("exporter") if isinstance(census, Mapping) else None
    snapshot = census.get("snapshot") if isinstance(census, Mapping) else None
    if not isinstance(exporter, Mapping) or not isinstance(snapshot, Mapping):
        raise DeploymentError(
            "fresh provider custody has no settlement-capable authority exporter"
        )
    exporter_path = Path(str(exporter.get("path", "")))
    exporter_bytes, exporter_sha256 = _stable_root_file_bytes(
        exporter_path,
        label="provider operation-settlement exporter",
        maximum_bytes=_MAX_CUSTODY_EXECUTABLE_BYTES,
    )
    _require_static_elf(
        exporter_bytes, label="provider operation-settlement exporter"
    )
    credential_bytes: dict[str, bytes] = {}
    for name, path_field, digest_field in (
        ("authority-ca", "authority_ca_path", "authority_ca_sha256"),
        ("client-certificate", "client_certificate_path", "client_certificate_sha256"),
        ("client-key", "client_key_path", "client_key_sha256"),
    ):
        captured, digest = _stable_root_file_bytes(
            Path(str(exporter.get(path_field, ""))),
            label=f"provider operation-settlement {name}",
            maximum_bytes=_MAX_CUSTODY_DOCUMENT_BYTES,
            private=True,
        )
        if digest != exporter.get(digest_field):
            raise DeploymentError(
                f"provider operation-settlement {name} differs from fresh custody"
            )
        credential_bytes[name] = captured
    expected_keys = {
        "schema",
        "observed_at",
        "provider_request_ids",
        "provider_response_sha256",
        "project_id",
        "cluster_id",
        "aborted_freeze_transaction_id",
        "apply_id",
        "started_at",
        "credential_epochs_sha256",
        "correlation",
        "accepted_operations",
        "active_operation_ids",
        "completeness",
        "observation_sha256",
    }
    previous_terminal: dict[str, Any] | None = None
    with ExitStack() as stack:
        credential_fds = {
            name: stack.enter_context(
                _sealed_memfd(f"fs2-provider-settlement-{name}", value)
            )
            for name, value in credential_bytes.items()
        }
        inherited_fds = tuple(credential_fds.values())
        exporter_environment = {
            "FS2_PROVIDER_AUTHORITY_API_URL": str(
                snapshot["provider_api_endpoint"]
            ),
            "FS2_PROVIDER_AUTHORITY_API_SERVER_CERT_SHA256": str(
                snapshot["authority_api_server_certificate_sha256"]
            ),
            "FS2_PROVIDER_AUTHORITY_API_CA": (
                f"/proc/self/fd/{credential_fds['authority-ca']}"
            ),
            "FS2_PROVIDER_AUTHORITY_API_CLIENT_CERT": (
                f"/proc/self/fd/{credential_fds['client-certificate']}"
            ),
            "FS2_PROVIDER_AUTHORITY_API_CLIENT_KEY": (
                f"/proc/self/fd/{credential_fds['client-key']}"
            ),
        }
        command = [
            "settlement",
            "--project-id",
            str(marker["project_id"]),
            "--cluster-id",
            str(marker["cluster_id"]),
            "--aborted-freeze-transaction-id",
            str(marker["custody_transaction_id"]),
            "--apply-id",
            str(marker["apply_id"]),
            "--started-at",
            str(marker["started_at"]),
            "--credential-epochs-sha256",
            str(marker["credential_epochs_sha256"]),
            "--output",
            "json",
        ]
        while datetime.now(UTC) < deadline:
            result = _pinned_custody_command(
                executable_path=exporter_path,
                expected_sha256=exporter_sha256,
                label="provider operation-settlement exporter",
                arguments=command,
                environment=exporter_environment,
                timeout=60,
                inherited_fds=inherited_fds,
            )
            try:
                observation = json.loads(result.stdout)
                observed_at = datetime.fromisoformat(
                    str(observation["observed_at"]).replace("Z", "+00:00")
                )
            except (KeyError, TypeError, ValueError, UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise DeploymentError(
                    "provider operation-settlement observation is malformed"
                ) from exc
            operations = observation.get("accepted_operations")
            active_ids = observation.get("active_operation_ids")
            completeness = observation.get("completeness")
            request_ids = observation.get("provider_request_ids")
            operation_ids = [
                operation.get("operation_id")
                for operation in operations
                if isinstance(operation, Mapping)
            ] if isinstance(operations, list) else []
            semantic = {
                key: value
                for key, value in observation.items()
                if key
                not in {
                    "observed_at",
                    "provider_request_ids",
                    "provider_response_sha256",
                    "observation_sha256",
                }
            } if isinstance(observation, dict) else {}
            semantic_completeness = semantic.get("completeness")
            if isinstance(semantic_completeness, dict):
                semantic_completeness = dict(semantic_completeness)
                semantic_completeness.pop("audit_log_closed_through", None)
                semantic["completeness"] = semantic_completeness
            if (
                result.returncode != 0
                or not isinstance(observation, dict)
                or set(observation) != expected_keys
                or observation.get("schema")
                != "fs2-serve.nebius.ai/provider-operation-settlement-observation/v1"
                or observation.get("project_id") != marker.get("project_id")
                or observation.get("cluster_id") != marker.get("cluster_id")
                or observation.get("aborted_freeze_transaction_id")
                != marker.get("custody_transaction_id")
                or observation.get("apply_id") != marker.get("apply_id")
                or observation.get("started_at") != marker.get("started_at")
                or observation.get("credential_epochs_sha256")
                != marker.get("credential_epochs_sha256")
                or observation.get("correlation")
                != "provider-audit-log-exact-user-agent-and-credential-epoch"
                or observed_at.tzinfo is None
                or observed_at > datetime.now(UTC) + timedelta(seconds=30)
                or datetime.now(UTC) - observed_at > timedelta(minutes=2)
                or not isinstance(request_ids, list)
                or not request_ids
                or request_ids != sorted(set(request_ids))
                or not all(
                    isinstance(request_id, str) and 1 <= len(request_id) <= 253
                    for request_id in request_ids
                )
                or re.fullmatch(
                    r"[a-f0-9]{64}",
                    str(observation.get("provider_response_sha256", "")),
                )
                is None
                or not isinstance(operations, list)
                or operation_ids != sorted(set(operation_ids))
                or not isinstance(active_ids, list)
                or active_ids != sorted(set(active_ids))
                or not set(active_ids).issubset(set(operation_ids))
                or not isinstance(completeness, Mapping)
                or completeness
                != {
                    "all_accepted_operations_enumerated": True,
                    "all_credential_epochs_included": True,
                    "all_services_included": True,
                    "audit_log_closed_through": observation.get("observed_at"),
                }
                or observation.get("observation_sha256") != _json_sha256(semantic)
            ):
                raise DeploymentError(
                    "provider operation settlement is incomplete or outside the aborted apply"
                )
            for operation in operations:
                if not isinstance(operation, Mapping):
                    raise DeploymentError(
                        "provider operation settlement contains a malformed operation"
                    )
                try:
                    accepted_at = datetime.fromisoformat(
                        str(operation["accepted_at"]).replace("Z", "+00:00")
                    )
                    terminal_at = (
                        datetime.fromisoformat(
                            str(operation["terminal_at"]).replace("Z", "+00:00")
                        )
                        if operation.get("terminal_at") is not None
                        else None
                    )
                except (KeyError, ValueError) as exc:
                    raise DeploymentError(
                        "provider operation settlement time is malformed"
                    ) from exc
                operation_is_active = operation.get("operation_id") in active_ids
                if (
                    set(operation)
                    != {
                        "operation_id",
                        "service",
                        "target_resource_id",
                        "accepted_at",
                        "terminal_at",
                        "terminal_status",
                        "semantic_sha256",
                    }
                    or not isinstance(operation.get("operation_id"), str)
                    or not operation["operation_id"]
                    or not isinstance(operation.get("service"), str)
                    or not operation["service"]
                    or not isinstance(operation.get("target_resource_id"), str)
                    or not operation["target_resource_id"]
                    or re.fullmatch(
                        r"[a-f0-9]{64}", str(operation.get("semantic_sha256", ""))
                    )
                    is None
                    or accepted_at.tzinfo is None
                    or accepted_at < datetime.fromisoformat(
                        str(marker["started_at"]).replace("Z", "+00:00")
                    )
                    or accepted_at > observed_at
                    or (
                        operation_is_active
                        and (
                            operation.get("terminal_status") != "ACTIVE"
                            or terminal_at is not None
                        )
                    )
                    or (
                        not operation_is_active
                        and (
                            operation.get("terminal_status")
                            not in {"SUCCEEDED", "FAILED", "CANCELLED"}
                            or terminal_at is None
                            or terminal_at.tzinfo is None
                            or terminal_at < accepted_at
                            or terminal_at > observed_at
                        )
                    )
                ):
                    raise DeploymentError(
                        "provider operation settlement contains a malformed operation"
                    )
            if active_ids:
                previous_terminal = None
                time.sleep(5)
                continue
            if previous_terminal == semantic:
                return observation
            previous_terminal = semantic
            time.sleep(5)
    raise DeploymentError(
        "provider operations did not reach two stable terminal observations before custody expiry"
    )


def _provider_apply_journal_operation(
    *,
    attestation: Mapping[str, Any],
    operation: str,
    request_document: Mapping[str, Any],
    provider_trust_root_sha256: str,
    signature_verifier_sha256: str,
) -> dict[str, Any]:
    """Perform one provider-native append-only apply-journal CAS operation."""

    if (
        operation not in {"observe", "begin", "resolve"}
        or request_document.get("schema")
        != _PROVIDER_APPLY_JOURNAL_REQUEST_SCHEMA
        or request_document.get("operation") != operation
    ):
        raise DeploymentError("provider apply-journal request is not exact")
    if operation == "observe":
        cursor = request_document.get("cursor")
        expected_checkpoint_sha256 = request_document.get(
            "expected_checkpoint_sha256"
        )
        if (
            set(request_document)
            != {
                "schema",
                "operation",
                "view",
                "cursor",
                "expected_checkpoint_sha256",
                "page_size",
            }
            or request_document.get("view") != "unresolved"
            or request_document.get("page_size")
            != _PROVIDER_APPLY_JOURNAL_PAGE_SIZE
            or (
                cursor is not None
                and (
                    not isinstance(cursor, str)
                    or re.fullmatch(r"[A-Za-z0-9_-]{16,512}", cursor) is None
                )
            )
            or (
                expected_checkpoint_sha256 is not None
                and re.fullmatch(
                    r"[a-f0-9]{64}", str(expected_checkpoint_sha256)
                )
                is None
            )
        ):
            raise DeploymentError("provider journal observe request is not exact")
    elif operation == "begin":
        marker = request_document.get("marker")
        expected_marker_keys = {
            "schema",
            "apply_id",
            "stage",
            "saved_plan_name",
            "saved_plan_sha256",
            "target_postconditions_sha256",
            "source_commit",
            "source_tree",
            "project_id",
            "cluster_id",
            "custody_transaction_id",
            "credential_epochs_sha256",
            "started_at",
            "remote_outcome",
        }
        try:
            started_at = datetime.fromisoformat(
                str(marker["started_at"]).replace("Z", "+00:00")
            )
        except (KeyError, TypeError, ValueError) as exc:
            raise DeploymentError("provider journal begin time is malformed") from exc
        if (
            set(request_document)
            != {
                "schema",
                "operation",
                "expected_journal_resource_version",
                "expected_checkpoint_sha256",
                "marker",
            }
            or not isinstance(marker, Mapping)
            or set(marker) != expected_marker_keys
            or marker.get("schema") != _INDETERMINATE_APPLY_SCHEMA
            or re.fullmatch(r"[a-f0-9]{32}", str(marker.get("apply_id", "")))
            is None
            or marker.get("stage")
            not in {"configuration", "infrastructure", "foundation", "workloads"}
            or re.fullmatch(
                r"(?:0|[1-9][0-9]*)",
                str(request_document.get("expected_journal_resource_version", "")),
            )
            is None
            or re.fullmatch(
                r"[a-f0-9]{64}",
                str(request_document.get("expected_checkpoint_sha256", "")),
            )
            is None
            or any(
                re.fullmatch(r"[a-f0-9]{64}", str(marker.get(field, ""))) is None
                for field in {
                    "saved_plan_sha256",
                    "target_postconditions_sha256",
                    "credential_epochs_sha256",
                }
            )
            or any(
                re.fullmatch(r"[a-f0-9]{40}", str(marker.get(field, ""))) is None
                for field in {"source_commit", "source_tree"}
            )
            or re.fullmatch(
                r"[a-z][a-z0-9]{5,31}:[1-9][0-9]*:[a-f0-9]{32}",
                str(marker.get("custody_transaction_id", "")),
            )
            is None
            or started_at.tzinfo is None
            or started_at > datetime.now(UTC) + timedelta(seconds=30)
            or marker.get("remote_outcome") != "pending-or-indeterminate"
        ):
            raise DeploymentError("provider journal begin request is not exact")
    else:
        resolution = request_document.get("resolution")
        expected_resolution_keys = {
            "schema",
            "resolution_kind",
            "resolution_custody_transaction_id",
            "provider_settlement_sha256",
            "refresh_plan_sha256",
            "refreshed_state_projection_sha256",
            "target_postconditions_sha256",
            "remote_operations_terminal",
            "target_postconditions_satisfied",
            "custody_valid_until",
        }
        try:
            valid_until = datetime.fromisoformat(
                str(resolution["custody_valid_until"]).replace("Z", "+00:00")
            )
        except (KeyError, TypeError, ValueError) as exc:
            raise DeploymentError(
                "provider journal resolution validity is malformed"
            ) from exc
        if (
            set(request_document)
            != {
                "schema",
                "operation",
                "expected_journal_resource_version",
                "expected_checkpoint_sha256",
                "apply_id",
                "marker_sha256",
                "resolution",
            }
            or not isinstance(resolution, Mapping)
            or set(resolution) != expected_resolution_keys
            or resolution.get("schema") != _INDETERMINATE_RESOLUTION_SCHEMA
            or resolution.get("resolution_kind")
            not in {"normal-completion", "fresh-recovery"}
            or re.fullmatch(
                r"[a-z][a-z0-9]{5,31}:[1-9][0-9]*:[a-f0-9]{32}",
                str(resolution.get("resolution_custody_transaction_id", "")),
            )
            is None
            or re.fullmatch(
                r"[1-9][0-9]*",
                str(request_document.get("expected_journal_resource_version", "")),
            )
            is None
            or re.fullmatch(
                r"[a-f0-9]{64}",
                str(request_document.get("expected_checkpoint_sha256", "")),
            )
            is None
            or re.fullmatch(
                r"[a-f0-9]{32}", str(request_document.get("apply_id", ""))
            )
            is None
            or re.fullmatch(
                r"[a-f0-9]{64}", str(request_document.get("marker_sha256", ""))
            )
            is None
            or any(
                re.fullmatch(
                    r"[a-f0-9]{64}", str(resolution.get(field, ""))
                )
                is None
                for field in {
                    "provider_settlement_sha256",
                    "refresh_plan_sha256",
                    "refreshed_state_projection_sha256",
                    "target_postconditions_sha256",
                }
            )
            or resolution.get("remote_operations_terminal") is not True
            or resolution.get("target_postconditions_satisfied") is not True
            or valid_until.tzinfo is None
            or valid_until <= datetime.now(UTC)
        ):
            raise DeploymentError("provider journal resolution request is not exact")
    project_id = str(attestation.get("project_id", ""))
    cluster_id = str(attestation.get("cluster_id", ""))
    if operation == "begin" and (
        request_document["marker"].get("project_id") != project_id
        or request_document["marker"].get("cluster_id") != cluster_id
    ):
        raise DeploymentError(
            "provider journal marker differs from the attested project or cluster"
        )
    census = attestation.get("provider_authority_census")
    exporter = census.get("exporter") if isinstance(census, Mapping) else None
    snapshot = census.get("snapshot") if isinstance(census, Mapping) else None
    if (
        re.fullmatch(r"project-[a-z0-9]+", project_id) is None
        or re.fullmatch(r"mk8scluster-[a-z0-9]+", cluster_id) is None
        or not isinstance(exporter, Mapping)
        or not isinstance(snapshot, Mapping)
    ):
        raise DeploymentError(
            "fresh provider custody has no apply-journal-capable authority exporter"
        )
    exporter_path = Path(str(exporter.get("path", "")))
    exporter_bytes, exporter_sha256 = _stable_root_file_bytes(
        exporter_path,
        label="provider apply-journal exporter",
        maximum_bytes=_MAX_CUSTODY_EXECUTABLE_BYTES,
    )
    _require_static_elf(exporter_bytes, label="provider apply-journal exporter")
    credential_bytes: dict[str, bytes] = {}
    for name, path_field, digest_field in (
        ("authority-ca", "authority_ca_path", "authority_ca_sha256"),
        ("client-certificate", "client_certificate_path", "client_certificate_sha256"),
        ("client-key", "client_key_path", "client_key_sha256"),
    ):
        captured, digest = _stable_root_file_bytes(
            Path(str(exporter.get(path_field, ""))),
            label=f"provider apply-journal {name}",
            maximum_bytes=_MAX_CUSTODY_DOCUMENT_BYTES,
            private=True,
        )
        if digest != exporter.get(digest_field):
            raise DeploymentError(
                f"provider apply-journal {name} differs from fresh custody"
            )
        credential_bytes[name] = captured
    encoded_request = json.dumps(
        request_document, sort_keys=True, separators=(",", ":")
    ).encode()
    with ExitStack() as stack:
        credential_fds = {
            name: stack.enter_context(
                _sealed_memfd(f"fs2-provider-journal-{name}", value)
            )
            for name, value in credential_bytes.items()
        }
        request_fd = stack.enter_context(
            _sealed_memfd("fs2-provider-journal-request", encoded_request)
        )
        inherited_fds = (*credential_fds.values(), request_fd)
        result = _pinned_custody_command(
            executable_path=exporter_path,
            expected_sha256=exporter_sha256,
            label="provider apply-journal exporter",
            arguments=[
                "journal",
                "--operation",
                operation,
                "--project-id",
                project_id,
                "--cluster-id",
                cluster_id,
                "--output",
                "json",
            ],
            environment={
                "FS2_PROVIDER_AUTHORITY_API_URL": str(
                    snapshot["provider_api_endpoint"]
                ),
                "FS2_PROVIDER_AUTHORITY_API_SERVER_CERT_SHA256": str(
                    snapshot["authority_api_server_certificate_sha256"]
                ),
                "FS2_PROVIDER_AUTHORITY_API_CA": (
                    f"/proc/self/fd/{credential_fds['authority-ca']}"
                ),
                "FS2_PROVIDER_AUTHORITY_API_CLIENT_CERT": (
                    f"/proc/self/fd/{credential_fds['client-certificate']}"
                ),
                "FS2_PROVIDER_AUTHORITY_API_CLIENT_KEY": (
                    f"/proc/self/fd/{credential_fds['client-key']}"
                ),
                "FS2_PROVIDER_APPLY_JOURNAL_REQUEST": f"/proc/self/fd/{request_fd}",
            },
            timeout=60,
            inherited_fds=inherited_fds,
        )
    try:
        observation = json.loads(result.stdout)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError(
            "provider apply-journal observation is not JSON"
        ) from exc
    if result.returncode != 0 or not isinstance(observation, dict):
        raise DeploymentError("provider apply-journal operation failed closed")
    return _verified_provider_apply_journal(
        observation,
        action=operation,
        request_document=request_document,
        project_id=project_id,
        cluster_id=cluster_id,
        provider_trust_root_sha256=provider_trust_root_sha256,
        signature_verifier_sha256=signature_verifier_sha256,
    )


def _decode_kubeconfig_data(value: Any, label: str) -> bytes:
    if not isinstance(value, str) or not value:
        raise DeploymentError(f"the kubeconfig has no embedded {label}")
    try:
        decoded = base64.b64decode(value, validate=True)
    except (ValueError, binascii.Error) as exc:
        raise DeploymentError(f"the kubeconfig {label} is not strict base64") from exc
    if not decoded:
        raise DeploymentError(f"the kubeconfig {label} is empty")
    return decoded


def _pinned_kubectl_command(
    *,
    kubectl: str,
    tool: Mapping[str, Any],
    arguments: Sequence[str],
    expected_kubeconfig_sha256: str,
    timeout: int = 30,
) -> subprocess.CompletedProcess[bytes]:
    if (
        set(tool) != {"path", "sha256", "context"}
        or str(Path(kubectl)) != tool.get("path")
        or re.fullmatch(r"[a-f0-9]{64}", expected_kubeconfig_sha256) is None
    ):
        raise DeploymentError("kubectl differs from the provider-signed tool path")
    exact_arguments = list(arguments)
    if exact_arguments.count("--context") != 1:
        raise DeploymentError("provider-signed kubectl requires one exact context")
    context_index = exact_arguments.index("--context")
    if (
        context_index + 1 >= len(exact_arguments)
        or exact_arguments[context_index + 1] != tool.get("context")
    ):
        raise DeploymentError("kubectl context differs from provider-signed custody")
    if exact_arguments.count("--kubeconfig") != 1:
        raise DeploymentError("provider-signed kubectl requires one exact kubeconfig")
    kubeconfig_index = exact_arguments.index("--kubeconfig") + 1
    if kubeconfig_index >= len(exact_arguments):
        raise DeploymentError("provider-signed kubectl kubeconfig is absent")
    kubeconfig_bytes, kubeconfig_sha256 = _stable_root_file_bytes(
        Path(exact_arguments[kubeconfig_index]),
        label="provider-issued kubeconfig",
        maximum_bytes=_MAX_CUSTODY_DOCUMENT_BYTES,
        private=True,
    )
    if kubeconfig_sha256 != expected_kubeconfig_sha256:
        raise DeploymentError("provider-issued kubeconfig differs from signed custody")
    with _sealed_memfd("fs2-provider-kubeconfig", kubeconfig_bytes) as kubeconfig_fd:
        exact_arguments[kubeconfig_index] = f"/proc/self/fd/{kubeconfig_fd}"
        return _pinned_custody_command(
            executable_path=Path(str(tool["path"])),
            expected_sha256=str(tool["sha256"]),
            label="provider-signed kubectl",
            arguments=exact_arguments,
            timeout=timeout,
            inherited_fds=(kubeconfig_fd,),
        )


def _provider_bound_kubeconfig_identity(
    *,
    kubectl: str,
    kubectl_tool: Mapping[str, Any],
    kubeconfig: Path,
    kubeconfig_sha256: str,
    context: str,
    signature_verifier_sha256: str,
) -> dict[str, str]:
    """Reconstruct certificate and provider principal facts from kubeconfig bytes."""

    viewed = _pinned_kubectl_command(
        kubectl=kubectl,
        tool=kubectl_tool,
        expected_kubeconfig_sha256=kubeconfig_sha256,
        arguments=[
            "--kubeconfig",
            str(kubeconfig),
            "--context",
            context,
            "config",
            "view",
            "--raw",
            "--minify",
            "--output",
            "json",
        ],
    )
    try:
        document = json.loads(viewed.stdout)
        users = document["users"]
        clusters = document["clusters"]
        user = users[0]["user"]
        cluster = clusters[0]["cluster"]
    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as exc:
        raise DeploymentError("the provider kubeconfig projection is malformed") from exc
    forbidden_user_fields = {
        "token",
        "tokenFile",
        "exec",
        "auth-provider",
        "username",
        "password",
        "as",
        "as-groups",
        "as-user-extra",
    }
    if (
        viewed.returncode != 0
        or not isinstance(user, dict)
        or not isinstance(cluster, dict)
        or forbidden_user_fields.intersection(user)
        or set(user) != {"client-certificate-data", "client-key-data"}
        or "certificate-authority-data" not in cluster
        or cluster.get("insecure-skip-tls-verify") is True
    ):
        raise DeploymentError(
            "the network-boundary kubeconfig must be embedded X.509 only, without impersonation or executable credentials"
        )
    certificate = _decode_kubeconfig_data(
        user.get("client-certificate-data"), "client certificate"
    )
    _decode_kubeconfig_data(user.get("client-key-data"), "client key")
    issuer_ca = _decode_kubeconfig_data(
        cluster.get("certificate-authority-data"), "issuer CA"
    )
    inspected = _pinned_signature_verifier(
        ["x509-spiffe-uris"],
        expected_sha256=signature_verifier_sha256,
        input_bytes=certificate,
    )
    normalized_certificate = _pinned_signature_verifier(
        ["x509-der"],
        expected_sha256=signature_verifier_sha256,
        input_bytes=certificate,
    )
    try:
        decoded_principals = json.loads(inspected.stdout)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("the client certificate SAN output is malformed") from exc
    principals = (
        sorted(set(decoded_principals))
        if isinstance(decoded_principals, list)
        and all(isinstance(value, str) for value in decoded_principals)
        else []
    )
    if (
        inspected.returncode != 0
        or normalized_certificate.returncode != 0
        or not normalized_certificate.stdout
        or len(principals) != 1
    ):
        raise DeploymentError(
            "the client certificate must carry exactly one provider-issued SPIFFE principal"
        )
    return {
        "provider_principal_id": principals[0],
        "client_certificate_sha256": hashlib.sha256(
            normalized_certificate.stdout
        ).hexdigest(),
        "issuer_ca_sha256": hashlib.sha256(issuer_ca).hexdigest(),
        "server": str(cluster.get("server", "")),
    }


def _authority_ready_endpoints(
    *,
    kubectl: str,
    kubectl_tool: Mapping[str, Any],
    auditor: Path,
    auditor_kubeconfig_sha256: str,
    context: str,
    serving_certificate_sha256: str,
) -> dict[str, Any]:
    """Capture one live Service endpoint/readiness projection.

    This deliberately reads Endpoints, Pods and every Pod's HTTPS readiness
    response as one fail-closed projection. Callers take the projection twice
    and require exact equality, alongside the two protected-object/RBAC reads.
    """

    endpoints_result = _pinned_kubectl_command(
        kubectl=kubectl,
        tool=kubectl_tool,
        expected_kubeconfig_sha256=auditor_kubeconfig_sha256,
        arguments=[
            "--kubeconfig",
            str(auditor),
            "--context",
            context,
            "--namespace",
            "fs2-network-security",
            "get",
            "endpoints",
            "fs2-model-network-boundary",
            "--output",
            "json",
        ],
    )
    pods_result = _pinned_kubectl_command(
        kubectl=kubectl,
        tool=kubectl_tool,
        expected_kubeconfig_sha256=auditor_kubeconfig_sha256,
        arguments=[
            "--kubeconfig",
            str(auditor),
            "--context",
            context,
            "--namespace",
            "fs2-network-security",
            "get",
            "pods",
            "--selector",
            "app.kubernetes.io/name=fs2-model-network-boundary,app.kubernetes.io/instance=fs2-model-network-boundary,app.kubernetes.io/component=admission",
            "--output",
            "json",
        ],
    )
    try:
        endpoints_document = json.loads(endpoints_result.stdout)
        endpoint_metadata = endpoints_document["metadata"]
        pod_items = json.loads(pods_result.stdout)["items"]
        addresses = [
            address
            for subset in endpoints_document.get("subsets", [])
            for address in subset.get("addresses", [])
        ]
    except (KeyError, TypeError, json.JSONDecodeError) as exc:
        raise DeploymentError("the boundary Service endpoint census is malformed") from exc
    if endpoints_result.returncode != 0 or pods_result.returncode != 0:
        raise DeploymentError("the boundary Service endpoint census is unavailable")
    pods_by_uid = {
        pod.get("metadata", {}).get("uid"): pod
        for pod in pod_items
        if isinstance(pod, dict)
    }
    ready_endpoints: list[dict[str, str]] = []
    for address in addresses:
        if not isinstance(address, dict):
            raise DeploymentError("a boundary endpoint address is malformed")
        target = address.get("targetRef", {})
        if not isinstance(target, dict):
            raise DeploymentError("a boundary endpoint targetRef is malformed")
        pod = pods_by_uid.get(target.get("uid"))
        if target.get("kind") != "Pod" or not isinstance(pod, dict):
            raise DeploymentError(
                "a boundary endpoint does not target one inventoried Pod"
            )
        pod_metadata = pod.get("metadata", {})
        pod_spec = pod.get("spec", {})
        pod_status = pod.get("status", {})
        if (
            target.get("name") != pod_metadata.get("name")
            or address.get("ip") != pod_status.get("podIP")
            or not isinstance(pod_spec.get("nodeName"), str)
            or not pod_spec["nodeName"]
        ):
            raise DeploymentError("a boundary endpoint has no stable Pod/node identity")
        readiness = _pinned_kubectl_command(
            kubectl=kubectl,
            tool=kubectl_tool,
            expected_kubeconfig_sha256=auditor_kubeconfig_sha256,
            arguments=[
                "--kubeconfig",
                str(auditor),
                "--context",
                context,
                "get",
                "--raw",
                (
                    "/api/v1/namespaces/fs2-network-security/pods/"
                    f"https:{pod_metadata['name']}:8443/proxy/readyz"
                ),
            ],
        )
        try:
            readiness_body = json.loads(readiness.stdout)
        except (TypeError, json.JSONDecodeError) as exc:
            raise DeploymentError(
                f"boundary Pod {pod_metadata.get('name')} readiness is malformed"
            ) from exc
        if (
            readiness.returncode != 0
            or readiness_body.get("status") != "ok"
            or readiness_body.get("serving_certificate_sha256")
            != serving_certificate_sha256
        ):
            raise DeploymentError(
                f"boundary Pod {pod_metadata.get('name')} is not API/TLS ready"
            )
        ready_endpoints.append(
            {
                "pod_name": str(pod_metadata.get("name", "")),
                "pod_uid": str(pod_metadata.get("uid", "")),
                "pod_resource_version": str(
                    pod_metadata.get("resourceVersion", "")
                ),
                "node_name": str(pod_spec.get("nodeName", "")),
                "ip": str(address.get("ip", "")),
            }
        )
    ready_endpoints.sort(key=lambda item: item["pod_name"])
    return {
        "uid": str(endpoint_metadata.get("uid", "")),
        "resource_version": str(endpoint_metadata.get("resourceVersion", "")),
        "object_sha256": _json_sha256(
            _semantic_kubernetes_object(endpoints_document)
        ),
        "ready_endpoints": ready_endpoints,
    }


def model_network_boundary_authority_custody(
    *,
    kubectl: str,
    context: str,
    cluster_id: str,
    project_id: str,
    nebius: str,
    nebius_profile: str,
    credential: Path,
    credential_kind: str,
    expected_username: str,
    expected_receipt_phase: str,
    trust_root_sha256: str,
    provider_trust_root_sha256: str,
    signature_verifier_sha256: str,
) -> dict[str, Any]:
    """Verify the externally signed authority receipt and every bound live object."""

    (
        provider_attestation,
        provider_attestation_sha256,
        freeze_active_until,
    ) = _verified_provider_custody(
        cluster_id=cluster_id,
        project_id=project_id,
        nebius=nebius,
        nebius_profile=nebius_profile,
        provider_trust_root_sha256=provider_trust_root_sha256,
        signature_verifier_sha256=signature_verifier_sha256,
    )
    credential_epochs_sha256 = _provider_credential_epochs_sha256(
        provider_attestation
    )
    kubectl_tool = provider_attestation["client_tools"]["kubectl"]
    if context != kubectl_tool.get("context"):
        raise DeploymentError("requested context differs from provider-signed custody")
    selected_kubeconfig_sha256 = str(
        provider_attestation["credentials"][credential_kind].get(
            "kubeconfig_sha256", ""
        )
    )
    authenticated = _pinned_kubectl_command(
        kubectl=kubectl,
        tool=kubectl_tool,
        expected_kubeconfig_sha256=selected_kubeconfig_sha256,
        arguments=[
            "--kubeconfig",
            str(credential),
            "--context",
            context,
            "auth",
            "whoami",
            "-o",
            "json",
        ],
    )
    try:
        observed_identity = _exact_kubernetes_user_info(
            json.loads(authenticated.stdout), "provider-pinned kubectl auth whoami"
        )
    except (UnicodeDecodeError, json.JSONDecodeError, DeploymentError) as exc:
        raise DeploymentError(
            "the separately issued model-network credential has no exact live identity"
        ) from exc
    if (
        authenticated.returncode != 0
        or observed_identity.get("username") != expected_username
    ):
        raise DeploymentError(
            "the separately issued model-network credential has the wrong live identity"
        )
    reconstructed_identity = _provider_bound_kubeconfig_identity(
        kubectl=kubectl,
        kubectl_tool=kubectl_tool,
        kubeconfig=credential,
        kubeconfig_sha256=selected_kubeconfig_sha256,
        context=context,
        signature_verifier_sha256=signature_verifier_sha256,
    )

    paths = {
        "receipt": Path(os.environ.get("FS2_NETWORK_BOUNDARY_AUTHORITY_RECEIPT", "")),
        "signature": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_AUTHORITY_SIGNATURE", "")
        ),
        "trust root": Path(
            os.environ.get("FS2_NETWORK_BOUNDARY_AUTHORITY_TRUST_ROOT", "")
        ),
    }
    receipt_bytes, _receipt_sha256 = _stable_root_file_bytes(
        paths["receipt"],
        label="model-network authority receipt",
        maximum_bytes=_MAX_CUSTODY_DOCUMENT_BYTES,
    )
    signature_bytes, _signature_sha256 = _stable_root_file_bytes(
        paths["signature"],
        label="model-network authority signature",
        maximum_bytes=_MAX_CUSTODY_SIGNATURE_BYTES,
    )
    trust_root_bytes, trust_root_actual_sha256 = _stable_root_file_bytes(
        paths["trust root"],
        label="model-network authority trust root",
        maximum_bytes=_MAX_CUSTODY_DOCUMENT_BYTES,
    )
    if not re.fullmatch(r"[a-f0-9]{64}", trust_root_sha256):
        raise DeploymentError(
            "the root deployment contract must pin the authority trust-root SHA-256"
        )
    if trust_root_actual_sha256 != trust_root_sha256:
        raise DeploymentError(
            "the authority signing key differs from the root-pinned digest"
        )
    _verify_detached_signature(
        document=receipt_bytes,
        signature=signature_bytes,
        trust_root=trust_root_bytes,
        verifier_sha256=signature_verifier_sha256,
        label="model-network authority custody",
    )
    try:
        receipt = json.loads(receipt_bytes)
        if not isinstance(receipt, dict):
            raise TypeError("receipt is not an object")
        payload = {
            key: value for key, value in receipt.items() if key != "payload_sha256"
        }
        credentials = receipt["custody"]["credentials"]
        credential_claim = credentials[credential_kind]
        issued_at = datetime.fromisoformat(receipt["issued_at"].replace("Z", "+00:00"))
        expires_at = datetime.fromisoformat(
            receipt["expires_at"].replace("Z", "+00:00")
        )
    except (KeyError, TypeError, ValueError, json.JSONDecodeError, OSError) as exc:
        raise DeploymentError(
            "the signed model-network authority receipt is malformed"
        ) from exc
    now = datetime.now(UTC)
    if (
        receipt.get("schema")
        != "fs2-serve.nebius.ai/model-network-boundary-authority/v4"
        or receipt.get("phase") != expected_receipt_phase
        or receipt.get("cluster_id") != cluster_id
        or receipt.get("authority_namespace") != "fs2-network-security"
        or receipt.get("payload_sha256") != _json_sha256(payload)
        or receipt["custody"].get("trust_root_sha256") != trust_root_sha256
        or issued_at.tzinfo is None
        or expires_at.tzinfo is None
        or expires_at - issued_at > timedelta(minutes=15)
        or issued_at > now + timedelta(seconds=60)
        or not (issued_at <= now < expires_at)
    ):
        raise DeploymentError(
            "the signed model-network authority receipt is expired or outside its exact custody contract"
        )
    if (
        credential_claim.get("username") != expected_username
        or credential_claim.get("groups") != observed_identity.get("groups")
        or credential_claim.get("extras") != observed_identity.get("extras")
        or credential_claim.get("authentication_mode") != "x509-client-certificate"
        or credential_claim.get("provider_principal_id")
        != reconstructed_identity["provider_principal_id"]
        or credential_claim.get("kubeconfig_sha256")
        != selected_kubeconfig_sha256
        or credential_claim.get("client_certificate_sha256")
        != reconstructed_identity["client_certificate_sha256"]
        or credential_claim.get("issuer_ca_sha256")
        != reconstructed_identity["issuer_ca_sha256"]
        or credential_claim.get("gateway_server") != reconstructed_identity["server"]
        or credential_claim.get("gateway_server")
        != provider_attestation.get("provider_gateway", {}).get("api_server_url")
    ):
        raise DeploymentError(
            "the model-network credential is not the exact provider-issued X.509 identity in the signed custody receipt"
        )

    expected_credentials = {
        "authorizer": ("fs2-model-network-authorizer", ["fs2:model-network-authorizer", "system:authenticated"]),
        "transition": ("fs2-model-network-transition", ["fs2:model-network-transition", "system:authenticated"]),
        "maintenance": ("fs2-model-network-maintenance", ["fs2:model-network-maintenance", "system:authenticated"]),
        "auditor": ("fs2-model-network-auditor", ["fs2:model-network-auditor", "system:authenticated"]),
        "custodian": ("fs2-model-network-custodian", ["fs2:model-network-custodian", "system:authenticated"]),
        "recovery": ("fs2-model-network-recovery", ["fs2:model-network-recovery", "system:authenticated"]),
    }
    if set(credentials) != set(expected_credentials):
        raise DeploymentError("the signed custody receipt does not enumerate every exact credential")
    provider_principals: set[str] = set()
    for name, (username, groups) in expected_credentials.items():
        claim = credentials.get(name)
        provider_credential = provider_attestation["credentials"].get(name)
        if (
            not isinstance(claim, dict)
            or not isinstance(provider_credential, dict)
            or claim.get("username") != username
            or claim.get("groups") != groups
            or claim.get("extras") != {}
            or claim.get("authentication_mode") != "x509-client-certificate"
            or not isinstance(claim.get("provider_principal_id"), str)
            or not claim["provider_principal_id"]
            or not re.fullmatch(r"[a-f0-9]{64}", str(claim.get("kubeconfig_sha256", "")))
            or not re.fullmatch(r"[a-f0-9]{64}", str(claim.get("client_certificate_sha256", "")))
            or not re.fullmatch(r"[a-f0-9]{64}", str(claim.get("issuer_ca_sha256", "")))
            or any(
                claim.get(field) != provider_credential.get(field)
                for field in (
                    "username",
                    "groups",
                    "provider_principal_id",
                    "kubeconfig_sha256",
                    "client_certificate_sha256",
                    "issuer_ca_sha256",
                    "gateway_server",
                    "credential_epoch",
                    "not_before",
                    "not_after",
                )
            )
            or claim.get("not_before")
            != provider_attestation["mutation_freeze"].get("active_from")
            or claim.get("not_after")
            != provider_attestation["mutation_freeze"].get("active_until")
        ):
            raise DeploymentError(f"the signed {name} custody identity is incomplete")
        provider_principals.add(claim["provider_principal_id"])
    if len(provider_principals) != len(expected_credentials):
        raise DeploymentError("model-network custody credentials must use distinct provider principals")
    provider = receipt["custody"].get("provider", {})
    external_custody = receipt.get("external_custody", {})
    if (
        not isinstance(provider, dict)
        or not isinstance(external_custody, dict)
        or credentials["custodian"]["provider_principal_id"]
        != provider.get("custodian_principal_id")
        or credentials["recovery"]["provider_principal_id"]
        != provider.get("recovery_principal_id")
        or external_custody.get("schema") != provider_attestation.get("schema")
        or external_custody.get("policy_id") != provider_attestation.get("policy_id")
        or external_custody.get("policy_revision")
        != provider_attestation.get("policy_revision")
        or external_custody.get("provider_trust_root_sha256")
        != provider_trust_root_sha256
        or external_custody.get("signature_verifier_sha256")
        != signature_verifier_sha256
        or external_custody.get("client_tools_sha256")
        != _json_sha256(provider_attestation.get("client_tools", {}))
        or external_custody.get("credential_epochs_sha256")
        != credential_epochs_sha256
        or external_custody.get("attestation_sha256")
        != provider_attestation_sha256
        or external_custody.get("stable_policy_sha256")
        != _provider_custody_stable_sha256(provider_attestation)
        or external_custody.get("gateway_policy_sha256")
        != provider_attestation.get("provider_gateway", {}).get("policy_sha256")
        or external_custody.get("provider_inventory_sha256")
        != provider_attestation.get("provider_gateway", {}).get(
            "provider_inventory_sha256"
        )
        or external_custody.get("kubernetes_authorization_sha256")
        != _json_sha256(provider_attestation.get("kubernetes_authorization", {}))
        or external_custody.get("provider_authority_census_sha256")
        != _provider_authority_census_stable_sha256(
            provider_attestation.get("provider_authority_census", {})
        )
        or external_custody.get("gateway_runtime_measurements_sha256")
        != _json_sha256(
            provider_attestation.get("provider_authority_census", {})
            .get("snapshot", {})
            .get("gateway_runtime_measurements", {})
        )
        or external_custody.get("gateway_member_ids")
        != [
            member.get("member_id")
            for member in provider_attestation.get("provider_gateway", {}).get(
                "members", []
            )
            if isinstance(member, dict)
        ]
        or external_custody.get("cluster_resource_version")
        != provider_attestation.get("provider_gateway", {}).get(
            "cluster_resource_version"
        )
        or external_custody.get("gateway_egress_host_cidrs")
        != provider_attestation.get("provider_gateway", {}).get(
            "gateway_egress_host_cidrs"
        )
        or external_custody.get("freeze_transaction_id")
        != provider_attestation.get("mutation_freeze", {}).get("transaction_id")
        or external_custody.get("freeze_expires_at")
        != provider_attestation.get("mutation_freeze", {}).get("active_until")
        or external_custody.get("frozen_resources_sha256")
        != _json_sha256(
            {
                "resources": sorted(
                    provider_attestation.get("mutation_freeze", {}).get(
                        "protected_kubernetes_resources", []
                    )
                ),
                "resource_prefixes": provider_attestation.get(
                    "mutation_freeze", {}
                ).get("protected_kubernetes_resource_prefixes", []),
            }
        )
        or sorted(provider_attestation.get("exclusive_break_glass_principals", []))
        != sorted(
            [
                credentials["custodian"]["provider_principal_id"],
                credentials["recovery"]["provider_principal_id"],
            ]
        )
    ):
        raise DeploymentError(
            "the authority receipt is not bound to the independent provider/IAM custody assertion"
        )

    auditor_raw = os.environ.get("FS2_NETWORK_AUDITOR_KUBECONFIG", "")
    auditor = Path(auditor_raw)
    auditor_claim = credentials.get("auditor")
    auditor_kubeconfig_sha256 = str(
        provider_attestation["credentials"]["auditor"].get(
            "kubeconfig_sha256", ""
        )
    )
    if (
        not auditor.is_absolute()
        or auditor.is_symlink()
        or not auditor.is_file()
        or auditor.resolve() == credential.resolve()
        or auditor.stat().st_mode & 0o077
        or not isinstance(auditor_claim, dict)
        or auditor_claim.get("username") != "fs2-model-network-auditor"
        or auditor_claim.get("authentication_mode") != "x509-client-certificate"
        or auditor_claim.get("kubeconfig_sha256")
        != auditor_kubeconfig_sha256
    ):
        raise DeploymentError(
            "FS2_NETWORK_AUDITOR_KUBECONFIG must be the distinct signed mode-0600 auditor credential"
        )
    auditor_whoami = _pinned_kubectl_command(
        kubectl=kubectl,
        tool=kubectl_tool,
        expected_kubeconfig_sha256=auditor_kubeconfig_sha256,
        arguments=[
            "--kubeconfig",
            str(auditor),
            "--context",
            context,
            "auth",
            "whoami",
            "-o",
            "json",
        ],
    )
    try:
        auditor_identity = _exact_kubernetes_user_info(
            json.loads(auditor_whoami.stdout), "auditor kubectl auth whoami"
        )
    except (json.JSONDecodeError, DeploymentError) as exc:
        raise DeploymentError("the signed model-network auditor cannot authenticate") from exc
    if (
        auditor_whoami.returncode != 0
        or auditor_identity["username"] != auditor_claim.get("username")
        or auditor_identity["groups"] != auditor_claim.get("groups")
        or auditor_identity["extras"] != auditor_claim.get("extras")
    ):
        raise DeploymentError("the live auditor identity differs from its signed claim")

    protected = receipt.get("protected_objects")
    if not isinstance(protected, list) or not protected:
        raise DeploymentError("the authority receipt has no protected-object inventory")
    required = {
        ("deployments.apps", "fs2-network-security", "fs2-model-network-boundary"),
