            sort_keys=True,
        )
    )


def _verify_settlement_signature(
    payload: Mapping[str, Any], signature_text: object
) -> Mapping[str, Any]:
    trust_fd = int(CAPSULE_TOOL_PATHS["mutation_settlement_trust"].rsplit("/", 1)[1])
    trust_raw = os.pread(trust_fd, os.fstat(trust_fd).st_size, 0)
    try:
        trust = json.loads(trust_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("mutation-settlement trust registry is malformed") from exc
    if _canonical_bytes(trust) + b"\n" != trust_raw or not isinstance(trust, dict) or set(trust) != {"authorities", "schema"} or trust["schema"] != "fs2-serve.nebius.ai/trusted-mutation-settlement-authorities/v1" or not isinstance(trust["authorities"], list):
        raise DeploymentError("mutation-settlement trust registry is not canonical v1")
    authority_id = payload.get("authority_id")
    key_id = payload.get("key_id")
    project_id = payload.get("project_id")
    matches = [
        item
        for item in trust["authorities"]
        if isinstance(item, dict)
        and set(item) == {
            "id", "key_id", "ledger", "project_ids", "providers", "public_key",
            "role", "settlement_root",
        }
        and item.get("id") == authority_id
        and item.get("key_id") == key_id
        and item.get("role") == "public-edge-provider-settlement-authority"
        and item.get("settlement_root") == str(MUTATION_SETTLEMENT_ROOT)
        and isinstance(item.get("project_ids"), list)
        and item["project_ids"] == sorted(set(item["project_ids"]))
        and project_id in item["project_ids"]
    ]
    if len(matches) != 1:
        raise DeploymentError("mutation settlement is not bound to one enrolled authority/project")
    authority = matches[0]
    ledger = authority["ledger"]
    if (
        not isinstance(ledger, dict)
        or set(ledger) != {
            "cgroup_root", "cgroup_watchdog_executable_sha256",
            "cgroup_watchdog_runtime_review_sha256",
            "config_path", "config_sha256", "executable_path", "executable_sha256",
            "peer_credential_mode", "peer_gid", "peer_uid", "runtime_review_sha256",
            "socket_path",
        }
        or ledger.get("socket_path") != str(MUTATION_LEDGER_SOCKET)
        or ledger.get("executable_path") != str(MUTATION_LEDGER_EXECUTABLE)
        or ledger.get("config_path") != str(MUTATION_LEDGER_CONFIG)
        or ledger.get("cgroup_root") != "/sys/fs/cgroup/fs2-public-edge-mutations"
        or ledger.get("peer_credential_mode") != "SO_PEERCRED"
        or not isinstance(ledger.get("peer_uid"), int)
        or not isinstance(ledger.get("peer_gid"), int)
        or any(
            not isinstance(ledger.get(key), str)
            or re.fullmatch(r"[a-f0-9]{64}", ledger[key]) is None
            or ledger[key] == "0" * 64
            for key in (
                "config_sha256", "executable_sha256", "runtime_review_sha256",
                "cgroup_watchdog_executable_sha256",
                "cgroup_watchdog_runtime_review_sha256",
            )
        )
    ):
        raise DeploymentError("mutation ledger authority is malformed or not fixed")
    if payload.get("schema") == "fs2-serve.nebius.ai/mutation-ledger-receipt/v2" and (
        payload.get("ledger_executable_sha256") != ledger["executable_sha256"]
        or payload.get("ledger_config_sha256") != ledger["config_sha256"]
        or payload.get("ledger_runtime_review_sha256") != ledger["runtime_review_sha256"]
        or payload.get("ledger_peer_credential_mode") != ledger["peer_credential_mode"]
        or payload.get("ledger_peer_uid") != ledger["peer_uid"]
        or payload.get("ledger_peer_gid") != ledger["peer_gid"]
        or payload.get("cgroup_runtime_review_sha256")
        != ledger["cgroup_watchdog_runtime_review_sha256"]
    ):
        raise DeploymentError("mutation-ledger receipt differs from its enrolled runtime")
    providers = authority["providers"]
    if not isinstance(providers, list):
        raise DeploymentError("mutation-settlement provider authority list is malformed")
    provider_keys = {
        "class", "endpoint", "observer_config_sha256", "observer_executable_sha256",
        "observer_id", "observer_runtime_review_sha256",
    }
    if any(
        not isinstance(provider, dict)
        or set(provider) != provider_keys
        or provider.get("class") not in {
            "terraform-local",
            "nebius",
            "kubernetes-helm",
            "registry",
        }
        or not isinstance(provider.get("endpoint"), str)
        or not provider["endpoint"]
        or not isinstance(provider.get("observer_id"), str)
        or not provider["observer_id"]
        or any(
            not isinstance(provider.get(key), str)
            or re.fullmatch(r"[a-f0-9]{64}", provider[key]) is None
            or provider[key] == "0" * 64
            for key in (
                "observer_executable_sha256",
                "observer_config_sha256",
                "observer_runtime_review_sha256",
            )
        )
        for provider in providers
    ):
        raise DeploymentError("mutation-settlement provider authority list is malformed")
    provider_identities = [
        (provider["class"], provider["endpoint"], provider["observer_id"])
        for provider in providers
    ]
    if provider_identities != sorted(set(provider_identities)):
        raise DeploymentError("mutation-settlement provider authority list is ambiguous")
    provider_matches = [
        provider
        for provider in providers
        if provider.get("class") == payload.get("provider_class")
        and provider.get("endpoint") == payload.get("provider_endpoint")
        and provider.get("observer_id") == payload.get("observer_id")
        and provider.get("observer_executable_sha256") == payload.get("observer_executable_sha256")
        and provider.get("observer_config_sha256") == payload.get("observer_config_sha256")
        and provider.get("observer_runtime_review_sha256") == payload.get("observer_runtime_review_sha256")
    ]
    if len(provider_matches) != 1:
        raise DeploymentError("settlement is not bound to one exact provider observer/runtime")
    try:
        public_key = base64.urlsafe_b64decode(
            str(authority["public_key"]) + "=" * (-len(str(authority["public_key"])) % 4)
        )
        signature = base64.urlsafe_b64decode(
            str(signature_text) + "=" * (-len(str(signature_text)) % 4)
        )
    except (ValueError, binascii.Error) as exc:
        raise DeploymentError("mutation-settlement signature encoding is invalid") from exc
    if len(public_key) != 32 or len(signature) != 64 or authority["key_id"] != "sha256:" + hashlib.sha256(public_key).hexdigest():
        raise DeploymentError("mutation-settlement signing key is invalid")
    key_fd = _sealed_memfd("settlement-key", bytes.fromhex("302a300506032b6570032100") + public_key)
    payload_fd = _sealed_memfd("settlement-payload", _canonical_bytes(payload))
    signature_fd = _sealed_memfd("settlement-signature", signature)
    try:
        result = subprocess.run(
            [
                CAPSULE_TOOL_PATHS["openssl"],
                "pkeyutl",
                "-verify",
                "-pubin",
                "-keyform",
                "DER",
                "-inkey",
                f"/proc/self/fd/{key_fd}",
                "-rawin",
                "-in",
                f"/proc/self/fd/{payload_fd}",
                "-sigfile",
                f"/proc/self/fd/{signature_fd}",
            ],
            env=clean_environment(),
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            pass_fds=tuple(sorted({*CAPSULE_PASS_FDS, key_fd, payload_fd, signature_fd})),
            close_fds=True,
        )
    finally:
        os.close(key_fd)
        os.close(payload_fd)
        os.close(signature_fd)
    if result.returncode != 0:
        raise DeploymentError("mutation-settlement signature is invalid")
    return authority


def _external_signed_record(path: Path, schema: str) -> dict[str, Any]:
    for parent in (Path("/var"), Path("/var/lib"), Path("/var/lib/fs2"), MUTATION_SETTLEMENT_ROOT):
        details = os.stat(parent, follow_symlinks=False)
        if not stat.S_ISDIR(details.st_mode) or details.st_uid != 0 or stat.S_IMODE(details.st_mode) & 0o022:
            raise DeploymentError("mutation-settlement authority directory is not protected")
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0))
    try:
        details = os.fstat(descriptor)
        if not stat.S_ISREG(details.st_mode) or details.st_uid != 0 or stat.S_IMODE(details.st_mode) != 0o444:
            raise DeploymentError("mutation-settlement receipt is not root-owned mode 0444")
        raw = os.pread(descriptor, details.st_size, 0)
    finally:
        os.close(descriptor)
    try:
        envelope = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("mutation-settlement receipt is malformed") from exc
    if _canonical_bytes(envelope) + b"\n" != raw or not isinstance(envelope, dict) or set(envelope) != {"payload", "signature"} or not isinstance(envelope["payload"], dict) or envelope["payload"].get("schema") != schema:
        raise DeploymentError("mutation-settlement receipt is not canonical or has the wrong schema")
    _verify_settlement_signature(envelope["payload"], envelope["signature"])
    return envelope["payload"]


def _protected_root_file_sha256(path: Path, *, label: str) -> str:
    current = Path("/")
    for part in path.parent.parts[1:]:
        current /= part
        details = os.stat(current, follow_symlinks=False)
        if (
            not stat.S_ISDIR(details.st_mode)
            or details.st_uid != 0
            or stat.S_IMODE(details.st_mode) & 0o022
        ):
            raise DeploymentError(f"{label} parent chain is not root-owned and protected")
    descriptor = os.open(
        path,
        os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != 0
            or stat.S_IMODE(before.st_mode) & 0o022
        ):
            raise DeploymentError(f"{label} is not a protected root-owned regular file")
        digest = hashlib.sha256()
        while True:
            chunk = os.read(descriptor, 128 * 1024)
            if not chunk:
                break
            digest.update(chunk)
        after = os.fstat(descriptor)
        if (
            before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns,
            before.st_ctime_ns,
        ) != (
            after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns,
            after.st_ctime_ns,
        ):
            raise DeploymentError(f"{label} changed while it was hashed")
        return digest.hexdigest()
    finally:
        os.close(descriptor)


def _request_mutation_ledger_event(
    *,
    action: str,
    attempt_id: str,
    run_root: Path,
    stage: str,
    record: Mapping[str, Any],
) -> tuple[dict[str, Any], str]:
    if action not in {"started", "terminal", "outcome"}:
        raise DeploymentError("mutation-ledger action is outside the exact contract")
    if re.fullmatch(r"[0-9]+-[0-9]+-[0-9]+", attempt_id) is None:
        raise DeploymentError("mutation-ledger attempt identity is malformed")
    project_id = CAPSULE_NEBIUS_AUTH.get("project_id")
    if not isinstance(project_id, str) or not project_id:
        raise DeploymentError("mutation ledger requires the capsule-bound cloud project")
    request = {
        "accepted_commit": os.environ["FS2_CAPSULE_ACCEPTED_COMMIT"],
        "accepted_tree": os.environ["FS2_CAPSULE_ACCEPTED_TREE"],
        "action": action,
        "attempt_id": attempt_id,
        "caller_effective_gid": os.getegid(),
        "caller_real_gid": os.getgid(),
        "caller_uid": os.getuid(),
        "project_id": project_id,
        "reconciliation_of": record.get("reconciliation_of"),
        "record": dict(record),
        "request_nonce": base64.urlsafe_b64encode(os.getrandom(32)).rstrip(b"=").decode("ascii"),
        "run_root": str(run_root),
        "schema": "fs2-serve.nebius.ai/mutation-ledger-request/v2",
        "stage": stage,
    }
    request_raw = _canonical_bytes(request) + b"\n"
    if len(request_raw) > 128 * 1024:
        raise DeploymentError("mutation-ledger request exceeds the bounded contract")
    for parent in (Path("/run"), MUTATION_LEDGER_SOCKET.parent):
        details = os.stat(parent, follow_symlinks=False)
        if (
            not stat.S_ISDIR(details.st_mode)
            or details.st_uid != 0
            or stat.S_IMODE(details.st_mode) & 0o022
        ):
            raise DeploymentError("mutation-ledger socket parent is not protected")
    socket_details = os.stat(MUTATION_LEDGER_SOCKET, follow_symlinks=False)
    if (
        not stat.S_ISSOCK(socket_details.st_mode)
        or socket_details.st_uid != 0
        or stat.S_IMODE(socket_details.st_mode) & 0o007
    ):
        raise DeploymentError("mutation-ledger socket is not root-owned and private")
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    connection.settimeout(30)
    try:
        connection.connect(str(MUTATION_LEDGER_SOCKET))
        peer_pid, peer_uid, peer_gid = struct.unpack(
            "3i",
            connection.getsockopt(
                socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")
            ),
        )
        connection.sendall(request_raw)
        connection.shutdown(socket.SHUT_WR)
        chunks: list[bytes] = []
        length = 0
        while True:
            chunk = connection.recv(64 * 1024)
            if not chunk:
                break
            length += len(chunk)
            if length > 256 * 1024:
                raise DeploymentError("mutation-ledger response exceeds its bound")
            chunks.append(chunk)
    finally:
        connection.close()
    response_raw = b"".join(chunks)
    try:
        envelope = json.loads(response_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("mutation-ledger response is malformed") from exc
    if (
        _canonical_bytes(envelope) + b"\n" != response_raw
        or not isinstance(envelope, dict)
        or set(envelope) != {"payload", "signature"}
        or not isinstance(envelope["payload"], dict)
    ):
        raise DeploymentError("mutation-ledger response is not one canonical envelope")
    payload = envelope["payload"]
    expected_keys = {
        "accepted_commit", "accepted_tree", "action", "conflicting_active_count",
        "accepted_exit_code",
        "attempt_id", "authority_id", "caller_effective_gid", "caller_real_gid", "caller_uid", "entry_sha256",
        "authority_sha256", "operation",
        "cgroup_events_sha256", "cgroup_inode", "cgroup_kill_deadline_unix",
        "cgroup_path", "cgroup_populated", "cgroup_runtime_review_sha256",
        "cgroup_watchdog_executable_sha256",
        "event_status",
        "key_id", "ledger_config_sha256", "ledger_executable_sha256",
        "ledger_peer_credential_mode", "ledger_peer_gid", "ledger_peer_uid",
        "ledger_runtime_review_sha256", "ledger_sequence", "observer_config_sha256",
        "mutation_started_at_unix",
        "observer_executable_sha256", "observer_id", "observer_runtime_review_sha256",
        "peer_observed_caller_gid", "peer_observed_caller_uid",
        "predecessor_receipt_sha256", "previous_head_sha256", "project_id",
        "reconciliation_of",
        "provider_class", "provider_endpoint", "record_path", "record_sha256",
        "recorded_at_unix", "request_sha256", "run_root", "schema", "stage",
    }
    if set(payload) != expected_keys:
        raise DeploymentError("mutation-ledger receipt violates its exact schema")
    authority = _verify_settlement_signature(payload, envelope["signature"])
    ledger = authority["ledger"]
    expected_provider_class = {
        "configuration": "terraform-local",
        "infrastructure": "nebius",
        "foundation": "kubernetes-helm",
        "workloads": "kubernetes-helm",
        "registry": "registry",
    }.get(stage)
    unsigned_entry = dict(payload)
    del unsigned_entry["entry_sha256"]
    expected_record_path = MUTATION_SETTLEMENT_ROOT / f"{attempt_id}.{action}.json"
    expected_cgroup_path = Path("/sys/fs/cgroup/fs2-public-edge-mutations") / attempt_id
    if (
        payload["schema"] != "fs2-serve.nebius.ai/mutation-ledger-receipt/v2"
        or payload["accepted_commit"] != request["accepted_commit"]
        or payload["accepted_tree"] != request["accepted_tree"]
        or payload["action"] != action
        or payload["accepted_exit_code"] != record.get("exit_code")
        or payload["attempt_id"] != attempt_id
        or payload["caller_uid"] != request["caller_uid"]
        or payload["caller_real_gid"] != request["caller_real_gid"]
        or payload["caller_effective_gid"] != request["caller_effective_gid"]
        or payload["project_id"] != project_id
        or payload["reconciliation_of"] != request["reconciliation_of"]
        or payload["run_root"] != str(run_root)
        or payload["stage"] != stage
        or (
            action == "started"
            and (
                payload["authority_sha256"] != record.get("authority_sha256")
                or payload["operation"] != record.get("operation")
            )
        )
        or payload["provider_class"] != expected_provider_class
        or payload["request_sha256"] != hashlib.sha256(request_raw).hexdigest()
        or payload["record_path"] != str(expected_record_path)
        or payload["conflicting_active_count"] != 0
        or payload["event_status"]
        != ({"started": "pending", "terminal": "success"}.get(action, str(record.get("outcome", ""))))
        or payload["record_sha256"] != hashlib.sha256(_canonical_bytes(record)).hexdigest()
        or payload["predecessor_receipt_sha256"]
        != (str(record.get("mutation_started_sha256", "0" * 64)))
        or not isinstance(payload["ledger_sequence"], int)
        or payload["ledger_sequence"] < 1
        or not isinstance(payload["recorded_at_unix"], int)
        or re.fullmatch(r"[a-f0-9]{64}", str(payload["previous_head_sha256"])) is None
        or payload["entry_sha256"] != hashlib.sha256(_canonical_bytes(unsigned_entry)).hexdigest()
        or payload["cgroup_path"] != str(expected_cgroup_path)
        or not isinstance(payload["cgroup_inode"], int)
        or payload["cgroup_inode"] < 1
        or not isinstance(payload["cgroup_kill_deadline_unix"], int)
        or not isinstance(payload["mutation_started_at_unix"], int)
        or (
            action == "started"
            and payload["mutation_started_at_unix"] != int(record["started_at_unix"])
        )
        or (
            action == "started"
            and payload["cgroup_kill_deadline_unix"]
            != int(record["started_at_unix"]) + MAXIMUM_MUTATION_SECONDS
        )
        or re.fullmatch(r"[a-f0-9]{64}", str(payload["cgroup_events_sha256"])) is None
        or not isinstance(payload["cgroup_populated"], bool)
        or payload["cgroup_populated"]
        or re.fullmatch(r"[a-f0-9]{64}", str(payload["cgroup_runtime_review_sha256"])) is None
        or payload["cgroup_runtime_review_sha256"] != ledger["cgroup_watchdog_runtime_review_sha256"]
        or payload["cgroup_watchdog_executable_sha256"] != ledger["cgroup_watchdog_executable_sha256"]
        or payload["ledger_executable_sha256"] != ledger["executable_sha256"]
        or payload["ledger_config_sha256"] != ledger["config_sha256"]
        or payload["ledger_runtime_review_sha256"] != ledger["runtime_review_sha256"]
        or payload["ledger_peer_credential_mode"] != "SO_PEERCRED"
        or payload["ledger_peer_uid"] != ledger["peer_uid"]
        or payload["ledger_peer_gid"] != ledger["peer_gid"]
        or payload["peer_observed_caller_uid"] != request["caller_uid"]
        or payload["peer_observed_caller_gid"] != request["caller_real_gid"]
        or peer_uid != ledger["peer_uid"]
        or peer_gid != ledger["peer_gid"]
        or peer_pid <= 0
        or _protected_root_file_sha256(
            MUTATION_LEDGER_EXECUTABLE, label="mutation-ledger executable"
        )
        != ledger["executable_sha256"]
        or _protected_root_file_sha256(
            MUTATION_LEDGER_CONFIG, label="mutation-ledger configuration"
        )
        != ledger["config_sha256"]
    ):
        raise DeploymentError("mutation-ledger receipt is not bound to the exact request/runtime")
    persisted = _external_signed_record(
        expected_record_path,
        "fs2-serve.nebius.ai/mutation-ledger-receipt/v2",
    )
    if persisted != payload:
        raise DeploymentError("mutation-ledger response differs from its protected durable record")
    persisted_sha256 = hashlib.sha256(expected_record_path.read_bytes()).hexdigest()
    return payload, persisted_sha256


def reconciled_mutation_digests(run_root: Path) -> set[str]:
    result: set[str] = set()
    for _journal_path, record, receipt_sha256 in indeterminate_mutation_records(run_root):
        acceptance_path = MUTATION_SETTLEMENT_ROOT / f"{receipt_sha256}.reconciled.json"
        if not acceptance_path.exists():
            continue
        if record.get("stage") == "registry":
            payload = _external_signed_record(
                acceptance_path,
                "fs2-serve.nebius.ai/registry-mutation-reconciliation-acceptance/v1",
            )
            evidence_path = (
                run_root / f"mutation-reconciliation-evidence-{receipt_sha256}.json"
            )
            try:
                evidence_raw = evidence_path.read_bytes()
                evidence = json.loads(evidence_raw)
            except (OSError, json.JSONDecodeError) as exc:
                raise DeploymentError(
                    "registry acceptance references malformed local evidence"
                ) from exc
            settlement_path = (
                MUTATION_SETTLEMENT_ROOT / f"{receipt_sha256}.settlement.json"
            )
            settlement = _external_signed_record(
                settlement_path,
                "fs2-serve.nebius.ai/provider-operation-settlement/v1",
            )
            if (
                set(payload)
                != {
                    "accepted_commit",
                    "accepted_tree",
                    "authority_id",
                    "completed_at",
                    "evidence_sha256",
                    "indeterminate_receipt_sha256",
                    "key_id",
                    "observer_config_sha256",
                    "observer_executable_sha256",
                    "observer_id",
                    "observer_runtime_review_sha256",
                    "project_id",
                    "provider_class",
                    "provider_endpoint",
                    "provider_settlement_sha256",
                    "reconciled_by",
                    "schema",
                    "stage",
                }
                or set(evidence)
                != {
                    "accepted_commit",
                    "accepted_tree",
                    "authority_sha256",
                    "expected_digest",
                    "indeterminate_receipt_sha256",
                    "provider_settlement_sha256",
                    "reconciled_by",
                    "schema",
                    "stage",
                    "target",
                }
                or payload["accepted_commit"]
                != os.environ["FS2_CAPSULE_ACCEPTED_COMMIT"]
                or payload["accepted_tree"] != os.environ["FS2_CAPSULE_ACCEPTED_TREE"]
                or payload["indeterminate_receipt_sha256"] != receipt_sha256
                or payload["stage"] != "registry"
                or payload["provider_class"] != "registry"
                or not evidence_path.is_file()
                or evidence_path.is_symlink()
                or hashlib.sha256(evidence_raw).hexdigest()
                != payload["evidence_sha256"]
                or evidence["schema"]
                != "fs2-serve.nebius.ai/registry-mutation-reconciliation-evidence/v1"
                or evidence["authority_sha256"] != record.get("authority_sha256")
                or evidence["indeterminate_receipt_sha256"] != receipt_sha256
                or evidence["provider_settlement_sha256"]
                != hashlib.sha256(settlement_path.read_bytes()).hexdigest()
                or evidence["reconciled_by"]
                not in {"authoritative-existing-digest", "fenced-no-clobber-retry"}
                or payload["reconciled_by"] != evidence["reconciled_by"]
                or payload["provider_settlement_sha256"]
                != evidence["provider_settlement_sha256"]
                or settlement.get("stage") != "registry"
                or settlement.get("provider_class") != "registry"
            ):
                raise DeploymentError(
                    "external registry reconciliation acceptance is not exact"
                )
            result.add(receipt_sha256)
            continue
        payload = _external_signed_record(
            acceptance_path,
            "fs2-serve.nebius.ai/terraform-mutation-reconciliation-acceptance/v1",
        )
        expected_keys = {
            "accepted_commit", "accepted_tree", "authority_id", "completed_at",
            "evidence_sha256", "indeterminate_receipt_sha256", "key_id", "project_id",
            "observer_config_sha256", "observer_executable_sha256", "observer_id",
            "observer_runtime_review_sha256", "provider_class", "provider_endpoint",
            "provider_settlement_sha256", "schema", "stage",
        }
        evidence_path = run_root / f"mutation-reconciliation-evidence-{receipt_sha256}.json"
        try:
            evidence_raw = evidence_path.read_bytes()
            evidence = json.loads(evidence_raw)
        except (OSError, json.JSONDecodeError) as exc:
            raise DeploymentError("external acceptance references malformed local evidence") from exc
        evidence_keys = {
            "accepted_commit", "accepted_tree", "indeterminate_receipt_sha256",
            "no_drift_plan_sha256", "output_postconditions_sha256",
            "provider_settlement_sha256", "refresh_only_exit_code",
            "refresh_only_plan_sha256", "refreshed_state_sha256", "schema", "stage",
        }
        settlement_path = MUTATION_SETTLEMENT_ROOT / f"{receipt_sha256}.settlement.json"
        settlement = _external_signed_record(
            settlement_path,
            "fs2-serve.nebius.ai/provider-operation-settlement/v1",
        )
        provider_binding_keys = (
            "authority_id", "key_id", "project_id", "provider_class",
            "provider_endpoint", "observer_id", "observer_executable_sha256",
            "observer_config_sha256", "observer_runtime_review_sha256",
        )
        if (
            set(payload) != expected_keys
            or payload["accepted_commit"] != os.environ["FS2_CAPSULE_ACCEPTED_COMMIT"]
            or payload["accepted_tree"] != os.environ["FS2_CAPSULE_ACCEPTED_TREE"]
            or payload["indeterminate_receipt_sha256"] != receipt_sha256
            or payload["stage"] != record.get("stage")
            or not evidence_path.is_file()
            or evidence_path.is_symlink()
            or hashlib.sha256(evidence_raw).hexdigest() != payload["evidence_sha256"]
            or not isinstance(evidence, dict)
            or set(evidence) != evidence_keys
            or evidence["schema"] != "fs2-serve.nebius.ai/terraform-mutation-reconciliation-evidence/v2"
            or evidence["accepted_commit"] != payload["accepted_commit"]
            or evidence["accepted_tree"] != payload["accepted_tree"]
            or evidence["indeterminate_receipt_sha256"] != receipt_sha256
            or evidence["stage"] != record.get("stage")
            or payload["provider_settlement_sha256"] != evidence["provider_settlement_sha256"]
            or hashlib.sha256(settlement_path.read_bytes()).hexdigest()
            != evidence["provider_settlement_sha256"]
            or any(payload[key] != settlement.get(key) for key in provider_binding_keys)
            or settlement.get("indeterminate_receipt_sha256") != receipt_sha256
            or settlement.get("stage") != record.get("stage")
            or evidence["refresh_only_exit_code"] not in {0, 2}
            or any(
                not isinstance(evidence[key], str)
                or re.fullmatch(r"[a-f0-9]{64}", evidence[key]) is None
                or evidence[key] == "0" * 64
                for key in (
                    "no_drift_plan_sha256",
                    "output_postconditions_sha256",
                    "provider_settlement_sha256",
                    "refresh_only_plan_sha256",
                    "refreshed_state_sha256",
                )
            )
        ):
            raise DeploymentError("external reconciliation acceptance does not bind exact local evidence")
        result.add(receipt_sha256)
    return result


def unresolved_mutation_records(
    run_root: Path,
) -> list[tuple[Path, dict[str, Any], str]]:
    resolved = reconciled_mutation_digests(run_root)
    return [
        item for item in indeterminate_mutation_records(run_root) if item[2] not in resolved
    ]


def require_reconciled_mutations(run_root: Path) -> None:
    pending = unresolved_mutation_records(run_root)
    if pending:
        raise DeploymentError(
            f"{len(pending)} Terraform mutation(s) have indeterminate state; run the "
            "accepted reconcile command and re-plan before mutation"
        )


def record_mutation_started(
    run_root: Path,
    *,
    stage: str,
    root: Path,
    operation: str,
    command: Sequence[str],
    authority_path: Path,
    authority_details: os.stat_result,
    authority_sha256: str,
    reconciliation_of: str | None,
) -> dict[str, Any]:
    if re.fullmatch(r"[a-z][a-z0-9-]{2,63}", operation) is None:
        raise DeploymentError("mutation operation kind is malformed")
    if re.fullmatch(r"[a-f0-9]{64}", authority_sha256) is None:
        raise DeploymentError("mutation authority digest is malformed")
    started_at = int(time.time())
    attempt_id = f"{started_at}-{time.time_ns()}-{os.getpid()}"
    record = {
        "accepted_commit": os.environ["FS2_CAPSULE_ACCEPTED_COMMIT"],
        "accepted_tree": os.environ["FS2_CAPSULE_ACCEPTED_TREE"],
        "attempt_id": attempt_id,
        "authority_device": authority_details.st_dev,
        "authority_gid": authority_details.st_gid,
        "authority_inode": authority_details.st_ino,
        "authority_mode": stat.S_IMODE(authority_details.st_mode),
        "authority_path": str(authority_path),
        "authority_sha256": authority_sha256,
        "authority_size": authority_details.st_size,
        "authority_uid": authority_details.st_uid,
        "command_sha256": hashlib.sha256(_canonical_bytes(list(command))).hexdigest(),
        "maximum_mutation_seconds": MAXIMUM_MUTATION_SECONDS,
        "operation": operation,
        "reconciliation_of": reconciliation_of,
        "root": str(root),
        "schema": "fs2-serve.nebius.ai/fenced-mutation-started/v3",
        "stage": stage,
        "started_at_unix": started_at,
    }
    # The external root-owned signed ledger is the authority. The local file is
    # only a durable operator-readable cache and is never used to clear a fence.
    ledger_payload, receipt_sha256 = _request_mutation_ledger_event(
        action="started",
        attempt_id=attempt_id,
        run_root=run_root,
        stage=stage,
        record=record,
    )
    append_only_private_json(
        run_root / f"mutation-started-{attempt_id}.json",
        {
            **record,
            "external_ledger_entry_sha256": ledger_payload["entry_sha256"],
            "external_ledger_receipt_sha256": receipt_sha256,
        },
    )
    return {
        "attempt_id": attempt_id,
        "ledger_payload": ledger_payload,
        "record": record,
        "receipt_sha256": receipt_sha256,
    }


