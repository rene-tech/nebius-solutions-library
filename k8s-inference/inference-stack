class DeploymentError(RuntimeError):
    """A bounded, user-actionable deployment failure."""


def enter_accepted_capsule(argv: Sequence[str]) -> None:
    """Re-exec an apply through the installed, accepted release capsule.

    This function performs no parsing, external execution, or run-root write.
    The fixed launcher chooses the accepted source and all executable bytes.
    The mutable checkout supplies only operator arguments and environment
    *selectors*. The launcher retains ambient secret values in a separate
    broker process; the accepted source can request only the four logical
    secret slots selected by its exact deployment contract.
    """

    if (
        not argv
        or argv[0] not in CAPSULE_COMMANDS
        or os.environ.get("FS2_CAPSULE_LAUNCHER")
    ):
        return
    if not CAPSULE_LAUNCHER.is_file():
        raise DeploymentError(
            "operator commands require the independently installed public-edge execution "
            "capsule; follow docs/security/public-edge-execution-capsule.md"
        )
    local_read_only = argv[0] in LOCAL_READ_ONLY_COMMANDS
    forwarded = list(argv)
    if not local_read_only and not any(
        value == "--var-file" or value.startswith("--var-file=")
        for value in forwarded
    ):
        forwarded.extend(["--var-file", str(DEPLOY_ROOT / "terraform.tfvars")])
    if not local_read_only and not any(
        value == "--nebius-profile" or value.startswith("--nebius-profile=")
        for value in forwarded
    ) and os.environ.get("NEBIUS_PROFILE"):
        forwarded.extend(["--nebius-profile", os.environ["NEBIUS_PROFILE"]])
    command = [
        str(CAPSULE_LAUNCHER),
        "inference-stack",
        "operator",
        "--",
        *forwarded,
    ]
    try:
        os.execv(command[0], command)
    except OSError as exc:
        raise DeploymentError("cannot enter the accepted public-edge capsule") from exc


def load_capsule_contract() -> None:
    """Validate the inherited capsule proof and pin subprocess descriptors."""

    global CAPSULE_NEBIUS_AUTH
    global CAPSULE_NEBIUS_AUTH_ENVELOPE
    global CAPSULE_AUTH_REFRESH_FD
    global CAPSULE_ACCESS_MODE
    global CAPSULE_PASS_FDS
    global CAPSULE_SECRET_BROKER_FD
    if os.environ.get("FS2_CAPSULE_LAUNCHER") != "fs2-public-edge-capsule-v1":
        raise DeploymentError("accepted capsule launcher proof is absent")
    if os.getegid() == os.getgid() or os.getegid() in os.getgroups():
        raise DeploymentError("accepted capsule no-member setgid proof is absent")
    accepted_commit = os.environ.get("FS2_CAPSULE_ACCEPTED_COMMIT", "")
    accepted_tree = os.environ.get("FS2_CAPSULE_ACCEPTED_TREE", "")
    manifest_sha256 = os.environ.get("FS2_CAPSULE_MANIFEST_SHA256", "")
    source_sha256 = os.environ.get("FS2_CAPSULE_SOURCE_SHA256", "")
    if not all(
        re.fullmatch(pattern, value)
        for pattern, value in (
            (r"[a-f0-9]{40}", accepted_commit),
            (r"[a-f0-9]{40}", accepted_tree),
            (r"[a-f0-9]{64}", manifest_sha256),
            (r"[a-f0-9]{64}", source_sha256),
        )
    ):
        raise DeploymentError("accepted capsule identity is malformed")
    if hashlib.sha256(Path(__file__).read_bytes()).hexdigest() != source_sha256:
        raise DeploymentError("running inference-stack differs from accepted bytes")
    try:
        raw_paths = json.loads(os.environ["FS2_CAPSULE_TOOL_PATHS_JSON"])
        raw_fds = os.environ["FS2_CAPSULE_PASS_FDS"].split(",")
    except (KeyError, json.JSONDecodeError) as exc:
        raise DeploymentError("accepted capsule descriptor contract is absent") from exc
    if not isinstance(raw_paths, dict) or not CAPSULE_TOOL_NAMES.issubset(raw_paths):
        raise DeploymentError("accepted capsule tool set is incomplete")
    parsed_fds: list[int] = []
    for value in raw_fds:
        if not value.isdecimal() or int(value) < 3:
            raise DeploymentError("accepted capsule descriptor set is malformed")
        descriptor = int(value)
        os.fstat(descriptor)
        parsed_fds.append(descriptor)
    for name in CAPSULE_TOOL_NAMES:
        path = raw_paths[name]
        if not isinstance(path, str) or not re.fullmatch(r"/proc/self/fd/[0-9]+", path):
            raise DeploymentError(f"accepted capsule tool {name} is not descriptor-pinned")
        if int(path.rsplit("/", 1)[1]) not in parsed_fds:
            raise DeploymentError(f"accepted capsule tool {name} descriptor is not inherited")
        CAPSULE_TOOL_PATHS[name] = path
    for source_name in ("internal-edge-acceptance", "internal-edge-proxy"):
        key = f"source:{source_name}"
        path = raw_paths.get(key)
        if not isinstance(path, str) or re.fullmatch(r"/proc/self/fd/[0-9]+", path) is None:
            raise DeploymentError(
                f"accepted capsule source {source_name} is not descriptor-pinned"
            )
        if int(path.rsplit("/", 1)[1]) not in parsed_fds:
            raise DeploymentError(
                f"accepted capsule source {source_name} descriptor is not inherited"
            )
        CAPSULE_TOOL_PATHS[key] = path
    cli_config = raw_paths.get("terraform_cli_config")
    if not isinstance(cli_config, str) or not re.fullmatch(
        r"/proc/self/fd/[0-9]+", cli_config
    ):
        raise DeploymentError("accepted Terraform CLI configuration is not sealed")
    if int(cli_config.rsplit("/", 1)[1]) not in parsed_fds:
        raise DeploymentError("accepted Terraform CLI descriptor is not inherited")
    CAPSULE_TOOL_PATHS["terraform_cli_config"] = cli_config
    tool_bin = raw_paths.get("tool_bin")
    if not isinstance(tool_bin, str) or not tool_bin.startswith("/opt/fs2/"):
        raise DeploymentError("accepted capsule tool bin is absent")
    CAPSULE_TOOL_PATHS["tool_bin"] = tool_bin
    settlement_trust = raw_paths.get("mutation_settlement_trust")
    if not isinstance(settlement_trust, str) or re.fullmatch(
        r"/proc/self/fd/[0-9]+", settlement_trust
    ) is None:
        raise DeploymentError("mutation-settlement trust registry is not descriptor-pinned")
    if int(settlement_trust.rsplit("/", 1)[1]) not in parsed_fds:
        raise DeploymentError("mutation-settlement trust descriptor is not inherited")
    CAPSULE_TOOL_PATHS["mutation_settlement_trust"] = settlement_trust
    debug_activation_trust = raw_paths.get("internal_debug_activation_trust")
    if not isinstance(debug_activation_trust, str) or re.fullmatch(
        r"/proc/self/fd/[0-9]+", debug_activation_trust
    ) is None:
        raise DeploymentError(
            "internal-debug activation trust registry is not descriptor-pinned"
        )
    if int(debug_activation_trust.rsplit("/", 1)[1]) not in parsed_fds:
        raise DeploymentError(
            "internal-debug activation trust descriptor is not inherited"
        )
    CAPSULE_TOOL_PATHS["internal_debug_activation_trust"] = debug_activation_trust
    access_mode = os.environ.get("FS2_CAPSULE_ACCESS_MODE", "")
    if access_mode not in {"brokered-cloud", "local-read-only"}:
        raise DeploymentError("accepted capsule access mode is absent")
    try:
        secret_broker_fd = int(os.environ["FS2_CAPSULE_SECRET_BROKER_FD"])
    except (KeyError, ValueError) as exc:
        raise DeploymentError("capsule operator identity handoff is absent") from exc
    if (
        secret_broker_fd < 3
        or not stat.S_ISSOCK(os.fstat(secret_broker_fd).st_mode)
        or secret_broker_fd not in parsed_fds
    ):
        raise DeploymentError("operator secret broker descriptor is not inherited")
    CAPSULE_SECRET_BROKER_FD = secret_broker_fd
    CAPSULE_ACCESS_MODE = access_mode
    if access_mode == "local-read-only":
        forbidden_auth = {
            "FS2_CAPSULE_NEBIUS_AUTH_JSON",
            "FS2_CAPSULE_DELEGATED_AUTH_FD",
            "FS2_CAPSULE_DELEGATED_AUTH_ENVELOPE",
            "FS2_CAPSULE_AUTH_REFRESH_FD",
        }
        if "nebius_token" in raw_paths or any(name in os.environ for name in forbidden_auth):
            raise DeploymentError("local read-only capsule unexpectedly carries cloud authority")
        CAPSULE_PASS_FDS = tuple(sorted(set(parsed_fds) - {secret_broker_fd}))
        return
    token_path = raw_paths.get("nebius_token")
    if not isinstance(token_path, str) or not re.fullmatch(
        r"/proc/self/fd/[0-9]+", token_path
    ):
        raise DeploymentError("brokered Nebius token descriptor is absent")
    token_fd = int(token_path.rsplit("/", 1)[1])
    if token_fd not in parsed_fds:
        raise DeploymentError("brokered Nebius token descriptor is not inherited")
    CAPSULE_TOOL_PATHS["nebius_token"] = token_path
    try:
        authentication = json.loads(os.environ["FS2_CAPSULE_NEBIUS_AUTH_JSON"])
        envelope = os.environ["FS2_CAPSULE_DELEGATED_AUTH_ENVELOPE"]
        auth_refresh_fd = int(os.environ["FS2_CAPSULE_AUTH_REFRESH_FD"])
    except (KeyError, ValueError, json.JSONDecodeError) as exc:
        raise DeploymentError("capsule cloud authentication handoff is absent") from exc
    if not isinstance(authentication, dict) or set(authentication) != {
        "accepted_commit",
        "accepted_tree",
        "audience",
        "authority_id",
        "broker_config_sha256",
        "broker_executable_sha256",
        "caller_effective_gid",
        "caller_real_gid",
        "caller_uid",
        "endpoint",
        "expires_at",
        "issued_at",
        "key_id",
        "manifest_sha256",
        "operator_identity",
        "peer_credential_mode",
        "peer_observed_caller_gid",
        "peer_observed_caller_uid",
        "profile",
        "project_id",
        "request_nonce",
        "schema",
        "subject_id",
        "tenant_id",
        "token_sha256",
    }:
        raise DeploymentError("capsule authentication metadata is malformed")
    if (
        authentication["schema"]
        != "fs2-serve.nebius.ai/short-lived-nebius-auth/v3"
        or authentication["accepted_commit"] != accepted_commit
        or authentication["accepted_tree"] != accepted_tree
        or authentication["manifest_sha256"] != manifest_sha256
        or authentication["audience"] != "fs2-public-edge-operator"
        or authentication["endpoint"] != "api.nebius.cloud"
        or authentication["caller_uid"] != os.getuid()
        or authentication["caller_real_gid"] != os.getgid()
        or authentication["caller_effective_gid"] != os.getegid()
        or authentication["peer_observed_caller_uid"] != os.getuid()
        or authentication["peer_observed_caller_gid"] != os.getgid()
        or not isinstance(authentication["operator_identity"], str)
        or re.fullmatch(r"[a-z][a-z0-9._-]{2,127}", authentication["operator_identity"])
        is None
        or not isinstance(authentication["expires_at"], int)
        or authentication["expires_at"] - int(time.time()) < 2 * 60 * 60
        or not isinstance(envelope, str)
        or not envelope
        or auth_refresh_fd < 3
        or not stat.S_ISSOCK(os.fstat(auth_refresh_fd).st_mode)
    ):
        raise DeploymentError("capsule authentication handoff is not current and exact")
    if auth_refresh_fd not in parsed_fds:
        raise DeploymentError("Nebius auth refresh descriptor is not inherited")
    CAPSULE_NEBIUS_AUTH = authentication
    CAPSULE_NEBIUS_AUTH_ENVELOPE = envelope
    CAPSULE_AUTH_REFRESH_FD = auth_refresh_fd
    CAPSULE_PASS_FDS = tuple(
        sorted(set(parsed_fds) - {auth_refresh_fd, secret_broker_fd, token_fd})
    )


def brokered_auth_pass_fds(
    environment: Mapping[str, str] | None,
) -> tuple[int, ...]:
    """Return the cloud-token descriptor only for its exact authenticated child."""

    if environment is None or "FS2_CAPSULE_DELEGATED_AUTH_FD" not in environment:
        if environment is not None and "NEBIUS_IAM_TOKEN" in environment:
            raise DeploymentError(
                "a child cannot receive cloud token text without its signed descriptor"
            )
        return ()
    value = environment["FS2_CAPSULE_DELEGATED_AUTH_FD"]
    token_path = CAPSULE_TOOL_PATHS.get("nebius_token", "")
    if (
        not value.isdecimal()
        or token_path != f"/proc/self/fd/{value}"
        or "NEBIUS_IAM_TOKEN" not in environment
        or environment.get("FS2_CAPSULE_DELEGATED_AUTH_ENVELOPE")
        != CAPSULE_NEBIUS_AUTH_ENVELOPE
    ):
        raise DeploymentError("child cloud authority is not the current signed lease")
    descriptor = int(value)
    os.fstat(descriptor)
    return (descriptor,)


def capsule_subprocess_options(
    *,
    environment: Mapping[str, str] | None = None,
    extra_pass_fds: Sequence[int] = (),
) -> dict[str, object]:
    """Pass only immutable capsule descriptors plus explicitly scoped authority."""

    return {
        "pass_fds": tuple(
            sorted(
                {
                    *CAPSULE_PASS_FDS,
                    *brokered_auth_pass_fds(environment),
                    *extra_pass_fds,
                }
            )
        ),
        "close_fds": True,
    }


def command_text(arguments: Sequence[str]) -> str:
    """Return a readable command containing no secret environment values."""
    return " ".join(arguments)


def run(
    arguments: Sequence[str],
    *,
    env: Mapping[str, str] | None = None,
    capture: bool = False,
    input_text: str | None = None,
    extra_pass_fds: Sequence[int] = (),
) -> subprocess.CompletedProcess[str]:
    print(f"+ {command_text(arguments)}", file=sys.stderr)
    try:
        return subprocess.run(
            list(arguments),
            env=dict(env) if env is not None else None,
            input=input_text,
            text=True,
            check=True,
            stdout=subprocess.PIPE if capture else sys.stderr,
            stderr=subprocess.PIPE if capture else None,
            **capsule_subprocess_options(
                environment=env,
                extra_pass_fds=extra_pass_fds,
            ),
        )
    except FileNotFoundError as exc:
        raise DeploymentError(f"required executable not found: {arguments[0]}") from exc
    except subprocess.CalledProcessError as exc:
        if capture and exc.stderr:
            print(exc.stderr.rstrip(), file=sys.stderr)
        raise DeploymentError(
            f"command failed with exit code {exc.returncode}: {command_text(arguments)}"
        ) from exc


def private_directory(path: Path) -> None:
    if path.exists() and (path.is_symlink() or not path.is_dir()):
        raise DeploymentError(f"run root must be a real directory: {path}")
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)


def private_json(path: Path, value: Any) -> None:
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    descriptor = os.open(temporary, flags, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def append_only_private_json(path: Path, value: Any) -> None:
    """Write one durable evidence object without replacement or cleanup."""

    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    raw = json.dumps(value, indent=2, sort_keys=True).encode("utf-8") + b"\n"
    try:
        offset = 0
        while offset < len(raw):
            written = os.write(descriptor, raw[offset:])
            if written <= 0:
                raise DeploymentError("cannot write append-only reconciliation evidence")
            offset += written
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    parent_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(parent_fd)
    finally:
        os.close(parent_fd)


def private_text(path: Path, value: str) -> None:
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(value)
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def clean_environment() -> dict[str, str]:
    """Return the complete, explicit environment for every child process.

    No ambient loader, Python, Terraform, proxy, plugin, credential, profile,
    or caller HOME variable crosses this boundary. Stage-specific secret values
    are copied individually by ``stage_environment`` only after the deployment
    contract names them.
    """

    environment = {
        "HOME": "/nonexistent",
        "PATH": CAPSULE_TOOL_PATHS.get("tool_bin", "/usr/bin:/bin"),
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
    }
    if CAPSULE_TOOL_PATHS:
        environment["TF_CLI_CONFIG_FILE"] = CAPSULE_TOOL_PATHS[
            "terraform_cli_config"
        ]
    return environment


def _sealed_descriptor_bytes(
    descriptor: int, *, label: str, maximum_bytes: int
) -> bytes:
    details = os.fstat(descriptor)
    required_seals = (
        fcntl.F_SEAL_SEAL
        | fcntl.F_SEAL_SHRINK
        | fcntl.F_SEAL_GROW
        | fcntl.F_SEAL_WRITE
    )
    if (
        not stat.S_ISREG(details.st_mode)
        or details.st_size < 1
        or details.st_size > maximum_bytes
        or fcntl.fcntl(descriptor, fcntl.F_GET_SEALS) & required_seals
        != required_seals
    ):
        raise DeploymentError(f"{label} is not one bounded fully sealed descriptor")
    value = os.pread(descriptor, details.st_size, 0)
    after = os.fstat(descriptor)
    if len(value) != details.st_size or (
        details.st_dev,
        details.st_ino,
        details.st_size,
        details.st_ctime_ns,
    ) != (
        after.st_dev,
        after.st_ino,
        after.st_size,
        after.st_ctime_ns,
    ):
        raise DeploymentError(f"{label} changed while read")
    return value


def brokered_nebius_token() -> str:
    """Return only the signed capsule-delivered short-lived token."""

    if not CAPSULE_NEBIUS_AUTH:
        raise DeploymentError("brokered Nebius authentication is absent")
    if CAPSULE_NEBIUS_AUTH["expires_at"] - int(time.time()) < 2 * 60 * 60:
        raise DeploymentError(
            "brokered Nebius authentication has less than two hours remaining; "
            "start a new accepted capsule command"
        )
    descriptor = int(CAPSULE_TOOL_PATHS["nebius_token"].rsplit("/", 1)[1])
    value = _sealed_descriptor_bytes(
        descriptor, label="brokered Nebius IAM token", maximum_bytes=64 * 1024
    )
    if hashlib.sha256(value).hexdigest() != CAPSULE_NEBIUS_AUTH["token_sha256"]:
        raise DeploymentError("brokered Nebius token differs from its signed envelope")
    try:
        token = value.decode("ascii")
    except UnicodeDecodeError as exc:
        raise DeploymentError("brokered Nebius token is not ASCII") from exc
    if not token or any(character.isspace() for character in token):
        raise DeploymentError("brokered Nebius token is empty or contains whitespace")
    return token


def refresh_brokered_auth() -> None:
    """Replace the stable token descriptor with one freshly brokered lease."""

    global CAPSULE_NEBIUS_AUTH
    global CAPSULE_NEBIUS_AUTH_ENVELOPE
    if CAPSULE_AUTH_REFRESH_FD < 3:
        raise DeploymentError("Nebius auth refresh agent is absent")
    broker = socket.socket(fileno=CAPSULE_AUTH_REFRESH_FD)
    try:
        broker.sendall(b"\x01")
        ancillary_size = socket.CMSG_SPACE(array.array("i", [0]).itemsize)
        envelope_raw, ancillary, flags, _address = broker.recvmsg(
            128 * 1024 + 1, ancillary_size
        )
    finally:
        broker.detach()
    if flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC) or len(envelope_raw) > 128 * 1024:
        raise DeploymentError("Nebius auth refresh response is truncated or oversized")
    descriptors: list[int] = []
    for level, kind, data in ancillary:
        if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
            values = array.array("i")
            values.frombytes(data[: len(data) - (len(data) % values.itemsize)])
            descriptors.extend(values.tolist())
    if len(descriptors) != 1:
        for descriptor in descriptors:
            os.close(descriptor)
        raise DeploymentError("Nebius auth refresh did not return one sealed token")
    refreshed_fd = descriptors[0]
    try:
        token_bytes = _sealed_descriptor_bytes(
            refreshed_fd,
            label="refreshed Nebius IAM token",
            maximum_bytes=64 * 1024,
        )
        envelope = json.loads(envelope_raw.decode("utf-8"))
        if not isinstance(envelope, dict) or set(envelope) != {"payload", "signature"}:
            raise DeploymentError("refreshed Nebius auth envelope is malformed")
        payload = envelope["payload"]
        if not isinstance(payload, dict) or set(payload) != set(CAPSULE_NEBIUS_AUTH):
            raise DeploymentError("refreshed Nebius auth payload schema changed")
        if (
            payload["schema"] != "fs2-serve.nebius.ai/short-lived-nebius-auth/v3"
            or payload["accepted_commit"] != CAPSULE_NEBIUS_AUTH["accepted_commit"]
            or payload["accepted_tree"] != CAPSULE_NEBIUS_AUTH["accepted_tree"]
            or payload["manifest_sha256"] != CAPSULE_NEBIUS_AUTH["manifest_sha256"]
            or payload["authority_id"] != CAPSULE_NEBIUS_AUTH["authority_id"]
            or payload["key_id"] != CAPSULE_NEBIUS_AUTH["key_id"]
            or payload["profile"] != CAPSULE_NEBIUS_AUTH["profile"]
            or payload["caller_uid"] != os.getuid()
            or payload["caller_real_gid"] != os.getgid()
            or payload["caller_effective_gid"] != os.getegid()
            or payload["peer_observed_caller_uid"] != os.getuid()
            or payload["peer_observed_caller_gid"] != os.getgid()
            or payload["operator_identity"] != CAPSULE_NEBIUS_AUTH["operator_identity"]
            or payload["subject_id"] != CAPSULE_NEBIUS_AUTH["subject_id"]
            or payload["project_id"] != CAPSULE_NEBIUS_AUTH["project_id"]
            or payload["tenant_id"] != CAPSULE_NEBIUS_AUTH["tenant_id"]
            or payload["broker_executable_sha256"]
            != CAPSULE_NEBIUS_AUTH["broker_executable_sha256"]
            or payload["broker_config_sha256"]
            != CAPSULE_NEBIUS_AUTH["broker_config_sha256"]
            or payload["peer_credential_mode"]
            != CAPSULE_NEBIUS_AUTH["peer_credential_mode"]
            or payload["expires_at"] - int(time.time()) < 2 * 60 * 60
            or payload["token_sha256"] != hashlib.sha256(token_bytes).hexdigest()
        ):
            raise DeploymentError("refreshed Nebius auth lease changed accepted authority")
        stable_fd = int(CAPSULE_TOOL_PATHS["nebius_token"].rsplit("/", 1)[1])
        os.dup2(refreshed_fd, stable_fd, inheritable=True)
        CAPSULE_NEBIUS_AUTH = payload
        CAPSULE_NEBIUS_AUTH_ENVELOPE = base64.urlsafe_b64encode(
            envelope_raw
        ).rstrip(b"=").decode("ascii")
    except (UnicodeDecodeError, json.JSONDecodeError, KeyError, TypeError) as exc:
        raise DeploymentError("refreshed Nebius auth response is invalid") from exc
    finally:
        os.close(refreshed_fd)


def brokered_auth_environment(
    environment: Mapping[str, str] | None = None,
) -> dict[str, str]:
    """Add only the capsule-verified token and its delegated signed proof."""

    refresh_brokered_auth()
    result = dict(environment) if environment is not None else clean_environment()
    token_fd = CAPSULE_TOOL_PATHS["nebius_token"].rsplit("/", 1)[1]
    result["NEBIUS_IAM_TOKEN"] = brokered_nebius_token()
    result["FS2_CAPSULE_NEBIUS_PROFILE"] = CAPSULE_NEBIUS_AUTH["profile"]
    result["FS2_CAPSULE_DELEGATED_AUTH_FD"] = token_fd
    result["FS2_CAPSULE_DELEGATED_AUTH_ENVELOPE"] = CAPSULE_NEBIUS_AUTH_ENVELOPE
    return result


def require_brokered_profile(profile: str) -> None:
    if (
        re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", profile) is None
        or CAPSULE_NEBIUS_AUTH.get("profile") != profile
    ):
        raise DeploymentError(
            "the selected Nebius profile differs from the signed capsule auth authority"
        )


def require_brokered_target(project_id: str) -> None:
    """Keep a profile-scoped lease from crossing its enrolled cloud project."""

    if CAPSULE_NEBIUS_AUTH.get("project_id") != project_id:
        raise DeploymentError(
            "the target project differs from the signed profile/subject authority"
        )


def operator_secret(slot: str, environment_name: str) -> str | None:
    """Resolve one contract-selected secret as one sealed broker descriptor."""

    if slot not in {
        "grafana_username",
        "grafana_password",
        "ngc_api_key",
        "nvcr_dockerconfig",
    }:
        raise DeploymentError("operator secret slot is outside the four-slot contract")
    if re.fullmatch(r"[A-Z][A-Z0-9_]{2,127}", environment_name) is None or (
        environment_name.startswith(
            (
                "LD_",
                "DYLD_",
                "PYTHON",
                "TF_",
                "NEBIUS_",
                "FS2_CAPSULE_",
                "AWS_",
                "GITHUB_",
                "OPENAI_",
            )
        )
        or environment_name in {"HOME", "PATH"}
        or "PROXY" in environment_name
    ):
        raise DeploymentError("operator secret environment reference is unsafe")
    cache_key = f"{slot}:{environment_name}"
    if cache_key in CAPSULE_SECRET_VALUES:
        return CAPSULE_SECRET_VALUES[cache_key]
    if CAPSULE_SECRET_BROKER_FD < 3:
        raise DeploymentError("operator secret broker descriptor is absent")
    request = slot.encode("ascii") + b"\0" + environment_name.encode("ascii") + b"\0"
    broker = socket.socket(fileno=CAPSULE_SECRET_BROKER_FD)
    try:
        broker.sendall(request)
        ancillary_size = socket.CMSG_SPACE(array.array("i", [0]).itemsize)
        response, ancillary, flags, _address = broker.recvmsg(1, ancillary_size)
    finally:
        broker.detach()
    if flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC) or response not in {b"\0", b"\1"}:
        raise DeploymentError("operator secret broker returned a malformed response")
    descriptors: list[int] = []
    for level, kind, data in ancillary:
        if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
            values = array.array("i")
            values.frombytes(data[: len(data) - (len(data) % values.itemsize)])
            descriptors.extend(values.tolist())
    if response == b"\0":
        if descriptors:
            for descriptor in descriptors:
                os.close(descriptor)
            raise DeploymentError("absent operator secret unexpectedly included a descriptor")
        CAPSULE_SECRET_VALUES[cache_key] = None
        return None
    if len(descriptors) != 1:
        for descriptor in descriptors:
            os.close(descriptor)
        raise DeploymentError("operator secret broker did not return one descriptor")
    descriptor = descriptors[0]
    try:
        raw = _sealed_descriptor_bytes(
            descriptor,
            label=f"operator secret slot {slot}",
            maximum_bytes=1024 * 1024,
        )
        value = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise DeploymentError(f"operator secret slot {slot} is not UTF-8") from exc
    finally:
        os.close(descriptor)
    CAPSULE_SECRET_VALUES[cache_key] = value
    return value


def require_protected_apply_start() -> None:
    """Reject operator execution outside the installed accepted capsule."""

    source_bytes = Path(__file__).read_bytes()
    source_sha256 = hashlib.sha256(source_bytes).hexdigest()
    forbidden = sorted(
        key
        for key in os.environ
        if key.startswith(("LD_", "DYLD_", "PYTHON", "TF_CLI_ARGS"))
        or key
        in {
            "TF_PLUGIN_CACHE_DIR",
            "TF_REATTACH_PROVIDERS",
            "TF_WORKSPACE",
        }
    )
    if (
        os.environ.get("FS2_CAPSULE_LAUNCHER") != "fs2-public-edge-capsule-v1"
        or CAPSULE_ACCESS_MODE != "brokered-cloud"
        or os.environ.get("FS2_CAPSULE_SOURCE_ID") != "inference-stack"
        or os.environ.get("FS2_CAPSULE_SOURCE_SHA256") != source_sha256
        or os.getegid() == os.getgid()
        or os.getegid() in os.getgroups()
        or not CAPSULE_TOOL_NAMES.issubset(CAPSULE_TOOL_PATHS)
        or "nebius_token" not in CAPSULE_TOOL_PATHS
        or not CAPSULE_NEBIUS_AUTH
        or not CAPSULE_NEBIUS_AUTH_ENVELOPE
        or CAPSULE_SECRET_BROKER_FD < 3
        or not CAPSULE_PASS_FDS
        or sys.flags.isolated != 1
        or not sys.dont_write_bytecode
        or forbidden
    ):
        raise DeploymentError(
            "operator execution requires the fixed root-owned accepted release capsule, "
            "its no-member setgid child proof, exact source/tool/provider "
            "descriptors, isolated/no-bytecode Python, and no ambient loader "
            "or Terraform plugin controls"
        )


def require_protected_read_only_start(command: str) -> None:
    """Authenticate local debugging without acquiring any cloud mutation authority."""

    source_sha256 = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    forbidden = sorted(
        key
        for key in os.environ
        if key.startswith(("LD_", "DYLD_", "PYTHON", "TF_CLI_ARGS"))
        or key
        in {
            "TF_PLUGIN_CACHE_DIR",
            "TF_REATTACH_PROVIDERS",
            "TF_WORKSPACE",
        }
    )
    if (
        command not in LOCAL_READ_ONLY_COMMANDS
        or CAPSULE_ACCESS_MODE != "local-read-only"
        or os.environ.get("FS2_CAPSULE_LAUNCHER") != "fs2-public-edge-capsule-v1"
        or os.environ.get("FS2_CAPSULE_SOURCE_ID") != "inference-stack"
        or os.environ.get("FS2_CAPSULE_SOURCE_SHA256") != source_sha256
        or os.getegid() == os.getgid()
        or os.getegid() in os.getgroups()
        or not CAPSULE_TOOL_NAMES.issubset(CAPSULE_TOOL_PATHS)
        or "nebius_token" in CAPSULE_TOOL_PATHS
        or CAPSULE_NEBIUS_AUTH
        or CAPSULE_NEBIUS_AUTH_ENVELOPE
        or CAPSULE_AUTH_REFRESH_FD >= 0
        or CAPSULE_SECRET_BROKER_FD < 3
        or not CAPSULE_PASS_FDS
        or sys.flags.isolated != 1
        or not sys.dont_write_bytecode
        or forbidden
    ):
        raise DeploymentError(
            "local inspection and debug activation require the fixed accepted "
            "capsule's authenticated no-cloud-authority mode"
        )


def require_public_edge_protected_start(contract: Mapping[str, Any]) -> None:
    """Retain an explicit contract-local guard for the public edge path."""

    infrastructure = contract.get("stages", {}).get("infrastructure", {})
    if isinstance(infrastructure, Mapping) and infrastructure.get(
        "public_edge_mode"
    ) == "public":
        require_protected_apply_start()


# Write-only Secret arguments (`data_wo`) are a Terraform 1.11 feature. On an
# older binary they are silently unknown attributes, which would put credential
# material back into state, so the whole flow refuses to run below 1.11.
MINIMUM_TERRAFORM_VERSION = (1, 11, 0)
MAXIMUM_MUTATION_SECONDS = 90 * 60


def require_terraform_version(terraform: str) -> tuple[int, int, int]:
    """Fail closed unless the binary supports write-only resource arguments."""

    result = subprocess.run(
        [terraform, "version", "-json"],
        capture_output=True,
        text=True,
        env=clean_environment(),
        **capsule_subprocess_options(),
    )
    if result.returncode != 0:
        raise DeploymentError(f"cannot determine the Terraform version using {terraform!r}")
    try:
        raw = json.loads(result.stdout)["terraform_version"]
        version = tuple(int(part) for part in raw.split("-")[0].split(".")[:3])
    except (KeyError, ValueError, json.JSONDecodeError) as error:
        raise DeploymentError("Terraform reported an unreadable version") from error
    if len(version) != 3 or version < MINIMUM_TERRAFORM_VERSION:
        wanted = ".".join(str(part) for part in MINIMUM_TERRAFORM_VERSION)
        raise DeploymentError(
            f"Terraform {raw} is too old; write-only Secret data requires {wanted} or newer"
        )
    return version  # type: ignore[return-value]


def terraform_environment(run_root: Path, stage: str) -> dict[str, str]:
    if CAPSULE_ACCESS_MODE == "local-read-only":
        raise DeploymentError(
            "local read-only support must parse retained state without Terraform initialization"
        )
    environment = clean_environment()
    environment = brokered_auth_environment(environment)
    data_directory = run_root / "terraform-data" / stage
    private_directory(data_directory)
    environment["TF_DATA_DIR"] = str(data_directory)
    environment["TF_IN_AUTOMATION"] = "1"
    return environment


def terraform_init(
    terraform: str,
    root: Path,
    backend: Path,
    environment: Mapping[str, str],
) -> None:
    if backend.is_symlink():
        raise DeploymentError(
            f"Terraform backend path must not be a symlink: {backend}"
        )
    run(
        [
            terraform,
            f"-chdir={root}",
            "init",
            "-input=false",
            "-reconfigure",
            f"-backend-config=path={backend}",
        ],
        env=environment,
    )


def validate_stage_roots(terraform: str, run_root: Path) -> None:
    for stage in ("infrastructure", "foundation", "workloads"):
        environment = terraform_environment(run_root, f"validate-{stage}")
        root = stage_root(stage)
        run(
            [
                terraform,
                f"-chdir={root}",
                "init",
                "-backend=false",
                "-input=false",
            ],
            env=environment,
        )
        run(
            [terraform, f"-chdir={root}", "validate", "-no-color"],
            env=environment,
        )


def terraform_json_output(
    terraform: str,
    root: Path,
    name: str,
    environment: Mapping[str, str],
) -> Any:
    result = run(
        [terraform, f"-chdir={root}", "output", "-json", name],
        env=environment,
        capture=True,
    )
    return json.loads(result.stdout)


def terraform_optional_json_output(
    terraform: str,
    root: Path,
    name: str,
    environment: Mapping[str, str],
) -> Any | None:
    """Read an output that Terraform legitimately omits when its value is null."""
    result = run(
        [terraform, f"-chdir={root}", "output", "-json"],
        env=environment,
        capture=True,
    )
    outputs = json.loads(result.stdout)
    output = outputs.get(name)
    if output is None:
        return None
    if not isinstance(output, dict) or "value" not in output:
        raise DeploymentError(f"Terraform returned malformed output {name!r}")
    return output["value"]


def state_addresses(
    terraform: str,
    root: Path,
    environment: Mapping[str, str],
) -> list[str]:
    result = subprocess.run(
        [terraform, f"-chdir={root}", "state", "list"],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
        **capsule_subprocess_options(environment=environment),
    )
    if result.returncode != 0:
        return []
    return [line for line in result.stdout.splitlines() if line.strip()]


def plan_json(
    terraform: str,
    *,
    root: Path,
    environment: Mapping[str, str],
    variable_file: Path,
    plan_path: Path,
    json_path: Path,
    destroy: bool = False,
) -> dict[str, Any]:
    if plan_path.is_symlink() or json_path.is_symlink():
        raise DeploymentError("plan and plan JSON paths must not be symlinks")
    arguments = [
        terraform,
        f"-chdir={root}",
        "plan",
        "-input=false",
        "-lock=true",
        f"-var-file={variable_file}",
        f"-out={plan_path}",
    ]
    if destroy:
        arguments.insert(3, "-destroy")
    run(arguments, env=environment)
    plan_path.chmod(0o600)
    result = run(
        [terraform, f"-chdir={root}", "show", "-json", str(plan_path)],
        env=environment,
        capture=True,
    )
    private_text(json_path, result.stdout)
    return json.loads(result.stdout)


def planned_output(document: Mapping[str, Any], name: str) -> Any:
    try:
        return document["planned_values"]["outputs"][name]["value"]
    except (KeyError, TypeError) as exc:
        raise DeploymentError(
            f"configuration plan did not produce output {name!r}"
        ) from exc


def plan_changes_managed_resources_or_outputs(document: Mapping[str, Any]) -> bool:
    """Return whether a stage handoff must converge before its consumer plans."""
    unchanged_actions = (["no-op"], ["read"])
    for resource in document.get("resource_changes", []):
        if resource.get("mode", "managed") != "managed":
            continue
        actions = resource.get("change", {}).get("actions", [])
        if actions not in unchanged_actions:
            return True
    for output in document.get("output_changes", {}).values():
        actions = output.get("actions", [])
        if actions not in unchanged_actions:
            return True
    return False


def source_commit() -> str:
    accepted = os.environ.get("FS2_CAPSULE_ACCEPTED_COMMIT")
    if CAPSULE_TOOL_PATHS:
        if accepted is None or re.fullmatch(r"[a-f0-9]{40}", accepted) is None:
            raise DeploymentError("accepted capsule commit identity is absent")
        return accepted
    result = run(
        ["git", "-C", str(REPOSITORY_ROOT), "rev-parse", "HEAD"],
        capture=True,
        env=clean_environment(),
    )
    commit = result.stdout.strip()
    if len(commit) != 40 or any(
        character not in "0123456789abcdef" for character in commit
    ):
        raise DeploymentError(
            "the source checkout does not have an exact Git commit identity"
        )
    return commit


def default_run_root(variable_file: Path) -> Path:
    identity = hashlib.sha256(str(variable_file.resolve()).encode()).hexdigest()[:12]
    state_home = os.environ.get("XDG_STATE_HOME")
    try:
        account_home = Path(pwd.getpwuid(os.getuid()).pw_dir)
    except KeyError as error:
        raise DeploymentError("invoking user has no canonical passwd home") from error
    base = Path(state_home) if state_home else account_home / ".local" / "state"
    return base / "nebius-k8s-inference" / identity


def validate_configuration(
    terraform: str,
    variable_file: Path,
    run_root: Path,
) -> tuple[dict[str, Any], dict[str, str]]:
    environment = terraform_environment(run_root, "configuration")
    backend = run_root / "configuration.tfstate"
    terraform_init(terraform, DEPLOY_ROOT, backend, environment)
    document = plan_json(
        terraform,
        root=DEPLOY_ROOT,
        environment=environment,
        variable_file=variable_file,
        plan_path=run_root / "configuration.tfplan",
        json_path=run_root / "configuration.plan.json",
    )
    contract = planned_output(document, "deployment_contract")
    private_json(run_root / "deployment-contract.json", contract)
    return contract, environment


def preflight_accelerators(
    args: argparse.Namespace,
    contract: Mapping[str, Any],
) -> None:
    """Validate project-local platform, preset, capacity, and driver facts live."""
    pools = contract["stages"]["infrastructure"].get("custom_accelerator_pools", {})
    if not pools:
        raise DeploymentError(
            "live preflight requires deployment.accelerator_pools; checked-in profile pools are evidence-backed but not a substitute for current capacity"
        )

    project_id = contract["target"]["project_id"]
    target_region = contract["target"]["region"]
    kubernetes_version = contract["stages"]["infrastructure"]["kubernetes_version"]
    checked: list[dict[str, Any]] = []
    for pool_id, pool in sorted(pools.items()):
        platform_result = run(
            [
                args.nebius,
                "compute",
                "platform",
                "get-by-name",
                "--parent-id",
                project_id,
                "--name",
                pool["platform"],
                "--format",
                "json",
            ],
            capture=True,
            env=brokered_auth_environment(),
        )
        platform = json.loads(platform_result.stdout)
        presets = {
            item.get("name"): item
            for item in platform.get("spec", {}).get("presets", [])
        }
        if pool["preset"] not in presets:
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: preset {pool['preset']!r} is not offered by platform {pool['platform']!r} in project {project_id}"
            )
        preset = presets[pool["preset"]]
        advertised_gpu_count = preset.get("resources", {}).get("gpu_count")
        if advertised_gpu_count != pool["gpus_per_node"]:
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: gpus_per_node={pool['gpus_per_node']} differs from the live preset value {advertised_gpu_count}"
            )
        if pool["capacity_type"] == "preemptible" and not platform.get(
            "status", {}
        ).get("allowed_for_preemptibles", False):
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: platform {pool['platform']!r} does not allow preemptible capacity in this project"
            )
        if pool["topology"]["mode"] == "gpu_cluster" and not preset.get(
            "allow_gpu_clustering", False
        ):
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: preset {pool['preset']!r} is not GPU-cluster capable"
            )

        compatibility_result = run(
            [
                args.nebius,
                "mk8s",
                "node-group",
                "get-compatibility-matrix",
                "--cluster-kubernetes-version",
                kubernetes_version,
                "--platform",
                pool["platform"],
                "--format",
                "json",
            ],
            capture=True,
            env=brokered_auth_environment(),
        )
        compatibility = json.loads(compatibility_result.stdout)
        items = [
            item
            for version in compatibility.get("versions", [])
            if version.get("kubernetes_version") == kubernetes_version
            for item in version.get("items", [])
            if pool["platform"] in item.get("compatible_platforms", [])
            and item.get("os") == pool["os"]
        ]
        driver = pool["driver"]
        compatible = any(
            (
                driver["mode"] == "managed"
                and item.get("drivers_preset") == driver.get("preset")
            )
            or (driver["mode"] == "operator" and not item.get("drivers_preset"))
            for item in items
        )
        if not compatible:
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: OS/driver mode is absent from the live MK8s compatibility matrix"
            )

        reservation = pool.get("reservation_policy")
        reservation_evidence: dict[str, Any] | None = None
        if reservation is not None:
            reservation_ids = reservation.get("reservation_ids", [])
            required_gpu_units = pool["max_nodes"] * pool["gpus_per_node"]
            total_gpu_units = 0.0
            available_gpu_units = 0.0
            groups: list[dict[str, Any]] = []
            for reservation_id in reservation_ids:
                group_result = run(
                    [
                        args.nebius,
                        "capacity",
                        "capacity-block-group",
                        "get",
                        "--id",
                        reservation_id,
                        "--format",
                        "json",
                    ],
                    capture=True,
                    env=brokered_auth_environment(),
                )
                group = json.loads(group_result.stdout)
                metadata = group.get("metadata", {})
                status = group.get("status", {})
                affinity = status.get("resource_affinity", {}).get("compute_v1", {})
                if (
                    metadata.get("id") != reservation_id
                    or status.get("state") != "STATE_ACTIVE"
                    or status.get("region") != target_region
                    or affinity.get("platform") != pool["platform"]
                ):
                    raise DeploymentError(
                        f"accelerator pool {pool_id!r}: capacity block {reservation_id!r} is not an active {target_region}/{pool['platform']} reservation"
                    )
                limit_text = str(status.get("current_limit", ""))
                usage_units_text = str(status.get("usage", ""))
                usage_text = str(status.get("usage_percentage", ""))
                if (
                    not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", limit_text)
                    or not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", usage_units_text)
                    or not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", usage_text)
                ):
                    raise DeploymentError(
                        f"accelerator pool {pool_id!r}: capacity block {reservation_id!r} has malformed capacity status"
                    )
                current_limit = float(limit_text)
                usage_gpu_units = float(usage_units_text)
                usage_fraction = float(usage_text)
                if (
                    current_limit < 0.0
                    or not 0.0 <= usage_gpu_units <= current_limit
                    or not 0.0 <= usage_fraction <= 1.0
                ):
                    raise DeploymentError(
                        f"accelerator pool {pool_id!r}: capacity block {reservation_id!r} has invalid capacity usage"
                    )
                total_gpu_units += current_limit
                available_gpu_units += current_limit - usage_gpu_units
                groups.append(
                    {
                        "id": reservation_id,
                        "state": status["state"],
                        "current_limit": current_limit,
                        "usage_gpu_units": usage_gpu_units,
                        "usage_fraction": usage_fraction,
                        "active_until": status.get(
                            "current_continuous_interval", {}
                        ).get("end_time"),
                    }
                )
            if total_gpu_units + 1e-9 < required_gpu_units:
                raise DeploymentError(
                    f"accelerator pool {pool_id!r}: capacity blocks reserve {total_gpu_units:g} total GPU units but fixed capacity requires {required_gpu_units}"
                )
            reservation_evidence = {
                "policy": reservation["policy"],
                "required_gpu_units": required_gpu_units,
                "total_gpu_units": total_gpu_units,
                "available_gpu_units": available_gpu_units,
                "groups": groups,
                "status": "compatible",
            }

        pool_evidence = {
            "pool_id": pool_id,
            "platform": pool["platform"],
            "preset": pool["preset"],
            "capacity_type": pool["capacity_type"],
            "driver_mode": driver["mode"],
            "topology": pool["topology"]["mode"],
            "status": "compatible",
        }
        if reservation_evidence is not None:
            pool_evidence["reservation"] = reservation_evidence
        checked.append(pool_evidence)

    print(
        json.dumps(
            {
                "status": "compatible",
                "project_id": project_id,
                "kubernetes_version": kubernetes_version,
                "accelerator_pools": checked,
                "capacity_advisor": "Run Capacity Advisor immediately before apply; availability is not guaranteed by compatibility.",
            },
            indent=2,
        )
    )


def require_deployable_images(contract: Mapping[str, Any]) -> None:
    """Fail before cloud mutation when source-build placeholders remain."""
    workloads = contract["stages"]["workloads"]
    policy = contract["artifact_delivery"]["mode"]
    application_images = {
        "control plane": workloads["control_plane_image"],
        "admin console": workloads["admin_console"]["image"],
    }
    for label, image in application_images.items():
        repository = image["repository"]
        digest = image["digest"]
        if repository.split("/", 1)[0].endswith(".invalid"):
            raise DeploymentError(
                f"{label} image still uses a .invalid source-build placeholder"
            )
        if digest == f"sha256:{'0' * 64}":
            raise DeploymentError(
                f"{label} image still uses the zero digest placeholder"
            )
        if policy == "regional-mirror":
            split_digest_reference(f"{repository}@{digest}", label=label)

    selected_models = set(contract["selected_model_ids"])
    model_images = workloads.get("model_image_overrides", {})
    missing = sorted(selected_models - set(model_images))
    if missing:
        raise DeploymentError(
            "selected models lack both a tfvars image override and a runtime-catalog image: "
            + ", ".join(missing)
        )
    for model_id in sorted(selected_models):
        image = model_images[model_id]
        host = image.split("/", 1)[0]
        if host.endswith(".invalid"):
            raise DeploymentError(
                f"selected model {model_id!r} still uses an unresolved .invalid runtime-catalog image"
            )
        if policy == "regional-mirror":
            split_digest_reference(image, label=f"model {model_id}")

    reference_data = workloads.get("reference_data", {})
    if isinstance(reference_data, Mapping) and reference_data.get("enabled") is True:
        for component in ("status", "pipeline"):
            configuration = reference_data.get(component, {})
            if not isinstance(configuration, Mapping) or configuration.get("enabled") is not True:
                continue
            image = configuration.get("image")
            if not isinstance(image, str) or image.split("/", 1)[0].endswith(".invalid"):
                raise DeploymentError(
                    f"reference-data {component} image is unresolved"
                )
            if policy == "regional-mirror":
                split_digest_reference(
                    image, label=f"reference-data {component}"
                )


def split_digest_reference(reference: str, *, label: str) -> tuple[str, str]:
    """Split one immutable OCI reference without accepting a tag-only source."""
    marker = "@sha256:"
    if reference.count("@") != 1 or reference.count(marker) != 1:
        raise DeploymentError(
            f"{label} image must be pinned as repository@sha256:<64 hex>"
        )
    repository, hexadecimal = reference.rsplit(marker, 1)
    if (
        not repository
        or "/" not in repository
        or any(character in repository for character in ("?", "#"))
        or any(character.isspace() for character in repository)
        or ":" in repository.rsplit("/", 1)[-1]
        or len(hexadecimal) != 64
        or any(character not in "0123456789abcdef" for character in hexadecimal)
    ):
        raise DeploymentError(
            f"{label} image must be pinned as repository@sha256:<64 hex>"
        )
    host, path = repository.split("/", 1)
    host_without_port = host.split(":", 1)[0]
    if (
        "." not in host_without_port
        or not re.fullmatch(r"[a-zA-Z0-9.-]+(?::[0-9]+)?", host)
        or any(part in ("", ".", "..") for part in path.split("/"))
        or not re.fullmatch(r"[a-z0-9._/-]+", path)
    ):
        raise DeploymentError(
            f"{label} image must use a fully-qualified registry host and safe repository path"
        )
    return repository, f"sha256:{hexadecimal}"


def source_repository_path(repository: str) -> str:
    """Preserve an upstream repository path, excluding a Nebius registry ID."""
    parts = repository.split("/")
    if len(parts) < 2:
        raise DeploymentError(f"OCI repository has no path: {repository!r}")
    host, path = parts[0], parts[1:]
    if host.startswith("cr.") and host.endswith(".nebius.cloud") and len(path) > 1:
        path = path[1:]
    if not path or any(part in ("", ".", "..") for part in path):
        raise DeploymentError(f"OCI repository has an unsafe path: {repository!r}")
    return "/".join(path)


def selected_image_artifacts(
    contract: Mapping[str, Any],
    registry_delivery: Mapping[str, Any],
) -> list[dict[str, str]]:
    """Return the complete selected source-to-target image closure."""
    expected_policy = contract["artifact_delivery"]
    if (
        registry_delivery.get("schema") != "fs2-serve.nebius.ai/registry-delivery/v1"
        or registry_delivery.get("mode") != expected_policy["mode"]
        or registry_delivery.get("repository_prefix")
        != expected_policy["repository_prefix"]
    ):
        raise DeploymentError(
            "the infrastructure registry-delivery output differs from terraform.tfvars"
        )
    target = registry_delivery.get("target_registry")
    if not isinstance(target, dict):
        raise DeploymentError(
            "the infrastructure registry-delivery output is malformed"
        )
    target_region = contract["target"]["region"]
    target_registry_id = str(target.get("id", ""))
    target_fqdn = str(target.get("fqdn", "")).rstrip("/")
    target_root = str(target.get("repository_root", "")).rstrip("/")
    expected_fqdn = f"cr.{target_region}.nebius.cloud"
    expected_root = f"{expected_fqdn}/{target_registry_id.removeprefix('registry-')}"
    if (
        not re.fullmatch(r"registry-[a-z0-9]+", target_registry_id)
        or target.get("project_id") != contract["target"]["project_id"]
        or target.get("region") != target_region
        or target_fqdn != expected_fqdn
        or target_root != expected_root
    ):
        raise DeploymentError("the infrastructure target registry root is malformed")

    workloads = contract["stages"]["workloads"]
    sources: list[tuple[str, str]] = [
        (
            "application/control-plane",
            f"{workloads['control_plane_image']['repository']}@{workloads['control_plane_image']['digest']}",
        ),
        (
            "application/admin-console",
            f"{workloads['admin_console']['image']['repository']}@{workloads['admin_console']['image']['digest']}",
        ),
    ]
    sources.extend(
        (f"model/{model_id}", workloads["model_image_overrides"][model_id])
        for model_id in contract["selected_model_ids"]
    )
    reference_data = workloads.get("reference_data", {})
    if isinstance(reference_data, Mapping) and reference_data.get("enabled") is True:
        for component in ("status", "pipeline"):
            configuration = reference_data.get(component, {})
            if isinstance(configuration, Mapping) and configuration.get("enabled") is True:
                sources.append(
                    (f"reference-data/{component}", str(configuration["image"]))
                )

    prefix = str(registry_delivery.get("repository_prefix", "")).strip("/")
    artifacts: list[dict[str, str]] = []
    target_sources: dict[str, str] = {}
    for name, source_reference in sources:
        source_repository, digest = split_digest_reference(source_reference, label=name)
        relative_repository = source_repository_path(source_repository)
        target_repository = "/".join(
            part for part in (target_root, prefix, relative_repository) if part
        )
        prior_source = target_sources.get(target_repository)
        if prior_source is not None and prior_source != source_repository:
            raise DeploymentError(
                "two distinct upstream repositories collapse to the same target repository: "
                f"{target_repository}"
            )
        target_sources[target_repository] = source_repository
        target_tag = (
            f"{target_repository}:mirror-sha256-{digest.removeprefix('sha256:')}"
        )
        artifacts.append(
            {
                "name": name,
                "source_repository": source_repository,
                "source_reference": source_reference,
                "digest": digest,
                "target_repository": target_repository,
                "target_reference": f"{target_repository}@{digest}",
                "target_tag": target_tag,
            }
        )
    return artifacts


def rewritten_workloads(
    contract: Mapping[str, Any], dynamic: Mapping[str, Any]
) -> dict[str, Any]:
    """Rewrite runtime pulls to the regional target without changing digests."""
    workloads = dict(contract["stages"]["workloads"])
    if contract["artifact_delivery"]["mode"] == "direct-source":
        return workloads
    artifacts = {
        artifact["name"]: artifact
        for artifact in selected_image_artifacts(
            contract, dynamic["registry_delivery_contract"]
        )
    }
    control_plane = dict(workloads["control_plane_image"])
    control_plane["repository"] = artifacts["application/control-plane"][
        "target_repository"
    ]
    workloads["control_plane_image"] = control_plane

    admin_console = dict(workloads["admin_console"])
    admin_image = dict(admin_console["image"])
    admin_image["repository"] = artifacts["application/admin-console"][
        "target_repository"
    ]
    admin_console["image"] = admin_image
    workloads["admin_console"] = admin_console
    workloads["model_image_overrides"] = {
        model_id: artifacts[f"model/{model_id}"]["target_reference"]
        for model_id in contract["selected_model_ids"]
    }
    reference_data = workloads.get("reference_data")
    if isinstance(reference_data, Mapping) and reference_data.get("enabled") is True:
        rewritten_reference_data = dict(reference_data)
        for component in ("status", "pipeline"):
            configuration = rewritten_reference_data.get(component)
            if not isinstance(configuration, Mapping) or configuration.get("enabled") is not True:
                continue
            rewritten_configuration = dict(configuration)
            rewritten_configuration["image"] = artifacts[
                f"reference-data/{component}"
            ]["target_reference"]
            rewritten_reference_data[component] = rewritten_configuration
        workloads["reference_data"] = rewritten_reference_data
    return workloads


def canonical_sha256(value: object) -> str:
    """Match the control-plane configuration ETag and Terraform jsonencode digest."""

    payload = json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
        allow_nan=False,
    ).encode()
    return hashlib.sha256(payload).hexdigest()


def _admin_catalog() -> Any:
    """Load the validated packaged catalog without requiring an installed wheel."""

    paths = [str(CATALOG_ROOT), str(SOLUTION_ROOT / "components/control-plane/src")]
    added = [path for path in paths if path not in sys.path]
    sys.path[:0] = added
    try:
        from fs2_serve_catalog.loader import load_catalog
        from fs2_serve.native_catalog import augment_native_catalog

        return augment_native_catalog(
            load_catalog(CATALOG_ROOT), CATALOG_ROOT, repo_root=REPOSITORY_ROOT
        )
    except (ImportError, OSError, ValueError) as exc:
        raise DeploymentError(
            "the canonical model catalog cannot derive the admin baseline"
        ) from exc
    finally:
        for path in added:
            sys.path.remove(path)


def selected_deployment_runtimes(model_images: Mapping[str, str]) -> dict[str, Any]:
    """Select exact runtime digests, independently of a mirror's registry region."""
    selected: dict[str, Any] = {}
    for path in sorted((CATALOG_ROOT / "deployment-runtimes").glob("*.json")):
        entry = json.loads(path.read_text(encoding="utf-8"))
        model_id = entry["model_id"]
        image = model_images.get(model_id)
        if image is None or image.rsplit("@", 1)[-1] != entry["record"]["runtime"]["image"]["digest"]:
            continue
        if model_id in selected:
            raise DeploymentError(f"model {model_id!r} has ambiguous deployment runtime records")
        selected[model_id] = entry
    return selected


def deployment_runtime_configuration_identities(entries: Mapping[str, Any]) -> dict[str, Any]:
    """Use the control plane's exact artifact identities for the admin baseline."""
    paths = [str(CATALOG_ROOT), str(SOLUTION_ROOT / "components/control-plane/src")]
    added = [path for path in paths if path not in sys.path]
    sys.path[:0] = added
    try:
        from fs2_serve.deployment_runtimes import deployment_runtime_configuration_identity

        return {model_id: deployment_runtime_configuration_identity(entry) for model_id, entry in entries.items()}
    finally:
        for path in added:
            sys.path.remove(path)


def _admin_pool_ids(
    contract: Mapping[str, Any],
    workloads: Mapping[str, Any],
    pools: Mapping[str, Any],
    *,
    model_id: str,
    accelerator_class: str,
) -> list[str]:
    override = workloads.get("model_pool_overrides", {}).get(model_id)
    if isinstance(override, str) and override:
        candidates = [override]
    else:
        placement = contract.get("selected_model_placements", {}).get(model_id, {})
        compatible = (
            placement.get("compatible_pool_ids", [])
            if isinstance(placement, Mapping)
            else []
        )
        candidates = [value for value in compatible if isinstance(value, str)]
    candidates = [value for value in candidates if value in pools]
    if not candidates:
        normalized = accelerator_class.casefold().replace("_", "-")
        candidates = sorted(
            pool_id
            for pool_id, pool in pools.items()
            if str(pool.get("accelerator_class", "")).casefold().replace("_", "-")
            == normalized
        )
    if not candidates:
        raise DeploymentError(
            f"model {model_id!r} has no selected accelerator pool; set deployment.models.pool_overrides"
        )
    return sorted(dict.fromkeys(candidates))


def _admin_scaling(
    workloads: Mapping[str, Any],
    model_id: str,
) -> dict[str, int]:
    mode = workloads.get("model_scaling_mode")
    if mode not in {"keda", "static"}:
        raise DeploymentError("admin baseline requires a supported model scaling mode")
    configured = workloads.get("model_scaling_overrides", {}).get(model_id, {})
    if not isinstance(configured, Mapping):
        raise DeploymentError(f"model {model_id!r} has an invalid scaling override")
    if mode == "static":
        return {
            "min_replicas": 1,
            "max_replicas": 1,
            "target_queue_depth": 1,
            "polling_interval_seconds": int(workloads["keda_polling_interval_seconds"]),
            "cooldown_seconds": int(workloads["keda_cooldown_period_seconds"]),
        }
    hot = model_id in workloads.get("hot_model_ids", [])
    return {
        "min_replicas": int(configured.get("min_replicas", 1 if hot else 0)),
        "max_replicas": int(configured.get("max_replicas", 1)),
        "target_queue_depth": int(configured.get("target_queue_depth", 1)),
        "polling_interval_seconds": int(
            configured.get(
                "polling_interval_seconds", workloads["keda_polling_interval_seconds"]
            )
        ),
        "cooldown_seconds": int(
            configured.get(
                "cooldown_seconds", workloads["keda_cooldown_period_seconds"]
            )
        ),
    }


def derived_admin_configuration(
    contract: Mapping[str, Any],
    dynamic: Mapping[str, Any],
    workloads: Mapping[str, Any],
) -> tuple[dict[str, Any], str, dict[str, dict[str, int]]]:
    """Project the same tfvars-selected pools, routes, and immutable artifacts into the admin API."""

    accelerator_contract = dynamic.get("accelerator_pool_contract")
    if not isinstance(accelerator_contract, Mapping):
        raise DeploymentError(
            "the accelerator-pool output is unavailable for the admin baseline"
        )
    raw_pools = accelerator_contract.get("pools")
    if not isinstance(raw_pools, Mapping) or not raw_pools:
        raise DeploymentError(
            "the accelerator-pool output contains no pools for the admin baseline"
        )

    catalog = _admin_catalog()
    try:
        routes_document = json.loads(MODEL_ROUTES_PATH.read_text(encoding="utf-8"))
        pool_profiles = json.loads(POOL_PROFILES_PATH.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError(
            "the admin baseline support contracts are unreadable"
        ) from exc
    routes = routes_document.get("routes", {})
    profile_name = contract.get("profiles", {}).get("accelerators")
    queue = pool_profiles.get("profiles", {}).get(profile_name, {}).get("queue", {})
    local_queue = str(queue.get("local_queue_name", "fs2-models-async"))

    pools: dict[str, Any] = {}
    pool_features: dict[str, Mapping[str, Any]] = {}
    for pool_id, raw_pool in sorted(raw_pools.items()):
        if not isinstance(raw_pool, Mapping):
            raise DeploymentError(f"accelerator pool {pool_id!r} is malformed")
        capacity = raw_pool.get("capacity", {})
        node = raw_pool.get("node", {})
        resource_api = raw_pool.get("resource_api", {})
        scheduling = raw_pool.get("scheduling", {})
        selectors = scheduling.get("stable_node_labels", {})
        tolerations = scheduling.get("tolerations", [])
        pools[str(pool_id)] = {
            "resource_name": str(resource_api.get("resource_name", "nvidia.com/gpu")),
            "accelerator_class": str(raw_pool.get("accelerator_class", "")),
            "capacity_type": str(capacity.get("type", "regular")),
            "accelerators_per_node": int(node.get("gpus_per_node", 0)),
            "min_nodes": int(capacity.get("min_nodes", 0)),
            "max_nodes": int(capacity.get("max_nodes", 0)),
            "node_selector": {
                str(key): str(value)
                for key, value in sorted(selectors.items())
                if isinstance(key, str) and isinstance(value, str)
            },
            "tolerations": [
                {
                    "key": str(item.get("key", "")),
                    "operator": str(item.get("operator", "Equal")),
                    "value": item.get("value"),
                    "effect": item.get("effect"),
                    "toleration_seconds": item.get("toleration_seconds"),
                }
                for item in tolerations
                if isinstance(item, Mapping)
            ],
        }
        pool_features[str(pool_id)] = (
            raw_pool.get("features", {})
            if isinstance(raw_pool.get("features", {}), Mapping)
            else {}
        )

    model_images = workloads.get("model_image_overrides", {})
    selected_model_ids = contract.get("selected_model_ids", [])
    deployment_runtimes = selected_deployment_runtimes({
        model_id: model_images[model_id] for model_id in selected_model_ids if model_id in model_images
    })
    cpu_runtime_model_ids = {
        model_id
        for model_id, entry in deployment_runtimes.items()
        if entry["record"]["resources"]["gpu"]
        == {
            "class": "CPU",
            "count": 0,
            "topology": "cpu-only",
            "placement": None,
            "b300_state": "not-applicable",
            "alternatives": [],
        }
    }
    native_ids = set(json.loads(
        (SOLUTION_ROOT / "catalog/profiles/model-profiles.json").read_text(encoding="utf-8")
    ).get("managed_native_model_ids", []))
    managed_cpu_ids = cpu_runtime_model_ids & native_ids
    if cpu_runtime_model_ids:
        general_cpu_contract = dynamic.get("general_cpu_pool_contract")
        if not isinstance(general_cpu_contract, Mapping):
            raise DeploymentError(
                "a selected CPU deployment runtime requires the general CPU pool output"
            )
        general_pools = general_cpu_contract.get("pools")
        node_selector = general_cpu_contract.get("node_selector")
        taint = general_cpu_contract.get("taint")
        if (
            general_cpu_contract.get("schema")
            != "fs2-serve.nebius.ai/general-cpu-pools/v1"
            or not isinstance(general_pools, Mapping)
            or len(general_pools) != 1
            or not isinstance(node_selector, Mapping)
            or not node_selector
            or not isinstance(taint, Mapping)
        ):
            raise DeploymentError(
                "a selected CPU deployment runtime requires one exact general CPU pool"
            )
        for pool_id, raw_pool in sorted(general_pools.items()):
            if pool_id in pools or not isinstance(raw_pool, Mapping):
                raise DeploymentError("the general CPU pool identity is malformed or duplicated")
            pools[str(pool_id)] = {
                "resource_name": "cpu",
                "accelerator_class": "CPU",
                "capacity_type": str(raw_pool.get("capacity_type", "")),
                "accelerators_per_node": 0,
                "min_nodes": int(raw_pool.get("min_nodes", 0)),
                "max_nodes": int(raw_pool.get("max_nodes", 0)),
                "node_selector": {
                    **{
                        str(key): str(value)
                        for key, value in sorted(node_selector.items())
                        if isinstance(key, str) and isinstance(value, str)
                    },
                    "capacity.fs2.nebius/pool-id": str(pool_id),
                },
                "tolerations": [
                    {
                        "key": str(taint.get("key", "")),
                        "operator": "Equal",
                        "value": str(taint.get("value", "")),
                        "effect": str(taint.get("effect", "")),
                        "toleration_seconds": None,
                    }
                ],
            }
            if managed_cpu_ids:
                resources = raw_pool.get("schedulable_capacity", {})
                pools[str(pool_id)].update({
                    "allocatable_cpu_millis": int(resources.get("cpu_millicores", 0)),
                    "allocatable_memory_bytes": int(resources.get("memory_mib", 0)) * 1048576,
                })
            pool_features[str(pool_id)] = {}
    deployment_identities = deployment_runtime_configuration_identities(deployment_runtimes) if deployment_runtimes else {}
    scaling = {
        model_id: (
            {
                "min_replicas": 1,
                "max_replicas": 1,
                "target_queue_depth": 1,
                "polling_interval_seconds": int(workloads["keda_polling_interval_seconds"]),
                "cooldown_seconds": int(workloads["keda_cooldown_period_seconds"]),
            }
            if model_id in cpu_runtime_model_ids and model_id not in managed_cpu_ids
            else _admin_scaling(workloads, model_id)
        )
        for model_id in selected_model_ids
    }
    models: dict[str, Any] = {}
    for model_id in selected_model_ids:
        if (
            model_id not in catalog.records
            or model_id not in catalog.acquisition_plans
            or model_id not in catalog.semantic_requests
        ):
            raise DeploymentError(
                f"model {model_id!r} lacks canonical admin configuration identities"
            )
        value = (
            deployment_runtimes[model_id]["record"]
            if model_id in deployment_runtimes
            else catalog.records[model_id].to_dict()
        )
        route = routes.get(model_id)
        if route is None and model_id in deployment_runtimes:
            # New native models do not rewrite the archived 16-model route
            # inventory. Their selected, validated record owns this metadata.
            route = {
                "mcp": {
                    "enabled": value["interface"]["mcp"]["discoverable"],
                    "tool_name": f"infer_{model_id.replace('-', '_')}",
                }
            }
        image_reference = model_images.get(model_id)
        if not isinstance(route, Mapping) or not isinstance(image_reference, str):
            raise DeploymentError(f"model {model_id!r} lacks a deployed route or image")
        image_repository, image_digest = split_digest_reference(
            image_reference,
            label=f"admin configuration model/{model_id}",
        )
        gpu = value["resources"]["gpu"]
        pool_ids = _admin_pool_ids(
            contract,
            workloads,
            pools,
            model_id=model_id,
            accelerator_class=str(gpu["class"]),
        )
        selected_pool_features = [
            pool_features[pool_id] for pool_id in pool_ids
        ]
        cache_tier = (
            "node-local"
            if model_id in cpu_runtime_model_ids or any(
                item.get("local_cache") == "node-local"
                for item in selected_pool_features
            )
            else "shared-filesystem"
            if any(
                item.get("shared_filesystem") is True for item in selected_pool_features
            )
            else "object-store"
        )
        mcp = route.get("mcp", {})
        mcp_enabled = bool(isinstance(mcp, Mapping) and mcp.get("enabled") is True)
        readiness_timeout = int(value["interface"]["readiness"]["timeout_seconds"])
        acquisition_sha256 = canonical_sha256(
            catalog.acquisition_plans[model_id].to_dict()
        )
        models[model_id] = {
            "model_id": model_id,
            "enabled": True,
            "placement": {
                "pool_ids": pool_ids,
                "accelerators": int(gpu["count"]),
                "topology_policy": "any" if model_id in cpu_runtime_model_ids else "single-node",
            },
            "autoscaling": scaling[model_id],
            "queue": {
                "local_queue": (
                    str(workloads.get("general_cpu_lane", {}).get("local_queue", ""))
                    if model_id in cpu_runtime_model_ids
                    else local_queue
                ),
                "priority_class": "default",
                "max_queue_seconds": 7200,
            },
            "snapshot": {
                "strategy": "disabled",
                "cache_tier": cache_tier,
                "restore_timeout_seconds": max(600, readiness_timeout),
                "parallelism": 1,
                "require_semantic_check": True,
            },
            "mcp": {
                "exposed": mcp_enabled,
                "tool_name": str(mcp["tool_name"]) if mcp_enabled else None,
            },
            "rate": {
                "requests_per_minute": None,
                "concurrent_requests": 1,
                "accelerator_seconds_per_day": None,
            },
            "artifact": {
                "image_repository": image_repository,
                "image_digest": image_digest,
                "model_revision": str(value["model"]["source"]["revision"]),
                "artifact_manifest_sha256": value["cache"]["artifact"].get(
                    "manifest_digest"
                ),
                "acquisition_contract_sha256": acquisition_sha256,
                "provenance_sha256": catalog.records[model_id].digest,
                "semantic_health_contract_sha256": catalog.semantic_requests[
                    model_id
                ].digest,
            },
        }
        if model_id in managed_cpu_ids:
            models[model_id]["placement"].update({
                "cpu_millis": int(value["resources"]["cpu_millis"]),
                "memory_bytes": int(value["resources"]["memory_bytes"]),
            })
        if model_id in deployment_identities:
            identity = deployment_identities[model_id]
            models[model_id]["artifact"].update({
                key: identity[key] for key in (
                    "model_revision", "artifact_manifest_sha256", "acquisition_contract_sha256",
                    "provenance_sha256", "semantic_health_contract_sha256",
                )
            })

    configuration = {
        "schema_version": "fs2.admin-configuration/v1",
        "pools": pools,
        "models": models,
    }
    return configuration, canonical_sha256(configuration), scaling


def merge_docker_config(base: Any, extra: Any) -> dict[str, Any]:
    """Merge Docker auth documents without logging or persisting credentials."""
    if not isinstance(base, dict) or not isinstance(extra, dict):
        raise DeploymentError("registry Docker configuration must be a JSON object")
    merged = dict(base)
    for key in ("auths", "credHelpers"):
        base_values = merged.get(key, {})
        extra_values = extra.get(key, {})
        if not isinstance(base_values, dict) or not isinstance(extra_values, dict):
            raise DeploymentError(
                f"registry Docker configuration {key} must be an object"
            )
        merged[key] = {**base_values, **extra_values}
    for key, value in extra.items():
        if key not in {"auths", "credHelpers"}:
            merged[key] = value
    return merged


@contextmanager
def registry_client_environment(
    contract: Mapping[str, Any],
    nebius_profile: str,
) -> Iterator[dict[str, str]]:
    """Materialize optional private registry auth only in an ephemeral directory."""
    require_brokered_profile(nebius_profile)
    environment = brokered_auth_environment()
    secret_name = contract["secret_environment"]["nvcr_dockerconfig"]
    encoded_extra = operator_secret("nvcr_dockerconfig", secret_name)
    if not encoded_extra:
        yield environment
        return
    try:
        extra = json.loads(encoded_extra)
    except json.JSONDecodeError as exc:
        raise DeploymentError(
            f"the Docker configuration in environment reference {secret_name!r} is not valid JSON"
        ) from exc

    docker_config_root = Path(
        environment.get("DOCKER_CONFIG", str(Path.home() / ".docker"))
    )
    base_path = docker_config_root / "config.json"
    base: Any = {}
    if base_path.is_file() and not base_path.is_symlink():
        try:
            base = json.loads(base_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            raise DeploymentError(
                "the existing Docker configuration is not valid JSON"
            ) from exc

    with tempfile.TemporaryDirectory(prefix="fs2-registry-auth-") as temporary:
        temporary_root = Path(temporary)
        temporary_root.chmod(0o700)
        private_json(temporary_root / "config.json", merge_docker_config(base, extra))
        environment["DOCKER_CONFIG"] = str(temporary_root)
        yield environment


def crane_digest(
    crane: str,
    reference: str,
    environment: Mapping[str, str],
    *,
    missing_ok: bool = False,
) -> str | None:
    result = subprocess.run(
        [crane, "digest", reference],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
        **capsule_subprocess_options(environment=environment),
    )
    if result.returncode != 0:
        missing_markers = (
            "manifest unknown",
            "manifest_unknown",
            "name unknown",
            "name_unknown",
            "not found",
            "404",
        )
        diagnostic = f"{result.stdout}\n{result.stderr}".lower()
        if missing_ok and any(marker in diagnostic for marker in missing_markers):
            return None
        raise DeploymentError(
            "registry digest lookup failed; verify source existence and operator registry credentials"
        )
    digest = result.stdout.strip()
    if not digest.startswith("sha256:") or len(digest) != 71:
        raise DeploymentError("registry returned a malformed OCI digest")
    return digest


def crane_copy(
    crane: str,
    source: str,
    target_tag: str,
    environment: Mapping[str, str],
    *,
    run_root: Path,
    expected_digest: str,
    reconciliation_of: str | None = None,
) -> None:
    operation = {
        "accepted_commit": os.environ["FS2_CAPSULE_ACCEPTED_COMMIT"],
        "accepted_tree": os.environ["FS2_CAPSULE_ACCEPTED_TREE"],
        "expected_digest": expected_digest,
        "no_clobber": True,
        "schema": "fs2-serve.nebius.ai/registry-copy-operation/v1",
        "source": source,
        "target": target_tag,
    }
    operation_sha256 = hashlib.sha256(_canonical_bytes(operation)).hexdigest()
    operation_path = run_root / f"registry-copy-{operation_sha256}.json"
    if operation_path.exists():
        if (
            operation_path.is_symlink()
            or not operation_path.is_file()
            or operation_path.read_bytes() != _canonical_bytes(operation) + b"\n"
        ):
            raise DeploymentError("retained registry-copy authority differs from this operation")
    else:
        append_only_private_json(operation_path, operation)
    execute_fenced_mutation(
        [crane, "copy", "--no-clobber", source, target_tag],
        run_root=run_root,
        stage="registry",
        root=run_root,
        operation="registry-copy",
        authority_path=operation_path,
        environment=environment,
        reconciliation_of=reconciliation_of,
        capture_output=True,
    )


def fresh_crane_digest(
    crane: str,
    reference: str,
    *,
    contract: Mapping[str, Any],
    nebius_profile: str,
    missing_ok: bool = False,
) -> str | None:
    """Use a separately brokered short-lived lease for each registry read."""

    with registry_client_environment(contract, nebius_profile) as environment:
        return crane_digest(
            crane,
            reference,
            environment,
            missing_ok=missing_ok,
        )


def mirror_selected_images(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    dynamic: Mapping[str, Any],
) -> Path | None:
    """Copy and verify the complete selected image closure before workloads."""
    if contract["artifact_delivery"]["mode"] == "direct-source":
        return None
    artifacts = selected_image_artifacts(
        contract, dynamic["registry_delivery_contract"]
    )
    receipt_images: list[dict[str, str]] = []
    completed_targets: dict[str, str] = {}
    for artifact in artifacts:
        expected = artifact["digest"]
        target_reference = artifact["target_reference"]
        status = completed_targets.get(target_reference)
        if status is None:
            existing = fresh_crane_digest(
                args.crane,
                artifact["target_tag"],
                contract=contract,
                nebius_profile=args.nebius_profile,
                missing_ok=True,
            )
            if existing is not None and existing != expected:
                raise DeploymentError(
                    f"target mirror tag digest mismatch for {artifact['name']}; refusing to overwrite"
                )
            if existing == expected:
                status = "existing"
            else:
                source_digest = fresh_crane_digest(
                    args.crane,
                    artifact["source_reference"],
                    contract=contract,
                    nebius_profile=args.nebius_profile,
                )
                if source_digest != expected:
                    raise DeploymentError(
                        f"upstream digest mismatch for {artifact['name']}; refusing to deploy"
                    )
                print(
                    f"Mirroring {artifact['name']} into the regional registry.",
                    file=sys.stderr,
                )
                # Materialize private registry configuration only for this one
                # copy. execute_fenced_mutation refreshes the cloud lease once
                # more immediately before the cgroup is populated.
                with registry_client_environment(
                    contract, args.nebius_profile
                ) as environment:
                    crane_copy(
                        args.crane,
                        artifact["source_reference"],
                        artifact["target_tag"],
                        environment,
                        run_root=run_root,
                        expected_digest=expected,
                    )
                status = "copied"
            if fresh_crane_digest(
                args.crane,
                artifact["target_tag"],
                contract=contract,
                nebius_profile=args.nebius_profile,
            ) != expected:
                raise DeploymentError(
                    f"post-copy tag verification failed for {artifact['name']}"
                )
            if fresh_crane_digest(
                args.crane,
                artifact["target_reference"],
                contract=contract,
                nebius_profile=args.nebius_profile,
            ) != expected:
                raise DeploymentError(
                    f"post-copy digest-reference verification failed for {artifact['name']}"
                )
            completed_targets[target_reference] = status
        receipt_images.append(
            {
                "name": artifact["name"],
                "source_host": artifact["source_repository"].split("/", 1)[0],
                "digest": expected,
                "target_reference": artifact["target_reference"],
                "status": status,
            }
        )
    receipt = {
        "schema": "fs2-serve.nebius.ai/registry-mirror-receipt/v1",
        "mode": "regional-mirror",
        "registry_id": dynamic["registry_delivery_contract"]["target_registry"]["id"],
        "images": receipt_images,
    }
    path = run_root / "registry-mirror.receipt.json"
    private_json(path, receipt)
    return path


def stage_paths(run_root: Path, stage: str) -> tuple[Path, Path, Path]:
    state_names = {
        "infrastructure": "terraform.tfstate",
        "foundation": "foundation.tfstate",
        "workloads": "workloads.tfstate",
    }
    return (
        run_root / state_names[stage],
        run_root / f"{stage}.tfvars.json",
        run_root / "terraform-data" / stage,
    )


def retained_json(path: Path, label: str, maximum_bytes: int = 64 * 1024 * 1024) -> Any:
    """Read one owner-only retained artifact without changing path or metadata."""

    if path.is_symlink():
        raise DeploymentError(f"{label} must not be a symlink")
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
        )
    except FileNotFoundError as exc:
        raise DeploymentError(f"{label} is not retained") from exc
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.getuid()
            or stat.S_IMODE(before.st_mode) != 0o600
            or before.st_size < 1
            or before.st_size > maximum_bytes
        ):
            raise DeploymentError(f"{label} is not an owner-only bounded regular file")
        raw = os.pread(descriptor, before.st_size, 0)
        after = os.fstat(descriptor)
        if (
            len(raw) != before.st_size
            or (
                before.st_dev,
                before.st_ino,
                before.st_size,
                before.st_mtime_ns,
                before.st_ctime_ns,
                stat.S_IMODE(before.st_mode),
            )
            != (
                after.st_dev,
                after.st_ino,
                after.st_size,
                after.st_mtime_ns,
                after.st_ctime_ns,
                stat.S_IMODE(after.st_mode),
            )
        ):
            raise DeploymentError(f"{label} changed while it was read")
    finally:
        os.close(descriptor)
    try:
        return json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError(f"{label} is not UTF-8 JSON") from exc


def retained_run_contract(run_root: Path) -> Mapping[str, Any]:
    try:
        details = os.stat(run_root, follow_symlinks=False)
    except FileNotFoundError as exc:
        raise DeploymentError("local read-only mode requires an existing retained run root") from exc
    if (
        not stat.S_ISDIR(details.st_mode)
        or details.st_uid != os.getuid()
        or stat.S_IMODE(details.st_mode) != 0o700
    ):
        raise DeploymentError("retained run root must be an owner-only mode-0700 directory")
    contract = retained_json(
        run_root / "deployment-contract.json", "retained deployment contract"
    )
    if (
        not isinstance(contract, Mapping)
        or not isinstance(contract.get("target"), Mapping)
        or not isinstance(contract.get("stages"), Mapping)
    ):
        raise DeploymentError("retained deployment contract is malformed")
    return contract


def retained_state_document(run_root: Path, stage: str) -> Mapping[str, Any]:
    state, _, _ = stage_paths(run_root, stage)
    document = retained_json(state, f"retained {stage} Terraform state")
    if (
        not isinstance(document, Mapping)
        or document.get("version") != 4
        or not isinstance(document.get("serial"), int)
        or document["serial"] < 1
        or not isinstance(document.get("outputs", {}), Mapping)
        or not isinstance(document.get("resources", []), list)
    ):
        raise DeploymentError(f"retained {stage} Terraform state is malformed")
    return document


def retained_state_output(
    run_root: Path, stage: str, name: str, *, optional: bool = False
) -> Any:
    output = retained_state_document(run_root, stage)["outputs"].get(name)
    if output is None:
        if optional:
            return None
        raise DeploymentError(f"retained {stage} state omits output {name!r}")
    if not isinstance(output, Mapping) or not {"value", "type"}.issubset(output):
        raise DeploymentError(f"retained {stage} output {name!r} is malformed")
    return output["value"]


def retained_state_address_count(run_root: Path, stage: str) -> int:
    resources = retained_state_document(run_root, stage)["resources"]
    count = 0
    for resource in resources:
        if not isinstance(resource, Mapping) or resource.get("mode", "managed") != "managed":
            continue
        instances = resource.get("instances", [])
        if not isinstance(instances, list):
            raise DeploymentError(f"retained {stage} resource instances are malformed")
        count += len(instances)
    return count


def stage_output(
    terraform: str,
    run_root: Path,
    stage: str,
    root: Path,
    name: str,
    environment: Mapping[str, str] | None,
    *,
    optional: bool = False,
) -> Any:
    if CAPSULE_ACCESS_MODE == "local-read-only":
        return retained_state_output(run_root, stage, name, optional=optional)
    if environment is None:
        raise DeploymentError("Terraform output environment is absent")
    if optional:
        return terraform_optional_json_output(terraform, root, name, environment)
    return terraform_json_output(terraform, root, name, environment)


def stage_root(stage: str) -> Path:
    return {
        "infrastructure": INFRA_ROOT,
        "foundation": FOUNDATION_ROOT,
        "workloads": WORKLOADS_ROOT,
    }[stage]


def stage_environment(
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
    *,
    include_secrets: bool = True,
) -> dict[str, str]:
    environment = terraform_environment(run_root, stage)
    if not include_secrets:
        return environment
    secret_names = contract["secret_environment"]

    if stage == "foundation":
        username = operator_secret(
            "grafana_username", secret_names["grafana_username"]
        )
        password = operator_secret(
            "grafana_password", secret_names["grafana_password"]
        )
        if not username or not password:
            raise DeploymentError(
                "fresh foundation deployment requires both configured Grafana bootstrap username and password environment references"
            )
        environment["TF_VAR_bootstrap_grafana_credentials"] = json.dumps(
            {"username": username, "password": password},
            separators=(",", ":"),
        )

    if stage == "workloads":
        ngc_key = operator_secret("ngc_api_key", secret_names["ngc_api_key"])
        docker_config = operator_secret(
            "nvcr_dockerconfig", secret_names["nvcr_dockerconfig"]
        )
        requirements = contract["secret_requirements"]
        if requirements["ngc_api_key"] and not ngc_key:
            raise DeploymentError(
                "the selected NIM models require the configured NGC API-key environment reference"
            )
        if requirements["nvcr_dockerconfig"] and not docker_config:
            raise DeploymentError(
                "the selected workloads require the configured NVCR dockerconfig environment reference"
            )
        if ngc_key:
            environment["TF_VAR_ngc_api_key"] = ngc_key
        if docker_config:
            environment["TF_VAR_nvcrio_dockerconfigjson"] = docker_config

    return environment


def write_infrastructure_variables(
    run_root: Path,
