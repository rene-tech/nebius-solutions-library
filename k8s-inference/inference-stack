class DeploymentError(RuntimeError):
    """A bounded, user-actionable deployment failure."""


def command_text(arguments: Sequence[str]) -> str:
    """Return a readable command containing no secret environment values."""
    return " ".join(arguments)


def run(
    arguments: Sequence[str],
    *,
    env: Mapping[str, str] | None = None,
    capture: bool = False,
    input_text: str | None = None,
) -> subprocess.CompletedProcess[str]:
    print(f"+ {command_text(arguments)}", file=sys.stderr)
    try:
        return subprocess.run(
            list(arguments),
            env=dict(env) if env is not None else None,
            input=input_text,
            text=True,
            check=True,
            stdout=subprocess.PIPE if capture else sys.stderr,
            stderr=subprocess.PIPE if capture else None,
        )
    except FileNotFoundError as exc:
        raise DeploymentError(f"required executable not found: {arguments[0]}") from exc
    except subprocess.CalledProcessError as exc:
        if capture and exc.stderr:
            print(exc.stderr.rstrip(), file=sys.stderr)
        raise DeploymentError(
            f"command failed with exit code {exc.returncode}: {command_text(arguments)}"
        ) from exc


def private_directory(path: Path) -> None:
    if path.exists() and (path.is_symlink() or not path.is_dir()):
        raise DeploymentError(f"run root must be a real directory: {path}")
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)


def private_json(path: Path, value: Any) -> None:
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    descriptor = os.open(temporary, flags, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def private_text(path: Path, value: str) -> None:
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(value)
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def clean_environment() -> dict[str, str]:
    # Stage inputs are generated explicitly. Inherited TF_VAR values could
    # otherwise make the same customer file produce a different deployment.
    return {
        key: value
        for key, value in os.environ.items()
        if not key.startswith("TF_VAR_")
        and not key.startswith("TF_CLI_ARGS")
        and key not in {"TF_DATA_DIR", "TF_WORKSPACE"}
    }


def terraform_environment(run_root: Path, stage: str) -> dict[str, str]:
    environment = clean_environment()
    data_directory = run_root / "terraform-data" / stage
    private_directory(data_directory)
    environment["TF_DATA_DIR"] = str(data_directory)
    environment["TF_IN_AUTOMATION"] = "1"
    return environment


def terraform_init(
    terraform: str,
    root: Path,
    backend: Path,
    environment: Mapping[str, str],
) -> None:
    if backend.is_symlink():
        raise DeploymentError(f"Terraform backend path must not be a symlink: {backend}")
    run(
        [
            terraform,
            f"-chdir={root}",
            "init",
            "-input=false",
            "-reconfigure",
            f"-backend-config=path={backend}",
        ],
        env=environment,
    )


def validate_stage_roots(terraform: str, run_root: Path) -> None:
    for stage in ("infrastructure", "foundation", "workloads"):
        environment = terraform_environment(run_root, f"validate-{stage}")
        root = stage_root(stage)
        run(
            [
                terraform,
                f"-chdir={root}",
                "init",
                "-backend=false",
                "-input=false",
            ],
            env=environment,
        )
        run(
            [terraform, f"-chdir={root}", "validate", "-no-color"],
            env=environment,
        )


def terraform_json_output(
    terraform: str,
    root: Path,
    name: str,
    environment: Mapping[str, str],
) -> Any:
    result = run(
        [terraform, f"-chdir={root}", "output", "-json", name],
        env=environment,
        capture=True,
    )
    return json.loads(result.stdout)


def terraform_optional_json_output(
    terraform: str,
    root: Path,
    name: str,
    environment: Mapping[str, str],
) -> Any | None:
    """Read an output that Terraform legitimately omits when its value is null."""
    result = run(
        [terraform, f"-chdir={root}", "output", "-json"],
        env=environment,
        capture=True,
    )
    outputs = json.loads(result.stdout)
    output = outputs.get(name)
    if output is None:
        return None
    if not isinstance(output, dict) or "value" not in output:
        raise DeploymentError(f"Terraform returned malformed output {name!r}")
    return output["value"]


def state_addresses(
    terraform: str,
    root: Path,
    environment: Mapping[str, str],
) -> list[str]:
    result = subprocess.run(
        [terraform, f"-chdir={root}", "state", "list"],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return []
    return [line for line in result.stdout.splitlines() if line.strip()]


def plan_json(
    terraform: str,
    *,
    root: Path,
    environment: Mapping[str, str],
    variable_file: Path,
    plan_path: Path,
    json_path: Path,
    destroy: bool = False,
) -> dict[str, Any]:
    if plan_path.is_symlink() or json_path.is_symlink():
        raise DeploymentError("plan and plan JSON paths must not be symlinks")
    arguments = [
        terraform,
        f"-chdir={root}",
        "plan",
        "-input=false",
        "-lock=true",
        f"-var-file={variable_file}",
        f"-out={plan_path}",
    ]
    if destroy:
        arguments.insert(3, "-destroy")
    run(arguments, env=environment)
    plan_path.chmod(0o600)
    result = run(
        [terraform, f"-chdir={root}", "show", "-json", str(plan_path)],
        env=environment,
        capture=True,
    )
    private_text(json_path, result.stdout)
    return json.loads(result.stdout)


def planned_output(document: Mapping[str, Any], name: str) -> Any:
    try:
        return document["planned_values"]["outputs"][name]["value"]
    except (KeyError, TypeError) as exc:
        raise DeploymentError(f"configuration plan did not produce output {name!r}") from exc


def plan_changes_managed_resources_or_outputs(document: Mapping[str, Any]) -> bool:
    """Return whether a stage handoff must converge before its consumer plans."""
    unchanged_actions = (["no-op"], ["read"])
    for resource in document.get("resource_changes", []):
        if resource.get("mode", "managed") != "managed":
            continue
        actions = resource.get("change", {}).get("actions", [])
        if actions not in unchanged_actions:
            return True
    for output in document.get("output_changes", {}).values():
        actions = output.get("actions", [])
        if actions not in unchanged_actions:
            return True
    return False


def source_commit() -> str:
    result = run(
        ["git", "-C", str(REPOSITORY_ROOT), "rev-parse", "HEAD"],
        capture=True,
        env=clean_environment(),
    )
    commit = result.stdout.strip()
    if len(commit) != 40 or any(character not in "0123456789abcdef" for character in commit):
        raise DeploymentError("the source checkout does not have an exact Git commit identity")
    return commit


def default_run_root(variable_file: Path) -> Path:
    identity = hashlib.sha256(str(variable_file.resolve()).encode()).hexdigest()[:12]
    state_home = os.environ.get("XDG_STATE_HOME")
    base = Path(state_home) if state_home else Path.home() / ".local" / "state"
    return base / "nebius-k8s-inference" / identity


def validate_configuration(
    terraform: str,
    variable_file: Path,
    run_root: Path,
) -> tuple[dict[str, Any], dict[str, str]]:
    environment = terraform_environment(run_root, "configuration")
    backend = run_root / "configuration.tfstate"
    terraform_init(terraform, DEPLOY_ROOT, backend, environment)
    document = plan_json(
        terraform,
        root=DEPLOY_ROOT,
        environment=environment,
        variable_file=variable_file,
        plan_path=run_root / "configuration.tfplan",
        json_path=run_root / "configuration.plan.json",
    )
    contract = planned_output(document, "deployment_contract")
    private_json(run_root / "deployment-contract.json", contract)
    return contract, environment


def preflight_accelerators(
    args: argparse.Namespace,
    contract: Mapping[str, Any],
) -> None:
    """Validate project-local platform, preset, capacity, and driver facts live."""
    pools = contract["stages"]["infrastructure"].get(
        "custom_accelerator_pools", {}
    )
    if not pools:
        raise DeploymentError(
            "live preflight requires deployment.accelerator_pools; checked-in profile pools are evidence-backed but not a substitute for current capacity"
        )

    project_id = contract["target"]["project_id"]
    target_region = contract["target"]["region"]
    kubernetes_version = contract["stages"]["infrastructure"][
        "kubernetes_version"
    ]
    checked: list[dict[str, Any]] = []
    for pool_id, pool in sorted(pools.items()):
        platform_result = run(
            [
                args.nebius,
                "--profile",
                args.nebius_profile,
                "compute",
                "platform",
                "get-by-name",
                "--parent-id",
                project_id,
                "--name",
                pool["platform"],
                "--format",
                "json",
            ],
            capture=True,
            env=clean_environment(),
        )
        platform = json.loads(platform_result.stdout)
        presets = {
            item.get("name"): item
            for item in platform.get("spec", {}).get("presets", [])
        }
        if pool["preset"] not in presets:
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: preset {pool['preset']!r} is not offered by platform {pool['platform']!r} in project {project_id}"
            )
        preset = presets[pool["preset"]]
        advertised_gpu_count = preset.get("resources", {}).get("gpu_count")
        if advertised_gpu_count != pool["gpus_per_node"]:
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: gpus_per_node={pool['gpus_per_node']} differs from the live preset value {advertised_gpu_count}"
            )
        if (
            pool["capacity_type"] == "preemptible"
            and not platform.get("status", {}).get("allowed_for_preemptibles", False)
        ):
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: platform {pool['platform']!r} does not allow preemptible capacity in this project"
            )
        if (
            pool["topology"]["mode"] == "gpu_cluster"
            and not preset.get("allow_gpu_clustering", False)
        ):
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: preset {pool['preset']!r} is not GPU-cluster capable"
            )

        compatibility_result = run(
            [
                args.nebius,
                "--profile",
                args.nebius_profile,
                "mk8s",
                "node-group",
                "get-compatibility-matrix",
                "--cluster-kubernetes-version",
                kubernetes_version,
                "--platform",
                pool["platform"],
                "--format",
                "json",
            ],
            capture=True,
            env=clean_environment(),
        )
        compatibility = json.loads(compatibility_result.stdout)
        items = [
            item
            for version in compatibility.get("versions", [])
            if version.get("kubernetes_version") == kubernetes_version
            for item in version.get("items", [])
            if pool["platform"] in item.get("compatible_platforms", [])
            and item.get("os") == pool["os"]
        ]
        driver = pool["driver"]
        compatible = any(
            (
                driver["mode"] == "managed"
                and item.get("drivers_preset") == driver.get("preset")
            )
            or (
                driver["mode"] == "operator"
                and not item.get("drivers_preset")
            )
            for item in items
        )
        if not compatible:
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: OS/driver mode is absent from the live MK8s compatibility matrix"
            )

        reservation = pool.get("reservation_policy")
        reservation_evidence: dict[str, Any] | None = None
        if reservation is not None:
            reservation_ids = reservation.get("reservation_ids", [])
            required_gpu_units = pool["max_nodes"] * pool["gpus_per_node"]
            total_gpu_units = 0.0
            available_gpu_units = 0.0
            groups: list[dict[str, Any]] = []
            for reservation_id in reservation_ids:
                group_result = run(
                    [
                        args.nebius,
                        "--profile",
                        args.nebius_profile,
                        "capacity",
                        "capacity-block-group",
                        "get",
                        "--id",
                        reservation_id,
                        "--format",
                        "json",
                    ],
                    capture=True,
                    env=clean_environment(),
                )
                group = json.loads(group_result.stdout)
                metadata = group.get("metadata", {})
                status = group.get("status", {})
                affinity = status.get("resource_affinity", {}).get(
                    "compute_v1", {}
                )
                if (
                    metadata.get("id") != reservation_id
                    or status.get("state") != "STATE_ACTIVE"
                    or status.get("region") != target_region
                    or affinity.get("platform") != pool["platform"]
                ):
                    raise DeploymentError(
                        f"accelerator pool {pool_id!r}: capacity block {reservation_id!r} is not an active {target_region}/{pool['platform']} reservation"
                    )
                limit_text = str(status.get("current_limit", ""))
                usage_units_text = str(status.get("usage", ""))
                usage_text = str(status.get("usage_percentage", ""))
                if (
                    not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", limit_text)
                    or not re.fullmatch(
                        r"[0-9]+(?:\.[0-9]+)?", usage_units_text
                    )
                    or not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", usage_text)
                ):
                    raise DeploymentError(
                        f"accelerator pool {pool_id!r}: capacity block {reservation_id!r} has malformed capacity status"
                    )
                current_limit = float(limit_text)
                usage_gpu_units = float(usage_units_text)
                usage_fraction = float(usage_text)
                if (
                    current_limit < 0.0
                    or not 0.0 <= usage_gpu_units <= current_limit
                    or not 0.0 <= usage_fraction <= 1.0
                ):
                    raise DeploymentError(
                        f"accelerator pool {pool_id!r}: capacity block {reservation_id!r} has invalid capacity usage"
                    )
                total_gpu_units += current_limit
                available_gpu_units += current_limit - usage_gpu_units
                groups.append(
                    {
                        "id": reservation_id,
                        "state": status["state"],
                        "current_limit": current_limit,
                        "usage_gpu_units": usage_gpu_units,
                        "usage_fraction": usage_fraction,
                        "active_until": status.get("current_continuous_interval", {}).get(
                            "end_time"
                        ),
                    }
                )
            if total_gpu_units + 1e-9 < required_gpu_units:
                raise DeploymentError(
                    f"accelerator pool {pool_id!r}: capacity blocks reserve {total_gpu_units:g} total GPU units but fixed capacity requires {required_gpu_units}"
                )
            reservation_evidence = {
                "policy": reservation["policy"],
                "required_gpu_units": required_gpu_units,
                "total_gpu_units": total_gpu_units,
                "available_gpu_units": available_gpu_units,
                "groups": groups,
                "status": "compatible",
            }

        pool_evidence = {
            "pool_id": pool_id,
            "platform": pool["platform"],
            "preset": pool["preset"],
            "capacity_type": pool["capacity_type"],
            "driver_mode": driver["mode"],
            "topology": pool["topology"]["mode"],
            "status": "compatible",
        }
        if reservation_evidence is not None:
            pool_evidence["reservation"] = reservation_evidence
        checked.append(pool_evidence)

    print(
        json.dumps(
            {
                "status": "compatible",
                "project_id": project_id,
                "kubernetes_version": kubernetes_version,
                "accelerator_pools": checked,
                "capacity_advisor": "Run Capacity Advisor immediately before apply; availability is not guaranteed by compatibility.",
            },
            indent=2,
        )
    )


def require_deployable_images(contract: Mapping[str, Any]) -> None:
    """Fail before cloud mutation when source-build placeholders remain."""
    workloads = contract["stages"]["workloads"]
    policy = contract["artifact_delivery"]["mode"]
    application_images = {
        "control plane": workloads["control_plane_image"],
        "admin console": workloads["admin_console"]["image"],
    }
    for label, image in application_images.items():
        repository = image["repository"]
        digest = image["digest"]
        if repository.split("/", 1)[0].endswith(".invalid"):
            raise DeploymentError(
                f"{label} image still uses a .invalid source-build placeholder"
            )
        if digest == f"sha256:{'0' * 64}":
            raise DeploymentError(f"{label} image still uses the zero digest placeholder")
        if policy == "regional-mirror":
            split_digest_reference(
                f"{repository}@{digest}", label=label
            )

    selected_models = set(contract["selected_model_ids"])
    model_images = workloads.get("model_image_overrides", {})
    missing = sorted(selected_models - set(model_images))
    if missing:
        raise DeploymentError(
            "selected models lack both a tfvars image override and a runtime-catalog image: "
            + ", ".join(missing)
        )
    for model_id in sorted(selected_models):
        image = model_images[model_id]
        host = image.split("/", 1)[0]
        if host.endswith(".invalid"):
            raise DeploymentError(
                f"selected model {model_id!r} still uses an unresolved .invalid runtime-catalog image"
            )
        if policy == "regional-mirror":
            split_digest_reference(image, label=f"model {model_id}")


def split_digest_reference(reference: str, *, label: str) -> tuple[str, str]:
    """Split one immutable OCI reference without accepting a tag-only source."""
    marker = "@sha256:"
    if reference.count("@") != 1 or reference.count(marker) != 1:
        raise DeploymentError(
            f"{label} image must be pinned as repository@sha256:<64 hex>"
        )
    repository, hexadecimal = reference.rsplit(marker, 1)
    if (
        not repository
        or "/" not in repository
        or any(character in repository for character in ("?", "#"))
        or any(character.isspace() for character in repository)
        or ":" in repository.rsplit("/", 1)[-1]
        or len(hexadecimal) != 64
        or any(character not in "0123456789abcdef" for character in hexadecimal)
    ):
        raise DeploymentError(
            f"{label} image must be pinned as repository@sha256:<64 hex>"
        )
    host, path = repository.split("/", 1)
    host_without_port = host.split(":", 1)[0]
    if (
        "." not in host_without_port
        or not re.fullmatch(r"[a-zA-Z0-9.-]+(?::[0-9]+)?", host)
        or any(part in ("", ".", "..") for part in path.split("/"))
        or not re.fullmatch(r"[a-z0-9._/-]+", path)
    ):
        raise DeploymentError(
            f"{label} image must use a fully-qualified registry host and safe repository path"
        )
    return repository, f"sha256:{hexadecimal}"


def source_repository_path(repository: str) -> str:
    """Preserve an upstream repository path, excluding a Nebius registry ID."""
    parts = repository.split("/")
    if len(parts) < 2:
        raise DeploymentError(f"OCI repository has no path: {repository!r}")
    host, path = parts[0], parts[1:]
    if host.startswith("cr.") and host.endswith(".nebius.cloud") and len(path) > 1:
        path = path[1:]
    if not path or any(part in ("", ".", "..") for part in path):
        raise DeploymentError(f"OCI repository has an unsafe path: {repository!r}")
    return "/".join(path)


def selected_image_artifacts(
    contract: Mapping[str, Any],
    registry_delivery: Mapping[str, Any],
) -> list[dict[str, str]]:
    """Return the complete selected source-to-target image closure."""
    expected_policy = contract["artifact_delivery"]
    if (
        registry_delivery.get("schema")
        != "fs2-serve.nebius.ai/registry-delivery/v1"
        or registry_delivery.get("mode") != expected_policy["mode"]
        or registry_delivery.get("repository_prefix")
        != expected_policy["repository_prefix"]
    ):
        raise DeploymentError(
            "the infrastructure registry-delivery output differs from terraform.tfvars"
        )
    target = registry_delivery.get("target_registry")
    if not isinstance(target, dict):
        raise DeploymentError("the infrastructure registry-delivery output is malformed")
    target_region = contract["target"]["region"]
    target_registry_id = str(target.get("id", ""))
    target_fqdn = str(target.get("fqdn", "")).rstrip("/")
    target_root = str(target.get("repository_root", "")).rstrip("/")
    expected_fqdn = f"cr.{target_region}.nebius.cloud"
    expected_root = (
        f"{expected_fqdn}/{target_registry_id.removeprefix('registry-')}"
    )
    if (
        not re.fullmatch(r"registry-[a-z0-9]+", target_registry_id)
        or target.get("project_id") != contract["target"]["project_id"]
        or target.get("region") != target_region
        or target_fqdn != expected_fqdn
        or target_root != expected_root
    ):
        raise DeploymentError("the infrastructure target registry root is malformed")

    workloads = contract["stages"]["workloads"]
    sources: list[tuple[str, str]] = [
        (
            "application/control-plane",
            f"{workloads['control_plane_image']['repository']}@{workloads['control_plane_image']['digest']}",
        ),
        (
            "application/admin-console",
            f"{workloads['admin_console']['image']['repository']}@{workloads['admin_console']['image']['digest']}",
        ),
    ]
    sources.extend(
        (f"model/{model_id}", workloads["model_image_overrides"][model_id])
        for model_id in contract["selected_model_ids"]
    )

    prefix = str(registry_delivery.get("repository_prefix", "")).strip("/")
    artifacts: list[dict[str, str]] = []
    target_sources: dict[str, str] = {}
    for name, source_reference in sources:
        source_repository, digest = split_digest_reference(
            source_reference, label=name
        )
        relative_repository = source_repository_path(source_repository)
        target_repository = "/".join(
            part for part in (target_root, prefix, relative_repository) if part
        )
        prior_source = target_sources.get(target_repository)
        if prior_source is not None and prior_source != source_repository:
            raise DeploymentError(
                "two distinct upstream repositories collapse to the same target repository: "
                f"{target_repository}"
            )
        target_sources[target_repository] = source_repository
        target_tag = f"{target_repository}:mirror-sha256-{digest.removeprefix('sha256:')}"
        artifacts.append(
            {
                "name": name,
                "source_repository": source_repository,
                "source_reference": source_reference,
                "digest": digest,
                "target_repository": target_repository,
                "target_reference": f"{target_repository}@{digest}",
                "target_tag": target_tag,
            }
        )
    return artifacts


def rewritten_workloads(
    contract: Mapping[str, Any], dynamic: Mapping[str, Any]
) -> dict[str, Any]:
    """Rewrite runtime pulls to the regional target without changing digests."""
    workloads = dict(contract["stages"]["workloads"])
    if contract["artifact_delivery"]["mode"] == "direct-source":
        return workloads
    artifacts = {
        artifact["name"]: artifact
        for artifact in selected_image_artifacts(
            contract, dynamic["registry_delivery_contract"]
        )
    }
    control_plane = dict(workloads["control_plane_image"])
    control_plane["repository"] = artifacts["application/control-plane"][
        "target_repository"
    ]
    workloads["control_plane_image"] = control_plane

    admin_console = dict(workloads["admin_console"])
    admin_image = dict(admin_console["image"])
    admin_image["repository"] = artifacts["application/admin-console"][
        "target_repository"
    ]
    admin_console["image"] = admin_image
    workloads["admin_console"] = admin_console
    workloads["model_image_overrides"] = {
        model_id: artifacts[f"model/{model_id}"]["target_reference"]
        for model_id in contract["selected_model_ids"]
    }
    return workloads


def merge_docker_config(base: Any, extra: Any) -> dict[str, Any]:
    """Merge Docker auth documents without logging or persisting credentials."""
    if not isinstance(base, dict) or not isinstance(extra, dict):
        raise DeploymentError("registry Docker configuration must be a JSON object")
    merged = dict(base)
    for key in ("auths", "credHelpers"):
        base_values = merged.get(key, {})
        extra_values = extra.get(key, {})
        if not isinstance(base_values, dict) or not isinstance(extra_values, dict):
            raise DeploymentError(f"registry Docker configuration {key} must be an object")
        merged[key] = {**base_values, **extra_values}
    for key, value in extra.items():
        if key not in {"auths", "credHelpers"}:
            merged[key] = value
    return merged


@contextmanager
def registry_client_environment(
    contract: Mapping[str, Any],
    nebius_profile: str,
) -> Iterator[dict[str, str]]:
    """Materialize optional private registry auth only in an ephemeral directory."""
    environment = clean_environment()
    environment["NEBIUS_PROFILE"] = nebius_profile
    secret_name = contract["secret_environment"]["nvcr_dockerconfig"]
    encoded_extra = os.environ.get(secret_name)
    if not encoded_extra:
        yield environment
        return
    try:
        extra = json.loads(encoded_extra)
    except json.JSONDecodeError as exc:
        raise DeploymentError(
            f"the Docker configuration in environment reference {secret_name!r} is not valid JSON"
        ) from exc

    docker_config_root = Path(
        environment.get("DOCKER_CONFIG", str(Path.home() / ".docker"))
    )
    base_path = docker_config_root / "config.json"
    base: Any = {}
    if base_path.is_file() and not base_path.is_symlink():
        try:
            base = json.loads(base_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            raise DeploymentError("the existing Docker configuration is not valid JSON") from exc

    with tempfile.TemporaryDirectory(prefix="fs2-registry-auth-") as temporary:
        temporary_root = Path(temporary)
        temporary_root.chmod(0o700)
        private_json(temporary_root / "config.json", merge_docker_config(base, extra))
        environment["DOCKER_CONFIG"] = str(temporary_root)
        yield environment


def crane_digest(
    crane: str,
    reference: str,
    environment: Mapping[str, str],
    *,
    missing_ok: bool = False,
) -> str | None:
    result = subprocess.run(
        [crane, "digest", reference],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        missing_markers = (
            "manifest unknown",
            "manifest_unknown",
            "name unknown",
            "name_unknown",
            "not found",
            "404",
        )
        diagnostic = f"{result.stdout}\n{result.stderr}".lower()
        if missing_ok and any(marker in diagnostic for marker in missing_markers):
            return None
        raise DeploymentError(
            "registry digest lookup failed; verify source existence and operator registry credentials"
        )
    digest = result.stdout.strip()
    if not digest.startswith("sha256:") or len(digest) != 71:
        raise DeploymentError("registry returned a malformed OCI digest")
    return digest


def crane_copy(
    crane: str,
    source: str,
    target_tag: str,
    environment: Mapping[str, str],
) -> None:
    result = subprocess.run(
        [crane, "copy", "--no-clobber", source, target_tag],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise DeploymentError(
            "regional image copy failed; verify upstream pull and target push credentials"
        )


def mirror_selected_images(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    dynamic: Mapping[str, Any],
) -> Path | None:
    """Copy and verify the complete selected image closure before workloads."""
    if contract["artifact_delivery"]["mode"] == "direct-source":
        return None
    artifacts = selected_image_artifacts(
        contract, dynamic["registry_delivery_contract"]
    )
    receipt_images: list[dict[str, str]] = []
    completed_targets: dict[str, str] = {}
    with registry_client_environment(contract, args.nebius_profile) as environment:
        for artifact in artifacts:
            expected = artifact["digest"]
            target_reference = artifact["target_reference"]
            status = completed_targets.get(target_reference)
            if status is None:
                existing = crane_digest(
                    args.crane, artifact["target_tag"], environment, missing_ok=True
                )
                if existing is not None and existing != expected:
                    raise DeploymentError(
                        f"target mirror tag digest mismatch for {artifact['name']}; refusing to overwrite"
                    )
                if existing == expected:
                    status = "existing"
                else:
                    source_digest = crane_digest(
                        args.crane, artifact["source_reference"], environment
                    )
                    if source_digest != expected:
                        raise DeploymentError(
                            f"upstream digest mismatch for {artifact['name']}; refusing to deploy"
                        )
                    print(f"Mirroring {artifact['name']} into the regional registry.", file=sys.stderr)
                    crane_copy(
                        args.crane,
                        artifact["source_reference"],
                        artifact["target_tag"],
                        environment,
                    )
                    status = "copied"
                if crane_digest(args.crane, artifact["target_tag"], environment) != expected:
                    raise DeploymentError(
                        f"post-copy tag verification failed for {artifact['name']}"
                    )
                if (
                    crane_digest(
                        args.crane, artifact["target_reference"], environment
                    )
                    != expected
                ):
                    raise DeploymentError(
                        f"post-copy digest-reference verification failed for {artifact['name']}"
                    )
                completed_targets[target_reference] = status
            receipt_images.append(
                {
                    "name": artifact["name"],
                    "source_host": artifact["source_repository"].split("/", 1)[0],
                    "digest": expected,
                    "target_reference": artifact["target_reference"],
                    "status": status,
                }
            )
    receipt = {
        "schema": "fs2-serve.nebius.ai/registry-mirror-receipt/v1",
        "mode": "regional-mirror",
        "registry_id": dynamic["registry_delivery_contract"]["target_registry"]["id"],
        "images": receipt_images,
    }
    path = run_root / "registry-mirror.receipt.json"
    private_json(path, receipt)
    return path


def stage_paths(run_root: Path, stage: str) -> tuple[Path, Path, Path]:
    state_names = {
        "infrastructure": "terraform.tfstate",
        "foundation": "foundation.tfstate",
        "workloads": "workloads.tfstate",
    }
    return (
        run_root / state_names[stage],
        run_root / f"{stage}.tfvars.json",
        run_root / "terraform-data" / stage,
    )


def stage_root(stage: str) -> Path:
    return {
        "infrastructure": INFRA_ROOT,
        "foundation": FOUNDATION_ROOT,
        "workloads": WORKLOADS_ROOT,
    }[stage]


def stage_environment(
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
    *,
    include_secrets: bool = True,
) -> dict[str, str]:
    environment = terraform_environment(run_root, stage)
    if not include_secrets:
        return environment
    secret_names = contract["secret_environment"]

    if stage == "foundation":
        username = os.environ.get(secret_names["grafana_username"])
        password = os.environ.get(secret_names["grafana_password"])
        if not username or not password:
            raise DeploymentError(
                "fresh foundation deployment requires both configured Grafana bootstrap username and password environment references"
            )
        environment["TF_VAR_bootstrap_grafana_credentials"] = json.dumps(
            {"username": username, "password": password},
            separators=(",", ":"),
        )

    if stage == "workloads":
        ngc_key = os.environ.get(secret_names["ngc_api_key"])
        docker_config = os.environ.get(secret_names["nvcr_dockerconfig"])
        requirements = contract["secret_requirements"]
        if requirements["ngc_api_key"] and not ngc_key:
            raise DeploymentError(
                "the selected NIM models require the configured NGC API-key environment reference"
            )
        if requirements["nvcr_dockerconfig"] and not docker_config:
            raise DeploymentError(
                "the selected workloads require the configured NVCR dockerconfig environment reference"
            )
        if ngc_key:
            environment["TF_VAR_ngc_api_key"] = ngc_key
        if docker_config:
            environment["TF_VAR_nvcrio_dockerconfigjson"] = docker_config

    return environment


def write_infrastructure_variables(
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
    nebius_profile: str,
) -> Path:
    variables = dict(contract["stages"]["infrastructure"])
    variables["source_commit"] = commit
    variables["nebius_profile"] = nebius_profile
    path = run_root / "infrastructure.tfvars.json"
    private_json(path, variables)
    return path


def ensure_kubeconfig(
    *,
    nebius: str,
    nebius_profile: str,
    kubectl: str,
    run_root: Path,
    cluster_id: str,
    cluster_name: str,
) -> tuple[Path, str]:
    kubeconfig = run_root / "kubeconfig"
    if kubeconfig.is_symlink():
        raise DeploymentError(f"kubeconfig path must not be a symlink: {kubeconfig}")
    environment = clean_environment()
    environment["KUBECONFIG"] = str(kubeconfig)
    run(
        [
            nebius,
            "--profile",
            nebius_profile,
            "mk8s",
            "cluster",
            "get-credentials",
            "--id",
            cluster_id,
            "--external",
            "--force",
            "--context-name",
            cluster_name,
        ],
        env=environment,
    )
    if not kubeconfig.is_file():
        raise DeploymentError("Nebius CLI did not create the run-scoped kubeconfig")
    kubeconfig.chmod(0o600)
    result = run(
        [
            kubectl,
            "--kubeconfig",
            str(kubeconfig),
            "--context",
            cluster_name,
            "get",
            "namespace",
            "kube-system",
            "-o",
            "jsonpath={.metadata.uid}",
        ],
        env=environment,
        capture=True,
    )
    uid = result.stdout.strip()
    if len(uid) < 20:
        raise DeploymentError("kube-system did not return a valid namespace UID")
    return kubeconfig, uid


def legacy_registry_delivery_contract(
    contract: Mapping[str, Any], target_contract: Mapping[str, Any]
) -> dict[str, Any]:
    """Upgrade an existing state whose target registry predates the v1 output."""
    registry = target_contract.get("source_registry")
    if not isinstance(registry, dict):
        raise DeploymentError(
            "the existing infrastructure state has neither a registry-delivery output nor a legacy target registry"
        )
    registry_id = str(registry.get("id", ""))
    fqdn = str(registry.get("fqdn", "")).rstrip("/")
    if not registry_id.startswith("registry-") or not fqdn:
        raise DeploymentError("the legacy infrastructure target registry is malformed")
    policy = contract["artifact_delivery"]
    target_region = contract["target"]["region"]
    cross_region_hosts = sorted(
        host
        for host in policy["source_hosts"]
        if (match := re.fullmatch(r"cr\.([a-z0-9-]+)\.nebius\.cloud", host))
        and match.group(1) != target_region
    )
    return {
        "schema": "fs2-serve.nebius.ai/registry-delivery/v1",
        "mode": policy["mode"],
        "repository_prefix": policy["repository_prefix"],
        "target_registry": {
            "id": registry_id,
            "project_id": registry.get("project_id", contract["target"]["project_id"]),
            "region": target_region,
            "fqdn": fqdn,
            "repository_root": f"{fqdn}/{registry_id.removeprefix('registry-')}",
        },
        "upstream": {
            "source_hosts": policy["source_hosts"],
            "nebius_registries": {},
        },
        "promotion_cross_region_required": bool(cross_region_hosts)
        and policy["mode"] == "regional-mirror",
        "runtime_cross_region_pull_required": bool(cross_region_hosts)
        and policy["mode"] == "direct-source",
        "cross_region_source_hosts": cross_region_hosts,
        "derived_from_legacy_state": True,
    }


def infrastructure_outputs(
    terraform: str,
    run_root: Path,
    contract: Mapping[str, Any],
    *,
    nebius: str,
    nebius_profile: str,
    kubectl: str,
) -> dict[str, Any]:
    environment = stage_environment(run_root, "infrastructure", contract)
    state, _, _ = stage_paths(run_root, "infrastructure")
    terraform_init(terraform, INFRA_ROOT, state, environment)
    cluster_id = terraform_json_output(terraform, INFRA_ROOT, "cluster_id", environment)
    cluster_name = terraform_json_output(terraform, INFRA_ROOT, "cluster_name", environment)
    kubeconfig, kube_system_uid = ensure_kubeconfig(
        nebius=nebius,
        nebius_profile=nebius_profile,
        kubectl=kubectl,
        run_root=run_root,
        cluster_id=cluster_id,
        cluster_name=cluster_name,
    )
    target_contract = terraform_json_output(
        terraform, INFRA_ROOT, "target_contract", environment
    )
    registry_delivery = terraform_optional_json_output(
        terraform, INFRA_ROOT, "registry_delivery_contract", environment
    )
    if registry_delivery is None:
        registry_delivery = legacy_registry_delivery_contract(
            contract, target_contract
        )
    return {
        "run_root": str(run_root.resolve()),
        "kubeconfig_path": str(kubeconfig.resolve()),
        "run_id": contract["run_id"],
        "cluster_id": cluster_id,
        "cluster_name": cluster_name,
        "kube_context": cluster_name,
        "kube_system_uid": kube_system_uid,
        "project_id": contract["target"]["project_id"],
        "target_contract": target_contract,
        "infrastructure_contract": terraform_optional_json_output(
            terraform, INFRA_ROOT, "infrastructure_contract", environment
        ),
        "accelerator_pool_contract": terraform_json_output(
            terraform, INFRA_ROOT, "accelerator_pool_contract", environment
        ),
        "registry_delivery_contract": registry_delivery,
        "public_edge_contract": terraform_json_output(
            terraform, INFRA_ROOT, "public_edge_contract", environment
        ),
    }


def write_downstream_variables(
    run_root: Path,
    contract: Mapping[str, Any],
    dynamic: Mapping[str, Any],
) -> tuple[Path, Path]:
    identity_keys = (
        "run_root",
        "kubeconfig_path",
        "run_id",
        "cluster_id",
        "cluster_name",
        "kube_context",
        "kube_system_uid",
        "project_id",
        "target_contract",
        "infrastructure_contract",
        "accelerator_pool_contract",
    )
    identity = {key: dynamic[key] for key in identity_keys}
    foundation = {**contract["stages"]["foundation"], **identity}
    workloads = {
        **rewritten_workloads(contract, dynamic),
        **identity,
        "public_edge_contract": dynamic["public_edge_contract"],
    }
    if foundation["grafana_publication"]["enabled"]:
        edge = dynamic["public_edge_contract"]
        origin = edge.get("public_origin")
        parsed = urlsplit(origin or "")
        if (
            edge.get("mode") != "public"
            or parsed.scheme != "https"
            or not parsed.hostname
            or parsed.path not in ("", "/")
            or parsed.query
            or parsed.fragment
            or parsed.username
            or parsed.password
        ):
            raise DeploymentError(
                "external Grafana publication requires an exact HTTPS public origin from the infrastructure output"
            )
        origin = origin.rstrip("/")
        foundation["grafana_publication"] = {
            **foundation["grafana_publication"],
            "external_base_url": origin,
        }
        workloads["admin_observability_links"] = {
            "allowed_hosts": [parsed.hostname],
            "grafana": {
                "url": f"{origin}/admin/observability/grafana",
                "verified_external_route": True,
            },
            "prometheus": {"url": "", "verified_external_route": False},
            "loki": {"url": "", "verified_external_route": False},
        }
    foundation_path = run_root / "foundation.tfvars.json"
    workloads_path = run_root / "workloads.tfvars.json"
    private_json(foundation_path, foundation)
    private_json(workloads_path, workloads)
    return foundation_path, workloads_path


def plan_stage(
    terraform: str,
    *,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
    variable_file: Path,
    destroy: bool = False,
) -> tuple[Path, dict[str, Any], dict[str, str]]:
    root = stage_root(stage)
    state, _, _ = stage_paths(run_root, stage)
    environment = stage_environment(
        run_root,
        stage,
        contract,
        include_secrets=not destroy,
    )
    terraform_init(terraform, root, state, environment)
    suffix = "destroy" if destroy else "plan"
    plan_path = run_root / f"{stage}-{suffix}.tfplan"
    document = plan_json(
        terraform,
        root=root,
        environment=environment,
        variable_file=variable_file,
        plan_path=plan_path,
        json_path=run_root / f"{stage}-{suffix}.plan.json",
        destroy=destroy,
    )
    return plan_path, document, environment


def apply_plan(
    terraform: str,
    root: Path,
    plan_path: Path,
    environment: Mapping[str, str],
) -> None:
    run(
        [terraform, f"-chdir={root}", "apply", "-input=false", str(plan_path)],
        env=environment,
    )


def workload_endpoint_outputs(
    terraform: str,
    run_root: Path,
    contract: Mapping[str, Any],
) -> dict[str, Any]:
    """Read only the two non-secret, customer-facing workload endpoints."""
    environment = stage_environment(
        run_root, "workloads", contract, include_secrets=False
    )
    return {
        "mcp_endpoint_url": terraform_json_output(
            terraform, WORKLOADS_ROOT, "mcp_endpoint_url", environment
        ),
        "admin_web_interface_url": terraform_json_output(
            terraform, WORKLOADS_ROOT, "admin_web_interface_url", environment
        ),
    }


def state_ready(
    terraform: str,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
) -> bool:
    state, _, _ = stage_paths(run_root, stage)
    if not state.exists():
        return False
    environment = stage_environment(
        run_root, stage, contract, include_secrets=False
    )
    terraform_init(terraform, stage_root(stage), state, environment)
    result = subprocess.run(
        [
            terraform,
            f"-chdir={stage_root(stage)}",
            "output",
            "-json",
            STAGE_COMPLETION_OUTPUTS[stage],
        ],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return False
    try:
        return json.loads(result.stdout) is not None
    except json.JSONDecodeError:
        return False


def state_has_resources(
    terraform: str,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
) -> bool:
    state, _, _ = stage_paths(run_root, stage)
    if not state.exists():
        return False
    environment = stage_environment(
        run_root, stage, contract, include_secrets=False
    )
    terraform_init(terraform, stage_root(stage), state, environment)
    return bool(state_addresses(terraform, stage_root(stage), environment))


def apply_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="infrastructure",
        contract=contract,
        variable_file=infrastructure_variables,
    )
    apply_plan(args.terraform, INFRA_ROOT, plan_path, environment)

    dynamic = infrastructure_outputs(
        args.terraform,
        run_root,
        contract,
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
    )
    mirror_selected_images(args, run_root, contract, dynamic)
    foundation_variables, workloads_variables = write_downstream_variables(
        run_root, contract, dynamic
    )

    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="foundation",
        contract=contract,
        variable_file=foundation_variables,
    )
    apply_plan(args.terraform, FOUNDATION_ROOT, plan_path, environment)

    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="workloads",
        contract=contract,
        variable_file=workloads_variables,
    )
    apply_plan(args.terraform, WORKLOADS_ROOT, plan_path, environment)

    endpoints = workload_endpoint_outputs(args.terraform, run_root, contract)
    print(json.dumps({"status": "applied", **endpoints}, indent=2))


def plan_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    if not state_ready(args.terraform, run_root, "infrastructure", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="infrastructure",
            contract=contract,
            variable_file=infrastructure_variables,
        )
        print("Planned infrastructure. Apply it before foundation can be planned against the new API server.")
        return

    _, infrastructure_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="infrastructure",
        contract=contract,
        variable_file=infrastructure_variables,
    )
    if plan_changes_managed_resources_or_outputs(infrastructure_plan):
        print(
            "Planned infrastructure changes. Apply infrastructure and rerun plan before planning foundation."
        )
        return

    dynamic = infrastructure_outputs(
        args.terraform,
        run_root,
        contract,
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
    )
    if "artifact_delivery" not in dynamic["accelerator_pool_contract"]:
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="infrastructure",
            contract=contract,
            variable_file=infrastructure_variables,
        )
        print(
            "Planned the registry-delivery contract upgrade. Apply infrastructure before planning downstream stages."
        )
        return
    foundation_variables, workloads_variables = write_downstream_variables(
        run_root, contract, dynamic
    )
    if not state_ready(args.terraform, run_root, "foundation", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="foundation",
            contract=contract,
            variable_file=foundation_variables,
        )
        print("Planned foundation. Apply it before custom resources can be planned.")
        return

    _, foundation_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="foundation",
        contract=contract,
        variable_file=foundation_variables,
    )
    if plan_changes_managed_resources_or_outputs(foundation_plan):
        print(
            "Planned foundation changes. Apply foundation and rerun plan before planning workloads."
        )
        return

    if not state_ready(args.terraform, run_root, "workloads", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="workloads",
            contract=contract,
            variable_file=workloads_variables,
        )
        print("Planned workloads.")
        return

    plan_stage(
        args.terraform,
        run_root=run_root,
        stage="workloads",
        contract=contract,
        variable_file=workloads_variables,
    )
    print("Planned all three existing states after upstream handoffs converged.")


def destroy_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    resources = {
        stage: state_has_resources(args.terraform, run_root, stage, contract)
        for stage in ("infrastructure", "foundation", "workloads")
    }
    cached_foundation = run_root / "foundation.tfvars.json"
    cached_workloads = run_root / "workloads.tfvars.json"
    downstream: tuple[Path, Path] | None = None
    if resources["foundation"] or resources["workloads"]:
        if (
            cached_foundation.is_file()
            and not cached_foundation.is_symlink()
            and cached_workloads.is_file()
            and not cached_workloads.is_symlink()
        ):
            downstream = (cached_foundation, cached_workloads)
        elif state_ready(args.terraform, run_root, "infrastructure", contract):
            dynamic = infrastructure_outputs(
                args.terraform,
                run_root,
                contract,
                nebius=args.nebius,
                nebius_profile=args.nebius_profile,
                kubectl=args.kubectl,
            )
            downstream = write_downstream_variables(run_root, contract, dynamic)
        else:
            raise DeploymentError(
                "downstream resources exist but their private generated tfvars and a complete infrastructure handoff are both unavailable"
            )

    for stage, variable_file in (
        ("workloads", downstream[1] if downstream else None),
        ("foundation", downstream[0] if downstream else None),
        ("infrastructure", infrastructure_variables),
    ):
        if not resources[stage]:
            continue
        if variable_file is None:
            raise DeploymentError(
                f"cannot destroy {stage}: its generated private variable file is unavailable"
            )
        plan_path, _, environment = plan_stage(
            args.terraform,
            run_root=run_root,
            stage=stage,
            contract=contract,
            variable_file=variable_file,
            destroy=True,
        )
        apply_plan(args.terraform, stage_root(stage), plan_path, environment)
    print(f"Destroyed Terraform-owned stack resources. Evidence remains in {run_root}.")


def status_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    stages: dict[str, Any] = {}
    workloads_ready = False
    for stage in ("infrastructure", "foundation", "workloads"):
        state, _, _ = stage_paths(run_root, stage)
        if not state.exists():
            stages[stage] = {"state": "absent", "addresses": 0, "complete": False}
            continue
        environment = stage_environment(
            run_root, stage, contract, include_secrets=False
        )
        terraform_init(args.terraform, stage_root(stage), state, environment)
        addresses = state_addresses(args.terraform, stage_root(stage), environment)
        complete = state_ready(args.terraform, run_root, stage, contract)
        stages[stage] = {
            "state": "ready" if complete else ("partial" if addresses else "empty"),
            "addresses": len(addresses),
            "complete": complete,
        }
        if stage == "workloads":
            workloads_ready = complete
    endpoints = (
        workload_endpoint_outputs(args.terraform, run_root, contract)
        if workloads_ready
        else {
            "mcp_endpoint_url": None,
            "admin_web_interface_url": None,
        }
    )
    print(
        json.dumps(
            {"run_root": str(run_root), "stages": stages, **endpoints},
            indent=2,
        )
    )


def output_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    """Print only the stable non-secret entry points from a completed deployment."""
    if not state_ready(args.terraform, run_root, "workloads", contract):
        raise DeploymentError(
            "workloads are not applied; run inference-stack apply before requesting endpoints"
        )
    print(
        json.dumps(
            workload_endpoint_outputs(args.terraform, run_root, contract),
            indent=2,
        )
    )


def internal_proxy_command(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> list[str]:
    """Build the non-secret command that serves an internal-only edge."""
    if not state_ready(args.terraform, run_root, "workloads", contract):
        raise DeploymentError(
            "workloads are not applied; run inference-stack apply before starting the proxy"
        )

    infrastructure_environment = stage_environment(
        run_root, "infrastructure", contract, include_secrets=False
    )
    infrastructure_state, _, _ = stage_paths(run_root, "infrastructure")
    terraform_init(
        args.terraform,
        INFRA_ROOT,
        infrastructure_state,
        infrastructure_environment,
    )
    cluster_id = terraform_json_output(
        args.terraform, INFRA_ROOT, "cluster_id", infrastructure_environment
    )
    cluster_name = terraform_json_output(
        args.terraform, INFRA_ROOT, "cluster_name", infrastructure_environment
    )
    public_edge = terraform_json_output(
        args.terraform,
        INFRA_ROOT,
        "public_edge_contract",
        infrastructure_environment,
    )
    kubeconfig, _ = ensure_kubeconfig(
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
        run_root=run_root,
        cluster_id=cluster_id,
        cluster_name=cluster_name,
    )

    if (
        not isinstance(public_edge, dict)
        or public_edge.get("mode") != "internal-only"
    ):
        raise DeploymentError(
            "this deployment has a public edge and does not require an operator proxy"
        )
    port_forward = public_edge.get("port_forward")
    if (
        not isinstance(port_forward, dict)
        or port_forward.get("enabled") is not True
    ):
        raise DeploymentError("the Terraform port-forward contract is malformed")
    expected = {
        "bind_address": "127.0.0.1",
        "control_plane_service": "fs2-serve-control-plane",
        "control_plane_port": 8080,
        "admin_console_service": "fs2-serve-control-plane-admin-console",
        "admin_console_port": 8080,
    }
    if any(port_forward.get(key) != value for key, value in expected.items()):
        raise DeploymentError("the Terraform port-forward contract is unsupported")
    try:
        local_ports = [
            int(port_forward["control_plane_local_port"]),
            int(port_forward["admin_console_local_port"]),
            int(port_forward["operator_proxy_port"]),
        ]
    except (KeyError, TypeError, ValueError) as exc:
        raise DeploymentError("the Terraform port-forward contract is malformed") from exc
    application_origin = f"http://localhost:{local_ports[2]}"
    operator_endpoint = f"http://127.0.0.1:{local_ports[2]}"
    if (
        port_forward.get("application_origin") != application_origin
        or port_forward.get("operator_endpoint") != operator_endpoint
    ):
        raise DeploymentError("the Terraform loopback origins do not match its ports")
    endpoints = workload_endpoint_outputs(args.terraform, run_root, contract)
    expected_endpoints = {
        "mcp_endpoint_url": f"{application_origin}/mcp",
        "admin_web_interface_url": f"{application_origin}/admin/",
    }
    if endpoints != expected_endpoints:
        raise DeploymentError("the workload endpoint outputs do not match the edge contract")

    return [
        sys.executable,
        str(INTERNAL_EDGE_PROXY),
        "--kubeconfig",
        str(kubeconfig),
        "--context",
        cluster_name,
        "--kubectl",
        args.kubectl,
        "--control-plane-local-port",
        str(local_ports[0]),
        "--admin-console-local-port",
        str(local_ports[1]),
        "--operator-proxy-port",
        str(local_ports[2]),
        "--mcp-endpoint-url",
        endpoints["mcp_endpoint_url"],
        "--admin-web-interface-url",
        endpoints["admin_web_interface_url"],
    ]


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Plan, apply, inspect, or destroy Kubernetes inference from one terraform.tfvars file."
    )
    parser.add_argument(
        "command",
        choices=(
            "validate",
            "preflight",
            "plan",
            "apply",
            "destroy",
            "status",
            "output",
            "proxy",
        ),
    )
    parser.add_argument(
        "--var-file",
        type=Path,
        default=DEPLOY_ROOT / "terraform.tfvars",
        help="customer terraform.tfvars file (default: k8s-inference/terraform.tfvars)",
    )
    parser.add_argument(
        "--run-root",
        type=Path,
        help="private state/evidence directory; defaults to an XDG state path bound to the tfvars path",
    )
    parser.add_argument("--terraform", default="terraform")
    parser.add_argument("--kubectl", default="kubectl")
    parser.add_argument("--nebius", default="nebius")
    parser.add_argument(
        "--crane",
        default="crane",
        help="OCI registry client used for digest-preserving regional mirrors",
    )
    parser.add_argument(
        "--nebius-profile",
        default=os.environ.get("NEBIUS_PROFILE", "sandbox"),
        help="authenticated Nebius CLI profile (default: NEBIUS_PROFILE or sandbox)",
    )
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    os.umask(0o077)
    args = parse_args(argv)
    variable_file = args.var_file.expanduser().resolve()
    if not variable_file.is_file():
        raise DeploymentError(
            f"configuration does not exist: {variable_file}; copy terraform.tfvars.example first"
        )
    run_root = (args.run_root or default_run_root(variable_file)).expanduser().resolve()
    private_directory(run_root)

    lock_path = run_root / ".inference-stack.lock"
    if lock_path.is_symlink():
        raise DeploymentError(f"lock path must not be a symlink: {lock_path}")
    with lock_path.open("a+", encoding="utf-8") as lock:
        lock_path.chmod(0o600)
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise DeploymentError(
                f"another inference-stack process owns {run_root}"
            ) from exc

        contract, _ = validate_configuration(args.terraform, variable_file, run_root)
        proxy_arguments: list[str] | None = None
        commit = source_commit()
        if args.command == "validate":
            validate_stage_roots(args.terraform, run_root)
            print(
                json.dumps(
                    {
                        "status": "valid",
                        "run_root": str(run_root),
                        "deployment": contract["name"],
                        "profiles": contract["profiles"],
                        "accelerator_pools": contract["selected_accelerator_pool_ids"],
                        "models": contract["selected_model_ids"],
                    },
                    indent=2,
                )
            )
        elif args.command == "preflight":
            preflight_accelerators(args, contract)
        elif args.command == "plan":
            plan_stack(args, run_root, contract, commit)
        elif args.command == "apply":
            require_deployable_images(contract)
            apply_stack(args, run_root, contract, commit)
        elif args.command == "destroy":
            destroy_stack(args, run_root, contract, commit)
        elif args.command == "output":
            output_stack(args, run_root, contract)
        elif args.command == "proxy":
            proxy_arguments = internal_proxy_command(args, run_root, contract)
        else:
            status_stack(args, run_root, contract)
    if proxy_arguments is not None:
        try:
            run(proxy_arguments, env=clean_environment())
        except KeyboardInterrupt:
            pass
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except DeploymentError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(2)
