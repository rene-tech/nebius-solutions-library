def brokered_proxy_session(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    *,
    debug_scope: bool,
    cli_operation: str | None = None,
) -> None:
    """Lease a broker-owned proxy whose raw transports live in a private netns."""

    if cli_operation not in {None, "debug-view", "debug-export"}:
        raise DeploymentError("unsupported brokered debug client operation")
    if cli_operation is not None and not debug_scope:
        raise DeploymentError("debug CLI operations require exact debug scope")
    if cli_operation == "debug-export" and args.debug_request_id is None:
        raise DeploymentError("debug-export requires --debug-request-id")
    if cli_operation != "debug-export" and args.debug_request_id is not None:
        raise DeploymentError("--debug-request-id is accepted only by debug-export")
    if not state_ready("", run_root, "workloads", contract):
        raise DeploymentError("workloads are not retained as applied")
    cluster_id = retained_state_output(run_root, "infrastructure", "cluster_id")
    cluster_name = retained_state_output(run_root, "infrastructure", "cluster_name")
    public_edge = retained_state_output(
        run_root, "infrastructure", "public_edge_contract"
    )
    if not isinstance(cluster_id, str) or not isinstance(cluster_name, str):
        raise DeploymentError("retained infrastructure identity outputs are malformed")
    if (
        not isinstance(public_edge, dict)
        or public_edge.get("mode") != "internal-only"
        or public_edge.get("schema") != "fs2-serve.nebius.ai/public-edge/v2"
        or public_edge.get("transport") != "kubectl-port-forward"
    ):
        raise DeploymentError("brokered proxy applies only to internal-only mode")
    port_forward = public_edge.get("port_forward")
    if not isinstance(port_forward, dict) or port_forward.get("enabled") is not True:
        raise DeploymentError("retained internal proxy contract is malformed")
    expected_isolation = {
        "debug_listener": "caller-owned-mode-0600-unix-socket",
        "kubeconfig_custody": "root-broker-only",
        "listener_modes": ["debug-read-only", "ordinary-authenticated"],
        "ordinary_listener": "application-authenticated-loopback-tcp",
        "raw_host_listeners": [],
        "raw_transport_visibility": "private-network-namespace",
        "schema": "fs2-serve.nebius.ai/internal-proxy-isolation/v1",
    }
    embedded_isolation = port_forward.get("broker_isolation")
    if embedded_isolation is None:
        isolation_contract_source = "retained-public-edge-v2-derived"
        isolation = expected_isolation
    else:
        isolation_contract_source = "embedded-internal-proxy-isolation-v1"
        isolation = embedded_isolation
    if isolation != expected_isolation:
        raise DeploymentError("retained broker-isolation contract is malformed")
    operator_port = port_forward.get("operator_proxy_port")
    if (
        not isinstance(operator_port, int)
        or isinstance(operator_port, bool)
        or not 1024 <= operator_port <= 65535
        or port_forward.get("bind_address") != "127.0.0.1"
    ):
        raise DeploymentError("retained proxy listener is unsupported")
    namespace_listeners = [
        {
            "address": "127.0.0.1",
            "port": port_forward.get("control_plane_local_port"),
            "service": port_forward.get("control_plane_service"),
            "service_port": port_forward.get("control_plane_port"),
        },
        {
            "address": "127.0.0.1",
            "port": port_forward.get("admin_console_local_port"),
            "service": port_forward.get("admin_console_service"),
            "service_port": port_forward.get("admin_console_port"),
        },
    ]
    if (
        namespace_listeners
        != [
            {
                "address": "127.0.0.1",
                "port": port_forward.get("control_plane_local_port"),
                "service": "fs2-serve-control-plane",
                "service_port": 8080,
            },
            {
                "address": "127.0.0.1",
                "port": port_forward.get("admin_console_local_port"),
                "service": "fs2-serve-control-plane-admin-console",
                "service_port": 8080,
            },
        ]
        or any(
            not isinstance(listener["port"], int)
            or isinstance(listener["port"], bool)
            or not 1024 <= listener["port"] <= 65535
            or listener["port"] == operator_port
            for listener in namespace_listeners
        )
        or namespace_listeners[0]["port"] == namespace_listeners[1]["port"]
    ):
        raise DeploymentError("retained private-namespace transport is malformed")
    activation_envelope: object | None = None
    activation: Mapping[str, Any] | None = None
    if debug_scope:
        activation_envelope = _current_debug_activation(run_root)
        activation = _verify_debug_activation(activation_envelope)
        _validate_debug_activation_grant(
            activation,
            cluster_id=cluster_id,
            cluster_name=cluster_name,
        )
    trust_path = CAPSULE_TOOL_PATHS.get("internal_debug_activation_trust", "")
    match = re.fullmatch(r"/proc/self/fd/([0-9]+)", trust_path)
    if match is None:
        raise DeploymentError("proxy broker trust root is not descriptor-pinned")
    trust_fd = int(match.group(1))
    trust_raw = os.pread(trust_fd, os.fstat(trust_fd).st_size, 0)
    try:
        trust = json.loads(trust_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("proxy broker registry is malformed") from exc
    if (
        _canonical_bytes(trust) + b"\n" != trust_raw
        or not isinstance(trust, dict)
        or set(trust) != {"brokers", "issuers", "schema"}
        or trust["schema"]
        != "fs2-serve.nebius.ai/trusted-internal-debug-activation-issuers/v1"
        or not isinstance(trust["brokers"], list)
    ):
        raise DeploymentError("proxy broker registry is not canonical v1")
    broker_id = activation.get("credential_broker_id") if activation else None
    broker_keys = {
        "cluster_ids",
        "config_path",
        "config_sha256",
        "executable_path",
        "executable_sha256",
        "id",
        "isolation_mode",
        "key_id",
        "listener_modes",
        "modes",
        "namespace_policy_sha256",
        "network_namespace_owner_uid",
        "peer_credential_mode",
        "peer_gid",
        "peer_uid",
        "public_key",
        "role",
        "runtime_review_sha256",
        "scope_policy_sha256",
        "socket_path",
    }
    candidates = [
        record
        for record in trust["brokers"]
        if isinstance(record, dict)
        and set(record) == broker_keys
        and record.get("role") == "internal-proxy-session-broker"
        and record.get("modes") == ["debug", "ordinary"]
        and record.get("listener_modes")
        == ["debug-read-only", "ordinary-authenticated"]
        and record.get("isolation_mode")
        == "private-network-namespace+broker-owned-proxy"
        and record.get("network_namespace_owner_uid") == 0
        and isinstance(record.get("cluster_ids"), list)
        and record["cluster_ids"] == sorted(set(record["cluster_ids"]))
        and cluster_id in record["cluster_ids"]
        and (broker_id is None or record.get("id") == broker_id)
    ]
    if len(candidates) != 1:
        raise DeploymentError("proxy session has no unique enrolled root broker")
    broker = candidates[0]
    if (
        broker["socket_path"] != str(DEBUG_CREDENTIAL_BROKER_SOCKET)
        or broker["executable_path"] != str(DEBUG_CREDENTIAL_BROKER_EXECUTABLE)
        or broker["config_path"] != str(DEBUG_CREDENTIAL_BROKER_CONFIG)
        or broker["peer_credential_mode"]
        != "SO_PEERCRED-real-gid+signed-setgid-effective-gid/v2"
        or broker["peer_uid"] != 0
        or not isinstance(broker["peer_gid"], int)
        or any(
            not isinstance(broker[field], str)
            or re.fullmatch(r"[a-f0-9]{64}", broker[field]) is None
            or broker[field] == "0" * 64
            for field in (
                "config_sha256",
                "executable_sha256",
                "namespace_policy_sha256",
                "runtime_review_sha256",
                "scope_policy_sha256",
            )
        )
    ):
        raise DeploymentError("proxy broker enrollment is malformed")
    nonce = os.getrandom(32).hex()
    deployment_sha256 = hashlib.sha256(_canonical_bytes(contract) + b"\n").hexdigest()
    mode = "debug-read-only" if debug_scope else "ordinary-authenticated"
    request = {
        "activation": activation_envelope,
        "caller_effective_gid": os.getegid(),
        "caller_real_gid": os.getgid(),
        "caller_uid": os.getuid(),
        "cluster_id": cluster_id,
        "cluster_name": cluster_name,
        "client_interface": (
            "control-channel-cli" if cli_operation is not None else "interactive-proxy"
        ),
        "client_operation": cli_operation,
        "debug_request_id": (
            str(args.debug_request_id)
            if cli_operation == "debug-export" and args.debug_request_id is not None
            else None
        ),
        "deployment_contract_sha256": deployment_sha256,
        "isolation_contract_source": isolation_contract_source,
        "mode": mode,
        "nonce": nonce,
        "operator_proxy_port": operator_port,
        "schema": "fs2-serve.nebius.ai/internal-proxy-session-request/v2",
    }
    handshake_budget = 30.0
    if activation is not None:
        try:
            activation_expires_at = datetime.fromisoformat(
                str(activation["expires_at"]).replace("Z", "+00:00")
            )
        except ValueError as exc:
            raise DeploymentError("debug proxy activation expiry is malformed") from exc
        handshake_budget = min(
            handshake_budget,
            (activation_expires_at - datetime.now(timezone.utc)).total_seconds(),
        )
    if handshake_budget <= 0:
        raise DeploymentError("proxy broker handshake cannot outlive its activation")
    handshake_deadline = time.monotonic() + handshake_budget

    def bound_handshake_io(operation: str, maximum: float) -> None:
        remaining = handshake_deadline - time.monotonic()
        if remaining <= 0:
            raise DeploymentError(
                f"proxy broker {operation} exceeded its startup deadline"
            )
        connection.settimeout(min(maximum, remaining))

    connection = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    try:
        bound_handshake_io("connect", 5.0)
        connection.connect(str(DEBUG_CREDENTIAL_BROKER_SOCKET))
        peer_pid, peer_uid, peer_gid = struct.unpack(
            "3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
        )
        if peer_pid < 1 or peer_uid != broker["peer_uid"] or peer_gid != broker["peer_gid"]:
            raise DeploymentError("proxy broker peer identity differs")
        bound_handshake_io("send", 5.0)
        connection.sendall(_canonical_bytes(request))
        bound_handshake_io("receive", 20.0)
        response_raw = connection.recv(256 * 1024)
        response = json.loads(response_raw.decode("utf-8"))
        if not isinstance(response, dict) or set(response) != {
            "payload",
            "payload_sha256",
            "signature",
        }:
            raise DeploymentError("proxy broker response envelope is malformed")
        payload = response["payload"]
        expected_keys = {
            "activation_payload_sha256",
            "backend_authorization",
            "broker_config_sha256",
            "broker_executable_sha256",
            "broker_id",
            "broker_runtime_review_sha256",
            "caller_effective_gid",
            "caller_real_gid",
            "caller_uid",
            "client_interface",
            "client_operation",
            "cluster_id",
            "cluster_name",
            "deployment_contract_sha256",
            "expires_at",
            "key_id",
            "lease_clock",
            "listener",
            "mode",
            "namespace_policy_sha256",
            "nonce",
            "peer_observed_caller_gid",
            "peer_observed_caller_uid",
            "raw_transport",
            "schema",
            "scope",
            "scope_policy_sha256",
            "session_id",
            "socket_path",
            "isolation_contract_source",
            "teardown_contract",
        }
        activation_sha256 = (
            hashlib.sha256(_canonical_bytes(activation)).hexdigest()
            if activation is not None
            else None
        )
        expected_scope = (
            {
                "app_id": activation["app_id"],
                "methods": ["GET", "HEAD"],
                "model_id": activation["model_id"],
                "tenant_id": activation["tenant_id"],
            }
            if activation is not None
            else {"mode": "ordinary-authenticated"}
        )
        expected_backend_authorization = (
            {
                "audience": "fs2-request-debug-read",
                "credential_exported": False,
                "header": "x-fs2-debug-authorization",
                "channel_binding_exported": False,
                "channel_binding_header": "x-fs2-debug-channel-binding",
                "injection_location": "root-broker-private-netns",
                "issuer_id": broker["id"],
                "key_id": broker["key_id"],
                "methods": ["GET", "HEAD"],
                "schema": "fs2-serve.nebius.ai/request-debug-proxy-authorization/v1",
                "scope_policy_sha256": broker["scope_policy_sha256"],
            }
            if debug_scope
            else {"mode": "disabled"}
        )
        if (
            not isinstance(payload, Mapping)
            or set(payload) != expected_keys
            or response["payload_sha256"]
            != hashlib.sha256(_canonical_bytes(payload)).hexdigest()
            or payload["schema"]
            != "fs2-serve.nebius.ai/internal-proxy-session-response/v2"
            or payload["activation_payload_sha256"] != activation_sha256
            or payload["broker_id"] != broker["id"]
            or payload["key_id"] != broker["key_id"]
            or payload["caller_uid"] != os.getuid()
            or payload["caller_real_gid"] != os.getgid()
            or payload["caller_effective_gid"] != os.getegid()
            or payload["peer_observed_caller_uid"] != os.getuid()
            or payload["peer_observed_caller_gid"] != os.getgid()
            or payload["client_interface"] != request["client_interface"]
            or payload["client_operation"] != cli_operation
            or payload["cluster_id"] != cluster_id
            or payload["cluster_name"] != cluster_name
            or payload["deployment_contract_sha256"] != deployment_sha256
            or payload["mode"] != mode
            or payload["isolation_contract_source"] != isolation_contract_source
            or payload["nonce"] != nonce
            or payload["socket_path"] != broker["socket_path"]
            or payload["broker_executable_sha256"] != broker["executable_sha256"]
            or payload["broker_config_sha256"] != broker["config_sha256"]
            or payload["broker_runtime_review_sha256"]
            != broker["runtime_review_sha256"]
            or payload["namespace_policy_sha256"]
            != broker["namespace_policy_sha256"]
            or payload["scope_policy_sha256"] != broker["scope_policy_sha256"]
            or payload["scope"] != expected_scope
            or payload["backend_authorization"]
            != expected_backend_authorization
            or payload["lease_clock"]
            != {
                "basis": "signed-wall-to-local-monotonic-v1",
                "heartbeat_interval_seconds": 15,
                "max_clock_skew_seconds": 5,
            }
            or payload["teardown_contract"]
            != {
                "close_connections": True,
                "close_listener": True,
                "close_on_control_eof": True,
                "close_raw_transports": True,
                "destroy_private_namespace": True,
                "reap_children": True,
                "signed_terminal_required": True,
                "teardown_grace_seconds": 5,
            }
            or not isinstance(payload["raw_transport"], Mapping)
            or set(payload["raw_transport"])
            != {
                "host_listeners",
                "host_listener_policy",
                "isolation_mode",
                "kubeconfig_custody",
                "namespace_inode",
                "namespace_listeners",
                "scope_enforcement_location",
            }
            or payload["raw_transport"].get("host_listeners") != []
            or payload["raw_transport"].get("host_listener_policy")
            != "scoped-proxy-only"
            or payload["raw_transport"].get("isolation_mode")
            != "private-network-namespace+broker-owned-proxy"
            or payload["raw_transport"].get("kubeconfig_custody")
            != "root-broker-only"
            or not isinstance(payload["raw_transport"].get("namespace_inode"), int)
            or payload["raw_transport"]["namespace_inode"] < 1
            or payload["raw_transport"].get("namespace_listeners")
            != namespace_listeners
            or payload["raw_transport"].get("scope_enforcement_location")
            != "root-broker-private-netns"
        ):
            raise DeploymentError("proxy broker response violates its isolation contract")
        _verify_debug_broker_signature(
            broker["public_key"], broker["key_id"], response["signature"], payload
        )
        if (
            not isinstance(payload["session_id"], str)
            or re.fullmatch(r"[a-f0-9]{32,64}", payload["session_id"]) is None
        ):
            raise DeploymentError("proxy broker session identity is malformed")
        listener = payload["listener"]
        if debug_scope:
            if cli_operation is not None:
                if listener != {
                    "authentication": "signed-root-broker-control-channel",
                    "kind": "none",
                }:
                    raise DeploymentError("debug CLI escaped its broker control channel")
            else:
                expected_debug_path = (
                    f"/run/user/{os.getuid()}/fs2-debug-proxy-{payload['session_id']}.sock"
                )
                if listener != {
                    "authentication": "filesystem-owner",
                    "kind": "unix",
                    "mode": "0600",
                    "owner_uid": os.getuid(),
                    "path": expected_debug_path,
                }:
                    raise DeploymentError("debug listener is not caller-confined")
                try:
                    listener_details = os.stat(expected_debug_path, follow_symlinks=False)
                except FileNotFoundError as exc:
                    raise DeploymentError("debug listener was not created before lease") from exc
                if (
                    not stat.S_ISSOCK(listener_details.st_mode)
                    or stat.S_IMODE(listener_details.st_mode) != 0o600
                    or listener_details.st_uid != os.getuid()
                ):
                    raise DeploymentError("debug listener ownership or mode is unsafe")
        elif listener != {
            "address": "127.0.0.1",
            "authentication": "upstream-application",
            "kind": "tcp",
            "port": operator_port,
        }:
            raise DeploymentError("ordinary proxy listener changed incompatibly")
        try:
            lease_expiry = datetime.fromisoformat(
                str(payload["expires_at"]).replace("Z", "+00:00")
            )
        except ValueError as exc:
            raise DeploymentError("proxy lease expiry is malformed") from exc
        wall_start = datetime.now(timezone.utc)
        monotonic_start = time.monotonic()
        if (
            lease_expiry.tzinfo is None
            or not wall_start < lease_expiry
            or (
                debug_scope
                and (
                    payload["expires_at"] != activation["expires_at"]
                    or lease_expiry - wall_start > timedelta(days=7)
                )
            )
            or (not debug_scope and lease_expiry - wall_start > timedelta(hours=12))
        ):
            raise DeploymentError("proxy lease exceeds its authorized lifetime")
        monotonic_deadline = monotonic_start + (
            lease_expiry - wall_start
        ).total_seconds()

        def signed_broker_message(raw: bytes, label: str) -> Mapping[str, Any]:
            try:
                envelope = json.loads(raw.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise DeploymentError(f"{label} is not canonical JSON") from exc
            if not isinstance(envelope, dict) or set(envelope) != {
                "payload",
                "payload_sha256",
                "signature",
            }:
                raise DeploymentError(f"{label} envelope is malformed")
            message = envelope["payload"]
            if (
                not isinstance(message, Mapping)
                or envelope["payload_sha256"]
                != hashlib.sha256(_canonical_bytes(message)).hexdigest()
            ):
                raise DeploymentError(f"{label} payload digest differs")
            _verify_debug_broker_signature(
                broker["public_key"], broker["key_id"], envelope["signature"], message
            )
            return message

        def close_session(reason: str, last_sequence: int) -> None:
            teardown_at = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(
                "+00:00", "Z"
            )
            connection.sendall(
                _canonical_bytes(
                    {
                        "last_sequence": last_sequence,
                        "nonce": nonce,
                        "reason": reason,
                        "schema": "fs2-serve.nebius.ai/internal-proxy-close/v1",
                        "session_id": payload["session_id"],
                        "teardown_at": teardown_at,
                    }
                )
            )
            connection.settimeout(5)
            terminal = signed_broker_message(
                connection.recv(32 * 1024), "proxy broker terminal"
            )
            if terminal != {
                "children_reaped": True,
                "backend_authorization_revoked": debug_scope,
                "connections_closed": True,
                "expires_at": payload["expires_at"],
                "listener_closed": True,
                "namespace_destroyed": True,
                "raw_transports_closed": True,
                "reason": reason,
                "schema": "fs2-serve.nebius.ai/internal-proxy-terminal/v1",
                "session_id": payload["session_id"],
                "teardown_at": teardown_at,
            }:
                raise DeploymentError("proxy broker did not prove terminal teardown")

        if cli_operation is not None:
            read_nonce = os.getrandom(32).hex()
            read_path = f"/admin/api/v1/apps/{activation['app_id']}/requests"
            if cli_operation == "debug-export":
                read_path += f"/{args.debug_request_id}"
            read_request = {
                "method": "GET",
                "nonce": read_nonce,
                "operation": cli_operation,
                "path": read_path,
                "schema": "fs2-serve.nebius.ai/internal-debug-cli-read/v1",
                "session_id": payload["session_id"],
            }
            remaining = monotonic_deadline - time.monotonic()
            if remaining <= 0:
                raise DeploymentError("debug CLI lease expired before its scoped read")
            connection.settimeout(min(20.0, remaining))
            connection.sendall(_canonical_bytes(read_request))
            result = signed_broker_message(
                connection.recv(8 * 1024 * 1024), "debug CLI result"
            )
            if not isinstance(result, Mapping) or set(result) != {
                "audit_event_sha256",
                "body_base64",
                "body_sha256",
                "content_type",
                "expires_at",
                "nonce",
                "operation",
                "path",
                "schema",
                "session_id",
                "status",
            }:
                raise DeploymentError("debug CLI result envelope is malformed")
            try:
                body = base64.b64decode(result["body_base64"], validate=True)
            except (ValueError, binascii.Error) as exc:
                raise DeploymentError("debug CLI result body is not canonical base64") from exc
            if (
                result["schema"]
                != "fs2-serve.nebius.ai/internal-debug-cli-result/v1"
                or result["session_id"] != payload["session_id"]
                or result["nonce"] != read_nonce
                or result["operation"] != cli_operation
                or result["path"] != read_path
                or result["expires_at"] != payload["expires_at"]
                or result["status"] != 200
                or result["content_type"] != "application/json"
                or len(body) > 8 * 1024 * 1024
                or hashlib.sha256(body).hexdigest() != result["body_sha256"]
                or re.fullmatch(
                    r"[a-f0-9]{64}", str(result["audit_event_sha256"])
                )
                is None
                or time.monotonic() >= monotonic_deadline
            ):
                raise DeploymentError("debug CLI result violates its exact signed scope")
            sys.stdout.buffer.write(body)
            if not body.endswith(b"\n"):
                sys.stdout.buffer.write(b"\n")
            sys.stdout.buffer.flush()
            close_session("cli-complete", 0)
            return

        print(
            json.dumps(
                {
                    "status": "serving",
                    "mode": mode,
                    "endpoint": (
                        f"unix://{listener['path']}"
                        if debug_scope
                        else f"http://127.0.0.1:{operator_port}"
                    ),
                    "session_id": payload["session_id"],
                    "expires_at": payload["expires_at"],
                },
                sort_keys=True,
            ),
            flush=True,
        )
        sequence = 0
        close_reason = "caller-closed"
        try:
            while True:
                monotonic_now = time.monotonic()
                if monotonic_now >= monotonic_deadline:
                    close_reason = "lease-expired"
                    break
                connection.settimeout(
                    min(20.0, max(0.1, monotonic_deadline - monotonic_now))
                )
                try:
                    heartbeat_raw = connection.recv(32 * 1024)
                except TimeoutError:
                    if time.monotonic() >= monotonic_deadline:
                        close_reason = "lease-expired"
                        break
                    raise DeploymentError("proxy broker heartbeat timed out")
                if not heartbeat_raw:
                    raise DeploymentError("proxy broker session ended before teardown")
                heartbeat = signed_broker_message(
                    heartbeat_raw, "proxy broker heartbeat"
                )
                expected_sequence = sequence + 1
                if (
                    set(heartbeat)
                    != {
                        "expires_at",
                        "backend_authorization_current",
                        "listener_open",
                        "namespace_inode",
                        "observed_at",
                        "raw_transports_bounded",
                        "schema",
                        "sequence",
                        "session_id",
                    }
                    or heartbeat["schema"]
                    != "fs2-serve.nebius.ai/internal-proxy-heartbeat/v2"
                    or heartbeat["session_id"] != payload["session_id"]
                    or heartbeat["sequence"] != expected_sequence
                    or heartbeat["expires_at"] != payload["expires_at"]
                    or heartbeat["backend_authorization_current"] is not debug_scope
                    or heartbeat["listener_open"] is not True
                    or heartbeat["raw_transports_bounded"] is not True
                    or heartbeat["namespace_inode"]
                    != payload["raw_transport"]["namespace_inode"]
                ):
                    raise DeploymentError("proxy broker heartbeat is malformed")
                try:
                    observed_wall = datetime.fromisoformat(
                        str(heartbeat["observed_at"]).replace("Z", "+00:00")
                    )
                except ValueError as exc:
                    raise DeploymentError("proxy broker heartbeat clock is malformed") from exc
                monotonic_now = time.monotonic()
                expected_wall = wall_start + timedelta(
                    seconds=monotonic_now - monotonic_start
                )
                if (
                    observed_wall.tzinfo is None
                    or abs((observed_wall - expected_wall).total_seconds()) > 5
                    or abs(
                        (datetime.now(timezone.utc) - expected_wall).total_seconds()
                    )
                    > 5
                ):
                    close_reason = "clock-anomaly"
                    break
                sequence = expected_sequence
        except KeyboardInterrupt:
            close_reason = "caller-closed"
        except DeploymentError:
            try:
                close_session("client-validation-failed", sequence)
            except (DeploymentError, OSError):
                # The signed contract requires teardown on control-channel EOF.
                # Closing the connection in the outer finally is therefore the
                # fail-closed fallback when a broker cannot return a terminal.
                pass
            raise
        close_session(close_reason, sequence)
        return
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("proxy broker session failed closed") from exc
    finally:
        connection.close()


def internal_proxy_command(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    *,
    debug_scope: bool = False,
) -> tuple[list[str], tuple[int, ...]]:
    """Reject the retired operator-owned raw port-forward implementation."""
    raise DeploymentError(
        "operator-owned port-forward listeners are forbidden; use the broker-owned proxy session"
    )
    # Retained below only as unreachable source provenance for earlier review
    # findings. The accepted command dispatcher has no path to this function.
    if not state_ready(args.terraform, run_root, "workloads", contract):
        raise DeploymentError(
            "workloads are not applied; run inference-stack apply before starting the proxy"
        )

    if CAPSULE_ACCESS_MODE != "local-read-only":
        raise DeploymentError("internal proxy requires the accepted local read-only lane")
    cluster_id = retained_state_output(run_root, "infrastructure", "cluster_id")
    cluster_name = retained_state_output(run_root, "infrastructure", "cluster_name")
    public_edge = retained_state_output(
        run_root, "infrastructure", "public_edge_contract"
    )
    if not isinstance(cluster_id, str) or not isinstance(cluster_name, str):
        raise DeploymentError("retained infrastructure identity outputs are malformed")
    debug_arguments: list[str] = []
    if debug_scope:
        (
            kubeconfig,
            kubeconfig_fds,
            debug_tenant_id,
            debug_model_id,
            debug_app_id,
        ) = existing_read_only_kubeconfig(
            kubectl=args.kubectl,
            run_root=run_root,
            cluster_id=cluster_id,
            cluster_name=cluster_name,
        )
        debug_arguments = [
            "--debug-tenant-id",
            debug_tenant_id,
            "--debug-model-id",
            debug_model_id,
            "--debug-app-id",
            debug_app_id,
        ]
    else:
        kubeconfig, kubeconfig_fds = sealed_normal_proxy_kubeconfig(
            kubectl=args.kubectl,
            run_root=run_root,
            cluster_id=cluster_id,
            cluster_name=cluster_name,
        )

    if not isinstance(public_edge, dict) or public_edge.get("mode") != "internal-only":
        raise DeploymentError(
            "this deployment has a public edge and does not require an operator proxy"
        )
    port_forward = public_edge.get("port_forward")
    if not isinstance(port_forward, dict) or port_forward.get("enabled") is not True:
        raise DeploymentError("the Terraform port-forward contract is malformed")
    expected = {
        "bind_address": "127.0.0.1",
        "control_plane_service": "fs2-serve-control-plane",
        "control_plane_port": 8080,
        "admin_console_service": "fs2-serve-control-plane-admin-console",
        "admin_console_port": 8080,
    }
    if any(port_forward.get(key) != value for key, value in expected.items()):
        raise DeploymentError("the Terraform port-forward contract is unsupported")
    try:
        local_ports = [
            int(port_forward["control_plane_local_port"]),
            int(port_forward["admin_console_local_port"]),
            int(port_forward["operator_proxy_port"]),
        ]
    except (KeyError, TypeError, ValueError) as exc:
        raise DeploymentError(
            "the Terraform port-forward contract is malformed"
        ) from exc
    application_origin = f"http://localhost:{local_ports[2]}"
    operator_endpoint = f"http://127.0.0.1:{local_ports[2]}"
    if (
        port_forward.get("application_origin") != application_origin
        or port_forward.get("operator_endpoint") != operator_endpoint
    ):
        raise DeploymentError("the Terraform loopback origins do not match its ports")
    endpoints = workload_endpoint_outputs(args.terraform, run_root, contract)
    expected_endpoints = {
        "mcp_endpoint_url": f"{application_origin}/mcp",
        "admin_web_interface_url": f"{application_origin}/admin/",
    }
    if any(endpoints.get(key) != value for key, value in expected_endpoints.items()):
        raise DeploymentError(
            "the workload endpoint outputs do not match the edge contract"
        )

    frozen_entry = (
        "import sys,types;a=sys.argv.pop(1);p=sys.argv.pop(1);"
        "sys.path[:]=[];sys.path_hooks[:]=[];sys.path_importer_cache.clear();"
        "sys.meta_path[:]=[x for x in sys.meta_path if getattr(x,'__name__','') in ('BuiltinImporter','FrozenImporter')];"
        "m=types.ModuleType('internal_edge_acceptance');m.__file__='capsule:internal-edge-acceptance';"
        "b=open(a,'rb',buffering=0).read();exec(compile(b,m.__file__,'exec'),m.__dict__);"
        "sys.modules['internal_edge_acceptance']=m;sys.argv[0]='capsule:internal-edge-proxy';"
        "b=open(p,'rb',buffering=0).read();exec(compile(b,sys.argv[0],'exec'),"
        "{'__name__':'__main__','__file__':sys.argv[0]})"
    )
    return [
        CAPSULE_TOOL_PATHS["python3"],
        "-I",
        "-S",
        "-B",
        "-c",
        frozen_entry,
        CAPSULE_TOOL_PATHS["source:internal-edge-acceptance"],
        CAPSULE_TOOL_PATHS["source:internal-edge-proxy"],
        "--kubeconfig",
        str(kubeconfig),
        "--context",
        cluster_name,
        "--kubectl",
        args.kubectl,
        "--control-plane-local-port",
        str(local_ports[0]),
        "--admin-console-local-port",
        str(local_ports[1]),
        "--operator-proxy-port",
        str(local_ports[2]),
        "--mcp-endpoint-url",
        endpoints["mcp_endpoint_url"],
        "--admin-web-interface-url",
        endpoints["admin_web_interface_url"],
        *debug_arguments,
    ], kubeconfig_fds


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Plan, apply, inspect, or destroy Kubernetes inference from one terraform.tfvars file."
    )
    parser.add_argument(
        "command",
        choices=(
            "validate",
            "preflight",
            "plan",
            "apply",
            "destroy",
            "status",
            "output",
            "proxy",
            "debug-proxy",
            "debug-view",
            "debug-export",
            "activate-debug",
            "disable-debug",
            "reconcile",
        ),
    )
    parser.add_argument(
        "--var-file",
        type=Path,
        default=DEPLOY_ROOT / "terraform.tfvars",
        help="customer terraform.tfvars file (default: k8s-inference/terraform.tfvars)",
    )
    parser.add_argument(
        "--run-root",
        type=Path,
        help="private state/evidence directory; defaults to an XDG state path bound to the tfvars path",
    )
    parser.add_argument(
        "--terraform",
        default="terraform",
        help="legacy compatibility argument; accepted operator execution always uses the capsule Terraform descriptor",
    )
    parser.add_argument(
        "--kubectl",
        default="kubectl",
        help="legacy compatibility argument; accepted operator execution always uses the capsule kubectl descriptor",
    )
    parser.add_argument(
        "--nebius",
        default="nebius",
        help="legacy compatibility argument; accepted operator execution always uses the capsule Nebius descriptor",
    )
    parser.add_argument(
        "--crane",
        default="crane",
        help="OCI registry client used for digest-preserving regional mirrors",
    )
    parser.add_argument(
        "--nebius-profile",
        default="sandbox",
        help="signed Nebius authority selector (default: sandbox; caller NEBIUS_PROFILE is converted into this argument before capsule entry)",
    )
    parser.add_argument(
        "--debug-kubeconfig-source",
        type=Path,
        help="retired and rejected: Kubernetes credentials remain in root-broker custody",
    )
    parser.add_argument(
        "--debug-activation-source",
        type=Path,
        help="owner-only externally signed tenant/model debug activation envelope",
    )
    parser.add_argument(
        "--debug-revocation-source",
        type=Path,
        help="owner-only externally signed append-only tenant/model debug revocation envelope",
    )
    parser.add_argument(
        "--debug-request-id",
        type=UUID,
        help="exact request-debug exchange UUID required only by debug-export",
    )
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    os.umask(0o077)
    arguments = list(argv) if argv is not None else sys.argv[1:]
    enter_accepted_capsule(arguments)
    if os.environ.get("FS2_CAPSULE_LAUNCHER"):
        load_capsule_contract()
    args = parse_args(arguments)
    # This runs before Terraform, configuration parsing, provider startup, or
    # any run-root mutation. Public mode is learned from that later plan, so
    # every operator command takes the same protected path and public mode
    # checks it again.
    local_read_only = args.command in LOCAL_READ_ONLY_COMMANDS
    if local_read_only:
        require_protected_read_only_start(args.command)
    else:
        require_protected_apply_start()
        require_brokered_profile(args.nebius_profile)
    args.terraform = CAPSULE_TOOL_PATHS["terraform"]
    args.kubectl = CAPSULE_TOOL_PATHS["kubectl"]
    args.nebius = CAPSULE_TOOL_PATHS["nebius"]
    args.crane = CAPSULE_TOOL_PATHS["crane"]
    variable_file = args.var_file.expanduser().resolve(strict=False)
    run_root = (args.run_root or default_run_root(variable_file)).expanduser().resolve(
        strict=False
    )
    if local_read_only:
        # This branch is intentionally before Terraform version probing,
        # tfvars reads, mkdir/chmod, lock creation, init, plan, cloud auth, and
        # configuration regeneration. Retained JSON/state is the only input.
        contract = retained_run_contract(run_root)
        if args.command == "status":
            retained_status_stack(args, run_root, contract)
            return 0
        if args.command == "output":
            output_stack(args, run_root, contract)
            return 0
        if args.command == "activate-debug":
            with debug_lifecycle_lock(run_root):
                install_debug_activation(args, run_root, contract)
            return 0
        if args.command == "disable-debug":
            with debug_lifecycle_lock(run_root):
                disable_debug_activation(args, run_root, contract)
            return 0
        brokered_proxy_session(
            args,
            run_root,
            contract,
            debug_scope=args.command in {"debug-proxy", "debug-view", "debug-export"},
            cli_operation=(
                args.command
                if args.command in {"debug-view", "debug-export"}
                else None
            ),
        )
        return 0

    require_terraform_version(args.terraform)
    variable_file = variable_file.resolve(strict=True)
    if not variable_file.is_file():
        raise DeploymentError(
            f"configuration does not exist: {variable_file}; copy terraform.tfvars.example first"
        )
    private_directory(run_root)

    lock_path = run_root / ".inference-stack.lock"
    if lock_path.is_symlink():
        raise DeploymentError(f"lock path must not be a symlink: {lock_path}")
    with lock_path.open("a+", encoding="utf-8") as lock:
        lock_path.chmod(0o600)
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise DeploymentError(
                f"another inference-stack process owns {run_root}"
            ) from exc

        contract, configuration_environment = validate_configuration(
            args.terraform, variable_file, run_root
        )
        if not local_read_only:
            require_brokered_target(contract["target"]["project_id"])
        proxy_arguments: list[str] | None = None
        proxy_fds: tuple[int, ...] = ()
        commit = source_commit()
        if args.command == "validate":
            validate_stage_roots(args.terraform, run_root)
            print(
                json.dumps(
                    {
                        "status": "valid",
                        "run_root": str(run_root),
                        "deployment": contract["name"],
                        "profiles": contract["profiles"],
                        "accelerator_pools": contract["selected_accelerator_pool_ids"],
                        "models": contract["selected_model_ids"],
                    },
                    indent=2,
                )
            )
        elif args.command == "preflight":
            preflight_accelerators(args, contract)
        elif args.command == "plan":
            plan_stack(args, run_root, contract, commit)
        elif args.command == "apply":
            require_deployable_images(contract)
            apply_stack(
                args,
                run_root,
                contract,
                commit,
                configuration_environment,
            )
        elif args.command == "destroy":
            destroy_stack(args, run_root, contract, commit)
        elif args.command == "output":
            output_stack(args, run_root, contract)
        elif args.command == "proxy":
            proxy_arguments, proxy_fds = internal_proxy_command(args, run_root, contract)
        elif args.command == "reconcile":
            reconcile_indeterminate_mutations(
                args, run_root, contract, variable_file
            )
        else:
            status_stack(args, run_root, contract)
    if proxy_arguments is not None:
        try:
            run(
                proxy_arguments,
                env=clean_environment(),
                extra_pass_fds=proxy_fds,
            )
        except KeyboardInterrupt:
            pass
        finally:
            for descriptor in proxy_fds:
                os.close(descriptor)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except DeploymentError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(2)
