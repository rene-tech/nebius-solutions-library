def ensure_kubeconfig(
    *,
    nebius: str,
    nebius_profile: str,
    kubectl: str,
    run_root: Path,
    cluster_id: str,
    cluster_name: str,
    provider_attestation: Mapping[str, Any],
) -> tuple[Path, str]:
    kubeconfig = run_root / "kubeconfig"
    if kubeconfig.is_symlink():
        raise DeploymentError(f"kubeconfig path must not be a symlink: {kubeconfig}")
    tools = provider_attestation.get("client_tools", {})
    credentials = provider_attestation.get("credentials", {})
    nebius_tool = tools.get("nebius", {}) if isinstance(tools, Mapping) else {}
    kubectl_tool = tools.get("kubectl", {}) if isinstance(tools, Mapping) else {}
    auditor = credentials.get("auditor", {}) if isinstance(credentials, Mapping) else {}
    signed_context = kubectl_tool.get("context") if isinstance(kubectl_tool, Mapping) else None
    if (
        cluster_id != provider_attestation.get("cluster_id")
        or cluster_name != signed_context
        or not isinstance(nebius_tool, Mapping)
        or not isinstance(kubectl_tool, Mapping)
        or not isinstance(auditor, Mapping)
    ):
        raise DeploymentError(
            "infrastructure kubeconfig target differs from signed provider custody"
        )
    if not kubeconfig.exists():
        created = _pinned_custody_command(
            executable_path=Path(str(nebius_tool["path"])),
            expected_sha256=str(nebius_tool["sha256"]),
            label="provider-signed Nebius CLI",
            arguments=[
                "--profile",
                nebius_profile,
                "mk8s",
                "cluster",
                "get-credentials",
                "--id",
                cluster_id,
                "--external",
                "--context-name",
                cluster_name,
            ],
            environment={
                "HOME": _root_custody_directory(
                    Path(str(nebius_tool["home_path"])),
                    label="signed Nebius CLI home",
                    private=True,
                ),
                "KUBECONFIG": str(kubeconfig),
            },
        )
        if created.returncode != 0:
            raise DeploymentError(
                "provider-signed Nebius CLI could not create the run-scoped kubeconfig"
            )
    auditor_path = os.environ.get("FS2_NETWORK_AUDITOR_KUBECONFIG", "")
    result = _pinned_kubectl_command(
        kubectl=kubectl,
        tool=kubectl_tool,
        expected_kubeconfig_sha256=str(auditor.get("kubeconfig_sha256", "")),
        arguments=[
            "--kubeconfig",
            auditor_path,
            "--context",
            cluster_name,
            "get",
            "namespace",
            "kube-system",
            "-o",
            "jsonpath={.metadata.uid}",
        ],
    )
    try:
        uid = result.stdout.decode("utf-8", errors="strict").strip()
    except UnicodeDecodeError as exc:
        raise DeploymentError("kube-system returned a malformed namespace UID") from exc
    if result.returncode != 0:
        raise DeploymentError("provider-pinned kubectl could not read kube-system")
    if not kubeconfig.is_file():
        raise DeploymentError("Nebius CLI did not create the run-scoped kubeconfig")
    kubeconfig.chmod(0o600)
    if len(uid) < 20:
        raise DeploymentError("kube-system did not return a valid namespace UID")
    return kubeconfig, uid


def legacy_registry_delivery_contract(
    contract: Mapping[str, Any], target_contract: Mapping[str, Any]
) -> dict[str, Any]:
    """Upgrade an existing state whose target registry predates the v1 output."""
    registry = target_contract.get("source_registry")
    if not isinstance(registry, dict):
        raise DeploymentError(
            "the existing infrastructure state has neither a registry-delivery output nor a legacy target registry"
        )
    registry_id = str(registry.get("id", ""))
    fqdn = str(registry.get("fqdn", "")).rstrip("/")
    if not registry_id.startswith("registry-") or not fqdn:
        raise DeploymentError("the legacy infrastructure target registry is malformed")
    policy = contract["artifact_delivery"]
    target_region = contract["target"]["region"]
    cross_region_hosts = sorted(
        host
        for host in policy["source_hosts"]
        if (match := re.fullmatch(r"cr\.([a-z0-9-]+)\.nebius\.cloud", host))
        and match.group(1) != target_region
    )
    return {
        "schema": "fs2-serve.nebius.ai/registry-delivery/v1",
        "mode": policy["mode"],
        "repository_prefix": policy["repository_prefix"],
        "target_registry": {
            "id": registry_id,
            "project_id": registry.get("project_id", contract["target"]["project_id"]),
            "region": target_region,
            "fqdn": fqdn,
            "repository_root": f"{fqdn}/{registry_id.removeprefix('registry-')}",
        },
        "upstream": {
            "source_hosts": policy["source_hosts"],
            "nebius_registries": {},
        },
        "promotion_cross_region_required": bool(cross_region_hosts)
        and policy["mode"] == "regional-mirror",
        "runtime_cross_region_pull_required": bool(cross_region_hosts)
        and policy["mode"] == "direct-source",
        "cross_region_source_hosts": cross_region_hosts,
        "derived_from_legacy_state": True,
    }


def infrastructure_outputs(
    terraform: str,
    run_root: Path,
    contract: Mapping[str, Any],
    *,
    nebius: str,
    nebius_profile: str,
    kubectl: str,
    provider_attestation: Mapping[str, Any],
) -> dict[str, Any]:
    environment = stage_environment(run_root, "infrastructure", contract)
    state, _, _ = stage_paths(run_root, "infrastructure")
    terraform_init(terraform, INFRA_ROOT, state, environment)
    cluster_id = terraform_json_output(terraform, INFRA_ROOT, "cluster_id", environment)
    cluster_name = terraform_json_output(
        terraform, INFRA_ROOT, "cluster_name", environment
    )
    kubeconfig, kube_system_uid = ensure_kubeconfig(
        nebius=nebius,
        nebius_profile=nebius_profile,
        kubectl=kubectl,
        run_root=run_root,
        cluster_id=cluster_id,
        cluster_name=cluster_name,
        provider_attestation=provider_attestation,
    )
    target_contract = terraform_json_output(
        terraform, INFRA_ROOT, "target_contract", environment
    )
    registry_delivery = terraform_optional_json_output(
        terraform, INFRA_ROOT, "registry_delivery_contract", environment
    )
    if registry_delivery is None:
        registry_delivery = legacy_registry_delivery_contract(contract, target_contract)
    reference_data_enabled = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("reference_data", {})
        .get("enabled")
        is True
    )
    reference_data_storage = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "reference_data_storage_contract", environment
        )
        if reference_data_enabled
        else None
    )
    reference_data_access = (
        terraform_optional_json_output(
            terraform,
            INFRA_ROOT,
            "reference_data_object_storage_access",
            environment,
        )
        if reference_data_enabled
        else None
    )
    reference_data_lifecycle = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "reference_data_lifecycle", environment
        )
        if reference_data_enabled
        else None
    )
    scientific_artifacts_enabled = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("scientific_artifacts", {})
        .get("enabled")
        is True
    )
    scientific_artifacts_storage = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "scientific_artifacts_storage_contract", environment
        )
        if scientific_artifacts_enabled
        else None
    )
    # Carries only the access-key ID, the opaque MysteryBox reference and a
    # revision. The S3 secret is resolved ephemerally inside the workloads
    # apply and never reaches this process, a tfvars file or a receipt.
    scientific_artifacts_access = (
        terraform_optional_json_output(
            terraform,
            INFRA_ROOT,
            "scientific_artifacts_object_storage_access",
            environment,
        )
        if scientific_artifacts_enabled
        else None
    )
    scientific_artifacts_lifecycle = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "scientific_artifacts_lifecycle", environment
        )
        if scientific_artifacts_enabled
        else None
    )
    # A general CPU pool is optional, so the output is read only when the facade
    # declared one. Its absence is a valid deployment, not a missing handoff.
    general_cpu_pools = (
        terraform_optional_json_output(
            terraform, INFRA_ROOT, "general_cpu_pool_contract", environment
        )
        if contract.get("stages", {}).get("infrastructure", {}).get("cpu_pools")
        else None
    )
    return {
        "run_root": str(run_root.resolve()),
        "nebius_profile": nebius_profile,
        "kubeconfig_path": str(kubeconfig.resolve()),
        "run_id": contract["run_id"],
        "cluster_id": cluster_id,
        "general_cpu_pool_contract": general_cpu_pools,
        "cluster_name": cluster_name,
        "kube_context": cluster_name,
        "kube_system_uid": kube_system_uid,
        "project_id": contract["target"]["project_id"],
        "target_contract": target_contract,
        "infrastructure_contract": terraform_optional_json_output(
            terraform, INFRA_ROOT, "infrastructure_contract", environment
        ),
        "accelerator_pool_contract": terraform_json_output(
            terraform, INFRA_ROOT, "accelerator_pool_contract", environment
        ),
        "registry_delivery_contract": registry_delivery,
        "public_edge_contract": terraform_json_output(
            terraform, INFRA_ROOT, "public_edge_contract", environment
        ),
        "reference_data_storage_contract": reference_data_storage,
        "reference_data_object_storage_access": reference_data_access,
        "reference_data_lifecycle": reference_data_lifecycle,
        "scientific_artifacts_storage_contract": scientific_artifacts_storage,
        "scientific_artifacts_object_storage_access": scientific_artifacts_access,
        "scientific_artifacts_lifecycle": scientific_artifacts_lifecycle,
    }


def existing_controller_ownership(
    run_root: Path, cluster_id: str, handoff_receipt: str | None
) -> bool:
    """Recognize a completed handoff without repeating it for every new model.

    The initial receipt still proves the transition. Later model/template
    changes do not invalidate that transition when the same accepted state
    already has a single GPU controller owner and no legacy GPU serving objects.
    Exact static CPU services are a separate Terraform-owned lane.
    """
    state_path = run_root / "workloads.tfstate"
    if not handoff_receipt or state_path.is_symlink() or not state_path.is_file():
        return False
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
        resources = state["resources"]
        inputs = {
            resource["name"]: resource["instances"][0]["attributes"]["input"]["value"]
            for resource in resources
            if resource.get("mode") == "managed"
            and resource.get("type") == "terraform_data"
            and not resource.get("module")
            and resource.get("name")
            in {"cluster_contract", "model_controller_contract"}
        }
        controller = inputs["model_controller_contract"]
        accepted = controller.get("accepted_handoff_receipt") or controller.get(
            "expected_handoff_receipt"
        )
        if (
            inputs["cluster_contract"]["cluster_id"] != cluster_id
            or controller.get("workload_owner") != "controller"
            or accepted != handoff_receipt
        ):
            return False
        cpu_resources = set()
        for resource in resources:
            if (
                resource.get("mode") != "managed"
                or resource.get("type") != "terraform_data"
                or resource.get("name") != "cpu_model_runtime_contract"
                or resource.get("module")
            ):
                continue
            for instance in resource.get("instances", []):
                cpu = instance["attributes"]["input"]["value"]
                for document in (cpu["deployment"], cpu["service_manifest"]):
                    metadata = document["metadata"]
                    cpu_resources.add(
                        (document["kind"], metadata["namespace"], metadata["name"])
                    )
                deployment = cpu["deployment"]
                account = deployment["spec"]["template"]["spec"].get(
                    "serviceAccountName"
                )
                if account:
                    cpu_resources.add(
                        ("ServiceAccount", deployment["metadata"]["namespace"], account)
                    )
        for resource in resources:
            if (
                resource.get("mode") != "managed"
                or resource.get("type") != "kubernetes_manifest"
            ):
                continue
            if resource.get("name") == "model_scaler" and resource.get("instances"):
                return False
            if resource.get("name") == "model":
                for instance in resource.get("instances", []):
                    manifest = instance["attributes"]["manifest"]["value"]
                    metadata = manifest.get("metadata", {})
                    if (
                        manifest.get("kind"),
                        metadata.get("namespace"),
                        metadata.get("name"),
                    ) in cpu_resources:
                        continue
                    if manifest.get("kind") in {
                        "Deployment",
                        "Service",
                        "ServiceAccount",
                        "ConfigMap",
                    }:
                        return False
        return True
    except (OSError, ValueError, KeyError, IndexError, TypeError):
        return False


def write_downstream_variables(
    run_root: Path,
    contract: Mapping[str, Any],
    dynamic: Mapping[str, Any],
) -> tuple[Path, Path]:
    identity_keys = (
        "run_root",
        "kubeconfig_path",
        "run_id",
        "cluster_id",
        "cluster_name",
        "kube_context",
        "kube_system_uid",
        "project_id",
        "target_contract",
        "infrastructure_contract",
        "accelerator_pool_contract",
    )
    identity = {key: dynamic[key] for key in identity_keys}
    foundation = {**contract["stages"]["foundation"], **identity}
    workloads = {
        **rewritten_workloads(contract, dynamic),
        **identity,
        "nebius_profile": dynamic.get("nebius_profile", "sandbox"),
        "public_edge_contract": dynamic["public_edge_contract"],
    }
    controller = workloads.get("model_controller")
    if isinstance(controller, Mapping):
        workloads["model_controller"] = {
            **controller,
            "existing_controller_ownership": existing_controller_ownership(
                run_root, dynamic["cluster_id"], controller.get("handoff_receipt")
            ),
        }
    reference_data = workloads.get("reference_data")
    if isinstance(reference_data, Mapping):
        enabled = reference_data.get("enabled") is True
        storage_contract = dynamic.get("reference_data_storage_contract")
        object_access = dynamic.get("reference_data_object_storage_access")
        if enabled and (
            not isinstance(storage_contract, Mapping)
            or not isinstance(object_access, Mapping)
        ):
            raise DeploymentError(
                "enabled reference data requires complete infrastructure storage and object-access outputs"
            )
        workloads["reference_data"] = {
            **reference_data,
            "storage_contract": storage_contract if enabled else None,
            "object_storage_access": object_access if enabled else None,
        }
    scientific_artifacts = workloads.get("scientific_artifacts")
    if isinstance(scientific_artifacts, Mapping):
        enabled = scientific_artifacts.get("enabled") is True
        storage_contract = dynamic.get("scientific_artifacts_storage_contract")
        object_access = dynamic.get("scientific_artifacts_object_storage_access")
        if enabled and (
            not isinstance(storage_contract, Mapping)
            or not isinstance(object_access, Mapping)
        ):
            raise DeploymentError(
                "an enabled scientific artifact store requires complete infrastructure "
                "bucket and object-access outputs"
            )
        if enabled and set(object_access) != {
            "key_id",
            "access_key_id",
            "secret_reference_id",
            "resource_version",
        }:
            raise DeploymentError(
                "the scientific artifact access handoff must contain exactly the key's "
                "non-secret identifiers: resource ID, access-key ID, MysteryBox reference "
                "and cloud resource version"
            )
        workloads["scientific_artifacts"] = {
            **scientific_artifacts,
            "storage_contract": storage_contract if enabled else None,
            "object_storage_access": object_access if enabled else None,
        }
    general_cpu_lane = workloads.get("general_cpu_lane")
    if isinstance(general_cpu_lane, Mapping):
        pool_contract = dynamic.get("general_cpu_pool_contract")
        if general_cpu_lane.get("enabled") is True and not isinstance(
            pool_contract, Mapping
        ):
            raise DeploymentError(
                "an enabled general CPU lane requires the infrastructure general-CPU pool contract"
            )
        if isinstance(pool_contract, Mapping):
            # The lane exists to keep general aggregation off the reference-data
            # nodes, so a pool contract that claims that filesystem is refused
            # rather than quietly admitted.
            if pool_contract.get("reference_data_filesystem") is not False:
                raise DeploymentError(
                    "a general CPU pool must never carry the reference-data filesystem"
                )
            if (
                pool_contract.get("schema")
                != "fs2-serve.nebius.ai/general-cpu-pools/v1"
            ):
                raise DeploymentError(
                    "the general CPU pool handoff must be the v1 general-CPU pool contract"
                )
        workloads["general_cpu_pools"] = (
            pool_contract if general_cpu_lane.get("enabled") is True else None
        )
    scientific_batch = workloads.get("scientific_batch")
    if isinstance(scientific_batch, Mapping):
        artifacts_enabled = (
            isinstance(scientific_artifacts, Mapping)
            and scientific_artifacts.get("enabled") is True
        )
        if scientific_batch.get("enabled") is True and not artifacts_enabled:
            raise DeploymentError(
                "staged scientific batch execution requires the dedicated artifact store"
            )
        if (
            scientific_batch.get("writes_enabled") is True
            and scientific_batch.get("enabled") is not True
        ):
            raise DeploymentError(
                "scientific batch Kubernetes writes require the batch controller gate"
            )
    admin_contract = contract.get("admin_configuration", {})
    if isinstance(admin_contract, Mapping) and admin_contract.get("enabled") is True:
        configuration, configuration_sha256, scaling = derived_admin_configuration(
            contract,
            dynamic,
            workloads,
        )
        workloads.update(
            {
                "admin_configuration": configuration,
                "admin_configuration_sha256": configuration_sha256,
                "model_scaling_overrides": scaling,
            }
        )
    if foundation["grafana_publication"]["enabled"]:
        edge = dynamic["public_edge_contract"]
        origin = edge.get("public_origin")
        parsed = urlsplit(origin or "")
        if (
            edge.get("mode") != "public"
            or parsed.scheme != "https"
            or not parsed.hostname
            or parsed.path not in ("", "/")
            or parsed.query
            or parsed.fragment
            or parsed.username
            or parsed.password
        ):
            raise DeploymentError(
                "external Grafana publication requires an exact HTTPS public origin from the infrastructure output"
            )
        origin = origin.rstrip("/")
        foundation["grafana_publication"] = {
            **foundation["grafana_publication"],
            "external_base_url": origin,
        }
        alertmanager_enabled = (
            isinstance(foundation.get("alertmanager"), Mapping)
            and foundation["alertmanager"].get("enabled") is True
        )
        workloads["admin_observability_links"] = {
            "allowed_hosts": [parsed.hostname],
            "grafana": {
                "url": f"{origin}/admin/observability/grafana",
                "verified_external_route": True,
            },
            "prometheus": {
                "url": f"{origin}/admin/observability/grafana/explore",
                "verified_external_route": True,
            },
            "loki": {
                "url": f"{origin}/admin/observability/grafana/explore",
                "verified_external_route": True,
            },
            "otel": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "dcgm": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "kueue": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "keda": {
                "url": f"{origin}/admin/observability/grafana/dashboards",
                "verified_external_route": True,
            },
            "alertmanager": (
                {
                    "url": f"{origin}/admin/observability/grafana/alerting/silences",
                    "verified_external_route": True,
                }
                if alertmanager_enabled
                else {"url": "", "verified_external_route": False}
            ),
            "tempo": {
                "url": f"{origin}/admin/observability/grafana/explore",
                "verified_external_route": True,
            },
        }
    foundation_path = run_root / "foundation.tfvars.json"
    workloads_path = run_root / "workloads.tfvars.json"
    private_json(foundation_path, foundation)
    private_json(workloads_path, workloads)
    return foundation_path, workloads_path


def plan_stage(
    terraform: str,
    *,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
    variable_file: Path,
    destroy: bool = False,
    environment_overrides: Mapping[str, str] | None = None,
) -> tuple[Path, dict[str, Any], dict[str, str]]:
    if stage == "workloads" and not destroy:
        expected_batch = (
            contract.get("stages", {}).get("workloads", {}).get("scientific_batch")
        )
        if isinstance(expected_batch, Mapping):
            if variable_file.is_symlink() or not variable_file.is_file():
                raise DeploymentError(
                    "the generated workloads input must be a regular file before planning"
                )
            try:
                workload_variables = json.loads(
                    variable_file.read_text(encoding="utf-8")
                )
            except (OSError, json.JSONDecodeError) as error:
                raise DeploymentError(
                    "the generated workloads input is not readable canonical JSON"
                ) from error
            actual_batch = (
                workload_variables.get("scientific_batch")
                if isinstance(workload_variables, Mapping)
                else None
            )
            if actual_batch != expected_batch:
                raise DeploymentError(
                    "the generated scientific batch input differs from the customer "
                    "configuration; regenerate staged inputs with inference-stack"
                )
    root = stage_root(stage)
    state, _, _ = stage_paths(run_root, stage)
    environment = stage_environment(
        run_root,
        stage,
        contract,
        include_secrets=not destroy,
    )
    if environment_overrides:
        environment.update(environment_overrides)
    terraform_init(terraform, root, state, environment)
    suffix = "destroy" if destroy else "plan"
    plan_path = run_root / f"{stage}-{suffix}.tfplan"
    document = plan_json(
        terraform,
        root=root,
        environment=environment,
        variable_file=variable_file,
        plan_path=plan_path,
        json_path=run_root / f"{stage}-{suffix}.plan.json",
        destroy=destroy,
    )
    return plan_path, document, environment


