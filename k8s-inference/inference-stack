def _validate_debug_activation_grant(
    activation: Mapping[str, Any], *, cluster_id: str, cluster_name: str
) -> tuple[str, str, str]:
    """Validate the signed scope without requesting the broker's credential."""

    if set(activation) != {
        "activated_at",
        "app_id",
        "authorization",
        "certificate_sha256",
        "cluster_ca_sha256",
        "cluster_id",
        "cluster_name",
        "credential_broker_id",
        "enabled",
        "expires_at",
        "issuer",
        "kubeconfig_sha256",
        "model_id",
        "records_retention_dependency",
        "schema",
        "server",
        "tenant_id",
    }:
        raise DeploymentError("debug activation violates its exact tenant/model schema")
    try:
        activated_at = datetime.fromisoformat(
            str(activation["activated_at"]).replace("Z", "+00:00")
        )
        expires_at = datetime.fromisoformat(
            str(activation["expires_at"]).replace("Z", "+00:00")
        )
        UUID(str(activation["app_id"]))
    except (KeyError, ValueError) as exc:
        raise DeploymentError("debug activation identity or timestamps are malformed") from exc
    now = datetime.now(timezone.utc)
    tenant_id = activation["tenant_id"]
    model_id = activation["model_id"]
    broker_id = activation["credential_broker_id"]
    if (
        activation["schema"] != "fs2-serve.nebius.ai/debug-activation/v1"
        or activation["enabled"] is not True
        or activation["records_retention_dependency"] != "SAI-02:90-day-purge"
        or activation["cluster_id"] != cluster_id
        or activation["cluster_name"] != cluster_name
        or not isinstance(activation["server"], str)
        or not activation["server"].startswith("https://")
        or not isinstance(tenant_id, str)
        or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", tenant_id) is None
        or not isinstance(model_id, str)
        or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/-]{0,255}", model_id) is None
        or not isinstance(broker_id, str)
        or re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,127}", broker_id) is None
        or activated_at.tzinfo is None
        or expires_at.tzinfo is None
        or activated_at.microsecond != 0
        or expires_at.microsecond != 0
        or not activated_at <= now < expires_at
        or expires_at - activated_at > timedelta(days=7)
        or any(
            not isinstance(activation[field], str)
            or re.fullmatch(r"[a-f0-9]{64}", activation[field]) is None
            or activation[field] == "0" * 64
            for field in (
                "certificate_sha256",
                "cluster_ca_sha256",
                "kubeconfig_sha256",
            )
        )
    ):
        raise DeploymentError(
            "debug activation is not current, exact-scope, or bounded to seven days"
        )
    expected_identity = f"fs2-debug:{tenant_id}:{model_id}"
    expected_services = [
        "fs2-serve-control-plane",
        "fs2-serve-control-plane-admin-console",
    ]
    expected_role_rules = [
        {
            "api_groups": [""],
            "resource_names": expected_services,
            "resources": ["services"],
            "verbs": ["get"],
        },
        {
            "api_groups": [""],
            "resource_names": [],
            "resources": ["pods"],
            "verbs": ["get", "list"],
        },
        {
            "api_groups": [""],
            "resource_names": [],
            "resources": ["pods/portforward"],
            "verbs": ["create"],
        },
    ]
    authorization = activation["authorization"]
    if (
        not isinstance(authorization, Mapping)
        or set(authorization)
        != {
            "decision",
            "identity",
            "namespace",
            "review_sha256",
            "role",
            "role_binding",
        }
        or authorization["decision"] != "allow-port-forward-only"
        or authorization["identity"] != expected_identity
        or authorization["namespace"] != "fs2-system"
        or not isinstance(authorization["review_sha256"], str)
        or re.fullmatch(r"[a-f0-9]{64}", authorization["review_sha256"]) is None
        or authorization["review_sha256"] == "0" * 64
    ):
        raise DeploymentError("debug activation authorization review is malformed")
    role = authorization["role"]
    binding = authorization["role_binding"]
    if (
        not isinstance(role, Mapping)
        or set(role) != {"name", "namespace", "resource_version", "rules", "uid"}
        or role["name"] != "fs2-debug-port-forward"
        or role["namespace"] != "fs2-system"
        or role["rules"] != expected_role_rules
        or not isinstance(role["resource_version"], str)
        or not role["resource_version"]
        or re.fullmatch(r"[a-f0-9-]{20,64}", str(role["uid"])) is None
        or not isinstance(binding, Mapping)
        or set(binding)
        != {"name", "namespace", "resource_version", "role_name", "subjects", "uid"}
        or binding["name"] != "fs2-debug-port-forward"
        or binding["namespace"] != "fs2-system"
        or binding["role_name"] != role["name"]
        or binding["subjects"] != [{"kind": "User", "name": expected_identity}]
        or not isinstance(binding["resource_version"], str)
        or not binding["resource_version"]
        or re.fullmatch(r"[a-f0-9-]{20,64}", str(binding["uid"])) is None
    ):
        raise DeploymentError("debug activation does not bind its exact live RBAC")
    return tenant_id, model_id, str(activation["app_id"])


def _validate_debug_revocation(
    revocation: Mapping[str, Any],
    *,
    activation: Mapping[str, Any],
    activation_payload_sha256: str,
    cluster_id: str,
    cluster_name: str,
    require_fresh: bool,
) -> None:
    if set(revocation) != {
        "activation_payload_sha256",
        "app_id",
        "cluster_id",
        "cluster_name",
        "issuer",
        "model_id",
        "reason",
        "revocation_epoch",
        "revoked_at",
        "schema",
        "tenant_id",
    }:
        raise DeploymentError("debug revocation violates its exact schema")
    try:
        revoked_at = datetime.fromisoformat(
            str(revocation["revoked_at"]).replace("Z", "+00:00")
        )
    except ValueError as exc:
        raise DeploymentError("debug revocation timestamp is malformed") from exc
    now = datetime.now(timezone.utc)
    if (
        revocation["schema"]
        != "fs2-serve.nebius.ai/signed-debug-activation-revocation/v1"
        or revoked_at.tzinfo is None
        or (
            require_fresh
            and not now - timedelta(minutes=5) <= revoked_at <= now + timedelta(seconds=5)
        )
        or revocation["activation_payload_sha256"] != activation_payload_sha256
        or revocation["cluster_id"] != cluster_id
        or revocation["cluster_name"] != cluster_name
        or revocation["tenant_id"] != activation["tenant_id"]
        or revocation["model_id"] != activation["model_id"]
        or revocation["app_id"] != activation["app_id"]
        or revocation["revocation_epoch"] != 1
        or not isinstance(revocation["reason"], str)
        or re.fullmatch(r"[a-z][a-z0-9-]{0,63}", revocation["reason"]) is None
    ):
        raise DeploymentError("debug revocation does not bind the exact activation")


def _debug_revocation_history(run_root: Path) -> dict[str, Mapping[str, Any]]:
    root = run_root / "debug-revocations"
    try:
        details = os.stat(root, follow_symlinks=False)
    except FileNotFoundError:
        return {}
    if (
        not stat.S_ISDIR(details.st_mode)
        or details.st_uid != os.getuid()
        or stat.S_IMODE(details.st_mode) != 0o700
    ):
        raise DeploymentError("debug revocation history is not owner-only")
    by_activation: dict[str, Mapping[str, Any]] = {}
    with os.scandir(root) as entries:
        ordered = sorted(entries, key=lambda entry: entry.name)
    for entry in ordered:
        if (
            entry.is_symlink()
            or not entry.is_file(follow_symlinks=False)
            or re.fullmatch(r"[a-f0-9]{64}\.json", entry.name) is None
        ):
            raise DeploymentError("debug revocation history contains an unsupported entry")
        envelope = retained_json(Path(entry.path), "retained signed debug revocation", 128 * 1024)
        payload = _verify_debug_revocation(envelope)
        if hashlib.sha256(_canonical_bytes(payload)).hexdigest() != entry.name[:-5]:
            raise DeploymentError("debug revocation filename does not bind its payload")
        activation_sha256 = payload.get("activation_payload_sha256")
        if (
            not isinstance(activation_sha256, str)
            or re.fullmatch(r"[a-f0-9]{64}", activation_sha256) is None
            or activation_sha256 in by_activation
        ):
            raise DeploymentError("debug revocation history is ambiguous")
        by_activation[activation_sha256] = payload
    return by_activation


def _verify_debug_broker_signature(
    public_key_text: object,
    key_id: object,
    signature_text: object,
    payload: Mapping[str, Any],
) -> None:
    try:
        public_key = base64.urlsafe_b64decode(
            str(public_key_text) + "=" * (-len(str(public_key_text)) % 4)
        )
        signature = base64.urlsafe_b64decode(
            str(signature_text) + "=" * (-len(str(signature_text)) % 4)
        )
    except (ValueError, binascii.Error) as exc:
        raise DeploymentError("debug credential broker signature is malformed") from exc
    if (
        len(public_key) != 32
        or len(signature) != 64
        or key_id != "sha256:" + hashlib.sha256(public_key).hexdigest()
    ):
        raise DeploymentError("debug credential broker key identity is malformed")
    key_fd = _sealed_memfd(
        "debug-broker-key",
        bytes.fromhex("302a300506032b6570032100") + public_key,
    )
    payload_fd = _sealed_memfd("debug-broker-payload", _canonical_bytes(payload))
    signature_fd = _sealed_memfd("debug-broker-signature", signature)
    try:
        result = subprocess.run(
            [
                CAPSULE_TOOL_PATHS["openssl"],
                "pkeyutl",
                "-verify",
                "-pubin",
                "-keyform",
                "DER",
                "-inkey",
                f"/proc/self/fd/{key_fd}",
                "-rawin",
                "-in",
                f"/proc/self/fd/{payload_fd}",
                "-sigfile",
                f"/proc/self/fd/{signature_fd}",
            ],
            env={
                **clean_environment(),
                "OPENSSL_CONF": "/dev/null",
                "OPENSSL_MODULES": "/nonexistent",
            },
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            pass_fds=tuple(
                sorted({*CAPSULE_PASS_FDS, key_fd, payload_fd, signature_fd})
            ),
            close_fds=True,
        )
    finally:
        os.close(key_fd)
        os.close(payload_fd)
        os.close(signature_fd)
    if result.returncode != 0:
        raise DeploymentError("debug credential broker signature is invalid")


def _brokered_debug_kubeconfig(
    activation_envelope: object,
    activation: Mapping[str, Any],
) -> object:
    """Receive one sealed credential from the separately owned root broker."""

    raise DeploymentError(
        "retired: the root proxy broker never exports its debug credential"
    )
    trust_path = CAPSULE_TOOL_PATHS.get("internal_debug_activation_trust", "")
    match = re.fullmatch(r"/proc/self/fd/([0-9]+)", trust_path)
    if match is None:
        raise DeploymentError("debug credential broker trust root is not pinned")
    trust_fd = int(match.group(1))
    trust_raw = os.pread(trust_fd, os.fstat(trust_fd).st_size, 0)
    try:
        trust = json.loads(trust_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("debug credential broker registry is malformed") from exc
    if (
        _canonical_bytes(trust) + b"\n" != trust_raw
        or not isinstance(trust, dict)
        or set(trust) != {"brokers", "issuers", "schema"}
        or trust["schema"]
        != "fs2-serve.nebius.ai/trusted-internal-debug-activation-issuers/v1"
        or not isinstance(trust["brokers"], list)
    ):
        raise DeploymentError("debug credential broker registry is not canonical v1")
    broker_id = activation.get("credential_broker_id")
    broker_keys = {
        "config_path",
        "config_sha256",
        "executable_path",
        "executable_sha256",
        "id",
        "key_id",
        "cluster_ids",
        "isolation_mode",
        "listener_modes",
        "modes",
        "namespace_policy_sha256",
        "network_namespace_owner_uid",
        "peer_credential_mode",
        "peer_gid",
        "peer_uid",
        "public_key",
        "role",
        "runtime_review_sha256",
        "scope_policy_sha256",
        "socket_path",
    }
    matches = [
        record
        for record in trust["brokers"]
        if isinstance(record, dict)
        and set(record) == broker_keys
        and record.get("id") == broker_id
        and record.get("role") == "internal-proxy-session-broker"
    ]
    if len(matches) != 1:
        raise DeploymentError("debug activation does not select one enrolled broker")
    broker = matches[0]
    if (
        broker["socket_path"] != str(DEBUG_CREDENTIAL_BROKER_SOCKET)
        or broker["executable_path"] != str(DEBUG_CREDENTIAL_BROKER_EXECUTABLE)
        or broker["config_path"] != str(DEBUG_CREDENTIAL_BROKER_CONFIG)
        or broker["peer_credential_mode"]
        != "SO_PEERCRED-real-gid+signed-setgid-effective-gid/v2"
        or broker["modes"] != ["debug", "ordinary"]
        or broker["listener_modes"] != ["debug-read-only", "ordinary-authenticated"]
        or broker["isolation_mode"]
        != "private-network-namespace+broker-owned-proxy"
        or broker["network_namespace_owner_uid"] != 0
        or not isinstance(broker["cluster_ids"], list)
        or broker["cluster_ids"] != sorted(set(broker["cluster_ids"]))
        or activation["cluster_id"] not in broker["cluster_ids"]
        or broker["peer_uid"] != 0
        or not isinstance(broker["peer_gid"], int)
        or any(
            not isinstance(broker[field], str)
            or re.fullmatch(r"[a-f0-9]{64}", broker[field]) is None
            or broker[field] == "0" * 64
            for field in (
                "config_sha256",
                "executable_sha256",
                "namespace_policy_sha256",
                "runtime_review_sha256",
                "scope_policy_sha256",
            )
        )
        or any(
            not isinstance(broker[key], str)
            or re.fullmatch(r"[a-f0-9]{64}", broker[key]) is None
            or broker[key] == "0" * 64
            for key in (
                "config_sha256",
                "executable_sha256",
                "runtime_review_sha256",
            )
        )
    ):
        raise DeploymentError("enrolled debug credential broker is not exact")
    nonce = os.getrandom(32).hex()
    request = {
        "activation": activation_envelope,
        "caller_effective_gid": os.getegid(),
        "caller_real_gid": os.getgid(),
        "caller_uid": os.getuid(),
        "nonce": nonce,
        "schema": "fs2-serve.nebius.ai/debug-kubeconfig-request/v2",
    }
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    descriptor = -1
    try:
        connection.connect(str(DEBUG_CREDENTIAL_BROKER_SOCKET))
        peer_pid, peer_uid, peer_gid = struct.unpack(
            "3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
        )
        if peer_pid < 1 or peer_uid != broker["peer_uid"] or peer_gid != broker["peer_gid"]:
            raise DeploymentError("debug credential broker peer identity differs")
        connection.sendall(_canonical_bytes(request))
        response_raw, ancillary, flags, _address = connection.recvmsg(
            256 * 1024,
            socket.CMSG_SPACE(array.array("i", [0]).itemsize),
        )
        if flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC):
            raise DeploymentError("debug credential broker response is truncated")
        received = array.array("i")
        for level, kind, data in ancillary:
            if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                received.frombytes(data[: len(data) - len(data) % received.itemsize])
        if len(received) != 1:
            for item in received:
                os.close(item)
            raise DeploymentError("debug credential broker returned an invalid descriptor set")
        descriptor = received[0]
    finally:
        connection.close()
    try:
        response = json.loads(response_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        if descriptor >= 0:
            os.close(descriptor)
        raise DeploymentError("debug credential broker response is malformed") from exc
    if not isinstance(response, dict) or set(response) != {
        "payload",
        "payload_sha256",
        "signature",
    }:
        os.close(descriptor)
        raise DeploymentError("debug credential broker envelope is not exact")
    payload = response["payload"]
    payload_keys = {
        "activation_payload_sha256",
        "broker_config_sha256",
        "broker_executable_sha256",
        "broker_id",
        "broker_runtime_review_sha256",
        "caller_effective_gid",
        "caller_real_gid",
        "caller_uid",
        "cluster_id",
        "cluster_name",
        "expires_at",
        "key_id",
        "kubeconfig_sha256",
        "nonce",
        "peer_observed_caller_gid",
        "peer_observed_caller_uid",
        "schema",
        "socket_path",
    }
    if (
        not isinstance(payload, Mapping)
        or set(payload) != payload_keys
        or response["payload_sha256"]
        != hashlib.sha256(_canonical_bytes(payload)).hexdigest()
        or payload["schema"]
        != "fs2-serve.nebius.ai/debug-kubeconfig-broker-response/v2"
        or payload["activation_payload_sha256"]
        != hashlib.sha256(_canonical_bytes(activation)).hexdigest()
        or payload["broker_id"] != broker["id"]
        or payload["key_id"] != broker["key_id"]
        or payload["caller_uid"] != os.getuid()
        or payload["caller_real_gid"] != os.getgid()
        or payload["caller_effective_gid"] != os.getegid()
        or payload["peer_observed_caller_uid"] != os.getuid()
        or payload["peer_observed_caller_gid"] != os.getgid()
        or payload["cluster_id"] != activation["cluster_id"]
        or payload["cluster_name"] != activation["cluster_name"]
        or payload["expires_at"] != activation["expires_at"]
        or payload["kubeconfig_sha256"] != activation["kubeconfig_sha256"]
        or payload["nonce"] != nonce
        or payload["socket_path"] != broker["socket_path"]
        or payload["broker_executable_sha256"] != broker["executable_sha256"]
        or payload["broker_config_sha256"] != broker["config_sha256"]
        or payload["broker_runtime_review_sha256"]
        != broker["runtime_review_sha256"]
    ):
        os.close(descriptor)
        raise DeploymentError("debug credential broker response differs from its request")
    _verify_debug_broker_signature(
        broker["public_key"],
        broker["key_id"],
        response["signature"],
        payload,
    )
    details = os.fstat(descriptor)
    required_seals = (
        fcntl.F_SEAL_SEAL
        | fcntl.F_SEAL_SHRINK
        | fcntl.F_SEAL_GROW
        | fcntl.F_SEAL_WRITE
    )
    if (
        not stat.S_ISREG(details.st_mode)
        or stat.S_IMODE(details.st_mode) != 0o600
        or details.st_size < 1
        or details.st_size > 4 * 1024 * 1024
        or fcntl.fcntl(descriptor, fcntl.F_GET_SEALS) != required_seals
    ):
        os.close(descriptor)
        raise DeploymentError("debug credential broker did not return one sealed memfd")
    raw = os.pread(descriptor, details.st_size, 0)
    os.close(descriptor)
    if hashlib.sha256(raw).hexdigest() != activation["kubeconfig_sha256"]:
        raise DeploymentError("brokered debug kubeconfig differs from signed activation")
    try:
        configuration = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("brokered debug kubeconfig is not canonical JSON") from exc
    if _canonical_bytes(configuration) + b"\n" != raw:
        raise DeploymentError("brokered debug kubeconfig is not canonical")
    return configuration


