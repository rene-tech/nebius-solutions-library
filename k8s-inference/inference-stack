def registry_operation_authority(
    run_root: Path, authority_sha256: str
) -> tuple[Path, dict[str, Any]]:
    matches: list[tuple[Path, dict[str, Any]]] = []
    for path in run_root.glob("registry-copy-*.json"):
        if path.is_symlink() or not path.is_file():
            raise DeploymentError("retained registry operation authority path is unsafe")
        raw = path.read_bytes()
        if hashlib.sha256(raw).hexdigest() != authority_sha256:
            continue
        try:
            value = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise DeploymentError("registry operation authority is malformed") from exc
        if _canonical_bytes(value) + b"\n" != raw or not isinstance(value, dict):
            raise DeploymentError("registry operation authority is not canonical")
        matches.append((path, value))
    if len(matches) != 1:
        raise DeploymentError(
            "indeterminate registry mutation lacks one exact retained operation authority"
        )
    path, operation = matches[0]
    if (
        set(operation)
        != {
            "accepted_commit",
            "accepted_tree",
            "expected_digest",
            "no_clobber",
            "schema",
            "source",
            "target",
        }
        or operation["schema"]
        != "fs2-serve.nebius.ai/registry-copy-operation/v1"
        or operation["accepted_commit"] != os.environ["FS2_CAPSULE_ACCEPTED_COMMIT"]
        or operation["accepted_tree"] != os.environ["FS2_CAPSULE_ACCEPTED_TREE"]
        or operation["no_clobber"] is not True
        or re.fullmatch(r"sha256:[a-f0-9]{64}", str(operation["expected_digest"]))
        is None
    ):
        raise DeploymentError("registry operation authority violates its exact schema")
    return path, operation


def reconcile_indeterminate_mutations(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    configuration_variable_file: Path,
) -> None:
    pending = unresolved_mutation_records(run_root)
    if not pending:
        print(json.dumps({"status": "no-indeterminate-mutations"}, sort_keys=True))
        return
    roots = {
        "configuration": (
            DEPLOY_ROOT,
            configuration_variable_file,
            run_root / "configuration.tfstate",
        ),
        "infrastructure": (
            INFRA_ROOT,
            run_root / "infrastructure.tfvars.json",
            run_root / "terraform.tfstate",
        ),
        "foundation": (
            FOUNDATION_ROOT,
            run_root / "foundation.tfvars.json",
            run_root / "foundation.tfstate",
        ),
        "workloads": (
            WORKLOADS_ROOT,
            run_root / "workloads.tfvars.json",
            run_root / "workloads.tfstate",
        ),
        "registry": (run_root, run_root, run_root),
    }
    for _journal_path, record, receipt_sha256 in pending:
        stage = record.get("stage")
        if (
            stage not in roots
            or record.get("schema")
            != "fs2-serve.nebius.ai/mutation-ledger-receipt/v2"
        ):
            raise DeploymentError(
                "indeterminate mutation journal is outside the staged contract"
            )
        root, variable_file, state = roots[stage]
        evidence_path = run_root / f"mutation-reconciliation-evidence-{receipt_sha256}.json"
        if evidence_path.exists():
            if evidence_path.is_symlink() or not evidence_path.is_file():
                raise DeploymentError("retained reconciliation evidence path is unsafe")
            # Evidence is append-only. An external authority must now verify it
            # and publish the root-owned signed acceptance; do not repeat a
            # refresh/apply sequence while that decision is pending.
            continue
        settlement = _external_signed_record(
            MUTATION_SETTLEMENT_ROOT / f"{receipt_sha256}.settlement.json",
            "fs2-serve.nebius.ai/provider-operation-settlement/v1",
        )
        settlement_keys = {
            "accepted_commit", "accepted_tree", "authority_id", "indeterminate_receipt_sha256",
            "key_id", "observed_at_unix", "operations", "outstanding_operation_ids",
            "observer_config_sha256", "observer_executable_sha256", "observer_id",
            "observer_runtime_review_sha256", "project_id", "provider_class",
            "provider_endpoint", "schema", "stage",
            "postconditions",
        }
        operations = settlement.get("operations")
        expected_provider_class = {
            "configuration": "terraform-local",
            "infrastructure": "nebius",
            "foundation": "kubernetes-helm",
            "workloads": "kubernetes-helm",
            "registry": "registry",
        }[stage]
        if (
            set(settlement) != settlement_keys
            or settlement["accepted_commit"] != os.environ["FS2_CAPSULE_ACCEPTED_COMMIT"]
            or settlement["accepted_tree"] != os.environ["FS2_CAPSULE_ACCEPTED_TREE"]
            or settlement["indeterminate_receipt_sha256"] != receipt_sha256
            or settlement["stage"] != stage
            or settlement["project_id"] != contract["target"]["project_id"]
            or settlement["provider_class"] != expected_provider_class
            or not isinstance(settlement["observed_at_unix"], int)
            or settlement["observed_at_unix"] < record["recorded_at_unix"]
            or settlement["outstanding_operation_ids"] != []
            or not isinstance(operations, list)
            or (stage == "infrastructure" and not operations)
            or not isinstance(settlement["postconditions"], dict)
            or any(
                not isinstance(operation, dict)
                or set(operation) != {"id", "settled_at_unix", "status"}
                or not isinstance(operation["id"], str)
                or not operation["id"]
                or operation["status"] not in {"SUCCEEDED", "FAILED", "CANCELLED"}
                or not isinstance(operation["settled_at_unix"], int)
                or operation["settled_at_unix"] < record["recorded_at_unix"]
                for operation in operations
            )
        ):
            raise DeploymentError(
                f"authoritative provider settlement for {stage} is incomplete or mismatched"
            )
        if stage == "registry":
            _operation_path, registry_operation = registry_operation_authority(
                run_root, str(record.get("authority_sha256", ""))
            )
            postconditions = settlement["postconditions"]
            if set(postconditions) != {
                "authority_sha256",
                "digest_reference",
                "observed_digest",
                "tag_reference",
                "target_absent",
            }:
                raise DeploymentError("registry settlement postconditions are incomplete")
            expected_identity = {
                "authority_sha256": record["authority_sha256"],
                "digest_reference": registry_operation["target"].rsplit(":", 1)[0]
                + "@"
                + registry_operation["expected_digest"],
                "tag_reference": registry_operation["target"],
            }
            if any(
                postconditions[key] != value
                for key, value in expected_identity.items()
            ):
                raise DeploymentError(
                    "registry settlement does not bind the exact no-clobber target"
                )
            if postconditions["observed_digest"] == registry_operation["expected_digest"]:
                if postconditions["target_absent"] is not False:
                    raise DeploymentError("registry settlement contradicts its observed digest")
                reconciled_by = "authoritative-existing-digest"
            elif (
                postconditions["observed_digest"] is None
                and postconditions["target_absent"] is True
            ):
                source_digest = fresh_crane_digest(
                    args.crane,
                    registry_operation["source"],
                    contract=contract,
                    nebius_profile=args.nebius_profile,
                )
                if source_digest != registry_operation["expected_digest"]:
                    raise DeploymentError(
                        "registry reconciliation source no longer has its accepted digest"
                    )
                with registry_client_environment(
                    contract, args.nebius_profile
                ) as registry_environment:
                    crane_copy(
                        args.crane,
                        registry_operation["source"],
                        registry_operation["target"],
                        registry_environment,
                        run_root=run_root,
                        expected_digest=registry_operation["expected_digest"],
                        reconciliation_of=receipt_sha256,
                    )
                if fresh_crane_digest(
                    args.crane,
                    registry_operation["target"],
                    contract=contract,
                    nebius_profile=args.nebius_profile,
                ) != registry_operation["expected_digest"]:
                    raise DeploymentError(
                        "registry retry lacks the exact post-copy digest"
                    )
                reconciled_by = "fenced-no-clobber-retry"
            else:
                raise DeploymentError(
                    "registry settlement reports a conflicting target digest"
                )
            settlement_path = (
                MUTATION_SETTLEMENT_ROOT / f"{receipt_sha256}.settlement.json"
            )
            append_only_private_json(
                evidence_path,
                {
                    "accepted_commit": os.environ["FS2_CAPSULE_ACCEPTED_COMMIT"],
                    "accepted_tree": os.environ["FS2_CAPSULE_ACCEPTED_TREE"],
                    "authority_sha256": record["authority_sha256"],
                    "expected_digest": registry_operation["expected_digest"],
                    "indeterminate_receipt_sha256": receipt_sha256,
                    "provider_settlement_sha256": hashlib.sha256(
                        settlement_path.read_bytes()
                    ).hexdigest(),
                    "reconciled_by": reconciled_by,
                    "schema": "fs2-serve.nebius.ai/registry-mutation-reconciliation-evidence/v1",
                    "stage": "registry",
                    "target": registry_operation["target"],
                },
            )
            continue
        if settlement["postconditions"] != {}:
            raise DeploymentError(
                "Terraform settlement contains unexpected registry postconditions"
            )
        if not variable_file.is_file() or variable_file.is_symlink():
            raise DeploymentError(
                f"cannot reconcile {stage}: exact variable input is unavailable"
            )
        environment = stage_environment(
            run_root,
            "configuration" if stage == "configuration" else stage,
            contract,
            # Reacquire only the four accepted one-shot broker slots so the
            # exact full no-drift plan sees the same credential-presence
            # booleans as normal apply. Values stay process-local and are not
            # serialized into settlement or reconciliation evidence.
            include_secrets=True,
        )
        execute_fenced_mutation(
            [
                args.terraform,
                f"-chdir={root}",
                "init",
                "-input=false",
                "-reconfigure",
                f"-backend-config=path={state}",
            ],
            run_root=run_root,
            stage=stage,
            root=root,
            operation="reconcile-terraform-init",
            authority_path=variable_file,
            environment=environment,
            reconciliation_of=receipt_sha256,
        )
        refresh_plan = run_root / f"mutation-reconcile-{receipt_sha256}.tfplan"
        command = [
            args.terraform,
            f"-chdir={root}",
            "plan",
            "-refresh-only",
            "-detailed-exitcode",
            "-input=false",
            "-lock=true",
            f"-var-file={variable_file}",
            f"-out={refresh_plan}",
        ]
        result = execute_fenced_mutation(
            command,
            run_root=run_root,
            stage=stage,
            root=root,
            operation="reconcile-refresh-plan",
            authority_path=variable_file,
            environment=environment,
            accepted_return_codes={0, 2},
            reconciliation_of=receipt_sha256,
        )
        if result.returncode not in {0, 2} or not refresh_plan.is_file():
            raise DeploymentError(
                f"refresh-state reconciliation plan for {stage} did not complete"
            )
        refresh_sha256 = hashlib.sha256(refresh_plan.read_bytes()).hexdigest()
        refresh_apply = execute_fenced_mutation(
            [args.terraform, f"-chdir={root}", "apply", "-input=false", "-lock=true", str(refresh_plan)],
            run_root=run_root,
            stage=stage,
            root=root,
            operation="reconcile-refresh-apply",
            authority_path=refresh_plan,
            environment=environment,
            reconciliation_of=receipt_sha256,
        )
        if refresh_apply.returncode != 0:
            raise DeploymentError(
                f"refresh-only state application for {stage} did not complete; mutation remains indeterminate"
            )
        no_drift_plan = run_root / f"mutation-postcondition-{receipt_sha256}.tfplan"
        no_drift = execute_fenced_mutation(
            [
                args.terraform,
                f"-chdir={root}",
                "plan",
                "-detailed-exitcode",
                "-input=false",
                "-lock=true",
                f"-var-file={variable_file}",
                f"-out={no_drift_plan}",
            ],
            run_root=run_root,
            stage=stage,
            root=root,
            operation="reconcile-no-drift-plan",
            authority_path=variable_file,
            environment=environment,
            reconciliation_of=receipt_sha256,
        )
        if no_drift.returncode != 0 or not no_drift_plan.is_file():
            raise DeploymentError(
                f"exact desired-state postcondition for {stage} is not a no-op; mutation remains indeterminate"
            )
        state_result = execute_fenced_mutation(
            [args.terraform, f"-chdir={root}", "show", "-json", str(state)],
            run_root=run_root,
            stage=stage,
            root=root,
            operation="reconcile-state-projection",
            authority_path=state,
            environment=environment,
            reconciliation_of=receipt_sha256,
            capture_output=True,
        )
        output_result = execute_fenced_mutation(
            [args.terraform, f"-chdir={root}", "output", "-json"],
            run_root=run_root,
            stage=stage,
            root=root,
            operation="reconcile-output-projection",
            authority_path=state,
            environment=environment,
            reconciliation_of=receipt_sha256,
            capture_output=True,
        )
        try:
            state_projection = json.loads(state_result.stdout)
            output_projection = json.loads(output_result.stdout)
        except json.JSONDecodeError as exc:
            raise DeploymentError("refreshed Terraform state/output projection is malformed") from exc
        required_output = STAGE_COMPLETION_OUTPUTS.get(stage)
        if required_output is not None and (
            not isinstance(output_projection, dict) or required_output not in output_projection
        ):
            raise DeploymentError(
                f"refreshed {stage} state lacks the exact completion postcondition output"
            )
        settlement_path = MUTATION_SETTLEMENT_ROOT / f"{receipt_sha256}.settlement.json"
        settlement_sha256 = hashlib.sha256(settlement_path.read_bytes()).hexdigest()
        append_only_private_json(
            evidence_path,
            {
                "accepted_commit": os.environ["FS2_CAPSULE_ACCEPTED_COMMIT"],
                "accepted_tree": os.environ["FS2_CAPSULE_ACCEPTED_TREE"],
                "indeterminate_receipt_sha256": receipt_sha256,
                "no_drift_plan_sha256": hashlib.sha256(no_drift_plan.read_bytes()).hexdigest(),
                "output_postconditions_sha256": hashlib.sha256(_canonical_bytes(output_projection)).hexdigest(),
                "provider_settlement_sha256": settlement_sha256,
                "refresh_only_exit_code": result.returncode,
                "refresh_only_plan_sha256": refresh_sha256,
                "refreshed_state_sha256": hashlib.sha256(_canonical_bytes(state_projection)).hexdigest(),
                "schema": "fs2-serve.nebius.ai/terraform-mutation-reconciliation-evidence/v2",
                "stage": stage,
            },
        )
    print(
        json.dumps(
            {
                "status": "awaiting-external-reconciliation-acceptance",
                "count": len(pending),
            },
            sort_keys=True,
        )
    )


def workload_endpoint_outputs(
    terraform: str,
    run_root: Path,
    contract: Mapping[str, Any],
) -> dict[str, Any]:
    """Read all non-secret, customer-facing workload endpoints."""
    environment = (
        None
        if CAPSULE_ACCESS_MODE == "local-read-only"
        else stage_environment(run_root, "workloads", contract, include_secrets=False)
    )
    outputs = {
        "mcp_endpoint_url": stage_output(
            terraform, run_root, "workloads", WORKLOADS_ROOT, "mcp_endpoint_url", environment
        ),
        "admin_web_interface_url": stage_output(
            terraform, run_root, "workloads", WORKLOADS_ROOT, "admin_web_interface_url", environment
        ),
        "inference_base_url": stage_output(
            terraform, run_root, "workloads", WORKLOADS_ROOT, "inference_base_url", environment
        ),
        "grafana_url": stage_output(
            terraform, run_root, "workloads", WORKLOADS_ROOT, "grafana_url", environment, optional=True
        ),
        "alertmanager_url": stage_output(
            terraform, run_root, "workloads", WORKLOADS_ROOT, "alertmanager_url", environment, optional=True
        ),
        "tempo_explore_url": stage_output(
            terraform, run_root, "workloads", WORKLOADS_ROOT, "tempo_explore_url", environment, optional=True
        ),
    }
    reference_enabled = (
        contract.get("stages", {})
        .get("workloads", {})
        .get("reference_data", {})
        .get("enabled")
        is True
    )
    outputs["reference_data"] = (
        stage_output(
            terraform, run_root, "workloads", WORKLOADS_ROOT, "reference_data_status", environment, optional=True
        )
        if reference_enabled
        else None
    )
    outputs["reference_data_contract"] = (
        stage_output(
            terraform, run_root, "workloads", WORKLOADS_ROOT, "reference_data_contract", environment, optional=True
        )
        if reference_enabled
        else None
    )
    scientific_enabled = (
        contract.get("stages", {})
        .get("workloads", {})
        .get("scientific_artifacts", {})
        .get("enabled")
        is True
    )
    outputs["scientific_artifacts"] = (
        stage_output(
            terraform, run_root, "workloads", WORKLOADS_ROOT, "scientific_artifacts_status", environment, optional=True
        )
        if scientific_enabled
        else None
    )
    outputs["scientific_artifacts_contract"] = (
        stage_output(
            terraform, run_root, "workloads", WORKLOADS_ROOT, "scientific_artifacts_contract", environment, optional=True
        )
        if scientific_enabled
        else None
    )
    return outputs


def workload_access_bundle(
    terraform: str,
    run_root: Path,
    contract: Mapping[str, Any],
) -> dict[str, Any]:
    """Read the explicit sensitive connection bundle from workloads state."""

    environment = (
        None
        if CAPSULE_ACCESS_MODE == "local-read-only"
        else stage_environment(run_root, "workloads", contract, include_secrets=False)
    )
    bundle = stage_output(
        terraform, run_root, "workloads", WORKLOADS_ROOT, "access_bundle", environment
    )
    if not isinstance(bundle, dict) or bundle.get("schema") != "fs2-serve.nebius.ai/access-bundle/v1":
        raise DeploymentError("the workloads access bundle is missing or malformed")

    cluster = bundle.get("cluster")
    endpoints = bundle.get("endpoints")
    credentials = bundle.get("credentials")
    mcp_access = bundle.get("mcp_access")
    scientific_access = bundle.get("scientific_access")
    reference_data = bundle.get("reference_data")
    reference_data_contract = bundle.get("reference_data_contract")
    if not all(
        isinstance(value, dict)
        for value in (cluster, endpoints, credentials, mcp_access)
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")

    def has_non_empty_strings(document: Mapping[str, Any], fields: tuple[str, ...]) -> bool:
        return all(
            isinstance(document.get(field), str) and bool(document[field].strip())
            for field in fields
        )

    if not has_non_empty_strings(
        cluster,
        (
            "project_id",
            "region",
            "cluster_id",
            "cluster_name",
            "kube_context",
            "kubeconfig_command",
        ),
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    if not has_non_empty_strings(endpoints, ("mcp_url", "inference_base_url")):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    if any(
        key not in endpoints
        or (endpoints[key] is not None and not isinstance(endpoints[key], str))
        for key in (
            "admin_portal_url",
            "grafana_url",
            "alertmanager_url",
            "tempo_explore_url",
        )
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")

    shared_token = credentials.get("mcp_inference_token")
    if (
        not has_non_empty_strings(
            credentials,
            ("admin_bootstrap_token", "mcp_inference_token", "inference_access_token"),
        )
        or credentials.get("inference_access_token") != shared_token
        or "scientific_access_token" not in credentials
        or "scientific_access" not in bundle
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    grafana = credentials.get("grafana")
    if not isinstance(grafana, dict) or not has_non_empty_strings(
        grafana, ("username", "password")
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    scopes = mcp_access.get("scopes")
    if (
        not has_non_empty_strings(
            mcp_access, ("principal_id", "tenant_id")
        )
        or not isinstance(scopes, list)
        or not {"mcp.invoke", "inference.invoke"}.issubset(scopes)
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")

    academic_assets = contract.get("academic_assets")
    academic_fleet_enabled = (
        isinstance(academic_assets, dict)
        and academic_assets.get("enabled") is True
    )
    if academic_fleet_enabled:
        academic_tenant_id = academic_assets.get("tenant_id")
        scientific_token = credentials.get("scientific_access_token")
        scientific_scopes = (
            scientific_access.get("scopes")
            if isinstance(scientific_access, dict)
            else None
        )
        scientific_models = (
            scientific_access.get("models")
            if isinstance(scientific_access, dict)
            else None
        )
        scientific_max_concurrency = (
            scientific_access.get("max_concurrency")
            if isinstance(scientific_access, dict)
            else None
        )
        if (
            not isinstance(academic_tenant_id, str)
            or not academic_tenant_id.strip()
            or not isinstance(scientific_token, str)
            or not scientific_token.strip()
            or scientific_token == shared_token
            or not isinstance(scientific_access, dict)
            or not has_non_empty_strings(
                scientific_access, ("principal_id", "tenant_id")
            )
            or scientific_access.get("tenant_id") != academic_tenant_id
            or scientific_access.get("principal_id") == mcp_access.get("principal_id")
            or not isinstance(scientific_scopes, list)
            or not {
                "mcp.invoke",
                "inference.invoke",
                "use.nonclinical",
                "use.noncommercial",
            }.issubset(scientific_scopes)
            or not isinstance(scientific_models, list)
            or not scientific_models
            or not all(
                isinstance(model_id, str) and model_id.strip()
                for model_id in scientific_models
            )
            or not isinstance(scientific_max_concurrency, int)
            or isinstance(scientific_max_concurrency, bool)
            or not 1 <= scientific_max_concurrency <= 100
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
    elif (
        credentials.get("scientific_access_token") is not None
        or scientific_access is not None
    ):
        raise DeploymentError("the workloads access bundle is missing or malformed")
    if reference_data is not None:
        if not isinstance(reference_data, dict) or not has_non_empty_strings(
            reference_data,
            ("filesystem_id", "bucket_id", "bucket_name", "cpu_pool_id"),
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
        lifecycle = reference_data.get("lifecycle")
        if (
            not isinstance(lifecycle, dict)
            or lifecycle.get("retention_mode") not in {"retain", "disposable"}
            or (
                lifecycle.get("retention_mode") == "retain"
                and (
                    lifecycle.get("destroy_status")
                    != "blocked-retained"
                    or lifecycle.get("destroy_completion")
                    != "full-stack-destroy-incomplete-infrastructure-retained"
                    or lifecycle.get("adoption_status")
                    != "ids-exported-for-explicit-state-adoption"
                )
            )
            or (
                lifecycle.get("retention_mode") == "disposable"
                and (
                    lifecycle.get("destroy_status")
                    != "eligible-only-while-bucket-empty"
                    or lifecycle.get("destroy_completion")
                    != "full-only-when-versioned-bucket-empty"
                )
            )
            or not isinstance(reference_data.get("pipeline"), (dict, type(None)))
            or not isinstance(reference_data.get("status_service"), (str, type(None)))
            or not isinstance(reference_data_contract, dict)
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
        storage = reference_data_contract.get("storage")
        plane = reference_data_contract.get("plane")
        if (
            not isinstance(storage, dict)
            or not isinstance(plane, dict)
            or storage.get("filesystem", {}).get("id")
            != reference_data["filesystem_id"]
            or storage.get("object_storage", {}).get("id")
            != reference_data["bucket_id"]
            or storage.get("object_storage", {}).get("name")
            != reference_data["bucket_name"]
            or storage.get("cpu_pool", {}).get("id")
            != reference_data["cpu_pool_id"]
            or plane.get("status_service") != reference_data["status_service"]
            or plane.get("pipeline") != reference_data["pipeline"]
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
    elif reference_data_contract is not None:
        raise DeploymentError("the workloads access bundle is missing or malformed")

    scientific_artifacts = bundle.get("scientific_artifacts")
    if scientific_artifacts is not None:
        if not isinstance(scientific_artifacts, dict) or not has_non_empty_strings(
            scientific_artifacts,
            ("bucket_id", "bucket_name", "endpoint", "object_key", "writer_role"),
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
        lifecycle = scientific_artifacts.get("lifecycle")
        if (
            not isinstance(lifecycle, dict)
            or lifecycle.get("retention_mode") not in {"retain", "disposable"}
            or scientific_artifacts.get("writer_role") != "storage.object-editor"
            or scientific_artifacts.get("credential_secret")
            != "fs2-system/fs2-serve-artifact-store"
            or not isinstance(scientific_artifacts.get("credential_revision"), int)
            or scientific_artifacts["credential_revision"] < 1
            or not isinstance(scientific_artifacts.get("batch_enabled"), bool)
        ):
            raise DeploymentError("the workloads access bundle is missing or malformed")
        # The bundle is the operator's copy of every live credential, so an S3
        # secret leaking into it would be the worst possible regression.
        if any(
            key in scientific_artifacts
            for key in ("secret_access_key", "secret_key", "credentials")
        ):
            raise DeploymentError(
                "the scientific artifact bundle must never carry object-storage secret material"
            )
    return bundle


def state_ready(
    terraform: str,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
) -> bool:
    state, _, _ = stage_paths(run_root, stage)
    if not state.exists():
        return False
    if CAPSULE_ACCESS_MODE == "local-read-only":
        try:
            return retained_state_output(
                run_root, stage, STAGE_COMPLETION_OUTPUTS[stage]
            ) is not None
        except DeploymentError:
            return False
    environment = stage_environment(run_root, stage, contract, include_secrets=False)
    terraform_init(terraform, stage_root(stage), state, environment)
    result = subprocess.run(
        [
            terraform,
            f"-chdir={stage_root(stage)}",
            "output",
            "-json",
            STAGE_COMPLETION_OUTPUTS[stage],
        ],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
        **capsule_subprocess_options(environment=environment),
    )
    if result.returncode != 0:
        return False
    try:
        return json.loads(result.stdout) is not None
    except json.JSONDecodeError:
        return False


def state_has_resources(
    terraform: str,
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
) -> bool:
    state, _, _ = stage_paths(run_root, stage)
    if not state.exists():
        return False
    environment = stage_environment(run_root, stage, contract, include_secrets=False)
    terraform_init(terraform, stage_root(stage), state, environment)
    return bool(state_addresses(terraform, stage_root(stage), environment))


def apply_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
    configuration_environment: Mapping[str, str],
) -> None:
    require_public_edge_protected_start(contract)
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="infrastructure",
        contract=contract,
        variable_file=infrastructure_variables,
    )
    apply_plan(args.terraform, INFRA_ROOT, plan_path, environment)

    dynamic = infrastructure_outputs(
        args.terraform,
        run_root,
        contract,
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
    )
    mirror_selected_images(args, run_root, contract, dynamic)
    foundation_variables, workloads_variables = write_downstream_variables(
        run_root, contract, dynamic
    )

    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="foundation",
        contract=contract,
        variable_file=foundation_variables,
    )
    apply_plan(args.terraform, FOUNDATION_ROOT, plan_path, environment)

    plan_path, _, environment = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="workloads",
        contract=contract,
        variable_file=workloads_variables,
    )
    apply_plan(args.terraform, WORKLOADS_ROOT, plan_path, environment)

    # Record the accepted root contract after all of its staged consumers converge.
    apply_plan(
        args.terraform,
        DEPLOY_ROOT,
        run_root / "configuration.tfplan",
        configuration_environment,
    )

    endpoints = workload_endpoint_outputs(args.terraform, run_root, contract)
    print(json.dumps({"status": "applied", **endpoints}, indent=2))


def plan_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    infrastructure_variables = write_infrastructure_variables(
        run_root, contract, commit, args.nebius_profile
    )
    if not state_ready(args.terraform, run_root, "infrastructure", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="infrastructure",
            contract=contract,
            variable_file=infrastructure_variables,
        )
        print(
            "Planned infrastructure. Apply it before foundation can be planned against the new API server."
        )
        return

    _, infrastructure_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="infrastructure",
        contract=contract,
        variable_file=infrastructure_variables,
    )
    if plan_changes_managed_resources_or_outputs(infrastructure_plan):
        print(
            "Planned infrastructure changes. Apply infrastructure and rerun plan before planning foundation."
        )
        return

    dynamic = infrastructure_outputs(
        args.terraform,
        run_root,
        contract,
        nebius=args.nebius,
        nebius_profile=args.nebius_profile,
        kubectl=args.kubectl,
    )
    if "artifact_delivery" not in dynamic["accelerator_pool_contract"]:
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="infrastructure",
            contract=contract,
            variable_file=infrastructure_variables,
        )
        print(
            "Planned the registry-delivery contract upgrade. Apply infrastructure before planning downstream stages."
        )
        return
    foundation_variables, workloads_variables = write_downstream_variables(
        run_root, contract, dynamic
    )
    if not state_ready(args.terraform, run_root, "foundation", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="foundation",
            contract=contract,
            variable_file=foundation_variables,
        )
        print("Planned foundation. Apply it before custom resources can be planned.")
        return

    _, foundation_plan, _ = plan_stage(
        args.terraform,
        run_root=run_root,
        stage="foundation",
        contract=contract,
        variable_file=foundation_variables,
    )
    if plan_changes_managed_resources_or_outputs(foundation_plan):
        print(
            "Planned foundation changes. Apply foundation and rerun plan before planning workloads."
        )
        return

    if not state_ready(args.terraform, run_root, "workloads", contract):
        plan_stage(
            args.terraform,
            run_root=run_root,
            stage="workloads",
            contract=contract,
            variable_file=workloads_variables,
        )
        print("Planned workloads.")
        return

    plan_stage(
        args.terraform,
        run_root=run_root,
        stage="workloads",
        contract=contract,
        variable_file=workloads_variables,
    )
    print("Planned all three existing states after upstream handoffs converged.")


def destroy_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    commit: str,
) -> None:
    reference_infrastructure = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("reference_data", {})
    )
    scientific_infrastructure = (
        contract.get("stages", {})
        .get("infrastructure", {})
        .get("scientific_artifacts", {})
    )
    reference_retained = (
        isinstance(reference_infrastructure, Mapping)
        and reference_infrastructure.get("enabled") is True
        and reference_infrastructure.get("lifecycle", {}).get("retention_mode")
        == "retain"
    )
    scientific_retained = (
        isinstance(scientific_infrastructure, Mapping)
        and scientific_infrastructure.get("enabled") is True
        and scientific_infrastructure.get("lifecycle", {}).get("retention_mode")
        == "retain"
    )
    retained_mode = reference_retained or scientific_retained
    resources = {
        stage: state_has_resources(args.terraform, run_root, stage, contract)
        for stage in ("infrastructure", "foundation", "workloads")
    }
    retain_infrastructure = retained_mode and resources["infrastructure"]
    infrastructure_variables = (
        None
        if retain_infrastructure
        else write_infrastructure_variables(
            run_root, contract, commit, args.nebius_profile
        )
    )
    cached_foundation = run_root / "foundation.tfvars.json"
    cached_workloads = run_root / "workloads.tfvars.json"
    downstream: tuple[Path, Path] | None = None
    dynamic: dict[str, Any] | None = None
    if retain_infrastructure:
        if not state_ready(args.terraform, run_root, "infrastructure", contract):
            raise DeploymentError(
                "retained reference infrastructure exists but its completion output "
                "is unavailable; no resource was changed"
            )
        dynamic = infrastructure_outputs(
            args.terraform,
            run_root,
            contract,
            nebius=args.nebius,
            nebius_profile=args.nebius_profile,
            kubectl=args.kubectl,
        )
        if reference_retained and not isinstance(
            dynamic.get("reference_data_storage_contract"), Mapping
        ):
            raise DeploymentError(
                "retained reference infrastructure is missing its non-secret storage "
                "contract; no resource was changed"
            )
        if reference_retained and not isinstance(
            dynamic.get("reference_data_lifecycle"), Mapping
        ):
            raise DeploymentError(
                "retained reference infrastructure is missing its lifecycle output; "
                "no resource was changed"
            )
        if scientific_retained and not isinstance(
            dynamic.get("scientific_artifacts_storage_contract"), Mapping
        ):
            raise DeploymentError(
                "retained scientific artifact storage is missing its non-secret bucket "
                "contract; no resource was changed"
            )
        if scientific_retained and not isinstance(
            dynamic.get("scientific_artifacts_lifecycle"), Mapping
        ):
            raise DeploymentError(
                "retained scientific artifact storage is missing its lifecycle output; "
                "no resource was changed"
            )
    if resources["foundation"] or resources["workloads"]:
        if (
            cached_foundation.is_file()
            and not cached_foundation.is_symlink()
            and cached_workloads.is_file()
            and not cached_workloads.is_symlink()
        ):
            downstream = (cached_foundation, cached_workloads)
        elif state_ready(args.terraform, run_root, "infrastructure", contract):
            if dynamic is None:
                dynamic = infrastructure_outputs(
                    args.terraform,
                    run_root,
                    contract,
                    nebius=args.nebius,
                    nebius_profile=args.nebius_profile,
                    kubectl=args.kubectl,
                )
            downstream = write_downstream_variables(run_root, contract, dynamic)
        else:
            raise DeploymentError(
                "downstream resources exist but their private generated tfvars and a complete infrastructure handoff are both unavailable"
            )

    retained_workload_outputs: dict[str, Any] = {
        "reference_data": None,
        "reference_data_contract": None,
        "scientific_artifacts": None,
        "scientific_artifacts_contract": None,
    }
    if (
        retain_infrastructure
        and resources["workloads"]
        and state_ready(args.terraform, run_root, "workloads", contract)
    ):
        retained_workload_outputs = workload_endpoint_outputs(
            args.terraform, run_root, contract
        )

    destroy_order: tuple[tuple[str, Path | None], ...] = (
        ("workloads", downstream[1] if downstream else None),
        ("foundation", downstream[0] if downstream else None),
    )
    if not retain_infrastructure:
        destroy_order += (("infrastructure", infrastructure_variables),)

    destroyed_stages: list[str] = []
    for stage, variable_file in destroy_order:
        if not resources[stage]:
            continue
        if variable_file is None:
            raise DeploymentError(
                f"cannot destroy {stage}: its generated private variable file is unavailable"
            )
        plan_path, _, environment = plan_stage(
            args.terraform,
            run_root=run_root,
            stage=stage,
            contract=contract,
            variable_file=variable_file,
            destroy=True,
        )
        apply_plan(args.terraform, stage_root(stage), plan_path, environment)
        destroyed_stages.append(stage)

    if retain_infrastructure:
        assert dynamic is not None
        storage = dynamic.get("reference_data_storage_contract")
        lifecycle = dynamic.get("reference_data_lifecycle")
        applied_status = retained_workload_outputs.get("reference_data")
        applied_contract = retained_workload_outputs.get("reference_data_contract")
        last_applied_status_service = (
            applied_status.get("status_service")
            if isinstance(applied_status, Mapping)
            else None
        )
        last_applied_pipeline = (
            applied_status.get("pipeline")
            if isinstance(applied_status, Mapping)
            else None
        )
        last_applied_plane = (
            applied_contract.get("plane")
            if isinstance(applied_contract, Mapping)
            else None
        )
        reference_data = None if not reference_retained else {
            "lifecycle": lifecycle,
            "filesystem_id": storage.get("filesystem", {}).get("id"),
            "bucket_id": storage.get("object_storage", {}).get("id"),
            "bucket_name": storage.get("object_storage", {}).get("name"),
            "cpu_pool_id": storage.get("cpu_pool", {}).get("id"),
            "status_service": None,
            "pipeline": None,
            "last_applied": {
                "status_service": last_applied_status_service,
                "pipeline": last_applied_pipeline,
            },
        }
        reference_data_contract = None if not reference_retained else {
            "storage": storage,
            "plane": None,
            "last_applied_plane": last_applied_plane,
        }
        scientific_storage = dynamic.get("scientific_artifacts_storage_contract")
        scientific_lifecycle = dynamic.get("scientific_artifacts_lifecycle")
        scientific_artifacts = None if not scientific_retained else {
            "lifecycle": scientific_lifecycle,
            "bucket_id": (scientific_storage or {}).get("object_storage", {}).get("id"),
            "bucket_name": (scientific_storage or {})
            .get("object_storage", {})
            .get("name"),
            "object_key": (scientific_storage or {}).get("layout", {}).get("object_key"),
            "last_applied": retained_workload_outputs.get("scientific_artifacts"),
        }
        scientific_artifacts_contract = None if not scientific_retained else {
            "storage": scientific_storage,
        }
        adoption_lifecycle = lifecycle if reference_retained else scientific_lifecycle
        receipt_path = run_root / (
            "reference-data-retention.json"
            if reference_retained
            else "scientific-artifacts-retention.json"
        )
        result = {
            "schema": "fs2-serve.nebius.ai/destroy-result/v1",
            "status": "infrastructure-retained",
            "completion": "full-stack-destroy-incomplete-infrastructure-retained",
            "destroyed_stages": destroyed_stages,
            "retained_stages": ["infrastructure"],
            "reference_data": reference_data,
            "reference_data_contract": reference_data_contract,
            "scientific_artifacts": scientific_artifacts,
            "scientific_artifacts_contract": scientific_artifacts_contract,
            "adoption": {
                "required_before_full_destroy": True,
                "status": (adoption_lifecycle or {}).get("adoption_status"),
                "receipt_path": str(receipt_path),
                "next_step": (
                    "adopt or migrate every retained filesystem and bucket into a "
                    "separate durable Terraform state before destroying infrastructure"
                ),
            },
        }
        private_json(receipt_path, result)
        print(json.dumps(result, indent=2))
        return

    print(
        json.dumps(
            {
                "schema": "fs2-serve.nebius.ai/destroy-result/v1",
                "status": "destroyed",
                "completion": "complete",
                "destroyed_stages": destroyed_stages,
                "retained_stages": [],
                "reference_data": None,
                "reference_data_contract": None,
                "scientific_artifacts": None,
                "scientific_artifacts_contract": None,
                "evidence_root": str(run_root),
            },
            indent=2,
        )
    )


def retained_status_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    """Render status from stable retained JSON only; never start Terraform."""

    stages: dict[str, Any] = {}
    for stage in ("infrastructure", "foundation", "workloads"):
        state, _, _ = stage_paths(run_root, stage)
        if not state.exists():
            stages[stage] = {"state": "absent", "addresses": 0, "complete": False}
            continue
        addresses = retained_state_address_count(run_root, stage)
        complete = state_ready(args.terraform, run_root, stage, contract)
        stages[stage] = {
            "state": "ready" if complete else ("partial" if addresses else "empty"),
            "addresses": addresses,
            "complete": complete,
        }
    workloads_ready = stages["workloads"]["complete"]
    endpoints = (
        workload_endpoint_outputs(args.terraform, run_root, contract)
        if workloads_ready
        else {
            "mcp_endpoint_url": None,
            "admin_web_interface_url": None,
            "inference_base_url": None,
            "grafana_url": None,
            "alertmanager_url": None,
            "tempo_explore_url": None,
            "reference_data": None,
            "reference_data_contract": None,
            "scientific_artifacts": None,
            "scientific_artifacts_contract": None,
        }
    )
    if stages["infrastructure"]["complete"]:
        storage = retained_state_output(
            run_root,
            "infrastructure",
            "reference_data_storage_contract",
            optional=True,
        )
        if endpoints["reference_data"] is None and isinstance(storage, Mapping):
            lifecycle = retained_state_output(
                run_root, "infrastructure", "reference_data_lifecycle", optional=True
            )
            endpoints["reference_data"] = {
                "lifecycle": lifecycle if isinstance(lifecycle, Mapping) else storage.get("lifecycle"),
                "filesystem_id": storage.get("filesystem", {}).get("id"),
                "bucket_id": storage.get("object_storage", {}).get("id"),
                "bucket_name": storage.get("object_storage", {}).get("name"),
                "cpu_pool_id": storage.get("cpu_pool", {}).get("id"),
                "status_service": None,
                "pipeline": None,
            }
            endpoints["reference_data_contract"] = {"storage": storage, "plane": None}
        scientific = retained_state_output(
            run_root,
            "infrastructure",
            "scientific_artifacts_storage_contract",
            optional=True,
        )
        if endpoints["scientific_artifacts"] is None and isinstance(scientific, Mapping):
            lifecycle = retained_state_output(
                run_root, "infrastructure", "scientific_artifacts_lifecycle", optional=True
            )
            endpoints["scientific_artifacts"] = {
                "lifecycle": lifecycle if isinstance(lifecycle, Mapping) else scientific.get("lifecycle"),
                "bucket_id": scientific.get("object_storage", {}).get("id"),
                "bucket_name": scientific.get("object_storage", {}).get("name"),
                "endpoint": scientific.get("object_storage", {}).get("endpoint"),
                "region": scientific.get("region"),
                "object_key": scientific.get("layout", {}).get("object_key"),
                "writer_role": scientific.get("writer", {}).get("role"),
                "writer_paths": scientific.get("writer", {}).get("paths"),
                "secret_delivery": scientific.get("writer", {}).get("secret_delivery"),
                "retention": scientific.get("retention"),
                "credential_secret": "fs2-system/fs2-serve-artifact-store",
            }
    print(json.dumps({"run_root": str(run_root), "stages": stages, **endpoints}, indent=2))


def status_stack(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    if CAPSULE_ACCESS_MODE == "local-read-only":
        retained_status_stack(args, run_root, contract)
        return
    stages: dict[str, Any] = {}
    workloads_ready = False
    infrastructure_reference_data: Any | None = None
    infrastructure_reference_data_contract: Any | None = None
    infrastructure_scientific_artifacts: Any | None = None
    for stage in ("infrastructure", "foundation", "workloads"):
        state, _, _ = stage_paths(run_root, stage)
        if not state.exists():
            stages[stage] = {"state": "absent", "addresses": 0, "complete": False}
            continue
        environment = stage_environment(
            run_root, stage, contract, include_secrets=False
        )
        terraform_init(args.terraform, stage_root(stage), state, environment)
        addresses = state_addresses(args.terraform, stage_root(stage), environment)
        complete = state_ready(args.terraform, run_root, stage, contract)
        stages[stage] = {
            "state": "ready" if complete else ("partial" if addresses else "empty"),
            "addresses": len(addresses),
            "complete": complete,
        }
        if stage == "workloads":
            workloads_ready = complete
        if (
            stage == "infrastructure"
            and complete
            and contract.get("stages", {})
            .get("infrastructure", {})
            .get("reference_data", {})
            .get("enabled")
            is True
        ):
            storage = terraform_optional_json_output(
                args.terraform,
                INFRA_ROOT,
                "reference_data_storage_contract",
                environment,
            )
            if isinstance(storage, Mapping):
                lifecycle = terraform_optional_json_output(
                    args.terraform,
                    INFRA_ROOT,
                    "reference_data_lifecycle",
                    environment,
                )
                infrastructure_reference_data = {
                    "lifecycle": (
                        lifecycle
                        if isinstance(lifecycle, Mapping)
                        else storage.get("lifecycle")
                    ),
                    "filesystem_id": storage.get("filesystem", {}).get("id"),
                    "bucket_id": storage.get("object_storage", {}).get("id"),
                    "bucket_name": storage.get("object_storage", {}).get("name"),
                    "cpu_pool_id": storage.get("cpu_pool", {}).get("id"),
                    "status_service": None,
                    "pipeline": None,
                }
                infrastructure_reference_data_contract = {
                    "storage": storage,
                    "plane": None,
                }
        if (
            stage == "infrastructure"
            and complete
            and contract.get("stages", {})
            .get("infrastructure", {})
            .get("scientific_artifacts", {})
            .get("enabled")
            is True
        ):
            artifact_storage = terraform_optional_json_output(
                args.terraform,
                INFRA_ROOT,
                "scientific_artifacts_storage_contract",
                environment,
            )
            if isinstance(artifact_storage, Mapping):
                artifact_lifecycle = terraform_optional_json_output(
                    args.terraform,
                    INFRA_ROOT,
                    "scientific_artifacts_lifecycle",
                    environment,
                )
                infrastructure_scientific_artifacts = {
                    "lifecycle": (
                        artifact_lifecycle
                        if isinstance(artifact_lifecycle, Mapping)
                        else artifact_storage.get("lifecycle")
                    ),
                    "bucket_id": artifact_storage.get("object_storage", {}).get("id"),
                    "bucket_name": artifact_storage.get("object_storage", {}).get(
                        "name"
                    ),
                    "endpoint": artifact_storage.get("object_storage", {}).get(
                        "endpoint"
                    ),
                    "region": artifact_storage.get("region"),
                    "object_key": artifact_storage.get("layout", {}).get("object_key"),
                    "writer_role": artifact_storage.get("writer", {}).get("role"),
                    "writer_paths": artifact_storage.get("writer", {}).get("paths"),
                    "secret_delivery": artifact_storage.get("writer", {}).get(
                        "secret_delivery"
                    ),
                    "retention": artifact_storage.get("retention"),
                    "credential_secret": "fs2-system/fs2-serve-artifact-store",
                }
    endpoints = (
        workload_endpoint_outputs(args.terraform, run_root, contract)
        if workloads_ready
        else {
            "mcp_endpoint_url": None,
            "admin_web_interface_url": None,
            "inference_base_url": None,
            "grafana_url": None,
            "alertmanager_url": None,
            "tempo_explore_url": None,
            "reference_data": None,
            "reference_data_contract": None,
            "scientific_artifacts": None,
            "scientific_artifacts_contract": None,
        }
    )
    # A previously applied workloads state can remain otherwise complete while the
    # newly enabled reference-data module is intentionally held behind its own
    # review gate. Keep the normal status surface truthful in that transition:
    # report the live infrastructure identities and retained lifecycle until the
    # workload-owned status service and pipeline replace this fallback.
    if (
        endpoints["reference_data"] is None
        and infrastructure_reference_data is not None
    ):
        endpoints["reference_data"] = infrastructure_reference_data
    if (
        endpoints["reference_data_contract"] is None
        and infrastructure_reference_data_contract is not None
    ):
        endpoints["reference_data_contract"] = (
            infrastructure_reference_data_contract
        )
    # The store can be provisioned and correct while the batch workloads that
    # consume it are still gated off. Report the live bucket identity rather
    # than pretending the feature is absent.
    if (
        endpoints.get("scientific_artifacts") is None
        and infrastructure_scientific_artifacts is not None
    ):
        endpoints["scientific_artifacts"] = infrastructure_scientific_artifacts
    print(
        json.dumps(
            {"run_root": str(run_root), "stages": stages, **endpoints},
            indent=2,
        )
    )


