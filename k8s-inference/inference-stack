# Write-only Secret arguments (`data_wo`) are a Terraform 1.11 feature. On an
# older binary they are silently unknown attributes, which would put credential
# material back into state, so the whole flow refuses to run below 1.11.
MINIMUM_TERRAFORM_VERSION = (1, 11, 0)
PAT_TOKEN_PATTERN = re.compile(r"^fs2_pat_([0-9a-f]{32})_[A-Za-z0-9_-]{32,}$")


def require_terraform_version(terraform: str) -> tuple[int, int, int]:
    """Fail closed unless the binary supports write-only resource arguments."""

    result = subprocess.run(
        [terraform, "version", "-json"],
        capture_output=True,
        text=True,
        env=clean_environment(),
    )
    if result.returncode != 0:
        raise DeploymentError(
            f"cannot determine the Terraform version using {terraform!r}"
        )
    try:
        raw = json.loads(result.stdout)["terraform_version"]
        version = tuple(int(part) for part in raw.split("-")[0].split(".")[:3])
    except (KeyError, ValueError, json.JSONDecodeError) as error:
        raise DeploymentError("Terraform reported an unreadable version") from error
    if len(version) != 3 or version < MINIMUM_TERRAFORM_VERSION:
        wanted = ".".join(str(part) for part in MINIMUM_TERRAFORM_VERSION)
        raise DeploymentError(
            f"Terraform {raw} is too old; write-only Secret data requires {wanted} or newer"
        )
    return version  # type: ignore[return-value]


def terraform_environment(run_root: Path, stage: str) -> dict[str, str]:
    environment = clean_environment()
    # Do not let an SDK rediscover ~/.aws/credentials through the inherited
    # user database/home chain. The explicit empty sentinel below disables the
    # shared-credentials branch while the attested config selects the one
    # purpose-bound workload-identity exchange.
    environment.pop("HOME", None)
    environment.pop("USERPROFILE", None)
    environment.pop("XDG_CONFIG_HOME", None)
    environment.pop("BOTO_CONFIG", None)
    data_directory = run_root / "terraform-data" / stage
    private_directory(data_directory)
    environment["TF_DATA_DIR"] = str(data_directory)
    environment["TF_IN_AUTOMATION"] = "1"
    if ACTIVE_BACKEND_IDENTITY is None:
        raise DeploymentError("Terraform requires a purpose-bound backend identity")
    environment["AWS_CONFIG_FILE"] = ACTIVE_BACKEND_IDENTITY["config_path"]
    environment["AWS_PROFILE"] = ACTIVE_BACKEND_IDENTITY["profile"]
    environment["AWS_SHARED_CREDENTIALS_FILE"] = ACTIVE_BACKEND_IDENTITY[
        "shared_credentials_file_path"
    ]
    environment["AWS_SDK_LOAD_CONFIG"] = "1"
    environment["AWS_EC2_METADATA_DISABLED"] = "true"
    if ACTIVE_RELEASE_IDENTITY is not None:
        environment["NEBIUS_CONFIG"] = ACTIVE_RELEASE_IDENTITY["config_path"]
        environment["NEBIUS_PROFILE"] = ACTIVE_RELEASE_IDENTITY["profile"]
    return environment


def validate_versioned_access_pat_ids(
    bootstrap_tokens_json: str | None,
    scientific_tokens_json: str | None,
    website_tokens_json: str | None,
) -> None:
    """Reject PAT identity reuse before any Terraform plan can consume it."""

    identifiers: list[str] = []
    for audience, encoded in (
        ("general", bootstrap_tokens_json),
        ("scientific", scientific_tokens_json),
        ("website", website_tokens_json),
    ):
        if not encoded:
            continue
        try:
            tokens = json.loads(encoded)
        except json.JSONDecodeError as error:
            raise DeploymentError(
                f"{audience} access token map is not valid JSON"
            ) from error
        if not isinstance(tokens, dict):
            raise DeploymentError(f"{audience} access token map must be a JSON object")
        for generation, token in tokens.items():
            if (
                not isinstance(generation, str)
                or not generation.isdecimal()
                or int(generation) <= 1
            ):
                raise DeploymentError(
                    f"{audience} access token map keys must be generations greater than 1"
                )
            match = (
                PAT_TOKEN_PATTERN.fullmatch(token) if isinstance(token, str) else None
            )
            if match is None:
                raise DeploymentError(
                    f"{audience} access generation {generation} is not a valid PAT"
                )
            identifiers.append(match.group(1))
    if len(identifiers) != len(set(identifiers)):
        raise DeploymentError(
            "PAT IDs must be unique across every generation and audience"
        )


def terraform_init(
    terraform: str,
    root: Path,
    environment: Mapping[str, str],
) -> None:
    """Initialize only a provider-attested encrypted remote backend."""
    root_name = TERRAFORM_ROOT_NAMES.get(root.resolve())
    if root_name is None:
        raise DeploymentError(f"Terraform root is not registered for remote state: {root}")
    backend_config = TERRAFORM_BACKEND_CONFIG_ROOT / f"{root_name}.s3.hcl"
    chain = [backend_config.parent, *backend_config.parent.parents]
    if (
        not backend_config.is_file()
        or backend_config.is_symlink()
        or backend_config.stat().st_uid != 0
        or ACTIVE_BACKEND_IDENTITY is None
        or os.geteuid() != ACTIVE_BACKEND_IDENTITY.get("reader_uid")
        or os.getegid() != ACTIVE_BACKEND_IDENTITY.get("reader_gid")
        or stat.S_IMODE(backend_config.stat().st_mode) != 0o644
        or any(
            path.is_symlink()
            or not path.is_dir()
            or path.stat().st_uid != 0
            or stat.S_IMODE(path.stat().st_mode) & 0o022
            for path in chain
        )
    ):
        raise DeploymentError(
            "root-owned non-secret mode-0644 remote backend configuration and a purpose-bound backend session are required at "
            f"{backend_config}; local state fallback is forbidden"
        )
    source = backend_config.read_text(encoding="utf-8")
    if (
        re.search(r"(?m)^\s*encrypt\s*=\s*true\s*$", source) is None
        or re.search(r'(?m)^\s*bucket\s*=\s*"[^"\n]+"\s*$', source) is None
        or re.search(r'(?m)^\s*key\s*=\s*"[^"\n]+"\s*$', source) is None
        or re.search(r"(?m)^\s*use_lockfile\s*=\s*true\s*$", source) is None
    ):
        raise DeploymentError(
            "remote backend must declare encryption, locking, bucket and object key"
        )
    migration = authority_observation(
        "state-migration-readiness", terraform_root_name=root_name
    )
    if (
        migration.get("terraform_root_name") != root_name
        or migration.get("authorizedCallerPurpose")
        != ACTIVE_BACKEND_IDENTITY.get("purpose")
        or migration.get("status") != "copy-verified-source-retained"
        or migration.get("destination_object_present") is not True
        or not isinstance(migration.get("destination_object_version_id"), str)
        or not migration["destination_object_version_id"]
        or migration.get("source_retained") is not True
        or migration.get("overwrite_performed") is not False
        or migration.get("backend_access_identity", {}).get("purpose")
        != ACTIVE_BACKEND_IDENTITY.get("purpose")
        or migration.get("backend_access_identity", {}).get(
            "binding_sha256"
        )
        != ACTIVE_BACKEND_IDENTITY.get("binding_sha256")
        or migration.get("destination_canonical_state_sha256")
        != migration.get("source_canonical_state_sha256")
        or not isinstance(migration.get("source_lineage"), str)
        or not migration["source_lineage"]
        or not isinstance(migration.get("source_serial"), int)
        or migration["source_serial"] < 1
    ):
        raise DeploymentError(
            "remote backend initialization is blocked until an externally anchored exact-copy observation preserves the legacy source"
        )
    custody = run(
        [sys.executable, str(CREDENTIAL_PROVIDER_ADAPTER)],
        env=clean_environment(),
        capture=True,
        input_text=json.dumps(
            {
                "operation": "backend-custody",
                "terraform_root_name": root_name,
            },
            separators=(",", ":"),
        ),
    )
    try:
        observation = json.loads(custody.stdout)
    except json.JSONDecodeError as error:
        raise DeploymentError("backend custody evidence is invalid JSON") from error
    if (
        observation.get("terraform_root_name") != root_name
        or observation.get("authorizedCallerPurpose")
        != ACTIVE_BACKEND_IDENTITY.get("purpose")
        or observation.get("backend_type") != "s3"
        or observation.get("backend_config_sha256")
        != hashlib.sha256(backend_config.read_bytes()).hexdigest()
        or observation.get("encryption", {}).get("enabled") is not True
        or not observation.get("encryption", {}).get("kms_key_id")
        or observation.get("access_logging", {}).get("enabled") is not True
        or not observation.get("access_logging", {}).get("destination_bucket_id")
        or observation.get("backend_access_identity", {}).get("purpose")
        != ACTIVE_BACKEND_IDENTITY.get("purpose")
        or observation.get("backend_access_identity", {}).get(
            "binding_sha256"
        )
        != ACTIVE_BACKEND_IDENTITY.get("binding_sha256")
        or observation.get("versioning_enabled") is not True
        or not str(observation.get("endpoint", "")).startswith("https://")
    ):
        raise DeploymentError(
            "provider-attested backend encryption, logging, versioning or endpoint is incomplete"
        )
    run(
        [
            terraform,
            f"-chdir={root}",
            "init",
            "-input=false",
            "-reconfigure",
            f"-backend-config={backend_config}",
        ],
        env=environment,
    )


