    def audited_collection(resource: str, *, all_namespaces: bool) -> dict[str, Any]:
        command = [
            "--kubeconfig",
            str(auditor),
            "--context",
            context,
            "get",
            resource,
        ]
        if all_namespaces:
            command.append("--all-namespaces")
        command.extend(["--output", "json"])
        result = _pinned_kubectl_command(
            kubectl=kubectl,
            tool=kubectl_tool,
            expected_kubeconfig_sha256=auditor_kubeconfig_sha256,
            arguments=command,
        )
        if result.returncode != 0:
            raise DeploymentError(f"cannot capture exhaustive {resource} custody census")
        try:
            document = json.loads(result.stdout)
            resource_version = document["metadata"]["resourceVersion"]
            items = document["items"]
        except (KeyError, TypeError, json.JSONDecodeError) as exc:
            raise DeploymentError(f"the {resource} custody census is malformed") from exc
        if not isinstance(resource_version, str) or not resource_version or not isinstance(items, list):
            raise DeploymentError(f"the {resource} custody census has no exact API identity")
        semantic_items = sorted(
            (_semantic_kubernetes_object(item) for item in items if isinstance(item, dict)),
            key=lambda item: (
                item.get("metadata", {}).get("namespace", ""),
                item.get("metadata", {}).get("name", ""),
            ),
        )
        if len(semantic_items) != len(items):
            raise DeploymentError(f"the {resource} custody census contains a non-object")
        return {
            "resource_version": resource_version,
            "items_sha256": hashlib.sha256(
                json.dumps(semantic_items, sort_keys=True, separators=(",", ":")).encode()
            ).hexdigest(),
            "items": items,
        }

