class DeploymentError(RuntimeError):
    """A bounded, user-actionable deployment failure."""


def _is_exact_host_route(value: object) -> bool:
    if not isinstance(value, str):
        return False
    try:
        network = ipaddress.ip_network(value, strict=True)
    except ValueError:
        return False
    return network.prefixlen == network.max_prefixlen


def _is_exact_non_loopback_address(value: object) -> bool:
    if not isinstance(value, str):
        return False
    try:
        address = ipaddress.ip_address(value)
    except ValueError:
        return False
    return not (address.is_loopback or address.is_unspecified or address.is_multicast)


def command_text(arguments: Sequence[str]) -> str:
    """Return a readable command containing no secret environment values."""
    return " ".join(arguments)


def run(
    arguments: Sequence[str],
    *,
    env: Mapping[str, str] | None = None,
    capture: bool = False,
    input_text: str | None = None,
) -> subprocess.CompletedProcess[str]:
    print(f"+ {command_text(arguments)}", file=sys.stderr)
    try:
        return subprocess.run(
            list(arguments),
            env=dict(env) if env is not None else None,
            input=input_text,
            text=True,
            check=True,
            stdout=subprocess.PIPE if capture else sys.stderr,
            stderr=subprocess.PIPE if capture else None,
        )
    except FileNotFoundError as exc:
        raise DeploymentError(f"required executable not found: {arguments[0]}") from exc
    except subprocess.CalledProcessError as exc:
        if capture and exc.stderr:
            print(exc.stderr.rstrip(), file=sys.stderr)
        raise DeploymentError(
            f"command failed with exit code {exc.returncode}: {command_text(arguments)}"
        ) from exc


def private_directory(path: Path) -> None:
    if path.exists() and (path.is_symlink() or not path.is_dir()):
        raise DeploymentError(f"run root must be a real directory: {path}")
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)


def private_json(path: Path, value: Any) -> None:
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    descriptor = os.open(temporary, flags, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def private_text(path: Path, value: str) -> None:
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(value)
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def clean_environment() -> dict[str, str]:
    # Stage inputs are generated explicitly. Inherited TF_VAR values could
    # otherwise make the same customer file produce a different deployment.
    return {
        key: value
        for key, value in os.environ.items()
        if not key.startswith("TF_VAR_")
        and not key.startswith("TF_CLI_ARGS")
        and key not in {"TF_DATA_DIR", "TF_WORKSPACE"}
    }


_PINNED_SIGNATURE_VERIFIER = Path("/opt/fs2/bin/fs2-custody-verifier")
_MAX_CUSTODY_DOCUMENT_BYTES = 16 * 1024 * 1024
_MAX_CUSTODY_SIGNATURE_BYTES = 64 * 1024
_MAX_CUSTODY_EXECUTABLE_BYTES = 128 * 1024 * 1024


def _custody_environment(*, python: bool = False) -> dict[str, str]:
    """Construct the complete environment for a custody subprocess.

    Nothing is inherited from the invoking process.  In particular, loader,
    Python import, proxy, credential, PATH and caller-selected tool variables
    cannot cross the custody boundary.
    """

    environment = {
        "HOME": "/nonexistent",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "TZ": "UTC",
    }
    if python:
        environment.update(
            {
                "PYTHONDONTWRITEBYTECODE": "1",
                "PYTHONNOUSERSITE": "1",
                "PYTHONSAFEPATH": "1",
            }
        )
    return environment


def _stable_root_file_bytes(
    path: Path,
    *,
    label: str,
    maximum_bytes: int,
    private: bool = False,
) -> tuple[bytes, str]:
    """Read one immutable root-custodied regular file without path reopens.

    Every component is traversed relative to a held directory descriptor with
    ``O_NOFOLLOW``.  The final descriptor is read once, checked for stability,
    and then compared with the still-held directory entry.  Callers consume
    only the returned bytes; verification and parsing never reopen ``path``.
    """

    if not path.is_absolute() or not path.parts[1:]:
        raise DeploymentError(f"{label} must be an absolute file path")
    components = path.parts[1:]
    if any(component in {"", ".", ".."} for component in components):
        raise DeploymentError(f"{label} contains an unsafe path component")
    directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
    file_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    directory_fd = os.open("/", directory_flags)
    try:
        directory_stat = os.fstat(directory_fd)
        if directory_stat.st_uid != 0 or directory_stat.st_mode & 0o022:
            raise DeploymentError(f"{label} root directory is not root-custodied")
        for component in components[:-1]:
            next_fd = os.open(component, directory_flags, dir_fd=directory_fd)
            directory_stat = os.fstat(next_fd)
            if (
                not stat.S_ISDIR(directory_stat.st_mode)
                or directory_stat.st_uid != 0
                or directory_stat.st_mode & 0o022
            ):
                os.close(next_fd)
                raise DeploymentError(
                    f"{label} parent directories must be root-owned and non-writable"
                )
            os.close(directory_fd)
            directory_fd = next_fd
        descriptor = os.open(components[-1], file_flags, dir_fd=directory_fd)
        try:
            before = os.fstat(descriptor)
            if (
                not stat.S_ISREG(before.st_mode)
                or before.st_uid != 0
                or before.st_mode & 0o022
                or (private and before.st_mode & 0o077)
                or before.st_nlink != 1
                or before.st_size < 1
                or before.st_size > maximum_bytes
            ):
                raise DeploymentError(
                    f"{label} must be a stable root-owned, non-writable regular file"
                )
            chunks: list[bytes] = []
            remaining = maximum_bytes + 1
            while remaining:
                chunk = os.read(descriptor, min(1024 * 1024, remaining))
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
            value = b"".join(chunks)
            after = os.fstat(descriptor)
            named = os.stat(
                components[-1], dir_fd=directory_fd, follow_symlinks=False
            )
            stable_fields = (
                "st_dev",
                "st_ino",
                "st_mode",
                "st_uid",
                "st_gid",
                "st_nlink",
                "st_size",
                "st_mtime_ns",
                "st_ctime_ns",
            )
            if (
                len(value) != before.st_size
                or len(value) > maximum_bytes
                or any(
                    getattr(before, field) != getattr(after, field)
                    or getattr(before, field) != getattr(named, field)
                    for field in stable_fields
                )
            ):
                raise DeploymentError(f"{label} changed during its single read")
        finally:
            os.close(descriptor)
    except OSError as exc:
        raise DeploymentError(f"cannot securely read {label}") from exc
    finally:
        os.close(directory_fd)
    return value, hashlib.sha256(value).hexdigest()


def _root_custody_directory(path: Path, *, label: str, private: bool = False) -> str:
    """Resolve only a root-owned, non-writable directory chain by descriptors."""

    if not path.is_absolute() or not path.parts[1:]:
        raise DeploymentError(f"{label} must be an absolute directory path")
    components = path.parts[1:]
    if any(component in {"", ".", ".."} for component in components):
        raise DeploymentError(f"{label} contains an unsafe path component")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
    descriptor = os.open("/", flags)
    try:
        for component in components:
            next_descriptor = os.open(component, flags, dir_fd=descriptor)
            metadata = os.fstat(next_descriptor)
            if (
                not stat.S_ISDIR(metadata.st_mode)
                or metadata.st_uid != 0
                or metadata.st_mode & 0o022
                or (private and metadata.st_mode & 0o077)
            ):
                os.close(next_descriptor)
                raise DeploymentError(
                    f"{label} must be root-owned and non-writable"
                )
            os.close(descriptor)
            descriptor = next_descriptor
    except OSError as exc:
        raise DeploymentError(f"cannot securely open {label}") from exc
    finally:
        os.close(descriptor)
    return str(path)


@contextmanager
def _sealed_memfd(
    label: str, value: bytes, *, executable: bool = False
) -> Iterator[int]:
    """Expose exact captured bytes to a subprocess without a mutable path."""

    required_constants = (
        "F_ADD_SEALS",
        "F_GET_SEALS",
        "F_SEAL_GROW",
        "F_SEAL_SHRINK",
        "F_SEAL_WRITE",
        "F_SEAL_SEAL",
    )
    if not hasattr(os, "memfd_create") or any(
        not hasattr(fcntl, name) for name in required_constants
    ):
        raise DeploymentError("sealed in-memory custody files are unavailable")
    descriptor = os.memfd_create(
        re.sub(r"[^a-zA-Z0-9_.-]", "-", label)[:64],
        os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING,
    )
    try:
        offset = 0
        while offset < len(value):
            offset += os.write(descriptor, value[offset:])
        os.fchmod(descriptor, 0o500 if executable else 0o400)
        seals = (
            fcntl.F_SEAL_GROW
            | fcntl.F_SEAL_SHRINK
            | fcntl.F_SEAL_WRITE
            | fcntl.F_SEAL_SEAL
        )
        fcntl.fcntl(descriptor, fcntl.F_ADD_SEALS, seals)
        if fcntl.fcntl(descriptor, fcntl.F_GET_SEALS) != seals:
            raise DeploymentError(f"could not seal exact bytes for {label}")
        os.lseek(descriptor, 0, os.SEEK_SET)
        yield descriptor
    finally:
        os.close(descriptor)


def _pinned_signature_verifier(
    arguments: Sequence[str],
    *,
    expected_sha256: str,
    input_bytes: bytes | None = None,
    inherited_fds: Sequence[int] = (),
) -> subprocess.CompletedProcess[bytes]:
    executable, digest = _stable_root_file_bytes(
        _PINNED_SIGNATURE_VERIFIER,
        label="pinned static custody verifier",
        maximum_bytes=_MAX_CUSTODY_EXECUTABLE_BYTES,
    )
    _require_static_elf(executable, label="pinned static custody verifier")
    if (
        re.fullmatch(r"[a-f0-9]{64}", expected_sha256) is None
        or digest != expected_sha256
    ):
        raise DeploymentError(
            "the fixed static custody verifier differs from the root contract"
        )
    with _sealed_memfd(
        "fs2-custody-verifier", executable, executable=True
    ) as executable_fd:
        return subprocess.run(
            [f"/proc/self/fd/{executable_fd}", *arguments],
            env=_custody_environment(),
            input=input_bytes,
            capture_output=True,
            check=False,
            pass_fds=(executable_fd, *inherited_fds),
        )


def _pinned_custody_command(
    *,
    executable_path: Path,
    expected_sha256: str,
    label: str,
    arguments: Sequence[str],
    environment: Mapping[str, str] | None = None,
    input_bytes: bytes | None = None,
    timeout: int = 30,
    inherited_fds: Sequence[int] = (),
) -> subprocess.CompletedProcess[bytes]:
    """Run a signed executable copy; never execute the caller-supplied path."""

    executable, actual_sha256 = _stable_root_file_bytes(
        executable_path,
        label=label,
        maximum_bytes=_MAX_CUSTODY_EXECUTABLE_BYTES,
    )
    if (
        re.fullmatch(r"[a-f0-9]{64}", expected_sha256) is None
        or actual_sha256 != expected_sha256
    ):
        raise DeploymentError(f"{label} differs from signed custody")
    exact_environment = _custody_environment()
    if environment is not None:
        forbidden = {
            "PATH",
            "PYTHONPATH",
            "PYTHONHOME",
            "LD_PRELOAD",
            "LD_LIBRARY_PATH",
            "FS2_OPENSSL",
        }
        if forbidden.intersection(environment):
            raise DeploymentError(f"{label} environment contains an unsafe override")
        exact_environment.update(environment)
    with _sealed_memfd(label, executable, executable=True) as executable_fd:
        return subprocess.run(
            [f"/proc/self/fd/{executable_fd}", *arguments],
            env=exact_environment,
            input=input_bytes,
            capture_output=True,
            check=False,
            timeout=timeout,
            pass_fds=(executable_fd, *inherited_fds),
        )


def _require_static_elf(value: bytes, *, label: str) -> None:
    """Reject scripts and ELF binaries that depend on an ambient loader.

    A custody verifier/exporter is a trust-boundary executable. Its exact
    signed bytes are copied to a sealed memfd, but that is insufficient if a
    shebang, PT_INTERP, or caller-controlled Python import graph can select more
    executable code.  Only a native ELF artifact without PT_INTERP is admitted.
    """

    if len(value) < 64 or value[:4] != b"\x7fELF":
        raise DeploymentError(f"{label} must be a native static ELF artifact")
    elf_class = value[4]
    elf_data = value[5]
    if elf_class not in {1, 2} or elf_data not in {1, 2}:
        raise DeploymentError(f"{label} has an unsupported ELF encoding")
    byte_order = "<" if elf_data == 1 else ">"
    try:
        if elf_class == 2:
            program_offset = struct.unpack_from(f"{byte_order}Q", value, 32)[0]
            program_entry_size = struct.unpack_from(f"{byte_order}H", value, 54)[0]
            program_count = struct.unpack_from(f"{byte_order}H", value, 56)[0]
            minimum_entry_size = 56
        else:
            program_offset = struct.unpack_from(f"{byte_order}I", value, 28)[0]
            program_entry_size = struct.unpack_from(f"{byte_order}H", value, 42)[0]
            program_count = struct.unpack_from(f"{byte_order}H", value, 44)[0]
            minimum_entry_size = 32
    except struct.error as exc:
        raise DeploymentError(f"{label} has a truncated ELF header") from exc
    table_end = program_offset + program_entry_size * program_count
    if (
        program_count < 1
        or program_entry_size < minimum_entry_size
        or program_offset < 1
        or table_end > len(value)
    ):
        raise DeploymentError(f"{label} has an invalid ELF program table")
    try:
        program_types = {
            struct.unpack_from(
                f"{byte_order}I", value, program_offset + index * program_entry_size
            )[0]
            for index in range(program_count)
        }
    except struct.error as exc:
        raise DeploymentError(f"{label} has a truncated ELF program table") from exc
    if 3 in program_types:  # PT_INTERP
        raise DeploymentError(
            f"{label} must not depend on a mutable dynamic loader or interpreter"
        )


def _verify_detached_signature(
    *,
    document: bytes,
    signature: bytes,
    trust_root: bytes,
    verifier_sha256: str,
    label: str,
) -> None:
    with ExitStack() as stack:
        document_fd = stack.enter_context(_sealed_memfd(f"{label}-document", document))
        signature_fd = stack.enter_context(
            _sealed_memfd(f"{label}-signature", signature)
        )
        trust_root_fd = stack.enter_context(
            _sealed_memfd(f"{label}-trust-root", trust_root)
        )
        verified = _pinned_signature_verifier(
            [
                "verify-sha256",
                "--public-key",
                f"/proc/self/fd/{trust_root_fd}",
                "--signature",
                f"/proc/self/fd/{signature_fd}",
                "--document",
                f"/proc/self/fd/{document_fd}",
            ],
            expected_sha256=verifier_sha256,
            inherited_fds=(document_fd, signature_fd, trust_root_fd),
        )
    if verified.returncode != 0 or verified.stdout.strip() != b"verified":
        raise DeploymentError(f"the {label} signature is invalid")


# Write-only Secret arguments (`data_wo`) are a Terraform 1.11 feature. On an
# older binary they are silently unknown attributes, which would put credential
# material back into state, so the whole flow refuses to run below 1.11.
MINIMUM_TERRAFORM_VERSION = (1, 11, 0)


def require_terraform_version(terraform: str) -> tuple[int, int, int]:
    """Fail closed unless the binary supports write-only resource arguments."""

    result = subprocess.run(
        [terraform, "version", "-json"],
        capture_output=True,
        text=True,
        env=clean_environment(),
    )
    if result.returncode != 0:
        raise DeploymentError(
            f"cannot determine the Terraform version using {terraform!r}"
        )
    try:
        raw = json.loads(result.stdout)["terraform_version"]
        version = tuple(int(part) for part in raw.split("-")[0].split(".")[:3])
    except (KeyError, ValueError, json.JSONDecodeError) as error:
        raise DeploymentError("Terraform reported an unreadable version") from error
    if len(version) != 3 or version < MINIMUM_TERRAFORM_VERSION:
        wanted = ".".join(str(part) for part in MINIMUM_TERRAFORM_VERSION)
        raise DeploymentError(
            f"Terraform {raw} is too old; write-only Secret data requires {wanted} or newer"
        )
    return version  # type: ignore[return-value]


def terraform_environment(run_root: Path, stage: str) -> dict[str, str]:
    environment = clean_environment()
    data_directory = run_root / "terraform-data" / stage
    private_directory(data_directory)
    environment["TF_DATA_DIR"] = str(data_directory)
    environment["TF_IN_AUTOMATION"] = "1"
    return environment


def terraform_init(
    terraform: str,
    root: Path,
    backend: Path,
    environment: Mapping[str, str],
) -> None:
    if backend.is_symlink():
        raise DeploymentError(
            f"Terraform backend path must not be a symlink: {backend}"
        )
    run(
        [
            terraform,
            f"-chdir={root}",
            "init",
            "-input=false",
            "-reconfigure",
            f"-backend-config=path={backend}",
        ],
        env=environment,
    )


def validate_stage_roots(terraform: str, run_root: Path) -> None:
    for stage in ("infrastructure", "foundation", "workloads"):
        environment = terraform_environment(run_root, f"validate-{stage}")
        root = stage_root(stage)
        run(
            [
                terraform,
                f"-chdir={root}",
                "init",
                "-backend=false",
                "-input=false",
            ],
            env=environment,
        )
        run(
            [terraform, f"-chdir={root}", "validate", "-no-color"],
            env=environment,
        )


def terraform_json_output(
    terraform: str,
    root: Path,
    name: str,
    environment: Mapping[str, str],
) -> Any:
    result = run(
        [terraform, f"-chdir={root}", "output", "-json", name],
        env=environment,
        capture=True,
    )
    return json.loads(result.stdout)


def terraform_optional_json_output(
    terraform: str,
    root: Path,
    name: str,
    environment: Mapping[str, str],
) -> Any | None:
    """Read an output that Terraform legitimately omits when its value is null."""
    result = run(
        [terraform, f"-chdir={root}", "output", "-json"],
        env=environment,
        capture=True,
    )
    outputs = json.loads(result.stdout)
    output = outputs.get(name)
    if output is None:
        return None
    if not isinstance(output, dict) or "value" not in output:
        raise DeploymentError(f"Terraform returned malformed output {name!r}")
    return output["value"]


def state_addresses(
    terraform: str,
    root: Path,
    environment: Mapping[str, str],
) -> list[str]:
    result = subprocess.run(
        [terraform, f"-chdir={root}", "state", "list"],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return []
    return [line for line in result.stdout.splitlines() if line.strip()]


def plan_json(
    terraform: str,
    *,
    root: Path,
    environment: Mapping[str, str],
    variable_file: Path,
    plan_path: Path,
    json_path: Path,
    destroy: bool = False,
) -> dict[str, Any]:
    if plan_path.is_symlink() or json_path.is_symlink():
        raise DeploymentError("plan and plan JSON paths must not be symlinks")
    arguments = [
        terraform,
        f"-chdir={root}",
        "plan",
        "-input=false",
        "-lock=true",
        f"-var-file={variable_file}",
        f"-out={plan_path}",
    ]
    if destroy:
        arguments.insert(3, "-destroy")
    run(arguments, env=environment)
    plan_path.chmod(0o600)
    result = run(
        [terraform, f"-chdir={root}", "show", "-json", str(plan_path)],
        env=environment,
        capture=True,
    )
    private_text(json_path, result.stdout)
    return json.loads(result.stdout)


def planned_output(document: Mapping[str, Any], name: str) -> Any:
    try:
        return document["planned_values"]["outputs"][name]["value"]
    except (KeyError, TypeError) as exc:
        raise DeploymentError(
            f"configuration plan did not produce output {name!r}"
        ) from exc


def plan_changes_managed_resources_or_outputs(document: Mapping[str, Any]) -> bool:
    """Return whether a stage handoff must converge before its consumer plans."""
    unchanged_actions = (["no-op"], ["read"])
    for resource in document.get("resource_changes", []):
        if resource.get("mode", "managed") != "managed":
            continue
        actions = resource.get("change", {}).get("actions", [])
        if actions not in unchanged_actions:
            return True
    for output in document.get("output_changes", {}).values():
        actions = output.get("actions", [])
        if actions not in unchanged_actions:
            return True
    return False


def validate_model_network_policy_rollback_plan(
    document: Mapping[str, Any], contract: Mapping[str, Any]
) -> None:
    """Keep deny removal isolated from Helm or any other workload mutation.

    Terraform dependency ordering cannot make two unrelated changes in one plan
    safe. During the rollback-remove-deny phase, the supported wrapper therefore
    accepts only deletion of the namespace deny and its one-shot apply-fence
    receipt plus the transition receipt's state update. The exact saved plan is
    applied only after this check.
    """
    transition = (
        contract.get("stages", {})
        .get("workloads", {})
        .get("model_runtime_network_policy", {})
    )
    if (
        not isinstance(transition, Mapping)
        or transition.get("phase") != "rollback-remove-deny"
    ):
        return

    def without_holder(value: Any) -> Any:
        if isinstance(value, Mapping):
            cleaned = {key: without_holder(item) for key, item in value.items()}
            annotations = cleaned.get("annotations")
            if isinstance(annotations, dict):
                annotations.pop("fs2-serve.nebius.ai/network-transition-holder", None)
            return cleaned
        if isinstance(value, list):
            return [without_holder(item) for item in value]
        return value

    holder_refresh_addresses = {
        "kubernetes_manifest.model_runtime_network_boundary_marker_admission",
        "kubernetes_manifest.model_runtime_network_boundary_marker_admission_binding[0]",
        "kubernetes_manifest.model_runtime_network_controller_freeze_admission",
        "kubernetes_manifest.model_runtime_network_controller_freeze_admission_binding[0]",
        "kubernetes_manifest.model_runtime_network_helm_freeze_admission",
        "kubernetes_manifest.model_runtime_network_helm_freeze_admission_binding[0]",
        "kubernetes_manifest.model_runtime_network_lease_guard_admission",
        "kubernetes_manifest.model_runtime_network_lease_guard_admission_binding",
        "kubernetes_manifest.model_runtime_network_transition_guard_admission",
        "kubernetes_manifest.model_runtime_network_transition_guard_admission_binding[0]",
        "kubernetes_config_map_v1.model_runtime_network_enforcement[0]",
    }
    holder_refresh_prefixes = (
        "kubernetes_manifest.model_runtime_network_profile_admission[",
        "kubernetes_manifest.model_runtime_network_profile_admission_binding[",
        "kubernetes_network_policy_v1.model_runtime_base_profile[",
        "kubernetes_network_policy_v1.model_runtime_modelexpress_profile[",
        "kubernetes_network_policy_v1.model_namespace_support_profile[",
    )
    changes: dict[str, list[str]] = {}
    for resource in document.get("resource_changes", []):
        if resource.get("mode", "managed") != "managed":
            continue
        actions = resource.get("change", {}).get("actions", [])
        if actions in (["no-op"], ["read"]):
            continue
        address = resource.get("address")
        if not isinstance(address, str) or not all(
            isinstance(action, str) for action in actions
        ):
            raise DeploymentError(
                "the workloads rollback plan has a malformed resource change"
            )
        change = resource.get("change", {})
        if (
            actions == ["update"]
            and (
                address in holder_refresh_addresses
                or address.startswith(holder_refresh_prefixes)
            )
            and without_holder(change.get("before"))
            == without_holder(change.get("after"))
        ):
            continue
        changes[address] = actions
    allowed = {
        "kubernetes_network_policy_v1.model_namespace_default_deny[0]": ["delete"],
        "terraform_data.model_runtime_network_policy_apply_fence[0]": ["delete"],
        "terraform_data.model_runtime_network_policy_transition": ["update"],
    }
    # A prior apply can crash after either state transition. Retrying that exact
    # saved plan may therefore contain neither change or just the remaining one.
    # Accept any subset, but never a third address or different action.
    if any(
        address not in allowed or actions != allowed[address]
        for address, actions in changes.items()
    ):
        rendered = (
            ", ".join(
                f"{address}={'+'.join(actions)}"
                for address, actions in sorted(changes.items())
            )
            or "none"
        )
        raise DeploymentError(
            "rollback-remove-deny must be an isolated saved plan containing only "
            "default-deny/apply-fence deletion, transition receipt update, and exact "
            "holder-token annotation refreshes; observed: "
            f"{rendered}"
        )


def validate_model_network_frozen_plan(
    document: Mapping[str, Any], contract: Mapping[str, Any]
) -> None:
    """Reject control-plane Helm mutation after the external fence is armed."""

    transition = (
        contract.get("stages", {})
        .get("workloads", {})
        .get("model_runtime_network_policy", {})
    )
    if not isinstance(transition, Mapping) or transition.get("phase") not in {
        "inventory",
        "enforce",
        "rollback-remove-deny",
    }:
        return
    for resource in document.get("resource_changes", []):
        if resource.get("address") != "helm_release.control_plane":
            continue
        actions = resource.get("change", {}).get("actions", [])
        if actions not in (["no-op"], ["read"]):
            raise DeploymentError(
                "the separately custodied Helm/controller fence is already active; "
                "roll out the integrated control-plane image before authority "
                "bootstrap or complete deny-first rollback before a later Helm change"
            )


def validate_model_network_maintenance_plan(
    document: Mapping[str, Any], contract: Mapping[str, Any]
) -> None:
    """Allow a routine Helm update without permitting boundary churn or replacement."""

    transition = (
        contract.get("stages", {})
        .get("workloads", {})
        .get("model_runtime_network_policy", {})
    )
    if not isinstance(transition, Mapping) or transition.get("phase") != "maintenance":
        return
    allowed = {
        "helm_release.control_plane": {("update",), ("no-op",), ("read",)},
        "terraform_data.model_runtime_network_policy_transition": {
            ("update",),
            ("no-op",),
            ("read",),
        },
    }
    violations: list[str] = []
    for resource in document.get("resource_changes", []):
        if resource.get("mode", "managed") != "managed":
            continue
        actions = tuple(resource.get("change", {}).get("actions", []))
        if actions in {("no-op",), ("read",)}:
            continue
        address = resource.get("address")
        if not isinstance(address, str) or actions not in allowed.get(address, set()):
            violations.append(f"{address}={'+'.join(actions)}")
    if violations:
        raise DeploymentError(
            "maintenance may update only the control-plane Helm release while "
            "default-deny, its apply fence, marker, policies and admission objects "
            "remain byte-stable; observed: " + ", ".join(sorted(violations))
        )


def source_commit() -> str:
    result = run(
        ["git", "-C", str(REPOSITORY_ROOT), "rev-parse", "HEAD"],
        capture=True,
        env=clean_environment(),
    )
    commit = result.stdout.strip()
    if len(commit) != 40 or any(
        character not in "0123456789abcdef" for character in commit
    ):
        raise DeploymentError(
            "the source checkout does not have an exact Git commit identity"
        )
    return commit


def default_run_root(variable_file: Path) -> Path:
    identity = hashlib.sha256(str(variable_file.resolve()).encode()).hexdigest()[:12]
    state_home = os.environ.get("XDG_STATE_HOME")
    base = Path(state_home) if state_home else Path.home() / ".local" / "state"
    return base / "nebius-k8s-inference" / identity


def validate_configuration(
    terraform: str,
    variable_file: Path,
    run_root: Path,
) -> tuple[dict[str, Any], dict[str, str]]:
    environment = terraform_environment(run_root, "configuration")
    backend = run_root / "configuration.tfstate"
    terraform_init(terraform, DEPLOY_ROOT, backend, environment)
    document = plan_json(
        terraform,
        root=DEPLOY_ROOT,
        environment=environment,
        variable_file=variable_file,
        plan_path=run_root / "configuration.tfplan",
        json_path=run_root / "configuration.plan.json",
    )
    contract = planned_output(document, "deployment_contract")
    private_json(run_root / "deployment-contract.json", contract)
    return contract, environment


def preflight_accelerators(
    args: argparse.Namespace,
    contract: Mapping[str, Any],
) -> None:
    """Validate project-local platform, preset, capacity, and driver facts live."""
    pools = contract["stages"]["infrastructure"].get("custom_accelerator_pools", {})
    if not pools:
        raise DeploymentError(
            "live preflight requires deployment.accelerator_pools; checked-in profile pools are evidence-backed but not a substitute for current capacity"
        )

    project_id = contract["target"]["project_id"]
    target_region = contract["target"]["region"]
    kubernetes_version = contract["stages"]["infrastructure"]["kubernetes_version"]
    checked: list[dict[str, Any]] = []
    for pool_id, pool in sorted(pools.items()):
        platform_result = run(
            [
                args.nebius,
                "--profile",
                args.nebius_profile,
                "compute",
                "platform",
                "get-by-name",
                "--parent-id",
                project_id,
                "--name",
                pool["platform"],
                "--format",
                "json",
            ],
            capture=True,
            env=clean_environment(),
        )
        platform = json.loads(platform_result.stdout)
        presets = {
            item.get("name"): item
            for item in platform.get("spec", {}).get("presets", [])
        }
        if pool["preset"] not in presets:
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: preset {pool['preset']!r} is not offered by platform {pool['platform']!r} in project {project_id}"
            )
        preset = presets[pool["preset"]]
        advertised_gpu_count = preset.get("resources", {}).get("gpu_count")
        if advertised_gpu_count != pool["gpus_per_node"]:
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: gpus_per_node={pool['gpus_per_node']} differs from the live preset value {advertised_gpu_count}"
            )
        if pool["capacity_type"] == "preemptible" and not platform.get(
            "status", {}
        ).get("allowed_for_preemptibles", False):
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: platform {pool['platform']!r} does not allow preemptible capacity in this project"
            )
        if pool["topology"]["mode"] == "gpu_cluster" and not preset.get(
            "allow_gpu_clustering", False
        ):
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: preset {pool['preset']!r} is not GPU-cluster capable"
            )

        compatibility_result = run(
            [
                args.nebius,
                "--profile",
                args.nebius_profile,
                "mk8s",
                "node-group",
                "get-compatibility-matrix",
                "--cluster-kubernetes-version",
                kubernetes_version,
                "--platform",
                pool["platform"],
                "--format",
                "json",
            ],
            capture=True,
            env=clean_environment(),
        )
        compatibility = json.loads(compatibility_result.stdout)
        items = [
            item
            for version in compatibility.get("versions", [])
            if version.get("kubernetes_version") == kubernetes_version
            for item in version.get("items", [])
            if pool["platform"] in item.get("compatible_platforms", [])
            and item.get("os") == pool["os"]
        ]
        driver = pool["driver"]
        compatible = any(
            (
                driver["mode"] == "managed"
                and item.get("drivers_preset") == driver.get("preset")
            )
            or (driver["mode"] == "operator" and not item.get("drivers_preset"))
            for item in items
        )
        if not compatible:
            raise DeploymentError(
                f"accelerator pool {pool_id!r}: OS/driver mode is absent from the live MK8s compatibility matrix"
            )

        reservation = pool.get("reservation_policy")
        reservation_evidence: dict[str, Any] | None = None
        if reservation is not None:
            reservation_ids = reservation.get("reservation_ids", [])
            required_gpu_units = pool["max_nodes"] * pool["gpus_per_node"]
            total_gpu_units = 0.0
            available_gpu_units = 0.0
            groups: list[dict[str, Any]] = []
            for reservation_id in reservation_ids:
                group_result = run(
                    [
                        args.nebius,
                        "--profile",
                        args.nebius_profile,
                        "capacity",
                        "capacity-block-group",
                        "get",
                        "--id",
                        reservation_id,
                        "--format",
                        "json",
                    ],
                    capture=True,
                    env=clean_environment(),
                )
                group = json.loads(group_result.stdout)
                metadata = group.get("metadata", {})
                status = group.get("status", {})
                affinity = status.get("resource_affinity", {}).get("compute_v1", {})
                if (
                    metadata.get("id") != reservation_id
                    or status.get("state") != "STATE_ACTIVE"
                    or status.get("region") != target_region
                    or affinity.get("platform") != pool["platform"]
                ):
                    raise DeploymentError(
                        f"accelerator pool {pool_id!r}: capacity block {reservation_id!r} is not an active {target_region}/{pool['platform']} reservation"
                    )
                limit_text = str(status.get("current_limit", ""))
                usage_units_text = str(status.get("usage", ""))
                usage_text = str(status.get("usage_percentage", ""))
                if (
                    not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", limit_text)
                    or not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", usage_units_text)
                    or not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", usage_text)
                ):
                    raise DeploymentError(
                        f"accelerator pool {pool_id!r}: capacity block {reservation_id!r} has malformed capacity status"
                    )
                current_limit = float(limit_text)
                usage_gpu_units = float(usage_units_text)
                usage_fraction = float(usage_text)
                if (
                    current_limit < 0.0
                    or not 0.0 <= usage_gpu_units <= current_limit
                    or not 0.0 <= usage_fraction <= 1.0
                ):
                    raise DeploymentError(
                        f"accelerator pool {pool_id!r}: capacity block {reservation_id!r} has invalid capacity usage"
                    )
                total_gpu_units += current_limit
                available_gpu_units += current_limit - usage_gpu_units
                groups.append(
                    {
                        "id": reservation_id,
                        "state": status["state"],
                        "current_limit": current_limit,
                        "usage_gpu_units": usage_gpu_units,
                        "usage_fraction": usage_fraction,
                        "active_until": status.get(
                            "current_continuous_interval", {}
                        ).get("end_time"),
                    }
                )
            if total_gpu_units + 1e-9 < required_gpu_units:
                raise DeploymentError(
                    f"accelerator pool {pool_id!r}: capacity blocks reserve {total_gpu_units:g} total GPU units but fixed capacity requires {required_gpu_units}"
                )
            reservation_evidence = {
                "policy": reservation["policy"],
                "required_gpu_units": required_gpu_units,
                "total_gpu_units": total_gpu_units,
                "available_gpu_units": available_gpu_units,
                "groups": groups,
                "status": "compatible",
            }

        pool_evidence = {
            "pool_id": pool_id,
            "platform": pool["platform"],
            "preset": pool["preset"],
            "capacity_type": pool["capacity_type"],
            "driver_mode": driver["mode"],
            "topology": pool["topology"]["mode"],
            "status": "compatible",
        }
        if reservation_evidence is not None:
            pool_evidence["reservation"] = reservation_evidence
        checked.append(pool_evidence)

    print(
        json.dumps(
            {
                "status": "compatible",
                "project_id": project_id,
                "kubernetes_version": kubernetes_version,
                "accelerator_pools": checked,
                "capacity_advisor": "Run Capacity Advisor immediately before apply; availability is not guaranteed by compatibility.",
            },
            indent=2,
        )
    )


def require_deployable_images(contract: Mapping[str, Any]) -> None:
    """Fail before cloud mutation when source-build placeholders remain."""
    workloads = contract["stages"]["workloads"]
    policy = contract["artifact_delivery"]["mode"]
    application_images = {
        "control plane": workloads["control_plane_image"],
        "admin console": workloads["admin_console"]["image"],
    }
    for label, image in application_images.items():
        repository = image["repository"]
        digest = image["digest"]
        if repository.split("/", 1)[0].endswith(".invalid"):
            raise DeploymentError(
                f"{label} image still uses a .invalid source-build placeholder"
            )
        if digest == f"sha256:{'0' * 64}":
            raise DeploymentError(
                f"{label} image still uses the zero digest placeholder"
            )
        if policy == "regional-mirror":
            split_digest_reference(f"{repository}@{digest}", label=label)

    selected_models = set(contract["selected_model_ids"])
    model_images = workloads.get("model_image_overrides", {})
    missing = sorted(selected_models - set(model_images))
    if missing:
        raise DeploymentError(
            "selected models lack both a tfvars image override and a runtime-catalog image: "
            + ", ".join(missing)
        )
    for model_id in sorted(selected_models):
        image = model_images[model_id]
        host = image.split("/", 1)[0]
        if host.endswith(".invalid"):
            raise DeploymentError(
                f"selected model {model_id!r} still uses an unresolved .invalid runtime-catalog image"
            )
        if policy == "regional-mirror":
            split_digest_reference(image, label=f"model {model_id}")

    reference_data = workloads.get("reference_data", {})
    if isinstance(reference_data, Mapping) and reference_data.get("enabled") is True:
        for component in ("status", "pipeline"):
            configuration = reference_data.get(component, {})
            if (
                not isinstance(configuration, Mapping)
                or configuration.get("enabled") is not True
            ):
                continue
            image = configuration.get("image")
            if not isinstance(image, str) or image.split("/", 1)[0].endswith(
                ".invalid"
            ):
                raise DeploymentError(f"reference-data {component} image is unresolved")
            if policy == "regional-mirror":
                split_digest_reference(image, label=f"reference-data {component}")


def split_digest_reference(reference: str, *, label: str) -> tuple[str, str]:
    """Split one immutable OCI reference without accepting a tag-only source."""
    marker = "@sha256:"
    if reference.count("@") != 1 or reference.count(marker) != 1:
        raise DeploymentError(
            f"{label} image must be pinned as repository@sha256:<64 hex>"
        )
    repository, hexadecimal = reference.rsplit(marker, 1)
    if (
        not repository
        or "/" not in repository
        or any(character in repository for character in ("?", "#"))
        or any(character.isspace() for character in repository)
        or ":" in repository.rsplit("/", 1)[-1]
        or len(hexadecimal) != 64
        or any(character not in "0123456789abcdef" for character in hexadecimal)
    ):
        raise DeploymentError(
            f"{label} image must be pinned as repository@sha256:<64 hex>"
        )
    host, path = repository.split("/", 1)
    host_without_port = host.split(":", 1)[0]
    if (
        "." not in host_without_port
        or not re.fullmatch(r"[a-zA-Z0-9.-]+(?::[0-9]+)?", host)
        or any(part in ("", ".", "..") for part in path.split("/"))
        or not re.fullmatch(r"[a-z0-9._/-]+", path)
    ):
        raise DeploymentError(
            f"{label} image must use a fully-qualified registry host and safe repository path"
        )
    return repository, f"sha256:{hexadecimal}"


def source_repository_path(repository: str) -> str:
    """Preserve an upstream repository path, excluding a Nebius registry ID."""
    parts = repository.split("/")
    if len(parts) < 2:
        raise DeploymentError(f"OCI repository has no path: {repository!r}")
    host, path = parts[0], parts[1:]
    if host.startswith("cr.") and host.endswith(".nebius.cloud") and len(path) > 1:
        path = path[1:]
    if not path or any(part in ("", ".", "..") for part in path):
        raise DeploymentError(f"OCI repository has an unsafe path: {repository!r}")
    return "/".join(path)


def selected_image_artifacts(
    contract: Mapping[str, Any],
    registry_delivery: Mapping[str, Any],
) -> list[dict[str, str]]:
    """Return the complete selected source-to-target image closure."""
    expected_policy = contract["artifact_delivery"]
    if (
        registry_delivery.get("schema") != "fs2-serve.nebius.ai/registry-delivery/v1"
        or registry_delivery.get("mode") != expected_policy["mode"]
        or registry_delivery.get("repository_prefix")
        != expected_policy["repository_prefix"]
    ):
        raise DeploymentError(
            "the infrastructure registry-delivery output differs from terraform.tfvars"
        )
    target = registry_delivery.get("target_registry")
    if not isinstance(target, dict):
        raise DeploymentError(
            "the infrastructure registry-delivery output is malformed"
        )
    target_region = contract["target"]["region"]
    target_registry_id = str(target.get("id", ""))
    target_fqdn = str(target.get("fqdn", "")).rstrip("/")
    target_root = str(target.get("repository_root", "")).rstrip("/")
    expected_fqdn = f"cr.{target_region}.nebius.cloud"
    expected_root = f"{expected_fqdn}/{target_registry_id.removeprefix('registry-')}"
    if (
        not re.fullmatch(r"registry-[a-z0-9]+", target_registry_id)
        or target.get("project_id") != contract["target"]["project_id"]
        or target.get("region") != target_region
        or target_fqdn != expected_fqdn
        or target_root != expected_root
    ):
        raise DeploymentError("the infrastructure target registry root is malformed")

    workloads = contract["stages"]["workloads"]
    sources: list[tuple[str, str]] = [
        (
            "application/control-plane",
            f"{workloads['control_plane_image']['repository']}@{workloads['control_plane_image']['digest']}",
        ),
        (
            "application/admin-console",
            f"{workloads['admin_console']['image']['repository']}@{workloads['admin_console']['image']['digest']}",
        ),
    ]
    sources.extend(
        (f"model/{model_id}", workloads["model_image_overrides"][model_id])
        for model_id in contract["selected_model_ids"]
    )
    reference_data = workloads.get("reference_data", {})
    if isinstance(reference_data, Mapping) and reference_data.get("enabled") is True:
        for component in ("status", "pipeline"):
            configuration = reference_data.get(component, {})
            if (
                isinstance(configuration, Mapping)
                and configuration.get("enabled") is True
            ):
                sources.append(
                    (f"reference-data/{component}", str(configuration["image"]))
                )

    prefix = str(registry_delivery.get("repository_prefix", "")).strip("/")
    artifacts: list[dict[str, str]] = []
    target_sources: dict[str, str] = {}
    for name, source_reference in sources:
        source_repository, digest = split_digest_reference(source_reference, label=name)
        relative_repository = source_repository_path(source_repository)
        target_repository = "/".join(
            part for part in (target_root, prefix, relative_repository) if part
        )
        prior_source = target_sources.get(target_repository)
        if prior_source is not None and prior_source != source_repository:
            raise DeploymentError(
                "two distinct upstream repositories collapse to the same target repository: "
                f"{target_repository}"
            )
        target_sources[target_repository] = source_repository
        target_tag = (
            f"{target_repository}:mirror-sha256-{digest.removeprefix('sha256:')}"
        )
        artifacts.append(
            {
                "name": name,
                "source_repository": source_repository,
                "source_reference": source_reference,
                "digest": digest,
                "target_repository": target_repository,
                "target_reference": f"{target_repository}@{digest}",
                "target_tag": target_tag,
            }
        )
    return artifacts


def rewritten_workloads(
    contract: Mapping[str, Any], dynamic: Mapping[str, Any]
) -> dict[str, Any]:
    """Rewrite runtime pulls to the regional target without changing digests."""
    workloads = dict(contract["stages"]["workloads"])
    if contract["artifact_delivery"]["mode"] == "direct-source":
        return workloads
    artifacts = {
        artifact["name"]: artifact
        for artifact in selected_image_artifacts(
            contract, dynamic["registry_delivery_contract"]
        )
    }
    control_plane = dict(workloads["control_plane_image"])
    control_plane["repository"] = artifacts["application/control-plane"][
        "target_repository"
    ]
    workloads["control_plane_image"] = control_plane

    admin_console = dict(workloads["admin_console"])
    admin_image = dict(admin_console["image"])
    admin_image["repository"] = artifacts["application/admin-console"][
        "target_repository"
    ]
    admin_console["image"] = admin_image
    workloads["admin_console"] = admin_console
    workloads["model_image_overrides"] = {
        model_id: artifacts[f"model/{model_id}"]["target_reference"]
        for model_id in contract["selected_model_ids"]
    }
    reference_data = workloads.get("reference_data")
    if isinstance(reference_data, Mapping) and reference_data.get("enabled") is True:
        rewritten_reference_data = dict(reference_data)
        for component in ("status", "pipeline"):
            configuration = rewritten_reference_data.get(component)
            if (
                not isinstance(configuration, Mapping)
                or configuration.get("enabled") is not True
            ):
                continue
            rewritten_configuration = dict(configuration)
            rewritten_configuration["image"] = artifacts[f"reference-data/{component}"][
                "target_reference"
            ]
            rewritten_reference_data[component] = rewritten_configuration
        workloads["reference_data"] = rewritten_reference_data
    return workloads


def canonical_sha256(value: object) -> str:
    """Match the control-plane configuration ETag and Terraform jsonencode digest."""

    payload = json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
        allow_nan=False,
    ).encode()
    return hashlib.sha256(payload).hexdigest()


def _admin_catalog() -> Any:
    """Load the validated packaged catalog without requiring an installed wheel."""

    paths = [str(CATALOG_ROOT), str(SOLUTION_ROOT / "components/control-plane/src")]
    added = [path for path in paths if path not in sys.path]
    sys.path[:0] = added
    try:
        from fs2_serve_catalog.loader import load_catalog
        from fs2_serve.native_catalog import augment_native_catalog

        return augment_native_catalog(
            load_catalog(CATALOG_ROOT), CATALOG_ROOT, repo_root=REPOSITORY_ROOT
        )
    except (ImportError, OSError, ValueError) as exc:
        raise DeploymentError(
            "the canonical model catalog cannot derive the admin baseline"
        ) from exc
    finally:
        for path in added:
            sys.path.remove(path)


def selected_deployment_runtimes(model_images: Mapping[str, str]) -> dict[str, Any]:
    """Select exact runtime digests, independently of a mirror's registry region."""
    selected: dict[str, Any] = {}
    for path in sorted((CATALOG_ROOT / "deployment-runtimes").glob("*.json")):
        entry = json.loads(path.read_text(encoding="utf-8"))
        model_id = entry["model_id"]
        image = model_images.get(model_id)
        if (
            image is None
            or image.rsplit("@", 1)[-1] != entry["record"]["runtime"]["image"]["digest"]
        ):
            continue
        if model_id in selected:
            raise DeploymentError(
                f"model {model_id!r} has ambiguous deployment runtime records"
            )
        selected[model_id] = entry
    return selected


def deployment_runtime_configuration_identities(
    entries: Mapping[str, Any],
) -> dict[str, Any]:
    """Use the control plane's exact artifact identities for the admin baseline."""
    paths = [str(CATALOG_ROOT), str(SOLUTION_ROOT / "components/control-plane/src")]
    added = [path for path in paths if path not in sys.path]
    sys.path[:0] = added
    try:
        from fs2_serve.deployment_runtimes import (
            deployment_runtime_configuration_identity,
        )

        return {
            model_id: deployment_runtime_configuration_identity(entry)
            for model_id, entry in entries.items()
        }
    finally:
        for path in added:
            sys.path.remove(path)


def _admin_pool_ids(
    contract: Mapping[str, Any],
    workloads: Mapping[str, Any],
    pools: Mapping[str, Any],
    *,
    model_id: str,
    accelerator_class: str,
) -> list[str]:
    override = workloads.get("model_pool_overrides", {}).get(model_id)
    if isinstance(override, str) and override:
        candidates = [override]
    else:
        placement = contract.get("selected_model_placements", {}).get(model_id, {})
        compatible = (
            placement.get("compatible_pool_ids", [])
            if isinstance(placement, Mapping)
            else []
        )
        candidates = [value for value in compatible if isinstance(value, str)]
    candidates = [value for value in candidates if value in pools]
    if not candidates:
        normalized = accelerator_class.casefold().replace("_", "-")
        candidates = sorted(
            pool_id
            for pool_id, pool in pools.items()
            if str(pool.get("accelerator_class", "")).casefold().replace("_", "-")
            == normalized
        )
    if not candidates:
        raise DeploymentError(
            f"model {model_id!r} has no selected accelerator pool; set deployment.models.pool_overrides"
        )
    return sorted(dict.fromkeys(candidates))


def _admin_scaling(
    workloads: Mapping[str, Any],
    model_id: str,
) -> dict[str, int]:
    mode = workloads.get("model_scaling_mode")
    if mode not in {"keda", "static"}:
        raise DeploymentError("admin baseline requires a supported model scaling mode")
    configured = workloads.get("model_scaling_overrides", {}).get(model_id, {})
    if not isinstance(configured, Mapping):
        raise DeploymentError(f"model {model_id!r} has an invalid scaling override")
    if mode == "static":
        return {
            "min_replicas": 1,
            "max_replicas": 1,
            "target_queue_depth": 1,
            "polling_interval_seconds": int(workloads["keda_polling_interval_seconds"]),
            "cooldown_seconds": int(workloads["keda_cooldown_period_seconds"]),
        }
    hot = model_id in workloads.get("hot_model_ids", [])
    return {
        "min_replicas": int(configured.get("min_replicas", 1 if hot else 0)),
        "max_replicas": int(configured.get("max_replicas", 1)),
        "target_queue_depth": int(configured.get("target_queue_depth", 1)),
        "polling_interval_seconds": int(
            configured.get(
                "polling_interval_seconds", workloads["keda_polling_interval_seconds"]
            )
        ),
        "cooldown_seconds": int(
            configured.get(
                "cooldown_seconds", workloads["keda_cooldown_period_seconds"]
            )
        ),
    }


def derived_admin_configuration(
    contract: Mapping[str, Any],
    dynamic: Mapping[str, Any],
    workloads: Mapping[str, Any],
) -> tuple[dict[str, Any], str, dict[str, dict[str, int]]]:
    """Project the same tfvars-selected pools, routes, and immutable artifacts into the admin API."""

    accelerator_contract = dynamic.get("accelerator_pool_contract")
    if not isinstance(accelerator_contract, Mapping):
        raise DeploymentError(
            "the accelerator-pool output is unavailable for the admin baseline"
        )
    raw_pools = accelerator_contract.get("pools")
    if not isinstance(raw_pools, Mapping) or not raw_pools:
        raise DeploymentError(
            "the accelerator-pool output contains no pools for the admin baseline"
        )

    catalog = _admin_catalog()
    try:
        routes_document = json.loads(MODEL_ROUTES_PATH.read_text(encoding="utf-8"))
        pool_profiles = json.loads(POOL_PROFILES_PATH.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError(
            "the admin baseline support contracts are unreadable"
        ) from exc
    routes = routes_document.get("routes", {})
    profile_name = contract.get("profiles", {}).get("accelerators")
    queue = pool_profiles.get("profiles", {}).get(profile_name, {}).get("queue", {})
    local_queue = str(queue.get("local_queue_name", "fs2-models-async"))

    pools: dict[str, Any] = {}
    pool_features: dict[str, Mapping[str, Any]] = {}
    for pool_id, raw_pool in sorted(raw_pools.items()):
        if not isinstance(raw_pool, Mapping):
            raise DeploymentError(f"accelerator pool {pool_id!r} is malformed")
        capacity = raw_pool.get("capacity", {})
        node = raw_pool.get("node", {})
        resource_api = raw_pool.get("resource_api", {})
        scheduling = raw_pool.get("scheduling", {})
        selectors = scheduling.get("stable_node_labels", {})
        tolerations = scheduling.get("tolerations", [])
        pools[str(pool_id)] = {
            "resource_name": str(resource_api.get("resource_name", "nvidia.com/gpu")),
            "accelerator_class": str(raw_pool.get("accelerator_class", "")),
            "capacity_type": str(capacity.get("type", "regular")),
            "accelerators_per_node": int(node.get("gpus_per_node", 0)),
            "min_nodes": int(capacity.get("min_nodes", 0)),
            "max_nodes": int(capacity.get("max_nodes", 0)),
            "node_selector": {
                str(key): str(value)
                for key, value in sorted(selectors.items())
                if isinstance(key, str) and isinstance(value, str)
            },
            "tolerations": [
                {
                    "key": str(item.get("key", "")),
                    "operator": str(item.get("operator", "Equal")),
                    "value": item.get("value"),
                    "effect": item.get("effect"),
                    "toleration_seconds": item.get("toleration_seconds"),
                }
                for item in tolerations
                if isinstance(item, Mapping)
            ],
        }
        pool_features[str(pool_id)] = (
            raw_pool.get("features", {})
            if isinstance(raw_pool.get("features", {}), Mapping)
            else {}
        )

    model_images = workloads.get("model_image_overrides", {})
    selected_model_ids = contract.get("selected_model_ids", [])
    deployment_runtimes = selected_deployment_runtimes(
        {
            model_id: model_images[model_id]
            for model_id in selected_model_ids
            if model_id in model_images
        }
    )
    cpu_runtime_model_ids = {
        model_id
        for model_id, entry in deployment_runtimes.items()
        if entry["record"]["resources"]["gpu"]
        == {
            "class": "CPU",
            "count": 0,
            "topology": "cpu-only",
            "placement": None,
            "b300_state": "not-applicable",
            "alternatives": [],
        }
    }
    native_ids = set(
        json.loads(
            (SOLUTION_ROOT / "catalog/profiles/model-profiles.json").read_text(
                encoding="utf-8"
            )
        ).get("managed_native_model_ids", [])
    )
    managed_cpu_ids = cpu_runtime_model_ids & native_ids
    if cpu_runtime_model_ids:
        general_cpu_contract = dynamic.get("general_cpu_pool_contract")
        if not isinstance(general_cpu_contract, Mapping):
            raise DeploymentError(
                "a selected CPU deployment runtime requires the general CPU pool output"
            )
        general_pools = general_cpu_contract.get("pools")
        node_selector = general_cpu_contract.get("node_selector")
        taint = general_cpu_contract.get("taint")
        if (
            general_cpu_contract.get("schema")
            != "fs2-serve.nebius.ai/general-cpu-pools/v1"
            or not isinstance(general_pools, Mapping)
            or len(general_pools) != 1
            or not isinstance(node_selector, Mapping)
            or not node_selector
            or not isinstance(taint, Mapping)
        ):
            raise DeploymentError(
                "a selected CPU deployment runtime requires one exact general CPU pool"
            )
        for pool_id, raw_pool in sorted(general_pools.items()):
            if pool_id in pools or not isinstance(raw_pool, Mapping):
                raise DeploymentError(
                    "the general CPU pool identity is malformed or duplicated"
                )
            pools[str(pool_id)] = {
                "resource_name": "cpu",
                "accelerator_class": "CPU",
                "capacity_type": str(raw_pool.get("capacity_type", "")),
                "accelerators_per_node": 0,
                "min_nodes": int(raw_pool.get("min_nodes", 0)),
                "max_nodes": int(raw_pool.get("max_nodes", 0)),
                "node_selector": {
                    **{
                        str(key): str(value)
                        for key, value in sorted(node_selector.items())
                        if isinstance(key, str) and isinstance(value, str)
                    },
                    "capacity.fs2.nebius/pool-id": str(pool_id),
                },
                "tolerations": [
                    {
                        "key": str(taint.get("key", "")),
                        "operator": "Equal",
                        "value": str(taint.get("value", "")),
                        "effect": str(taint.get("effect", "")),
                        "toleration_seconds": None,
                    }
                ],
            }
            if managed_cpu_ids:
                resources = raw_pool.get("schedulable_capacity", {})
                pools[str(pool_id)].update(
                    {
                        "allocatable_cpu_millis": int(
                            resources.get("cpu_millicores", 0)
                        ),
                        "allocatable_memory_bytes": int(resources.get("memory_mib", 0))
                        * 1048576,
                    }
                )
            pool_features[str(pool_id)] = {}
    deployment_identities = (
        deployment_runtime_configuration_identities(deployment_runtimes)
        if deployment_runtimes
        else {}
    )
    scaling = {
        model_id: (
            {
                "min_replicas": 1,
                "max_replicas": 1,
                "target_queue_depth": 1,
                "polling_interval_seconds": int(
                    workloads["keda_polling_interval_seconds"]
                ),
                "cooldown_seconds": int(workloads["keda_cooldown_period_seconds"]),
            }
            if model_id in cpu_runtime_model_ids and model_id not in managed_cpu_ids
            else _admin_scaling(workloads, model_id)
        )
        for model_id in selected_model_ids
    }
    models: dict[str, Any] = {}
    for model_id in selected_model_ids:
        if (
            model_id not in catalog.records
            or model_id not in catalog.acquisition_plans
            or model_id not in catalog.semantic_requests
        ):
            raise DeploymentError(
                f"model {model_id!r} lacks canonical admin configuration identities"
            )
        value = (
            deployment_runtimes[model_id]["record"]
            if model_id in deployment_runtimes
            else catalog.records[model_id].to_dict()
        )
        route = routes.get(model_id)
        if route is None and model_id in deployment_runtimes:
            # New native models do not rewrite the archived 16-model route
            # inventory. Their selected, validated record owns this metadata.
            route = {
                "mcp": {
                    "enabled": value["interface"]["mcp"]["discoverable"],
                    "tool_name": f"infer_{model_id.replace('-', '_')}",
                }
            }
        image_reference = model_images.get(model_id)
        if not isinstance(route, Mapping) or not isinstance(image_reference, str):
            raise DeploymentError(f"model {model_id!r} lacks a deployed route or image")
        image_repository, image_digest = split_digest_reference(
            image_reference,
            label=f"admin configuration model/{model_id}",
        )
        gpu = value["resources"]["gpu"]
        pool_ids = _admin_pool_ids(
            contract,
            workloads,
            pools,
            model_id=model_id,
            accelerator_class=str(gpu["class"]),
        )
        selected_pool_features = [pool_features[pool_id] for pool_id in pool_ids]
        cache_tier = (
            "node-local"
            if model_id in cpu_runtime_model_ids
            or any(
                item.get("local_cache") == "node-local"
                for item in selected_pool_features
            )
            else "shared-filesystem"
            if any(
                item.get("shared_filesystem") is True for item in selected_pool_features
            )
            else "object-store"
        )
        mcp = route.get("mcp", {})
        mcp_enabled = bool(isinstance(mcp, Mapping) and mcp.get("enabled") is True)
        readiness_timeout = int(value["interface"]["readiness"]["timeout_seconds"])
        acquisition_sha256 = canonical_sha256(
            catalog.acquisition_plans[model_id].to_dict()
        )
        models[model_id] = {
            "model_id": model_id,
            "enabled": True,
            "placement": {
                "pool_ids": pool_ids,
                "accelerators": int(gpu["count"]),
                "topology_policy": "any"
                if model_id in cpu_runtime_model_ids
                else "single-node",
            },
            "autoscaling": scaling[model_id],
            "queue": {
                "local_queue": (
                    str(workloads.get("general_cpu_lane", {}).get("local_queue", ""))
                    if model_id in cpu_runtime_model_ids
                    else local_queue
                ),
                "priority_class": "default",
                "max_queue_seconds": 7200,
            },
            "snapshot": {
                "strategy": "disabled",
                "cache_tier": cache_tier,
                "restore_timeout_seconds": max(600, readiness_timeout),
                "parallelism": 1,
                "require_semantic_check": True,
            },
            "mcp": {
                "exposed": mcp_enabled,
                "tool_name": str(mcp["tool_name"]) if mcp_enabled else None,
            },
            "rate": {
                "requests_per_minute": None,
                "concurrent_requests": 1,
                "accelerator_seconds_per_day": None,
            },
            "artifact": {
                "image_repository": image_repository,
                "image_digest": image_digest,
                "model_revision": str(value["model"]["source"]["revision"]),
                "artifact_manifest_sha256": value["cache"]["artifact"].get(
                    "manifest_digest"
                ),
                "acquisition_contract_sha256": acquisition_sha256,
                "provenance_sha256": catalog.records[model_id].digest,
                "semantic_health_contract_sha256": catalog.semantic_requests[
                    model_id
                ].digest,
            },
        }
        if model_id in managed_cpu_ids:
            models[model_id]["placement"].update(
                {
                    "cpu_millis": int(value["resources"]["cpu_millis"]),
                    "memory_bytes": int(value["resources"]["memory_bytes"]),
                }
            )
        if model_id in deployment_identities:
            identity = deployment_identities[model_id]
            models[model_id]["artifact"].update(
                {
                    key: identity[key]
                    for key in (
                        "model_revision",
                        "artifact_manifest_sha256",
                        "acquisition_contract_sha256",
                        "provenance_sha256",
                        "semantic_health_contract_sha256",
                    )
                }
            )

    configuration = {
        "schema_version": "fs2.admin-configuration/v1",
        "pools": pools,
        "models": models,
    }
    return configuration, canonical_sha256(configuration), scaling


def merge_docker_config(base: Any, extra: Any) -> dict[str, Any]:
    """Merge Docker auth documents without logging or persisting credentials."""
    if not isinstance(base, dict) or not isinstance(extra, dict):
        raise DeploymentError("registry Docker configuration must be a JSON object")
    merged = dict(base)
    for key in ("auths", "credHelpers"):
        base_values = merged.get(key, {})
        extra_values = extra.get(key, {})
        if not isinstance(base_values, dict) or not isinstance(extra_values, dict):
            raise DeploymentError(
                f"registry Docker configuration {key} must be an object"
            )
        merged[key] = {**base_values, **extra_values}
    for key, value in extra.items():
        if key not in {"auths", "credHelpers"}:
            merged[key] = value
    return merged


@contextmanager
def registry_client_environment(
    contract: Mapping[str, Any],
    nebius_profile: str,
) -> Iterator[dict[str, str]]:
    """Materialize optional private registry auth only in an ephemeral directory."""
    environment = clean_environment()
    environment["NEBIUS_PROFILE"] = nebius_profile
    secret_name = contract["secret_environment"]["nvcr_dockerconfig"]
    encoded_extra = os.environ.get(secret_name)
    if not encoded_extra:
        yield environment
        return
    try:
        extra = json.loads(encoded_extra)
    except json.JSONDecodeError as exc:
        raise DeploymentError(
            f"the Docker configuration in environment reference {secret_name!r} is not valid JSON"
        ) from exc

    docker_config_root = Path(
        environment.get("DOCKER_CONFIG", str(Path.home() / ".docker"))
    )
    base_path = docker_config_root / "config.json"
    base: Any = {}
    if base_path.is_file() and not base_path.is_symlink():
        try:
            base = json.loads(base_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            raise DeploymentError(
                "the existing Docker configuration is not valid JSON"
            ) from exc

    with tempfile.TemporaryDirectory(prefix="fs2-registry-auth-") as temporary:
        temporary_root = Path(temporary)
        temporary_root.chmod(0o700)
        private_json(temporary_root / "config.json", merge_docker_config(base, extra))
        environment["DOCKER_CONFIG"] = str(temporary_root)
        yield environment


def crane_digest(
    crane: str,
    reference: str,
    environment: Mapping[str, str],
    *,
    missing_ok: bool = False,
) -> str | None:
    result = subprocess.run(
        [crane, "digest", reference],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        missing_markers = (
            "manifest unknown",
            "manifest_unknown",
            "name unknown",
            "name_unknown",
            "not found",
            "404",
        )
        diagnostic = f"{result.stdout}\n{result.stderr}".lower()
        if missing_ok and any(marker in diagnostic for marker in missing_markers):
            return None
        raise DeploymentError(
            "registry digest lookup failed; verify source existence and operator registry credentials"
        )
    digest = result.stdout.strip()
    if not digest.startswith("sha256:") or len(digest) != 71:
        raise DeploymentError("registry returned a malformed OCI digest")
    return digest


def crane_copy(
    crane: str,
    source: str,
    target_tag: str,
    environment: Mapping[str, str],
) -> None:
    result = subprocess.run(
        [crane, "copy", "--no-clobber", source, target_tag],
        env=dict(environment),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise DeploymentError(
            "regional image copy failed; verify upstream pull and target push credentials"
        )


def mirror_selected_images(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
    dynamic: Mapping[str, Any],
) -> Path | None:
    """Copy and verify the complete selected image closure before workloads."""
    if contract["artifact_delivery"]["mode"] == "direct-source":
        return None
    artifacts = selected_image_artifacts(
        contract, dynamic["registry_delivery_contract"]
    )
    receipt_images: list[dict[str, str]] = []
    completed_targets: dict[str, str] = {}
    with registry_client_environment(contract, args.nebius_profile) as environment:
        for artifact in artifacts:
            expected = artifact["digest"]
            target_reference = artifact["target_reference"]
            status = completed_targets.get(target_reference)
            if status is None:
                existing = crane_digest(
                    args.crane, artifact["target_tag"], environment, missing_ok=True
                )
                if existing is not None and existing != expected:
                    raise DeploymentError(
                        f"target mirror tag digest mismatch for {artifact['name']}; refusing to overwrite"
                    )
                if existing == expected:
                    status = "existing"
                else:
                    source_digest = crane_digest(
                        args.crane, artifact["source_reference"], environment
                    )
                    if source_digest != expected:
                        raise DeploymentError(
                            f"upstream digest mismatch for {artifact['name']}; refusing to deploy"
                        )
                    print(
                        f"Mirroring {artifact['name']} into the regional registry.",
                        file=sys.stderr,
                    )
                    crane_copy(
                        args.crane,
                        artifact["source_reference"],
                        artifact["target_tag"],
                        environment,
                    )
                    status = "copied"
                if (
                    crane_digest(args.crane, artifact["target_tag"], environment)
                    != expected
                ):
                    raise DeploymentError(
                        f"post-copy tag verification failed for {artifact['name']}"
                    )
                if (
                    crane_digest(args.crane, artifact["target_reference"], environment)
                    != expected
                ):
                    raise DeploymentError(
                        f"post-copy digest-reference verification failed for {artifact['name']}"
                    )
                completed_targets[target_reference] = status
            receipt_images.append(
                {
                    "name": artifact["name"],
                    "source_host": artifact["source_repository"].split("/", 1)[0],
                    "digest": expected,
                    "target_reference": artifact["target_reference"],
                    "status": status,
                }
            )
    receipt = {
        "schema": "fs2-serve.nebius.ai/registry-mirror-receipt/v1",
        "mode": "regional-mirror",
        "registry_id": dynamic["registry_delivery_contract"]["target_registry"]["id"],
        "images": receipt_images,
    }
    path = run_root / "registry-mirror.receipt.json"
    private_json(path, receipt)
    return path


def stage_paths(run_root: Path, stage: str) -> tuple[Path, Path, Path]:
    state_names = {
        "infrastructure": "terraform.tfstate",
        "foundation": "foundation.tfstate",
        "workloads": "workloads.tfstate",
    }
    return (
        run_root / state_names[stage],
        run_root / f"{stage}.tfvars.json",
        run_root / "terraform-data" / stage,
    )


def stage_root(stage: str) -> Path:
    return {
        "infrastructure": INFRA_ROOT,
        "foundation": FOUNDATION_ROOT,
        "workloads": WORKLOADS_ROOT,
    }[stage]


def stage_environment(
    run_root: Path,
    stage: str,
    contract: Mapping[str, Any],
    *,
    include_secrets: bool = True,
) -> dict[str, str]:
    environment = terraform_environment(run_root, stage)
    if not include_secrets:
        return environment
    secret_names = contract["secret_environment"]

    if stage == "foundation":
        username = os.environ.get(secret_names["grafana_username"])
        password = os.environ.get(secret_names["grafana_password"])
        if not username or not password:
            raise DeploymentError(
                "fresh foundation deployment requires both configured Grafana bootstrap username and password environment references"
            )
        environment["TF_VAR_bootstrap_grafana_credentials"] = json.dumps(
            {"username": username, "password": password},
            separators=(",", ":"),
        )

    if stage == "workloads":
        ngc_key = os.environ.get(secret_names["ngc_api_key"])
        docker_config = os.environ.get(secret_names["nvcr_dockerconfig"])
        requirements = contract["secret_requirements"]
        if requirements["ngc_api_key"] and not ngc_key:
            raise DeploymentError(
                "the selected NIM models require the configured NGC API-key environment reference"
            )
        if requirements["nvcr_dockerconfig"] and not docker_config:
            raise DeploymentError(
                "the selected workloads require the configured NVCR dockerconfig environment reference"
            )
        if ngc_key:
            environment["TF_VAR_ngc_api_key"] = ngc_key
        if docker_config:
            environment["TF_VAR_nvcrio_dockerconfigjson"] = docker_config

    return environment


