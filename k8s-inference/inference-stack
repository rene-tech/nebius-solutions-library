    return [line for line in result.stdout.splitlines() if line.strip()]


def plan_json(
    terraform: str,
    *,
    root: Path,
    environment: Mapping[str, str],
    variable_file: Path,
    plan_path: Path,
    json_path: Path,
    destroy: bool = False,
) -> dict[str, Any]:
    if plan_path.is_symlink() or json_path.is_symlink():
        raise DeploymentError("plan and plan JSON paths must not be symlinks")
    arguments = [
        terraform,
        f"-chdir={root}",
        "plan",
        "-input=false",
        "-lock=true",
        f"-var-file={variable_file}",
        f"-out={plan_path}",
    ]
    if destroy:
        arguments.insert(3, "-destroy")
    run(arguments, env=environment)
    plan_path.chmod(0o600)
    result = run(
        [terraform, f"-chdir={root}", "show", "-json", str(plan_path)],
        env=environment,
        capture=True,
    )
    guard_secret_migration_plan(
        result.stdout,
        identity_receipt=(
            plan_path.parent / "fixed-v1-identity.receipt.json"
            if root == WORKLOADS_ROOT
            else None
        ),
        terraform_root=root.name,
    )
    private_text(json_path, result.stdout)
    return json.loads(result.stdout)


def guard_secret_migration_plan(
    encoded_plan: str,
    *,
    identity_receipt: Path | None = None,
    terraform_root: str | None = None,
) -> None:
    """Apply the fail-closed legacy-generation guard without writing more JSON."""

    if SECRET_MIGRATION_GUARD.is_symlink() or not SECRET_MIGRATION_GUARD.is_file():
        raise DeploymentError("secret migration guard is absent or unsafe")
    arguments = [sys.executable, str(SECRET_MIGRATION_GUARD), "plan", "-"]
    if identity_receipt is not None:
        arguments.extend(["--identity-receipt", str(identity_receipt)])
    arguments.extend(["--registry", str(DURABLE_CREDENTIAL_REGISTRY)])
    if terraform_root is not None:
        arguments.extend(["--terraform-root", terraform_root])
    run(
        arguments,
        capture=True,
        input_text=encoded_plan,
    )


def guard_saved_plan(
