        "retained broker debug disable receipt",
    )
    _append_or_verify_json(
        revocation_root / f"{revocation_sha256}.json",
        revocation_envelope,
        "retained signed debug revocation",
    )
    print(
        json.dumps(
            {
                "activation_payload_sha256": activation_sha256,
                "backend_event_sha256": backend_ack["database_event_sha256"],
                "records_retention_dependency": "SAI-02:90-day-purge",
                "revoked_at": revocation["revoked_at"],
                "status": "debug-activation-disabled",
