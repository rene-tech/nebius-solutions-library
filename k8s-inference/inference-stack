            raise DeploymentError("ordinary proxy broker peer identity differs")
        connection.sendall(_canonical_bytes(request))
        response_raw, ancillary, flags, _address = connection.recvmsg(
            256 * 1024,
            socket.CMSG_SPACE(array.array("i", [0]).itemsize),
        )
        if flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC):
            raise DeploymentError("ordinary proxy broker response is truncated")
        received = array.array("i")
        for level, kind, data in ancillary:
            if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                received.frombytes(data[: len(data) - len(data) % received.itemsize])
        if len(received) != 1:
            for item in received:
                os.close(item)
            raise DeploymentError("ordinary proxy broker returned an invalid descriptor set")
        descriptor = received[0]
    finally:
        connection.close()
    try:
        response = json.loads(response_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        if descriptor >= 0:
            os.close(descriptor)
        raise DeploymentError("ordinary proxy broker response is malformed") from exc
    if not isinstance(response, dict) or set(response) != {
        "payload",
        "payload_sha256",
        "signature",
    }:
        os.close(descriptor)
        raise DeploymentError("ordinary proxy broker envelope is not exact")
    payload = response["payload"]
    expected_keys = {
        "broker_config_sha256",
        "broker_executable_sha256",
        "broker_id",
        "broker_runtime_review_sha256",
        "caller_effective_gid",
        "caller_real_gid",
        "caller_uid",
        "cluster_id",
        "cluster_name",
        "deployment_contract_sha256",
        "expires_at",
        "issued_at",
        "key_id",
        "kubeconfig_sha256",
        "mode",
        "nonce",
        "peer_observed_caller_gid",
        "peer_observed_caller_uid",
        "schema",
        "socket_path",
    }
    if (
        not isinstance(payload, Mapping)
        or set(payload) != expected_keys
        or response["payload_sha256"]
        != hashlib.sha256(_canonical_bytes(payload)).hexdigest()
        or payload["schema"]
        != "fs2-serve.nebius.ai/proxy-kubeconfig-broker-response/v2"
        or payload["broker_id"] != broker["id"]
        or payload["key_id"] != broker["key_id"]
        or payload["caller_uid"] != os.getuid()
        or payload["caller_real_gid"] != os.getgid()
        or payload["caller_effective_gid"] != os.getegid()
        or payload["peer_observed_caller_uid"] != os.getuid()
        or payload["peer_observed_caller_gid"] != os.getgid()
        or payload["cluster_id"] != cluster_id
        or payload["cluster_name"] != cluster_name
        or payload["deployment_contract_sha256"] != deployment_contract_sha256
        or payload["mode"] != "ordinary"
        or payload["nonce"] != nonce
        or payload["socket_path"] != broker["socket_path"]
        or payload["broker_executable_sha256"] != broker["executable_sha256"]
        or payload["broker_config_sha256"] != broker["config_sha256"]
        or payload["broker_runtime_review_sha256"]
        != broker["runtime_review_sha256"]
    ):
        os.close(descriptor)
        raise DeploymentError("ordinary proxy broker response differs from request")
    try:
        issued_at = datetime.fromisoformat(str(payload["issued_at"]).replace("Z", "+00:00"))
        expires_at = datetime.fromisoformat(str(payload["expires_at"]).replace("Z", "+00:00"))
    except ValueError as exc:
        os.close(descriptor)
        raise DeploymentError("ordinary proxy broker lease timestamps are malformed") from exc
    now = datetime.now(timezone.utc)
    if (
        issued_at.tzinfo is None
        or expires_at.tzinfo is None
        or not (issued_at <= now < expires_at)
        or expires_at - issued_at > timedelta(hours=12)
    ):
        os.close(descriptor)
        raise DeploymentError("ordinary proxy broker lease exceeds twelve hours")
    _verify_debug_broker_signature(
        broker["public_key"], broker["key_id"], response["signature"], payload
    )
    details = os.fstat(descriptor)
    required_seals = (
        fcntl.F_SEAL_SEAL
        | fcntl.F_SEAL_SHRINK
        | fcntl.F_SEAL_GROW
        | fcntl.F_SEAL_WRITE
    )
    if (
        not stat.S_ISREG(details.st_mode)
        or stat.S_IMODE(details.st_mode) != 0o600
        or details.st_size < 1
        or details.st_size > 4 * 1024 * 1024
        or fcntl.fcntl(descriptor, fcntl.F_GET_SEALS) != required_seals
    ):
        os.close(descriptor)
        raise DeploymentError("ordinary proxy broker did not return one sealed memfd")
    raw = os.pread(descriptor, details.st_size, 0)
    os.close(descriptor)
    if hashlib.sha256(raw).hexdigest() != payload["kubeconfig_sha256"]:
        raise DeploymentError("ordinary proxy kubeconfig differs from broker receipt")
    try:
        configuration = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("ordinary proxy kubeconfig is not canonical JSON") from exc
    if _canonical_bytes(configuration) + b"\n" != raw:
        raise DeploymentError("ordinary proxy kubeconfig is not canonical")
    if not isinstance(configuration, dict) or set(configuration) != {
        "apiVersion",
        "clusters",
        "contexts",
        "current-context",
        "kind",
        "preferences",
        "users",
    }:
        raise DeploymentError("ordinary proxy kubeconfig has unsupported fields")
    clusters = configuration["clusters"]
    contexts = configuration["contexts"]
    users = configuration["users"]
    if (
        configuration["apiVersion"] != "v1"
        or configuration["kind"] != "Config"
        or configuration["preferences"] != {}
        or configuration["current-context"] != cluster_name
        or not isinstance(clusters, list)
        or len(clusters) != 1
        or not isinstance(contexts, list)
        or len(contexts) != 1
        or not isinstance(users, list)
        or len(users) != 1
        or not isinstance(clusters[0], dict)
        or set(clusters[0]) != {"cluster", "name"}
        or clusters[0]["name"] != cluster_name
        or not isinstance(clusters[0]["cluster"], dict)
        or set(clusters[0]["cluster"])
        != {"certificate-authority-data", "server"}
        or not isinstance(contexts[0], dict)
        or set(contexts[0]) != {"context", "name"}
        or contexts[0]["name"] != cluster_name
        or not isinstance(contexts[0]["context"], dict)
        or set(contexts[0]["context"]) != {"cluster", "namespace", "user"}
        or contexts[0]["context"]["cluster"] != cluster_name
        or contexts[0]["context"]["namespace"] != "fs2-system"
        or not isinstance(users[0], dict)
        or set(users[0]) != {"name", "user"}
        or users[0]["name"] != contexts[0]["context"]["user"]
        or not isinstance(users[0]["user"], dict)
        or set(users[0]["user"])
        != {"client-certificate-data", "client-key-data"}
    ):
        raise DeploymentError(
            "ordinary proxy broker returned a plugin, token, path, or multi-context credential"
        )
    return configuration


def _debug_activation_history(
    run_root: Path, *, allow_absent: bool
) -> tuple[
    list[tuple[object, Mapping[str, Any]]],
    dict[str, tuple[object, Mapping[str, Any]]],
    dict[str, Mapping[str, Any]],
]:
    """Reconstruct every retained activation and its append-only tombstone."""

    activation_root = run_root / "debug-activations"
    try:
        details = os.stat(activation_root, follow_symlinks=False)
    except FileNotFoundError as exc:
        revocations = _debug_revocation_history(run_root)
        if revocations:
            raise DeploymentError(
                "debug revocation history exists without its activation history"
            ) from exc
        if allow_absent:
            return [], {}, {}
        raise DeploymentError(
            "request debugging is default-off; no accepted activation history exists"
        ) from exc
    if (
        not stat.S_ISDIR(details.st_mode)
        or details.st_uid != os.getuid()
        or stat.S_IMODE(details.st_mode) != 0o700
    ):
        raise DeploymentError("debug activation history is not one owner-only directory")
    current: list[tuple[object, Mapping[str, Any]]] = []
    installed: dict[str, tuple[object, Mapping[str, Any]]] = {}
    revocations = _debug_revocation_history(run_root)
    matched_revocations: set[str] = set()
    cluster_id = retained_state_output(run_root, "infrastructure", "cluster_id")
    cluster_name = retained_state_output(run_root, "infrastructure", "cluster_name")
    if not isinstance(cluster_id, str) or not isinstance(cluster_name, str):
        raise DeploymentError("retained infrastructure identity outputs are malformed")
    now = datetime.now(timezone.utc)
    with os.scandir(activation_root) as entries:
        ordered = sorted(entries, key=lambda entry: entry.name)
    if not ordered and not allow_absent:
        raise DeploymentError("request debugging is default-off; no activation is installed")
    for entry in ordered:
        if (
            entry.is_symlink()
            or not entry.is_file(follow_symlinks=False)
            or re.fullmatch(r"[a-f0-9]{64}\.json", entry.name) is None
        ):
            raise DeploymentError("debug activation history contains an unsupported entry")
        envelope = retained_json(
            Path(entry.path), "retained signed debug activation", 128 * 1024
        )
        payload = _verify_debug_activation(envelope)
        activation_sha256 = hashlib.sha256(_canonical_bytes(payload)).hexdigest()
        if activation_sha256 != entry.name[:-5] or activation_sha256 in installed:
            raise DeploymentError("debug activation filename is duplicate or unbound")
        installed[activation_sha256] = (envelope, payload)
        if activation_sha256 in revocations:
            _validate_debug_revocation(
                revocations[activation_sha256],
                activation=payload,
                activation_payload_sha256=activation_sha256,
                cluster_id=cluster_id,
                cluster_name=cluster_name,
                require_fresh=False,
            )
            matched_revocations.add(activation_sha256)
            continue
        try:
            activated_at = datetime.fromisoformat(
                str(payload["activated_at"]).replace("Z", "+00:00")
            )
            expires_at = datetime.fromisoformat(
                str(payload["expires_at"]).replace("Z", "+00:00")
            )
        except (KeyError, ValueError) as exc:
            raise DeploymentError("debug activation timestamps are malformed") from exc
        if activated_at.tzinfo is None or expires_at.tzinfo is None:
            raise DeploymentError("debug activation timestamps are not timezone-aware")
        if activated_at <= now < expires_at:
            current.append((envelope, payload))
    if matched_revocations != set(revocations):
        raise DeploymentError("debug revocation history references a missing activation")
    _require_debug_disable_receipts(run_root, installed, revocations)
    return current, installed, revocations


def _current_debug_activation(run_root: Path) -> object:
    """Select exactly one current grant from append-only activation history."""

    current, _installed, _revocations = _debug_activation_history(
        run_root, allow_absent=False
    )
    if len(current) != 1:
        raise DeploymentError(
            "debug activation history must contain exactly one current tenant/model grant"
        )
    envelope, _payload = current[0]
    return envelope


@contextmanager
def debug_lifecycle_lock(run_root: Path) -> Iterator[None]:
    """Serialize additive activation/disable history without deleting evidence."""

    descriptor = os.open(
        run_root,
        os.O_RDONLY
        | os.O_DIRECTORY
        | os.O_CLOEXEC
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        details = os.fstat(descriptor)
        if (
            not stat.S_ISDIR(details.st_mode)
            or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) != 0o700
        ):
            raise DeploymentError("retained run root is not one owner-only directory")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise DeploymentError(
                "another activate-debug or disable-debug command owns the retained lifecycle"
            ) from exc
        yield
    finally:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        finally:
            os.close(descriptor)


def _append_only_directory(path: Path) -> None:
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        details = os.stat(path, follow_symlinks=False)
        if (
            not stat.S_ISDIR(details.st_mode)
            or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) != 0o700
        ):
            raise DeploymentError("debug activation directory conflicts with policy")
        return
    parent = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    directory = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(directory)
        os.fsync(parent)
    finally:
        os.close(directory)
        os.close(parent)


def _append_or_verify_json(path: Path, value: object, label: str) -> None:
    if path.exists():
        if retained_json(path, label) != value:
            raise DeploymentError(f"{label} conflicts with retained append-only bytes")
        return
    append_only_private_json(path, value)


def install_debug_activation(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    """Validate, then append one externally authorized short-lived grant."""

    del contract
    if args.debug_activation_source is None or args.debug_kubeconfig_source is not None:
        raise DeploymentError(
            "activate-debug requires only --debug-activation-source; reusable operator-owned kubeconfigs are forbidden"
        )
    envelope = retained_json(
        args.debug_activation_source,
        "candidate signed debug activation",
        128 * 1024,
    )
    cluster_id = retained_state_output(run_root, "infrastructure", "cluster_id")
    cluster_name = retained_state_output(run_root, "infrastructure", "cluster_name")
    if not isinstance(cluster_id, str) or not isinstance(cluster_name, str):
        raise DeploymentError("retained infrastructure identity outputs are malformed")
    payload = _verify_debug_activation(envelope)
    tenant_id, model_id, app_id = _validate_debug_activation_grant(
        payload,
        cluster_id=cluster_id,
        cluster_name=cluster_name,
    )
    payload_sha256 = hashlib.sha256(_canonical_bytes(payload)).hexdigest()
    activation_root = run_root / "debug-activations"
    current, installed, revocations = _debug_activation_history(
        run_root, allow_absent=True
    )
    if payload_sha256 in revocations:
        raise DeploymentError("a tombstoned debug activation cannot be reinstalled")
    if current and any(
        hashlib.sha256(_canonical_bytes(active_payload)).hexdigest() != payload_sha256
        for _active_envelope, active_payload in current
    ):
        raise DeploymentError(
            "another unrevoked debug activation is current; disable or await expiry before replacement"
        )
    if len(current) > 1:
        raise DeploymentError("retained debug history already has overlapping current grants")
    if payload_sha256 in installed and not current:
        raise DeploymentError("an expired retained activation cannot be reinstalled")
    _append_only_directory(activation_root)
    _append_or_verify_json(
        activation_root / f"{payload_sha256}.json",
        envelope,
        "retained signed debug activation",
    )
    print(
        json.dumps(
            {
                "status": "debug-activation-installed",
                "tenant_id": tenant_id,
                "model_id": model_id,
                "app_id": app_id,
                "expires_at": payload["expires_at"],
                "records_retention_dependency": "SAI-02:90-day-purge",
            },
            sort_keys=True,
        )
    )


def _accepted_internal_debug_broker(
    *, cluster_id: str, broker_id: str
) -> Mapping[str, Any]:
    trust_path = CAPSULE_TOOL_PATHS.get("internal_debug_activation_trust", "")
    match = re.fullmatch(r"/proc/self/fd/([0-9]+)", trust_path)
    if match is None:
        raise DeploymentError("debug broker trust root is not descriptor-pinned")
    trust_fd = int(match.group(1))
    trust_raw = os.pread(trust_fd, os.fstat(trust_fd).st_size, 0)
    try:
        trust = json.loads(trust_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("debug broker registry is malformed") from exc
    if (
        _canonical_bytes(trust) + b"\n" != trust_raw
        or not isinstance(trust, dict)
        or set(trust) != {"brokers", "issuers", "schema"}
        or trust["schema"]
        != "fs2-serve.nebius.ai/trusted-internal-debug-activation-issuers/v1"
        or not isinstance(trust["brokers"], list)
    ):
        raise DeploymentError("debug broker registry is not canonical v1")
    required = {
        "cluster_ids",
        "config_path",
        "config_sha256",
        "executable_path",
        "executable_sha256",
        "id",
        "isolation_mode",
        "key_id",
        "listener_modes",
        "modes",
        "namespace_policy_sha256",
        "network_namespace_owner_uid",
        "peer_credential_mode",
        "peer_gid",
        "peer_uid",
        "public_key",
        "role",
        "runtime_review_sha256",
        "scope_policy_sha256",
        "socket_path",
    }
    matches = [
        record
        for record in trust["brokers"]
        if isinstance(record, dict)
        and set(record) == required
        and record.get("id") == broker_id
        and record.get("role") == "internal-proxy-session-broker"
        and record.get("cluster_ids")
        == sorted(set(record.get("cluster_ids", [])))
        and cluster_id in record.get("cluster_ids", [])
        and record.get("modes") == ["debug", "ordinary"]
        and record.get("listener_modes")
        == ["debug-read-only", "ordinary-authenticated"]
        and record.get("isolation_mode")
        == "private-network-namespace+broker-owned-proxy"
        and record.get("network_namespace_owner_uid") == 0
        and record.get("peer_uid") == 0
        and record.get("peer_credential_mode")
        == "SO_PEERCRED-real-gid+signed-setgid-effective-gid/v2"
        and record.get("socket_path") == str(DEBUG_CREDENTIAL_BROKER_SOCKET)
        and record.get("executable_path")
        == str(DEBUG_CREDENTIAL_BROKER_EXECUTABLE)
        and record.get("config_path") == str(DEBUG_CREDENTIAL_BROKER_CONFIG)
    ]
    if len(matches) != 1:
        raise DeploymentError("debug disable has no unique enrolled root broker")
    broker = matches[0]
    if any(
        not isinstance(broker.get(field), str)
        or re.fullmatch(r"[a-f0-9]{64}", broker[field]) is None
        or broker[field] == "0" * 64
        for field in (
            "config_sha256",
            "executable_sha256",
            "namespace_policy_sha256",
            "runtime_review_sha256",
            "scope_policy_sha256",
        )
    ):
        raise DeploymentError("debug broker enrollment is malformed")
    return broker


def _require_debug_disable_receipts(
    run_root: Path,
    installed: Mapping[str, tuple[object, Mapping[str, Any]]],
    revocations: Mapping[str, Mapping[str, Any]],
) -> None:
    """Require every local tombstone to reopen one signed terminal broker proof."""

    if not revocations:
        return
    root = run_root / "debug-disable-receipts"
    try:
        details = os.stat(root, follow_symlinks=False)
    except FileNotFoundError as exc:
        raise DeploymentError(
            "debug revocations exist without retained broker teardown receipts"
        ) from exc
    if (
        not stat.S_ISDIR(details.st_mode)
        or details.st_uid != os.getuid()
        or stat.S_IMODE(details.st_mode) != 0o700
    ):
        raise DeploymentError("debug disable receipt history is not owner-only")
    proven: set[str] = set()
    with os.scandir(root) as entries:
        ordered = sorted(entries, key=lambda entry: entry.name)
    for entry in ordered:
        if (
            entry.is_symlink()
            or not entry.is_file(follow_symlinks=False)
            or re.fullmatch(r"[a-f0-9]{64}\.json", entry.name) is None
        ):
            raise DeploymentError("debug disable receipts contain an unsupported entry")
        envelope = retained_json(
            Path(entry.path), "retained broker debug disable receipt", 256 * 1024
        )
        if (
            not isinstance(envelope, Mapping)
            or set(envelope) != {"payload", "payload_sha256", "signature"}
            or not isinstance(envelope.get("payload"), Mapping)
        ):
            raise DeploymentError("retained broker debug disable receipt is malformed")
        payload = envelope["payload"]
        activation_sha256 = payload.get("activation_payload_sha256")
        if activation_sha256 not in installed:
            raise DeploymentError(
                "debug disable receipt references an unknown retained activation"
            )
        _activation_envelope, activation = installed[activation_sha256]
        broker = _accepted_internal_debug_broker(
            cluster_id=str(activation["cluster_id"]),
            broker_id=str(activation["credential_broker_id"]),
        )
        revocation = revocations.get(str(activation_sha256))
        backend_ack = payload.get("backend_ack")
        teardown = payload.get("teardown")
        payload_sha256 = hashlib.sha256(_canonical_bytes(payload)).hexdigest()
        expected_keys = {
            "activation_payload_sha256",
            "app_id",
            "backend_ack",
            "broker_id",
            "caller_effective_gid",
            "caller_real_gid",
            "caller_uid",
            "cluster_id",
            "cluster_name",
            "deployment_contract_sha256",
            "key_id",
            "model_id",
            "nonce",
            "peer_observed_caller_gid",
            "peer_observed_caller_uid",
            "revocation_payload_sha256",
            "revoked_at",
            "schema",
            "teardown",
            "tenant_id",
        }
        if (
            set(payload) != expected_keys
            or entry.name != f"{payload_sha256}.json"
            or envelope["payload_sha256"] != payload_sha256
            or payload.get("schema")
            != "fs2-serve.nebius.ai/internal-debug-disable-response/v2"
            or payload.get("broker_id") != broker["id"]
            or payload.get("key_id") != broker["key_id"]
            or payload.get("caller_uid") != os.getuid()
            or payload.get("caller_real_gid") != os.getgid()
            or payload.get("caller_effective_gid") != os.getegid()
            or payload.get("peer_observed_caller_uid") != os.getuid()
            or payload.get("peer_observed_caller_gid") != os.getgid()
            or payload.get("cluster_id") != activation["cluster_id"]
            or payload.get("cluster_name") != activation["cluster_name"]
            or payload.get("tenant_id") != activation["tenant_id"]
            or payload.get("model_id") != activation["model_id"]
            or payload.get("app_id") != activation["app_id"]
            or not isinstance(backend_ack, Mapping)
            or set(backend_ack)
            != {
                "activation_payload_sha256",
                "database_event_sha256",
                "revoked_at",
                "schema",
                "status",
            }
            or backend_ack.get("schema")
            != "fs2-serve.nebius.ai/request-debug-activation-tombstone-ack/v1"
            or backend_ack.get("activation_payload_sha256") != activation_sha256
            or backend_ack.get("status") != "accepted"
            or re.fullmatch(
                r"[a-f0-9]{64}", str(backend_ack.get("database_event_sha256"))
            )
            is None
            or teardown
            != {
                "active_sessions_after": 0,
                "backend_authorization_revoked": True,
                "children_reaped": True,
                "connections_closed": True,
                "listeners_closed": True,
                "raw_transports_closed": True,
            }
        ):
            raise DeploymentError(
                "retained debug disable receipt does not prove terminal backend denial"
            )
        _verify_debug_broker_signature(
            broker["public_key"], broker["key_id"], envelope["signature"], payload
        )
        if revocation is None:
            # A broker-complete disable receipt may be durable before the
            # local owner revocation append after a crash. It proves nothing
            # current by itself and permits the same lifecycle command to retry.
            continue
        if (
            payload.get("revoked_at") != revocation["revoked_at"]
            or payload.get("revocation_payload_sha256")
            != hashlib.sha256(_canonical_bytes(revocation)).hexdigest()
            or backend_ack.get("revoked_at") != revocation["revoked_at"]
        ):
            raise DeploymentError(
                "retained debug disable receipt differs from its owner revocation"
            )
        proven.add(str(activation_sha256))
    missing = sorted(set(revocations) - proven)
    if missing:
        raise DeploymentError(
            "debug revocation history lacks a signed terminal broker receipt"
        )


def disable_debug_activation(
    args: argparse.Namespace,
    run_root: Path,
    contract: Mapping[str, Any],
) -> None:
    """Append disable evidence only after broker teardown and backend denial."""

    if (
        args.debug_revocation_source is None
        or args.debug_activation_source is not None
        or args.debug_kubeconfig_source is not None
    ):
        raise DeploymentError(
            "disable-debug requires only --debug-revocation-source"
        )
    activation_envelope = _current_debug_activation(run_root)
    activation = _verify_debug_activation(activation_envelope)
    activation_sha256 = hashlib.sha256(_canonical_bytes(activation)).hexdigest()
    cluster_id = retained_state_output(run_root, "infrastructure", "cluster_id")
    cluster_name = retained_state_output(run_root, "infrastructure", "cluster_name")
    if not isinstance(cluster_id, str) or not isinstance(cluster_name, str):
        raise DeploymentError("retained infrastructure identity outputs are malformed")
    _validate_debug_activation_grant(
        activation,
        cluster_id=cluster_id,
        cluster_name=cluster_name,
    )
    revocation_envelope = retained_json(
        args.debug_revocation_source,
        "candidate signed debug activation revocation",
        128 * 1024,
    )
    revocation = _verify_debug_revocation(revocation_envelope)
    _validate_debug_revocation(
        revocation,
        activation=activation,
        activation_payload_sha256=activation_sha256,
        cluster_id=cluster_id,
        cluster_name=cluster_name,
        require_fresh=True,
    )
    broker = _accepted_internal_debug_broker(
        cluster_id=cluster_id,
        broker_id=str(activation["credential_broker_id"]),
    )
    nonce = os.getrandom(32).hex()
    deployment_sha256 = hashlib.sha256(_canonical_bytes(contract) + b"\n").hexdigest()
    request = {
        "activation": activation_envelope,
        "activation_revocation": revocation_envelope,
        "caller_effective_gid": os.getegid(),
        "caller_real_gid": os.getgid(),
        "caller_uid": os.getuid(),
        "cluster_id": cluster_id,
        "cluster_name": cluster_name,
        "deployment_contract_sha256": deployment_sha256,
        "nonce": nonce,
        "schema": "fs2-serve.nebius.ai/internal-debug-disable-request/v2",
    }
    try:
        revocation_fresh_until = datetime.fromisoformat(
            str(revocation["revoked_at"]).replace("Z", "+00:00")
        ) + timedelta(minutes=5)
        activation_expires_at = datetime.fromisoformat(
            str(activation["expires_at"]).replace("Z", "+00:00")
        )
    except ValueError as exc:
        raise DeploymentError("debug disable deadline is malformed") from exc
    deadline_wall = min(revocation_fresh_until, activation_expires_at)
    remaining_wall = (deadline_wall - datetime.now(timezone.utc)).total_seconds()
    if remaining_wall <= 0:
        raise DeploymentError("debug disable freshness expired before broker exchange")
    disable_deadline = time.monotonic() + min(30.0, remaining_wall)

    def bound_disable_io(operation: str, maximum: float) -> None:
        remaining = disable_deadline - time.monotonic()
        if remaining <= 0:
            raise DeploymentError(
                f"debug disable broker {operation} exceeded its signed deadline"
            )
        connection.settimeout(min(maximum, remaining))

    connection = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    try:
        bound_disable_io("connect", 5.0)
        connection.connect(str(DEBUG_CREDENTIAL_BROKER_SOCKET))
        peer_pid, peer_uid, peer_gid = struct.unpack(
            "3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
        )
        if (
            peer_pid < 1
            or peer_uid != broker["peer_uid"]
            or peer_gid != broker["peer_gid"]
        ):
            raise DeploymentError("debug disable broker peer identity differs")
        bound_disable_io("send", 5.0)
        connection.sendall(_canonical_bytes(request))
        bound_disable_io("receive", 20.0)
        response = json.loads(connection.recv(256 * 1024).decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("debug disable broker exchange failed closed") from exc
    finally:
        connection.close()
    if not isinstance(response, dict) or set(response) != {
        "payload",
        "payload_sha256",
        "signature",
    }:
        raise DeploymentError("debug disable broker response is malformed")
    payload = response["payload"]
    expected_keys = {
        "activation_payload_sha256",
        "app_id",
        "backend_ack",
        "broker_id",
        "caller_effective_gid",
        "caller_real_gid",
        "caller_uid",
        "cluster_id",
        "cluster_name",
        "deployment_contract_sha256",
        "key_id",
        "model_id",
        "nonce",
        "peer_observed_caller_gid",
        "peer_observed_caller_uid",
        "revocation_payload_sha256",
        "revoked_at",
        "schema",
        "teardown",
        "tenant_id",
    }
    backend_ack = payload.get("backend_ack") if isinstance(payload, Mapping) else None
    teardown = payload.get("teardown") if isinstance(payload, Mapping) else None
    if (
        not isinstance(payload, Mapping)
        or set(payload) != expected_keys
        or response["payload_sha256"]
        != hashlib.sha256(_canonical_bytes(payload)).hexdigest()
        or payload["schema"]
        != "fs2-serve.nebius.ai/internal-debug-disable-response/v2"
        or payload["activation_payload_sha256"] != activation_sha256
        or payload["revocation_payload_sha256"]
        != hashlib.sha256(_canonical_bytes(revocation)).hexdigest()
        or payload["broker_id"] != broker["id"]
        or payload["key_id"] != broker["key_id"]
        or payload["caller_uid"] != os.getuid()
        or payload["caller_real_gid"] != os.getgid()
        or payload["caller_effective_gid"] != os.getegid()
        or payload["peer_observed_caller_uid"] != os.getuid()
        or payload["peer_observed_caller_gid"] != os.getgid()
        or payload["cluster_id"] != cluster_id
        or payload["cluster_name"] != cluster_name
        or payload["deployment_contract_sha256"] != deployment_sha256
        or payload["nonce"] != nonce
        or payload["tenant_id"] != activation["tenant_id"]
        or payload["model_id"] != activation["model_id"]
        or payload["app_id"] != activation["app_id"]
        or payload["revoked_at"] != revocation["revoked_at"]
        or not isinstance(backend_ack, Mapping)
        or set(backend_ack)
        != {
            "activation_payload_sha256",
            "database_event_sha256",
            "revoked_at",
            "schema",
            "status",
        }
        or backend_ack.get("schema")
        != "fs2-serve.nebius.ai/request-debug-activation-tombstone-ack/v1"
        or backend_ack.get("activation_payload_sha256") != activation_sha256
        or backend_ack.get("revoked_at") != revocation["revoked_at"]
        or backend_ack.get("status") != "accepted"
        or re.fullmatch(
            r"[a-f0-9]{64}", str(backend_ack.get("database_event_sha256"))
        )
        is None
        or teardown
        != {
            "active_sessions_after": 0,
            "backend_authorization_revoked": True,
            "children_reaped": True,
            "connections_closed": True,
            "listeners_closed": True,
            "raw_transports_closed": True,
        }
    ):
        raise DeploymentError("debug disable did not prove teardown and backend denial")
    _verify_debug_broker_signature(
        broker["public_key"], broker["key_id"], response["signature"], payload
    )
    revocation_root = run_root / "debug-revocations"
    receipt_root = run_root / "debug-disable-receipts"
    _append_only_directory(revocation_root)
    _append_only_directory(receipt_root)
    revocation_sha256 = hashlib.sha256(_canonical_bytes(revocation)).hexdigest()
    response_sha256 = hashlib.sha256(_canonical_bytes(payload)).hexdigest()
    _append_or_verify_json(
        receipt_root / f"{response_sha256}.json",
